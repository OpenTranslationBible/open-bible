{
    "book": "נחום",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "משא נינוה. ספר חזון נחום האלקושי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אל קנוא ונוקם ה';",
                "> נוקם ה' ובעל חמה",
                "> נוקם ה' לצריו",
                "> ונוטר הוא לאויביו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ה' ארך אפיים וגדול כוח",
                "> ונקה לא ינקה;",
                "> ה' בסופה ובסערה דרכו",
                "> וענן אבק רגליו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> גוער בים ויבשהו",
                "> וכל הנהרות החריב;",
                "> אמלל בשן וכרמל",
                "> ופרח לבנון אמלל."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הרים רעשו ממנו",
                "> והגבעות התמוגגו;",
                "> ותשא ארץ מפניו",
                "> ותבל וכל יושבי בה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> לפני זעמו מי יעמוד",
                "> ומי יקום בחרון אפו;",
                "> חמתו נתכה כאש",
                "> והצורים נהרסו ממנו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> טוב ה'",
                "> למעוז ביום צרה",
                "> ויודע חסי בו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ובשטף עבר",
                "> כלה יעשה מקומה",
                "> ואויביו ירדף חושך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מה תחשבון אל ה'",
                "> כלה הוא עושה;",
                "> לא תקום פעמים צרה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי עד סירים סבוכים",
                "> וכסבאם סבואים",
                "> אוכלו כקש יבש מלא."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ממך יצא",
                "> חושב על ה' רעה",
                "> יועץ בליעל."
            ]
        },
        {
            "verse": 12,
            "text": [
                "כה אמר ה':",
                "> \"אם שלמים וכן רבים",
                "> וכן נגוזו ועבר;",
                "> ועיניתיך לא אענך עוד."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ועתה אשבר מטהו מעליך",
                "> ומוסרותיך אנתק.\""
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ויצו עליך ה' ולא יזרע משמך עוד;",
                "> מבית אלהיך אכרית פסל ומסכה",
                "> אשים קברך כי קלות."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הנה על ההרים רגלי מבשר",
                "> משמיע שלום חגי יהודה חגיך",
                "> שלמי נדריך",
                "> כי לא יוסיף עוד לעבור בך בליעל",
                "> כלה נכרת."
            ]
        }
    ]
}