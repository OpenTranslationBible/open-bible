{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הוי עיר הדמים, מלאה כזב ושוד;",
                "> טרפה לא תסור."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> קול השוט,",
                "> וקול רעש אופן,",
                "> וסוס דוהר",
                "> ומרכבה מרקדה!"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> פרש מעלה,",
                "> ולהב חרב וברק חנית,",
                "> ורוב חלל וכבד פגר,",
                "> ואין קצה לגוויה—",
                "> יכשלו בגוויה!"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מרוב זנוני זונה טובת חן,",
                "> בעלת כשפים,",
                "> המוכרת גוים בזנוניה,",
                "> ומשפחות בכשפיה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> \"הנני אליך,\" נאום יהוה צבאות;",
                "> \"וגיליתי שוליך על פניך,",
                "> והראיתי גוים מערך,",
                "> וממלכות קלונך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ושמתי עליך שקוצים",
                "> ונבלתיך,",
                "> ונתתיך כראי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והיה כל רואיך",
                "> יברחו ממך ואמרו,",
                "> 'נינוה שדודה!",
                "> מי ינוד לה?'",
                "> מאין אבקש מנחמים לך?\""
            ]
        },
        {
            "verse": 8,
            "text": [
                "> התיטבי מנא אמון,",
                "> הישבה ביאורים,",
                "> מים סביב לה,",
                "> אשר חיל ים,",
                "> מים חומתה?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כוש עצמה ומצרים ואין קצה.",
                "> פוט ולובים היו בעזרתך."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> גם היא לגולה הלכה,",
                "> בשבי הלכה;",
                "> גם עולליה ירטשו",
                "> בראש כל חוצות;",
                "> ועל נכבדיה ידו גורל,",
                "> וכל גדוליה רותקו בזיקים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> גם את תשכרי,",
                "> תהיי נעלמה.",
                "> גם את תבקשי מחסה מאויב."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כל מבצריך תאנים עם בכורים—",
                "> אם ינועו, יפלו על פי אוכל."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> הנה עמך נשים בקרבך!",
                "> שערי ארצך נפתחו לאויביך;",
                "> אש אכלה בריחיך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> שאבי לך מים למצור!",
                "> חזקי מבצריך!",
                "> באי בטיט ורמסי בחומר!",
                "> החזיקי מלבן!"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> שם תאכלך אש,",
                "> תכריתך חרב;",
                "> תאכלך כילק.",
                "> התכבדי כילק,",
                "> התכבדי כארבה."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> הרבית רכליך מכוכבי השמים—",
                "> ילק פשט ויעוף."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> מנזריך כארבה,",
                "> וצבאיך כגוב גובי",
                "> חונים בגדרות ביום קרה—",
                "> שמש זרחה ונודדו,",
                "> ולא נודע מקומם."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> נמו רעיך מלך אשור;",
                "> ישכנו אדיריך.",
                "> נפוצו עמך על ההרים,",
                "> ואין מקבץ."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אין כהה לשברך,",
                "> נחלתך אנושה.",
                "> כל שמעיך",
                "> תקעו כף עליך,",
                "> כי על מי לא עברה רעתך תמיד?"
            ]
        }
    ]
}