{
    "book": "תהילים",
    "chapter": 18,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד, עבד ה', אשר דיבר לה' את דברי השיר הזה ביום אשר הציל אותו ה' מכף כל אויביו ומכף שאול. ויאמר:"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ארחמך ה', חזקי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ה' סלעי ומצודתי ומפלטי,",
                "> אלי, צורי אחסה בו;",
                "> מגני וקרן ישעי, משגבי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> מהולל אקרא ה',",
                "> ומן אויבי אושע."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אפפוני חבלי מוות,",
                "> ונחלי בליעל יבעתוני."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> חבלי שאול סבבוני;",
                "> מוקשי מוות קדמוני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> בצר לי אקרא ה',",
                "> ואל אלוהי אשוע;",
                "> ישמע מהיכלו קולי,",
                "> ושועתי לפניו תבוא באוזניו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ותגעש ותרעש הארץ;",
                "> ומוסדי הרים ירגזו",
                "> ויתגעשו, כי חרה לו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> עלה עשן באפו,",
                "> ואש מפיו תאכל;",
                "> גחלים בערו ממנו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ויט שמים וירד,",
                "> וערפל תחת רגליו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> וירכב על כרוב ויעף;",
                "> וידא על כנפי רוח."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ישת חושך סתרו, סביבותיו סוכתו,",
                "> חשכת מים, עבֵי שחקים."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מנוגה נגדו עביו עברו,",
                "> ברד וגחלי אש."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> וירעם בשמים ה',",
                "> ועליון יתן קולו,",
                "> ברד וגחלי אש."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> וישלח חציו ויפיצם,",
                "> וברקים רב ויהומם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ויראו אפיקי מים,",
                "> ויגלו מוסדות תבל",
                "> מגערתך, ה',",
                "> מנשמת רוח אפך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ישלח ממרום יקחני;",
                "> ימשני ממים רבים."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> יצילני מאויבי עז,",
                "> ומשונאי כי אמצו ממני."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> יקדמוני ביום אידי,",
                "> ויהי ה' למשען לי."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ויוציאני למרחב;",
                "> יחלצני כי חפץ בי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> יגמלני ה' כצדקי;",
                "> כבר ידי ישיב לי."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> כי שמרתי דרכי ה',",
                "> ולא רשעתי מאלוהי."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> כי כל משפטיו לנגדי,",
                "> וחקותיו לא אסיר מני."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ואהיה תמים עמו,",
                "> ואשמרה מעווני."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> וישב ה' לי כצדקי,",
                "> כבר ידי לנגד עיניו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> עם חסיד תתחסד;",
                "> עם גבר תמים תתמם;"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> עם נבר תבר,",
                "> ועם עיקש תתפתל."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> כי אתה עם עני תושיע,",
                "> ועיניים רמות תשפיל."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> כי אתה תאיר נרי;",
                "> ה' אלוהי יגיה חשכי."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> כי בך ארוץ גדוד;",
                "> ובאלוהי אדלג שור."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> האל תמים דרכו;",
                "> אמרת ה' צרופה;",
                "> מגן הוא לכל החוסים בו."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> כי מי אלוה מבלעדי ה'?",
                "> ומי צור זולתי אלוהינו?"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> האל המאזרני חיל,",
                "> ויתן תמים דרכי?"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> משוה רגלי כאילות,",
                "> ועל במותי יעמידני."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> מלמד ידי למלחמה,",
                "> ונחתה קשת נחושה זרועותי."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> ותתן לי מגן ישעך,",
                "> וימינך תסעדני;",
                "> וענותך תרבני."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> תרחיב צעדי תחתי,",
                "> ולא מעדו קרסולי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> ארדוף אויבי ואשיגם,",
                "> ולא אשוב עד כלותם."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> אמחצם ולא יוכלו קום;",
                "> יפלו תחת רגלי."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> ותאזרני חיל למלחמה;",
                "> תכריע קמי תחתי."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ואויבי תתה לי עורף,",
                "> ומשנאי אצמיתם."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> ישועו ואין מושיע;",
                "> אל ה' ולא ענם."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> ואשחקם כעפר על פני רוח;",
                "> כטיט חוצות אריקם."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> תפלטני מריבי עם;",
                "> תשימני לראש גוים;",
                "> עם לא ידעתי יעבדוני."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> לשמע אוזן ישמעו לי;",
                "> בני נכר יכחשו לי."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> בני נכר יבלו,",
                "> ויחרגו ממסגרותיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> חי ה', וברוך צורי;",
                "> וירום אלוהי ישעי,"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> האל הנותן נקמות לי,",
                "> וידבר עמים תחתי."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> מפלטי מאויבי;",
                "> אף תנשאני ממתקוממי;",
                "> מאיש חמס תצילני."
            ]
        },
        {
            "verse": 49,
            "text": [
                "> על כן אודך בגוים, ה',",
                "> ולשמך אזמרה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> מגדול ישועות מלכו,",
                "> ועושה חסד למשיחו,",
                "> לדוד ולזרעו עד עולם."
            ]
        }
    ]
}