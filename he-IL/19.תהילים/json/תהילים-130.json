{
    "book": "תהילים",
    "chapter": 130,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ממעמקים קראתיך, ה'."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ה', שמעה בקולי!",
                "> תהיינה אוזניך קשובות",
                "> לקול תחנוני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אם עוונות תשמר יה,",
                "> ה', מי יעמוד?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי עמך הסליחה,",
                "> למען תירא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> קיוויתי לה', קיוותה נפשי,",
                "> ולדברו הוחלתי."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> נפשי לה' משומרים לבוקר,",
                "> שומרים לבוקר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יחל ישראל אל ה',",
                "> כי עם ה' החסד,",
                "> והרבה עמו פדות."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> והוא יפדה את ישראל",
                "> מכל עוונותיו."
            ]
        }
    ]
}