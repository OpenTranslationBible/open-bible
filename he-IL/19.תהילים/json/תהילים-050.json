{
    "book": "תהילים",
    "chapter": 50,
    "verses": [
        {
            "text": [
                "מזמור לאסף."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> האל, אלוהים, ה' דיבר,",
                "> ויקרא לארץ ממזרח שמש עד מבואו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> מציון, מושלמת היופי,",
                "> הופיע אלוהים באורו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יבוא אלוהינו ואל יחרש;",
                "> אש אוכלת לפניו,",
                "> וסביביו סערה עזה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יקרא לשמים מעל,",
                "> ולארץ, לדין עמו:"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> \"אספו לי חסידי,",
                "> כורתי בריתי עלי זבח.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ויגידו שמים צדקו,",
                "> כי אלוהים שופט הוא.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"שמע עמי ואדברה;",
                "> ישראל, ואעידה בך;",
                "> אלוהים אנכי, אלוהיך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> לא על זבחיך אוכיחך,",
                "> ועולותיך תמיד לנגדי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לא אקח מביתך פר,",
                "> מעשתרותיך עתודים."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי לי כל חיתו יער,",
                "> בהמות בהררי אלף."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ידעתי כל עוף הרים,",
                "> וזיז שדי עמדי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אם ארעב לא אומר לך,",
                "> כי לי תבל ומלואה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> האוכל בשר אבירים",
                "> ודם עתודים אשתה?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> זבח לאלוהים תודה",
                "> ושלם לעליון נדריך;"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> וקראני ביום צרה;",
                "> אחלצך, ותכבדני.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "ולרשע אמר אלוהים,",
                "> \"מה לך לספר חוקי",
                "> ותשא בריתי עלי פיך?"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ואתה שנאת מוסר,",
                "> ותשלך דברי אחריך."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אם ראית גנב ותרץ עמו,",
                "> ועם מנאפים חלקך."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> פיך שלחת ברעה,",
                "> ולשונך תצמיד מרמה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> תשב באחיך תדבר,",
                "> בבן אמך תתן דופי."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אלה עשית והחרשתי;",
                "> דמית היות אהיה כמוך;",
                "> אוכיחך ואערכה לעיניך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> הבינו נא זאת, שוכחי אל,",
                "> פן אטרוף ואין מציל."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> זובח תודה יכבדנני;",
                "> ושם דרך אראנו בישע אלוהים.\""
            ]
        }
    ]
}