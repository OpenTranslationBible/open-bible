{
    "book": "תהילים",
    "chapter": 105,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הודו לה' קראו בשמו;",
                "> הודיעו בעמים עלילותיו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שירו לו, זמרו לו;",
                "> שיחו בכל נפלאותיו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> התהללו בשם קדשו;",
                "> ישמח לב מבקשי ה'."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> דרשו ה' ועוזו;",
                "> בקשו פניו תמיד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> זכרו נפלאותיו אשר עשה,",
                "> מופתיו ומשפטי פיו,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> זרע אברהם עבדו,",
                "> בני יעקב בחיריו!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הוא ה' אלוהינו;",
                "> בכל הארץ משפטיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> זכר לעולם בריתו,",
                "> דבר ציווה לאלף דור,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אשר כרת את אברהם,",
                "> ושבועתו ליצחק."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ויעמידה ליעקב לחוק,",
                "> לישראל ברית עולם,"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> לאמור, \"לך אתן את ארץ כנען",
                "> חבל נחלתכם.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> בהיותם מתי מספר,",
                "> כמעט וגרים בה,"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ויתהלכו מגוי אל גוי,",
                "> מממלכה אל עם אחר,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> לא הניח אדם לעשקם,",
                "> ויוכח עליהם מלכים, לאמור,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> \"אל תגעו במשיחי,",
                "> ולנביאי אל תרעו.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ויקרא רעב על הארץ;",
                "> כל מטה לחם שבר."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> שלח לפניהם איש,",
                "> לעבד נמכר יוסף."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> עינו בכבל רגלו,",
                "> ברזל באה נפשו;"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> עד עת בוא דברו,",
                "> אמרת ה' צרפתהו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> שלח מלך ויתירהו,",
                "> מושל עמים ויפתחהו."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> שמו אדון לביתו,",
                "> ומשל בכל קניינו,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> לאסור שריו בנפשו,",
                "> וזקניו יחכם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ויבוא ישראל מצרימה;",
                "> ויעקב גר בארץ חם."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ויפר את עמו מאוד,",
                "> ויעצמם מצריו."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> הפך ליבם לשנוא עמו,",
                "> להתנכל בעבדיו."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> שלח משה עבדו,",
                "> אהרון אשר בחר בו."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> שמו בם דברי אותותיו,",
                "> ומופתים בארץ חם."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> שלח חושך ויחשך;",
                "> ולא מרו את דברו."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> הפך את מימיהם לדם,",
                "> וימת את דגתם."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> שרץ ארצם צפרדעים",
                "> בחדרי מלכיהם."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> אמר ויבוא ערב,",
                "> כינים בכל גבולם."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> נתן גשמיהם ברד,",
                "> אש להבות בארצם."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> ויך גפנם ותאנתם,",
                "> וישבר עץ גבולם."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> אמר ויבוא ארבה,",
                "> וילק ואין מספר,"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> ויאכל כל עשב בארצם,",
                "> ויאכל פרי אדמתם."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> ויך כל בכור בארצם,",
                "> ראשית לכל אונם."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> ויוצא ככסף וזהב,",
                "> ואין בשבטיו כושל."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> שמח מצרים בצאתם,",
                "> כי נפל פחדם עליהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> פרש ענן למסך,",
                "> ואש להאיר לילה."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> שאל ויבא שלו,",
                "> ולחם שמים ישביעם."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> פתח צור ויזובו מים;",
                "> הלכו בציות נהר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> כי זכר את דבר קדשו",
                "> את אברהם עבדו;"
            ]
        },
        {
            "verse": 43,
            "text": [
                "> ויוצא עמו בששון,",
                "> ברנה את בחיריו."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> ויתן להם ארצות גוים,",
                "> ועמל לאומים יירשו,"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> בעבור ישמרו חקיו",
                "> ותורותיו ינצורו.",
                "> הללו יה!"
            ]
        }
    ]
}