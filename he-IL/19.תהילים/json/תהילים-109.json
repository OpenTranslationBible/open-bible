{
    "book": "תהילים",
    "chapter": 109,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלוהי תהילתי, אל תחרש!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי פי רשע ופיה מרמה עלי פתחו;",
                "> דברו אתי בלשון שקר."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ודברי שנאה סבבוני,",
                "> וילחמו בי חנם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> תחת אהבתי ישטנוני;",
                "> ואני תפילה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> וישימו עלי רעה תחת טובה,",
                "> ושנאה תחת אהבתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הפקד עליו רשע,",
                "> ושטן יעמד על ימינו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בהשפטו יצא רשע,",
                "> ותפלתו תהיה לחטאה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> יהיו ימיו מעטו;",
                "> פקדתו יקח אחר."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יהיו בניו יתומים,",
                "> ואשתו אלמנה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ונוע ינועו בניו ושאלו;",
                "> ודרשו מחרבותיהם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ינקש נושה לכל אשר לו,",
                "> ויבזו זרים יגיעו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אל יהי לו מושך חסד,",
                "> ואל יהי חונן ליתומיו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יהי אחריתו להכרית;",
                "> בדור אחר ימח שמם."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> יזכר עון אבותיו אל ה',",
                "> וחטאת אמו אל תמח."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> יהיו נגד ה' תמיד,",
                "> ויכרת מארץ זכרם;"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> יען אשר לא זכר לעשות חסד,",
                "> וירדף איש עני ואביון,",
                "> ונכאה לבב, להמיתו."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ויאהב קללה ותבואהו;",
                "> ולא חפץ בברכה ותרחק ממנו."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> וילבש קללה כמדו,",
                "> ותבא כמים בקרבו,",
                "> וכשמן בעצמותיו."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> תהי לו כבגד יעטה,",
                "> וכחגור תמיד יחגרה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> זאת פעולת שטני מאת ה',",
                "> והדברים רע על נפשי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ואתה, ה' אלוהים, עשה עמי למען שמך;",
                "> כי טוב חסדך, הצילני;"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> כי עני ואביון אנכי,",
                "> ולבי חלל בקרבי."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> כצל כנטותו נהלכתי;",
                "> ננערתי כארבה."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ברכי כשלו מצום,",
                "> ובשרי כחש משמן."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> ואני הייתי חרפה להם;",
                "> יראוני, יניעו ראשם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> עזרני, ה' אלוהי;",
                "> הושיעני כחסדך."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> וידעו כי ידך זאת:",
                "> אתה, ה', עשית."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> יקללו, ואתה תברך;",
                "> קמו ויבשו,",
                "> ועבדך ישמח."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> ילבשו שטני כלמה,",
                "> ויעטו כמעיל בשתם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> אודה ה' מאד בפי,",
                "> ובתוך רבים אהללנו."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> כי יעמד לימין אביון,",
                "> להושיע משופטי נפשו."
            ]
        }
    ]
}