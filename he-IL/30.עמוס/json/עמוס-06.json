{
    "book": "עמוס",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הוי השאננים בציון,",
                "> והבוטחים בהר שומרון,",
                "> נקובי ראשית הגויים,",
                "> ובאו בית ישראל."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עברו כלנה וראו,",
                "> ולכו משם חמת רבה,",
                "> ורדו גת פלשתים.",
                "> הטובים מן הממלכות האלה,",
                "> אם רב גבולם מגבלכם?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> המנדים ליום רע",
                "> ותגישון שבת חמס."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> השוכבים על מטות שן",
                "> וסרוחים על ערסותם,",
                "> ואוכלים כרים מצאן",
                "> ועגלים מתוך מרבק."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הפרטים על פי הנבל",
                "> כדוד חשבו להם כלי שיר,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> השותים במזרקי יין",
                "> וראשית שמנים ימשחו,",
                "> ולא נחלו על שבר יוסף."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> לכן עתה יגלו בראש גולים,",
                "> וסר מרזח סרוחים."
            ]
        },
        {
            "verse": 8,
            "text": [
                "נשבע אדני יהוה בנפשו, נאם יהוה אלהי צבאות:",
                "> \"מתאב אנכי את גאון יעקב",
                "> וארמנתיו שנאתי;",
                "> והסגרתי עיר ומלאה.\""
            ]
        },
        {
            "verse": 9,
            "text": [
                "והיה אם ייוותרו עשרה אנשים בבית אחד, ומתו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "ונשאו דודו ומספדו להוציא עצמות מן הבית, ואמר לאשר בירכתי הבית, \"העוד עמך?\" ואמר, \"אפס,\" ואמר, \"הס!\" כי לא להזכיר בשם יהוה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי הנה יהוה מצוה,",
                "> והכה הבית הגדול רסיסים",
                "> והבית הקטן בקעים."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הירוצון סוסים על סלעים?",
                "> אם יחרוש בבקרים ים?",
                "> כי הפכתם למשפט רוש",
                "> ופרי צדקה ללענה—"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> השמחים ללא דבר",
                "> האומרים, \"הלוא בחזקנו לקחנו קרניים?\""
            ]
        },
        {
            "verse": 14,
            "text": [
                "> \"כי הנה מקים עליכם גוי בית ישראל,\"",
                "> נאם יהוה אלהי צבאות,",
                "> \"ולחצו אתכם מלבוא חמת",
                "> עד נחל הערבה.\""
            ]
        }
    ]
}