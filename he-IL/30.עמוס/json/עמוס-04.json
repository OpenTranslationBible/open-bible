{
    "book": "עמוס",
    "chapter": 4,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> שמעו את הדבר הזה, פרות הבשן אשר בהר שומרון,",
                "> העושקות דלים, הרוצצות אביונים,",
                "> האומרות לאדוניהם, \"הביאו ונשתה!\""
            ]
        },
        {
            "verse": 2,
            "text": [
                "> נשבע אדוני ה' בקדשו,",
                "> \"הנה ימים באים עליכם",
                "> ולקחו אתכם בצנות,",
                "> ואחריתכן בסירות דוגה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ויצאתן בפרצים,",
                "> אישה נגד פניה,",
                "> והשלכתן ההרמונה,\"",
                "> נאום ה'."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"באו בית אל ופשעו,",
                "> בגלגל הרבו לפשוע!",
                "> הביאו זבחיכם לבוקר,",
                "> מעשרותיכם לשלושת ימים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> וקטר מחמץ תודה,",
                "> וקראו נדבות, השמיעו.",
                "> כי כן אהבתם, בני ישראל,\"",
                "> נאום אדוני ה'."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> \"וגם אני נתתי לכם נקיון שיניים בכל עריכם,",
                "> וחוסר לחם בכל מקומותיכם,",
                "> ולא שבתם עדי,\" נאום ה'."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"וגם מנעתי מכם את הגשם",
                "> בעוד שלושה חודשים לקציר.",
                "> המטירתי על עיר אחת,",
                "> ועל עיר אחת לא המטיר;",
                "> חלק אחד ימטיר,",
                "> וחלק אשר לא ימטיר ייבש."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ונעו שתיים שלוש ערים אל עיר אחת לשתות מים,",
                "> ולא ישבעו;",
                "> ולא שבתם עדי,\" נאום ה'."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> \"הכיתי אתכם בשדפון ובירקון;",
                "> הרבה גנותיכם וכרמיכם, תאנותיכם וזיתיכם יאכל הגזם;",
                "> ולא שבתם עדי,\" נאום ה'."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> \"שלחתי בכם דבר בדרך מצרים;",
                "> הרגתי בחרב בחוריכם,",
                "> עם שבי סוסיכם,",
                "> ואעלה באש את מחניכם באפכם;",
                "> ולא שבתם עדי,\" נאום ה'."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> \"הפכתי בכם כמהפכת אלוהים את סדום ואת עמורה,",
                "> ותהיו כעץ מוצל מאש;",
                "> ולא שבתם עדי,\" נאום ה'."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"לכן כה אעשה לך, ישראל;",
                "> יען כי אעשה זאת לך,",
                "> הכון לקראת אלוהיך, ישראל.\""
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי הנה יוצר הרים ובורא רוח,",
                "> ומגיד לאדם מה שיחו,",
                "> עשה שחר עיפה",
                "> ודורך על במותי ארץ,",
                "> ה' אלוהי צבאות שמו."
            ]
        }
    ]
}