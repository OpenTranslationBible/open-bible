{
    "book": "איוב",
    "chapter": 31,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"כרתתי ברית לעיני;",
                "> ואיך אתבונן על בתולה?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ומה חלק אלוה ממעל,",
                "> ונחלת שדי ממרומים?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הלא פורענות לעוול,",
                "> ואסון לפועלי און?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הלא הוא רואה דרכי,",
                "> וסופר את כל צעדי?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אם הלכתי עם שווא,",
                "> ותחש על מרמה רגלי,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ישקולני במאזני צדק,",
                "> וידע אלוה תמי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אם תטה אשורי מדרך,",
                "> ואחרי עיני הלך לבי,",
                "> ובכפי דבק מאום,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אזרעה ואחר יאכל,",
                "> וצאצאי ישרשו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אם נפתה לבי על אישה,",
                "> ועל פתח רעי ארבתי,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> תטחן לאחר אשתי,",
                "> ועליה יכרעו אחרים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי היא זימה,",
                "> ואוון פלילים."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי אש היא עד אבדון תאכל,",
                "> ובכל תבואתי תשרש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אם אמאס משפט עבדי ואמתי",
                "> בריבם עמי,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ומה אעשה כי יקום אל,",
                "> וכי יפקוד מה אשיבנו?"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הלא בבטן עשני עשהו,",
                "> ויכוננו ברחם אחד?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אם אמנע מחפץ דלים,",
                "> ועיני אלמנה אכלה,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ואוכל פתי לבדי,",
                "> ולא אכל יתום ממנה"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> (כי מנעורי גדלני כאב,",
                "> ומבטן אמי אנחנה),"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אם אראה אובד מבלי לבוש,",
                "> ואין כסות לאביון,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אם לא ברכוני חלציו,",
                "> ומגז כבשי יתחמם,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אם הניפותי על יתום ידי,",
                "> כי אראה בשער עזרתי,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> תיפול כתפי משכמה,",
                "> וזרועי מקנה תשבר."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> כי פחד אלוה עלי איד,",
                "> ומשאתו לא אוכל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> אם שמתי זהב כסלי,",
                "> ולכתם אמרתי מבטחי,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> אם אשמח כי רב חילי,",
                "> וכי כביר מצאה ידי,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> אם אראה אור כי יהל,",
                "> וירח יקר הלך,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> ותפת בסתר לבי,",
                "> ותשק ידי לפי,"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> גם הוא עוון פלילי,",
                "> כי כחשתי לאל ממעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> אם אשמח בפיד משנאי,",
                "> והתעררתי כי מצאו רע,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> ולא נתתי לחטוא פי",
                "> לשאול באלה נפשו."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> אם לא אמרו אנשי אוהלי,",
                "> מי יתן מבשרו לא נשבע?"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> בחוץ לא ילין גר,",
                "> דלתי לאורח אפתח."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> אם כסיתי כאדם פשעי,",
                "> לטמון בחובי עווני,"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> כי אערוץ המון רב,",
                "> ובוז משפחות יחתני,",
                "> ואדם לא אצא פתח."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> מי יתן לי שומע לי!",
                "> הנה תוי,",
                "> שדי יענני!",
                "> וספר כתב איש ריבי,"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> אם לא על שכמי אשאנו,",
                "> אענדנו עטרות לי."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> מספר צעדי אגידנו;",
                "> כנגיד אקרבנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> אם עלי אדמתי תזעק,",
                "> ויחד תלמיה יבכיון,"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> אם כחה אכלתי בלי כסף,",
                "> ונפש בעליה הפחתי,"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> תחת חיטה יצא חוח,",
                "> ותחת שעורה באשה.\"",
                "> תמו דברי איוב."
            ]
        }
    ]
}