{
    "book": "איוב",
    "chapter": 33,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"ועתה, איוב, נא שמע את דברי;",
                "> הקשב לכל מילותי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ראה נא, אני עומד לפתוח את פי;",
                "> לשוני מוכנה לדבר."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> דברי יוצאים מתום לבי;",
                "> שפתי מביעות דעת בכנות."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> רוח אלוהים עשתה אותי;",
                "> נשמת שדי תחייני."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> השב לי אם תוכל;",
                "> הכן עצמך ועמוד."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הנה אני כמותך לאל;",
                "> גם אני מחומר קורצתי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> לא תבעתך אימתי,",
                "> ולא תהיה ידי כבדה עליך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"אך אתה דיברת באוזניי,",
                "> ואשמע קול דבריך:"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 'נקי אני, בלי פשע;",
                "> טהור אני ואין בי עוון."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> והנה תואנות עלי ימצא;",
                "> יחשבני לאויב לו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ישים בסד רגלי;",
                "> ישמור כל ארחותי.'"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"אך אני אומר לך, בזאת לא צדקת,",
                "> כי אלוהים גדול מאדם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> מדוע תריב עמו,",
                "> כי כל דבריך לא יענה?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי באלוהים ידבר פעם,",
                "> ושתיים ולא ישורנה."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> בחלום, חזון לילה,",
                "> בנפול תרדמה על אנשים,",
                "> בתנומות עלי משכב,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אז יגלה אוזן אנשים",
                "> ובמוסרם יחתום,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> להסיר אדם מעשה",
                "> וגוה מגבר יכסה."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> יחוש נפשו משחת,",
                "> וחייתו מעבר בשלח."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> \"או ייסר במכאוב על משכבו,",
                "> וריב עצמותיו איתן."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> ותזנה נפשו מלחם,",
                "> ונפשו מאכל תאוה."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> יכל בשרו מראה,",
                "> ועצמותיו לא נראו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ותקרב נפשו לשחת,",
                "> וחייתו לממתים."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> אם יש עליו מלאך מליץ,",
                "> אחד מני אלף,",
                "> להגיד לאדם ישרו,"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ויחננו ויאמר,",
                "> 'פדעהו מרדת שחת;",
                "> מצאתי כופר—"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> רטפש בשרו מנער,",
                "> ישוב לימי עלומיו'—"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> יתפלל אל אלוהים",
                "> וירצהו; יראה פניו בתרועה,",
                "> וישב לאנוש צדקתו."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> ישור על אנשים ויאמר,",
                "> 'חטאתי וישר העויתי,",
                "> ולא שוה לי."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> פדה נפשי מעבר שחת,",
                "> וחייתי באור תראה.'"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> \"הן כל אלה יפעל אל",
                "> פעמים שלוש עם גבר—"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> להשיב נפשו משחת,",
                "> להאיר באור החיים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> \"הקשב, איוב, שמע לי;",
                "> החרש, ואנכי אדבר."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> אם יש לך דבר, השיבני;",
                "> דבר, כי חפצתי להצדיקך."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> ואם אין, אתה שמע לי;",
                "> החרש, ואחכמה אותך.\""
            ]
        }
    ]
}