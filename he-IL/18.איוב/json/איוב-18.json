{
    "book": "איוב",
    "chapter": 18,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ויען בלדד השוחי ויאמר:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עד מתי תשימו קנצי למלים?",
                "> תבינו ואחר נדבר."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> מדוע נחשבנו כבהמות,",
                "> נטמינו בעיניכם?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> טרף נפשו באפו,",
                "> האם בעבורך תעזב ארץ,",
                "> ויעתק צור ממקומו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> גם אור רשעים ידעך,",
                "> ולא יאיר שביב אש."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אור חשך באהלו,",
                "> ונרו עליו ידעך."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יצרו מצעדיו יצרו,",
                "> ועצתו תפילנו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כי שלח ברשת ברגליו,",
                "> ועל שבכה יתהלך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יאחז בעקבו פח,",
                "> יחזק עליו מוקש."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> טמון בארץ חבלו,",
                "> ומלכדתו עלי נתיב."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> סביב בעתהו בלהות,",
                "> ותפיציהו לרגליו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> יהי רעב אונו,",
                "> ואיד נכון לצלעו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יאכל בדי עורו,",
                "> יאכל בדי עורו,",
                "> בכור מות יאכל איבריו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ינתק מאהלו מבטחו,",
                "> ותצעדהו למלך בלהות."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ישכון באהלו גפרית,",
                "> יזרו על נוהו."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> מתחת שרשיו יבשו,",
                "> וממעל יכרת קצירו."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> זכרו אבד מארץ,",
                "> ולא שם לו על פני חוץ."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ידחה מאור אל חשך,",
                "> ומגרשו מתבל."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> לא נין לו ולא נכד בעמו,",
                "> ואין שריד במגוריו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> על יומו ישומו אחרנים,",
                "> וקדמנים אחזו שער."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אך אלה משכנות עול,",
                "> וזה מקום לא ידע אל.”"
            ]
        }
    ]
}