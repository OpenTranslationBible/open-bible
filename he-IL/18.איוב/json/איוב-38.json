{
    "book": "איוב",
    "chapter": 38,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אז דיבר ה' אל איוב מתוך הסערה ואמר:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"מי זה מחשיך עצה במילים חסרות דעת?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> חגור נא כגבר חלציך;",
                "> אשאלך ואתה תודיעני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> איפה היית ביסדי ארץ?",
                "> הגד אם ידעת בינה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מי שם ממדיה כי תדע?",
                "> או מי נטה עליה קו?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> על מה אדניה הטבעו,",
                "> או מי ירה אבן פינתה—"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ברן יחד כוכבי בוקר",
                "> ויריעו כל בני אלוהים?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"ויסך בדלתיים ים",
                "> בגיחו מרחם יצא,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> בשומי ענן לבושו",
                "> וערפל חתולתו,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ואשבור עליו חקי",
                "> ואשים בריח ודלתיים,"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ואומר עד פה תבוא ולא תוסיף;",
                "> ופא ישית בגאון גליך?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"המימיך צוית בוקר,",
                "> ידעת שחר מקומו,"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לאחוז בכנפות הארץ",
                "> וינערו רשעים ממנה?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> תתהפך כחמר חותם",
                "> ויתיצבו כמו לבוש."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> וימנע מרשעים אורם,",
                "> וזרוע רמה תשבר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> \"הבאת עד נבכי ים",
                "> ובחקר תהום התהלכת?"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> הנגלו לך שערי מות?",
                "> ושערי צלמות תראה?"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> התבוננת עד רחבי ארץ?",
                "> הגד אם ידעת כלה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אי זה הדרך ישכן אור,",
                "> וחשך אי זה מקומו,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> כי תקחנו אל גבולו,",
                "> וכי תבין נתיבות ביתו?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ידעת כי אז תולד,",
                "> ומספר ימיך רבים!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> \"הבאת אל אצרות שלג",
                "> ואצרות ברד תראה,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> אשר חשכתי לעת צר,",
                "> ליום קרב ומלחמה?"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> אי זה הדרך יחלק אור,",
                "> יפץ קדים עלי ארץ?"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> מי פלג לשטף תעלה,",
                "> ודרך לחזיז קולות,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> להמטיר על ארץ לא איש,",
                "> מדבר לא אדם בו,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> להשביע שאה ומשאה",
                "> ולהצמיח מוצא דשא?"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> היש למטר אב?",
                "> או מי הוליד אגלי טל?"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> מבטן מי יצא הקרח?",
                "> וכפור שמים מי ילדו"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> כאבן מים יתחבאו,",
                "> ופני תהום יתלכדו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> \"התקשר מעדנות כימה,",
                "> או משכות כסיל תפתח?"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> התוציא מזרות בעתו,",
                "> ועיש על בניה תנחם?"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> הידעת חקות שמים?",
                "> אם תשים משטרו בארץ?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> \"התרים לעב קולך",
                "> ושפעת מים תכסך?"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> התשלח ברקים וילכו",
                "> ויאמרו לך הננו?"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> מי שת בטחות חכמה,",
                "> או מי נתן לשכוי בינה?"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> מי יספר שחקים בחכמה,",
                "> ונבלי שמים מי ישכיב,"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> בצקת עפר למוצק",
                "> ורגבים ידבקו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> \"התצוד ללביא טרף",
                "> וחית כפירים תמלא,"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> כי ישחו במעונות",
                "> ישבו בסכה למו?"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> מי יכין לעורב צידו",
                "> כי ילדיו אל אל ישועו",
                "> יתעו לבלי אוכל?"
            ]
        }
    ]
}