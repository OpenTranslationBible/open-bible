{
    "book": "הושע",
    "chapter": 10,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ישראל גפן בוקק;",
                "> פרי ישווה לו.",
                "> כפי שרבו פירותיו,",
                "> כן הרבה מזבחות;",
                "> כפי שפרחה ארצו,",
                "> כן היטיב מצבות."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> חלקם חלק;",
                "> עתה יישאו את עונם.",
                "> ה' יהרוס את מזבחותיהם",
                "> וישמיד את מצבותיהם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> עתה יאמרו,",
                "> \"אין לנו מלך,",
                "> כי לא יראנו את ה'.",
                "> והמלך, מה יעשה לנו?\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> דברו דברים ריקים,",
                "> בשבועות שקר כרתו בריתות;",
                "> ומשפט יצמח כמו עשבים רעים בתלמי השדה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ייראו יושבי שומרון",
                "> על עגל בית-און.",
                "> אמנם, יתאבלו עליו עמו,",
                "> וכהניו האלילים,",
                "> אשר שמחו עליו ועל כבודו,",
                "> כי גלה ממנו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> גם הוא יובל לאשור",
                "> מנחה למלך ירב;",
                "> יבוש אפרים,",
                "> ויבוש ישראל מעצתו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שומרון ומלכה יאבדו,",
                "> כמו קיסם על פני המים."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ונשמדו במות און, חטאת ישראל;",
                "> קוץ ודרדר יעלה על מזבחותיהם.",
                "> ואמרו להרים, \"כסונו!\"",
                "> ולגבעות, \"נפלו עלינו!\""
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מימי גבעה חטאת, ישראל;",
                "> שם עמדו!",
                "> הלוא תשיגם מלחמה על בני עולה בגבעה?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> באותי אחפוץ, ואיסרם;",
                "> ונאספו עליהם עמים",
                "> בעבותם לשתי עוונותם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ואפרים עגלה מלומדה אוהבת לדוש,",
                "> ואני עברתי על טוב צווארה;",
                "> ארכיב אפרים,",
                "> יהודה יחרוש, יעקב ישדד לו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> זרעו לכם לצדקה,",
                "> קצרו לפי חסד;",
                "> נירו לכם ניר,",
                "> כי עת לדרוש את ה'",
                "> עד יבוא ויורד צדקה לכם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> חרשתם רשע, קצרתם עולה,",
                "> אכלתם פרי כזב.",
                "> כי בטחת בדרכך, ברוב גיבוריך,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> וקם שאון בעמך,",
                "> וכל מבצריך יושדדו,",
                "> כשוד שלמן בית-ארבל ביום מלחמה,",
                "> אם על בנים רוטשה."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ככה עשה לכם בית-אל מפני רעתכם הגדולה;",
                "> בשחר יידמה מלך ישראל."
            ]
        }
    ]
}