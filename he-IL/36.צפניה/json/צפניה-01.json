{
    "book": "צפניה",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "דבר ה' אשר היה אל צפניה בן כושי בן גדליה בן אמריה בן חזקיה בימי יאשיהו בן אמון מלך יהודה:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"אסף אסף כל מעל פני האדמה,\" נאום ה'."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"אסף אדם ובהמה;",
                "> אסף עוף השמים",
                "> ודגי הים,",
                "> והמכשלות את הרשעים;",
                "> והכרתי את האדם מעל פני האדמה,\" נאום ה'."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"ונטיתי ידי על יהודה",
                "> ועל כל יושבי ירושלים;",
                "> והכרתי מן המקום הזה את שארית הבעל,",
                "> את שמות הכמרים עם הכהנים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> המשתחוים על הגגות לצבא השמים,",
                "> והמשתחוים הנשבעים בה' והנשבעים במלכם,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> והנסוגים מאחרי ה'",
                "> ואשר לא דרשו את ה' ולא בקשוהו.\""
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הס מפני אדון ה',",
                "> כי קרוב יום ה';",
                "> כי הכין ה' זבח,",
                "> הקדיש קרואיו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"והיה ביום זבח ה'",
                "> ופקדתי על השרים ועל בני המלך",
                "> ועל כל הלובשים מלבוש נכרי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ופקדתי על כל הדולג על המפתן ביום ההוא,",
                "> הממלאים בית אדוניהם חמס ומרמה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> והיה ביום ההוא,\" נאום ה',",
                "> \"קול צעקה משער הדגים,",
                "> ויללה מן המשנה,",
                "> ושבר גדול מהגבעות."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הילילו יושבי המכתש,",
                "> כי נדמה כל עם כנען;",
                "> נכרתו כל נשאי כסף."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והיה בעת ההיא אחפש את ירושלים בנרות",
                "> ופקדתי על האנשים הקופאים על שמריהם,",
                "> האומרים בלבבם,",
                "> 'לא ייטיב ה' ולא ירע.'"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> והיה חילם למשסה,",
                "> ובתיהם לשממה;",
                "> ובנו בתים ולא ישבו,",
                "> ונטעו כרמים ולא ישתו את יינם.\""
            ]
        },
        {
            "verse": 14,
            "text": [
                "> קרוב יום ה' הגדול",
                "> —קרוב ומהר מאד;",
                "> קול יום ה' מר,",
                "> שם גיבור יצעק."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> יום עברה היום ההוא,",
                "> יום צרה ומצוקה,",
                "> יום שאה ומשואה,",
                "> יום חושך ואפלה,",
                "> יום ענן וערפל,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> יום שופר ותרועה",
                "> על הערים הבצורות",
                "> ועל הפנות הגבוהות."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> \"והצרתי לאדם,",
                "> והלכו כעורים,",
                "> כי לה' חטאו;",
                "> ושפך דמם כעפר",
                "> ולחומם כגללים."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> גם כספם גם זהבם",
                "> לא יוכל להצילם",
                "> ביום עברת ה';",
                "> ובאש קנאתו",
                "> תאכל כל הארץ,",
                "> כי כלה אך נבהלה",
                "> יעשה את כל יושבי הארץ."
            ]
        }
    ]
}