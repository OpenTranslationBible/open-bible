{
    "book": "צפניה",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> אוי לה המורדת והמטונפת,",
                "> העיר הלוחצת!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> לא שמעה בקול,",
                "> לא קיבלה מוסר.",
                "> לא בטחה בה',",
                "> לא קרבה אל אלוהיה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> שריה בקרבה אריות שואגים,",
                "> שופטיה זאבי ערב;",
                "> לא השאירו לבוקר."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> נביאיה אנשי זדון וגאווה;",
                "> כהניה חיללו את הקודש,",
                "> עברו על התורה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ה' צדיק בקרבה;",
                "> לא יעשה עוול.",
                "> בכל בוקר יאיר משפטו;",
                "> לא נעדר.",
                "> והעוול לא ידע בושה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> \"הכרתי גויים;",
                "> פנות מגדליהם שוממות.",
                "> החרבתי רחובותיהם,",
                "> ואין עובר;",
                "> עריהם נהרסו,",
                "> מאין איש, מאין יושב."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אמרתי, 'אך תיראי אותי,",
                "> תקבלי מוסר.'",
                "> ולא ייכרת מעונה",
                "> כל אשר פקדתי עליה.",
                "> אבל הם מהרו להשחית כל מעשיהם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> לכן חכו לי,\" נאום ה',",
                "> \"ליום קומי לעד.",
                "> כי משפטי לאסוף גויים,",
                "> לקבץ ממלכות,",
                "> לשפוך עליהם זעמי,",
                "> כל חרון אפי;",
                "> כי באש קנאתי תאכל כל הארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אז אהפוך אל עמים",
                "> שפה ברורה,",
                "> לקרוא כולם בשם ה',",
                "> לעבדו שכם אחד."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> מעבר לנהרי כוש",
                "> עטרי, בת פזורי,",
                "> יביאו מנחתי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ביום ההוא לא תבושי",
                "> מכל עלילותיך",
                "> אשר פשעת בי;",
                "> כי אז אסיר מקרבך",
                "> עליזי גאוותך,",
                "> ולא תוסיפי לגבהה בהר קודשי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והשארתי בקרבך",
                "> עם עני ודל,",
                "> וחסו בשם ה'."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> שארית ישראל לא יעשו עוולה",
                "> ולא ידברו כזב,",
                "> ולא ימצא בפיהם",
                "> לשון תרמית;",
                "> כי הם ירעו ורבצו",
                "> ואין מחריד.\""
            ]
        },
        {
            "verse": 14,
            "text": [
                "> רני בת ציון!",
                "> הריעי ישראל!",
                "> שמחי ועלזי בכל לבך,",
                "> בת ירושלים!"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הסיר ה' משפטיך,",
                "> פנה אויבך.",
                "> מלך ישראל, ה', בקרבך;",
                "> לא תראי רע עוד."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ביום ההוא יאמר לירושלים:",
                "> \"אל תיראי, ציון;",
                "> אל ירפו ידיך."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ה' אלוהיך בקרבך,",
                "> גיבור יושיע.",
                "> ישיש עלייך בשמחה,",
                "> יחריש באהבתו,",
                "> יגיל עלייך ברינה."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אספתי את המוגים ממועד—",
                "> ממך, ציון;",
                "> חרפת הגלות משא עליהם."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> הנה אני עושה בעת ההיא",
                "> לכל מעניך;",
                "> והושעתי את הצולעה",
                "> ואספתי את הנדחה,",
                "> ושמתי אותם לתהילה ולשם",
                "> בכל הארץ."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> בעת ההיא אביא אתכם,",
                "> גם בעת קבצי אתכם;",
                "> כי אתן אתכם לשם ולתהילה",
                "> בכל עמי הארץ,",
                "> בשובי את שבותיכם לעיניכם,\"",
                "> אמר ה'."
            ]
        }
    ]
}