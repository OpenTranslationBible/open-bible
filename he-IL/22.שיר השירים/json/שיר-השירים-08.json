{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "מי יתנך כאח לי,",
                "יונק שדי אמי;",
                "אמצאך בחוץ, אשקך,",
                "גם לא יבוזו לי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "אנהגך אביאך",
                "אל בית אמי תלמדני;",
                "אשקך מיין הרקח",
                "מעסיס רמוני."
            ]
        },
        {
            "verse": 3,
            "text": [
                "שמאלו תחת ראשי,",
                "וימינו תחבקני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "השבעתי אתכן,",
                "בנות ירושלים,",
                "אל תעירו ואל תעוררו את האהבה",
                "עד שתחפץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "מי זאת עולה מן המדבר",
                "מתרפקת על דודה?",
                "תחת התפוח עוררתיך;",
                "שם חבלתך אמך,",
                "שם חבלה ילדתך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "שימני כחותם על לבך,",
                "כחותם על זרועך;",
                "כי עזה כמוות אהבה,",
                "קשה כשאול קנאה;",
                "רשפיה רשפי אש,",
                "שלהבתיה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "מים רבים לא יוכלו לכבות את האהבה,",
                "ונהרות לא ישטפוה;",
                "אם יתן איש את כל הון ביתו באהבה,",
                "בוז יבוזו לו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "אחות לנו קטנה,",
                "ושדים אין לה;",
                "מה נעשה לאחותנו",
                "ביום שידובר בה?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "אם חומה היא,",
                "נבנה עליה טירת כסף;",
                "ואם דלת היא,",
                "נצור עליה לוח ארז."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "אני חומה ושדי כמגדלות;",
                "אז הייתי בעיניו",
                "כמוצאת שלום."
            ]
        },
        {
            "verse": 11,
            "text": [
                "כרם היה לשלמה בבעל המון;",
                "נתן את הכרם לנוטרים.",
                "איש יביא בפריו אלף כסף."
            ]
        },
        {
            "verse": 12,
            "text": [
                "כרמי שלי לפני;",
                "האלף לך, שלמה,",
                "ומאתיים לנוטרים את פריו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "היושבת בגנים,",
                "חברים מקשיבים לקולך—",
                "השמיעיני!"
            ]
        },
        {
            "verse": 14,
            "text": [
                "ברח דודי,",
                "ודמה לך לצבי או לעופר האיילים",
                "על הרי בשמים."
            ]
        }
    ]
}