{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "智慧的儿子听从父亲的教导，亵慢人却不理会责备。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "人因口所结的果子，必享美福，奸诈人的心愿乃是强暴。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "谨守口的，得保生命；大张嘴的，必致败亡。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "懒惰人的心愿得不到什么，殷勤人的心愿却得以满足。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "义人恨恶谎言，恶人行事可耻且令人厌恶。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "公义护卫行为正直的人，罪恶倾覆恶人。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "有人假装富足却一无所有，有人假装贫穷却有大财。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "人的财富可以赎他的命，穷人却听不见威吓。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "义人的光明欢喜，恶人的灯必熄灭。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "骄傲只启争端，听劝言的却有智慧。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "不劳而得之财必然消耗，积少成多者必然增加。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "盼望迟延令人心忧，所愿成就却是生命树。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "藐视训言的必自取其害，敬畏诫命的必得善报。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "智慧人的教训是生命的泉源，可以使人离开死亡的网罗。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "美好的聪明使人蒙恩，奸诈人的道路却致败亡。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "凡通达人都凭知识行事，愚昧人却显露愚妄。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "恶使者必陷祸患，忠信使者却带来医治。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "弃绝管教的，必致贫受辱，领受责备的，必得尊荣。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "心愿得成，令人甘甜；离弃恶事，为愚昧人所憎恶。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "与智慧人同行的，必得智慧；和愚昧人作伴的，必受亏损。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "祸患追赶罪人，义人必得善报。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "善人给子孙遗留产业，罪人的财物却为义人积存。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "穷人的耕地多有粮食，但因不义而被夺去。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "不忍用杖打儿子的，是恨恶他；疼爱儿子的，随时管教。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "义人吃得饱足，恶人的肚腹却常饥饿。"
            ]
        }
    ]
}