{
    "book": "箴言",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "我儿，你若领受我的言语，珍藏我的命令在你心里，"
            ]
        },
        {
            "verse": 2,
            "text": [
                "侧耳听智慧，专心求聪明，"
            ]
        },
        {
            "verse": 3,
            "text": [
                "呼求明哲，扬声求聪明，"
            ]
        },
        {
            "verse": 4,
            "text": [
                "寻找它如寻找银子，搜求它如搜求隐藏的珍宝，"
            ]
        },
        {
            "verse": 5,
            "text": [
                "你就明白敬畏耶和华，得以认识神。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "因为耶和华赐人智慧；知识和聪明都由他口而出。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "他给正直人存留真智慧，给行为纯正的人作盾牌，"
            ]
        },
        {
            "verse": 8,
            "text": [
                "为要保守公平人的路，护卫虔诚人的道。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "你就明白仁义、公平、正直，一切的善道。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "智慧必入你心，知识必令你灵魂愉悦。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "谋略必护卫你，聪明必保守你。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "要救你脱离恶道，脱离说乖谬话的人，"
            ]
        },
        {
            "verse": 13,
            "text": [
                "那些离弃正直的路，行走黑暗道的人，"
            ]
        },
        {
            "verse": 14,
            "text": [
                "他们喜爱作恶，欢喜恶人的乖僻，"
            ]
        },
        {
            "verse": 15,
            "text": [
                "在他们的道中弯曲，在他们的路上偏僻。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "要救你脱离淫妇，脱离那油嘴滑舌的外女，"
            ]
        },
        {
            "verse": 17,
            "text": [
                "她离弃幼年的配偶，忘了她神的盟约。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "她的家陷入死地，她的路偏向阴间。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "凡到她那里去的，不得转回，也得不着生命的路。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "你必行善人的道，守义人的路。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "正直人必在世上居住，完全人必在地上存留；"
            ]
        },
        {
            "verse": 22,
            "text": [
                "惟有恶人必然剪除，奸诈的必然拔出。"
            ]
        }
    ]
}