{
    "book": "诗篇",
    "chapter": 149,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 赞美主！",
                "> 向主唱一首新歌，",
                "> 在忠实者的会中赞美祂。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 以色列要因造物主欢喜；",
                "> 锡安的子民要因他们的君王快乐。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 他们要跳舞赞美祂的名；",
                "> 要用手鼓和琴歌颂祂。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 因为主喜爱祂的子民；",
                "> 祂要用救恩装饰谦卑的人。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 忠实者要因荣耀欢喜；",
                "> 他们要在床上欢呼。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 神的高赞要在他们口中，",
                "> 双刃的剑要在他们手中，"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 为要向列国施行报应，",
                "> 向万民施行惩罚，"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 要用链子捆绑他们的君王，",
                "> 用铁镣锁住他们的贵族，"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 要执行所写的判决。",
                "> 这荣耀是祂所有忠实者的。",
                "> 赞美主！"
            ]
        }
    ]
}