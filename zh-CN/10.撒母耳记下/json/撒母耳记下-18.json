{
    "book": "撒母耳记下",
    "chapter": 18,
    "verses": [
        {
            "verse": 1,
            "text": [
                "大卫数点跟随他的人，",
                "立千夫长、百夫长率领他们。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "大卫打发军队出去：三分之一在约押手下，",
                "三分之一在洗鲁雅的儿子约押兄弟亚比筛手下，",
                "三分之一在迦特人以太手下。",
                "王对百姓说：",
                "“我必与你们一同出战。”"
            ]
        },
        {
            "verse": 3,
            "text": [
                "百姓却说：",
                "“你不可出战。若我们逃跑，他们不会理会我们；",
                "即使我们的一半人死了，他们也不会理会。",
                "但你如同我们的一万。",
                "所以你最好在城里准备帮助我们。”"
            ]
        },
        {
            "verse": 4,
            "text": [
                "王对他们说：",
                "“你们看怎样好，我就怎样行。”",
                "于是王站在城门旁，",
                "众百姓按着百人千人出去了。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "王嘱咐约押、亚比筛、以太说：",
                "“你们要为我的缘故宽待那少年人押沙龙。”",
                "王为押沙龙嘱咐众将领的话，百姓都听见了。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "于是百姓出到田野迎着以色列人，",
                "在以法莲的树林里交战。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "在那里，以色列人被大卫的仆人打败，",
                "那日阵亡的人甚多，共有二万人。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "战事遍及全地，",
                "那日树林吞灭的人比刀剑吞灭的更多。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "押沙龙偶遇大卫的仆人。",
                "押沙龙骑着骡子，",
                "骡子经过大橡树密枝下，",
                "他的头被树枝缠住，",
                "就悬挂在天地之间，",
                "骡子便离他而去。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "有个人看见，就告诉约押说：",
                "“我看见押沙龙挂在橡树上了。”"
            ]
        },
        {
            "verse": 11,
            "text": [
                "约押对报信的人说：",
                "“你既看见他，为什么不在那里打他落地呢？",
                "我必赏你十块银子和一条带子。”"
            ]
        },
        {
            "verse": 12,
            "text": [
                "那人对约押说：",
                "“我就是得你一千块银子，",
                "我也不敢伸手害王的儿子；",
                "因为我们听见王嘱咐你、亚比筛、以太说：",
                "‘你们要谨慎，不可伤害那少年人押沙龙。’"
            ]
        },
        {
            "verse": 13,
            "text": [
                "若我妄为害了他的性命，",
                "就是你也必与我为敌，",
                "因为无论何事都瞒不过王。”"
            ]
        },
        {
            "verse": 14,
            "text": [
                "约押说：",
                "“我不能与你在这里耽搁。”",
                "他手拿三杆短枪，",
                "趁押沙龙在橡树上还活着，刺透他的心。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "给约押拿兵器的十个少年人围绕押沙龙，",
                "击杀他，将他杀死。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "约押吹角，",
                "众民就回来，不再追赶以色列人，",
                "因为约押拦阻他们。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "他们将押沙龙丢在林中一个大坑里，",
                "在他上头堆起一大堆石头。",
                "以色列众人都逃跑，各回各家去了。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "押沙龙活着的时候，在王谷立了一根石柱，",
                "因为他说：“我没有儿子为我留名。”",
                "他就以自己的名给石柱起名，",
                "叫押沙龙柱，直到今日。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "撒督的儿子亚希玛斯说：",
                "“让我跑去报信给王，",
                "耶和华已为他伸冤，救他脱离仇敌之手。”"
            ]
        },
        {
            "verse": 20,
            "text": [
                "约押对他说：",
                "“你今日不可去报信，改日可以报信。",
                "因为今日王的儿子死了，所以你不可去报信。”"
            ]
        },
        {
            "verse": 21,
            "text": [
                "约押对古示人说：",
                "“你去将你所看见的告诉王。”",
                "古示人在约押面前下拜，就跑去了。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "撒督的儿子亚希玛斯又对约押说：",
                "“无论怎样，求你让我也跟随古示人跑。”",
                "约押说：“我儿，你报这信息既无赏赐，何必要跑呢？”"
            ]
        },
        {
            "verse": 23,
            "text": [
                "他说：“无论怎样，我要跑。”",
                "约押说：“你跑去吧。”",
                "亚希玛斯就从平原往前跑，跑过了古示人。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "大卫正坐在两门之间，",
                "守望的人上城门楼顶，",
                "举目观看，见有一个人独自跑来。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "守望的人就大声告诉王。",
                "王说：“他若独自来，必是报好信息。”",
                "那人跑得渐渐近了。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "守望的人又见一个人跑来，",
                "就对守城门的人说：",
                "“又有一个人独自跑来。”",
                "王说：“这也必是报好信息的。”"
            ]
        },
        {
            "verse": 27,
            "text": [
                "守望的人说：",
                "“我看前头人的跑法，好像撒督的儿子亚希玛斯的跑法。”",
                "王说：“他是个好人，必是报好信息。”"
            ]
        },
        {
            "verse": 28,
            "text": [
                "亚希玛斯向王呼叫，说：",
                "“一切平安。”",
                "就在王面前脸伏于地叩拜，说：",
                "“耶和华你的神是应当称颂的，",
                "因他已将那举手攻击我主我王的人交给王了。”"
            ]
        },
        {
            "verse": 29,
            "text": [
                "王说：",
                "“少年人押沙龙平安不平安？”",
                "亚希玛斯回答说：",
                "“约押打发王的仆人我仆人时，我看见群众大大喧哗，",
                "却不知道是什么事。”"
            ]
        },
        {
            "verse": 30,
            "text": [
                "王说：“你退去，站在旁边。”",
                "他就退去，站在旁边。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "古示人也来到，说：",
                "“有信息报给我主我王，",
                "因为今日耶和华为你伸冤，",
                "救你脱离一切起来攻击你的人。”"
            ]
        },
        {
            "verse": 32,
            "text": [
                "王问古示人说：",
                "“少年人押沙龙平安不平安？”",
                "古示人回答说：",
                "“愿我主我王的仇敌和一切兴起要害你的人，",
                "都与那少年人一样。”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "王就心里伤痛，",
                "上城门楼去哀哭。",
                "一面走一面说：",
                "“我儿押沙龙啊，我儿，我儿押沙龙啊！",
                "我恨不得替你死，",
                "押沙龙啊，我儿，我儿！”"
            ]
        }
    ]
}