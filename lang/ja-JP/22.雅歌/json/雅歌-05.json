{
    "book": "ソロモンの歌",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "私は私の庭に来た、わが妹、わが花嫁よ。",
                "私は没薬とバルサムを集め、",
                "蜂の巣と蜜を食べ、",
                "ぶどう酒と乳を飲んだ。",
                "食べよ、友よ。",
                "飲め、愛に酔いしれよ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "私は眠っていたが、私の心は目覚めていた。",
                "声がする。私の愛する人が戸口にいた。",
                "「開けておくれ、わが妹、愛しい人、",
                "わが鳩、傷のない人よ。",
                "私の頭は露でぬれ、",
                "髪は夜のしずくでぬれている。」"
            ]
        },
        {
            "verse": 3,
            "text": [
                "「私はもう長服を脱いでしまった。",
                "どうしてまた着られよう。",
                "足を洗ってしまった。",
                "どうしてまた汚せよう。」"
            ]
        },
        {
            "verse": 4,
            "text": [
                "私の愛する人が戸の隙間から手を差し入れ、",
                "私の心は彼のために揺れ動いた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "私は愛する人のために開けようと立ち上がった。",
                "私の手は没薬にまみれ、",
                "私の指は、閂の取っ手の上で、",
                "流れる没薬にまみれていた。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "私は愛する人のために開けたが、",
                "愛する人は背を向けて去ってしまっていた。",
                "彼が去ったとき、私の魂は消え入った。",
                "私は彼を探したが見つけられなかった。",
                "私は彼を呼んだが、彼は答えなかった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "町を巡回する見張りたちが私を見つけ、",
                "私を打ち、傷つけた。",
                "城壁の番人たちは私の肩掛けを私から奪い取った。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "エルサレムの娘たちよ、",
                "あなたがたに誓わせる。",
                "もし私の愛する人を見つけたら、",
                "彼に何を告げるのかというと――私は恋わずらいだ、",
                "と。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "あなたの愛する人は、どのような愛する人なのか、",
                "女たちの中で最も美しい人よ。",
                "あなたの愛する人は、どのような愛する人なのか、",
                "私たちにこのように誓わせるとは。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "私の愛する人はまばゆく、赤みを帯び、",
                "万人の中で抜きん出ている。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "彼の頭は精錬された金のようだ。",
                "彼の髪はナツメヤシの房のようで、",
                "カラスのように黒い。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "彼の目は水の流れのそばの鳩のようで、",
                "ミルクに浸され、",
                "完璧に配置されている。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "彼の頬は香料の花壇のようで、",
                "香り高い草の土手のようだ。",
                "彼の唇はユリで、",
                "液体の没薬が滴っている。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼の手はトパーズで飾られた金の棒だ。",
                "彼の腹は彫られた象牙で、",
                "サファイアがはめ込まれている。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼の脚は純金の台座に立つアラバスターの柱だ。",
                "彼の姿はレバノンのように威厳があり、",
                "杉のように選び抜かれている。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼の口は甘美に満ち、",
                "彼はまったく愛らしい。",
                "これが私の愛する人、これが私の友だ、",
                "エルサレムの娘たちよ。"
            ]
        }
    ]
}
