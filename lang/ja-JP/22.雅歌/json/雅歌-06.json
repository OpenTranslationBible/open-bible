{
    "book": "雅歌",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "あなたの愛する人はどこへ行ったのですか、",
                "女性の中で最も美しい方よ。",
                "あなたの愛する人はどこへ向かったのですか、",
                "私たちがあなたと一緒に彼を探すために。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "私の愛する人は彼の庭に下り、",
                "バルサムの花壇へ、",
                "庭で彼の群れを飼い、",
                "ユリを集めるために。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "私は私の愛する人のものであり、私の愛する人は私のものです、",
                "彼はユリの間で彼の群れを飼う。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "あなたはティルツァのように魅力的です、私の愛しい人よ、",
                "エルサレムのように美しく、",
                "旗を掲げた軍隊のように威厳があります。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "私から目をそらしてください、",
                "それは私を圧倒したからです。",
                "あなたの髪はギルアデから下るヤギの群れのようです。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "あなたの歯は洗い場から上がってきた羊の群れのようです、",
                "すべてが双子を産み、",
                "その中の一つも子を失っていません。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "あなたのこめかみはあなたのベールの後ろのザクロの内側のようです。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "六十人の王妃と八十人の側女、",
                "数え切れないほどの乙女たちがいます。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "しかし、私の鳩、私の完璧な者は一人です。",
                "彼女は彼女の母の唯一の娘です。",
                "彼女は彼女を産んだ者の大切な子です。",
                "若い女性たちは彼女を見て祝福されたと言い、",
                "王妃たちと側女たちも彼女を称賛し、こう言いました、"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "「これは誰ですか、夜明けのように現れる者、",
                "満月のように美しく、",
                "太陽のように純粋で、",
                "旗を掲げた軍隊のように威厳がある者は？」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "私はクルミの木の林に下り、",
                "谷の花を見に行きました、",
                "ブドウの木が芽を出したかどうか、",
                "ザクロが咲いたかどうかを見に。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "私が気づく前に、私の魂は私を",
                "私の高貴な人々の戦車の中に置きました。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "戻ってきてください、戻ってきてください、シュラムの女よ。",
                "戻ってきてください、戻ってきてください、私たちがあなたを見るために！",
                "なぜあなたはシュラムの女を見るのですか、",
                "二つの軍隊の踊りのように？"
            ]
        }
    ]
}