{
    "book": "雅歌",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "あなたの愛する人はどこへ行ったのか、",
                "女たちの中で最も美しい人よ。",
                "あなたの愛する人はどこへ向かったのか、",
                "私たちがあなたと共に彼を探すために。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "私の愛する人は自分の庭へ、",
                "バルサムの花壇へ下りていった。",
                "庭で群れを飼い、",
                "ゆりを摘むために。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "私は私の愛する人のもの、私の愛する人は私のもの。",
                "彼はゆりの間で群れを飼っている。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "愛しい人よ、あなたはティルツァのように魅惑的で、",
                "エルサレムのように美しく、",
                "旗を掲げた軍勢のように堂々としている。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "私から目をそらして。",
                "あなたの目は私を圧倒した。",
                "あなたの髪はギルアデを下ってくるやぎの群れのようだ。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "あなたの歯は、洗い場から上がってきた雌羊の群れのようで、",
                "どれも双子を産み、",
                "一匹として子を失ったものはない。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "ベールの後ろのあなたのこめかみは、ざくろの内側のようだ。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "六十人の王妃と八十人の側女、",
                "そして数えきれないほどの乙女たちがいるが、"
            ]
        },
        {
            "verse": 9,
            "text": [
                "私の鳩、私の完全な人はただ一人だ。",
                "彼女は母の一人娘、",
                "産んだ人の大切な子である。",
                "若い女たちは彼女を見て幸いな人と呼び、",
                "王妃たちも側女たちも彼女を称賛して、こう言った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "「夜明けのように現れ、満月のように美しく、",
                "太陽のように清らかで、",
                "旗を掲げた軍勢のように堂々としているこの人は誰か。",
                "」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "私はくるみの林へ下りて行き、",
                "谷の花を見、",
                "ぶどうの木が芽ぐんだか、",
                "ざくろが咲いたかを見ようとした。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "気がつかないうちに、私の魂は私を、",
                "わが高貴な民の戦車の間に置いた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "戻れ、戻れ、シュラムの女よ。戻れ、戻れ、",
                "私たちがあなたを見られるように。",
                "なぜシュラムの女を見るのか、",
                "二つの軍の踊りを見るように。"
            ]
        }
    ]
}
