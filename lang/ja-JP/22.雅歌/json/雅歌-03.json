{
    "book": "ソロモンの歌",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "夜ごと、寝床の上で、",
                "私は私の魂が愛する人を探した。",
                "探したが、見つけられなかった。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "私は今、起きて町を歩き回り、",
                "通りや広場で、",
                "私の魂が愛する人を探さなければならない。",
                "私は彼を探したが、見つけられなかった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "町を巡回する見張りの者たちが私を見つけた。",
                "私は尋ねた。",
                "「私の魂が愛する人を見ましたか。」"
            ]
        },
        {
            "verse": 4,
            "text": [
                "彼らのそばを通り過ぎるとすぐに、",
                "私の魂が愛する人を見つけた。",
                "私は彼をつかんで離さず、私の母の家に、",
                "私を身ごもった人の部屋に連れて行くまで放さなかった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "エルサレムの娘たちよ、",
                "ガゼルや野の雌鹿にかけて、",
                "あなたがたに誓わせる。",
                "愛が望むときまでは、愛を呼び覚ましたり、",
                "かき立てたりしないと。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "荒野から上ってくる、煙の柱のようなこれは何か。",
                "没薬と乳香で香り、",
                "商人のあらゆる香粉で香っている。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "見よ、ソロモンの旅の寝台だ。",
                "その周りには六十人の勇士がいる。",
                "イスラエルの勇士たちである。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "彼らは皆、剣を取る者、",
                "戦いに慣れた者である。",
                "それぞれ腰に剣を帯び、",
                "夜の恐怖に備えている。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "ソロモン王は、",
                "レバノンの木材で自分のために輿を作った。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼はその柱を銀で、",
                "背を金で作り、",
                "座を紫の布で造った。",
                "その内側は、エルサレムの娘たちによって愛を込めて飾られていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "出て行け、シオンの娘たちよ。",
                "ソロモン王を見よ。婚礼の日、",
                "彼の心の喜びの日に、",
                "母が彼にかぶせた冠をつけた王を。"
            ]
        }
    ]
}
