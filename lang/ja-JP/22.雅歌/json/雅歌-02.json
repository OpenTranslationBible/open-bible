{
    "book": "雅歌",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "私はシャロンのばら、",
                "谷間のゆりのようだ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "いばらの中のゆりのように、",
                "若い女たちの中の私の愛しい人はそうだ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "森の木々の中でりんごの木が目立つように、",
                "若い男たちの中で私の愛する人はそうだ。",
                "その陰で私は大いに喜んで座り、",
                "その実は私の口に甘かった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "彼は私を宴の場に導いた。",
                "私の上にある彼の旗は愛である。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "干しぶどうの菓子で私を元気づけ、",
                "りんごで私を支えて。",
                "私は恋わずらいなのだから。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "彼の左手は私の頭を支え、",
                "彼の右手は私をしっかり抱きしめる。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "エルサレムの娘たちよ、",
                "ガゼルや野の雌鹿にかけて、",
                "あなたがたに誓わせる。",
                "愛が望むときまでは、愛を呼び覚ましたり、",
                "かき立てたりしないと。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "私の愛する人の声。",
                "見よ、彼が来る。",
                "山々を跳び越え、",
                "丘を飛び越えて。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "私の愛する人はガゼルか若い牡鹿のようだ。",
                "見よ、彼は私たちの壁の後ろに立ち、",
                "窓から見つめ、",
                "格子の間からうかがっている。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "私の愛する人は私に語りかけて言った。",
                "「立ち上がれ、愛しい人、美しい人よ。",
                "さあ、来なさい。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "見よ、冬は過ぎ去り、",
                "雨はやんで去った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "花が地に姿を現し、",
                "ぶどうの枝を刈り込む時が来た。",
                "山鳩の声が私たちの地に聞こえている。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "いちじくの木は実を熟させ、",
                "花盛りのぶどうの木は香りを放っている。",
                "立ち上がれ、愛しい人、美しい人よ。",
                "さあ、来なさい。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "岩の裂け目にいる私の鳩よ、",
                "山道の隠れ場にいる私の鳩よ。",
                "あなたの姿を見せて、",
                "あなたの声を聞かせて。",
                "あなたの声は甘く、",
                "あなたの姿は愛らしいから。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "私たちのために狐を捕まえて。",
                "ぶどう畑を荒らす小さな狐たちを。",
                "私たちのぶどう畑が花盛りの間に。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "私の愛する人は私のもの、私は彼のもの。",
                "彼はゆりの間で群れを飼う。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "日が息づき、影が逃げ去るまで、",
                "戻ってきて、私の愛する人よ。ガゼルのように、",
                "険しい丘の若い牡鹿のようになって。"
            ]
        }
    ]
}
