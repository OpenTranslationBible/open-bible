{
    "book": "ソロモンの歌",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ああ、あなたが私の母の乳を飲んだ兄弟のようであったなら。",
                "外であなたを見つけたら口づけするのに、",
                "誰も私を軽んじはしないだろう。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "私はあなたを導いて、",
                "私を教えてくれた母の家に連れて行き、",
                "香料入りのぶどう酒を、",
                "私のざくろの汁から飲ませるだろう。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "彼の左手は私の頭を支え、",
                "彼の右手は私をしっかり抱きしめる。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "エルサレムの娘たちよ、",
                "あなたがたに誓わせる。",
                "愛が望むときまでは、愛を呼び覚ましたり、",
                "かき立てたりしないと。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "愛する人に寄りかかって、",
                "荒野から上ってくるのは誰か。」",
                "「りんごの木の下で、私はあなたを目覚めさせた。",
                "そこであなたの母はあなたのために産みの苦しみを味わい、",
                "そこで産みの苦しみをして、あなたを産んだ。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "私を印章のようにあなたの心に置いて、",
                "印章のようにあなたの腕に置いて。",
                "愛は死のように強く、",
                "情熱は墓のように容赦ない。",
                "その閃きは火の閃き、",
                "神の炎である。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "大水も愛を消すことはできず、",
                "川もそれを押し流せない。",
                "人が愛と引き換えに家の富をすべて差し出しても、",
                "それはまったく軽蔑されるだろう。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "私たちには小さな妹がいるが、",
                "彼女はまだ成熟していない。",
                "妹に求婚の話が来る日、",
                "私たちは妹のために何をしようか。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "もし彼女が壁なら、",
                "私たちはその上に銀の胸壁を築こう。",
                "もし彼女が扉なら、",
                "杉の板で閉ざそう。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "私は壁であり、私の背丈は塔のようだった。",
                "そのとき私は彼の目に、",
                "平安を見いだす者のようになった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "ソロモンはバアル・ハモンにぶどう畑を持っていた。",
                "彼はそのぶどう畑を管理人たちに貸した。",
                "それぞれ、その実のために銀千シェケルを納めることになっていた。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "私自身のぶどう畑は私の自由になる。",
                "千シェケルはあなたのもの、ソロモンよ、",
                "二百はその実を管理する者たちのものだ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "園に住む人よ、",
                "仲間たちがあなたの声に耳を傾けている――私にも聞かせて。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "急いで、私の愛する人よ、",
                "香り高い山々の上の、",
                "速いガゼルか若い牡鹿のようになって。"
            ]
        }
    ]
}
