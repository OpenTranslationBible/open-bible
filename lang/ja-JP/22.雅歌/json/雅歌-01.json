{
    "book": "雅歌",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ソロモンに帰せられる、最も優れた歌。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "どうか、あの人がその口の口づけで私に口づけしてくれますように。",
                "あなたの愛はぶどう酒よりも心地よいから。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "あなたの香油は心地よい香りを放ち、",
                "あなたの名は精製された油のようだ。",
                "それゆえ、若い娘たちはあなたを慕う。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "私を引き寄せて。一緒に走ろう。",
                "王は私をその部屋に連れて行った。",
                "私たちはあなたによって喜び楽しみ、",
                "あなたの愛をぶどう酒よりもほめよう。",
                "人々があなたを愛するのは当然だ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "私は黒くて美しい、",
                "エルサレムの娘たちよ、",
                "ケダルの天幕のように、",
                "ソロモンの幕のように。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "私が黒くなったからといって、見つめないで。",
                "太陽が私を焼いたのだから。",
                "母の息子たちは私に怒り、",
                "私をぶどう畑の番人にしたが、",
                "私は自分のぶどう畑の世話をしなかった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "教えて、私の魂が愛するあなた。",
                "あなたはどこで群れを飼い、",
                "正午にはどこで休ませるのか。",
                "なぜ私は、",
                "あなたの仲間たちの群れのそばで顔を覆う女のようでなければならないのか。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "わからないなら、",
                "女たちの中で最も美しい人よ、",
                "群れの足跡をたどり、",
                "羊飼いたちの天幕のそばで、",
                "あなたの子やぎを飼いなさい。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "愛しい人よ、あなたは私にとって、",
                "ファラオの戦車の中のわが牝馬のようだ。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "あなたの頬は飾りで愛らしく、",
                "あなたの首は玉の連なりで愛らしい。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "私たちはあなたのために、金の飾りを作り、",
                "銀の玉をあしらおう。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "王が食卓についている間、",
                "私の香料はその香りを放った。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "私の愛する人は私にとって、没薬の小袋のようで、",
                "夜通し私の胸の間に休んでいる。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "私の愛する人は私にとって、",
                "エンゲディの園のヘンナの花房のようだ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "愛しい人よ、なんと美しいのだろう、",
                "なんと美しいのだろう。",
                "あなたの目は鳩のようだ。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "私の愛する人よ、なんと麗しく、",
                "なんと心地よいのだろう。まことに、",
                "私たちの寝床は緑に茂っている。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "私たちの家の梁は杉で、",
                "垂木は糸杉でできている。"
            ]
        }
    ]
}
