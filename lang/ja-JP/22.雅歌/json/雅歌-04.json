{
    "book": "雅歌",
    "chapter": 4,
    "verses": [
        {
            "verse": 1,
            "text": [
                "愛しい人よ、なんと麗しいのだろう、",
                "なんと麗しいのだろう。",
                "ベールの後ろのあなたの目は鳩のようだ。",
                "あなたの髪は、",
                "ギルアデの山を下ってくるやぎの群れのように波打つ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "あなたの歯は、",
                "洗い場から上がってきた毛を刈ったばかりの羊の群れのようで、",
                "どれも双子を産み、",
                "一匹として子を失ったものはない。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "あなたの唇は緋色の糸のようで、",
                "あなたの口は愛らしい。",
                "ベールの後ろのあなたのこめかみは、",
                "ざくろを割ったひと切れのようだ。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "あなたの首は、",
                "石を層にして建てられたダビデの塔のようで、",
                "そこには千の盾が掛けられ、",
                "そのすべてが勇士たちの丸い盾である。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "あなたの二つの乳房は、ゆりの間で草を食べる、",
                "ガゼルの双子の二匹の子鹿のようだ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "日が涼しい風を吹かせ、",
                "影が逃げ去るときまで、",
                "私は没薬の山へ、",
                "乳香の丘へ行こう。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "愛しい人よ、あなたはすべてが美しく、",
                "あなたには欠点がない。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "レバノンから私と来てくれ、わが花嫁よ。",
                "レバノンから私と共に来てくれ。アマナの頂から、",
                "セニルとヘルモンの頂から、",
                "ライオンの巣から、",
                "ヒョウの山々から下りてきてくれ。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "わが妹、わが花嫁よ、あなたは私の心を奪った。",
                "あなたの目のただひと目で、",
                "首飾りのただひと筋で、私の心を奪った。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "わが妹、わが花嫁よ、あなたの愛はなんと心地よいことか。",
                "あなたの愛はぶどう酒よりどれほど優れ、",
                "あなたの香油の香りはあらゆるバルサム油にどれほどまさることか。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "わが花嫁よ、あなたの唇は蜜を滴らせ、",
                "蜜と乳があなたの舌の下にあり、",
                "あなたの衣の香りはレバノンの香りのようだ。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "わが妹、わが花嫁は閉ざされた園、",
                "閉ざされた井戸、封じられた泉である。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "あなたの枝は、",
                "心地よい実をつけるざくろの園のようで、",
                "ヘンナとナルドの草がある。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "ナルドとサフラン、香りのある葦とシナモン、",
                "あらゆる乳香の木々、",
                "没薬とアロエ、あらゆる最上のバルサム油と共に。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "あなたは庭の泉、",
                "清らかな水の井戸、",
                "レバノンから流れ下る小川のようだ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "目覚めよ、北風よ。",
                "来て、南風よ。",
                "私の庭に吹いて、その香りを漂わせ、",
                "そのバルサム油を流れさせて。",
                "私の愛する人が自分の庭に来て、",
                "その心地よい実を食べますように。"
            ]
        }
    ]
}
