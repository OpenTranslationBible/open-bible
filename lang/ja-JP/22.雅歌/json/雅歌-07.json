{
    "book": "雅歌",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "サンダルをはいたあなたの足は、なんと美しいことか、",
                "王子の娘よ。",
                "腰のまるみは宝石のようで、",
                "名匠の手のわざである。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "あなたのへそは丸い杯で、",
                "混ぜたぶどう酒が絶えることがない。",
                "あなたの腹は、",
                "ゆりで囲まれた小麦の山のようだ。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "あなたの二つの乳房は、ガゼルの双子の、",
                "愛らしい子鹿のようだ。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "あなたの首は象牙の塔のように優美で、",
                "あなたの目はバテ・ラビムの門のそばのヘシュボンの静かな池のようだ。",
                "あなたの鼻は、",
                "ダマスコの方を見渡すレバノンの塔のように気品がある。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "あなたの頭はカルメルのように堂々とし、",
                "あなたの頭の流れる髪は紫の糸のようだ。",
                "王はあなたの巻き毛に魅せられている。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "愛しい人よ、あなたはなんと麗しく、",
                "なんと心地よいことか、そのすべての魅力のゆえに。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "あなたの背丈はヤシの木のようで、",
                "あなたの乳房はその房のようだ。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "私は言った。「私はヤシの木に登り、",
                "その実の茎をつかもう。",
                "ああ、あなたの乳房がぶどうの房のように、",
                "あなたの息の香りがりんごのようであるように、"
            ]
        },
        {
            "verse": 9,
            "text": [
                "あなたの口が最上のぶどう酒のようであるように。」",
                "それは私の愛する人のためにするりと流れ、",
                "休む者たちの唇の上を静かに流れる。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "私は私の愛する人のもの、",
                "彼の思いは私に向かっている。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "来て、私の愛する人よ、野へ出よう。",
                "村々で夜を過ごそう。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "早く起きてぶどう畑へ行こう。",
                "ぶどうの木が芽ぐんだか、",
                "花が開いたか、",
                "ざくろが咲いたかを見よう。",
                "そこで私はあなたと私の愛を分かち合おう。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "恋なすびは香りを放ち、",
                "私たちの戸口の上には、新しいものも古いものも、",
                "あらゆる選り抜きの実がある。",
                "私の愛する人よ、あなたのために取っておいたものだ。"
            ]
        }
    ]
}
