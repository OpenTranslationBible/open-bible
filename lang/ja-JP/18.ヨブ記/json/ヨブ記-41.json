{
    "book": "ヨブ記",
    "chapter": 41,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 「あなたは釣り針でレビヤタンを引き出せるか、",
                "> その舌を縄で押さえつけることができるか。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> その鼻に縄を通せるか、",
                "> その顎を釣り針で突き刺せるか。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 彼は繰り返しあなたに懇願するだろうか、",
                "> あるいは優しい言葉であなたに話しかけるだろうか。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 彼はあなたと契約を結ぶだろうか。",
                "> あなたは彼を永遠のしもべとして取るだろうか。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> あなたは鳥のように彼と遊ぶだろうか、",
                "> あるいは若い娘たちのために彼を縛るだろうか。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 商人たちは彼をめぐって取引するだろうか。",
                "> 彼を商人たちの間で分け合うだろうか。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 彼の皮膚を銛で覆うことができるか、",
                "> 彼の頭を釣り槍で覆うことができるか。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 彼に手を置いてみよ。",
                "> 戦いを思い出せ、再びそれを試みることはないだろう！"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 見よ、あなたの期待は無駄である。",
                "> 彼を見ただけで打ちのめされるだろうか。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 彼を起こすことを恐れない者はいない。",
                "> それならば、誰が私の前に立つことができるだろうか。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 誰が私に与えて、私がそれを返さなければならないのか。",
                "> 天の下にあるすべてのものは私のものである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 「私は彼の肢体について沈黙しない、",
                "> 彼の強大な力や優雅な形についても。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 誰が彼の外皮を剥ぎ取ることができるか。",
                "> 誰が彼の二重の鎧を貫くことができるか。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 誰が彼の口を開けることができるか。",
                "> 彼の歯は畏怖を抱かせる。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 彼の強い鱗は彼の誇り、",
                "> しっかりと密閉されている。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 一つ一つが次のものに非常に近く、",
                "> 空気もその間を通ることができない。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> それらは互いに結びつき、",
                "> くっついて分離することはできない。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 彼のくしゃみは光の閃きを放ち、",
                "> 彼の目は夜明けの光線のようである。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 彼の口からは燃えるたいまつが出て、",
                "> 火の火花が飛び出す。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 煙が彼の鼻から出る、",
                "> 沸騰する鍋や燃える葦のように。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 彼の息は炭を燃やし、",
                "> 炎が彼の口から出る。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 力は彼の首にあり、",
                "> 恐れが彼の前に動く。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 彼の肉のひだはしっかりと結びつき、",
                "> 彼の上で堅固で動かない。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 彼の心は石のように硬く、",
                "> 実際、下の石臼のように硬い。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 彼が立ち上がると、強者たちは恐れ、",
                "> 衝撃音のために混乱する。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 彼を打つ剣は勝てず、",
                "> 槍も、矢も、投げ槍も。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 彼は鉄を藁のように、",
                "> 青銅を腐った木のように考える。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 矢は彼を逃げさせることができない、",
                "> 投石は彼にとってもみ殻のようである。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 棍棒はもみ殻とみなされ、",
                "> 彼は投げ槍の音を笑う。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 彼の下部は鋭い陶器の破片のようで、",
                "> 泥の上に脱穀機のように広がる。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 彼は深みを鍋のようにかき回し、",
                "> 海を香油の鍋のようにする。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 彼の後ろには輝く跡が残り、",
                "> 深みが白髪のように見える。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 地上には彼のようなものはなく、",
                "> 恐れを知らない生き物である。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 彼はすべての高きものを見下ろし、",
                "> 彼はすべての誇り高き者の王である。」"
            ]
        }
    ]
}