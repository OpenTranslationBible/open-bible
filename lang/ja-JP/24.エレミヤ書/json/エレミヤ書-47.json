{
    "book": "エレミヤ書",
    "chapter": 47,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ファラオがガザを攻撃する前に、ペリシテ人について預言者エレミヤに臨んだ主のことば。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "万軍の主はこう言われる。「見よ、北から水が上って来る。",
                "それはあふれる奔流となり、地とそこに満ちるすべてのものの上にあふれる。",
                "町とそこに住む者たちは沈み、その日、戦士たちは叫ぶ。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "小盾と大盾の音、",
                "戦いの叫びの声。",
                "主がペリシテ人の地を滅ぼし、海岸の住民を消し去るからだ。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "ガザは丸坊主になり、",
                "アシュケロンは完全に断ち切られた。",
                "オレムとガザは恥を見る。",
                "彼らは頼みとするものを失った。",
                "王とその首長たちは共に去った。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "海岸の残りの者よ、",
                "いつまで自分の身を傷つけるのか。",
                "主はあなたを造った。",
                "主はあなたを厳しく罰し、また健やかにする。」"
            ]
        },
        {
            "verse": 6,
            "text": [
                "万軍の主は言われる。「見よ、災いが海岸に――",
                "ペリシテ人に――大きな破壊が来る。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "ガザは丸坊主になり、アシュケロンは完全に断ち切られた。",
                "オレムとガザは恥を見ている。",
                "彼らは共に捕らえ移された。」"
            ]
        }
    ]
}
