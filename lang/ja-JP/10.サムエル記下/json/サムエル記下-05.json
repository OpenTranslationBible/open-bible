{
    "book": "サムエル記 第二",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "イスラエルの全部族は、ヘブロンのダビデのもとに来て言った。「ご覧ください。",
                "私たちはあなたの骨肉です。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "以前、サウルが私たちの王であったときも、",
                "イスラエルを率いて出入りしていたのはあなたでした。",
                "そして主はあなたに、",
                "『あなたがわたしの民イスラエルを牧し、あなたがイスラエルの君主となる』と言われました。」"
            ]
        },
        {
            "verse": 3,
            "text": [
                "そこでイスラエルのすべての長老たちはヘブロンで王のもとに来た。",
                "そしてダビデ王はそこで主の前で彼らと契約を結び、",
                "彼らはダビデに油を注いでイスラエルの王とした。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "ダビデは三十歳で王となり、",
                "四十年間統治した。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼はヘブロンでユダを七年六か月間統治し、",
                "エルサレムでイスラエルとユダ全体を三十三年間統治した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "王とその部下たちは、その地の住民エブス人を攻めようと、",
                "エルサレムに向かった。",
                "エブス人はダビデに言った。",
                "「おまえはここに入れない。目の見えない者や足の不自由な者が、おまえを追い返すだろう。」彼らは、",
                "ダビデはここに入れないと思っていたのである。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "しかしダビデは、シオンの要害を攻め取った。",
                "これがダビデの町である。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "その日ダビデは言った。",
                "「エブス人を打とうとする者は、水路を通って、ダビデが心から嫌う、",
                "足の不自由な者や目の見えない者のところまで行け。」それで人々は、",
                "「目の見えない者や足の不自由な者は家に入ってはならない」と言う。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "ダビデはこの要害に住み、そこをダビデの町と呼んだ。",
                "ダビデはミロから内側にかけて、周囲を建て巡らした。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "ダビデはますます大いなる者となった。",
                "万軍の神である主が、彼と共におられたからである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "ツロの王ヒラムは、ダビデのもとに使者たちを送り、",
                "杉の木と大工と石工も送った。",
                "彼らはダビデのために家を建てた。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "ダビデは、主が自分をイスラエルの王として堅く立て、",
                "ご自分の民イスラエルのために、自分の王国を高めてくださったことを悟った。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "ダビデは、ヘブロンから来た後、エルサレムでさらに側女たちと妻たちをめとった。",
                "ダビデには、さらに息子や娘たちが生まれた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "エルサレムで彼に生まれた子供たちは、",
                "シャムア、ショバブ、ナタン、ソロモン、"
            ]
        },
        {
            "verse": 15,
            "text": [
                "イブハル、エリシュア、ネフェグ、ヤフィア、"
            ]
        },
        {
            "verse": 16,
            "text": [
                "そしてエリシャマ、エリアダ、エリフェレット。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "ダビデがイスラエルの王として油を注がれたと聞いて、",
                "ペリシテ人は皆、ダビデを捜しに上って来た。",
                "ダビデはそれを聞いて、要害に下って行った。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ペリシテ人は進軍し、レファイムの谷に広がった。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "ダビデは主に伺って言った。",
                "「ペリシテ人に向かって上って行くべきでしょうか。彼らを私の手に渡してくださいますか。",
                "」主はダビデに言われた。",
                "「上れ。わたしは必ずペリシテ人をあなたの手に渡す。」"
            ]
        },
        {
            "verse": 20,
            "text": [
                "ダビデはバアル・ペラツィムに行き、そこで彼らを打ち破って言った。",
                "「主は、",
                "水が堤を破るように、私の前で敵を打ち破られた。」",
                "それで、その場所はバアル・ペラツィムと名づけられた。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "ペリシテ人は自分たちの偶像をそこに捨てて行ったので、",
                "ダビデとその部下たちはそれを運び去った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ペリシテ人は再び上ってきて、",
                "レファイムの谷に広がった。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "ダビデが主に伺うと、主は言われた。",
                "「まっすぐに上って行ってはならない。彼らの背後に回り、",
                "バルサムの木の前から彼らに向かえ。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "バルサムの木の上の方から行進の音が聞こえたら、すぐに行動せよ。",
                "そのとき主は、ペリシテ人の軍勢を打つために、",
                "すでにあなたの前に出ているからだ。」"
            ]
        },
        {
            "verse": 25,
            "text": [
                "それからダビデは主が命じられたとおりに行い、",
                "ゲバからゲゼルまでペリシテ人を打ち破った。"
            ]
        }
    ]
}
