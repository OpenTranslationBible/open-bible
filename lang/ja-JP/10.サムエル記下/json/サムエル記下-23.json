                "ネトファ出身のマハライ、"
            ]
        },
        {
            "verse": 29,
            "text": [
                "ネトファ出身のバアナの子ヘレブ、",
                "ベニヤミン族のギベア出身のリバイの子イッタイ、"
            ]
        },
        {
            "verse": 30,
            "text": [
                "ピラトン人ベナヤ、",
                "ガアシュの谷のヒダイ、"
            ]
        },
        {
            "verse": 31,
            "text": [
                "アルバ人アビ・アルボン、",
                "バルフム人アズマウェテ、"
            ]
        },
        {
            "verse": 32,
            "text": [
                "シャアルボン人エリアバ、",
                "ヤシェンの子たち、ヨナタンを含む、"
            ]
        },
        {
            "verse": 33,
            "text": [
