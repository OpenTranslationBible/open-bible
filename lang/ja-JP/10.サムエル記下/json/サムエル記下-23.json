{
    "book": "サムエル記 第二",
    "chapter": 23,
    "verses": [
        {
            "verse": 1,
            "text": [
                "これはダビデの最後の言葉である。",
                "エッサイの子ダビデが語る、",
                "いと高き方により高められた人、",
                "ヤコブの神に油注がれた者、",
                "イスラエルの愛される詩人が語る。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 「主の御霊は私を通して語り、",
                "> そのことばは私の舌の上にあった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> イスラエルの神は言われた。",
                "> イスラエルの岩は私に語られた。",
                "> 『人を正しく治め、",
                "> 神を畏れて治める者は、"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> それは太陽が昇る朝の光のようであり、",
                "> 雲のない夜明け、",
                "> 日光と雨の後に地から芽生える新しい草のようだ。』"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> まことに、私の家は神とともにそのようではないか。",
                "> 神は私と永遠の契約を結ばれた。",
                "> それはすべてにおいて整えられ、確かなものとされている。",
                "> 神は私の救いと私の願いのすべてを、必ず芽生えさせてくださるではないか。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> しかし、ならず者たちは皆、茨のように投げ捨てられる。",
                "> 手で扱うことができないからである。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> しかし、彼らに触れる者は",
                "> 鉄と槍の柄を備えなければならず、",
                "> 彼らはその場で完全に火で焼かれる。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "ダビデの勇士たちの名は次のとおりである。",
                "タフケモニ人ヨシェブ・バシェベテは、隊長たちのかしらであった。",
                "彼は八百人に向かって槍を振るい、一度にこれを殺した。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "彼の次はアホヒ人ドドの子、エルアザル、",
                "ダビデと共にいた三人の勇士の一人であり、",
                "彼らが戦いのために集まったペリシテ人に立ち向かったとき、",
                "イスラエルの人々は退いた。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼は立ち上がり、手が疲れて剣にくっついてしまうまでペリシテ人を打ち続けた。その日、",
                "主は大いなる勝利をもたらされた。",
                "民は彼の後に戻って来たが、それは戦死者からはぎ取るためにすぎなかった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "彼の次はハラル人アゲの子シャマであった。",
                "ペリシテ人が、",
                "レンズ豆がいっぱいに育っている畑のある所に集まって部隊を組んだとき、",
                "民はペリシテ人の前から逃げた。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "しかし彼はその畑の真ん中に踏みとどまってそこを守り、",
                "ペリシテ人を打ち倒した。",
                "こうして主は大いなる勝利をもたらされた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "その後、三十人の隊長のうちの三人が収穫の時に下り、",
                "アドラムの洞窟でダビデのもとに来た。",
                "その間、ペリシテ人の陣営はレファイムの谷にあった。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "ダビデは要塞におり、",
                "ペリシテ人の守備隊はベツレヘムにあった。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "ダビデはしきりに望んで言った。",
                "「だれか、門のそばにあるベツレヘムの井戸の水を、私に飲ませてくれたらよいのだが。」"
            ]
        },
        {
            "verse": 16,
            "text": [
                "そこで三人の勇士たちはペリシテ人の陣営を突破し、",
                "門のそばにあるベツレヘムの井戸から水を汲み、",
                "それを持ってきてダビデに渡した。",
                "しかし、彼はそれを飲まず、主への捧げ物として注いだ。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "彼は言った。",
                "「主よ、私がこんなことをするなど、とんでもないことです。",
                "いのちをかけて行った人たちの血を、私が飲めるでしょうか。",
                "」彼はそれを飲もうとしなかった。",
                "三人の勇士たちは、これらのことを行ったのである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ヨアブの兄弟、ゼルヤの子アビシャイは、",
                "三十人の隊長であった。",
                "彼は槍を振るい、三百人を殺し、",
                "三人と同じ名声を持っていた。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "彼は三十人の中で最も名誉ある者であったので、",
                "彼らの指揮官となった。",
                "しかし、彼は三人には及ばなかった。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "次に、カブツェル出身の勇敢な戦士、",
                "エホヤダの子ベナヤがいた。",
                "彼は力強い行いをし、",
                "モアブのアリエルの二人の息子を殺した。",
                "また、雪の日に穴の中でライオンを殺した。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "彼はまた、著名なエジプト人を殺した。",
                "そのエジプト人は手に槍を持っていたが、",
                "彼は杖を持って彼に下り、",
                "エジプト人の手から槍を奪い、",
                "彼自身の槍で彼を殺した。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "これらの行為はエホヤダの子ベナヤによって行われ、",
                "彼は三人の勇士たちと同じ名声を持っていた。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "彼は三十人の中で名誉を受けたが、",
                "三人には及ばなかった。",
                "ダビデは彼を自分の護衛の長に任命した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "ヨアブの兄弟アサヘルは三十人の一人であった。",
                "ベツレヘム出身のドドの子エルハナン、"
            ]
        },
        {
            "verse": 25,
            "text": [
                "ハロデ人シャマ、",
                "もう一人のハロデ人エリカ、"
            ]
        },
        {
            "verse": 26,
            "text": [
                "パルティ人ヘレツ、",
                "テコア出身のイケシュの子イラ、"
            ]
        },
        {
            "verse": 27,
            "text": [
                "アナトテ出身のアビエゼル、",
                "フシャ人メブンナイ、"
            ]
        },
        {
            "verse": 28,
            "text": [
                "アホヒ人ツァルモン、",
                "ネトファ出身のマハライ、"
            ]
        },
        {
            "verse": 29,
            "text": [
                "ネトファ出身のバアナの子ヘレブ、",
                "ベニヤミン族のギベア出身のリバイの子イッタイ、"
            ]
        },
        {
            "verse": 30,
            "text": [
                "ピラトン人ベナヤ、",
                "ガアシュの谷のヒダイ、"
            ]
        },
        {
            "verse": 31,
            "text": [
                "アルバ人アビ・アルボン、",
                "バルフム人アズマウェテ、"
            ]
        },
        {
            "verse": 32,
            "text": [
                "シャアルボン人エリアバ、",
                "ヤシェンの子たち、ヨナタンを含む、"
            ]
        },
        {
            "verse": 33,
            "text": [
                "ハラル人シャマ、",
                "アラル出身のシャラルの子アヒアム、"
            ]
        },
        {
            "verse": 34,
            "text": [
                "マアカ人アハスバイの子エリフェレット、",
                "ギロ出身のアヒトフェルの子エリアム、"
            ]
        },
        {
            "verse": 35,
            "text": [
                "カルメル人ヘツロ、",
                "アルバ人パアライ、"
            ]
        },
        {
            "verse": 36,
            "text": [
                "ツォバ出身のナタンの子イガル、",
                "ガド人バニ、"
            ]
        },
        {
            "verse": 37,
            "text": [
                "アンモン人ツェレク、",
                "ベエロテ人ナハライ、ゼルヤの子ヨアブの武器持ち、"
            ]
        },
        {
            "verse": 38,
            "text": [
                "イテリ人イラ、",
                "もう一人のイテリ人ガレブ、"
            ]
        },
        {
            "verse": 39,
            "text": [
                "ヘテ人ウリヤ、",
                "合計三十七人。"
            ]
        }
    ]
}
