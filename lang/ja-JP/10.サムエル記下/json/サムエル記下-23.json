                "アラル出身のシャラルの子アヒアム、"
            ]
        },
        {
            "verse": 34,
            "text": [
                "マアカ人アハスバイの子エリフェレット、",
                "ギロ出身のアヒトフェルの子エリアム、"
            ]
        },
        {
            "verse": 35,
            "text": [
                "カルメル人ヘツロ、",
                "アルバ人パアライ、"
            ]
        },
        {
            "verse": 36,
            "text": [
                "ツォバ出身のナタンの子イガル、",
                "ガド人バニ、"
            ]
        },
        {
            "verse": 37,
            "text": [
                "アンモン人ツェレク、",
                "ベエロテ人ナハライ、ゼルヤの子ヨアブの武器持ち、"
            ]
        },
        {
            "verse": 38,
            "text": [
                "イテリ人イラ、",
                "もう一人のイテリ人ガレブ、"
            ]
        },
        {
            "verse": 39,
            "text": [
                "ヒッタイト人ウリヤ、",
                "合計三十七人。"
            ]
        }
    ]
