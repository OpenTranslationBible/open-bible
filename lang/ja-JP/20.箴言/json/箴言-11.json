{
    "book": "箴言",
    "chapter": 11,
    "verses": [
        {
            "verse": 1,
            "text": [
                "主は偽りのはかりを忌み嫌われるが、正確な重りは主の喜びである。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "高慢が来ると恥も来るが、謙遜な者には知恵がある。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "正直な者の誠実さは彼らを導くが、不誠実な者の裏切りは彼らを滅ぼす。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "富は怒りの日に無益だが、正義は死から救う。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "潔白な者の正義はその道を開くが、悪しき者は自分の悪によってつまずく。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "正直な者の正義は彼らを救うが、裏切る者は自らの貪欲に捕らえられる。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "悪しき者が死ぬと、その望みは消え、その力の約束は無に帰する。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "正しい者は苦難から救われ、悪しき者にそれが代わって降りかかる。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "神を畏れない者はその口で隣人を滅ぼすが、正しい者は知識によって救いを見いだす。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "正しい者が栄えると町は喜び、悪しき者が滅びると歓声が上がる。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "町は正しい者の祝福によって高められるが、悪しき者の言葉によって滅ぼされる。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "隣人を軽んじる者は判断力に欠けるが、悟りのある者は黙っている。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "噂話をする者は秘密を漏らすが、信頼できる者は事を隠す。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "指導がなければ国は倒れるが、多くの助言者によって勝利が来る。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "見知らぬ人の保証をする者はそれで苦しむが、そのような誓約を避ける者は安全である。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "心優しい女性は名誉を得るが、無慈悲な男は富しか得ない。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "あわれみ深い者は自分に利益をもたらすが、残酷な者は自分に害をもたらす。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "悪しき者は偽りの報酬を得るが、正義を蒔く者は確かな報いを受ける。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "正義に堅く立つ者は命を得るが、悪を追い求める者は死に至る。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "主は心の曲がった者を忌み嫌われるが、潔白な者を喜ばれる。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "確かに、悪しき者は罰を免れないが、正しい者は救われる。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "豚の鼻にある金の輪のように、思慮のない美しい女もそうである。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "正しい者の願いは善に終わるが、悪しき者の期待は怒りに終わる。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "惜しみなく与えてもなお増える人がおり、不当に出し惜しんで貧しくなる人がいる。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "寛大な者は栄え、他者を潤す者は自らも潤される。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "穀物を溜め込む者は人々にのろわれるが、進んで売る者には祝福がある。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "善を求める者は好意を見出すが、悪を追い求める者には悪が来る。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "富に頼る者は倒れるが、正しい者は青々とした葉のように栄える。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "自分の家に災いをもたらす者は風だけを受け継ぎ、愚か者は賢い者に仕える。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "正しい者の実は命の木であり、賢者は命を救う。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "正しい者が地上で報いを受けるなら、悪しき者と罪人はなおさらである！"
            ]
        }
    ]
}
