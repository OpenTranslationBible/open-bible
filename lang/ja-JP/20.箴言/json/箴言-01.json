{
    "book": "箴言",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "イスラエルの支配者、ダビデの子ソロモンの賢い言葉："
            ]
        },
        {
            "verse": 2,
            "text": [
                "知恵と訓戒を得るために、理解の言葉を見分けるために；"
            ]
        },
        {
            "verse": 3,
            "text": [
                "賢い行動、正義、公正、公平の訓戒を受けるために；"
            ]
        },
        {
            "verse": 4,
            "text": [
                "単純な者に慎重さを、若者に知識と分別を与えるために；"
            ]
        },
        {
            "verse": 5,
            "text": [
                "賢い者は聞いて学びを増し、理解のある者は指導を得るように、"
            ]
        },
        {
            "verse": 6,
            "text": [
                "箴言とたとえ、賢者の言葉と謎を理解するために。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "主を恐れることはすべての知識の始まりである；愚かな者は知恵と訓戒を憎む。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "わが子よ、父の指導に注意を払い、母の教えを捨ててはならない；"
            ]
        },
        {
            "verse": 9,
            "text": [
                "それらはあなたの頭の美しい冠のようであり、あなたの首の飾りのようである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "わが子よ、罪人があなたを誘おうとしても、従ってはならない。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "彼らが言うなら、「我々と一緒に来い、",
                "> 血を待ち伏せしよう、",
                "> 理由もなく無実の者を待ち伏せしよう；"
            ]
        },
        {
            "verse": 12,
            "text": [
                "墓のように彼らを生きたまま飲み込み、",
                "> 穴に下る者のように全体を；"
            ]
        },
        {
            "verse": 13,
            "text": [
                "我々はあらゆる種類の貴重な品を見つけ、",
                "> 我々の家を略奪品で満たそう；"
            ]
        },
        {
            "verse": 14,
            "text": [
                "我々と一緒にくじを投げよう、",
                "> 我々は皆で一つの財布を共有しよう」—"
            ]
        },
        {
            "verse": 15,
            "text": [
                "わが子よ、彼らの道を歩んではならない、彼らの道から足を守れ、"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼らは悪事を追うのが早く、",
                "血を流すのを急ぐからである。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "すべての鳥の目の前で網を広げることがどれほど無駄なことか！"
            ]
        },
        {
            "verse": 18,
            "text": [
                "しかしこれらの者は自分自身に罠を仕掛けている；彼らは自分の命を待ち伏せしている。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "不正な利益を貪る者の道は皆このようである；それはそれを追い求める者の命を奪う。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "知恵は街で大声で呼びかけ、",
                "広場で声を上げる；"
            ]
        },
        {
            "verse": 21,
            "text": [
                "賑やかな通りの頭で叫び、",
                "町の門の入口で彼女の演説をする："
            ]
        },
        {
            "verse": 22,
            "text": [
                "「いつまで、単純な者たちよ、あなたたちは単純な道を愛するのか？",
                "> いつまであざける者たちはあざけりを喜び、",
                "> 愚か者たちは知識を憎むのか？"
            ]
        },
        {
            "verse": 23,
            "text": [
                "私の叱責に悔い改めよ！",
                "> そうすれば私はあなたたちに私の霊を注ぎ、",
                "> 私の言葉をあなたたちに知らせる。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "私が呼んでもあなたたちは拒み、私が手を差し伸べても誰も注意を払わなかった；"
            ]
        },
        {
            "verse": 25,
            "text": [
                "あなたたちは私のすべての助言を無視し",
                "私の叱責を受け入れなかったので、"
            ]
        },
        {
            "verse": 26,
            "text": [
                "私はあなたたちの災難を見て微笑む；",
                "あなたたちの恐怖が来るときに私は喜んで応じる、"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "あなたたちの恐怖が嵐のように来るとき、あなたたちの災難が旋風のように来るとき、苦難と苦悩があなたたちに襲いかかるとき。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼らは私を呼ぶが、私は応じない；彼らは熱心に私を求めるが、私を見つけることはない、"
            ]
        },
        {
            "verse": 29,
            "text": [
                "彼らは知恵を拒み、主を恐れることを選ばなかったからである。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "彼らは私の助言を受け入れず、私のすべての叱責を軽蔑した。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "それゆえ、彼らは自分の道の実を食べ、自分の計画の実で満たされる。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "単純な者の迷いは彼らの破滅をもたらし、愚か者の安逸は彼らの破滅をもたらす；"
            ]
        },
        {
            "verse": 33,
            "text": [
                "しかし、私に耳を傾ける者は安全に住み、害を恐れることなく安らかである。」"
            ]
        }
    ]
}