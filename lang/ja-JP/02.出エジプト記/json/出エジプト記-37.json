{
    "book": "出エジプト記",
    "chapter": 37,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ベツァルエルはアカシア材で箱を作った。その長さは二キュビト半、幅は一キュビト半、高さは一キュビト半であった。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "彼はそれを内側も外側も純金で覆い、その周りに金の縁飾りを作った。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "彼はそれのために金の輪を四つ鋳造し、それをその四つの足に取り付けた。片側に二つの輪、もう一方の側に二つの輪である。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "彼はアカシア材で棒を作り、それを金で覆った。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼は箱を運ぶために、棒を箱の側面の輪に差し込んだ。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "彼はまた、純金で贖いの蓋を作った。その長さは二キュビト半、幅は一キュビト半であった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "彼は贖いの蓋の両端に、打ち出し金で二つのケルビムを作った。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "一つのケルブは一方の端に、もう一つのケルブは反対の端に位置していた。彼はケルビムを贖いの蓋と一体にして両端に作った。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "ケルビムは翼を上に広げ、それで贖いの蓋を覆っていた。彼らは互いに向かい合い、蓋の方を見ていた。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼はアカシア材で机を作った。長さは二キュビト、幅は一キュビト、高さは一キュビト半であった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "彼はそれを純金で覆い、その周りに金の縁飾りを作った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "彼はまた、手のひら幅の縁を作り、その縁の周りに金の縁飾りを付けた。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "彼は机のために金の輪を四つ鋳造し、それを脚のある四隅に取り付けた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "輪は縁に近い位置にあり、机を運ぶための棒を保持するためであった。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼はアカシア材で棒を作り、それを金で覆い、机を運ぶために用いた。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼は机のために、純金で皿、皿、鉢、注ぎ出すためのピッチャーを作った。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "彼は純金で燭台を作り、その台座と軸を打ち出し、その花のような杯、蕾、花びらを一体にした。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "六つの枝がその側面から伸びていた。片側に三つの枝、もう一方に三つの枝である。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "各枝にはアーモンドの花の形をした三つの杯、蕾、花びらがあり、このパターンは燭台から伸びる六つの枝すべてに一貫していた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "燭台自体にはアーモンドの花の形をした四つの杯、蕾、花びらがあった。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "最初の枝の対の下に蕾があり、二番目の対の下に二つ目の蕾があり、三番目の対の下に三つ目の蕾があった。合計で六つの枝である。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "蕾と枝はすべて燭台と一体で、純金の一つの打ち出し作業であった。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "彼はその七つのランプ、芯切りばさみ、皿を純金で作った。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "彼は燭台とそのすべての付属品を純金の一タラントから作った。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "彼はアカシア材で香の祭壇を作った。長さは一キュビト、幅は一キュビトで正方形、高さは二キュビトで、その角は一体であった。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "彼はその上部、周囲の側面、角を純金で覆い、その周りに金の縁飾りを作った。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "彼は運ぶための棒を保持するために、縁飾りの下に対向する側に二つの金の輪を作った。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼はアカシア材で棒を作り、それを金で覆った。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "彼はまた、聖なる注ぎ油と純粋で香り高い香を調香師の技術で作った。"
            ]
        }
    ]
}