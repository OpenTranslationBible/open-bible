{
    "book": "列王記第二",
    "chapter": 11,
    "verses": [
        {
            "verse": 1,
            "text": [
                "アハズヤの母アタルヤは、彼女の息子が死んだことを知ったとき、",
                "立ち上がって王家の子孫をすべて滅ぼした。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "しかし、ヨラム王の娘で、アハズヤの姉妹であるヨシェバが、",
                "殺されようとしていた王の子たちの中からアハズヤの子ヨアシュを盗み出し、",
                "彼とその乳母を寝室に入れた。",
                "こうして彼らは彼をアタルヤから隠したので、彼は殺されなかった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "彼は六年間、主の家で彼女と共に隠されていた。",
                "その間、アタルヤは国を治めていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "七年目に、エホヤダは人を遣わして、カリ人と近衛兵の百人隊の長たちを呼び寄せ、",
                "彼らを主の家の自分のもとに来させた。",
                "そして彼らと契約を結び、主の家で彼らに誓いを立てさせ、",
                "王の子を彼らに見せた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼は彼らに命じて言った。",
                "「あなたがたのすべきことはこうだ。あなたがたのうち、",
                "安息日に勤務に就いて王宮の警護に当たる三分の一は、"
            ]
        },
        {
            "verse": 6,
            "text": [
                "三分の一はスルの門に、",
                "三分の一は近衛兵の後ろの門にいて、",
                "宮を守り、防備に当たれ。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "安息日に勤務を終えるあなたがたの二組は、",
                "王のために主の家の警護に当たれ。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "あなたがたは各自、武器を手にして王の周りを囲め。",
                "隊列の中に入って来る者は殺せ。",
                "王が出るときも入るときも、王とともにいよ。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "それで百人隊長たちは、祭司エホヤダが命じたすべてのことを行った。",
                "彼らは安息日に入って来るべき者たちと、",
                "安息日に出て行くべき者たちを連れて来て、祭司エホヤダのもとに来た。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "そして祭司は百人隊長たちに、",
                "主の家にあったダビデ王の槍と盾を与えた。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "それから護衛たちは、各々が手に武器を持ち、",
                "家の右側から左側まで、",
                "祭壇と家のそばで、王の周りに立った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "そして彼は王の息子を連れ出し、彼に冠を置き、証を与えた。",
                "彼らは彼を王とし、彼に油を注いだ。",
                "彼らは手を叩いて言った。「王様万歳！」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "アタルヤは護衛と民の騒音を聞いたとき、",
                "主の家で民のところに来た。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼女は見て、見よ、王が柱のそばに立っていた、これは慣例であった。",
                "王のそばには百人隊長とラッパ吹きがいた。",
                "そして国のすべての民は喜び、ラッパを吹いていた。",
                "それでアタルヤは衣を裂き、叫んだ。「反逆だ！反逆だ！」"
            ]
        },
        {
            "verse": 15,
            "text": [
                "祭司エホヤダは、軍勢を指揮する百人隊の長たちに命じて言った。",
                "「彼女を隊列の間から連れ出せ。彼女に従う者は剣で殺せ。」",
                "祭司が「彼女を主の家で殺してはならない」と言っていたからである。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "それで彼らは彼女を捕らえ、彼女は馬の入口の道を通って王の家に行き、",
                "そこで殺された。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "それからエホヤダは、主と王と民との間に契約を結び、",
                "彼らが主の民となるようにし、また王と民との間にも契約を結んだ。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "そして国のすべての民はバアルの家に来て、それを壊し、",
                "彼の祭壇と像を徹底的に打ち砕き、",
                "バアルの祭司マタンを祭壇の前で殺した。",
                "そして祭司は主の家に役人を任命した。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "そして彼は百人隊長たち、カリ人、護衛たち、国のすべての民を集め、",
                "彼らは王を主の家から護衛し、",
                "護衛の門を通って王の家に行った。",
                "そこで彼は王座に座った。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "それで国のすべての民は喜び、町は平和であった。",
                "彼らはアタルヤを王の家で剣で殺したからである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "ヨアシュは王に即位したとき、わずか七歳であった。"
            ]
        }
    ]
}
