{
    "book": "列王記第二",
    "chapter": 15,
    "verses": [
        {
            "verse": 1,
            "text": [
                "イスラエルの王ヤロブアムの第二十七年に、",
                "ユダの王アマツヤの子アザリヤが王となった。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "彼は十六歳で王となり、",
                "エルサレムで五十二年間統治した。",
                "彼の母はエルサレムのエコリヤであった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "彼は父アマツヤの例に従って、",
                "主の目にかなう正しい行いをした。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "しかし、高き所は取り除かれず、",
                "民は引き続きこれらの高き所でいけにえを捧げ、香を焚いた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "そして主は王を患わせ、彼は死ぬ日まで重い皮膚病にかかった。",
                "彼は別の家に住み、",
                "王の子ヨタムが家を管理し、",
                "国の民を裁いた。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "アザリヤの他の行いや彼のすべての業績は、",
                "ユダの王たちの年代記の書に記されているではないか。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "アザリヤは死んで、ダビデの町で先祖と共に葬られ、",
                "彼の子ヨタムが彼に代わって王となった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "ユダの王アザリヤの第三十八年に、",
                "ヤロブアムの子ゼカリヤがサマリアでイスラエルの王となり、六か月間治めた。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "彼は先祖たちがしたように、",
                "主の目に悪であることを行い、",
                "イスラエルに罪を犯させたネバテの子ヤロブアムの罪から離れなかった。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "そのとき、ヤベシュの子シャルムが彼に対して陰謀を企て、",
                "民の前で彼を打ち倒し、殺して、彼に代わって王となった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "ゼカリヤの他の行いは、確かに、",
                "イスラエルの王たちの年代記の書に記録されている。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "主がかつてエフに「あなたの子孫は四代目までイスラエルの王座に着く」",
                "と語られたことばは、このとおりであった。",
                "そして、そのとおりになった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "ヤベシュの子シャルムは、ユダの王ウジヤの第三十九年に王となり、",
                "サマリアで一か月間治めた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "そのとき、ガディの子メナヘムがティルツァからサマリアに上り、",
                "サマリアでヤベシュの子シャルムを打ち倒し、殺して、",
                "彼に代わって王座を奪った。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "シャルムの他の行いや彼の陰謀は、",
                "確かに、イスラエルの王たちの年代記の書に記録されている。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "そのころ、メナヘムはティルツァから出て、ティプサとその中にいるすべての者、",
                "およびその領土を打った。彼らが城門を開かなかったので、",
                "これを打ち、その中の妊婦をみな切り裂いた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "ユダの王アザリヤの第三十九年に、",
                "ガディの子メナヘムがイスラエルの王となり、",
                "サマリアで十年間統治した。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "彼は主の目に悪であることを行い、",
                "一生の間、",
                "イスラエルに罪を犯させたネバテの子ヤロブアムの罪から離れなかった。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "アッシリアの王プルがこの国に攻めて来た。",
                "そこでメナヘムは、プルの支援を得て王国を自分の手に固めるために、",
                "プルに銀千タラントを与えた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "その後、メナヘムはイスラエルから金を徴収し、",
                "すべての富裕な者から一人当たり銀五十シェケルを取り、",
                "アッシリアの王に与えた。",
                "それでアッシリアの王は撤退し、国に留まらなかった。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "メナヘムの他の行いや彼のすべての業績は、",
                "イスラエルの王たちの年代記の書に記されているではないか。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "メナヘムは死に、",
                "彼の子ペカヒヤが彼に代わって王となった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "ユダの王アザリヤの第五十年に、",
                "メナヘムの子ペカヒヤがイスラエルの王となり、サマリアで二年間統治した。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "彼は主の目に悪であることを行い、",
                "イスラエルに罪を犯させたネバテの子ヤロブアムの罪から離れなかった。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "彼の副官であったレマリヤの子ペカは、",
                "ギルアデ人五十人を率いて彼に謀反を企て、",
                "サマリアの王宮の高殿で、アルゴブとアリエとともに彼を打ち殺し、",
                "彼に代わって王となった。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "ペカヒヤの他の行いや彼のすべての業績は、",
                "確かに、イスラエルの王たちの年代記の書に記録されている。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "ユダの王アザリヤの第五十二年に、",
                "レマリヤの子ペカがイスラエルの王となり、サマリアで二十年間統治した。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼は主の目に悪であることを行い、",
                "イスラエルに罪を犯させたネバテの子ヤロブアムの罪から離れなかった。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "イスラエルの王ペカの時代に、アッシリアの王ティグラテ・ピレセルが来て、",
                "イヨン、アベル・ベテ・マアカ、ヤノア、ケデシュ、ハツォル、ギルアデ、ガリラヤ、",
                "ナフタリの全地を占領し、住民をアッシリアに捕囚として連れて行った。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "そしてエラの子ホセアがレマリヤの子ペカに対して陰謀を企て、",
                "彼を打ち倒し、殺して、彼に代わって王座を奪った。",
                "それはウジヤの子ヨタムの第二十年のことであった。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "ペカの他の行いや彼のすべての業績は、",
                "確かに、イスラエルの王たちの年代記の書に記録されている。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "イスラエルの王レマリヤの子ペカの第二年に、",
                "ユダの王ウジヤの子ヨタムが王となった。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "彼は二十五歳で王となり、",
                "エルサレムで十六年間統治した。",
                "彼の母はザドクの娘エルシャであった。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "彼は主の目にかなう正しい行いをし、",
                "彼の父ウジヤのすべての道に従った。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "しかし、高き所は取り除かれず、",
                "民は引き続きこれらの高き所でいけにえを捧げ、香を焚いた。",
                "彼は主の家の上の門を建設した。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "ヨタムの他の行いや彼の業績は、",
                "ユダの王たちの年代記の書に記されているではないか。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "そのころ、主はアラムの王レツィンとレマリヤの子ペカをユダに送り始められた。"
            ]
        },
        {
            "verse": 38,
            "text": [
                "ヨタムは死んで、彼の父ダビデの町で先祖と共に葬られ、",
                "彼の子アハズが彼に代わって王となった。"
            ]
        }
    ]
}
