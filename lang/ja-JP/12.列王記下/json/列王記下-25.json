{
    "book": "列王記下",
    "chapter": 25,
    "verses": [
        {
            "verse": 1,
            "text": [
                "その治世の第九年の第十の月の第十の日に、",
                "バビロンの王ネブカドネザルが全軍を率いてエルサレムに来て、",
                "その周りに陣を敷き、周囲に包囲壁を築いた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "こうして、その町はゼデキヤ王の第十一年まで包囲された。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "第四の月の第九の日に、町の中の飢饉が激しくなり、",
                "その地の民に食物がなくなった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "その時、町は破られ、夜に戦士たちは皆逃げた。",
                "王の庭のそばの二つの壁の間の門を通って、",
                "カルデア人が町の周りにいるにもかかわらず、",
                "彼らはアラバの道を通って行った。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "しかし、カルデア人の軍隊は王を追い、",
                "エリコの平原で彼を捕らえ、",
                "彼の軍隊は皆彼から散り散りになった。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "彼らは王を捕らえ、彼をリブラのバビロンの王のもとに連れて行き、",
                "そこで彼は裁かれた。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "彼らはゼデキヤの息子たちを彼の目の前で殺し、",
                "ゼデキヤの目をつぶし、彼を青銅の鎖で縛り、",
                "バビロンに連れて行った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "第五の月の第七の日に、",
                "バビロンの王ネブカドネザルの第十九年に、",
                "バビロンの王の従者であり、護衛隊長であるネブザラダンがエルサレムに来た。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "彼は主の家、王の家、",
                "エルサレムのすべての家を焼き、",
                "大きな家をすべて火で焼いた。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "護衛隊長と共にいたカルデア人の全軍は、",
                "エルサレムの周りの壁を壊した。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "その後、護衛隊長ネブザラダンは、",
                "町に残っていた人々、",
                "バビロンの王に降った脱走者、",
                "そして残りの民を捕らえて連れ去った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "しかし、護衛隊長は、土地の最も貧しい人々を残して、葡萄園の管理者や農夫にした。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "主の家にあった青銅の柱、",
                "台座、青銅の海は、",
                "カルデア人によって砕かれ、青銅はバビロンに運ばれた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼らはまた、鍋、シャベル、芯切りばさみ、匙、",
                "そして神殿の奉仕に使われるすべての青銅の器具を持ち去った。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "護衛隊長はまた、火皿や鉢、",
                "金のもの、銀のものを持ち去った。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "ソロモンが主の家のために作った二つの柱、一つの海、台座、",
                "これらすべての器具の青銅は重さを超えていた。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "一つの柱の高さは十八キュビットで、",
                "その上に青銅の柱頭があり、",
                "柱頭の高さは三キュビットで、",
                "柱頭の周りには格子細工とザクロがあり、すべて青銅であった。",
                "もう一つの柱もこれと同様で、格子細工があった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "その後、護衛隊長は大祭司セラヤ、",
                "次の祭司ゼパニヤ、三人の門衛を捕らえた。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "そして、町からは戦士たちの監督である一人の役人、",
                "町にいた王の顧問五人、",
                "地の民を集めた軍隊の書記官、",
                "町にいた地の民六十人を捕らえた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "護衛隊長ネブザラダンは彼らをリブラのバビロンの王のもとに連れて行った。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "バビロンの王は彼らを打ち、ハマテの地リブラで彼らを殺した。",
                "こうしてユダはその地から捕らえ移された。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ユダの地に残された民については、",
                "バビロンの王ネブカドネザルが残した者たちに、",
                "彼はアヒカムの子ゲダルヤを彼らの上に任命した。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "すべての軍隊の隊長たちとその部下たちは、",
                "バビロンの王がゲダルヤを総督に任命したと聞いたとき、",
                "彼らはミツパでゲダルヤのもとに来た。",
                "すなわち、ネタニヤの子イシュマエル、",
                "カレアの子ヨハナン、",
                "タヌメテの子セラヤ、ネトファ人、",
                "マアカ人の子ヤアザニヤ、彼らとその部下たちである。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "ゲダルヤは彼らとその部下たちに誓い、彼らに言った。",
                "「カルデア人の従者を恐れることはない。",
                "この地に住み、バビロンの王に仕えれば、あなたがたは幸せになる。」"
            ]
        },
        {
            "verse": 25,
            "text": [
                "しかし、第七の月に、ネタニヤの子イシュマエル、エリシャマの子、",
                "王族の者が十人の男と共に来て、ゲダルヤを打ち殺し、",
                "ミツパで彼と共にいたユダヤ人とカルデア人も殺した。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "その後、小さな者から大きな者までのすべての民と軍隊の隊長たちは、",
                "立ち上がりエジプトに行った。",
                "彼らはカルデア人を恐れていたからである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "ユダの王エホヤキンの捕囚の第三十七年、",
                "第十二の月の第二十七の日に、",
                "バビロンの王エビル・メロダクは、その治世の年に、",
                "ユダの王エホヤキンを獄から解放した。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼は彼に親切に語り、バビロンにいる他の王たちの座よりも高く彼の座を置いた。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "こうしてエホヤキンは獄の服を変え、",
                "彼の生涯のすべての日々、王の前で定期的に食事をした。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "彼の生活のために、王から毎日の分が与えられ、",
                "彼の生涯を通じて続けられた。"
            ]
        }
    ]
}