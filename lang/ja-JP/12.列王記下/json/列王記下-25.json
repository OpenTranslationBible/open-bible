{
    "book": "列王記下",
    "chapter": 25,
    "verses": [
        {
            "verse": 1,
            "text": [
                "その治世の第九年の第十の月の第十の日に、",
                "バビロンの王ネブカドネザルが全軍を率いてエルサレムに来て、",
                "その周りに陣を敷き、周囲に包囲壁を築いた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "こうして、その町はゼデキヤ王の第十一年まで包囲された。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "第四の月の第九の日に、町の中の飢饉が激しくなり、",
                "その地の民に食物がなくなった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "その時、町は破られた。カルデア人が町を包囲していたが、",
                "戦士たちはみな夜のうちに、",
                "王の園のそばにある二重の城壁の間の門の道から逃げ出し、",
                "アラバへの道を進んで行った。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "しかし、カルデア人の軍勢は王を追い、",
                "エリコの草原で彼に追いついた。",
                "王の軍勢はみな王から離れて散り散りになった。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "彼らは王を捕らえ、彼をリブラのバビロンの王のもとに連れて行き、",
                "そこで彼は裁かれた。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "彼らはゼデキヤの息子たちを彼の目の前で殺し、",
                "ゼデキヤの目をつぶし、彼を青銅の鎖で縛り、",
                "バビロンに連れて行った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "第五の月の第七の日に、",
                "バビロンの王ネブカドネザルの第十九年に、",
                "バビロンの王の従者であり、護衛隊長であるネブザラダンがエルサレムに来た。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "彼は主の家、王の家、",
                "エルサレムのすべての家を焼き、",
                "大きな家をすべて火で焼いた。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "護衛隊長と共にいたカルデア人の全軍は、",
                "エルサレムの周りの壁を壊した。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "その後、護衛隊長ネブザラダンは、",
                "町に残っていた人々、",
                "バビロンの王に降った脱走者、",
                "そして残りの民を捕らえて連れ去った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "しかし護衛隊長は、その国の最も貧しい民の一部を残して、ぶどう園の働き手と農夫にした。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "主の家にあった青銅の柱、",
                "台座、青銅の海は、",
                "カルデア人によって砕かれ、青銅はバビロンに運ばれた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼らはまた、鍋、シャベル、芯切りばさみ、匙、",
                "そして神殿の奉仕に使われるすべての青銅の器具を持ち去った。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "護衛隊長はまた、火皿と鉢、",
                "純金の物と純銀の物を持ち去った。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "ソロモンが主の家のために造った二本の柱、一つの海、",
                "台座――これらすべての器の青銅は量りきれなかった。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "一本の柱の高さは十八キュビトで、",
                "その上に青銅の柱頭があった。",
                "柱頭の高さは三キュビトで、",
                "柱頭の周りには格子細工とざくろがあり、すべて青銅であった。",
                "もう一本の柱もこれと同様で、格子細工があった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "護衛隊長は、",
                "祭司長セラヤと次席の祭司ゼパニヤと三人の門衛を捕らえた。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "また、町からは、戦士たちを監督していた役人一人、",
                "町にいた王の側近五人、",
                "国の民を徴集する軍の長の書記、",
                "町にいた国の民六十人を捕らえた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "護衛隊長ネブザラダンは彼らをリブラのバビロンの王のもとに連れて行った。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "バビロンの王は彼らを打ち、ハマテの地リブラで彼らを殺した。",
                "こうしてユダはその地から捕らえ移された。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ユダの地に残された民、",
                "すなわちバビロンの王ネブカドネザルが残した者たちの上に、",
                "王はシャファンの子アヒカムの子ゲダルヤを任命した。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "軍の隊長たちとその部下たちはみな、",
                "バビロンの王がゲダルヤを総督に任命したことを聞いて、",
                "ミツパにいるゲダルヤのもとに来た。",
                "それは、ネタニヤの子イシュマエル、",
                "カレアの子ヨハナン、",
                "ネトファ人タヌメテの子セラヤ、",
                "マアカ人の子ヤアザニヤと、彼らの部下たちであった。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "ゲダルヤは彼らとその部下たちに誓い、彼らに言った。",
                "「カルデア人の従者を恐れることはない。",
                "この地に住み、バビロンの王に仕えれば、あなたがたは幸せになる。」"
            ]
        },
        {
            "verse": 25,
            "text": [
                "しかし第七の月に、王族の一人で、エリシャマの子ネタニヤの子イシュマエルが、",
                "十人の部下を連れて来てゲダルヤを打ち殺し、",
                "ミツパで彼とともにいたユダヤ人とカルデア人も打ち殺した。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "その後、小さな者から大きな者までのすべての民と軍隊の隊長たちは、",
                "立ち上がりエジプトに行った。",
                "彼らはカルデア人を恐れていたからである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "ユダの王エホヤキンが捕らえ移されてから三十七年目の第十二の月の二十七日に、",
                "バビロンの王エビル・メロダクは、",
                "王となったその年に、",
                "ユダの王エホヤキンを獄から出した。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼はエホヤキンに優しく語りかけ、その位を、バビロンで彼とともにいた王たちの位よりも高くした。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "エホヤキンは囚人の服を脱ぎ、",
                "生涯、いつも王の前で食事をした。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "彼の生活のために、王から毎日の分が与えられ、",
                "彼の生涯を通じて続けられた。"
            ]
        }
    ]
}
