{
    "book": "ヨハネによる福音書",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "初めに言があった。言は神と共にあった。言は神であった。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "この方は初めに神と共におられた。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "すべてのものはこの方によって成った。この方なしには成ったものは一つもない。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "この方に命があった。この命は人々の光であった。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "光は暗闇の中で輝いている。暗闇はそれに打ち勝たなかった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "神から遣わされた人が現れた。その名はヨハネであった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "彼は証しのために来た。光について証しするためであり、すべての人が彼を通して信じるためである。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "彼自身は光ではなく、ただ光について証しするために来た。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "すべての人を照らす真の光が世に来ようとしていた。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼は世におられた。世は彼によって成ったが、世は彼を認めなかった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "彼は自分のところに来たが、自分の民は彼を受け入れなかった。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "しかし、彼を受け入れた人々、彼の名を信じた人々には、神の子となる特権を与えた。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "この人々は、血によってではなく、肉の欲によってでもなく、人の欲によってでもなく、神によって生まれたのである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "言は肉となって、私たちの間に住まわれた。私たちは彼の栄光を見た。それは父のもとから来られた一人子の栄光であり、恵みと真理に満ちていた。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "ヨハネは彼について証しし、叫んで言った。「私の後に来られる方は、私よりも優れている。なぜなら、彼は私より先におられたからである。」"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼の満ちあふれる恵みから、私たちは皆、恵みの上に恵みを受けた。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "律法はモーセを通して与えられたが、恵みと真理はイエス・キリストを通して来たのである。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "いまだかつて神を見た者はいない。しかし、父のふところにいる一人子である神が、神を示されたのである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "これは、ユダヤ人の指導者たちがエルサレムから祭司とレビ人をヨハネのもとに送り、「あなたは誰ですか」と尋ねさせたときのヨハネの証しである。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "彼は告白して否まず、「私はメシアではない」と告白した。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "彼らは尋ねた。「それでは、あなたは誰ですか。エリヤですか。」彼は言った。「違います。」 「預言者ですか。」彼は答えた。「いいえ。」"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ついに彼らは言った。「あなたは誰ですか。私たちを送った人々に返事を持ち帰らせてください。あなた自身について何と言いますか。」"
            ]
        },
        {
            "verse": 23,
            "text": [
                "ヨハネは預言者イザヤの言葉を用いて答えた。「私は荒野で叫ぶ者の声である。『主の道を整えよ』」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "さて、使者たちはパリサイ人からヨハネに尋ねるために送られていた。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "彼らは彼に質問した。「それでは、なぜあなたはメシアでもなく、エリヤでもなく、預言者でもないのに洗礼を施すのですか。」"
            ]
        },
        {
            "verse": 26,
            "text": [
                "ヨハネは答えた。「私は水で洗礼を施しますが、あなたがたの中にあなたがたの知らない方が立っておられます。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "その方は私の後に来られる方であり、私はその方の履物のひもを解く値打ちもありません。」"
            ]
        },
        {
            "verse": 28,
            "text": [
                "これはヨルダンの向こう側のベタニヤで、ヨハネが洗礼を施していたときに起こったことである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "翌日、ヨハネはイエスが自分の方に来られるのを見て言った。「見よ、世の罪を取り除く神の小羊である。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "これは私が言った方である。『私の後に来られる方は、私よりも優れている。なぜなら、彼は私より先におられたからである。』"
            ]
        },
        {
            "verse": 31,
            "text": [
                "私は彼を認識しなかったが、彼がイスラエルに現れるために、私は水で洗礼を施して来たのである。」"
            ]
        },
        {
            "verse": 32,
            "text": [
                "それからヨハネはこの証しをした。「私は霊が鳩のように天から降りて彼の上に留まるのを見た。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "私は彼を認識しなかったが、水で洗礼を施すように私を遣わした方が私に言われた。『霊が降りて留まるのを見た人が、聖霊で洗礼を施す方である。』"
            ]
        },
        {
            "verse": 34,
            "text": [
                "私は見たので、この方が神の子であると証しする。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "その翌日、ヨハネは再び二人の弟子と共に立っていた。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "彼がイエスが通り過ぎるのを見たとき、「見よ、神の小羊である」と言った。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "これを聞いて、二人の弟子はイエスに従った。"
            ]
        },
        {
            "verse": 38,
            "text": [
                "イエスは振り返り、彼らがついて来るのを見て言われた。「何を求めているのですか。」彼らは言った。「ラビ」（訳すと先生）、あなたはどこにお泊まりですか。」"
            ]
        },
        {
            "verse": 39,
            "text": [
                "「来なさい、そうすれば分かります」と彼は言われた。彼らは行って、彼が泊まっている所を見、彼と共にその日を過ごした。それはおよそ第十時であった。"
            ]
        },
        {
            "verse": 40,
            "text": [
                "アンデレ、シモン・ペテロの兄弟は、ヨハネが言ったことを聞いてイエスに従った二人のうちの一人であった。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "アンデレが最初にしたことは、自分の兄弟シモンを見つけて、「私たちはメシアを見つけた」（訳すとキリスト）と言ったことである。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "彼はシモンをイエスのもとに連れて行った。イエスは彼を見て言われた。「あなたはヨハネの子シモンである。あなたはケファスと呼ばれるであろう」（訳すとペテロ）。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "翌日、イエスはガリラヤに行こうと決心された。ピリポを見つけて彼に言われた。「私に従いなさい。」"
            ]
        },
        {
            "verse": 44,
            "text": [
                "ピリポはアンデレとペテロと同じく、ベツサイダの町の出身であった。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "ピリポはナタナエルを見つけて言った。「私たちはモーセが律法に書き、預言者たちも書いた方を見つけた。ナザレのイエス、ヨセフの子である。」"
            ]
        },
        {
            "verse": 46,
            "text": [
                "「ナザレから何か良いものが出るだろうか」とナタナエルは言った。「来て見なさい」とピリポは言った。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "イエスがナタナエルが近づいて来るのを見たとき、言われた。「見よ、偽りのないイスラエル人がここにいる。」"
            ]
        },
        {
            "verse": 48,
            "text": [
                "「どうして私を知っているのですか」とナタナエルは言った。イエスは答えられた。「ピリポがあなたを呼ぶ前に、あなたがいちじくの木の下にいるのを見た。」"
            ]
        },
        {
            "verse": 49,
            "text": [
                "ナタナエルは答えて言った。「ラビ、あなたは神の子です。あなたはイスラエルの王です。」"
            ]
        },
        {
            "verse": 50,
            "text": [
                "イエスは言われた。「あなたがいちじくの木の下にいるのを見たと言ったので信じるのですか。あなたはそれよりも大きなことを見るであろう。」"
            ]
        },
        {
            "verse": 51,
            "text": [
                "さらに言われた。「まことに、まことに、あなたがたに言います。天が開けて、神の使いたちが人の子の上に上り下りするのをあなたがたは見るであろう。」"
            ]
        }
    ]
}