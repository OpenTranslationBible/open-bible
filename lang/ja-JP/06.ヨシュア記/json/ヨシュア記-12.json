            ]
        },
        {
            "verse": 23,
            "text": [
                "ドールの高地に位置するドールの王、一人；ギルガルのゴイイムの王、一人；"
            ]
        },
        {
            "verse": 24,
            "text": [
                "ティルツァの王、一人；合計三十一の王。"
            ]
        }
    ]
}