{
    "book": "詩篇",
    "chapter": 89,
    "verses": [
        {
            "text": [
                "エズラ人エタンのマスキール"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 私は主の慈しみを永遠に歌います。",
                "> 私の口であなたの真実を世々に知らせます。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 私は言いました、「慈しみは永遠に築かれる。",
                "> 天においてあなたの真実を確立される。」"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 「私は私の選ばれた者と契約を結んだ。",
                "> 私のしもべダビデに誓った、"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> あなたの子孫を永遠に確立し、",
                "> あなたの王座を世々に支える。」",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 天は主の驚くべき業を祝います。",
                "> あなたの真実もまた、聖なる者たちの集会の中で。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 天において主に比べられる者は誰か。",
                "> 力ある者の中で主のような者は誰か、"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 聖なる者たちの会議で大いに畏れられる神、",
                "> 彼を囲むすべての者の上に畏れられる方。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 万軍の主なる神よ、あなたのような方は誰か、力ある主よ。",
                "> あなたの真実はあなたを囲んでいる。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> あなたは海の荒れ狂う波を治め、",
                "> その波が立ち上がるとき、あなたはそれらを静める。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> あなたはラハブを打ち砕き、殺された者のようにし、",
                "> あなたの力強い腕で敵を散らされた。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 天はあなたのものであり、地もまたあなたのものです。",
                "> あなたは世界とその中にあるすべてを確立されました。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> あなたは北と南を形作り、",
                "> タボルとヘルモンはあなたの名に喜び歌います。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> あなたは力強い腕を持ち、",
                "> あなたの手は力強く、あなたの右手は高く上げられています。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 義と正義はあなたの王座の基盤であり、",
                "> 慈しみと真実はあなたの前を進みます。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 喜びの呼び声を聞く民は幸いです。",
                "> 主よ、彼らはあなたの御顔の光の中を歩みます。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 彼らは一日中あなたの名に喜び、",
                "> あなたの義によって高められます。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> あなたは彼らの力の輝きであり、",
                "> あなたの恵みによって私たちの角は高く上げられます。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 私たちの守護者は主であり、",
                "> 私たちの王はイスラエルの聖なる方です。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> あなたはかつてあなたの忠実な者たちに幻の中で語り、",
                "> 言われました、「私は力ある者に助けを与え、",
                "> 民の中から選ばれた者を高めた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 私は私のしもべダビデを見出し、",
                "> 私の聖なる油で彼に油を注いだ、"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 彼と共に私の手は確かであり、",
                "> 私の腕もまた彼を強くする。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 敵は彼を欺かず、",
                "> 悪しき者は彼を圧迫しない。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> しかし私は彼の前で彼の敵を打ち砕き、",
                "> 彼を憎む者を打ち倒す。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 私の真実と私の慈しみは彼と共にあり、",
                "> 私の名において彼の角は高く上げられる。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 私は彼の手を海の上に伸ばし、",
                "> 彼の右手を川の上に伸ばす。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 彼は私に呼びかける、『あなたは私の父、",
                "> 私の神、私の救いの基盤です。』"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 私はまた彼を私の初子とし、",
                "> 地の王たちの中で最も高い者とする。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 私は彼に対する私の慈しみを永遠に保ち、",
                "> 私の契約は彼と共に堅固である。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> こうして私は彼の子孫を永遠に確立し、",
                "> 彼の王座を天の日々のように永続させる。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> もし彼の子らが私の律法を捨て、",
                "> 私の裁きを守らないなら、"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> もし彼らが私の定めを破り、",
                "> 私の命令を守らないなら、"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> そのとき私は彼らの不正を杖で罰し、",
                "> 彼らの罪を災いで罰する。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> しかし私は彼から私の慈しみを取り去らず、",
                "> 私の約束に不誠実であることはない。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 私は私の契約を破らず、",
                "> 私の唇から出たことを変えることはない。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 私は一度私の聖さにかけて誓った。",
                "> 私はダビデを欺かない。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> 彼の子孫は永遠に続き、",
                "> 彼の王座は私の前で太陽のように常にある。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> それは月のように永遠に確立され、",
                "> 天における忠実な証人である。」",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> しかしあなたは拒絶し、軽蔑されました。",
                "> あなたはあなたの油注がれた者に対して怒りに満ちています。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> あなたはあなたのしもべの契約を破棄し、",
                "> 彼の冠を塵に汚されました。"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> あなたは彼のすべての城壁を破り、",
                "> 彼の要塞を廃墟にされました。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> 通り過ぎるすべての者が彼を略奪し、",
                "> 彼は隣人たちの恥となりました。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> あなたは彼の敵の右手を高め、",
                "> 彼のすべての敵を喜ばせました。"
            ]
        },
        {
            "verse": 43,
            "text": [
                "> あなたはまた彼の剣の刃を引き返し、",
                "> 戦いで彼を支えられませんでした。"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> あなたは彼の輝きを終わらせ、",
                "> 彼の王座を地に投げ倒されました。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> あなたは彼の若さの日々を短くし、",
                "> 彼を恥で包まれました。",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> どれほど長く、主よ。あなたは永遠に隠れられるのですか。",
                "> あなたの怒りは火のように燃えますか。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> 私の命がどれほど儚いかを思い出してください。",
                "> あなたはすべての人の子を何のために創造されたのでしょうか。"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> 誰が生きて死を見ないことができるでしょうか。",
                "> 彼はシェオルの力から自分の魂を救うことができるでしょうか。",
                "> セラ"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> 主よ、あなたの以前の慈しみの行いはどこにありますか。",
                "> あなたがダビデに誓われたあなたの真実の中で。"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> 主よ、あなたのしもべに対する嘲りを思い出してください。",
                "> 私が心に抱く多くの民の嘲りを。"
            ]
        },
        {
            "verse": 51,
            "text": [
                "> 主よ、あなたの敵が嘲り、",
                "> あなたの油注がれた者の足跡を嘲ったことを。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 52,
            "text": [
                "> 主が永遠に栄光を受けられますように。",
                "> アーメン、アーメン。"
            ]
        }
    ]
}