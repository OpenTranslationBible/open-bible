{
    "book": "詩篇",
    "chapter": 89,
    "verses": [
        {
            "text": [
                "エズラ人エタンのマスキール"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 私は主のあわれみを永遠に歌います。",
                "> 私の口で、あなたの真実を代々にわたって知らせます。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 私は言いました。「あわれみは永遠に築かれます。",
                "> 天において、あなたはあなたの真実を確立されます。」"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 「わたしは、わたしの選んだ者と約束を交わした。",
                "> わたしのしもべダビデに誓った、"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> あなたの子孫を永遠に確立し、",
                "> あなたの王座を世々に支える。」",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 主よ、天はあなたの不思議な御業をたたえます。",
                "> 聖なる者たちの集会でも、あなたの真実がたたえられます。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 天において、だれが主に比べられるでしょうか。",
                "> 力ある者たちの中で、だれが主のような方でしょうか。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 主は、聖なる者たちの会議で大いに畏れられる神、",
                "> ご自分を囲むすべての者にまさって畏るべき方です。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 万軍の神である主よ、だれがあなたのような方でしょうか。主よ、力ある方よ。",
                "> あなたの真実があなたを取り囲んでいます。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> あなたは海の高ぶりを治め、",
                "> その波が立つとき、あなたはそれを静められます。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> あなたはラハブを、殺された者のように打ち砕き、",
                "> あなたの力強い腕で敵を散らされました。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 天はあなたのものであり、地もまたあなたのものです。",
                "> あなたは世界とその中にあるすべてを確立されました。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> あなたは北と南を形作り、",
                "> タボルとヘルモンはあなたの名に喜び歌います。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> あなたの腕は力強く、",
                "> あなたの手は強く、あなたの右の手は高く上げられています。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 義と正義はあなたの王座の基であり、",
                "> あわれみと真理があなたの前を進みます。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 喜びの呼び声を聞く民は幸いです。",
                "> 主よ、彼らはあなたの御顔の光の中を歩みます。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 彼らは一日中あなたの名に喜び、",
                "> あなたの義によって高められます。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> あなたは彼らの力の輝きであり、",
                "> あなたの恵みによって私たちの角は高く上げられます。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 私たちの守護者は主であり、",
                "> 私たちの王はイスラエルの聖なる方です。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> あなたはかつて、幻のうちにあなたに忠実な者たちに語り、",
                "> 言われました。「わたしは力ある者に助けを与え、",
                "> 民の中から選ばれた者を高めた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> わたしはわたしのしもべダビデを見いだし、",
                "> わたしの聖なる油で彼に油を注いだ。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> わたしの手は彼とともに堅く、",
                "> わたしの腕も彼を強くする。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 敵は彼を欺かず、",
                "> 悪しき者は彼を圧迫しない。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> しかしわたしは彼の前で彼の敵を打ち砕き、",
                "> 彼を憎む者を打ち倒す。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> わたしの真実とわたしのあわれみは彼とともにあり、",
                "> わたしの名によって彼の角は高く上げられる。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> わたしは彼の手を海の上に伸ばし、",
                "> 彼の右手を川の上に伸ばす。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 彼はわたしに呼びかける。『あなたは私の父、",
                "> 私の神、私の救いの礎です。』"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> わたしはまた彼をわたしの初子とし、",
                "> 地の王たちの中で最も高い者とする。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> わたしは彼に対するわたしのあわれみを永遠に保ち、",
                "> わたしの契約は彼とともに堅くある。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> こうしてわたしは彼の子孫を永遠に確立し、",
                "> 彼の王座を天の日々のように続くものとする。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> もし彼の子らがわたしの律法を捨て、",
                "> わたしの裁きに従わないなら、"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> もし彼らがわたしの掟を破り、",
                "> わたしの命令を守らないなら、"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> そのときわたしは、彼らの不正を杖で、",
                "> 彼らの咎を災いで懲らしめる。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> しかしわたしは彼からわたしのあわれみを取り去らず、",
                "> わたしの約束に対して不実であることもない。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> わたしはわたしの契約を破らず、",
                "> わたしの唇から出たことを変えることもない。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> わたしは一度、わたしの聖さにかけて誓った。",
                "> わたしはダビデを欺かない。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> 彼の子孫は永遠に続き、",
                "> 彼の王座はわたしの前で太陽のように変わらない。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> それは月のように永遠に確立され、",
                "> 天における忠実な証人である。」",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> しかしあなたは拒絶し、軽蔑されました。",
                "> あなたはあなたの油注がれた者に対して怒りに満ちています。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> あなたはあなたのしもべの契約を破棄し、",
                "> 彼の冠を塵に汚されました。"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> あなたは彼のすべての城壁を破り、",
                "> 彼の要塞を廃墟にされました。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> 通り過ぎるすべての者が彼を略奪し、",
                "> 彼は隣人たちの恥となりました。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> あなたは彼の敵の右手を高め、",
                "> 彼のすべての敵を喜ばせました。"
            ]
        },
        {
            "verse": 43,
            "text": [
                "> あなたはまた彼の剣の刃を押し返し、",
                "> 戦いで彼を支えてくださいませんでした。"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> あなたは彼の輝きを終わらせ、",
                "> 彼の王座を地に投げ倒されました。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> あなたは彼の若さの日々を短くし、",
                "> 彼を恥で包まれました。",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> 主よ、いつまでですか。あなたは永遠に身を隠されるのですか。",
                "> あなたの怒りは火のように燃え続けるのですか。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> 私の命がどれほどはかないかを、思い出してください。",
                "> 何とむなしいもののために、あなたはすべての人の子らを造られたことでしょう。"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> 誰が生きて死を見ないことができるでしょうか。",
                "> 彼はシェオルの力から自分の魂を救うことができるでしょうか。",
                "> セラ"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> 主よ、以前のあなたのあわれみの数々、",
                "> あなたがご自分の真実によってダビデに誓われたそれは、どこにあるのですか。"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> 主よ、あなたのしもべに対する嘲りを思い出してください。",
                "> 私が心に抱く多くの民の嘲りを。"
            ]
        },
        {
            "verse": 51,
            "text": [
                "> 主よ、あなたの敵が嘲り、",
                "> あなたの油注がれた者の足跡を嘲ったことを。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 52,
            "text": [
                "> 主が永遠に栄光を受けられますように。",
                "> アーメン、アーメン。"
            ]
        }
    ]
}
