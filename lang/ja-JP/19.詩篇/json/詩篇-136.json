{
    "book": "詩篇",
    "chapter": 136,
    "verses": [
        {
            "verse": 1,
            "text": [
                "主に感謝せよ、主は良い、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "神の神に感謝せよ、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "主の主に感謝せよ、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "ただひとり大いなる奇跡を行う方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "知恵をもって天を造られた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "水の上に地を広げられた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "大いなる光を造られた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "昼を治めるために太陽を、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "夜を治めるために月と星を、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "エジプト人、すなわちその初子を打たれた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "そしてイスラエルをその中から導き出された方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "強い手と伸ばされた腕で、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "紅海を分けられた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "そしてイスラエルをその中を通らせた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "しかし、パロとその軍勢を紅海に投げ込まれた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "荒野を通してその民を導かれた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "大いなる王たちを打たれた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "力ある王たちを殺された方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "アモリ人の王シホン、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "バシャンの王オグ、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "彼らの地を嗣業として与えられた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "そのしもべイスラエルへの嗣業として、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "我らの卑しさを覚えておられた方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "そして我らの敵から救い出された方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "すべての肉に食物を与えられる方に、",
                "> その恵みはとこしえに。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "天の神に感謝せよ、",
                "> その恵みはとこしえに。"
            ]
        }
    ]
}