{
    "book": "詩篇",
    "chapter": 136,
    "verses": [
        {
            "verse": 1,
            "text": [
                "主に感謝せよ。主は良い方である。",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "神々の神に感謝せよ。",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "主の主に感謝せよ。",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "ただひとり、大いなる不思議な御業を行われる方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "巧みに天を造られた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "水の上に地を広げられた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "大いなる光を造られた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "昼を治める太陽を、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "夜を治める月と星を、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "エジプト人を、すなわちその初子を打たれた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "そしてイスラエルを、その中から導き出された方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "強い手と伸べられた腕で、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "紅海を幾つにも分けられた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "そしてイスラエルを、その真ん中を通り抜けさせた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "しかし、ファラオとその軍勢を紅海に投げ込まれた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "荒野を通してその民を導かれた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "大いなる王たちを打たれた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "そして力ある王たちを殺された方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "アモリ人の王シホンを、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "そしてバシャンの王オグを、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "そして彼らの地を嗣業として与えられた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "そのしもべイスラエルへの嗣業として、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "私たちが低い者であったときに、私たちを覚えておられた方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "そして私たちを敵から救い出された方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "すべての肉なる者に食物を与えられる方に、",
                "> その慈しみはとこしえに続く。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "天の神に感謝せよ。",
                "> その慈しみはとこしえに続く。"
            ]
        }
    ]
}
