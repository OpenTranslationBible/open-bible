{
    "book": "詩篇",
    "chapter": 150,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 主を賛美せよ！",
                "> 聖なる所で神をあがめよ。",
                "> 広大な天で神を賛美せよ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 力強い御業のゆえに神をあがめよ。",
                "> この上ない偉大さのゆえに神を賛美せよ。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ラッパの音で神をあがめよ。",
                "> 琴と竪琴で神を賛美せよ。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 鼓と踊りで神をあがめよ。",
                "> 弦楽器と笛で神を賛美せよ。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 響き渡るシンバルで神をあがめよ。",
                "> 鳴り響くシンバルで神を賛美せよ。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 息のあるすべてのものよ、主を賛美せよ。",
                "> 主を賛美せよ！"
            ]
        }
    ]
}
