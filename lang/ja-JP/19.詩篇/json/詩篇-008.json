{
    "book": "詩篇",
    "chapter": 8,
    "verses": [
        {
            "text": [
                "指揮者のために。ギティトに合わせて。ダビデの詩。"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 主よ、私たちの主よ、",
                "> あなたの御名は全地にわたって、なんと荘厳なことでしょう。",
                "> あなたは天の上に、ご自分の栄光を表しておられます。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 幼子と乳飲み子の口によって、あなたは力を打ち立てられました。",
                "> あなたに敵対する者たちのゆえに、",
                "> 敵と復讐する者を黙らせるためです。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> あなたの天、あなたの御手の業、",
                "> あなたが据えられた月と星を思うとき、"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 人とは何者でしょう。あなたがその人を心に留められるとは。",
                "> 人の子とは何者でしょう。あなたがその子を顧みられるとは。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> しかし、あなたは人を神よりわずかに低いものとして造り、",
                "> 栄光と誉れの冠をかぶらせてくださいます。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> あなたは、ご自分の手の業を人に治めさせ、",
                "> 万物をその足の下に置かれました。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> すべての羊と牛、",
                "> また野の獣も、"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 空の鳥と海の魚、",
                "> 海の道を通るものすべて。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 主よ、私たちの主よ、",
                "> あなたの御名は全地にわたって、なんと荘厳なことでしょう。"
            ]
        }
    ]
}
