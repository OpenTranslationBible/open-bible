{
    "book": "詩篇",
    "chapter": 134,
    "verses": [
        {
            "text": [
                "登の歌"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 見よ、主をほめたたえよ、主のすべてのしもべたちよ、",
                "> 夜、主の家に仕える者たちよ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 聖所に向かって手を上げ、",
                "> 主をほめたたえよ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 天と地を造られた主が、シオンからあなたを祝福されるように。"
            ]
        }
    ]
}