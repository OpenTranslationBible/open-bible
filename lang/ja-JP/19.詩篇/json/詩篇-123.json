{
    "book": "詩篇",
    "chapter": 123,
    "verses": [
        {
            "text": [
                "登る歌"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 天に座しておられるあなたに、",
                "> 私は目を上げます。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 見よ、しもべたちの目がその主人の手に注がれ、",
                "> はしための目がその女主人の手に注がれるように、",
                "> 私たちの目は私たちの神、主に向けられています。",
                "> 彼が私たちに恵みを示してくださるまで。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 主よ、私たちに恵みを示してください、恵みを示してください、",
                "> 私たちは侮辱に飽き飽きしています。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 私たちの魂は飽き飽きしています、",
                "> 安逸を貪る者たちの嘲りに、",
                "> 高慢な者たちの侮辱に。"
            ]
        }
    ]
}