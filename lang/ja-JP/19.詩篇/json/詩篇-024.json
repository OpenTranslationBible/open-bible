{
    "book": "詩篇",
    "chapter": 24,
    "verses": [
        {
            "text": [
                "ダビデの詩篇"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 地も、そこに満ちるものも主のものである。",
                "> 世界も、そこに住む者たちも主のものである。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 主がそれを海の上に据え、",
                "> 水の上に堅く立てられたからである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 誰が主の山に登ることを許されるのか。",
                "> 誰がその聖なる場所に立つことができるのか。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 手が清く、心が純粋な者、",
                "> その魂を偽りに向けず、",
                "> 偽って誓わなかった者。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> そのような人は主から祝福を受け、",
                "> 救う神から義を受ける。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> これが主を求める者たちの世代、",
                "> あなたの御顔を求める者、ヤコブである。",
                "> セラ"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 門よ、頭を上げよ。",
                "> いにしえの扉よ、身を起こせ。",
                "> 栄光の王が入られるために。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 栄光の王とはだれか。",
                "> 力強く勇ましい主、",
                "> 戦いに力ある主である。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 門よ、頭を上げよ。",
                "> いにしえの扉よ、高く上がれ。",
                "> 栄光の王が入られるために。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> この威厳ある王とはだれか。",
                "> 万軍の主、この方こそ栄光の王である。",
                "> セラ"
            ]
        }
    ]
}
