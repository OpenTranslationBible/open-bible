{
    "book": "詩篇",
    "chapter": 16,
    "verses": [
        {
            "text": [
                "ダビデのミクタム"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 神よ、私をお守りください。私はあなたに避け所を求めています。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 私は主に言いました。「あなたは私の主です。",
                "> あなたを離れて、私の幸いはありません」と。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 地にいる聖徒たち、",
                "> 彼らこそ尊い者たちです。私の喜びはすべて、彼らにあります。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 他の神に走る者たちの悲しみは増し加わります。",
                "> 私は彼らの血の注ぎの捧げ物を注がず、",
                "> その名を唇に上らせません。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 主は私の受ける分、私の祝福の杯です。",
                "> あなたは私の割り当てを堅く守ってくださいます。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 境界線は、私のために好ましい場所に落ちました。",
                "> まことに、私には喜ばしい相続地があります。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 私を導いてくださる主をほめたたえます。",
                "> まことに、夜も私の心が私を教えます。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 私は絶えず主を自分の前に置いています。",
                "> 主が私の右におられるので、私は揺るがされません。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> それゆえ、私の心は喜び、私の霊は歓喜します。",
                "> 私の体もまた、安らかに憩います。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> あなたは私の魂をシェオルに捨て置かれず、",
                "> あなたの聖なる方が朽ちるのをお見せにならないからです。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> あなたは私に命の道を示してくださいます。",
                "> あなたの御前には喜びが満ちています。",
                "> あなたの右手には永遠の楽しみがあります。"
            ]
        }
    ]
}
