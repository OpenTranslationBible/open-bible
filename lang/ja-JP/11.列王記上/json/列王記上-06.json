{
    "book": "列王記第一",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "イスラエルの子らがエジプトの地を出てから四百八十年目、",
                "ソロモンがイスラエルを治めて四年目の",
                "ジブの月（第二の月）に、",
                "彼は主の家の建設を開始した。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "ソロモン王が主のために建てた家は、長さ六十キュビト、",
                "幅二十キュビト、",
                "高さ三十キュビトであった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "家の本堂の前の玄関は、家の幅に合わせて長さ二十キュビト、",
                "奥行きは家の前に十キュビトであった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "そして彼は家に芸術的な枠の窓を作った。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼はまた、家の壁、すなわち本堂と内陣の壁に接して、",
                "周囲に建て増しをし、",
                "その周りに脇間を造った。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "最下層の床は幅五キュビト、",
                "中層は幅六キュビト、",
                "三層目は幅七キュビトであった。",
                "彼は家の壁の周りに段を作り、",
                "梁が家の壁に差し込まれないようにした。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "家は石切り場で整えられた石で建てられたので、",
                "建てている間、槌や斧など鉄の道具の音は家の中で聞こえなかった。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "下の階の脇間の入口は家の右側にあり、",
                "らせん階段で中の階に上り、",
                "中の階から三階に上るようになっていた。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "こうして彼は家を建てて完成させ、",
                "家を杉の梁と板で覆った。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼はまた、家全体に接して脇間を建てた。",
                "それぞれ高さは五キュビトで、",
                "杉材で家に固定されていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "そのとき、主のことばがソロモンに臨んで、こう言った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "「あなたが建てているこの家についてだが、",
                "もしあなたがわたしの掟に歩み、",
                "わたしの定めを行い、",
                "わたしのすべての命令を守ってそれに歩むなら、",
                "わたしはあなたの父ダビデに語ったことばを、あなたに対して成就する。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "わたしはイスラエルの子らのただ中に住み、",
                "わたしの民イスラエルを見捨てない。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "こうして、ソロモンは家を建てて完成させた。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼は家の内側の壁を杉で建て、",
                "家の床から天井まで内側を木で覆い、",
                "家の床をジュニパーの板で覆った。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "また、家の奥の二十キュビトの部分を、",
                "床から天井まで杉の板で仕切り、",
                "その内側を内陣、すなわち至聖所とした。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "内陣の前の本堂は、",
                "長さ四十キュビトであった。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "家の内部は杉で飾られ、",
                "ひょうたんや開いた花の形に彫刻されていた。",
                "すべてが杉で、",
                "石は見えなかった。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "彼は主の契約の箱を置くために、",
                "家の奥に内陣を設けた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "内陣は長さ二十キュビト、",
                "幅二十キュビト、",
                "高さ二十キュビトで、",
                "純金で覆われていた。",
                "彼はまた、祭壇を杉で覆った。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "ソロモンは家の内部を純金で覆った。",
                "彼は内陣の前に金の鎖を引き、",
                "それを金で覆った。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "彼は家全体を金で覆い、",
                "家が完成するまでそうした。",
                "彼はまた、内陣のそばにあった祭壇全体を金で覆った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "内陣の中に、彼はオリーブの木で二つのケルビムを作り、",
                "それぞれ高さ十キュビトであった。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "一方のケルブの片方の翼の長さは五キュビト、",
                "そのケルブのもう片方の翼の長さも五キュビトで、",
                "一方の翼の先からもう一方の翼の先までは十キュビトであった。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "もう一方のケルブも十キュビトであった。",
                "二つのケルビムは同じ寸法、同じ形であった。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "一方のケルブの高さは十キュビトで、",
                "もう一方のケルブも同じ高さであった。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "彼はケルビムを奥の家の中に置いた。",
                "ケルビムの翼は広げられていて、",
                "一方のケルブの翼は一方の壁に、",
                "もう一方のケルブの翼はもう一方の壁に触れ、",
                "それぞれの翼は家の中央で互いに触れ合っていた。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼はまた、ケルビムを金で覆った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "彼は家の周囲の壁全体に、",
                "内側の部屋から外側の部屋まで、",
                "ケルビムとヤシの木と開いた花の模様を彫り刻んだ。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "彼はまた、家の床を金で覆い、",
                "内側の部屋から外側の部屋までそうした。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "内陣の入口には、オリーブの木で扉を作り、",
                "上枠と五面の柱を作った。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "彼はオリーブの木で二つの扉を作り、",
                "それにケルビム、ヤシの木、開いた花を彫刻し、",
                "それを金で覆い、",
                "ケルビムとヤシの木に金を打ち付けた。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "同様に、彼は本堂の入口にオリーブの木で四面の柱を作り、"
            ]
        },
        {
            "verse": 34,
            "text": [
                "また、糸杉材で二枚の扉を作った。",
                "一方の扉の二枚の戸板は回転軸で開き、",
                "もう一方の扉の二枚の戸板も回転軸で開くようになっていた。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "彼はそれにケルビム、ヤシの木、開いた花を彫刻し、",
                "彫刻の上に均等に金を施した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 36,
            "text": [
                "彼は切石の三列と",
                "杉の梁の一列で内庭を建設した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "第四年のジブの月に、主の家の基礎が据えられた。"
            ]
        },
        {
            "verse": 38,
            "text": [
                "第十一年のブルの月（第八の月）に、",
                "家はすべての部分とすべての計画に従って完成した。",
                "彼はそれを七年間で建てた。"
            ]
        }
    ]
}
