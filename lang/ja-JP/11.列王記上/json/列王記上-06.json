{
    "book": "列王記第一",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "イスラエルの子らがエジプトの地を出てから四百八十年目、",
                "ソロモンがイスラエルを治めて四年目の",
                "ジブの月（第二の月）に、",
                "彼は主の家の建設を開始した。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "ソロモン王が主のために建てた家は、長さ六十キュビト、",
                "幅二十キュビト、",
                "高さ三十キュビトであった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "家の本堂の前のポーチは長さ二十キュビトで、",
                "家の幅に沿っており、",
                "家の前に深さ十キュビトであった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "そして彼は家に芸術的な枠の窓を作った。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼はまた、家の壁に付けて付属建物を建て、",
                "家の壁の周り、すなわち本堂と内陣の周りに、",
                "側室を作った。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "最下層の床は幅五キュビト、",
                "中層は幅六キュビト、",
                "三層目は幅七キュビトであった。",
                "彼は家の壁の周りに段を作り、",
                "梁が家の壁に差し込まれないようにした。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "家は採石場で準備された石で建てられ、",
                "建設中は家の中でハンマーや斧、鉄の道具の音は聞こえなかった。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "最下層の側室の入口は家の右側にあり、",
                "螺旋階段で中層に上がり、",
                "中層から三層目に上がった。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "こうして彼は家を建てて完成させ、",
                "家を杉の梁と板で覆った。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼はまた、家全体に対して側室を建て、",
                "それぞれ高さ五キュビトで、",
                "それらは杉の木材で家に取り付けられていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "その時、主がソロモンに言われた、"
            ]
        },
        {
            "verse": 12,
            "text": [
                "「あなたが建てているこの家について、",
                "もしあなたが私の掟を守り、",
                "私の定めを行い、",
                "私のすべての命令を守って歩むならば、",
                "私はあなたの父ダビデに語った言葉をあなたに果たす。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "そして私はイスラエルの子らの間に住み、",
                "私の民イスラエルを見捨てない。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "こうして、ソロモンは家を建てて完成させた。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼は家の内側の壁を杉で建て、",
                "家の床から天井まで内側を木で覆い、",
                "家の床をジュニパーの板で覆った。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼はまた、家の後部に杉の板で二十キュビトの部分を建て、",
                "床から天井まで内側に建て、",
                "それを内陣、すなわち最も聖なる場所として知られる場所とした。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "内陣の前の本堂は、",
                "長さ四十キュビトであった。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "家の内部は杉で飾られ、",
                "ひょうたんや開いた花の形に彫刻されていた。",
                "すべてが杉で、",
                "石は見えなかった。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "彼は家の中に内陣を準備し、",
                "主の契約の箱を置くためであった。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "内陣は長さ二十キュビト、",
                "幅二十キュビト、",
                "高さ二十キュビトで、",
                "純金で覆われていた。",
                "彼はまた、祭壇を杉で覆った。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "ソロモンは家の内部を純金で覆った。",
                "彼は内陣の前に金の鎖を引き、",
                "それを金で覆った。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "彼は家全体を金で覆い、",
                "家が完成するまでそうした。",
                "彼はまた、内陣のそばにあった祭壇全体を金で覆った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "内陣の中に、彼はオリーブの木で二つのケルビムを作り、",
                "それぞれ高さ十キュビトであった。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "ケルビムの一つの翼の長さは五キュビト、",
                "もう一つの翼の長さも五キュビトで、",
                "翼の先から翼の先まで十キュビトであった。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "もう一つのケルビムも十キュビトで、",
                "両方のケルビムは同じ大きさと形であった。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "一つのケルビムの高さは十キュビトで、",
                "もう一つのケルビムも同じ高さであった。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "彼はケルビムを内陣に置き、",
                "ケルビムの翼は広げられ、",
                "一つの翼が一方の壁に触れ、",
                "もう一つのケルビムの翼が他方の壁に触れ、",
                "彼らの翼は家の中央で互いに触れ合っていた。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "彼はまた、ケルビムを金で覆った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "彼は家のすべての壁を周囲に彫刻し、",
                "ケルビム、ヤシの木、開いた花の彫刻を施し、",
                "内側の部屋から外側の部屋までそうした。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "彼はまた、家の床を金で覆い、",
                "内側の部屋から外側の部屋までそうした。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "内陣の入口には、オリーブの木で扉を作り、",
                "上枠と五面の柱を作った。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "彼はオリーブの木で二つの扉を作り、",
                "それにケルビム、ヤシの木、開いた花を彫刻し、",
                "それを金で覆い、",
                "ケルビムとヤシの木に金を打ち付けた。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "同様に、彼は本堂の入口にオリーブの木で四面の柱を作り、"
            ]
        },
        {
            "verse": 34,
            "text": [
                "糸杉の木で二つの扉を作り、",
                "一つの扉の二枚の葉は回転軸で回り、",
                "もう一つの扉の二枚の葉も回転軸で回った。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "彼はそれにケルビム、ヤシの木、開いた花を彫刻し、",
                "彫刻の上に均等に金を施した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 36,
            "text": [
                "彼は切石の三列と",
                "杉の梁の一列で内庭を建設した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "第四年のジブの月に、主の家の基礎が据えられた。"
            ]
        },
        {
            "verse": 38,
            "text": [
                "第十一年のブルの月（第八の月）に、",
                "家はすべての部分とすべての計画に従って完成した。",
                "彼はそれを七年間で建てた。"
            ]
        }
    ]
}