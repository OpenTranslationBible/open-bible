{
    "book": "列王記第一",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "さて、ソロモンは自分の家を十三年かけて建て、",
                "その家をすべて完成させた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "彼はレバノンの森の家を建てた。",
                "その長さは百キュビト、幅は五十キュビト、高さは三十キュビトで、",
                "四列の杉の柱の上に杉の梁があった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "四十五本の柱の上にある脇間の上は、杉で屋根が葺かれていた。",
                "柱は一列に十五本であった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "三列の装飾的な窓枠があり、",
                "各窓は三段にわたって他の窓に向かっていた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "すべての戸口と戸枠は四角い芸術的な枠があり、",
                "各窓は三段にわたって他の窓に向かっていた。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "次に彼は柱の広間を造った。",
                "その長さは五十キュビト、幅は三十キュビトで、",
                "その前には柱のある玄関があり、さらにその前にひさしがあった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "彼はまた、さばきを行うための王座の広間、",
                "すなわちさばきの広間を造り、床から天井まで杉の板を張った。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "彼が住む家は、",
                "その広間の奥のもう一つの庭にあって、同じ造りであった。また、",
                "ソロモンが妻として迎えたファラオの娘のためにも、この広間と同じような家を造った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "これらすべては貴重な石で作られており、",
                "大きさに合わせて切られ、内側と外側に鋸で切られていた。",
                "基礎から軒まで、外側から大きな中庭まで。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "基礎は貴重な石で、",
                "大きな石、十キュビトと八キュビトの石であった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "その上には貴重な石、大きさに合わせて切られた石、",
                "そして杉があった。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "大庭の周囲には、主の家の内庭や家の玄関と同じように、",
                "切り石が三段と杉の梁が一段あった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "この時、ソロモン王はツロからヒラムを呼び寄せた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼はナフタリ族の未亡人の息子で、",
                "彼の父はツロの人で青銅の職人であった。",
                "彼は青銅のあらゆる作業を行うための知恵と理解と技術に満ちていた。",
                "それで彼はソロモン王のもとに来て、すべての作業を行った。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼は青銅の柱を二本鋳造した。",
                "一本の柱の高さは十八キュビトで、",
                "どちらの柱も周囲は十二キュビトの綱で測るほどであった。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "また、柱の頂に据えるために、青銅を鋳て柱頭を二つ造った。",
                "一方の柱頭の高さは五キュビト、もう一方の柱頭の高さも五キュビトであった。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "柱の頂にある柱頭には、網細工の格子と、鎖細工の撚り糸の飾りがあり、",
                "一つの柱頭に七つずつあった。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "こうして彼は柱を造り、",
                "柱の頂にある柱頭を覆うために、",
                "一つの網細工の周りにザクロを二列に巡らせた。もう一方の柱頭にも同じようにした。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "玄関にある柱の頂の柱頭は、ユリの花の形をしていて、",
                "四キュビトであった。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "二本の柱の上の柱頭は、網細工のそばにある丸い膨らみのさらに上にもあり、",
                "ザクロは各柱頭の周囲に二百個ずつ列をなしていた。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "彼は本堂の玄関に柱を立てた。",
                "右側の柱を立ててこれをヤキンと名づけ、",
                "左側の柱を立ててこれをボアズと名づけた。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "柱の頂にはユリの花の形があった。",
                "こうして柱の工事は完了した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "彼はまた鋳造金属の海を作った。縁から縁まで十キュビトで、円形であり、",
                "高さは五キュビトで、三十キュビトの線がその周囲を測った。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "その縁の下にはひょうたんがあり、",
                "一キュビトに十個、海の周りを取り囲んでいた。",
                "ひょうたんは鋳造されたときに二列に鋳造された。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "それは十二の雄牛の上に立っており、",
                "三つは北を向き、三つは西を向き、三つは南を向き、三つは東を向いていた。",
                "海はその上に置かれ、",
                "そのすべての後部は内側を向いていた。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "その厚さは一手幅で、",
                "縁は杯の縁のように、",
                "ユリの花のように造られていた。",
                "それは二千バテを入れることができた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "次に彼は青銅の台を十個作った。",
                "各台の長さは四キュビト、幅は四キュビト、高さは三キュビトであった。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "そして台のデザインはこうであった。",
                "それらには枠があり、枠の間に境界があった。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "そして枠の間の境界にはライオン、雄牛、ケルビムがあった。",
                "そして枠の上には台座があり、",
                "ライオンと雄牛の下には装飾的な花輪があった。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "各台には青銅の車輪が四つと青銅の車軸があり、",
                "その四隅の脚には支えがあった。",
                "洗盤の下には鋳物の支えがあり、",
                "それぞれの脇に花輪があった。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "その頂上の冠の内側の開口部は一キュビトで、",
                "開口部は台座のように丸く、一キュビト半の直径があった。",
                "そして開口部にも彫刻があった。",
                "その境界は四角で、丸くはなかった。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "そして四つの車輪は境界の下にあり、",
                "車輪の軸は台の上にあった。",
                "車輪の高さは一キュビト半であった。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "車輪の工芸は戦車の車輪のようであった。",
                "その軸、縁、スポーク、ハブはすべて鋳造されていた。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "各台の四隅には四つの支えがあり、",
                "その支えは台そのものと一体であった。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "台の頂上には半キュビトの高さの円形の形があり、",
                "台の頂上にはその支えと境界が一体化されていた。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "彼はその支えの板と鏡板の上に、",
                "それぞれの空いている所に応じて、",
                "ケルビム、ライオン、ヤシの木を彫り、",
                "周囲に花輪を彫った。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "彼はこのようにして十個の台を作った。",
                "それらはすべて均一な鋳造、寸法、形状を持っていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "また彼は青銅の洗盤を十個造った。洗盤はそれぞれ四十バテ入り、",
                "四キュビトであった。",
                "十個の台のそれぞれに洗盤が一つずつ載せられた。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "それから彼は台を設置した。",
                "五つは家の右側に、五つは家の左側に。",
                "そして海を家の右側、東側の南に設置した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "さて、ヒラムは洗盤とシャベルと鉢を造った。",
                "こうしてヒラムは、ソロモン王のために主の家で行ったすべての仕事を終えた。すなわち、"
            ]
        },
        {
            "verse": 41,
            "text": [
                "すなわち、二本の柱、二本の柱の頂にある柱頭の二つの玉、",
                "柱の頂にある柱頭の二つの玉を覆う二つの網細工、"
            ]
        },
        {
            "verse": 42,
            "text": [
                "二つの網細工のための四百個のザクロ、",
                "すなわち柱の上にある柱頭の二つの玉を覆うため、網細工一つにつきザクロ二列、"
            ]
        },
        {
            "verse": 43,
            "text": [
                "十個の台と、その台の上の十個の洗盤、"
            ]
        },
        {
            "verse": 44,
            "text": [
                "「海」と呼ばれる大きな洗盤と、その下の十二頭の雄牛、"
            ]
        },
        {
            "verse": 45,
            "text": [
                "そして鍋、シャベル、鉢。",
                "ヒラムがソロモン王のために主の家で作ったこれらすべての器具は磨かれた青銅であった。"
            ]
        },
        {
            "verse": 46,
            "text": [
                "王はヨルダンの低地、スコテとザレタンの間の粘土質の土地で、",
                "それらを鋳造した。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "ソロモンはすべての器具を計量せずに残した。",
                "それらがあまりにも多かったので、",
                "青銅の重さは測定できなかった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 48,
            "text": [
                "ソロモンはまた、主の家にあるすべての用具を造った。",
                "すなわち、金の祭壇、臨在のパンを載せる金の机、"
            ]
        },
        {
            "verse": 49,
            "text": [
                "内陣の前に右側に五つ、左側に五つ置かれた純金の燭台、",
                "金の花飾り、",
                "ともしび皿、火ばさみ、"
            ]
        },
        {
            "verse": 50,
            "text": [
                "純金の杯、芯切りばさみ、鉢、ひしゃく、火皿、",
                "さらに奥の家すなわち至聖所の扉と、",
                "家すなわち本堂の扉のための金のちょうつがいである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "それで、ソロモン王が主の家で行ったすべての作業は完了した。",
                "そしてソロモンは父ダビデが捧げたもの、",
                "銀、金、器具を持ち込み、",
                "それらを主の家の宝物庫に置いた。"
            ]
        }
    ]
}
