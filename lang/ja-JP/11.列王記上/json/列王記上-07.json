{
    "book": "列王記第一",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "さて、ソロモンは自分の家を十三年かけて建て、",
                "その家をすべて完成させた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "彼はレバノンの森の家を建てた。",
                "その長さは百キュビト、幅は五十キュビト、高さは三十キュビトで、",
                "四列の杉の柱の上に杉の梁があった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "それは四十五の柱の上に、上の部屋に杉で屋根がかけられており、",
                "各列に十五の柱があった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "三列の装飾的な窓枠があり、",
                "各窓は三段にわたって他の窓に向かっていた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "すべての戸口と戸枠は四角い芸術的な枠があり、",
                "各窓は三段にわたって他の窓に向かっていた。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "次に彼は柱の広間を作った。",
                "その長さは五十キュビト、幅は三十キュビトで、",
                "前には柱とその前に天蓋があるポーチがあった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "彼は裁きを行うための玉座の広間、裁きの広間を作った。",
                "それは床から天井まで杉でパネルが張られていた。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "彼が住むための家は、",
                "広間から内側の他の中庭にあり、同じ工法で作られていた。",
                "彼はまた、ソロモンが妻として迎えたパロの娘のために、この広間のような家を作った。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "これらすべては貴重な石で作られており、",
                "大きさに合わせて切られ、内側と外側に鋸で切られていた。",
                "基礎から軒まで、外側から大きな中庭まで。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "基礎は貴重な石で、",
                "大きな石、十キュビトと八キュビトの石であった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "その上には貴重な石、大きさに合わせて切られた石、",
                "そして杉があった。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "そのため、大きな中庭は周囲に三列の切石と",
                "一列の杉の梁があり、",
                "主の家の内庭と家のポーチに似ていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "この時、ソロモン王はツロからヒラムを呼び寄せた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼はナフタリ族の未亡人の息子で、",
                "彼の父はツロの人で青銅の職人であった。",
                "彼は青銅のあらゆる作業を行うための知恵と理解と技術に満ちていた。",
                "それで彼はソロモン王のもとに来て、すべての作業を行った。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼は青銅の柱を二本鋳造した。",
                "一本の柱の高さは十八キュビトで、",
                "十二キュビトの線が両方の周囲を測った。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼は柱の頂上に置くための鋳造青銅の冠を二つ作った。",
                "一つの冠の高さは五キュビトで、もう一つの冠の高さも五キュビトであった。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "柱の頂上にある冠のために、格子細工と鎖細工のねじれた糸があり、",
                "各冠に七つずつあった。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "それで彼は柱を作り、",
                "一つの格子細工の周りにザクロを二列作り、",
                "柱の上にある冠を覆った。もう一つの冠も同様にした。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "今、ポーチの柱の頂上にある冠はユリのデザインで、",
                "四キュビトであった。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "そして、格子細工の隣にある丸い部分の上に、二つの柱の上に冠があり、",
                "ザクロは各冠の周りに二百個ずつ列をなしていた。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "彼は大広間のポーチに柱を立てた。",
                "右の柱を立ててそれをヤキンと名付け、",
                "左の柱を立ててそれをボアズと名付けた。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "柱の頂上にはユリのデザインがあった。",
                "それで柱の作業は完了した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "彼はまた鋳造金属の海を作った。縁から縁まで十キュビトで、円形であり、",
                "高さは五キュビトで、三十キュビトの線がその周囲を測った。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "その縁の下にはひょうたんがあり、",
                "一キュビトに十個、海の周りを取り囲んでいた。",
                "ひょうたんは鋳造されたときに二列に鋳造された。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "それは十二の雄牛の上に立っており、",
                "三つは北を向き、三つは西を向き、三つは南を向き、三つは東を向いていた。",
                "海はその上に置かれ、",
                "そのすべての後部は内側を向いていた。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "それは手の幅の厚さがあり、",
                "その縁はカップの縁のように、",
                "ユリの花のように作られていた。",
                "それは二千バスを収容できた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "次に彼は青銅の台を十個作った。",
                "各台の長さは四キュビト、幅は四キュビト、高さは三キュビトであった。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "そして台のデザインはこうであった。",
                "それらには枠があり、枠の間に境界があった。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "そして枠の間の境界には獅子、雄牛、ケルビムがあった。",
                "そして枠の上には台座があり、",
                "獅子と雄牛の下には装飾的な花輪があった。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "今、各台には青銅の車輪が四つあり、青銅の軸があり、",
                "その四つの足には支持があった。",
                "盆の下には鋳造された支持があり、",
                "各側に花輪があった。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "その頂上の冠の内側の開口部は一キュビトで、",
                "開口部は台座のように丸く、一キュビト半の直径があった。",
                "そして開口部にも彫刻があった。",
                "その境界は四角で、丸くはなかった。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "そして四つの車輪は境界の下にあり、",
                "車輪の軸は台の上にあった。",
                "車輪の高さは一キュビト半であった。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "車輪の工芸は戦車の車輪のようであった。",
                "その軸、縁、スポーク、ハブはすべて鋳造されていた。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "今、各台の四つの角には四つの支持があり、",
                "これらの支持は台自体に一体化されていた。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "台の頂上には半キュビトの高さの円形の形があり、",
                "台の頂上にはその支えと境界が一体化されていた。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "彼はその支えの板と境界に彫刻を施し、",
                "ケルビム、獅子、ヤシの木を、",
                "各々の利用可能なスペースに応じて、",
                "周囲に花輪を施した。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "彼はこのようにして十個の台を作った。",
                "それらはすべて均一な鋳造、寸法、形状を持っていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "そして彼は青銅の盆を十個作り、十個の台の各々に一つの盆を作った。",
                "各盆は四十バスを収容し、四キュビトであった。",
                "そして十個の台の各々に一つの盆があった。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "それから彼は台を設置した。",
                "五つは家の右側に、五つは家の左側に。",
                "そして海を家の右側、東側の南に設置した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "さて、ヒラムは盆、シャベル、鉢を作った。",
                "それでヒラムはソロモン王のために主の家で行ったすべての作業を完了した。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "二つの柱と、二つの柱の頂上にある二つの冠の鉢、",
                "そして柱の頂上にある二つの冠の鉢を覆うための二つの格子細工。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "そして二つの格子細工のための四百のザクロ、",
                "各格子細工のための二列のザクロが柱の上の冠の鉢を覆うためにあった。"
            ]
        },
        {
            "verse": 43,
            "text": [
                "さらに十個の台とその十個の盆。"
            ]
        },
        {
            "verse": 44,
            "text": [
                "そして大きな盆、すなわち海とその下の十二の雄牛。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "そして鍋、シャベル、鉢。",
                "ヒラムがソロモン王のために主の家で作ったこれらすべての器具は磨かれた青銅であった。"
            ]
        },
        {
            "verse": 46,
            "text": [
                "ヨルダンの平野で、王はそれらを鋳造した。",
                "スコテとザレタンの間の粘土の土で。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "ソロモンはすべての器具を計量せずに残した。",
                "それらがあまりにも多かったので、",
                "青銅の重さは測定できなかった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 48,
            "text": [
                "ソロモンはまた、主の家にあるすべての家具を作った。",
                "金の祭壇と、供えのパンが置かれた金のテーブル。"
            ]
        },
        {
            "verse": 49,
            "text": [
                "そして燭台、五つは右側に、五つは左側に、内陣の前に、",
                "純金で、",
                "花、ランプ、金のトング。"
            ]
        },
        {
            "verse": 50,
            "text": [
                "そしてカップ、芯切り、鉢、スプーン、火皿、純金で。",
                "内側の家の扉のための蝶番、",
                "すなわち、至聖所のため、そして家の扉、すなわち、廊のため、金で。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "それで、ソロモン王が主の家で行ったすべての作業は完了した。",
                "そしてソロモンは父ダビデが捧げたもの、",
                "銀、金、器具を持ち込み、",
                "それらを主の家の宝物庫に置いた。"
            ]
        }
    ]
}