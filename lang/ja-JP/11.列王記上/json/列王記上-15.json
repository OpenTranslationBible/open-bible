{
    "book": "列王記第一",
    "chapter": 15,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ネバテの子ヤロブアム王の十八年目に、",
                "アビヤムがユダを治め始めた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "彼はエルサレムで三年間治めた。",
                "母はアビシャロムの娘マアカであった。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "彼は、父が先に犯したすべての罪をそのまま行い、",
                "その心は、先祖ダビデの心とは違って、自分の神、",
                "主と全く一つにはなっていなかった。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "しかしダビデのために、彼の神、主はエルサレムに一つのともしびを備え、",
                "彼の後にその子を立てて、エルサレムを堅く立てられた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "ダビデは主の目にかなうことを行い、",
                "ヘテ人ウリヤのことのほかは、生涯、",
                "主が命じられたすべてのことから外れなかったからである。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "レハブアムとヤロブアムの間には彼の生涯を通じて絶え間ない争いがあった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "アビヤムのその他の行いと、彼が成し遂げたすべてのことは、",
                "ユダの王たちの年代記の書に記されているではないか。",
                "アビヤムとヤロブアムの間には戦いがあった。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "アビヤムは先祖たちとともに眠りにつき、",
                "人々は彼をダビデの町に葬った。",
                "彼の子アサが代わって王となった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "ヤロブアムのイスラエル統治の二十年目に、",
                "アサがユダの王となった。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "彼はエルサレムで四十一年間治めた。",
                "母はアビシャロムの娘マアカであった。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "アサは父祖ダビデのように、",
                "主の目にかなうことを行った。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "彼はまた神殿男娼たちを国から追放し、",
                "先祖たちが造ったすべての偶像を取り除いた。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "また彼は、母マアカがアシェラ像として忌まわしい像を造ったので、",
                "彼女を太后の位から退けた。",
                "アサはその忌まわしい像を切り倒し、キデロンの谷で焼いた。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "しかし高き所は取り除かれなかった。",
                "それでも、アサの心は生涯、主と全く一つであった。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼は、",
                "父が聖別した物と自分が聖別した物、すなわち銀、金、",
                "器を主の家に運び入れた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "アサとイスラエルの王バアシャの間には、彼らの治世の間ずっと争いと戦いが絶えなかった。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "イスラエルの王バアシャはユダに攻め上り、",
                "ラマを築いて、",
                "ユダの王アサのもとにだれも出入りできないようにした。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "その時、アサは主の家の財宝と王の家の財宝に残っていたすべての銀と金を取り、",
                "それを彼の家来たちに渡した。",
                "そして王アサはそれをダマスコに住むアラムの王、タブリモンの子、ヘジオンの子、ベン・ハダデに送って言った。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "「私とあなたの間に、",
                "私の父とあなたの父の間にあったような同盟を結びましょう。見よ、",
                "私はあなたに銀と金の贈り物を送りました。どうか行って、",
                "イスラエルの王バアシャとの同盟を破棄し、彼が私から引き揚げるようにしてください。」"
            ]
        },
        {
            "verse": 20,
            "text": [
                "ベン・ハダデはアサ王の願いを聞き入れ、",
                "自分の軍の長たちをイスラエルの町々に送り、イヨン、",
                "ダン、アベル・ベテ・マアカ、キネレテ全域、",
                "それにナフタリの全土を攻め取った。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "バアシャはそれを聞くと、ラマを築くのをやめて、ティルツァにとどまった。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "そこでアサ王はユダ全体に布告を出し、一人も免除されなかった。",
                "人々はバアシャが建築に使っていたラマの石材と木材を運び去り、",
                "アサ王はそれでベニヤミンのゲバとミツパを建てた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "アサのその他のすべての業績、彼のすべての力、彼が行ったすべてのこと、",
                "彼が建てた町々については、",
                "ユダの王たちの年代記の書に記されているではないか。",
                "ただ、彼は年老いてから足の病気を患った。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "アサは先祖たちとともに眠りにつき、父ダビデの町に先祖たちとともに葬られた。",
                "彼の子ヨシャパテが代わって王となった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "ヤロブアムの子ナダブは、ユダの王アサの二年目にイスラエルの王となり、",
                "彼はイスラエルを二年間統治した。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "彼は主の目に悪であることを行い、",
                "父の道に歩み、父がイスラエルに犯させた罪のうちを歩んだ。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "イッサカルの家のアヒヤの子バアシャが彼に謀反を企てた。",
                "ナダブと全イスラエルがギベトンを包囲していたとき、",
                "バアシャはペリシテ人のギベトンで彼を打ち殺した。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "こうしてバアシャは、ユダの王アサの第三年に彼を殺し、",
                "代わって王となった。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "彼は王になるとすぐに、",
                "ヤロブアムの家の者をみな打ち殺した。",
                "ヤロブアムに属する息のある者を一人も残さず、",
                "根絶やしにした。",
                "主がそのしもべシロ人アヒヤを通して語られたことばのとおりであった。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "それは、ヤロブアムが自ら犯し、",
                "またイスラエルに犯させた罪のためであり、",
                "彼がイスラエルの神、主の怒りを引き起こしたためである。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "ナダブのその他の行いと、彼が行ったすべてのことは、",
                "イスラエルの王たちの年代記の書に記されているではないか。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "アサとイスラエルの王バアシャの間には、彼らの治世の間ずっと争いが絶えなかった。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "ユダの王アサの第三年に、",
                "アヒヤの子バアシャがティルツァで全イスラエルの王となり、",
                "二十四年間治めた。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "彼は主の目に悪であることを行い、",
                "ヤロブアムの道に歩み、ヤロブアムがイスラエルに犯させた罪のうちを歩んだ。"
            ]
        }
    ]
}
