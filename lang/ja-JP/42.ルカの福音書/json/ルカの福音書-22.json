{
    "book": "ルカによる福音書",
    "chapter": 22,
    "verses": [
        {
            "verse": 1,
            "text": [
                "さて、過越しと呼ばれる種なしパンの祭りが近づいていた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "祭司長たちと律法学者たちは、イエスを殺す方法を探していた。彼らは民衆を恐れていたからである。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "その時、十二人の一人であるイスカリオテと呼ばれるユダにサタンが入った。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "ユダは行って、祭司長たちや神殿の役人たちと、どのようにしてイエスを裏切るかを相談した。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼らは喜び、彼に金を与えることに同意した。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "彼はそれを受け入れ、群衆のいないところでイエスを引き渡す機会をうかがっていた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "それから、過越しの小羊をほふるべき種なしパンの日が来た。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "イエスはペテロとヨハネを送り、「私たちが食べるために過越しを準備しなさい」と指示された。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "彼らはイエスに尋ねた、「どこで準備をすればよいですか？」"
            ]
        },
        {
            "verse": 10,
            "text": [
                "イエスは答えられた、「町に入ると、水がめを運んでいる男に会う。その男が入る家に従って行きなさい。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "そして、その家の主人に言いなさい、『先生が尋ねています。私が弟子たちと過越しを食べるための客間はどこですか？』"
            ]
        },
        {
            "verse": 12,
            "text": [
                "彼はあなたがたに大きな整った上の部屋を見せる。そこで準備しなさい。」"
            ]
        },
        {
            "verse": 13,
            "text": [
                "彼らは行って、イエスが言われたとおりにすべてを見つけ、過越しを準備した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "時が来たとき、イエスは席に着き、使徒たちも共にいた。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "イエスは彼らに言われた、「私は苦しむ前に、あなたがたとこの過越しを食べることを切に望んでいました。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "私は言いますが、神の国で成就するまで、私はもうこれを食べません。」"
            ]
        },
        {
            "verse": 17,
            "text": [
                "杯を取り、感謝を捧げてから、イエスは言われた、「これを取り、あなたがたの間で分けなさい。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "私は言いますが、神の国が来るまで、私はもうぶどうの実から取ったものを飲みません。」"
            ]
        },
        {
            "verse": 19,
            "text": [
                "イエスはパンを取り、感謝を捧げ、これを裂いて彼らに与え、言われた、「これはあなたがたのために与えられる私の体です。私を記念してこれを行いなさい。」"
            ]
        },
        {
            "verse": 20,
            "text": [
                "同じように、食事の後、杯を取り、言われた、「この杯は、あなたがたのために流される私の血による新しい契約です。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "しかし見なさい、私を裏切る者の手が私と共に食卓にあります。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "人の子は定められたとおりに行きますが、彼を裏切るその人には災いがあります！」"
            ]
        },
        {
            "verse": 23,
            "text": [
                "彼らは自分たちの中で誰がこれを行うのかを互いに問い始めた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "また、彼らの間で誰が最も偉いかについての議論が起こった。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "イエスは彼らに言われた、「異邦人の王たちは彼らに対して主権を行使し、彼らの上に権威を持つ者たちは恩人と呼ばれます。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "しかし、あなたがたはそうであってはなりません。むしろ、あなたがたの中で最も偉い者は最も若い者のようであり、指導者は仕える者のようであるべきです。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "食卓に着く者と仕える者のうち、どちらが偉いですか？食卓に着く者ではありませんか？しかし、私はあなたがたの間で仕える者としています。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "あなたがたは私の試練の中で私と共に留まった者たちです。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "そして、私の父が私に王国を与えられたように、私はあなたがたに王国を与えます。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "それは、あなたがたが私の王国で私の食卓に着き、イスラエルの十二部族を治める座に着くためです。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "「シモン、シモン、見なさい、サタンがあなたがたを小麦のようにふるいにかけることを求めました。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "しかし、私はあなたの信仰が失われないように祈りました。そして、あなたが立ち直ったときに、兄弟たちを強めなさい。」"
            ]
        },
        {
            "verse": 33,
            "text": [
                "しかし彼は答えた、「主よ、私はあなたと共に牢獄にも死にも行く準備ができています。」"
            ]
        },
        {
            "verse": 34,
            "text": [
                "イエスは言われた、「ペテロ、私はあなたに言いますが、今日、鶏が鳴く前に、あなたは三度私を知らないと言うでしょう。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "それからイエスは彼らに尋ねられた、「財布も袋も履物も持たずにあなたがたを送ったとき、何か欠けたものがありましたか？」彼らは答えた、「何もありませんでした。」"
            ]
        },
        {
            "verse": 36,
            "text": [
                "イエスは言われた、「しかし今、財布がある者はそれを持ち、袋も持ちなさい。そして、剣がない者は、外套を売ってそれを買いなさい。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "私はあなたがたに言いますが、『彼は罪人たちと共に数えられた』というこの聖書の言葉は私において成就しなければなりません。私について書かれていることは成就に向かっています。」"
            ]
        },
        {
            "verse": 38,
            "text": [
                "弟子たちは言った、「主よ、ここに二つの剣があります。」イエスは答えられた、「それで十分です！」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "イエスはいつものようにオリーブ山に出かけ、弟子たちも従った。"
            ]
        },
        {
            "verse": 40,
            "text": [
                "その場所に着くと、イエスは彼らに言われた、「誘惑に陥らないように祈りなさい。」"
            ]
        },
        {
            "verse": 41,
            "text": [
                "イエスは彼らから少し離れたところに行き、ひざまずいて祈られた、"
            ]
        },
        {
            "verse": 42,
            "text": [
                "「父よ、もしあなたの御心なら、この杯を私から取り去ってください。しかし、私の意志ではなく、あなたの御意志が成されますように。」"
            ]
        },
        {
            "verse": 43,
            "text": [
                "[天の使いがイエスを訪れ、力を与えた。]"
            ]
        },
        {
            "verse": 44,
            "text": [
                "イエスは苦しみの中で、さらに熱心に祈られ、その汗は血の滴のように地に落ちた。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "祈りから立ち上がって弟子たちのところに戻ると、彼らが悲しみに打ちひしがれて眠っているのを見つけた。"
            ]
        },
        {
            "verse": 46,
            "text": [
                "「なぜ眠っているのですか？」イエスは彼らに言われた。「起きて、誘惑に陥らないように祈りなさい。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "イエスがまだ話しておられるときに、群衆がやって来て、十二人の一人であるユダという男が彼らを率いていた。彼はイエスに接吻しようと近づいた。"
            ]
        },
        {
            "verse": 48,
            "text": [
                "しかしイエスは彼に尋ねられた、「ユダ、あなたは接吻で人の子を裏切るのですか？」"
            ]
        },
        {
            "verse": 49,
            "text": [
                "周りにいた者たちは何が起こるかを見て、「主よ、私たちは剣で打つべきですか？」と言った。"
            ]
        },
        {
            "verse": 50,
            "text": [
                "そして、彼らの一人が大祭司のしもべを打ち、その右耳を切り落とした。"
            ]
        },
        {
            "verse": 51,
            "text": [
                "しかしイエスは答えられた、「これ以上はやめなさい！」そしてその男の耳に触れて彼を癒された。"
            ]
        },
        {
            "verse": 52,
            "text": [
                "それからイエスは、祭司長たち、神殿の役人たち、そして自分を捕らえに来た長老たちに言われた、「私が反乱を起こしているかのように、剣や棒を持って来たのですか？"
            ]
        },
        {
            "verse": 53,
            "text": [
                "毎日私は神殿の庭であなたがたと共にいましたが、あなたがたは私に手をかけませんでした。しかし、これはあなたがたの時です――闇がその力を持つ時です。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 54,
            "text": [
                "それから彼らはイエスを捕らえ、連れ去り、大祭司の家に連れて行った。ペテロは遠くから従った。"
            ]
        },
        {
            "verse": 55,
            "text": [
                "中庭の真ん中で火が焚かれ、彼らが一緒に座ったとき、ペテロも彼らの中に座った。"
            ]
        },
        {
            "verse": 56,
            "text": [
                "しもべの女が火の光の中で彼を見て、じっと見つめて、「この人もイエスと一緒にいました」と叫んだ。"
            ]
        },
        {
            "verse": 57,
            "text": [
                "しかし彼は答えた、「女よ、私は彼を知らない。」"
            ]
        },
        {
            "verse": 58,
            "text": [
                "少し後に、他の誰かが彼を見て言った、「あなたも彼らの一人です。」ペテロは答えた、「違います！」"
            ]
        },
        {
            "verse": 59,
            "text": [
                "約一時間後、別の者が主張した、「確かにこの人もイエスと一緒にいました。彼はガリラヤ人ですから。」"
            ]
        },
        {
            "verse": 60,
            "text": [
                "ペテロは答えた、「私はあなたが何を言っているのか分かりません！」彼がまだ話していると、すぐに鶏が鳴いた。"
            ]
        },
        {
            "verse": 61,
            "text": [
                "主は振り向いてペテロを見つめられた。するとペテロは、主が彼に言われた言葉を思い出した、「今日、鶏が鳴く前に、あなたは三度私を知らないと言うでしょう。」"
            ]
        },
        {
            "verse": 62,
            "text": [
                "そして彼は外に出て、激しく泣いた。"
            ]
        },
        {
            "verse": 63,
            "text": [
                "イエスを見張っていた者たちは、イエスをあざけり、打ち始めた。"
            ]
        },
        {
            "verse": 64,
            "text": [
                "彼らはイエスの目を覆い、「予言しろ！誰があなたを打ったのか？」と要求した。"
            ]
        },
        {
            "verse": 65,
            "text": [
                "そして、彼に対して多くの他の侮辱的な言葉を投げかけた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 66,
            "text": [
                "夜が明けると、民の長老たちの会議、祭司長たちと律法学者たちが集まり、イエスは彼らの前に連れて行かれた。"
            ]
        },
        {
            "verse": 67,
            "text": [
                "「もしあなたがメシアなら、私たちに言いなさい。」イエスは答えられた、「もし私が言っても、あなたがたは信じないでしょう。"
            ]
        },
        {
            "verse": 68,
            "text": [
                "そして、私が何かを尋ねても、あなたがたは答えないでしょう。"
            ]
        },
        {
            "verse": 69,
            "text": [
                "しかし、今から後、人の子は神の力の右に座るでしょう。」"
            ]
        },
        {
            "verse": 70,
            "text": [
                "彼らは皆言った、「それでは、あなたは神の子ですか？」イエスは答えられた、「あなたがたがそう言っています。」"
            ]
        },
        {
            "verse": 71,
            "text": [
                "すると彼らは言った、「なぜさらに証言が必要ですか？私たちは彼自身の口から聞きました。」"
            ]
        }
    ]
}