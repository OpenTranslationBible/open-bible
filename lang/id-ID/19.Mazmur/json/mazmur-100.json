{
    "book": "Mazmur",
    "chapter": 100,
    "verses": [
        {
            "text": [
                "Mazmur untuk pengucapan syukur."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> Bersorak-sorailah bagi Tuhan, hai seluruh bumi."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Layani Tuhan dengan sukacita;",
                "> Datanglah ke hadapan-Nya dengan nyanyian gembira."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> Ketahuilah bahwa Tuhan adalah Tuhan;",
                "> Dialah Pencipta kita, dan bukan kita yang menciptakan diri kita sendiri;",
                "> Kita adalah milik-Nya, kawanan domba di bawah pemeliharaan-Nya."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Masuklah melalui gerbang-Nya dengan rasa syukur,",
                "> Dan pelataran-Nya dengan pujian.",
                "> Bersyukurlah kepada-Nya, muliakan nama-Nya."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> Sebab Tuhan itu baik;",
                "> Kasih setia-Nya kekal selamanya,",
                "> Dan kesetiaan-Nya berlanjut dari generasi ke generasi."
            ]
        }
    ]
}