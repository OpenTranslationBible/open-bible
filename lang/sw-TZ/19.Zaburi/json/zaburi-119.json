{
    "book": "Zaburi",
    "chapter": 119,
    "verses": [
        {
            "text": [
                "א Aleph"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> Heri walio kamili njia,",
                "> Wao wanaofuata sheria za Bwana."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Heri wanaoshika ushuhuda wake,",
                "> Na kumtafuta kwa moyo wote."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> Wao pia hawatendi uovu;",
                "> Wanatembea katika njia zake."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Umeamuru mausia yako,",
                "> Ili tuyashike kwa bidii."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> Laiti njia zangu zingekuwa imara",
                "> Katika kushika amri zako!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> Ndipo sitatahayarika",
                "> Ninapozingatia amri zako zote."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> Nitakushukuru kwa unyoofu wa moyo,",
                "> Ninapojifunza hukumu zako za haki."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> Nitashika amri zako;",
                "> Usiniache kabisa!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ב Beth"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> Kijana anawezaje kuitunza njia yake kuwa safi?",
                "> Kwa kuitunza sawasawa na neno lako."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> Kwa moyo wangu wote nimekutafuta;",
                "> Usiniruhusu nikae mbali na amri zako."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> Nimeweka neno lako moyoni mwangu,",
                "> Ili nisikutende dhambi."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> Umebarikiwa, Bwana;",
                "> Nifundishe amri zako."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> Kwa midomo yangu nimetangaza",
                "> Hukumu zote za kinywa chako."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> Nimepata furaha katika njia ya ushuhuda wako,",
                "> Kama vile katika mali zote."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> Nitatafakari mausia yako",
                "> Na kuzingatia njia zako."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> Nitafurahia amri zako;",
                "> Sitaisahau neno lako."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ג Gimel"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> Nitendee kwa ukarimu mtumishi wako,",
                "> Ili nipate kuishi na kushika neno lako."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> Fungua macho yangu, ili nipate kuona",
                "> Mambo ya ajabu kutoka katika sheria yako."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> Mimi ni mgeni duniani;",
                "> Usinifiche amri zako."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> Nafsi yangu imezidiwa na shauku",
                "> Kwa hukumu zako wakati wote."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> Unawakemea wenye kiburi, walio laaniwa,",
                "> Wanaoacha amri zako."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> Niondolee aibu na dharau,",
                "> Kwa kuwa nashika ushuhuda wako."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> Hata wakuu wanaketi na kunizungumzia,",
                "> Mtumishi wako anatafakari amri zako."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> Ushuhuda wako pia ni furaha yangu;",
                "> Wao ni washauri wangu."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ד Daleth"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> Nafsi yangu inashikamana na mavumbi;",
                "> Unihuisha sawasawa na neno lako."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> Nimeeleza njia zangu, nawe umenijibu;",
                "> Nifundishe amri zako."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> Nisaidie kuelewa njia ya mausia yako,",
                "> Ili niyatafakari maajabu yako."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> Nafsi yangu inalia kwa huzuni;",
                "> Unitie nguvu sawasawa na neno lako."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> Niondolee njia ya udanganyifu,",
                "> Na unipe kwa neema sheria yako."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> Nimechagua njia ya uaminifu;",
                "> Nimeweka hukumu zako mbele yangu."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> Nimeshikamana na ushuhuda wako;",
                "> Bwana, usiniache nikae katika aibu!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> Nitakimbia njia ya amri zako,",
                "> Kwa kuwa utanipanua moyo wangu."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ה He"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> Nifundishe, njia ya amri zako, Bwana,",
                "> Nami nitaitunza hadi mwisho."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> Nipe ufahamu, ili niweze kushika sheria yako",
                "> Na kuitunza kwa moyo wangu wote."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> Niongoze katika njia ya amri zako,",
                "> Kwa kuwa ninaifurahia."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> Uuelekeze moyo wangu kwenye ushuhuda wako,",
                "> Na si kwenye faida isiyo ya haki."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> Geuza macho yangu yasitazame mambo yasiyo na maana,",
                "> Na unihuisha katika njia zako."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> Thibitisha neno lako kwa mtumishi wako,",
                "> Kama lile linaloleta heshima kwako."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> Niondolee aibu ninayoogopa,",
                "> Kwa kuwa hukumu zako ni nzuri."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> Tazama, ninatamani mausia yako;",
                "> Unihuisha kwa haki yako."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ו Waw"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> Neema yako na ije kwangu, Bwana,",
                "> Wokovu wako sawasawa na neno lako;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> Ili nipate jibu kwa anaye nidharau,",
                "> Kwa kuwa ninalitumainia neno lako."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> Wala usiondoe neno la kweli kabisa kutoka kinywani mwangu,",
                "> Kwa kuwa ninangojea hukumu zako."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> Hivyo nitashika sheria yako daima,",
                "> Milele na milele."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> Nami nitakwenda kwa uhuru,",
                "> Kwa kuwa ninatafuta mausia yako."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> Nitatangaza ushuhuda wako mbele ya wafalme,",
                "> Wala sitatahayarika."
            ]
        },
        {
            "verse": 47,
            "text": [
                "> Nitaifurahia amri zako,",
                "> Ambazo ninazipenda."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> Nami nitainua mikono yangu kwa amri zako, ambazo ninazipenda;",
                "> Nami nitatafakari amri zako."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ז Zayin"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> Kumbuka neno lako kwa mtumishi wako,",
                "> Ambalo umenitia matumaini."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> Hii ni faraja yangu katika mateso yangu,",
                "> Kwamba neno lako limenihuisha."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> Wenye kiburi wananidharau kabisa,",
                "> Lakini siiachi sheria yako."
            ]
        },
        {
            "verse": 52,
            "text": [
                "> Nimekumbuka hukumu zako za zamani, Bwana,",
                "> Nami nimepata faraja."
            ]
        },
        {
            "verse": 53,
            "text": [
                "> Hasira kali imenishika kwa sababu ya waovu,",
                "> Wanaoacha sheria yako."
            ]
        },
        {
            "verse": 54,
            "text": [
                "> Amri zako zimekuwa nyimbo zangu",
                "> Katika nyumba ya safari yangu."
            ]
        },
        {
            "verse": 55,
            "text": [
                "> Bwana, nakumbuka jina lako usiku,",
                "> Nami ninashika sheria yako."
            ]
        },
        {
            "verse": 56,
            "text": [
                "> Hii imekuwa yangu,",
                "> Kwamba ninashika mausia yako."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ח Heth"
            ]
        },
        {
            "verse": 57,
            "text": [
                "> Bwana ni fungu langu;",
                "> Nimeahidi kushika maneno yako."
            ]
        },
        {
            "verse": 58,
            "text": [
                "> Nimeutafuta uso wako kwa moyo wangu wote;",
                "> Unifadhili sawasawa na neno lako."
            ]
        },
        {
            "verse": 59,
            "text": [
                "> Nimeyatafakari njia zangu",
                "> Na kugeuza hatua zangu kwa ushuhuda wako."
            ]
        },
        {
            "verse": 60,
            "text": [
                "> Nimeharakisha na sikukawia",
                "> Kufuatilia amri zako."
            ]
        },
        {
            "verse": 61,
            "text": [
                "> Mitego ya waovu imenizunguka,",
                "> Lakini sikuisahau sheria yako."
            ]
        },
        {
            "verse": 62,
            "text": [
                "> Ninasimama usiku wa manane kukushukuru",
                "> Kwa sababu ya hukumu zako za haki."
            ]
        },
        {
            "verse": 63,
            "text": [
                "> Mimi ni rafiki wa wote wanaokuogopa,",
                "> Na wa wale wanaoshika mausia yako."
            ]
        },
        {
            "verse": 64,
            "text": [
                "> Dunia imejaa rehema zako, Bwana;",
                "> Nifundishe amri zako."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ט Teth"
            ]
        },
        {
            "verse": 65,
            "text": [
                "> Umetenda mema kwa mtumishi wako, Bwana,",
                "> Sawa na neno lako."
            ]
        },
        {
            "verse": 66,
            "text": [
                "> Nifundishe busara nzuri na maarifa,",
                "> Kwa kuwa ninatumainia amri zako."
            ]
        },
        {
            "verse": 67,
            "text": [
                "> Kabla sijapatwa na mateso, nilipotea,",
                "> Lakini sasa ninashika neno lako daima."
            ]
        },
        {
            "verse": 68,
            "text": [
                "> Wewe ni mwema na unafanya yaliyo sawa;",
                "> Nifundishe amri zako."
            ]
        },
        {
            "verse": 69,
            "text": [
                "> Wenye kiburi wameunda uongo dhidi yangu;",
                "> Kwa moyo wangu wote nitashika mausia yako."
            ]
        },
        {
            "verse": 70,
            "text": [
                "> Moyo wao ni mgumu, kama mafuta yaliyoganda,",
                "> Lakini ninaifurahia sheria yako."
            ]
        },
        {
            "verse": 71,
            "text": [
                "> Ni faida kwangu kwamba nilipata mateso,",
                "> Ili nijifunze amri zako."
            ]
        },
        {
            "verse": 72,
            "text": [
                "> Sheria ya kinywa chako ni ya thamani zaidi kwangu",
                "> Kuliko maelfu ya vipande vya dhahabu na fedha."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "י Yodh"
            ]
        },
        {
            "verse": 73,
            "text": [
                "> Mikono yako iliniumba na kunifinyanga;",
                "> Nipe ufahamu, ili nijifunze amri zako."
            ]
        },
        {
            "verse": 74,
            "text": [
                "> Wale wanaokuogopa na wanione na wafurahi,",
                "> Kwa kuwa ninatumaini katika neno lako."
            ]
        },
        {
            "verse": 75,
            "text": [
                "> Najua, Bwana, kwamba hukumu zako ni za haki,",
                "> Na kwamba umeniruhusu kukabili majaribu kwa uaminifu."
            ]
        },
        {
            "verse": 76,
            "text": [
                "> Neema yako na inifariji,",
                "> Sawa na neno lako kwa mtumishi wako."
            ]
        },
        {
            "verse": 77,
            "text": [
                "> Huruma zako na zije kwangu, zinipatie uhai,",
                "> Kwa kuwa sheria yako ni furaha yangu."
            ]
        },
        {
            "verse": 78,
            "text": [
                "> Wenye kiburi na waone aibu, kwa kuwa wananikosea kwa uongo;",
                "> Lakini nitatafakari mausia yako."
            ]
        },
        {
            "verse": 79,
            "text": [
                "> Wale wanaokuogopa na wanigeukie,",
                "> Na wale wanaojua ushuhuda wako."
            ]
        },
        {
            "verse": 80,
            "text": [
                "> Moyo wangu na uwe imara katika amri zako,",
                "> Ili nisije nikatahayarika."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "כ Kaph"
            ]
        },
        {
            "verse": 81,
            "text": [
                "> Nafsi yangu inazimia kwa wokovu wako;",
                "> Ninangojea neno lako."
            ]
        },
        {
            "verse": 82,
            "text": [
                "> Macho yangu yanachoka kwa kutamani neno lako,",
                "> Wakati nasema, “Utanifariji lini?”"
            ]
        },
        {
            "verse": 83,
            "text": [
                "> Ingawa nimekuwa kama kiriba kilichokauka katika moshi,",
                "> Siisahau amri zako."
            ]
        },
        {
            "verse": 84,
            "text": [
                "> Kipimo cha siku zangu ni kipi, mtumishi wako?",
                "> Utaleta lini haki kwa wanaonifuatilia?"
            ]
        },
        {
            "verse": 85,
            "text": [
                "> Wenye kiburi wamenichimbia mashimo,",
                "> Watu ambao hawako sawa na sheria yako."
            ]
        },
        {
            "verse": 86,
            "text": [
                "> Amri zako zote ni za uaminifu;",
                "> Wamenitesa kwa uongo; nisaidie!"
            ]
        },
        {
            "verse": 87,
            "text": [
                "> Walikaribia kuniharibu duniani,",
                "> Lakini sikuyaacha mausia yako."
            ]
        },
        {
            "verse": 88,
            "text": [
                "> Unihuisha sawasawa na rehema zako,",
                "> Ili nipate kushika ushuhuda wa kinywa chako."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ל Lamedh"
            ]
        },
        {
            "verse": 89,
            "text": [
                "> Milele, Bwana,",
                "> Neno lako limesimama mbinguni."
            ]
        },
        {
            "verse": 90,
            "text": [
                "> Uaminifu wako unaendelea katika vizazi vyote;",
                "> Uliiimarisha dunia, nayo inasimama."
            ]
        },
        {
            "verse": 91,
            "text": [
                "> Zinasimama siku hii kwa hukumu zako,",
                "> Kwa kuwa vitu vyote vinakutumikia."
            ]
        },
        {
            "verse": 92,
            "text": [
                "> Kama sheria yako isingekuwa furaha yangu,",
                "> Ningekuwa nimeangamia kwa mateso yangu."
            ]
        },
        {
            "verse": 93,
            "text": [
                "> Sitaisahau kamwe mausia yako,",
                "> Kwa kuwa kwa hayo umenihuisha."
            ]
        },
        {
            "verse": 94,
            "text": [
                "> Mimi ni wako; niokoe,",
                "> Kwa kuwa nimetafuta mausia yako."
            ]
        },
        {
            "verse": 95,
            "text": [
                "> Waovu wananilalia kungojea kuniangamiza;",
                "> Nitazingatia ushuhuda wako kwa bidii."
            ]
        },
        {
            "verse": 96,
            "text": [
                "> Nimeona mwisho wa ukamilifu wote;",
                "> Amri yako ni pana sana."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מ Mem"
            ]
        },
        {
            "verse": 97,
            "text": [
                "> Jinsi ninavyopenda sheria yako!",
                "> Ni tafakari yangu mchana kutwa."
            ]
        },
        {
            "verse": 98,
            "text": [
                "> Amri zako zinanifanya niwe na hekima kuliko adui zangu,",
                "> Kwa kuwa ziko nami daima."
            ]
        },
        {
            "verse": 99,
            "text": [
                "> Nina ufahamu zaidi kuliko walimu wangu wote,",
                "> Kwa kuwa ushuhuda wako ni tafakari yangu."
            ]
        },
        {
            "verse": 100,
            "text": [
                "> Ninaelewa zaidi kuliko wazee,",
                "> Kwa kuwa nimezingatia mausia yako."
            ]
        },
        {
            "verse": 101,
            "text": [
                "> Nimezuia miguu yangu kutoka njia mbaya yoyote,",
                "> Ili nipate kushika neno lako."
            ]
        },
        {
            "verse": 102,
            "text": [
                "> Sijageuka kutoka hukumu zako,",
                "> Kwa kuwa umenifundisha."
            ]
        },
        {
            "verse": 103,
            "text": [
                "> Jinsi maneno yako yalivyo matamu kwa kinywa changu!",
                "> Naam, matamu kuliko asali kinywani mwangu!"
            ]
        },
        {
            "verse": 104,
            "text": [
                "> Kutoka kwa mausia yako napata ufahamu;",
                "> Kwa hiyo nachukia kila njia ya uongo."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "נ Nun"
            ]
        },
        {
            "verse": 105,
            "text": [
                "> Neno lako ni taa kwa miguu yangu",
                "> Na mwanga kwenye njia yangu."
            ]
        },
        {
            "verse": 106,
            "text": [
                "> Nimeapa na nitaitekeleza,",
                "> Kwamba nitashika hukumu zako za haki."
            ]
        },
        {
            "verse": 107,
            "text": [
                "> Nimepatwa na mateso makubwa;",
                "> Unihuisha, Bwana, sawasawa na neno lako."
            ]
        },
        {
            "verse": 108,
            "text": [
                "> Tafadhali pokea sadaka za hiari za kinywa changu, Bwana,",
                "> Na unifundishe hukumu zako."
            ]
        },
        {
            "verse": 109,
            "text": [
                "> Uhai wangu uko daima mikononi mwangu,",
                "> Lakini siiachi sheria yako."
            ]
        },
        {
            "verse": 110,
            "text": [
                "> Waovu wamenitegea mtego,",
                "> Lakini sijaacha mausia yako."
            ]
        },
        {
            "verse": 111,
            "text": [
                "> Nimepokea ushuhuda wako kama urithi wa milele,",
                "> Kwa kuwa ni furaha ya moyo wangu."
            ]
        },
        {
            "verse": 112,
            "text": [
                "> Nimeweka moyo wangu kutekeleza amri zako",
                "> Milele, hata mwisho."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ס Samekh"
            ]
        },
        {
            "verse": 113,
            "text": [
                "> Nawachukia wenye mawazo mawili,",
                "> Lakini napenda sheria yako."
            ]
        },
        {
            "verse": 114,
            "text": [
                "> Wewe ni kimbilio langu na ngao yangu;",
                "> Ninalitumainia neno lako."
            ]
        },
        {
            "verse": 115,
            "text": [
                "> Ondokeni kwangu, enyi watenda maovu,",
                "> Ili nipate kushika amri za Mungu wangu."
            ]
        },
        {
