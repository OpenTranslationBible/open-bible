{
    "book": "Zaburi",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Msifuni Bwana, enyi mataifa yote;",
                "> Msifuni jina lake, enyi watu wote!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Kwa maana fadhili zake kwetu ni kuu,",
                "> Na uaminifu wa Bwana unadumu milele.",
                "---",
                "> Msifuni Bwana!"
            ]
        }
    ]
}