{
    "book": "Salmernes Bog",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Lov Herren, alle folkeslag;",
                "> Pris Hans navn, alle folk!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> For Hans godhed mod os er stor,",
                "> Og Herrens trofasthed varer evigt.",
                "---",
                "> Lov Herren!"
            ]
        }
    ]
}