{
    "book": "Zephanja",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Versammelt euch, ja, kommt zusammen,",
                "> Ihr schamloses Volk,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Ehe der Beschluss erfüllt wird—",
                "> Der Tag vergeht wie Spreu—",
                "> Ehe der grimmige Zorn des Herrn über euch kommt,",
                "> Ehe der Tag des Zorns des Herrn über euch kommt."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> Sucht den Herrn,",
                "> Alle ihr Demütigen der Erde,",
                "> Die seine Gebote gehalten haben;",
                "> Sucht Gerechtigkeit, sucht Demut.",
                "> Vielleicht werdet ihr verborgen bleiben",
                "> Am Tag des Zorns des Herrn."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Denn Gaza wird verlassen sein,",
                "> Und Aschkelon wird zur Wüste werden;",
                "> Aschdod wird am Mittag vertrieben,",
                "> Und Ekron wird entwurzelt."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> Wehe den Bewohnern der Küste,",
                "> Dem Volk der Kreter!",
                "> Das Wort des Herrn ist gegen euch,",
                "> Kanaan, Land der Philister;",
                "> Und ich werde euch vernichten,",
                "> So dass kein Bewohner bleibt."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> So wird die Küste zu Weideland,",
                "> Mit Weiden für Hirten und Gehegen für Herden."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> Und die Küste wird sein",
                "> Für den Überrest des Hauses Juda,",
                "> Sie werden dort Herden weiden;",
                "> In den Häusern von Aschkelon werden sie am Abend lagern,",
                "> Denn der Herr, ihr Gott, wird sich um sie kümmern",
                "> Und ihr Geschick wenden."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> „Ich habe die Schmähungen Moabs gehört",
                "> Und die höhnischen Worte der Söhne Ammons,",
                "> Mit denen sie mein Volk verhöhnt",
                "> Und gegen ihr Gebiet geprahlt haben."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> Darum, so wahr ich lebe,“ spricht der Herr der Heerscharen,",
                "> Der Gott Israels,",
                "> „Moab wird gewiss wie Sodom sein,",
                "> Und die Söhne Ammons wie Gomorra—",
                "> Ein Ort, der von Unkraut und Salzgruben eingenommen wird,",
                "> Und eine ewige Wüste.",
                "> Der Überrest meines Volkes wird sie plündern,",
                "> Und der Rest meiner Nation wird sie erben.“"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> Dies werden sie haben als Lohn für ihren Hochmut,",
                "> Weil sie das Volk des Herrn der Heerscharen verhöhnt und geprahlt haben."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> Der Herr wird ihnen furchtbar sein,",
                "> Denn er wird alle Götter der Erde vernichten;",
                "> Und alle Küstenländer der Nationen werden sich vor ihm beugen,",
                "> Jeder von seinem Ort aus."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> „Auch ihr, Kuschiten,",
                "> Werdet durch mein Schwert erschlagen.“"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> Und er wird seine Hand gegen den Norden ausstrecken",
                "> Und Assyrien stürzen,",
                "> Und er wird Ninive zur Wüste machen,",
                "> Dürre wie die Wüste."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> Herden werden mitten in ihr lagern,",
                "> Alle Tiere, die in Herden umherziehen;",
                "> Sowohl der Pelikan als auch der Igel",
                "> Werden auf den Spitzen ihrer Säulen übernachten;",
                "> Vögel werden im Fenster singen,",
                "> Verwüstung wird an der Schwelle sein;",
                "> Denn er hat das Zedernwerk entblößt."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> Das ist die vermessene Stadt,",
                "> Die sicher wohnt,",
                "> Die in ihrem Herzen sagt,",
                "> „Ich bin, und es gibt keinen außer mir.“",
                "> Wie ist sie zur Wüste geworden,",
                "> Ein Ruheplatz für Tiere!",
                "> Jeder, der an ihr vorbeigeht, wird pfeifen",
                "> Und seine Hand verächtlich schwenken."
            ]
        }
    ]
}