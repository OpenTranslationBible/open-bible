{
    "book": "列王纪上",
    "chapter": 4,
    "verses": [
        {
            "verse": 1,
            "text": [
                "所罗门王治理以色列全地。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "他的官员如下：",
                "撒督的儿子亚撒利雅作祭司；"
            ]
        },
        {
            "verse": 3,
            "text": [
                "示沙的儿子以利何烈和亚希亚作书记；",
                "亚希律的儿子约沙法作史官；"
            ]
        },
        {
            "verse": 4,
            "text": [
                "耶何耶大的儿子比拿雅作军队的统帅；",
                "撒督和亚比亚他作祭司；"
            ]
        },
        {
            "verse": 5,
            "text": [
                "拿单的儿子亚撒利雅作众吏长；",
                "拿单的儿子撒布得作祭司，并作王的朋友；"
            ]
        },
        {
            "verse": 6,
            "text": [
                "亚希煞管理王宫；",
                "亚比大的儿子亚多尼兰掌管服苦役的人。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "所罗门在以色列全地设立了十二个官吏，",
                "他们为王和王家供给食物；",
                "每年各人供给一个月。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "他们的名字如下：以法莲山地的便户珥；"
            ]
        },
        {
            "verse": 9,
            "text": [
                "在玛迦斯、沙宾、伯示麦、以伦伯哈南的便底甲；"
            ]
        },
        {
            "verse": 10,
            "text": [
                "在亚鲁波的便希悉（他管理梭哥和希弗全地）；"
            ]
        },
        {
            "verse": 11,
            "text": [
                "在多珥山冈的便亚比拿达（他娶了所罗门的女儿他法为妻）；"
            ]
        },
        {
            "verse": 12,
            "text": [
                "在他纳和米吉多，并靠近撒拉但、耶斯列下边的伯善，从伯善到亚伯米何拉直到约念之外的巴拿的儿子亚希律；"
            ]
        },
        {
            "verse": 13,
            "text": [
                "在基列的拉末的便基别（玛拿西的儿子睚珥的城邑在基列地属他；还有巴珊的亚珥歌伯地的六十座大城，城墙和铜闩）；"
            ]
        },
        {
            "verse": 14,
            "text": [
                "在玛哈念的易多的儿子亚希拿达；"
            ]
        },
        {
            "verse": 15,
            "text": [
                "在拿弗他利的亚希玛斯（他也娶了所罗门的女儿巴实抹为妻）；"
            ]
        },
        {
            "verse": 16,
            "text": [
                "在亚设和亚禄的户筛的儿子巴拿；"
            ]
        },
        {
            "verse": 17,
            "text": [
                "在以萨迦的巴路亚的儿子约沙法；"
            ]
        },
        {
            "verse": 18,
            "text": [
                "在便雅悯的以拉的儿子示每；"
            ]
        },
        {
            "verse": 19,
            "text": [
                "在基列地的乌利的儿子基别，",
                "就是亚摩利王西宏和巴珊王噩之地；",
                "还有一个官吏在那地。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "犹大人和以色列人如同海边的沙那样多；",
                "他们吃喝快乐。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "所罗门统治所有的国，",
                "从大河到非利士地直到埃及的边界；",
                "他们都进贡服事所罗门一生的日子。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "所罗门每日所需的食物是细面三十歌珥，",
                "粗面六十歌珥，"
            ]
        },
        {
            "verse": 23,
            "text": [
                "肥牛十只，草场的牛二十只，",
                "羊一百只，还有鹿、羚羊、狍子，并肥禽。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "因为他统治大河西边的全地，",
                "从提弗萨直到迦萨，所有大河西边的王；",
                "他四围尽都平安。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "所罗门在世的日子，犹大人和以色列人都安居乐业，各人坐在自己的葡萄树下和无花果树下，",
                "从但到别是巴。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "所罗门有套车的马四万，",
                "马兵一万二千。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "那些官吏各按各月供给所罗门王，并一切与他同席之人的食物，",
                "不使有所缺乏。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "他们各按各职将大麦和草送到马和驽马之处。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "神赐给所罗门极大的智慧和聪明，",
                "以及广大的心，如同海边的沙。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "所罗门的智慧超过东方人和埃及人的一切智慧。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "他的智慧胜过万人，",
                "胜过以斯拉人以探，并玛曷的儿子希幔、甲各、达大的智慧；",
                "他的名声传扬在四围的列国。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "他作箴言三千句，",
                "诗歌一千零五首。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "他讲论草木，自黎巴嫩的香柏树直到墙上长的牛膝草；",
                "又讲论飞禽走兽、昆虫水族。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "天下列王听见所罗门的智慧，就都差人来听他的智慧话。"
            ]
        }
    ]
}