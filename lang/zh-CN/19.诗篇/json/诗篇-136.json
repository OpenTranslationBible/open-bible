{
    "book": "诗篇",
    "chapter": 136,
    "verses": [
        {
            "verse": 1,
            "text": [
                "要称谢耶和华，因他本为善，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "要称谢万神之神，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "要称谢万主之主，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "称谢那独行大奇事的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "称谢那用智慧造天的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "称谢那铺地在水以上的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "称谢那造大光的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "日头管白昼，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "月亮星宿管黑夜，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "称谢那击杀埃及人之长子的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "领以色列人从他们中间出来的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "用大能的手和伸出来的膀臂，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "称谢那分裂红海的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "领以色列从其中经过的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "却把法老和他的军兵推翻在红海里的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "称谢那引导自己的民行走旷野的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "称谢那击杀大君王的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "杀戮有名的王的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "就是亚摩利王西宏，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "和巴珊王噩，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "将他们的地赐给他的百姓为业的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "就是赐他的仆人以色列为业的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "他顾念我们在卑微的地步，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "救拔我们脱离敌人，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "赐粮食给凡有血气的，",
                "> 他的慈爱永远长存。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "要称谢天上的神，",
                "> 他的慈爱永远长存。"
            ]
        }
    ]
}