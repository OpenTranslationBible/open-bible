{
    "book": "历代志上",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "亚当、塞特、以挪士，"
            ]
        },
        {
            "verse": 2,
            "text": [
                "该南、玛勒列、雅列，"
            ]
        },
        {
            "verse": 3,
            "text": [
                "以诺、玛土撒拉、拉麦，"
            ]
        },
        {
            "verse": 4,
            "text": [
                "挪亚，以及他的儿子：",
                "> 闪、含、雅弗。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "雅弗的儿子有：",
                "> 歌篾、玛各、玛代、雅完、土巴、米设、提拉。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "歌篾的儿子是：",
                "> 亚实基拿、低法、陀迦玛。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "雅完的子孙有：",
                "> 以利沙、他施、基提、罗单。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "含的儿子有：",
                "> 古实、麦西、弗、迦南。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "古实的儿子是：",
                "> 西巴、哈腓拉、撒弗他、拉玛、撒弗提迦。",
                "> 拉玛的儿子是：",
                "> 示巴、底但。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 古实生宁录；",
                "> 他开始在地上成为英雄。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "麦西生了",
                "> 路低人、亚拿米人、利哈比人、拿弗土希人、"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 帕斯鲁细人、迦斯路希人（从迦斯路希人出来非利士人）、迦斐托人。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "迦南生了",
                "> 长子西顿、赫，"
            ]
        },
        {
            "verse": 14,
            "text": [
                "还有耶布斯人、亚摩利人、革迦撒人、"
            ]
        },
        {
            "verse": 15,
            "text": [
                "希未人、亚基人、西尼人、"
            ]
        },
        {
            "verse": 16,
            "text": [
                "亚瓦底人、洗玛利人、哈马人。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "闪的儿子有：",
                "> 以拦、亚述、亚法撒、路德、亚兰。",
                "> 亚兰的儿子是",
                "> 乌斯、户勒、基帖、米设。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "亚法撒生了沙拉，",
                "沙拉生了希伯。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "希伯生了两个儿子：",
                "> 一个名叫法勒，因为在他的时候地就分开了；",
                "> 他的兄弟名叫约坍。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "约坍的子孙有：",
                "> 亚摩答、沙列、哈萨玛非、耶拉、"
            ]
        },
        {
            "verse": 21,
            "text": [
                "哈多兰、乌萨、德拉、"
            ]
        },
        {
            "verse": 22,
            "text": [
                "以巴录、亚比玛利、示巴、"
            ]
        },
        {
            "verse": 23,
            "text": [
                "阿斐、哈腓拉、约巴。",
                "这些都是约坍的儿子。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 闪、亚法撒、沙拉、"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 希伯、法勒、拉吴、"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 西鹿、拿鹤、他拉、"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 亚伯兰，就是亚伯拉罕。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 亚伯拉罕的儿子是：",
                "> 以撒和以实玛利。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "他们的后代记在下面：",
                "> 以实玛利的长子是尼拜约，其次是基达、亚德别、米比衫、"
            ]
        },
        {
            "verse": 30,
            "text": [
                "米施玛、度玛、玛撒、哈达、提玛、"
            ]
        },
        {
            "verse": 31,
            "text": [
                "伊突、拿非施、基底玛。",
                "这些是以实玛利的子孙。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "亚伯拉罕的妾基土拉所生的儿子：",
                "> 心兰、约珊、米但、米甸、伊施巴、书亚。",
                "> 约珊的儿子是：",
                "> 示巴、底但。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "米甸的儿子是：",
                "> 以法、以弗、哈诺、亚比大、以勒大。",
                "> 这些都是基土拉的子孙。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "亚伯拉罕生以撒。",
                "> 以撒的儿子是：",
                "> 以扫和以色列。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "以扫的儿子是：",
                "> 以利法、流珥、耶乌施、雅兰、可拉。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "以利法的儿子是：",
                "> 提幔、阿抹、洗玻、迦坦、基纳斯、亭纳、亚玛力。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "流珥的儿子是：",
                "> 拿哈、谢拉、沙玛、米撒。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "西珥的儿子是：",
                "> 罗坍、朔巴、洗便、亚拿、底顺、以察、底珊。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "罗坍的儿子是：",
                "> 何利、荷幔；罗坍的妹子是亭纳。"
            ]
        },
        {
            "verse": 40,
            "text": [
                "朔巴的儿子是：",
                "> 亚勒文、玛拿辖、以巴录、示非、阿南。",
                "> 洗便的儿子是：",
                "> 亚雅、亚拿。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "亚拿的儿子是：",
                "> 底顺。",
                "> 底顺的儿子是：",
                "> 亥兰、以是班、益兰、基兰。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "以察的儿子是：",
                "> 辟罕、撒番、亚干。",
                "> 底珊的儿子是：",
                "> 乌斯、亚兰。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "以色列人未有君王治理之先，在以东地作王的记在下面：",
                "比珥的儿子比拉，他的京城名叫亭哈巴。"
            ]
        },
        {
            "verse": 44,
            "text": [
                "比拉死了，波斯拉人谢拉的儿子约巴接续他作王。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "约巴死了，提幔地的人户珊接续他作王。"
            ]
        },
        {
            "verse": 46,
            "text": [
                "户珊死了，比达的儿子哈达接续他作王；他在摩押田野杀败米甸人，他的京城名叫亚未得。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "哈达死了，玛士利加人桑拉接续他作王。"
            ]
        },
        {
            "verse": 48,
            "text": [
                "桑拉死了，大河边的利河伯人扫罗接续他作王。"
            ]
        },
        {
            "verse": 49,
            "text": [
                "扫罗死了，亚革波的儿子巴勒哈南接续他作王。"
            ]
        },
        {
            "verse": 50,
            "text": [
                "巴勒哈南死了，哈达接续他作王；",
                "他的京城名叫巴伊，",
                "他的妻子名叫米希他别，是米萨合的孙女、玛特列的女儿。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "哈达死了。",
                "以东的族长有：",
                "亭纳族长、亚利雅族长、耶帖族长、"
            ]
        },
        {
            "verse": 52,
            "text": [
                "阿何利巴玛族长、以拉族长、比嫩族长、"
            ]
        },
        {
            "verse": 53,
            "text": [
                "基纳斯族长、提幔族长、米比萨族长、"
            ]
        },
        {
            "verse": 54,
            "text": [
                "玛基叠族长、以兰族长。",
                "这些是以东的族长。"
            ]
        }
    ]
}