{
    "book": "撒母耳记上",
    "chapter": 18,
    "verses": [
        {
            "verse": 1,
            "text": [
                "大卫与扫罗说完话，约拿单的心与大卫的心深相契合，约拿单爱他如同自己的性命。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "那日扫罗留住大卫，不让他回父家。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "约拿单与大卫立约，因为他爱他如同自己的性命。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "约拿单脱下身上的外袍给大卫，又将自己的战衣、刀、弓、腰带都给了他。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "大卫无论往哪里去，扫罗派他去，他都作事精明，扫罗就立他作战士的统领，众百姓和扫罗的臣仆无不喜悦。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "大卫打死那非利士人回来，与众人一同回来的时候，妇女们从以色列各城里出来，欢欢喜喜地打鼓、跳舞，迎接扫罗王。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "妇女们舞蹈唱和，说：",
                "> “扫罗杀死千千，",
                "> 大卫杀死万万。”"
            ]
        },
        {
            "verse": 8,
            "text": [
                "扫罗甚发怒，不喜悦这话，就说：“将万万归大卫，千千归我，只剩下王位没有给他了。”"
            ]
        },
        {
            "verse": 9,
            "text": [
                "从那日起，扫罗就怒视大卫。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "次日，从神那里来的恶魔大大降在扫罗身上，他就在家中胡言乱语。大卫照常用手弹琴，扫罗手里拿着枪。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "扫罗把枪一掷，心里说：“我要将大卫刺透，钉在墙上。”大卫躲避他两次。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "扫罗惧怕大卫，因为耶和华离开自己，与大卫同在。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "所以扫罗使大卫离开自己，立他为千夫长，他就领兵出入。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "大卫作事无不精明，耶和华也与他同在。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "扫罗见大卫作事精明，就甚怕他。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "但以色列和犹大众人都爱大卫，因为他领他们出入。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "扫罗对大卫说：“我将大女儿米拉给你为妻，只要你为我奋勇，为耶和华争战。”扫罗心里说：“我不好亲手害他，要借非利士人的手害他。”"
            ]
        },
        {
            "verse": 18,
            "text": [
                "大卫对扫罗说：“我是谁？我是什么出身，我父家在以色列中是何等的家，岂敢作王的女婿呢？”"
            ]
        },
        {
            "verse": 19,
            "text": [
                "扫罗的女儿米拉到了当给大卫的时候，却给了米何拉人亚得列为妻。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "扫罗的女儿米甲爱大卫，有人告诉扫罗，扫罗就喜悦。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "扫罗心里说：“我将这女儿给大卫作他的网罗，好借非利士人的手害他。”所以扫罗对大卫说：“你今日可以第二次作我的女婿。”"
            ]
        },
        {
            "verse": 22,
            "text": [
                "扫罗吩咐臣仆说：“你们暗中对大卫说：‘王喜悦你，王的臣仆也都喜爱你，所以你当作王的女婿。’”"
            ]
        },
        {
            "verse": 23,
            "text": [
                "扫罗的臣仆将这些话说给大卫听，大卫说：“你们以为作王的女婿是一件小事吗？我是贫穷卑微的人。”"
            ]
        },
        {
            "verse": 24,
            "text": [
                "扫罗的臣仆回奏，说大卫所说的话如此如此。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "扫罗说：“你们要对大卫这样说：‘王不要什么聘礼，只要一百非利士人的阳皮，好在王的仇敌身上报仇。’”扫罗的意思要使大卫丧在非利士人的手里。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "扫罗的臣仆将这话告诉大卫，大卫就欢喜作王的女婿。日期还没有到，"
            ]
        },
        {
            "verse": 27,
            "text": [
                "大卫和跟随他的人起身前往，杀了二百非利士人，将他们的阳皮满数拿来给王，为要作王的女婿。于是扫罗将女儿米甲给大卫为妻。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "扫罗见耶和华与大卫同在，又知道女儿米甲爱大卫，"
            ]
        },
        {
            "verse": 29,
            "text": [
                "就更怕大卫，常作大卫的仇敌。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "每逢非利士军长出来打仗，大卫比扫罗的臣仆作事更精明，因此他的名被人尊重。"
            ]
        }
    ]
}