{
    "book": "撒母耳记下",
    "chapter": 19,
    "verses": [
        {
            "verse": 1,
            "text": [
                "有人告诉约押说：",
                "“看哪，王为押沙龙哭泣悲哀。”"
            ]
        },
        {
            "verse": 2,
            "text": [
                "那日众民得胜，反成悲哀，",
                "因为众民听说那日王为他儿子忧愁。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "那日众民暗暗地进城，",
                "如同在战场逃跑、惭愧的民一般。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "王蒙着脸，大声哭号说：",
                "“我儿押沙龙啊！押沙龙，我儿，我儿啊！”"
            ]
        },
        {
            "verse": 5,
            "text": [
                "约押进屋见王，说：",
                "“你今日使你一切仆人脸面惭愧了。",
                "他们今日救了你的性命和你儿女妻妾的性命，"
            ]
        },
        {
            "verse": 6,
            "text": [
                "你却爱那恨你的人，恨那爱你的人。",
                "你今日明明不以将帅和仆人为念。",
                "我今日看明，若押沙龙活着，我们都死亡，",
                "你就喜悦了。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "现在你当出去，安慰你仆人的心。",
                "我指着耶和华起誓，",
                "你若不出去，今夜必无一人与你同在。",
                "这祸患就比你从幼年到如今所遭的更甚。”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "于是王起来，坐在城门口。",
                "众民告诉众民说：",
                "“看哪，王坐在城门口。”",
                "众民就都到王面前。",
                "以色列人已经逃跑，各回各家去了。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "以色列众支派的人纷纷议论说：",
                "“王曾救我们脱离仇敌的手，",
                "又救我们脱离非利士人的手，",
                "现在他躲避押沙龙逃出这地。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "我们所膏的押沙龙死在阵上。",
                "现在为什么不请王回来呢？”"
            ]
        },
        {
            "verse": 11,
            "text": [
                "大卫王差人去见祭司撒督和亚比亚他，说：",
                "“你们当向犹大长老说：",
                "‘为什么最后请王回他的宫呢？",
                "以色列众人的话已经传到王那里，",
                "请他回宫。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "你们是我的弟兄，是我的骨肉。",
                "为什么最后请王回来呢？’"
            ]
        },
        {
            "verse": 13,
            "text": [
                "也要对亚玛撒说：",
                "‘你不是我的骨肉吗？",
                "若不立你替约押常作元帅，",
                "愿神重重地降罚于我。’”"
            ]
        },
        {
            "verse": 14,
            "text": [
                "如此就挽回犹大众人的心，",
                "如同一人的心。",
                "他们就打发人去见王，说：",
                "“请王和王的一切仆人回来。”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "王就回来，到了约旦河。",
                "犹大人来到吉甲，要去迎接王，",
                "请王过约旦河。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "巴户琳的便雅悯人基拉的儿子示每，",
                "急忙与犹大人一同下去迎接大卫王。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "跟从示每的有便雅悯人一千，",
                "还有扫罗家的仆人洗巴，",
                "和他十五个儿子、二十个仆人；",
                "他们都急忙过约旦河迎接王。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "他们过渡口，要迎接王的家眷，",
                "并伺候王的心愿。",
                "王要过约旦河的时候，",
                "基拉的儿子示每就俯伏在王面前，"
            ]
        },
        {
            "verse": 19,
            "text": [
                "对王说：",
                "“我主不要算我有罪，",
                "不要记念仆人你出耶路撒冷王那日所行的恶，",
                "王不要放在心上。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "仆人明知自己有罪。",
                "所以今日我首先下到约瑟家，",
                "迎接我主我王。”"
            ]
        },
        {
            "verse": 21,
            "text": [
                "洗鲁雅的儿子亚比筛说：",
                "“示每既咒骂耶和华的受膏者，",
                "岂不该死吗？”"
            ]
        },
        {
            "verse": 22,
            "text": [
                "大卫说：",
                "“洗鲁雅的儿子，我与你们何干，",
                "使你们今日与我作对呢？",
                "今日在以色列中岂可杀人呢？",
                "我岂不知今日我作以色列的王吗？”"
            ]
        },
        {
            "verse": 23,
            "text": [
                "于是王对示每说：",
                "“你必不死。”",
                "王就向他起誓。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "扫罗的孙子米非波设也下去迎接王。",
                "他自从王去的日子直到王平平安安回来，",
                "没有修脚，没有剃胡须，也没有洗衣服。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "他到了耶路撒冷迎接王的时候，",
                "王问他说：",
                "“米非波设，你为什么没有与我同去呢？”"
            ]
        },
        {
            "verse": 26,
            "text": [
                "他回答说：",
                "“我主我王，我的仆人欺哄了我。",
                "因为仆人曾说：‘我要备驴，",
                "自己骑上，与王同去。’",
                "因为仆人是瘸腿的。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "又诬告仆人于我主我王。",
                "我主我王却如神的使者，",
                "所以你看怎样好，就怎样行吧。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "因为我祖父的全家在我主我王面前都是该死的人，",
                "王却使仆人与你同席吃饭。",
                "我现在向王还能辨理诉冤吗？”"
            ]
        },
        {
            "verse": 29,
            "text": [
                "王对他说：",
                "“你何必再提你的事呢？",
                "我说：你与洗巴均分地土。”"
            ]
        },
        {
            "verse": 30,
            "text": [
                "米非波设对王说：",
                "“我主我王既平平安安回宫，",
                "就任凭他都取了，也可以。”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "基列人巴西莱从罗基琳下来，",
                "要送王过约旦河，与王一同过约旦河。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "巴西莱年纪老迈，已经八十岁了。",
                "王住在玛哈念的时候，",
                "他就拿食物来供给王，",
                "因为他是大富户。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "王对巴西莱说：",
                "“你与我同去，我要在耶路撒冷养活你。”"
            ]
        },
        {
            "verse": 34,
            "text": [
                "巴西莱对王说：",
                "“我在世的年日还能有多少，",
                "使我与王同上耶路撒冷呢？"
            ]
        },
        {
            "verse": 35,
            "text": [
                "仆人现在八十岁了，",
                "还能辨别善恶吗？",
                "仆人还能尝出饮食的滋味吗？",
                "还能听男女歌唱的声音吗？",
                "仆人何必累赘我主我王呢？"
            ]
        },
        {
            "verse": 36,
            "text": [
                "仆人只要送王过约旦河，",
                "王何必赐我这样的恩典呢？"
            ]
        },
        {
            "verse": 37,
            "text": [
                "求你容仆人回去，",
                "好死在我本城，",
                "葬在我父母的坟墓旁。",
                "看哪，你仆人金罕可以随我主我王过去，",
                "愿王随意待他。”"
            ]
        },
        {
            "verse": 38,
            "text": [
                "王说：",
                "“金罕可以与我同去，",
                "我必照你的心愿待他。",
                "凡你向我求的，我都必为你成就。”"
            ]
        },
        {
            "verse": 39,
            "text": [
                "于是众民过约旦河，",
                "王也过去。",
                "王与巴西莱亲嘴，为他祝福，",
                "巴西莱就回本地去了。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "王过了约旦河，",
                "金罕也随他过去。",
                "犹大众民和以色列民的一半，",
                "都送王过去。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "看哪，以色列众人来见王，对他说：",
                "“我们弟兄犹大人为什么暗暗送王，",
                "和王的家眷，并跟随大卫的人过约旦河呢？”"
            ]
        },
        {
            "verse": 42,
            "text": [
                "犹大众人回答以色列人说：",
                "“因为王与我们是亲属。",
                "你们为何因这事发怒呢？",
                "我们吃了王的什么呢？",
                "王赏赐了我们什么呢？”"
            ]
        },
        {
            "verse": 43,
            "text": [
                "以色列人回答犹大人说：",
                "“按支派我们与王有十分的情分，",
                "大卫在我们这边，你们为何藐视我们呢？",
                "我们先议论请王回来，",
                "不是我们先说的吗？”",
                "犹大人的话比以色列人的话更硬。"
            ]
        }
    ]
}