{
    "book": "撒母耳记下",
    "chapter": 21,
    "verses": [
        {
            "verse": 1,
            "text": [
                "大卫年间有饥荒，一连三年；",
                "大卫就求问耶和华。",
                "耶和华说：",
                "“这饥荒是因扫罗和他流人血之家，",
                "因为他杀死了基遍人。”"
            ]
        },
        {
            "verse": 2,
            "text": [
                "王召了基遍人来对他们说话。",
                "（基遍人不是以色列人中的一族，乃是亚摩利人中所剩下的；",
                "以色列人曾向他们起誓；",
                "但扫罗因以色列人和犹大人所发的热心，想要杀他们。）"
            ]
        },
        {
            "verse": 3,
            "text": [
                "大卫对基遍人说：",
                "“我当为你们做什么呢？",
                "我怎样赎罪，",
                "使你们为耶和华的产业祝福呢？”"
            ]
        },
        {
            "verse": 4,
            "text": [
                "基遍人回答说：",
                "“我们和扫罗与他的家无关，不要银子金子，",
                "也不要在以色列中杀人。”",
                "大卫说：“你们怎样说，我就为你们怎样行。”"
            ]
        },
        {
            "verse": 5,
            "text": [
                "他们对王说：",
                "“那从前谋害我们，想要灭绝我们，",
                "使我们不得住在以色列境内的人—"
            ]
        },
        {
            "verse": 6,
            "text": [
                "请将他的子孙中七个人交给我们，",
                "我们要在耶和华面前，在扫罗所拣选的基比亚，将他们悬挂。”",
                "王说：“我必交给你们。”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "但王因为约拿单的缘故，",
                "就是扫罗的儿子约拿单与大卫之间耶和华的誓约，",
                "就顾惜约拿单的儿子米非波设，",
                "不交出来。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "王把爱亚的女儿利斯巴给扫罗所生的两个儿子，",
                "亚摩尼和米非波设，",
                "和扫罗的女儿米拉给米何拉人巴西莱的儿子亚得列所生的五个儿子，"
            ]
        },
        {
            "verse": 9,
            "text": [
                "交在基遍人手里，",
                "基遍人就在山上，在耶和华面前将他们悬挂。",
                "这七个人就一同死亡，",
                "被杀的时候正是收割的日子，",
                "就是动手割大麦的时候。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "爱亚的女儿利斯巴用麻布为自己搭棚在磐石上，",
                "从收割的起头，直到天降雨在尸身上；",
                "她不让空中的鸟在白昼落在尸身上，",
                "也不让田野的兽在夜间前来。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "有人将扫罗的妃嫔，爱亚的女儿利斯巴所行的事告诉大卫。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "大卫就去，从基列·雅比人那里将扫罗和他儿子约拿单的骸骨搬了来，",
                "是因非利士人杀扫罗在基利波那日，",
                "将他们悬挂在伯珊街市上，",
                "基列·雅比人偷了去的。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "大卫将扫罗和他儿子约拿单的骸骨从那里搬了来，",
                "又收殓被悬挂之人的骸骨，"
            ]
        },
        {
            "verse": 14,
            "text": [
                "将扫罗和他儿子约拿单的骸骨葬在便雅悯地的洗拉，",
                "在他父亲基士的坟墓里。",
                "众人遵着王所吩咐的行了。",
                "此后，神垂听国民所求的。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "非利士人与以色列人又打仗。",
                "大卫带领仆人下去，与非利士人接战，",
                "大卫就疲乏了。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "伟人的一个儿子以实比诺要杀大卫。",
                "他的铜枪重三百舍客勒，",
                "又佩着新刀。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "但洗鲁雅的儿子亚比筛帮助大卫，击杀那非利士人。",
                "当时大卫的跟随者向他起誓说：",
                "“以后你不可再与我们一同出战，",
                "免得熄灭以色列的灯。”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "后来，以色列人在歌伯与非利士人打仗。",
                "户沙人西比该杀了伟人的一个儿子撒弗。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "又在歌伯与非利士人打仗。",
                "伯利恒人雅雷·俄珥金的儿子以利哈难杀了迦特人歌利亚，",
                "这人的枪杆粗如织布的机轴。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "又在迦特打仗。",
                "那里有一个身量高大的人，",
                "两手各有六指，两脚各有六趾，共有二十四个指头，",
                "也是伟人的儿子。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "这人向以色列人骂阵，",
                "大卫的哥哥示米亚的儿子约拿单就杀了他。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "这四个人是迦特伟人的儿子，",
                "都死在大卫和他仆人的手下。"
            ]
        }
    ]
}