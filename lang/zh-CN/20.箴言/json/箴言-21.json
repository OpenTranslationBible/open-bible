{
    "book": "箴言",
    "chapter": 21,
    "verses": [
        {
            "verse": 1,
            "text": [
                "王的心在耶和华手中，好像水中的河道，随意流转。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "人所行的，在自己眼中看为正，但耶和华衡量人心。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "行公义和公平，比献祭更蒙耶和华悦纳。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "高傲的眼和骄傲的心，恶人的灯，都是罪。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "殷勤人的筹算必致丰裕，急躁的人必致贫乏。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "用诡诈之舌得来的财宝，是虚浮的泡影，乃是寻死之路。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "恶人的强暴必将自己扫除，因为他们不肯按公平行事。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "罪人的路弯曲，清洁人的行为正直。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "宁可住在房顶的角上，不在宽阔的房屋与争吵的妇人同住。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "恶人的心乐于作恶，怜悯人也不顾。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "亵慢人受刑罚，愚蒙人就得智慧；智慧人受训诲，便得知识。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "义人思想恶人的家，知道恶人倾倒，必至灭亡。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "塞耳不听穷人哀求的，他将来呼吁也不蒙应允。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "暗中送的礼物挽回怒气，怀中搋的贿赂止息暴怒。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "秉公行义使义人喜乐，却使作孽的人败坏。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "迷离通达道的，必住在阴魂的会中。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "爱宴乐的，必致穷乏；好酒爱膏油的，必不富足。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "恶人作了义人的赎价，奸诈人代替正直人。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "宁可住在旷野，不与争吵使气的妇人同住。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "智慧人家中积蓄宝物膏油，愚昧人随得来随吞下。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "追求公义仁慈的，就寻得生命、公义和尊荣。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "智慧人爬上勇士的城墙，倾覆他所倚靠的坚垒。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "谨守口与舌的，就保守自己免受灾难。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "心骄气傲的人名叫亵慢，他行事狂妄，皆因骄傲。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "懒惰人的心愿将他杀害，因为他手不肯作工。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "有终日贪得无餍的，义人施舍而不吝惜。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "恶人的祭物是可憎的，何况他存恶意来献呢？"
            ]
        },
        {
            "verse": 28,
            "text": [
                "作假见证的必灭亡，惟有听真情的必存言长久。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "恶人脸无羞耻，正直人行事坚定。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "没有智慧、没有聪明、没有谋略能敌挡耶和华。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "马是为打仗之日预备的，得胜乃在乎耶和华。"
            ]
        }
    ]
}