{
    "book": "箴言",
    "chapter": 19,
    "verses": [
        {
            "verse": 1,
            "text": [
                "行为正直的穷人胜过言语乖谬的愚昧人。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "心中无知识的愿望并不好，脚步匆忙的容易失足。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "人的愚昧使他的路偏离，他的心却向耶和华发怒。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "财富使朋友增多，但穷人却被朋友远离。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "作假见证的必不免受罚，吐出谎言的必不能逃脱。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "许多人求恩于慷慨的人，凡送礼的人都为朋友。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "穷人的亲戚都厌弃他，何况他的朋友更远离他！他用言语追随他们，他们却无踪影。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "得智慧的爱惜自己的生命，珍惜聪明的必得好处。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "作假见证的必不免受罚，吐出谎言的终必灭亡。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "愚昧人不宜享受奢华，何况仆人管辖王子呢？"
            ]
        },
        {
            "verse": 11,
            "text": [
                "人的智慧使他不轻易发怒，宽恕人的过失便是他的荣耀。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "王的忿怒如狮子吼叫，他的恩典却如草上的甘露。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "愚昧的儿子是父亲的祸患，妻子的争吵如雨滴不断。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "房屋和财物是祖宗所遗留的，惟有贤慧的妻子是从耶和华来的。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "懒惰使人沉睡，懒散的人必受饥饿。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "谨守诫命的保全生命，轻忽己行的必致死亡。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "怜悯贫穷的就是借给耶和华，他的善行耶和华必偿还。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "趁有指望管教你的儿子，不可任他死亡。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "暴怒的人必受罚，若你救他，必须再救。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "听从劝告，接受教训，使你终久有智慧。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "人心多有计谋，惟有耶和华的旨意才能立定。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "人的仁慈是可取的，穷人胜过说谎的人。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "敬畏耶和华使人得生命，得享安息，不遭祸患。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "懒惰人把手放在盘子里，却不肯拿回口中。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "责打亵慢人，愚蒙人必长见识；责备明哲人，他就会明白知识。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "抢夺父亲、赶出母亲的，是令人羞愧、可耻的儿子。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "我儿，不可不听教训，以致偏离知识的言语。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "无赖的见证人戏弄公义，恶人的口吞下罪孽。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "刑罚是为亵慢人预备的，鞭打是为愚昧人的背预备的。"
            ]
        }
    ]
}