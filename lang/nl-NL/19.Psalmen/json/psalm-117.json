{
    "book": "Psalmen",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Eer de Heer, alle naties;",
                "> Vier Zijn naam, alle volken!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Want Zijn goedheid jegens ons is immens,",
                "> En de trouw van de Heer duurt voor eeuwig.",
                "---",
                "> Eer de Heer!"
            ]
        }
    ]
}