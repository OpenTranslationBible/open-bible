{
    "book": "Sabuurka",
    "chapter": 119,
    "verses": [
        {
            "text": [
                "א Aleph"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> Waxaa faraxsan kuwa jidkoodu nadiif yahay,",
                "> Kuwa raaca Sharciga Eebbe."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Waxaa faraxsan kuwa dhawra markhaatiyadiisa,",
                "> Oo isaga u doondoona qalbigooda oo dhan."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> Iyaguna ma sameeyaan wax qaldan;",
                "> Waxay ku socdaan jidadkiisa."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Waxaad dejisay amarradaada,",
                "> In aan si dadaal leh u ilaalino."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> Bal in jidadkaygu ay joogto noqdaan",
                "> Si aan u dhawro xeerarkaaga!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> Markaasaan ma xishoon doono",
                "> Markaan tixgeliyo amarradaada oo dhan."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> Waxaan kuugu mahadcelin doonaa qalbi daacad ah,",
                "> Markaan barto xukummadaada xaqa ah."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> Waxaan ilaalin doonaa xeerarkaaga;",
                "> Ha iga tegin gebi ahaanba!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ב Beth"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> Sidee ayuu wiil dhallinyaro ah jidkiisa nadiif uga dhigi karaa?",
                "> Markuu ku hayo eraygaaga."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> Qalbigayga oo dhan ayaan ku doondoonay;",
                "> Ha iga leexin amarradaada."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> Waxaan qalbigayga ku haystay eraygaaga,",
                "> Si aanan kaaga dembaabin."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> Waxaa ammaan mudan tahay, Eebbow;",
                "> I bar xeerarkaaga."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> Bushimahayga waxaan ku sheegay",
                "> Dhammaan xeerarka afkaaga."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> Waxaan farxad ku helay jidka markhaatiyadaada,",
                "> Sida oo kale dhammaan maalmaha hodanka ah."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> Waxaan ka fikirayaa amarradaada",
                "> Oo waxaan tixgelinayaa jidadkaaga."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> Waxaan ku raaxaysan doonaa xeerarkaaga;",
                "> Ma illoobi doono eraygaaga."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ג Gimel"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> U naxariiso addoonkaaga,",
                "> Si aan u noolaado oo aan u hayo eraygaaga."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> I fur indhahayga, si aan u arko",
                "> Waxyaalaha yaabka leh ee Sharcigaaga."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> Waxaan ahay socdaal dhulka;",
                "> Ha iga qarin amarradaada."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> Naftaydu waxay ku dheggan tahay xiisaha",
                "> Xeerarkaaga waqti kasta."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> Waxaad canaanatay kuwa kibirka leh, kuwa la habaaray,",
                "> Kuwa ka leexda amarradaada."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> Ka qaad ceeb iyo quudhsi iga,",
                "> Waayo, waxaan dhawrayaa markhaatiyadaada."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> In kastoo taliyayaashu fadhiyaan oo iga hadlaan,",
                "> Addoonkaaga wuxuu ka fikiraa xeerarkaaga."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> Markhaatiyadaaduna waa farxaddayda;",
                "> Iyagu waa la-taliyayaashayda."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ד Daleth"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> Naftaydu waxay ku dheggan tahay dhulka;",
                "> I cusbooneysii sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> Waxaan ka sheekeeyey jidadkayga, oo waxaad ii jawaabtay;",
                "> I bar xeerarkaaga."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> I caawi inaan fahmo jidka amarradaada,",
                "> Si aan uga fikiro yaababtaada."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> Naftaydu waxay ilmeeysaa murugo awgeed;",
                "> I adkee sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> Ka fogee jidka khiyaanada iga,",
                "> Oo si naxariis leh i sii Sharcigaaga."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> Waxaan doortay jidka daacadnimada;",
                "> Waxaan hortayda dhigay xukummadaada."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> Waxaan ku dhegganahay markhaatiyadaada;",
                "> Eebbow, ha iga dhigin mid xishooda!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> Waxaan ku ordi doonaa jidka amarradaada,",
                "> Waayo, waxaad ballaadhin doontaa qalbigayga."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ה He"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> I bar, jidka xeerarkaaga, Eebbow,",
                "> Oo waan dhawri doonaa ilaa dhammaadka."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> I sii faham, si aan u dhawro Sharcigaaga",
                "> Oo aan ugu hayo qalbigayga oo dhan."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> I hanuuni jidka amarradaada,",
                "> Waayo, waxaan ku raaxaystaa."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> Qalbigayga u soo jiid markhaatiyadaada,",
                "> Oo aan u jeedin faa'iido been ah."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> I leexi indhahayga si aanan ugu fiirsan waxa aan qiimo lahayn,",
                "> Oo i cusbooneysii jidadkaaga."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> Adkee eraygaaga addoonkaaga,",
                "> Sida mid ku dhiirigeliya cabsidaada."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> Ka fogee ceebtayda aan ka baqayo,",
                "> Waayo, xukummadaadu waa wanaagsan yihiin."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> Bal eeg, waxaan u xiisay amarradaada;",
                "> I cusbooneysii xaqnimadaada."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ו Waw"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> Fadligaaga ha ii yimaado, Eebbow,",
                "> Badbaadintaada sida ku qoran eraygaaga;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> Si aan u helo jawaab midka i quudhsada,",
                "> Waayo, waxaan isku halleeyaa eraygaaga."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> Ha iga qaadin erayga runta gebi ahaanba afkayga,",
                "> Waayo, waxaan sugayaa xukummadaada."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> Sidaas ayaan u ilaalin doonaa Sharcigaaga si joogto ah,",
                "> Waqti walba."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> Oo waxaan ku socon doonaa xorriyad,",
                "> Waayo, waxaan doondoonayaa amarradaada."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> Waxaan kaloo ka sheegi doonaa markhaatiyadaada hortooda boqorrada,",
                "> Oo ma xishoon doono."
            ]
        },
        {
            "verse": 47,
            "text": [
                "> Waxaan ku raaxaysan doonaa amarradaada,",
                "> Kuwa aan jeclahay."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> Oo waxaan kor u qaadi doonaa gacmahayga amarradaada, kuwa aan jeclahay;",
                "> Oo waxaan ka fikiri doonaa xeerarkaaga."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ז Zayin"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> Xusuuso erayga addoonkaaga,",
                "> Kaas oo aad igu rajo gelisay."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> Tani waa raaxadayda dhibaatadayda,",
                "> In eraygaaga i cusbooneysiiyey."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> Kuwa kibirka leh waxay i quudhsadaan gebi ahaanba,",
                "> Hase yeeshee kama leexdo Sharcigaaga."
            ]
        },
        {
            "verse": 52,
            "text": [
                "> Waxaan xusuustay xukummadaadii hore, Eebbow,",
                "> Oo waxaan helay raaxo."
            ]
        },
        {
            "verse": 53,
            "text": [
                "> Cadho xoog leh ayaa i qabatay sababtoo ah kuwa sharka leh,",
                "> Kuwa ka tagay Sharcigaaga."
            ]
        },
        {
            "verse": 54,
            "text": [
                "> Xeerarkaagu waxay ahaayeen heesahayga",
                "> Guriga safarkayga."
            ]
        },
        {
            "verse": 55,
            "text": [
                "> Eebbow, waxaan xusuustaa magacaaga habeenkii,",
                "> Oo waxaan dhawraa Sharcigaaga."
            ]
        },
        {
            "verse": 56,
            "text": [
                "> Tani waxay noqotay aniga,",
                "> In aan dhawro amarradaada."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ח Heth"
            ]
        },
        {
            "verse": 57,
            "text": [
                "> Eebbe waa qaybteyda;",
                "> Waxaan ballanqaaday inaan dhawro erayadaada."
            ]
        },
        {
            "verse": 58,
            "text": [
                "> Waxaan ku doondoonay fadligaaga qalbigayga oo dhan;",
                "> I si naxariis leh sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 59,
            "text": [
                "> Waxaan ka fikiri jiray jidadkayga",
                "> Oo waxaan u jeestay tallaabooyinkayga markhaatiyadaada."
            ]
        },
        {
            "verse": 60,
            "text": [
                "> Waxaan ku degdegay oo ma daahin",
                "> In aan raaco amarradaada."
            ]
        },
        {
            "verse": 61,
            "text": [
                "> Dabinnada kuwa sharka leh ayaa hareereeyey,",
                "> Laakiin ma illoobin Sharcigaaga."
            ]
        },
        {
            "verse": 62,
            "text": [
                "> Waxaan kacaa habeenbadhkii si aan kuugu mahadceliyo",
                "> Sababta xukummadaada xaqa ah."
            ]
        },
        {
            "verse": 63,
            "text": [
                "> Waxaan ahay saaxiib u ah dhammaan kuwa kaa cabsada,",
                "> Iyo kuwa dhawra amarradaada."
            ]
        },
        {
            "verse": 64,
            "text": [
                "> Dhulka waxaa ka buuxa naxariistaada, Eebbow;",
                "> I bar xeerarkaaga."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ט Teth"
            ]
        },
        {
            "verse": 65,
            "text": [
                "> Waxaad si wanaagsan ula dhaqantay addoonkaaga, Eebbow,",
                "> Sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 66,
            "text": [
                "> I bar garasho wanaagsan iyo aqoon,",
                "> Waayo, waxaan isku halleeyaa amarradaada."
            ]
        },
        {
            "verse": 67,
            "text": [
                "> Intaanan dhibaataysan, waan ka leexday,",
                "> Laakiin hadda waxaan had iyo jeer dhawraa eraygaaga."
            ]
        },
        {
            "verse": 68,
            "text": [
                "> Waxaad tahay mid wanaagsan oo samaysa waxa saxda ah;",
                "> I bar xeerarkaaga."
            ]
        },
        {
            "verse": 69,
            "text": [
                "> Kuwa kibirka leh waxay igu been abuureen;",
                "> Qalbigayga oo dhan waxaan dhawri doonaa amarradaada."
            ]
        },
        {
            "verse": 70,
            "text": [
                "> Qalbigoodu waa mid aan dareen lahayn, sida baruurta adag,",
                "> Laakiin waxaan ku raaxaystaa Sharcigaaga."
            ]
        },
        {
            "verse": 71,
            "text": [
                "> Waxaa ii wanaagsanayd inaan la kulmo dhibaato,",
                "> Si aan u barto xeerarkaaga."
            ]
        },
        {
            "verse": 72,
            "text": [
                "> Sharciga afkaaga wuxuu ii yahay mid ka qaalisan",
                "> Kumanaan dahab iyo lacag ah."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "י Yodh"
            ]
        },
        {
            "verse": 73,
            "text": [
                "> Gacmahaagu waxay i sameeyeen oo i qaabeeyeen;",
                "> I sii faham, si aan u barto amarradaada."
            ]
        },
        {
            "verse": 74,
            "text": [
                "> Kuwa kaa cabsada ha i arkaan oo ha ku farxaan,",
                "> Waayo, waxaan rajaynayaa eraygaaga."
            ]
        },
        {
            "verse": 75,
            "text": [
                "> Waxaan ogahay, Eebbow, in xukummadaadu ay yihiin kuwo xaq ah,",
                "> Oo inaad i siisay imtixaan si daacadnimo ah."
            ]
        },
        {
            "verse": 76,
            "text": [
                "> Fadligaagu ha i raaxeeyo,",
                "> Sida ku qoran eraygaaga addoonkaaga."
            ]
        },
        {
            "verse": 77,
            "text": [
                "> Naxariistaadu ha ii timaado, i siiso nolol,",
                "> Waayo, Sharcigaagu waa farxaddayda."
            ]
        },
        {
            "verse": 78,
            "text": [
                "> Kuwa kibirka leh ha xishoodaan, waayo, waxay igu sameeyaan been;",
                "> Laakiin waxaan ka fikiri doonaa amarradaada."
            ]
        },
        {
            "verse": 79,
            "text": [
                "> Kuwa kaa cabsada ha ii soo jeestaan,",
                "> Iyo kuwa yaqaan markhaatiyadaada."
            ]
        },
        {
            "verse": 80,
            "text": [
                "> Qalbigaygu ha noqdo mid joogto ah xeerarkaaga,",
                "> Si aanan u xishoon."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "כ Kaph"
            ]
        },
        {
            "verse": 81,
            "text": [
                "> Naftaydu waxay u xiisay badbaadintaada;",
                "> Waxaan sugayaa eraygaaga."
            ]
        },
        {
            "verse": 82,
            "text": [
                "> Indhahaygu way daaleen iyagoo u xiisaya eraygaaga,",
                "> Intaan leeyahay, “Goorma ayaad i raaxayn doontaa?”"
            ]
        },
        {
            "verse": 83,
            "text": [
                "> In kastoo aan noqday sida maqaarka khamriga ee qalalan ee qiiqa,",
                "> Ma illoobin xeerarkaaga."
            ]
        },
        {
            "verse": 84,
            "text": [
                "> Waa maxay cabbirka maalmahayga, addoonkaaga?",
                "> Goorma ayaad cadaalad u keeni doontaa kuwa i eryanaya?"
            ]
        },
        {
            "verse": 85,
            "text": [
                "> Kuwa kibirka leh waxay ii qodeen godad,",
                "> Dadka aan ku raacsanayn Sharcigaaga."
            ]
        },
        {
            "verse": 86,
            "text": [
                "> Dhammaan amarradaadu waa kuwo daacad ah;",
                "> Waxay igu silciyeen been; i caawi!"
            ]
        },
        {
            "verse": 87,
            "text": [
                "> Waxay ku dhowaadeen inay i baabi'iyaan dhulka,",
                "> Laakiin kama tagin amarradaada."
            ]
        },
        {
            "verse": 88,
            "text": [
                "> I cusbooneysii sida ku qoran naxariistaada,",
                "> Si aan u dhawro markhaatiga afkaaga."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ל Lamedh"
            ]
        },
        {
            "verse": 89,
            "text": [
                "> Weligeed, Eebbow,",
                "> Eraygaagu wuxuu taagan yahay samada."
            ]
        },
        {
            "verse": 90,
            "text": [
                "> Daacadnimadaadu waxay sii socotaa jiilal dhan;",
                "> Waxaad dejisay dhulka, oo wuu taagan yahay."
            ]
        },
        {
            "verse": 91,
            "text": [
                "> Waxay taagan yihiin maanta xukummadaada,",
                "> Waayo, dhammaan waxyaaluhu way kuu adeegaan."
            ]
        },
        {
            "verse": 92,
            "text": [
                "> Haddaan Sharcigaagu noqon mid aan ku raaxaysto,",
                "> Waxaan ku halligmi lahaa dhibaatadayda."
            ]
        },
        {
            "verse": 93,
            "text": [
                "> Marnaba ma illoobi doono amarradaada,",
                "> Waayo, adigaa i cusbooneysiiyey iyaga."
            ]
        },
        {
            "verse": 94,
            "text": [
                "> Waxaan kuu ahay; i badbaadi,",
                "> Waayo, waxaan doondoonay amarradaada."
            ]
        },
        {
            "verse": 95,
            "text": [
                "> Kuwa sharka leh waxay ku sugayaan inay i baabi'iyaan;",
                "> Waxaan si dadaal leh u tixgelin doonaa markhaatiyadaada."
            ]
        },
        {
            "verse": 96,
            "text": [
                "> Waxaan arkay xad u leh dhammaan kaamilnimada;",
                "> Amarkaagu waa mid aad u ballaadhan."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מ Mem"
            ]
        },
        {
            "verse": 97,
            "text": [
                "> Sidee ayaan u jeclahay Sharcigaaga!",
                "> Waa fikirka maalintayda oo dhan."
            ]
        },
        {
            "verse": 98,
            "text": [
                "> Amarradaadu waxay iga dhigaan mid ka caqli badan cadowgayga,",
                "> Waayo, weligood waa kayga."
            ]
        },
        {
            "verse": 99,
            "text": [
                "> Waxaan leeyahay faham ka badan dhammaan macallimiintayda,",
                "> Waayo, markhaatiyadaadu waa fikirka aan ka fikiro."
            ]
        },
        {
            "verse": 100,
            "text": [
                "> Waxaan fahmayaa ka badan kuwa waayeelka ah,",
                "> Sababta oo ah waxaan dhawray amarradaada."
            ]
        },
        {
            "verse": 101,
            "text": [
                "> Waxaan ka ilaaliyay cagahayga jid kasta oo shar ah,",
                "> Si aan u dhawro eraygaaga."
            ]
        },
        {
            "verse": 102,
            "text": [
                "> Kama leexan xukummadaada,",
                "> Waayo, adigaa i baray."
            ]
        },
        {
            "verse": 103,
            "text": [
                "> Sidee ayay erayadaadu ugu macaan yihiin dhadhankayga!",
                "> Haa, way ka macaan yihiin malabka afkayga!"
            ]
        },
        {
            "verse": 104,
            "text": [
                "> Amarradaada waxaan ka helaa faham;",
                "> Sidaa darteed waxaan necbahay jid kasta oo been ah."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "נ Nun"
            ]
        },
        {
            "verse": 105,
            "text": [
                "> Eraygaagu waa sida laambad cagahayga u ah",
                "> Iyo iftiin jidkayga."
            ]
        },
        {
            "verse": 106,
            "text": [
                "> Waxaan ku dhaartay oo waan ilaalin doonaa,",
                "> In aan dhawro xukummadaada xaqa ah."
            ]
        },
        {
            "verse": 107,
            "text": [
                "> Waxaan ahay mid aad u dhibaataysan;",
                "> I cusbooneysii, Eebbow, sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 108,
            "text": [
                "> Fadlan aqbal hadiyadaha afkayga ee ikhtiyaarka ah, Eebbow,",
                "> Oo i bar xukummadaada."
            ]
        },
        {
            "verse": 109,
            "text": [
                "> Nolosheydu waxay si joogto ah ugu jirtaa gacantayda,",
                "> Hase yeeshee ma illoobin Sharcigaaga."
            ]
        },
        {
            "verse": 110,
            "text": [
                "> Kuwa sharka leh waxay ii dhigeen dabin,",
                "> Hase yeeshee kama leexan amarradaada."
            ]
        },
        {
            "verse": 111,
            "text": [
                "> Waxaan helay markhaatiyadaada sida dhaxal weligiis ah,",
                "> Waayo, waa farxadda qalbigayga."
            ]
        },
        {
            "verse": 112,
            "text": [
                "> Waxaan dejiyay qalbigayga inaan fuliyo xeerarkaaga",
                "> Weligeed, ilaa dhammaadka."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ס Samekh"
            ]
        },
        {
            "verse": 113,
            "text": [
                "> Waxaan necbahay kuwa laba-wajiilayaasha ah,",
                "> Laakiin waxaan jeclahay Sharcigaaga."
            ]
        },
        {
            "verse": 114,
            "text": [
                "> Adigu waxaad tahay magangalkayga iyo gaashaanadayda;",
                "> Waxaan rajaynayaa eraygaaga."
            ]
        },
        {
            "verse": 115,
            "text": [
                "> Iga taga, kuwa sharka leh,",
                "> Si aan u dhawro amarrada Eebbaha."
            ]
        },
        {
            "verse": 116,
            "text": [
                "> I taageer sida ku qoran eraygaaga, si aan u noolaado;",
                "> Oo ha iga dhigin mid xishooda rajadayda."
            ]
        },
        {
            "verse": 117,
            "text": [
                "> I taageer si aan u nabad galo,",
                "> Si aan u tixgeliyo xeerarkaaga si joogto ah."
            ]
        },
        {
            "verse": 118,
            "text": [
                "> Waxaad diidday dhammaan kuwa ka leexda xeerarkaaga,",
                "> Waayo, khiyaanadoodu waa mid aan faa'iido lahayn."
            ]
        },
        {
            "verse": 119,
            "text": [
                "> Waxaad ka saartay dhammaan kuwa sharka leh ee dhulka sida wasakhda;",
                "> Sidaa darteed waxaan jeclahay xeerarkaaga."
            ]
        },
        {
            "verse": 120,
            "text": [
                "> Hilibkaygu wuxuu la gariiraa cabsidaada,",
                "> Oo waxaan ka baqayaa xukummadaada."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ע Ayin"
            ]
        },
        {
            "verse": 121,
            "text": [
                "> Waxaan sameeyey caddaalad iyo xaqnimo;",
                "> Ha iga tegin kuwa i dulma."
            ]
        },
        {
            "verse": 122,
            "text": [
                "> Noqo dammaanad qaade addoonkaaga wanaag;",
                "> Ha u ogolaan kuwa kibirka leh inay i dulmaan."
            ]
        },
        {
            "verse": 123,
            "text": [
                "> Indhahaygu way daaleen iyagoo u xiisaya badbaadintaada,",
                "> Iyo eraygaaga xaqa ah."
            ]
        },
        {
            "verse": 124,
            "text": [
                "> U dhaqan addoonkaaga naxariistaada,",
                "> Oo i bar xeerarkaaga."
            ]
        },
        {
            "verse": 125,
            "text": [
                "> Waxaan ahay addoonkaaga; i sii faham,",
                "> Si aan u ogaado markhaatiyadaada."
            ]
        },
        {
            "verse": 126,
            "text": [
                "> Waa waqtigii Eebbe uu wax qaban lahaa,",
                "> Waayo, waxay jebiyeen Sharcigaaga."
            ]
        },
        {
            "verse": 127,
            "text": [
                "> Sidaa darteed waxaan jeclahay amarradaada",
                "> Ka badan dahabka, haa, ka badan dahabka saafi ah."
            ]
        },
        {
            "verse": 128,
            "text": [
                "> Sidaa darteed waxaan raacaa dhammaan amarradaada si taxaddar leh,",
                "> Waxaan necbahay jid kasta oo been ah."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "פ Pe"
            ]
        },
        {
            "verse": 129,
            "text": [
                "> Markhaatiyadaadu waa yaab;",
                "> Sidaa darteed naftaydu way dhawrtay."
            ]
        },
        {
            "verse": 130,
            "text": [
                "> Muujinta erayadaadu waxay keentaa iftiin;",
                "> Waxay faham siisaa kuwa fudud."
            ]
        },
        {
            "verse": 131,
            "text": [
                "> Waxaan afkayga u furay si ballaadhan oo xiiso leh,",
                "> Waayo, waxaan u xiisay amarradaada."
            ]
        },
        {
            "verse": 132,
            "text": [
                "> I soo jeedso oo ii naxariiso,",
                "> Sida ku habboon kuwa jeclaada magacaaga."
            ]
        },
        {
            "verse": 133,
            "text": [
                "> Adkee tallaabooyinkayga eraygaaga,",
                "> Oo ha u ogolaan wax qaldan inay igu awood yeeshaan."
            ]
        },
        {
            "verse": 134,
            "text": [
                "> Iga soo fur dulmiga dadka,",
                "> Si aan u dhawro amarradaada."
            ]
        },
        {
            "verse": 135,
            "text": [
                "> Wajigaaga ku iftiimi addoonkaaga,",
                "> Oo i bar xeerarkaaga."
            ]
        },
        {
            "verse": 136,
            "text": [
                "> Indhahaygu waxay daadshaan biyo qulqulaya,",
                "> Sababta oo ah ma dhawraan Sharcigaaga."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "צ Tsadhe"
            ]
        },
        {
            "verse": 137,
            "text": [
                "> Adigu waxaad tahay mid xaq ah, Eebbow,",
                "> Oo xukummadaadu waa sax."
            ]
        },
        {
            "verse": 138,
            "text": [
                "> Waxaad ku amartay markhaatiyadaada xaqnimo",
                "> Iyo daacadnimo weyn."
            ]
        },
        {
            "verse": 139,
            "text": [
                "> Xamaasadaydu waxay i qabatay,",
                "> Sababta oo ah cadowgaygu waxay illoobeen erayadaada."
            ]
        },
        {
            "verse": 140,
            "text": [
                "> Eraygaagu waa mid aad u saafi ah,",
                "> Sidaa darteed addoonkaagu wuu jeclaanayaa."
            ]
        },
        {
            "verse": 141,
            "text": [
                "> Waxaan ahay mid aan qiimo lahayn oo la quudhsaday,",
                "> Hase yeeshee ma illoobin amarradaada."
            ]
        },
        {
            "verse": 142,
            "text": [
                "> Xaqnimadaadu waa mid weligeed ah,",
                "> Oo Sharcigaagu waa udub dhexaadka runta."
            ]
        },
        {
            "verse": 143,
            "text": [
                "> Dhib iyo cidhiidhi ayaa i helay,",
                "> Hase yeeshee amarradaadu waxay ii keenaan farxad."
            ]
        },
        {
            "verse": 144,
            "text": [
                "> Markhaatiyadaadu waa xaq weligeed ah;",
                "> I sii faham si aan u noolaado."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ק Qoph"
            ]
        },
        {
            "verse": 145,
            "text": [
                "> Waxaan ku qayliyay qalbigayga oo dhan; iigu jawaab, Eebbow!",
                "> Waxaan dhawri doonaa xeerarkaaga."
            ]
        },
        {
            "verse": 146,
            "text": [
                "> Waxaan kuu yeedhay; i badbaadi,",
                "> Oo waxaan dhawri doonaa markhaatiyadaada."
            ]
        },
        {
            "verse": 147,
            "text": [
                "> Waxaan kacaa waaberiga ka hor oo waxaan u qayliyaa caawimaad;",
                "> Waxaan sugayaa erayadaada."
            ]
        },
        {
            "verse": 148,
            "text": [
                "> Indhahaygu waxay sugayaan ilaalinta habeenka,",
                "> Si aan uga fikiro eraygaaga."
            ]
        },
        {
            "verse": 149,
            "text": [
                "> Maqal codkayga sida ku qoran naxariistaada;",
                "> I cusbooneysii, Eebbow, sida ku qoran xukummadaada."
            ]
        },
        {
            "verse": 150,
            "text": [
                "> Kuwa sharka leh waxay ii soo dhowaanayaan;",
                "> Waxay ka fog yihiin Sharcigaaga."
            ]
        },
        {
            "verse": 151,
            "text": [
                "> Hase yeeshee adigu waxaad tahay mid dhow, Eebbow,",
                "> Oo dhammaan amarradaadu waa run."
            ]
        },
        {
            "verse": 152,
            "text": [
                "> Hore ayaan uga bartay markhaatiyadaada,",
                "> In aad dejisay weligeed."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ר Resh"
            ]
        },
        {
            "verse": 153,
            "text": [
                "> Fiiri dhibaatadayda oo i badbaadi,",
                "> Waayo, ma illoobin Sharcigaaga."
            ]
        },
        {
            "verse": 154,
            "text": [
                "> Dacwaddayda u doodo oo i soo fur;",
                "> I cusbooneysii sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 155,
            "text": [
                "> Badbaadintu waa ka fog tahay kuwa sharka leh,",
                "> Waayo, ma doondoonaan xeerarkaaga."
            ]
        },
        {
            "verse": 156,
            "text": [
                "> Naxariistaadu waa weyn tahay, Eebbow;",
                "> I cusbooneysii sida ku qoran xukummadaada."
            ]
        },
        {
            "verse": 157,
            "text": [
                "> Waxaa badan kuwa i silciya iyo cadowgayga,",
                "> Hase yeeshee kama leexdo markhaatiyadaada."
            ]
        },
        {
            "verse": 158,
            "text": [
                "> Waxaan arkaa kuwa khiyaano leh oo dareemaya quudhsi,",
                "> Sababta oo ah ma dhawraan eraygaaga."
            ]
        },
        {
            "verse": 159,
            "text": [
                "> Tixgeli sida aan u jeclahay amarradaada;",
                "> I cusbooneysii, Eebbow, sida ku qoran naxariistaada."
            ]
        },
        {
            "verse": 160,
            "text": [
                "> Dhammaan eraygaagu waa run,",
                "> Oo mid kasta oo xukummadaada xaqa ah waa weligeed."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ש Sin and Shin"
            ]
        },
        {
            "verse": 161,
            "text": [
                "> Amiirro waxay i eryaan sabab la'aan,",
                "> Laakiin qalbigaygu wuxuu ka cabsadaa erayadaada."
            ]
        },
        {
            "verse": 162,
            "text": [
                "> Waxaan ku farxaa eraygaaga,",
                "> Sida mid helay hanti weyn."
            ]
        },
        {
            "verse": 163,
            "text": [
                "> Waxaan necbahay oo quudhsadaa been,",
                "> Laakiin waxaan jeclahay Sharcigaaga."
            ]
        },
        {
            "verse": 164,
            "text": [
                "> Waxaan ku ammaanayaa maalinta oo dhan",
                "> Sababta oo ah xukummadaada xaqa ah."
            ]
        },
        {
            "verse": 165,
            "text": [
                "> Kuwa jeclaada Sharcigaaga waxay leeyihiin nabad weyn,",
                "> Oo waxba ma keeni karaan inay ku turunturoodaan."
            ]
        },
        {
            "verse": 166,
            "text": [
                "> Waxaan rajaynayaa badbaadintaada, Eebbow,",
                "> Oo waxaan raacaa amarradaada."
            ]
        },
        {
            "verse": 167,
            "text": [
                "> Naftaydu waxay dhawrtay markhaatiyadaada,",
                "> Oo waxaan aad u jeclahay."
            ]
        },
        {
            "verse": 168,
            "text": [
                "> Waxaan dhawrayaa amarradaada iyo markhaatiyadaada,",
                "> Waayo, dhammaan jidadkaygu waa hortaa."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ת Taw"
            ]
        },
        {
            "verse": 169,
            "text": [
                "> Ha yimaado qayladaydu hortaa, Eebbow;",
                "> I sii faham sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 170,
            "text": [
                "> Ha yimaado baryadaydu hortaa;",
                "> I badbaadi sida ku qoran eraygaaga."
            ]
        },
        {
            "verse": 171,
            "text": [
                "> Bushimahaygu ha ka buuxsamaan ammaan,",
                "> Waayo, waxaad i bartaa xeerarkaaga."
            ]
        },
        {
            "verse": 172,
            "text": [
                "> Carrabkaygu ha ku heeso eraygaaga,",
                "> Waayo, dhammaan amarradaadu waa xaqnimo."
            ]
        },
        {
            "verse": 173,
            "text": [
                "> Gacantaadu ha diyaar noqoto inay i caawiso,",
                "> Waayo, waxaan doortay amarradaada."
            ]
        },
        {
            "verse": 174,
            "text": [
                "> Waxaan u xiisay badbaadintaada, Eebbow,",
                "> Oo Sharcigaagu waa farxaddayda."
            ]
        },
        {
            "verse": 175,
            "text": [
                "> Naftaydu ha noolaato si ay kuu ammaanto,",
                "> Oo xukummadaadu ha i caawiyaan."
            ]
        },
        {
            "verse": 176,
            "text": [
                "> Waxaan ku wareegay sida ido lumay; addoonkaaga raadi,",
                "> Waayo, ma illoobin amarradaada."
            ]
        }
