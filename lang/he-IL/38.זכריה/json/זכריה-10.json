{
    "book": "זכריה",
    "chapter": 10,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> שאלו מֵיָהוה מטר בעת מלקוש—",
                "> יְהוה עושה חזיזים;",
                "> ויתן להם מטר גשם, עשב בשדה לאיש."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי התרפים דברו און,",
                "> והקוסמים חזו שקר",
                "> וחלמות שוא ידברו;",
                "> הבל ינחמון.",
                "> על כן נסעו כמו צאן,",
                "> יענו כי אין רועה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"חרה אפי ברועים,",
                "> ופקדתי על העתודים;",
                "> כי פקד יְהוה צבאות את עדרו, בית יהודה,",
                "> ושם אותם כסוס הודו במלחמה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ממנו פינה תצא,",
                "> ממנו יתד,",
                "> ממנו קשת מלחמה,",
                "> ממנו יצא כל נוגש יחדו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> והיו כגיבורים,",
                "> בוסים בטיט חוצות במלחמה;",
                "> ונלחמו כי יְהוה עמם;",
                "> והבישו רוכבי סוסים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> וגברתי את בית יהודה,",
                "> ואת בית יוסף אושיע,",
                "> והשיבותים,",
                "> כי רחמתים;",
                "> והיו כאשר לא זנחתים,",
                "> כי אני יְהוה אלהיהם ואענם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והיה אפרים כגיבור,",
                "> ושמח לבם כמו מיין;",
                "> ובניהם יראו ושמחו,",
                "> יגל לבם בַּיְהוה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אשְרקה להם ואקבצם,",
                "> כי פדיתים;",
                "> ורבו כמו רבו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> וזרעתים בעמים,",
                "> ובמרחקים יזכרוני,",
                "> וחיו את בניהם ושבו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> והשיבותים מארץ מצרים",
                "> ומאשור אקבצם;",
                "> והביאותים אל ארץ גלעד ולבנון",
                "> ולא ימצא להם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ועבר בים צרה,",
                "> והכה בים גלים",
                "> והובשו כל מצולות יאור;",
                "> והורד גאון אשור,",
                "> ושבט מצרים יסור."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> וגברתי אותם בַּיְהוה,",
                "> ובשמו יתהלכו,\" נאום יְהוה."
            ]
        }
    ]
}