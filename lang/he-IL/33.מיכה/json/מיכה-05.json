{
    "book": "מיכה",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> עתה התגודדי בת גְדוּד;",
                "> מצור שמו עלינו;",
                "> בשבט יכו על הלחי",
                "> את שופט ישראל."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"ואתה, בית לחם, בארץ יהודה,",
                "> אינך הקטנה בין אלפי יהודה;",
                "> כי ממך ייצא מושל אשר ירעה את עמי ישראל.",
                "> ומוצאיו מקדם,",
                "> מימי עולם.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> לכן ייתן אותם עד עת",
                "> יולדה ילדה.",
                "> וישוב יתר אחיו",
                "> על בני ישראל."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ועמד ורעה בעוז ה'",
                "> בגאון שם ה' אלוהיו.",
                "> וישבו,",
                "> כי עתה יגדל",
                "> עד אפסי ארץ."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> והיה זה שלום.",
                "> כי יבוא אשור בארצנו,",
                "> וכי ידרוך בארמנותינו,",
                "> והקמנו עליו",
                "> שבעה רועים ושמונה נסיכי אדם."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ורעו את ארץ אשור בחרב,",
                "> ואת ארץ נמרוד בפתחיה;",
                "> והצילנו מאשור",
                "> כי יבוא בארצנו",
                "> וכי ידרוך בגבולנו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והיה שארית יעקב",
                "> בקרב עמים רבים",
                "> כטל מאת ה',",
                "> כרביבים עלי עשב",
                "> אשר לא יקווה לאיש",
                "> ולא ייחל לבני אדם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> והיה שארית יעקב",
                "> בגויים,",
                "> בקרב עמים רבים",
                "> כאריה בבהמות יער,",
                "> ככפיר בעדרי צאן,",
                "> אשר אם יעבור,",
                "> ורמס וטרף,",
                "> ואין מציל."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> תרום ידך על צריך,",
                "> וכל אויביך ייכרתו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "\"והיה ביום ההוא,\" נאום ה',",
                "> \"והכרתי סוסיך מקרבך",
                "> והאבדתי מרכבותיך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> והכרתי ערי ארצך",
                "> והרסתי כל מבצריך."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והכרתי כשפים מידיך,",
                "> ומעוננים לא יהיו לך."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> והכרתי פסיליך",
                "> ומצבותיך מקרבך,",
                "> ולא תשתחווה עוד",
                "> למעשה ידיך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ונתשתי אשריך מקרבך",
                "> והשמדתי עריך."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ועשיתי באף ובחמה נקם",
                "> בגויים אשר לא שמעו.\""
            ]
        }
    ]
}