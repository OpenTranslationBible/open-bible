{
    "book": "מיכה",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "שמעו נא את אשר ה' אומר:",
                "> \"קום, ריב את ריבך לפני ההרים,",
                "> וישמעו הגבעות קולך.\""
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמעו הרים את ריב ה',",
                "> והאיתנים מוסדי ארץ,",
                "> כי ריב לה' עם עמו,",
                "> ועם ישראל יתוכח."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> עמי, מה עשיתי לך,",
                "> ומה הלאתיך? ענה בי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי העליתיך מארץ מצרים,",
                "> ומבית עבדים פדיתיך,",
                "> ואשלח לפניך את משה, אהרן ומרים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> עמי, זכור נא",
                "> מה יעץ בלק מלך מואב,",
                "> ומה ענה אותו בלעם בן בעור,",
                "> מן השיטים עד הגלגל,",
                "> למען דעת צדקות ה'.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "> במה אקדם ה'",
                "> אכף לאלוהים מרום?",
                "> האקדמנו בעולות,",
                "> בעגלים בני שנה?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הירצה ה' באלפי אילים,",
                "> ברבבות נחלי שמן?",
                "> האתן בכורי פשעי,",
                "> פרי בטני חטאת נפשי?"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> הגיד לך אדם מה טוב;",
                "> ומה ה' דורש ממך",
                "> כי אם עשות משפט, ואהבת חסד,",
                "> והצנע לכת עם אלוהיך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> קול ה' לעיר יקרא—",
                "> ותושיה יראה שמך:",
                "> \"שמעו מטה ומי יעדה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> העוד אִש בֵּית רשע,",
                "> אוצרות רשע,",
                "> ואיפת רזון זעומה?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> האזכה במאזני רשע,",
                "> ובכיס אבני מרמה?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי עשיריה מלאו חמס,",
                "> ויושביה דברו שקר,",
                "> ולשונם רמיה בפיהם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> וגם אני החליתי להכותך,",
                "> השמם על חטאתיך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אתה תאכל ולא תשבע,",
                "> ויֶשַחְךָ בקרבך.",
                "> ותסג ולא תפליט,",
                "> ואשר תפלט לחרב אתן."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אתה תזרע ולא תקצור.",
                "> תדרך זית ולא תסוך שמן;",
                "> ותירוש ולא תשתה יין."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> וישמרו חקות עמרי",
                "> וכל מעשה בית אחאב,",
                "> ותלכו במעצותיהם.",
                "> למען תתן אותך לשמה,",
                "> ויושבי העיר לשרקה,",
                "> ותשא חרפת עמי.\""
            ]
        }
    ]
}