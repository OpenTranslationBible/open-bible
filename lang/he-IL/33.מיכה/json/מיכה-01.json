{
    "book": "מיכה",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "דבר ה' אשר היה אל מיכה המורשתי בימי יותם, אחז, יחזקיהו, מלכי יהודה, אשר חזה על שומרון וירושלים."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמעו עמים כולם;",
                "> הקשיבי ארץ ומלואה,",
                "> ויהי אדוני ה' בכם לעד,",
                "> אדוני מהיכל קדשו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי הנה ה' יוצא ממקומו,",
                "> וירד ודרך על במותי ארץ."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ונמסו ההרים תחתיו,",
                "> והעמקים יתבקעו כשעוה מפני האש,",
                "> כמים מוגרים במורד."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> בכל זאת מפשע יעקב",
                "> ומחטאות בית ישראל.",
                "> מי פשע יעקב? הלא שומרון?",
                "> ומה במות יהודה? הלא ירושלים?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ושמתי שומרון לעי השדה,",
                "> למטעי כרם.",
                "> והגרתי אבניה בעמק,",
                "> ויסדיה אגלה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> וכל פסיליה יכתו,",
                "> וכל אתנניה ישרפו באש,",
                "> וכל עצביה אשים שממה;",
                "> כי מאתנן זונה קבצה,",
                "> ועד אתנן זונה ישובו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> על זאת אספדה ואילילה,",
                "> אלכה שולל וערום;",
                "> אעשה מספד כתנים,",
                "> ואבל כבנות יענה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אנושה מכותיה,",
                "> כי באה עד יהודה;",
                "> נגעה עד שער עמי,",
                "> עד ירושלים."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> בגת אל תגידו,",
                "> בכו אל תבכו.",
                "> בבית לעפרה עפר התפלשי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> עברי לכם, יושבת שפר, עריה בשת.",
                "> לא יצאה יושבת צאנן.",
                "> מספד בית האצל: \"יקח מכם עמדתו.\""
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי חלה למררה",
                "> הטובה כי ירד ה'",
                "> לשער ירושלים."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> רתמי המרכבה, יושבת לכיש—",
                "> ראשית חטאת",
                "> היא לבת ציון—",
                "> כי בך נמצאו",
                "> פשעי ישראל."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> לכן תשלחי שלוחים",
                "> על מורשת גת;",
                "> בתי אכזיב לאכזב",
                "> למלכי ישראל."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עוד אביא לך",
                "> היורש,",
                "> יושבת מרשה.",
                "> עד עדלם יבוא",
                "> כבוד ישראל."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> קרחי וגזי על בני תענוגיך;",
                "> הרחיבי קרחתך כנשר,",
                "> כי גלו ממך."
            ]
        }
    ]
}