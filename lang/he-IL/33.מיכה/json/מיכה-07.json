{
    "book": "מיכה",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> אוי לי! כי הייתי",
                "> כאסיפת קיץ, כעוללות בציר:",
                "> אין אשכול לאכול,",
                "> בכורה אותה נפשי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אבד חסיד מן הארץ,",
                "> ואין ישר באדם.",
                "> כולם אורבים לדם;",
                "> איש את רעהו יצודו ברשת."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> על הרע כפים היטיבו.",
                "> השר שואל והשופט בשוחד,",
                "> והגדול דבר הוות נפשו—",
                "> ויעבתוה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> טובם כחדק,",
                "> ישר ממסוכה.",
                "> יום מצפיך פקודתך באה,",
                "> עתה תהיה מבוכתם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אל תאמינו ברע;",
                "> אל תבטחו באלוף.",
                "> משוכבת חיקך",
                "> שמור פתחי פיך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי בן מנבל אב,",
                "> בת קמה באמה,",
                "> כלה בחמותה;",
                "> אויבי איש אנשי ביתו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ואני בה' אצפה;",
                "> אוחילה לאלוהי ישעי.",
                "> ישמעני אלוהי."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אל תשמחי אויבתי לי.",
                "> כי נפלתי קמתי;",
                "> כי אשב בחושך, ה' אור לי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> זעם ה' אשא",
                "> כי חטאתי לו,",
                "> עד אשר יריב ריבי ועשה משפטי.",
                "> יוציאני לאור,",
                "> אראה בצדקתו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ותרא אויבתי,",
                "> ותכסה בושה האומרת אלי,",
                "> \"איה ה' אלוהיך?\"",
                "> עיני תראינה בה;",
                "> עתה תהיה למרמס",
                "> כטיט חוצות."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> יום לבנות גדרותיך.",
                "> יום ההוא ירחק חוק."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> יום הוא ויבוא עדיך",
                "> מאשור וערי מצרים,",
                "> וממצרים ועד הנהר,",
                "> וים מים והר מהר."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> והיתה הארץ לשממה על יושביה,",
                "> מפרי מעלליהם."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> רעה עמך בשבטך,",
                "> צאן נחלתך",
                "> שכני לבדד יער,",
                "> בתוך כרמל.",
                "> ירעו בשן וגלעד",
                "> כימי עולם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כימי צאתך מארץ מצרים,",
                "> אראנו נפלאות."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> יראו גויים ויבושו",
                "> מכל גבורתם.",
                "> ישימו יד על פה,",
                "> אזניהם תחרשנה."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ילחכו עפר כנחש,",
                "> כזוחלי ארץ.",
                "> ירגזו ממסגרותיהם;",
                "> אל ה' אלוהינו יפחדו,",
                "> ויראו ממך."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> מי אל כמוך,",
                "> נושא עוון ועובר על פשע לשארית נחלתו?",
                "> לא החזיק לעד אפו,",
                "> כי חפץ חסד הוא."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ישוב ירחמנו;",
                "> יכבוש עוונותינו.",
                "> ותשליך במצולות ים",
                "> כל חטאותם."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> תתן אמת ליעקב",
                "> חסד לאברהם,",
                "> אשר נשבעת לאבותינו",
                "> מימי קדם."
            ]
        }
    ]
}