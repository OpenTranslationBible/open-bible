{
    "book": "מיכה",
    "chapter": 4,
    "verses": [
        {
            "verse": 1,
            "text": [
                "והיה באחרית הימים",
                "> יהיה הר בית ה' נכון בראש ההרים",
                "> ונישא הוא מגבעות,",
                "> ונהרו אליו עמים."
            ]
        },
        {
            "verse": 2,
            "text": [
                "והלכו גויים רבים ואמרו,",
                "> \"לכו ונעלה אל הר ה'",
                "> ואל בית אלוהי יעקב,",
                "> ויורנו מדרכיו",
                "> ונלכה באורחותיו.\"",
                "> כי מציון תצא תורה,",
                "> ודבר ה' מירושלים."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ושפט בין עמים רבים",
                "> והוכיח לגויים עצומים רחוקים.",
                "> וכתתו חרבותיהם לאתים",
                "> וחניתותיהם למזמרות;",
                "> לא ישא גוי אל גוי חרב,",
                "> ולא ילמדו עוד מלחמה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> וישבו איש תחת גפנו",
                "> ותחת תאנתו,",
                "> ואין מחריד,",
                "> כי פי ה' צבאות דיבר."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי כל העמים ילכו",
                "> איש בשם אלוהיו,",
                "> ואנחנו נלך",
                "> בשם ה' אלוהינו לעולם ועד."
            ]
        },
        {
            "verse": 6,
            "text": [
                "\"ביום ההוא,\" נאום ה',",
                "> \"אאסף את הצולעה",
                "> ואקבץ את הנדחה,",
                "> אשר הרעותי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ושמתי את הצולעה לשארית,",
                "> והנהלאה לגוי עצום,",
                "> ומלך ה' עליהם בהר ציון",
                "> מעתה ועד עולם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ואתה, מגדל עדר,",
                "> עופל בת ציון,",
                "> עדיך תבוא—",
                "> ובאה הממלכה הראשונה,",
                "> ממלכת בת ירושלים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> עתה למה תריעי רע?",
                "> המלך אין בך,",
                "> אם יועצך אבד,",
                "> כי אחזך חיל כיולדה?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> חולי וגוחי, בת ציון,",
                "> כיולדה;",
                "> כי עתה תצאי מהעיר,",
                "> ושכנת בשדה,",
                "> ובאת עד בבל.",
                "> שם תנצלי,",
                "> שם יגאלך ה'",
                "> מכף אויביך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ועתה נאספו עליך גויים רבים",
                "> האומרים, \"תחנף,",
                "> ותרא עינינו בציון!\""
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והם לא ידעו מחשבות ה',",
                "> ולא הבינו עצתו;",
                "> כי קבצם כעמיר לגרנה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> קומי ודושי, בת ציון,",
                "> כי קרנך אשים ברזל,",
                "> ופרסותיך אשים נחושה,",
                "> והדקת עמים רבים,",
                "> והחרמתי לה' בצעם,",
                "> וחילם לאדון כל הארץ."
            ]
        }
    ]
}