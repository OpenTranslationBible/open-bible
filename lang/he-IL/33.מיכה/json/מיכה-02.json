{
    "book": "מיכה",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הוי חושבי און ופועלי רע על משכבותם!",
                "> באור הבוקר יעשוה,",
                "> כי יש לאל ידם."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> וחמדו שדות וגזלו,",
                "> ובתים ונשאו;",
                "> ועשקו גבר וביתו,",
                "> ואיש ונחלתו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> לכן כה אמר ה':",
                "> \"הנני חושב על המשפחה הזאת רעה",
                "> אשר לא תסירו ממנה את צואריכם;",
                "> ולא תלכו רוממות,",
                "> כי עת רעה היא."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ביום ההוא ישא עליכם משל",
                "> ונהה נהי נהיה ואמר,",
                "> 'שדוד נשדדנו!",
                "> חלק עמי ימיר;",
                "> איך ימיש ממני!",
                "> לשובב יחלק שדותינו.'"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לכן לא יהיה לך משליך חבל בגורל",
                "> בקהל ה'."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 'אל תטיפו,' יטיפו.",
                "> אם לא יטיפו לאלה,",
                "> לא יסור כלימה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> האמור בית יעקב:",
                "> \"התקצר רוח ה'?",
                "> אלה מעלליו?\"",
                "> הלא דברי ייטיבו",
                "> עם הישר הולך?"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ואתמול עמי כאויב יקומם—",
                "> מעל שלמה תפשיטון",
                "> עברי בטח,",
                "> שובי מלחמה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> נשי עמי תגרשון",
                "> מבית תענוגיהן.",
                "> מעל עלליהן תקחו הדרי",
                "> לעולם."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> קומו ולכו,",
                "> כי לא זאת המנוחה",
                "> בגלל הטומאה המשחיתה,",
                "> חורבן מכאיב."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> לו היה הולך רוח ושקר כזב,",
                "> \"אטיף לך ליין ולשכר,\"",
                "> והיה מטיף לעם הזה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אסף אאסף יעקב כלך,",
                "> קבץ אקבץ שארית ישראל.",
                "> יחד אשימם כצאן בצרה;",
                "> כעדר בתוך הדבר",
                "> תהימנה מאדם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> עלה הפורץ לפניהם;",
                "> פרצו ויעברו שער ויצאו בו.",
                "> ויעבר מלכם לפניהם,",
                "> וה' בראשם.\""
            ]
        }
    ]
}