{
    "book": "יואל",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "דבר ה' אשר היה אל יואל בן פתואל."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמעו זאת, הזקנים,",
                "> והאזינו כל יושבי הארץ.",
                "> האם קרה דבר כזה בימיכם",
                "> או בימי אבותיכם?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ספרו זאת לבניכם,",
                "> ויגידו לבניהם,",
                "> ובניהם לדור אחר."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יתר הגזם אכל הארבה;",
                "> יתר הארבה אכל הילק;",
                "> יתר הילק אכל החסיל."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הקיצו, שכורים, ובכו!",
                "> הילילו, כל שותי יין,",
                "> על עסיס,",
                "> כי נכרת מפיכם."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי גוי עלה על ארצי,",
                "> עצום ואין מספר;",
                "> שיניו שיני אריה",
                "> ומתלעות לביאה לו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שם גפני לשמה",
                "> ותאנתי לקצפה.",
                "> חשף חשפה והשליך,",
                "> הלבינו שריגיה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אלי כבתולה חגורת שק",
                "> על בעל נעוריה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> נכרת מנחה ונסך",
                "> מבית ה'.",
                "> אבלו הכהנים,",
                "> משרתי ה'."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> שדדה שדה,",
                "> אבלה אדמה;",
                "> כי שודד דגן,",
                "> הוביש תירוש,",
                "> אמלל יצהר."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הבישו אכרים,",
                "> הילילו כורמים,",
                "> על חיטה ועל שעורה,",
                "> כי אבד קציר שדה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הגפן הובישה",
                "> והתאנה אמללה;",
                "> רמון גם תמר ותפוח—",
                "> כל עצי השדה יבשו.",
                "> כי הבושה שמחה",
                "> מן בני אדם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> חגרו וספדו, הכהנים;",
                "> הילילו, משרתי מזבח.",
                "> באו לינו בשקים,",
                "> משרתי אלי,",
                "> כי נמנע מנחה ונסך",
                "> מבית אלוהיכם."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> קדשו צום;",
                "> קראו עצרה.",
                "> אספו זקנים",
                "> כל יושבי הארץ",
                "> בית ה' אלוהיכם,",
                "> וזעקו אל ה'."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אהה ליום!",
                "> כי קרוב יום ה';",
                "> ובא כשד משדי."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> הלא נגד עינינו נכרת אכל,",
                "> מבית אלוהינו שמחה וגיל?"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> עבשו פרודות תחת מגרפותיהם;",
                "> נשמו אוצרות,",
                "> נהרסו ממגרות,",
                "> כי הוביש דגן."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> מה נאנחה בהמה!",
                "> נבוכו עדרי בקר",
                "> כי אין מרעה להם;",
                "> גם עדרי הצאן נאשמו."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אליך ה', אקרא,",
                "> כי אש אכלה נאות מדבר",
                "> ולהבה להטה כל עצי השדה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> גם בהמות שדה תערוג אליך;",
                "> כי יבשו אפיקי מים,",
                "> ואש אכלה נאות המדבר."
            ]
        }
    ]
}