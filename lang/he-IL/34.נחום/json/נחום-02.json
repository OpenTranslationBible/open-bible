{
    "book": "נחום",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> עלה מפיץ על פניך.",
                "> נצור מצרה,",
                "> צפה דרך;",
                "> חזק מתניך,",
                "> אמץ מאוד כוחך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי שב יהוה את גאון יעקב",
                "> כגאון ישראל,",
                "> כי בקקים בקקום",
                "> ושחיתו זמורותם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> מגני גיבוריו מאדם,",
                "> אנשי חיל מתלעים,",
                "> ברק פלדות הרכב",
                "> ביום הכינו,",
                "> והברושים הרעלו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> בחוצות יתהוללו הרכב,",
                "> ישתקשקו ברחבות;",
                "> מראיהם כלפידים,",
                "> כברקים ירוצצו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יזכור אדיריו;",
                "> יכשלו בהלכם,",
                "> ימהרו חומתה,",
                "> והוכן הסכך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> שערי הנהרות נפתחו,",
                "> וההיכל נמוג."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והצב גלתה, הועלתה,",
                "> ואמהתיה מנהגות כקול יונים,",
                "> מתופפות על לבביהן."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ונינוה כברכת מים מימי היא,",
                "> והמה נסים;",
                "> \"עמדו, עמדו,\"",
                "> ואין מפנה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> בזהו כסף,",
                "> בזהו זהב!",
                "> ואין קצה לתכונה—",
                "> כבד מכל כלי חמדה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> בוקה ומבוקה ומבולקה!",
                "> ולב נמס וברכיים כשלו!",
                "> וחלחלה בכל מתנים!",
                "> ופני כלם קבצו פארור!"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> איה מעון אריות",
                "> ומרעה היא לכריאים,",
                "> אשר הלך אריה לביא שם,",
                "> גור אריה ואין מחריד."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> טרף אריה די גורתיו,",
                "> ומחנק ללביאותיו,",
                "> וימלא טרף חוריו",
                "> ומענותיו טרפה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> \"הנני אליך,\" נאם יהוה צבאות.",
                "> \"והבערתי בעשן רכבה,",
                "> וחרב תאכל כפיריך;",
                "> והכרתי מארץ טרפך,",
                "> ולא ישמע עוד קול מלאכיך.\""
            ]
        }
    ]
}