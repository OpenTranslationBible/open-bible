{
    "book": "חבקוק",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "תפילה של תחנון מאת חבקוק הנביא, על שיגיונות."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ה', שמעתי שמעך יראתי, ה'.",
                "> חיה אותם בקרב שנים,",
                "> בקרב שנים תודיע;",
                "> ברוגז רחם תזכור."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אלוהים בא מתימן,",
                "> וקדוש מהר פארן. סלה",
                "> כבודו כיסה שמים,",
                "> ותהילתו מלאה הארץ."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ונוגה כאור תהיה;",
                "> קרנים מידו לו,",
                "> ושם חביון עוזו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לפניו ילך דבר,",
                "> ויצא רשף לרגליו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> עמד וימודד ארץ;",
                "> ראה ויתר גויים.",
                "> ויתפוצצו הררי עד,",
                "> שחו גבעות עולם.",
                "> הליכות עולם לו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> תחת און כושן ראיתי,",
                "> ירגזון יריעות ארץ מדין."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> הבנהרות חרה ה',",
                "> אם בנהרים אפך,",
                "> אם בים עברתך,",
                "> כי תרכב על סוסיך,",
                "> מרכבות ישועתך?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> עריה תעור קשתך,",
                "> שבעות מטות אמר סלה.",
                "> נהרות תבקע ארץ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ראוך יחילו הרים;",
                "> זרם מים עבר.",
                "> נתן תהום קולו,",
                "> רום ידיו נשא."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> שמש ירח עמד זבולה;",
                "> לאור חציך יהלכו,",
                "> לנוגה ברק חניתך."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> בזעם תצעד ארץ;",
                "> באף תדוש גויים."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יצאת לישע עמך,",
                "> לישע את משיחך.",
                "> מחצת ראש מבית רשע,",
                "> ערות יסוד עד צואר סלה."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> נקבת במטיו ראש פרזו;",
                "> יסערו להפיצני,",
                "> עליצותם כמו לאכול עני בסתר."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> דרכת בים סוסיך,",
                "> חמר מים רבים."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> שמעתי ותרגז בטני;",
                "> לקול צללו שפתי.",
                "> רקב בעצמי יבא,",
                "> ותחתיי ארגז.",
                "> אשר אנוח ליום צרה,",
                "> לעלות לעם יגודנו."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי תאנה לא תפרח,",
                "> ואין יבול בגפנים;",
                "> כחש מעשה זית,",
                "> ושדמות לא עשה אכל;",
                "> גזר ממכלה צאן,",
                "> ואין בקר ברפתים."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ואני בה' אעלוזה,",
                "> אגילה באלוהי ישעי."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ה' אדוני חילי;",
                "> וישם רגלי כאילות,",
                "> ועל במותי ידרכני.",
                "למנצח בנגינותי."
            ]
        }
    ]
}