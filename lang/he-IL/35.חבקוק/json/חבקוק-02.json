{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> על משמרתי אעמודה",
                "> ואתייצבה על מצור;",
                "> ואצפה לראות מה ידבר בי,",
                "> ומה אשיב על תוכחתי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "ויענני ה' ויאמר,",
                "> כתוב חזון זה",
                "> ברור על הלוחות,",
                "> למען ירוץ קורא בו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי עוד חזון למועד,",
                "> ויפח לקץ ולא יכזב.",
                "> אם יתמהמה חכה לו;",
                "> כי בא יבא, לא יאחר."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הנה עפל לא ישרה נפשו בו;",
                "> וצדיק באמונתו יחיה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ואף כי היין בוגד גבר יהיר,",
                "> ולא ינוח.",
                "> הרחיב כשאול נפשו,",
                "> והוא כמות ולא ישבע.",
                "> ויאסף אליו כל הגוים",
                "> ויקבץ אליו כל העמים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "הלוא אלה כולם עליו משל ישאו,",
                "> ומליצה חידות לו ואמרו,",
                "> הוי המרבה לא לו—",
                "> עד מתי—",
                "> ומכביד עליו עבטיט!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הלוא פתע יקומו נשכיך,",
                "> ויקיצו מזעזעיך?",
                "> והיית למשסה להם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כי אתה שלות גוים רבים,",
                "> ישלוך כל יתר עמים—",
                "> מדמי אדם וחמס ארץ,",
                "> קריה וכל ישביה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> הוי בצע בצע רע לביתו,",
                "> לשום במרום קנו,",
                "> להנצל מכף רע!"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יעצת בושת לביתך",
                "> קצות עמים רבים;",
                "> וחוטא נפשך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי אבן מקיר תזעק,",
                "> וכפיס מעץ יעננה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הוי בונה עיר בדמים,",
                "> וכונן קריה בעולה!"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> הלוא הנה מאת ה' צבאות",
                "> ויגעו עמים בדי אש,",
                "> ולאמים בדי ריק ייעפו?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי תמלא הארץ",
                "> לדעת כבוד ה',",
                "> כמים יכסו על ים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הוי משקה רעהו מספח חמתך,",
                "> ואף שכר למען הביט על מערומיהם!"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> שבעת קלון מכבוד.",
                "> שתה גם אתה והערל;",
                "> תסוב עליך כוס ימין ה',",
                "> וקיקלון על כבודך."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי חמס לבנון יכסך,",
                "> ושד בהמות יחיתן,",
                "> מדמי אדם וחמס ארץ,",
                "> קריה וכל ישביה."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> מה הועיל פסל כי פסלו יצרו,",
                "> מסכה ומורה שקר?",
                "> כי בטח יצר יצרו",
                "> עליו לעשות אלילים אלמים."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> הוי אמר לעץ, הקיצה!",
                "> לאבן דומם, עור!",
                "> הורה הוא?",
                "> הנה הוא תפוש זהב וכסף,",
                "> וכל רוח אין בקרבו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> וה' בהיכל קדשו.",
                "> הס מפניו כל הארץ."
            ]
        }
    ]
}