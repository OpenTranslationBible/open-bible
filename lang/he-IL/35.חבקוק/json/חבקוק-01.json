{
    "book": "חבקוק",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "המשא אשר חזה הנביא חבקוק."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עד מתי, יהוה, שוועתי ולא תשמע?",
                "> אצעק אליך, \"חמס!\" ולא תושיע."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> למה תראני עָוֶן,",
                "> ועמל תביט?",
                "> ושֹד וחמס לנגדי,",
                "> ויהי ריב ומדון נשא."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> על כן תפוג תורה,",
                "> ולא יצא לנצח משפט.",
                "> כי רשע מכתיר את הצדיק,",
                "> על כן יצא משפט מעוקל."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ראו בגוים,",
                "> והביטו ותמהו תמהו.",
                "> כי פעל פועל בימיכם,",
                "> לא תאמינו כי יספר."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי הנני מקים את הכשדים,",
                "> הגוי המר והנמהר,",
                "> ההולך למרחבי ארץ",
                "> לרשת משכנות לא לו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אויה ונורא הוא;",
                "> ממנו משפטו ושאתו יצא."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> וקלו מנמרים סוסיו,",
                "> וחדו מזאבי ערב.",
                "> ופשו פרשיו,",
                "> ופרשיו ממרחק יבואו.",
                "> יעופו כנשר חש לאכול."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כלו לחמס יבוא,",
                "> מגמת פניהם קדימה.",
                "> ויאסף כעפר שביה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> והוא במלכים יתקלס,",
                "> ורוזנים משחק לו.",
                "> הוא לכל מבצר ישחק,",
                "> ויצבר עפר וילכדה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אז חלף רוח ויעבור.",
                "> ואשם זו כחו לאלוהו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הלוא אתה מקדם,",
                "> יהוה אלוהי קדושי?",
                "> לא נמות.",
                "> יהוה, למשפט שמתו,",
                "> וצור להוכיח יסדתו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> טהור עיניים מראות רע,",
                "> והביט אל עמל לא תוכל.",
                "> למה תביט בוגדים?",
                "> תחריש בבלע רשע",
                "> צדיק ממנו?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ותעשה אדם כדגי הים,",
                "> כרמש לא מושל בו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כלה בחכה העלה,",
                "> יגרהו בחרמו,",
                "> ויאספהו במכמרתו;",
                "> על כן ישמח ויגיל."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> על כן יזבח לחרמו,",
                "> ויקטר למכמרתו;",
                "> כי בהם שמן חלקו,",
                "> ומאכלו בריא."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> העל כן יריק חרמו,",
                "> ותמיד להמית גוים לא יחמול?"
            ]
        }
    ]
}