{
    "book": "איוב",
    "chapter": 14,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"האדם, יולד מאישה,",
                "> חייו קצרים ומלאים בצרות."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כפרח, הוא עולה ונובל,",
                "> גם בורח כצל ואינו עומד."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> גם אתה משגיח עליו מקרוב",
                "> ומביא אותו למשפט איתך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מי יכול להביא טוהר מטומאה?",
                "> אין אף אחד!"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי ימיהם קבועים,",
                "> מספר חודשיהם ידוע לך;",
                "> ואתה קבעת גבולותיהם שלא יעברו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הסר עיניך מהם כדי שינוחו,",
                "> עד שיסיימו את יומם כשכיר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"כי יש תקווה לעץ,",
                "> אם ייכרת, שיצמח שוב,",
                "> ונצרו לא ייכשל."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אם שורשו יזקין בארץ,",
                "> וגזעו ימות בעפר יבש,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מריח מים יפרח",
                "> וישלח ענפים כשתיל צעיר."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אבל כשאדם מת ונשכב,",
                "> אדם חולף, ואיפה הוא?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כמים נעלמים מן הים,",
                "> ונהר מתייבש וצחיח,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כך אנשים נשכבים ולא קמים.",
                "> עד שהשמים לא יהיו עוד,",
                "> לא יתעוררו ולא יקומו משנתם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> \"הלוואי שתסתיר אותי בשאול,",
                "> שתכסה אותי עד שיעבור זעמך,",
                "> שתקבע לי זמן ותזכור אותי!"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אם אדם מת, האם יחיה שוב?",
                "> כל ימי צערי אצפה",
                "> עד שיבוא חידושי."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> תקרא, ואני אענה לך;",
                "> תשתוקק למעשי ידיך."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> כי כעת אתה סופר את צעדי,",
                "> אינך משגיח על חטאתי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> פשעי חתום בשק,",
                "> ואתה מכסה על עווני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> \"אבל הר מתמוטט ומתפורר,",
                "> וסלע נע ממקומו;"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> מים שוחקים אבנים,",
                "> שטפיהם סוחפים את עפר הארץ;",
                "> כך אתה ממעט תקוות אדם."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אתה מתגבר עליהם תדיר והם הולכים;",
                "> אתה משנה את מראיהם ומשלחם."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ילדיהם מגיעים לכבוד, אך אינם יודעים זאת;",
                "> או שהם נעשים חסרי ערך, והם אינם מבינים זאת."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אך גופם חש כאב,",
                "> ונפשם מתאבלת עליו.\""
            ]
        }
    ]
}