{
    "book": "איוב",
    "chapter": 30,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"ועתה שחקו עלי צעירים ממני,",
                "> אשר מאסתי אבותם לשום עם כלבי צאני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> גם כח ידיהם למה לי?",
                "> עלימו אבד כלח."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> בחסר ובכפן גלמוד,",
                "> הערקים ציה אמש שואה ומשואה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הקטפים מלוח עלי שיח,",
                "> ושרש רתמים לחמם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מן גו גרשו,",
                "> יריעו עלימו כגנב."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> בערוץ נחלים לשכון,",
                "> חרי עפר וכפים."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בין שיחים ינהקו,",
                "> תחת חרול יספחו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> בני נבל גם בני בלי שם,",
                "> נכאו מן הארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ועתה הייתי להם לשיר,",
                "> ואהי להם למלה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> תעבוני רחקו מני,",
                "> ומפני לא חשכו רק."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי יתרו פתח ויענני,",
                "> ורסן מפני שלחו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> על ימין פרחח יקומו,",
                "> רגלי שלחו ויסולו עלי אורחות אידם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> נתסו נתיבתי,",
                "> להותי יועילו,",
                "> לא עזר למו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כפרץ רחב יבאו,",
                "> תחת שואה התגלגלו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> נהפך עלי בלהות,",
                "> תרדף כרוח נדיבתי,",
                "> וכעב עברה ישועתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ועתה עלי תשתפך נפשי,",
                "> יאחזוני ימי עני."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> לילה עצמי נקר מעלי,",
                "> ועורקי לא ישכבון."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ברב כח יתחפש לבושי,",
                "> כפי כתנתי יאזרני."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> השליךני לטיט,",
                "> ואשוה כעפר ואפר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אשוע אליך ולא תענני,",
                "> עמדתי ותתבונן בי."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> תהפך לאכזר לי,",
                "> בעצם ידך תשטמני."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> תשאני אל רוח תרכיבני,",
                "> ותמוגגני תשוה."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> כי ידעתי מוות תשיבני,",
                "> ובית מועד לכל חי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> אך לא בשלוח יד אלי שוע,",
                "> אם בפידו להם שוע."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> אם לא בכיתי לקשה יום,",
                "> עגמה נפשי לאביון."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> כי טוב קויתי ויבא רע,",
                "> ואיחלה לאור ויבא אפל."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> מעי רתחו ולא דמו,",
                "> קדמני ימי עני."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> קדר הלכתי בלי חמם,",
                "> קמתי בקהל אשוע."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> אח הייתי לתנים,",
                "> ורע לבנות יענה."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> עור שחור מעלי,",
                "> ועצמי חרה מני חם."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> ויהי לאבל כנורי,",
                "> ועוגבי לקול בוכים."
            ]
        }
    ]
}