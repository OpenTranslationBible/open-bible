{
    "book": "איוב",
    "chapter": 39,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"הידעת עת לדת יעלי סלע?",
                "> חולל אילות תשמור?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> תספור ירחים תמלאנה,",
                "> וידעת עת לדתנה?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> תכרענה ילדיהן,",
                "> תחוללנה חבליהן תשלחנה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יברו בניהם, יגדלו בשדה,",
                "> יצאו ולא ישובו להם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מי שלח פרא חופשי,",
                "> ומוסרות ערוד מי פתח,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אשר שמתי ערבה ביתו,",
                "> ומשכנותיו ארץ מלח?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ישחק להמון קריה,",
                "> תשאות נוגש לא ישמע."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> יתור הרים מרעהו,",
                "> ואחר כל ירוק ידרוש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> הירצה רים עבדך,",
                "> אם ילין אבוסך?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> התקשר רים בתלם עבותו,",
                "> אם ישדד עמקים אחריך?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> התבטח בו כי רב כחו,",
                "> ותעזוב אליו יגיעך?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> התאמין בו כי ישיב זרעך,",
                "> וגרנך יאסוף?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> \"כנף רננים נעלסה,",
                "> אם אברה חסידה ונוצה,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי תעזוב לארץ ביציה,",
                "> ועל עפר תחמם,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ותשכח כי רגל תזורה,",
                "> וחית השדה תדושנה."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> הקשיח בניה ללא לה,",
                "> לריק יגיעה בלי פחד,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי השה אלוה חכמה,",
                "> ולא חלק לה בבינה."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> כעת במרום תמריא,",
                "> תשחק לסוס ולרכבו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> \"התתן לסוס גבורה,",
                "> התלביש צווארו רעמה?"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> התרעישנו כארבה?",
                "> הוד נחרו אימה."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> יחפר בעמק וישיש בכח,",
                "> יצא לקראת נשק."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ישחק לפחד ולא יחת,",
                "> ולא ישוב מפני חרב."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> עליו תשחק אשפה,",
                "> להב חנית וכידון."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ברעש ורוגז יגמא ארץ,",
                "> ולא יאמין כי קול שופר."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> בדי שופר יאמר האח,",
                "> ומרחוק יריח מלחמה,",
                "> רעם שרים ותרועה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> \"הבינתך יאבר נץ,",
                "> יפרוש כנפיו לתימן?"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> אם על פיך יגביה נשר,",
                "> כי ירים קנו?"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> סלע ישכון ויתלונן,",
                "> על שן סלע ומצודה."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> משם חפר אכל,",
                "> למרחוק עיניו יביטו."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> ואפרוחיו יעלעו דם,",
                "> ובאשר חללים שם הוא.\""
            ]
        }
    ]
}