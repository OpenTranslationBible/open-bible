{
    "book": "איוב",
    "chapter": 10,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"בנפשי אקוץ בחיי;",
                "> את תלונתי אשפוך בחופשיות;",
                "> אדבר במרירות נפשי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אומר לאל, 'אל תחרימני;",
                "> עזור לי להבין מדוע אתה מאשים אותי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> האם נכון לך לדכא,",
                "> לדחות את מעשה ידיך,",
                "> ולהביט בעין טובה על תכנית הרשעים?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> האם יש לך עיניים כבשר ודם,",
                "> או שאתה רואה כפי שהאנושות רואה?"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> האם ימיך כימי אנוש,",
                "> או שנותיך כשנות אדם,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> שאתה מחפש את עוונותיי",
                "> ובוחן את כל חטאיי?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אף שאתה יודע שאיני אשם,",
                "> ואין מי שיצילני מידך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 'ידיך עיצבו אותי ועשו אותי,",
                "> ועתה תהפוך להשמידני?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> זכור כי כעפר עשיתני;",
                "> ותחזירני לעפר שוב?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> האם לא יצרתני כחלב,",
                "> והקרשתני כגבינה;"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כיסיתני בעור ובשר,",
                "> ותארגני בעצמות וגידים?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> חננתני חיים וחסד;",
                "> ופיקודך שמרה רוחי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אך את אלה הסתרת בלבך;",
                "> ידעתי כי זה אצלך:"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אם אחטא, אז תשים לב אליי,",
                "> ולא תנקני מעווני."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אם רשע אני, אוי לי!",
                "> ואם צדיק אני, לא אוכל להרים ראשי.",
                "> מלאתי כלימה, ומודע לצרתי."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אם יגבה ראשי, תצוד אותי כאריה,",
                "> ושוב תראה את כוחך נגדי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> תחדש עדי בך",
                "> ותרבה זעמך עליי;",
                "> צרה אחר צרה תבוא עליי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> למה אפוא הוצאתני מרחם?",
                "> לו מתתי, ועין לא ראתה אותי!"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> הייתי כאילו לא הייתי,",
                "> מובא מרחם לקבר.'"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> האם לא מעט ימיי?",
                "> חדל, עזוב אותי, כדי שיהיה לי מעט שמחה"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> לפני שאלך ולא אשוב—",
                "> אל ארץ חושך וצלמות,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ארץ עיפתה כמו חושך עצמו,",
                "> צלמות בלי סדר,",
                "> שגם האור בה כמו חושך.\""
            ]
        }
    ]
}