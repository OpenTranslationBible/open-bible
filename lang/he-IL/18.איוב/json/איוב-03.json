{
    "book": "איוב",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "לאחר האירועים הללו, איוב דיבר והתאבל על יום הולדתו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "ואמר:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"יאבד יום הולדתי,",
                "> והלילה שאמר, 'הנה נולד בן.'"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יהי היום ההוא חושך;",
                "> אלוהים ממעל אל ידרוש אותו,",
                "> ואל יזרח עליו אור."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ידרשו אותו חושך וצלמות;",
                "> תשכון עליו עננה;",
                "> יבעתוהו כמרירי יום."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הלילה ההוא, ייקחהו אופל;",
                "> אל ייחשב בימי שנה,",
                "> ובחודשים אל יבוא."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הנה, הלילה ההוא יהיה עקר;",
                "> אל יבוא בו רננה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> יקללוהו מקללי יום,",
                "> העתידים עורר לויתן."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יחשכו כוכבי נשפו;",
                "> יקווה לאור ואין,",
                "> ואל יראה בעפעפי שחר,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי לא סגר דלתי בטני אמי,",
                "> ולא הסתיר עמל מעיני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> \"מדוע לא מתתי מרחם,",
                "> מבטן יצאתי ואגווע?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מדוע קדמוני ברכיים,",
                "> ומה שדים כי אינק?"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי עתה שכבתי ואשקוט;",
                "> ישנתי אז ינוח לי,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> עם מלכים ויועצי ארץ,",
                "> הבונים חרבות למו,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> או עם שרים זהב להם,",
                "> הממלאים בתיהם כסף."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> או כטמון נפל אעלם,",
                "> כעללים לא ראו אור."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> שם רשעים חדלו רגז,",
                "> ושם ינוחו יגיעי כח."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אסירים יחד שאננו;",
                "> לא שמעו קול נוגש."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> קטן וגדול שם הוא,",
                "> ועבד חפשי מאדוניו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> \"למה יתן לעמל אור,",
                "> וחיים למרי נפש,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> המייחלים למוות ואין,",
                "> ויחפרוהו ממטמונים,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> השמחים אלי גיל,",
                "> ישישו כי ימצאו קבר?"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> למה יתן לאיש דרכו נסתרה,",
                "> ויסך אלוה בעדו?"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> כי לפני לחמי אנחתי תבוא,",
                "> ויתכו כמים שאגתי."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> כי פחד פחדתי ויאתיני,",
                "> ואשר יגורתי יבוא לי."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> לא שלותי ולא שקטתי,",
                "> ולא נחתי ויבוא רוגז.\""
            ]
        }
    ]
}