{
    "book": "איוב",
    "chapter": 25,
    "verses": [
        {
            "verse": 1,
            "text": [
                "בלדד השוחי השיב ואמר,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"לשלו יש ממשלה ויראה",
                "> העושה שלום במרומיו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> היש מספר לצבאותיו?",
                "> ועל מי לא יזרח אורו?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ואיך יצדק אנוש עם אל?",
                "> ואיך יטהר ילוד אישה?"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הן הירח לא יאהיל",
                "> וכוכבים לא זכו בעיניו,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אף כי אנוש רימה,",
                "> ובן אדם תולעה!\""
            ]
        }
    ]
}