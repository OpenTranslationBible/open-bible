{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "בלדד השוחי השיב,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"עד מתי תדבר כאלה,",
                "> ודברי פיך יהיו כרוח עזה?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> האם אל מעוות משפט?",
                "> או שדי יעקם צדק?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אם בניך חטאו לו,",
                "> הוא מסרם ליד פשעם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אך אם תשחר אל,",
                "> ותחנן לרחמי שדי,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אם טהור וישר אתה,",
                "> ודאי יתעורר למענך",
                "> וישיב את מקומך בצדק."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ראשיתך קטנה נראתה,",
                "> אחריתך תשגשג מאוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"שאל נא לדורות ראשונים,",
                "> והתבונן במה שחקרו אבותם,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אנחנו מאתמול ולא נדע,",
                "> כי צל ימינו עלי ארץ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> האם לא יורוך וידברו לך,",
                "> יוציאו דברים מהבנתם?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> האם גומא יגדל בלי ביצה?",
                "> האם קנה ישגשג בלי מים?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> בעודו ירוק ולא ייקטף,",
                "> ייבש מהר מכל עשב."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כך דרכם של כל שוכחי אל;",
                "> תוחלת חסרי האל תובד."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> מבטחם רופף,",
                "> ובטחונם כקורי עכביש."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> יישען על ביתו ולא יעמוד;",
                "> יחזיק בו ולא יתקיים."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> הוא כצמח פורח בשמש,",
                "> שולח יונקותיו על הגן."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> שורשיו סובבים גל אבנים,",
                "> מחפש מקום בין הסלעים."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אך אם ייעקר ממקומו,",
                "> המקום יכחיש אותו, יאמר, 'לא ראיתיך.'"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> הנה זה ששון דרכו,",
                "> ומהאדמה יצמחו אחרים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> הנה, אל לא ימאס תם,",
                "> ולא יחזיק ביד מרעים."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> עוד ימלא שחוק פיך",
                "> ותשואות שפתיך."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> שונאיך ילבשו קלון,",
                "> ואוהל רשעים לא יהיה.\""
            ]
        }
    ]
}