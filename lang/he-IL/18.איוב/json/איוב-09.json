{
    "book": "איוב",
    "chapter": 9,
    "verses": [
        {
            "verse": 1,
            "text": [
                "איוב השיב ואמר,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"אכן ידעתי כי כן;",
                "> ומה יצדק אנוש עם אל?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אם יחפוץ לריב עמו,",
                "> לא יענהו אחת מני אלף."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> חכם לבב ואמיץ כח;",
                "> מי הקשה אליו וישלם?"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> המעביר הרים ולא ידעו,",
                "> אשר הפכם באפו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> המרגיז ארץ ממקומה,",
                "> ועמודיה יתפלצון."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> האומר לחרס ולא יזרח,",
                "> ובעד כוכבים יחתום."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> נוטה שמים לבדו",
                "> ודורך על במתי ים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> עשה עש כסיל וכימה,",
                "> וחדרי תימן."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> עשה גדולות עד אין חקר,",
                "> ונפלאות עד אין מספר."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הן יעבור עלי ולא אראה,",
                "> ויחלף ולא אבין לו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הן יחתוף מי ישיבנו?",
                "> מי יאמר אליו מה תעשה?"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אלוה לא ישיב אפו;",
                "> תחתיו שחו עזרי רהב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אף כי אנוכי אעננו,",
                "> אבחרה דברי עמו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אשר אם צדקתי לא אענה;",
                "> למשפטי אתחנן."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אם קראתי ויענני,",
                "> לא אאמין כי יאזין קולי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אשר בשער יסופני,",
                "> והרבה פצעי חנם."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> לא יתנני השב רוחי,",
                "> כי ישבעני ממרורים."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אם לכח אמיץ הוא;",
                "> ואם למשפט מי יועידני?"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אם אצדק פי ירשיעני;",
                "> תם אני ויעקשני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> תם אני לא אדע נפשי;",
                "> אמאס חיי."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אחת היא על כן אמרתי,",
                "> תם ורשע הוא מכלה."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> אם שוט ימית פתאם,",
                "> למסת נקים ילעג."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ארץ נתנה ביד רשע,",
                "> פני שופטיה יכסה;",
                "> אם לא אפוא מי הוא?"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> \"וימי קלו מני רץ;",
                "> ברחו לא ראו טובה."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> חלפו עם אניות אבה,",
                "> כנשר יטוש על אכל."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> אם אמרי אשכחה שיחי,",
                "> אעזבה פני ואבליגה,"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> יגורתי מכל עצבתי,",
                "> ידעתי כי לא תנקני."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> אנכי ארשע;",
                "> למה זה הבל איגע?"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> אם התרחצתי במו שלג",
                "> והזכותי בבר כפי,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> אז בשחת תטבלני,",
                "> ותעבוני שלמותי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> כי לא איש כמוני אעננו,",
                "> נבוא יחדו במשפט."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> לא יש בינינו מוכיח,",
                "> ישת ידו על שנינו."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> יסר מעלי שבטו,",
                "> ואמתו אל תבעתני."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> אדברה ולא איראנו,",
                "> כי לא כן אנכי עמדי."
            ]
        }
    ]
}