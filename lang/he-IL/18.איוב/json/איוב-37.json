{
    "book": "איוב",
    "chapter": 37,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"על זאת גם לבי יחרד,",
                "> ויתר ממקומו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמעו שמוע ברגז קולו,",
                "> והגה יוצא מפיו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> תחת כל השמים ישורנו,",
                "> ואורו על כנפות הארץ."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אחריו ישאג קול,",
                "> ירעם בקול גאונו,",
                "> ולא יעצרם כי ישמע קולו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ירעם אל בקולו נפלאות,",
                "> עשה גדולות ולא נדע."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי לשלג יאמר הוי ארץ,",
                "> וגם מטר גשם עזו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ביד כל אדם יחתום,",
                "> לדעת כל אנשי מעשהו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ותבא חיה במו-סתר,",
                "> ובמעונתה תשב."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מן החדר תבוא סופה,",
                "> וממזרים קרה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> מנשמת אל יתן קרח,",
                "> ורחב מים במוצק."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אף ברי יטריח עב,",
                "> יפיץ ענן אורו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והוא מסבב מתהפך בתחבולותיו,",
                "> לפעלם כל אשר יצום",
                "> על פני תבל ארצה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אם לשבט אם לארצו,",
                "> אם לחסד ימצאהו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> \"האזינה זאת איוב,",
                "> עמוד והתבונן נפלאות אל."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> התדע בשום אל עליהם,",
                "> והופיע אור עננו?"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> התבין על מפלאות עב,",
                "> נפלאות תמים דעים,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אשר בגדיך חמים,",
                "> בשקט ארץ מדרום?"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> תרקיע עמו לשחקים,",
                "> חזקים כראי מוצק?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> \"הודיענו מה נאמר לו;",
                "> לא נערוך מפני חשך."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> היסופר לו כי אדבר?",
                "> אם אמר איש כי יבלע?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ועתה לא ראו אור,",
                "> בהיר הוא בשחקים;",
                "> ורוח עברה ותטהרם."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> מצפון זהב יאתה,",
                "> על אלוה נורא הוד."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> שדי לא מצאנוהו שגיא כח,",
                "> ומשפט ורב צדקה לא יענה."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> לכן יראוהו אנשים;",
                "> לא יראה כל חכמי לב.\""
            ]
        }
    ]
}