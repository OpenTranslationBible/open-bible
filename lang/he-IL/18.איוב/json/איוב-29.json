{
    "book": "איוב",
    "chapter": 29,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ויוסף איוב שאת משלו ויאמר,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> מי יתנני כירחי קדם,",
                "> כימי אלוה ישמרני;"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> בהלו נרו עלי ראשי,",
                "> לאורו אלך חשך;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כאשר הייתי בימי חרפי,",
                "> בסוד אלוה עלי אהלי;"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> בעוד שדי עמדי,",
                "> סביבותי נערי;"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ברחץ הליכותי בחמאה,",
                "> וצור יצוק עמדי פלגי שמן!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בצאתי שער עלי קרת,",
                "> ברחוב אכין מושבי,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ראוני נערים ונחבאו,",
                "> וישישים קמו עמדו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> שרים עצרו במילים",
                "> וכף ידם לפיהם שמו;"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> קול נגידים נחבא,",
                "> ולשונם לחיכם דבקה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי אוזן שמעה ותאשרני,",
                "> ועין ראתה ותעידני,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי אמלט עני משווע,",
                "> ויתום ולא עזר לו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ברכת אובד עלי תבוא,",
                "> ולב אלמנה ארנין."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> צדק לבשתי וילבשני,",
                "> כמעיל וצניף משפטי."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עיניים הייתי לעיוור,",
                "> ורגליים לפיסח אני."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אב אנוכי לאביונים,",
                "> וריב לא ידעתי אחקורה."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ואשבר מתלעות עוול,",
                "> ומשיניו אשליך טרף."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ואומר, 'עם קני אגוע,",
                "> וכחול ארבה ימים."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> שורשי פתוחים אל המים,",
                "> וטל ילין בקצירי כל הלילה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> כבודי חדש עמי,",
                "> וקשתי בידי תחליף.'"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> לי שמעו וייחלו,",
                "> וידומו למועצתי."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אחרי דברי לא ישנו,",
                "> ועליהם תטוף מלתי."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> וייחלו כמטר לי,",
                "> ופיהם פערו למלקוש."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> אשחק אליהם לא יאמינו,",
                "> ואור פני לא יפילון."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> אבחר דרכם ואשב ראש,",
                "> ואשכון כמלך בגדוד,",
                "> כאשר אבלים ינחם."
            ]
        }
    ]
}