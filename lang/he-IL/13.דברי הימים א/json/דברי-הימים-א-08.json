{
    "book": "דברי הימים א",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "בנימין היה אב ל:",
                "> בלע בכורו, אשבל השני, אחרא השלישי,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> נוחה הרביעי, ורפא החמישי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "בני בלע כללו את:",
                "> אדר, גרא, אביהוד,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אבישוע, ונעמן, ואחוח,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> גרא, ושפופן, וחורם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "אלה הם צאצאי אהוד.",
                "הם היו ראשי המשפחות שגרו בגבע,",
                "> והם הוגלו למנחת:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כלומר, נעמן, אחיה, וגרא—הוא הוביל אותם לגלות.",
                "> והוא היה אב לעוזא ואחיהוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "שחרים הוליד ילדים בארץ מואב",
                "לאחר ששלח את חושים ובערה נשותיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "דרך חודש אשתו, היו לו:",
                "> יובב, צביה, מישע, מלכם,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יעוץ, שכיה, ומרמה.",
                "> אלה היו בניו, ראשי משפחותיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "עם חושים, הוליד:",
                "> אביטוב ואלפעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "בני אלפעל היו:",
                "> עבר, משעם, ושמד—שבנה את אונו ולוד עם עריהם—"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ובריעה ושמע, שהיו ראשי המשפחות",
                "> של תושבי אילון, שהבריחו את תושבי גת."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "אחיו, וששק, וירמות,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "וזבדיה, ערד, ועדר,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "מיכאל, וישפה, ויוחא היו בני בריעה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "זבדיה, ומשלם, חזקי, חבר,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ישמרי, ויזליה, ויובב היו בני אלפעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "עם יקים, וזכרי, וזבדי,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "אליעני, וצלתיי, ואליאל,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "עדיה, ובריה, ושמרת היו בני שמעי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ישפן, ועבר, ואליאל,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "עבדון, וזכרי, וחנן,"
            ]
        },
        {
            "verse": 24,
            "text": [
                "חנניה, ואלם, וענתותיה,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "יפדיה, ופנואל -בני ששק."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "שמשרי, ושחריה, ואתליה,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "יערשיה, ואליה, וזכרי היו בני ירחם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "אלה היו ראשי משפחות לפי דורותיהם,",
                "> אנשים חשובים שגרו בירושלים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "ועכשיו בגבעון, ייעיאל, אבי גבעון, גר,",
                "> ושם אשתו היה מעכה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "בנו הבכור היה עבדון, ואחריו צור, קיש, בעל, נדב,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "גדור, ואחיו, וזכר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "מכלות היה אב לשמע.",
                "> הם גם התגוררו עם קרוביהם בירושלים מול קרוביהם האחרים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "נר היה אב לשושלת קיש,",
                "> קיש היה אב לשאול,",
                "> שאול היה אב לנתן, מלכי-שוע, אבינדב, ואישבעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "בן יונתן היה מריב-בעל,",
                "> ומריב-בעל היה אב למיכה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "צאצאי מיכה היו:",
                "> פיתון, מלך, תרע, ואחז."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 36,
            "text": [
                "אחז היה אב ליהועדה,",
                "> ויהועדה היה אב לעלמת, עזמות, וזמרי;",
                "> וזמרי היה אב למוצא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "מוצא היה אב לבניה;",
                "רפא היה בנו,",
                "> אלעשה בנו,",
                "> אצל בנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "לאצל היו שישה בנים, ואלה שמותיהם:",
                "> עזריקם, בכרו, ישמעאל, שעיריה, עובדיה, וחנן.",
                "> כל אלה היו צאצאי אצל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "בני אשק כללו את:",
                "> אולם בכורו, יעוש השני, ואליפלט השלישי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "בני אולם היו לוחמים אמיצים מיומנים בקשת,",
                "> והיו להם בנים ונכדים רבים, 150 בסך הכל.",
                "> כל אלה היו בין צאצאי בנימין."
            ]
        }
    ]
}