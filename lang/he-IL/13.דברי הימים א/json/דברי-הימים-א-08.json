{
    "book": "דברי הימים א",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "בנימין היה אב ל:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "בני בלע כללו את:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "אלה הם צאצאי אהוד.",
                "הם היו ראשי המשפחות שגרו בגבע,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "שחרים הוליד ילדים בארץ מואב",
                "לאחר ששלח את חושים ובערה נשותיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "דרך חודש אשתו, היו לו:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "עם חושים, הוליד:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "בני אלפעל היו:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "אחיו, וששק, וירמות,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "וזבדיה, ערד, ועדר,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "מיכאל, וישפה, ויוחא היו בני בריעה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "זבדיה, ומשלם, חזקי, חבר,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ישמרי, ויזליה, ויובב היו בני אלפעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "עם יקים, וזכרי, וזבדי,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "אליעני, וצלתיי, ואליאל,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "עדיה, ובריה, ושמרת היו בני שמעי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ישפן, ועבר, ואליאל,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "עבדון, וזכרי, וחנן,"
            ]
        },
        {
            "verse": 24,
            "text": [
                "חנניה, ואלם, וענתותיה,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "יפדיה, ופנואל -בני ששק."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "שמשרי, ושחריה, ואתליה,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "יערשיה, ואליה, וזכרי היו בני ירחם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "אלה היו ראשי משפחות לפי דורותיהם,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "ועכשיו בגבעון, ייעיאל, אבי גבעון, גר,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "בנו הבכור היה עבדון, ואחריו צור, קיש, בעל, נדב,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "גדור, ואחיו, וזכר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "מכלות היה אב לשמע."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "נר היה אב לשושלת קיש,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "בן יונתן היה מריב-בעל,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "צאצאי מיכה היו:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 36,
            "text": [
                "אחז היה אב ליהועדה,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "מוצא היה אב לבניה;",
                "רפא היה בנו,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "לאצל היו שישה בנים, ואלה שמותיהם:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "בני אשק כללו את:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "בני אולם היו לוחמים אמיצים מיומנים בקשת,"
            ]
        }
    ]
}