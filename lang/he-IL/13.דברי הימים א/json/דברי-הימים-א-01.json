{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אדם, שת, ואנוש,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "קינן, מהללאל, וירד,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "חנוך, מתושלח, ולמך,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "נח, ובניו:",
                "> שם, חם, ויפת."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "בני יפת היו:",
                "> גומר, מגוג, מדי, יוון, תובל, משך, ותירס."
            ]
        },
        {
            "verse": 6,
            "text": [
                "בני גומר היו:",
                "> אשכנז, דיפת, ותוגרמה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "בני יוון היו:",
                "> אלישה, תרשיש, כתים, ורודנים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "בני חם היו:",
                "> כוש, מצרים, פוט, וכנען."
            ]
        },
        {
            "verse": 9,
            "text": [
                "בני כוש היו:",
                "> סבא, חוילה, סבתא, רעמה, וסבתכא.",
                "> ובני רעמה היו:",
                "> שבא ודדן."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כוש הוליד את נמרוד;",
                "> הוא החל להיות גיבור בארץ."
            ]
        },
        {
            "verse": 11,
            "text": [
                "מצרים הוליד את",
                "> לוד, ענם, להב, נפתוח,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> פתרוס, כסלוח (מהם יצאו פלשתים), וכפתור."
            ]
        },
        {
            "verse": 13,
            "text": [
                "כנען הוליד את",
                "> צידון בכורו, ואת חת,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "ואת היבוסי, האמורי, והגרגשי,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "ואת החוי, הארקי, והסיני,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "ואת הארודי, הצמרי, והחמתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "בני שם היו:",
                "> עילם, אשור, ארפכשד, לוד, וארם,",
                "> ובני ארם היו",
                "> עוץ, חול, גתר, ומשך."
            ]
        },
        {
            "verse": 18,
            "text": [
                "ארפכשד הוליד את שלח,",
                "ושלח הוליד את עבר."
            ]
        },
        {
            "verse": 19,
            "text": [
                "לעבר נולדו שני בנים:",
                "> האחד נקרא פלג, כי בימיו נפלגה הארץ;",
                "> ואחיו נקרא יקטן."
            ]
        },
        {
            "verse": 20,
            "text": [
                "בני יקטן היו:",
                "> אלמודד, שלף, חצרמות, וירח,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "הדורם, אוזל, ודקלה,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "עיבל, אבימאל, ושבא,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "אופיר, חוילה, ויובב.",
                "אלה כולם בני יקטן."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> שם, ארפכשד, ושלח,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> עבר, פלג, ורעו,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> שרוג, נחור, ותרח,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> ואברם, הוא אברהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> בני אברהם היו:",
                "> יצחק וישמעאל."
            ]
        },
        {
            "verse": 29,
            "text": [
                "אלה תולדותיהם:",
                "> בכור ישמעאל היה נביות, ואחריו קדר, אדבאל, ומבשם,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "משמע, דומה, משא, חדד, ותימא,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "יטור, נפיש, וקדמה.",
                "אלה היו בני ישמעאל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "בני קטורה, פילגש אברהם, שילדה:",
                "> זמרן, יקשן, מדן, מדין, ישבק, ושוח.",
                "> ובני יקשן היו:",
                "> שבא ודדן."
            ]
        },
        {
            "verse": 33,
            "text": [
                "בני מדין היו:",
                "> עיפה, עפר, חנוך, אבידע, ואלדעה.",
                "> אלה כולם בני קטורה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "אברהם הוליד את יצחק.",
                "> בני יצחק היו:",
                "> עשו וישראל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "בני עשו היו:",
                "> אליפז, רעואל, ויעוש; ילם, וקרח."
            ]
        },
        {
            "verse": 36,
            "text": [
                "בני אליפז היו:",
                "> תימן, אומר, צפי, געתם, קנז, תמנע, ועמלק."
            ]
        },
        {
            "verse": 37,
            "text": [
                "בני רעואל היו:",
                "> נחת, וזרח; שמא, ומזה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "בני שעיר היו:",
                "> לוטן, שובל, וצבעון; ענה, דישון, אצר, ודישן."
            ]
        },
        {
            "verse": 39,
            "text": [
                "בני לוטן היו:",
                "> חורי והומם; ותמנע הייתה אחות לוטן."
            ]
        },
        {
            "verse": 40,
            "text": [
                "בני שובל היו:",
                "> עלין, מנחת, עיבל, שפי, ואונם.",
                "> ובני צבעון היו:",
                "> איה וענה."
            ]
        },
        {
            "verse": 41,
            "text": [
                "בן ענה היה:",
                "> דישון.",
                "> ובני דישון היו:",
                "> חמרא, ישבן, יתרן, וכרן."
            ]
        },
        {
            "verse": 42,
            "text": [
                "בני אצר היו:",
                "> בלהן, זעון, ויעקן.",
                "> ובני דישן היו:",
                "> עוץ וארן."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "אלה המלכים אשר מלכו בארץ אדום לפני מלוך מלך על בני ישראל:",
                "בלה בן בעור, ושם עירו דנהבה."
            ]
        },
        {
            "verse": 44,
            "text": [
                "וימת בלה, וימלוך תחתיו יובב בן זרח מבצרה."
            ]
        },
        {
            "verse": 45,
            "text": [
                "וימת יובב, וימלוך תחתיו חושם מארץ התימני."
            ]
        },
        {
            "verse": 46,
            "text": [
                "וימת חושם, וימלוך תחתיו הדד בן בדד, המכה את מדין בשדה מואב,",
                "ושם עירו עוית."
            ]
        },
        {
            "verse": 47,
            "text": [
                "וימת הדד, וימלוך תחתיו שמלה ממשרקה."
            ]
        },
        {
            "verse": 48,
            "text": [
                "וימת שמלה, וימלוך תחתיו שאול מרחובות הנהר."
            ]
        },
        {
            "verse": 49,
            "text": [
                "וימת שאול, וימלוך תחתיו בעל חנן בן עכבור."
            ]
        },
        {
            "verse": 50,
            "text": [
                "וימת בעל חנן, וימלוך תחתיו הדד;",
                "ושם עירו פעי,",
                "ושם אשתו מהיטבאל בת מטרד בת מיזהב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "וימת הדד.",
                "ויהיו אלופי אדום:",
                "אלוף תמנע, אלוף עלוה, ואלוף יתת,"
            ]
        },
        {
            "verse": 52,
            "text": [
                "אלוף אהליבמה, אלוף אלה, ואלוף פינון,"
            ]
        },
        {
            "verse": 53,
            "text": [
                "אלוף קנז, אלוף תימן, ואלוף מבצר,"
            ]
        },
        {
            "verse": 54,
            "text": [
                "אלוף מגדיאל, ואלוף עירם.",
                "אלה אלופי אדום."
            ]
        }
    ]
}