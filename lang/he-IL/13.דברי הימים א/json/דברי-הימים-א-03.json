{
    "book": "דברי הימים א",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אלה בני דוד אשר נולדו לו בחברון:",
                "> הבכור אמנון, מאחינעם היזרעאלית;",
                "> השני דניאל, מאביגיל הכרמלית;"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> השלישי אבשלום, בן מעכה בת תלמי מלך גשור;",
                "> הרביעי אדוניה, בן חגית;"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> החמישי שפטיה, מאביטל;",
                "> השישי יתרעם, מעגלה אשתו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "שישה בנים נולדו לו בחברון, שם מלך שבע שנים ושישה חודשים.",
                "בירושלים מלך שלושים ושלוש שנים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "אלה היו בניו שנולדו בירושלים:",
                "> שמעה, שובב, נתן ושלמה—ארבעה מבת-שוע בת עמיאל—"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ויבחר, אלישמע ואליפלט, נולדו"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> נגה, נפג ויפיע, נולדו"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אלישמע, אלידע ואליפלט—סה\"כ תשעה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "כל אלה היו בני דוד, בנוסף לבני הפילגשים;",
                "> ותמר הייתה אחותם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "רחבעם היה בנו של שלמה,",
                "> אחריו אביה,",
                "> אסא,",
                "> ויהושפט,"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> יורם,",
                "> אחזיהו,",
                "> ויואש,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אמציהו,",
                "> עזריהו,",
                "> ויותם,"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אחז,",
                "> חזקיהו,",
                "> ומנשה,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אמון,",
                "> ואחריו יאשיהו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "בני יאשיהו היו:",
                "> יוחנן הבכור,",
                "> השני יהויקים,",
                "> השלישי צדקיהו,",
                "> הרביעי שלום."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "בני יהויקים היו:",
                "> יכניה בנו,",
                "> צדקיה בנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "יכניה, שנלקח בשבי, היו לו בנים:",
                "> שאלתיאל בנו,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> יחד עם מלכירם, פדיה, שנאצר, יקמיה, הושמע ונדביה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "בני פדיה כללו:",
                "> זרובבל ושמעי.",
                "> בני זרובבל היו:",
                "> משולם וחנניה, ושלומית הייתה אחותם;"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> יחד עם חשובה, אוהל, ברכיה, חסדיה ויושב חסד—סה\"כ חמישה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "בני חנניה היו:",
                "> פלטיה וישעיה,",
                "> בני רפיה,",
                "> בני ארנן,",
                "> בני עובדיה,",
                "> ובני שכניה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "צאצאי שכניה היו:",
                "> שמעיה,",
                "> ובני שמעיה: חטוש, יגאל, בריח, נריה ושפט—סה\"כ שישה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "בני נריה היו:",
                "> אליועיני, חזקיה ועזריקם—סה\"כ שלושה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "בני אליועיני היו:",
                "> הודויה, אלישיב, פלאיה, עקוב, יוחנן, דליה וענני—סה\"כ שבעה."
            ]
        }
    ]
}