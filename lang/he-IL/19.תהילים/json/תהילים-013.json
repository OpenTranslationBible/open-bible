{
    "book": "תהילים",
    "chapter": 13,
    "verses": [
        {
            "text": [
                "למנצח מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> עד מתי, ה'? תשכחני לנצח?",
                "> עד מתי תסתיר את פניך ממני?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עד מתי אשית עצות בנפשי,",
                "> יגון בלבבי יומם?",
                "> עד מתי ירום אויבי עלי?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הביטה ענני, ה' אלוהי;",
                "> האירה עיני פן אישן המוות,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ויאמר אויבי, \"יכלתי לו,\"",
                "> וצרי יגילו כי אמוט."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ואני בחסדך בטחתי;",
                "> יגל לבי בישועתך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אשירה לה',",
                "> כי גמל עלי."
            ]
        }
    ]
}