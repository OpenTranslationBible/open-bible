{
    "book": "תהילים",
    "chapter": 38,
    "verses": [
        {
            "text": [
                "מזמור לדוד להזכיר."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה', אל תוכחני באפך,",
                "> ואל תיסרני בחמתך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי חציך נחתו בי,",
                "> ותלחץ עלי ידך."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אין מתום בבשרי מפני זעמך;",
                "> אין שלום בעצמותי מפני חטאתי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי עוונותי עברו ראשי;",
                "> כמשא כבד יכבדו ממני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> נעוויתי, נשחתו חבורותי",
                "> מפני אולתי."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> נעויתי, שחותי עד מאוד;",
                "> כל היום קודר הלכתי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי כסלים מלאו נקלה,",
                "> ואין מתום בבשרי."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> נפוגותי ונדכיתי עד מאוד;",
                "> שאגתי מנהמת לבי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אדוני, נגדך כל תאוותי;",
                "> ואנחתי ממך לא נסתרה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לבי סחרחר, עזבי עזבני;",
                "> ואור עיני גם הם אין איתי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אהובי ורעי מנגד נגעי יעמדו,",
                "> וקרובי מרחוק עמדו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> וינקשו מבקשי נפשי,",
                "> ודרשו רעתי,",
                "> ודברו הוות ומרמות כל היום יהגו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ואני כחרש לא אשמע;",
                "> וכאלם לא יפתח פיו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ואהי כאיש אשר לא ישמע,",
                "> ואין בפיו תוכחות."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כי לך ה' הוחלתי;",
                "> אתה תענה, אדוני אלוהי."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> כי אמרתי, פן ישמחו לי,",
                "> במוט רגלי עלי הגדילו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי אני לצלע נכון,",
                "> ומכאובי נגדי תמיד."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> כי עווני אגיד;",
                "> אדאג מחטאתי."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ואויבי חיים עצמו,",
                "> ורבו שונאי שקר."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> ומשלמי רעה תחת טובה,",
                "> ישטנוני תחת רדפי טוב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אל תעזבני ה';",
                "> אלוהי, אל תרחק ממני!"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> חושה לעזרתי,",
                "> אדוני, תשועתי!"
            ]
        }
    ]
}