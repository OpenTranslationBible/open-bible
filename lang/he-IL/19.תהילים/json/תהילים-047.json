{
    "book": "תהילים",
    "chapter": 47,
    "verses": [
        {
            "text": [
                "למנצח מזמור לבני קורח"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> כל העמים תקעו כף,",
                "> הריעו לאלוהים בקול רינה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי ה' עליון נורא,",
                "> מלך גדול על כל הארץ."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יכבוש עמים תחתינו",
                "> ולאומים תחת רגלינו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יבחר לנו את נחלתנו,",
                "> את גאון יעקב אשר אהב.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> עלה אלוהים בתרועה,",
                "> ה' בקול שופר."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> זמרו לאלוהים זמרו,",
                "> זמרו למלכנו זמרו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי מלך כל הארץ אלוהים,",
                "> זמרו משכיל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> מלך אלוהים על גויים,",
                "> אלוהים ישב על כיסא קודשו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> נדיבי עמים נאספו",
                "> עם אלוהי אברהם,",
                "> כי לאלוהים מגני ארץ;",
                "> מאוד נעלה."
            ]
        }
    ]
}