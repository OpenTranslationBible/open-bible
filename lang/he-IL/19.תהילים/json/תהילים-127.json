{
    "book": "תהילים",
    "chapter": 127,
    "verses": [
        {
            "text": [
                "שיר המעלות לשלמה"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אם ה' לא יבנה בית,",
                "> שוא עמלו בוניו בו;",
                "> אם ה' לא ישמר עיר,",
                "> שוא שקד שומר."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שוא לכם משכימי קום,",
                "> מאחרי שבת,",
                "> אוכלי לחם העצבים;",
                "> כן יתן לידידו שנא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הנה נחלת ה' בנים,",
                "> שכר פרי הבטן."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כחצים ביד גיבור,",
                "> כן בני הנעורים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אשרי הגבר אשר מלא את אשפתו מהם;",
                "> לא יבושו",
                "> כי ידברו את אויבים בשער."
            ]
        }
    ]
}