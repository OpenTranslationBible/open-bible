{
    "book": "תהילים",
    "chapter": 51,
    "verses": [
        {
            "text": [
                "למנצח מזמור לדוד, בבוא נתן הנביא אליו כאשר בא אל בת שבע."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> חנני אלוהים כחסדך;",
                "> כרוב רחמיך מחה פשעי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הרבה כבסני מעווני",
                "> ומחטאתי טהרני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי פשעי אני אדע,",
                "> וחטאתי נגדי תמיד."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> לך לבדך חטאתי",
                "> והרע בעיניך עשיתי,",
                "> למען תצדק בדברך",
                "> תזכה בשפטך."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הן בעוון חוללתי,",
                "> ובחטא יחמתני אמי."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הן אמת חפצת בטוחות,",
                "> ובסתום חכמה תודיעני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> תחטאני באזוב ואטהר;",
                "> תכבסני ומשלג אלבין."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> תשמיעני ששון ושמחה,",
                "> תגלנה עצמות דכית."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> הסתר פניך מחטאי",
                "> וכל עוונותי מחה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לב טהור ברא לי אלוהים,",
                "> ורוח נכון חדש בקרבי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אל תשליכני מלפניך,",
                "> ורוח קדשך אל תקח ממני."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> השיבה לי ששון ישעך,",
                "> ורוח נדיבה תסמכני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אלמד פושעים דרכיך,",
                "> וחטאים אליך ישובו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> הצילני מדמים אלוהים, אלוהי ישעי;",
                "> תרנן לשוני צדקתך."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אדוני שפתי תפתח,",
                "> ופי יגיד תהלתך."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> כי לא תחפוץ זבח ואתנה;",
                "> עולה לא תרצה."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> זבחי אלוהים רוח נשברה;",
                "> לב נשבר ונדכה, אלוהים לא תבזה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> היטיבה ברצונך את ציון;",
                "> תבנה חומות ירושלים."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אז תחפוץ זבחי צדק,",
                "> עולה וכליל;",
                "> אז יעלו על מזבחך פרים."
            ]
        }
    ]
}