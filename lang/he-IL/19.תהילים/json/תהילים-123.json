{
    "book": "תהילים",
    "chapter": 123,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אליך נשאתי את עיניי,",
                "> היושב בשמים!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הנה כעיני עבדים אל יד אדוניהם,",
                "> כעיני שפחה אל יד גבירתה,",
                "> כן עינינו אל ה' אלוהינו,",
                "> עד שיחננו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> חננו ה', חננו,",
                "> כי רב שבענו בוז."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> רבת שבעה לה נפשנו",
                "> מהלעג השאננים,",
                "> הבוז לגאים."
            ]
        }
    ]
}