{
    "book": "תהילים",
    "chapter": 110,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> נאום ה' לאדוני:",
                "> \"שב לימיני",
                "> עד אשית אויביך הדום לרגליך.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> מטה עוזך ישלח ה' מציון, לאמור,",
                "> \"רד בקרב אויביך.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> עמך נדבות ביום חילך;",
                "> בהדרי קודש, מרחם משחר,",
                "> לך טל ילדותיך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> נשבע ה' ולא ינחם,",
                "> \"אתה כהן לעולם",
                "> על דברתי מלכיצדק.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אדוני על ימינך;",
                "> מחץ ביום אפו מלכים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ידין בגויים,",
                "> מלא גוויות,",
                "> מחץ ראש על ארץ רבה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מנחל בדרך ישתה;",
                "> על כן ירים ראש."
            ]
        }
    ]
}