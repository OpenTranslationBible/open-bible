{
    "book": "תהילים",
    "chapter": 9,
    "verses": [
        {
            "text": [
                "למנצח על מות לבן מזמור לדוד"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אודה יהוה בכל לבי;",
                "> אספר כל נפלאותיך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אשמחה ואעלצה בך;",
                "> אזמרה שמך עליון."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> בשוב אויבי אחור;",
                "> יכשלו ויאבדו מפניך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי עשית משפטי ודיני;",
                "> ישבת על הכסא שופט צדק."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> גערת גוים, אבדת רשע;",
                "> שמם מחית לעולם ועד."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> האויב תמו חרבות לנצח;",
                "> וערים נתשת,",
                "> אבד זכרם המה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ויהוה לעולם ישב;",
                "> כונן למשפט כסאו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> והוא ישפוט תבל בצדק;",
                "> ידין לאומים במישרים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ויהי יהוה משגב לדך;",
                "> משגב לעתות בצרה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ויבטחו בך יודעי שמך;",
                "> כי לא עזבת דורשיך יהוה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> זמרו ליהוה יושב ציון;",
                "> הגידו בעמים עלילותיו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי דורש דמים אותם זכר;",
                "> לא שכח צעקת עניים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> חנני יהוה;",
                "> ראה עניי משונאי,",
                "> מרוממי משערי מוות."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> למען אספרה כל תהלתיך;",
                "> בשערי בת ציון",
                "> אגילה בישועתך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> טבעו גוים בשחת עשו;",
                "> ברשת זו טמנו, נלכדה רגלם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> נודע יהוה משפט עשה;",
                "> בפועל כפיו נוקש רשע.",
                "> הגיון סלה"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ישובו רשעים לשאול;",
                "> כל גוים שכחי אלהים."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> כי לא לנצח ישכח אביון;",
                "> תקוות עניים תאבד לעד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> קומה יהוה, אל יעוז אנוש;",
                "> ישפטו גוים על פניך."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> שיתה יהוה מורה להם;",
                "> ידעו גוים אנוש המה.",
                "> סלה"
            ]
        }
    ]
}