{
    "book": "תהילים",
    "chapter": 83,
    "verses": [
        {
            "text": [
                "שיר מזמור לאסף."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלוהים, אל תחרש;",
                "> אל תשתוק ואל תישאר דומם, אלוהים."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי הנה אויביך יהמיון,",
                "> ומשנאיך נשאו ראש."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> על עמך יערימו סוד,",
                "> ויתייעצו על צפוניך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אמרו, \"לכו ונכחידם מגוי,",
                "> ולא ייזכר שם ישראל עוד.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי נועצו לב יחדיו;",
                "> עליך ברית יכרותו:"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אהלי אדום וישמעאלים,",
                "> מואב והגרים;"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> גבל ועמון ועמלק,",
                "> פלשת עם יושבי צור;"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> גם אשור נלוה עמם;",
                "> היו זרוע לבני לוט.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> עשה להם כמדין,",
                "> כסיסרא כיבין בנחל קישון,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> נשמדו בעין דור,",
                "> היו דומן לאדמה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> שיתמו נדיביהם כערב וכזאב,",
                "> וכזבח וכצלמנע כל נשיאמו,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אשר אמרו, \"נירשה לנו",
                "> את נאות אלוהים.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אלהי, שיתמו כגלגל,",
                "> כקש לפני רוח."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כאש תבער יער,",
                "> וכלהבה תלהט הרים,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כן תרדפם בסערך,",
                "> ובסופתך תבהלם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> מלא פניהם קלון,",
                "> ויבקשו שמך, יהוה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> יבושו ויבהלו עדי עד,",
                "> ויחפרו ויאבדו,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> וידעו כי אתה שמך יהוה לבדך,",
                "> עליון על כל הארץ."
            ]
        }
    ]
}