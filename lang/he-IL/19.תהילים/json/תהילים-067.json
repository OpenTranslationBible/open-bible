{
    "book": "תהילים",
    "chapter": 67,
    "verses": [
        {
            "text": [
                "למנצח בנגינות מזמור שיר."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלוהים יחננו ויברכנו,",
                "> יאר פניו איתנו סלה."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> לדעת בארץ דרכך,",
                "> בכל גויים ישועתך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יודוך עמים אלוהים,",
                "> יודוך עמים כולם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ישמחו וירננו לאומים,",
                "> כי תשפוט עמים מישור,",
                "> ולאומים בארץ תנחם סלה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יודוך עמים אלוהים,",
                "> יודוך עמים כולם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ארץ נתנה יבולה,",
                "> יברכנו אלוהים אלוהינו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יברכנו אלוהים,",
                "> וייראו אותו כל אפסי ארץ."
            ]
        }
    ]
}