{
    "book": "תהילים",
    "chapter": 125,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הבוטחים בה'",
                "> כהר ציון שלא יימוט, יישב לעולם."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ירושלים הרים סביב לה,",
                "> וה' סביב לעמו",
                "> מעתה ועד עולם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי לא ינוח שבט הרשע על גורל הצדיקים,",
                "> למען לא ישלחו הצדיקים בעוולה ידיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> היטיבה, ה', לטובים",
                "> ולישרים בלבותם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> והמטים עקלקלותם,",
                "> יוליכם ה' את פועלי האוון.",
                "> שלום על ישראל."
            ]
        }
    ]
}