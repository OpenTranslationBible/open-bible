{
    "book": "תהילים",
    "chapter": 34,
    "verses": [
        {
            "text": [
                "מזמור לדוד, כאשר התחזה למשוגע לפני אבימלך, אשר גירש אותו והוא הלך."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אברך את ה' בכל עת;",
                "> תמיד תהילתו בפי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> בה' תתהלל נפשי;",
                "> ישמעו ענוים וישמחו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> גדלו לה' אתי,",
                "> ונרוממה שמו יחדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> דרשתי את ה', וענה לי,",
                "> ומכל מגורתי הצילני."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הביטו אליו ונהרו,",
                "> ופניהם אל יחפרו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> זה עני קרא, וה' שמע,",
                "> ומכל צרותיו הושיעו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> חונה מלאך ה' סביב ליראיו,",
                "> ויחלצם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> טעמו וראו כי טוב ה';",
                "> אשרי הגבר יחסה בו!"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יראו את ה', קדושיו;",
                "> כי אין מחסור ליראיו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כפירים רשו ורעבו;",
                "> ודורשי ה' לא יחסרו כל טוב."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> לכו בנים שמעו לי;",
                "> יראת ה' אלמדכם."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מי האיש החפץ חיים",
                "> אוהב ימים לראות טוב?"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> נצר לשונך מרע",
                "> ושפתיך מדבר מרמה."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> סור מרע ועשה טוב;",
                "> בקש שלום ורדפהו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עיני ה' אל צדיקים,",
                "> ואזניו אל שועתם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> פני ה' בעושי רע,",
                "> להכרית מארץ זכרם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> צעקו, וה' שמע,",
                "> ומכל צרותיהם הצילם."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> קרוב ה' לנשברי לב",
                "> ואת דכאי רוח יושיע."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> רבות רעות צדיק,",
                "> ומכולם יצילנו ה'."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> שומר כל עצמותיו,",
                "> אחת מהנה לא נשברה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> תמותת רשע רעה,",
                "> ושונאי צדיק יאשמו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> פודה ה' נפש עבדיו,",
                "> ולא יאשמו כל החוסים בו."
            ]
        }
    ]
}