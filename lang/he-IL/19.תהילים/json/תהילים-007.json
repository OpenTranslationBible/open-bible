{
    "book": "תהילים",
    "chapter": 7,
    "verses": [
        {
            "text": [
                "שגיון לדוד אשר שר לה' על דברי כוש בן ימיני."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה' אלוהי, בך חסיתי;",
                "> הושיעני מכל רודפי והצילני,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> פן יטרוף כאריה נפשי,",
                "> פורק ואין מציל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ה' אלוהי, אם עשיתי זאת,",
                "> אם יש עוול בכפי,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אם גמלתי שולמי רע,",
                "> ואחלצה צוררי ריקם,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ירדוף אויב נפשי וישיג,",
                "> וירמס לארץ חיי",
                "> וכבודי לעפר ישכן.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> קומה ה', באפך;",
                "> התנשא בעברות צוררי,",
                "> ועורה לי;",
                "> משפט צוית."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ועדת לאומים תסובבך,",
                "> ועליה למרום שובה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' ידין עמים;",
                "> שפטני ה', כצדקי וכתמי עלי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יגמר נא רע רשעים ותכונן צדיק;",
                "> ובוחן לבות וכליות אלוהים צדיק."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> מגני על אלוהים,",
                "> מושיע ישרי לב."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אלוהים שופט צדיק,",
                "> ואל זועם בכל יום."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אם לא ישוב, חרבו ילטוש;",
                "> קשתו דרך ויכוננה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ולו הכין כלי מות;",
                "> חציו לדולקים יפעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> הנה יחבל און,",
                "> והרה עמל וילד שקר."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> בור כרה ויחפרהו,",
                "> ויפול בשחת יפעל."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ישוב עמלו בראשו,",
                "> ועל קדקדו חמסו ירד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אודה ה' כצדקו",
                "> ואזמרה שם ה' עליון."
            ]
        }
    ]
}