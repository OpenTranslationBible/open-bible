{
    "book": "תהילים",
    "chapter": 103,
    "verses": [
        {
            "text": [
                "לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ברכי נפשי את ה',",
                "> וכל קרבי את שם קדשו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ברכי נפשי את ה',",
                "> ואל תשכחי כל תגמוליו;"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הסולח לכל עוונייך,",
                "> הרופא לכל תחלואייך;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הגואל משחת חייך,",
                "> המעטרך חסד ורחמים;"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> המשביע בטוב עולמך,",
                "> תתחדש כנשר נעורייך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> עושה צדקות ה',",
                "> ומשפטים לכל עשוקים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יודיע דרכיו למשה,",
                "> לבני ישראל עלילותיו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> רחום וחנון ה',",
                "> ארך אפיים ורב חסד."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לא לנצח יריב,",
                "> ולא לעולם יטור."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לא כעונותינו עשה לנו,",
                "> ולא כעוויותינו גמל עלינו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי כגבוה שמים על הארץ,",
                "> גבר חסדו על יראיו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כרחוק מזרח ממערב,",
                "> הרחיק ממנו פשעינו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כרחם אב על בנים,",
                "> רחם ה' על יראיו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי הוא ידע יצרנו,",
                "> זכור כי עפר אנחנו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אדם כעשב ימיו,",
                "> כציץ השדה כן יציץ."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> כי רוח עברה בו ואיננו,",
                "> ולא יכירנו עוד מקומו."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> וחסד ה' מעולם ועד עולם",
                "> על יראיו,",
                "> וצדקתו לבני בנים,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> לשומרי בריתו",
                "> ולזוכרי פיקודיו לעשותם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ה' בשמים הכין כסאו,",
                "> ומלכותו בכל משלה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> ברכו ה' מלאכיו,",
                "> גיבורי כוח עושי דברו,",
                "> לשמוע בקול דברו!"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ברכו ה' כל צבאיו,",
                "> משרתיו עושי רצונו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ברכו ה' כל מעשיו,",
                "> בכל מקומות ממשלתו;",
                "> ברכי נפשי את ה'!"
            ]
        }
    ]
}