{
    "book": "תהילים",
    "chapter": 150,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> שבחו את אלוהים במקדשו;",
                "> הללו אותו ברקיע עוזו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שבחו אותו בגבורותיו;",
                "> הללו אותו כרוב גדלו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> שבחו אותו בתקע שופר;",
                "> הללו אותו בנבל וכנור."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> שבחו אותו בתוף ומחול;",
                "> הללו אותו במינים ועוגב."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> שבחו אותו בצלצלי שמע;",
                "> הללו אותו בצלצלי תרועה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כל הנשמה תהלל יה.",
                "> הללו את ה'!"
            ]
        }
    ]
}