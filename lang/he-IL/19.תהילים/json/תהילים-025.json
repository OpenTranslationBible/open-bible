{
    "book": "תהילים",
    "chapter": 25,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אליך, ה' נפשי אשא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אלוהי, בך בטחתי,",
                "> אל אֵבוֹשָׁה;",
                "> אל יעלצו אויבי לי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> גם כל קויך לא יבושו;",
                "> יבושו הבוגדים ריקם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> דרכיך, ה', הודיעני;",
                "> אורחותיך למדני."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הדריכני באמתך ולמדני,",
                "> כי אתה אלוהי ישעי;",
                "> אותך קיוויתי כל היום."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> זכר רחמיך, ה', וחסדיך,",
                "> כי מעולם המה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> חטאות נעורי ופשעי אל תזכור;",
                "> כחסדך זכר לי אתה,",
                "> למען טובך, ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> טוב וישר ה';",
                "> על כן יורה חטאים בדרך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ידרך ענוים במשפט,",
                "> וילמד ענוים דרכו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כל ארחות ה' חסד ואמת",
                "> לנצרי בריתו ועדותיו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> למען שמך, ה',",
                "> וסלחת לעווני כי רב הוא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מי זה האיש ירא ה'?",
                "> יורהו בדרך יבחר."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> נפשו בטוב תלין,",
                "> וזרעו יירש ארץ."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> סוד ה' ליראיו,",
                "> ובריתו להודיעם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עיני תמיד אל ה',",
                "> כי הוא יוציא מרשת רגלי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> פנה אלי וחנני,",
                "> כי יחיד ועני אני."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> צרות לבבי הרחיבו;",
                "> ממצוקותי הוציאני."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ראה עניי ועמלי,",
                "> ושא לכל חטאתי."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ראה אויבי כי רבו,",
                "> ושנאת חמס שנאוני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> שמרה נפשי והצילני;",
                "> אל אבוש כי חסיתי בך."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> תם וישר יצרוני,",
                "> כי קיוויתי לך."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> פדה אלוהים את ישראל,",
                "> מכל צרותיו."
            ]
        }
    ]
}