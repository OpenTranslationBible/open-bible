{
    "book": "תהילים",
    "chapter": 132,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> זכור, יהוה, לדוד",
                "> את כל ענותו;"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אשר נשבע ליהוה",
                "> נדר לאביר יעקב:"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"אם אבוא באהל ביתי,",
                "> אם אעלה על ערש יצועי;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אם אתן שנת לעיני,",
                "> לעפעפי תנומה,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> עד אמצא מקום ליהוה,",
                "> משכנות לאביר יעקב.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הנה שמענוה באפרתה,",
                "> מצאנוה בשדי יער."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> נבואה למשכנותיו;",
                "> נשתחוה להדום רגליו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> קומה, יהוה, למנוחתך,",
                "> אתה וארון עוזך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כהניך ילבשו צדק,",
                "> וחסידיך ירננו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> בעבור דוד עבדך,",
                "> אל תשב פני משיחך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> נשבע יהוה לדוד",
                "> אמת לא ישוב ממנה:",
                "> \"מפרי בטנך",
                "> אשית לכסא לך."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אם ישמרו בניך בריתי",
                "> ועדותי זו אלמדם,",
                "> גם בניהם עדי עד",
                "> ישבו לכסא לך.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי בחר יהוה בציון;",
                "> אוה למושב לו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> \"זאת מנוחתי עדי עד;",
                "> פה אשב כי אויתיה."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ברך אברך צידיה;",
                "> אביוניה אשביע לחם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> וכהניה אלביש ישע,",
                "> וחסידיה רננה ירננו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> שם אצמיח קרן לדוד;",
                "> ערכתי נר למשיחי."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אויביו אלביש בושת,",
                "> ועליו יציץ נזרו.\""
            ]
        }
    ]
}