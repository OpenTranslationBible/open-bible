{
    "book": "תהילים",
    "chapter": 66,
    "verses": [
        {
            "text": [
                "למנצח שיר מזמור"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הריעו לאלוהים כל הארץ;"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> זמרו כבוד שמו;",
                "> שימו כבוד תהילתו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אמרו לאלוהים, \"מה נוראים מעשיך!",
                "> ברוב עוזך יכחשו לך אויביך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כל הארץ תשתחווה לך,",
                "> ותזמר לך;",
                "> יזמרו שמך.\"",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לכו וראו מפעלות אלוהים,",
                "> נורא עלילה על בני אדם."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הפך ים ליבשה;",
                "> בנהר יעברו ברגל;",
                "> שם נשמחה בו!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מושל בגבורתו עולם;",
                "> עיניו בגויים תצפינה;",
                "> הסוררים לא ירימו ראשם.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ברכו עמים אלוהינו,",
                "> והשמיעו קול תהילתו,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> השם נפשנו בחיים,",
                "> ולא נתן למוט רגלינו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי בחנתנו אלוהים;",
                "> צרפתנו כצרוף כסף."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הבאתנו במצודה;",
                "> שמת מועקה במתנינו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הרכבת אנוש לראשנו;",
                "> באנו באש ובמים.",
                "> ותוציאנו לרוויה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אבוא ביתך בעולות;",
                "> אשלם לך נדרי,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אשר פצו שפתיי",
                "> ודיבר פי בצר לי."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עולות מחים אעלה לך,",
                "> עם קטרת אילים;",
                "> אעשה בקר עם עתודים.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> לכו שמעו ואספרה, כל יראי אלוהים,",
                "> אשר עשה לנפשי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אליו פי קראתי,",
                "> ורומם תחת לשוני."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> און אם ראיתי בלבי,",
                "> לא ישמע אדוני;"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אבל שמע אלוהים;",
                "> הקשיב בקול תפילתי."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> ברוך אלוהים,",
                "> אשר לא הסיר תפילתי,",
                "> וחסדו מאיתי."
            ]
        }
    ]
}