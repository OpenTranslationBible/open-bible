{
    "book": "תהילים",
    "chapter": 28,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אליך, ה' אקרא;",
                "> צורי, אל תחרש ממני,",
                "> פן תחרש ממני,",
                "> ונמשלתי עם יורדי בור."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמע קול תחנוני בשוועי אליך,",
                "> בנשאי ידי אל דביר קדשך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אל תמשכני עם רשעים",
                "> ועם פועלי אוון,",
                "> דוברי שלום עם רעיהם,",
                "> ורעה בלבבם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> תן להם כפעלם",
                "> וכרוע מעלליהם;",
                "> כמעשה ידיהם תן להם;",
                "> השב גמולם להם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי לא יבינו אל פעלות ה'",
                "> ואל מעשה ידיו,",
                "> יהרסם ולא יבנם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ברוך ה',",
                "> כי שמע קול תחנוני."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ה' עוזי ומגני;",
                "> בו בטח לבי ונעזרתי;",
                "> ויעלוז לבי,",
                "> ומשירי אודנו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' עוז למו,",
                "> ומעוז ישועות משיחו הוא."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> הושע את עמך וברך את נחלתך;",
                "> ורעם ונשאם עד העולם."
            ]
        }
    ]
}