{
    "book": "תהילים",
    "chapter": 146,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> שבחי נפשי את ה'!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אהללה את ה' בחיי;",
                "> אזמרה לאלוהי בעודי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אל תבטחו בנדיבים,",
                "> בבן אדם שאין לו תשועה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> תצא רוחו, ישוב לאדמתו;",
                "> ביום ההוא אבדו עשתונותיו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אשרי שאל יעקב בעזרו,",
                "> שברו על ה' אלוהיו,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> עשה שמים וארץ,",
                "> את הים וכל אשר בם;",
                "> השומר אמת לעולם;"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> עושה משפט לעשוקים;",
                "> נותן לחם לרעבים.",
                "> ה' מתיר אסורים."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' פוקח עיוורים;",
                "> ה' זוקף כפופים;",
                "> ה' אוהב צדיקים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ה' שומר את גרים;",
                "> יתום ואלמנה יעודד,",
                "> ודרך רשעים יעות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ימלוך ה' לעולם,",
                "> אלוהיך ציון לדור ודור.",
                "> הללו את ה'!"
            ]
        }
    ]
}