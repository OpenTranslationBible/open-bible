{
    "book": "תהילים",
    "chapter": 21,
    "verses": [
        {
            "text": [
                "למנצח מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה' בעוזך ישמח מלך,",
                "> ובישועתך מה יגל מאוד!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> תאוות לבו נתת לו,",
                "> וארשת שפתיו בל מנעת סלה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי תקדמנו ברכות טוב,",
                "> תשים לראשו עטרת פז."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> חיים שאל ממך, נתתה לו,",
                "> אורך ימים עולם ועד."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> גדול כבודו בישועתך,",
                "> הוד והדר תשוה עליו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי תשיתהו ברכות לעד,",
                "> תחדהו בשמחה את פניך."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי המלך בוטח בה',",
                "> ובחסד עליון בל ימוט."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> תמצא ידך לכל אויביך,",
                "> ימינך תמצא שונאיך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> תשיתמו כתנור אש לעת פניך,",
                "> ה' באפו יבלעם,",
                "> ותאכלם אש."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> פרים מארץ תאבד,",
                "> וזרעם מבני אדם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי נטו עליך רעה,",
                "> חשבו מזימה,",
                "> בל יוכלו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי תשיתמו שכם,",
                "> במיתריך תכונן על פניהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> רומה ה' בעוזך,",
                "> נשירה ונזמרה גבורתך."
            ]
        }
    ]
}