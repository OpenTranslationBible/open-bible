{
    "book": "תהילים",
    "chapter": 144,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ברוך ה', צורי,",
                "> המלמד ידי לקרב,",
                "> אצבעותי למלחמה;"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> חסדי ומצודתי,",
                "> משגבי ומפלטי לי,",
                "> מגני ובו חסיתי,",
                "> הרודד עמי תחתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ה', מה אדם ותדעהו?",
                "> בן אנוש ותחשבהו?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אדם להבל דמה;",
                "> ימיו כצל עובר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ה', הט שמיך ותרד;",
                "> גע בהרים ויעשנו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ברק ברק ותפיצם;",
                "> שלח חציך ותהמם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שלח ידך ממרום;",
                "> פצני והצילני ממים רבים,",
                "> מיד בני נכר"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אשר פיהם דיבר שוא,",
                "> וימינם ימין שקר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אלוהים, שיר חדש אשירה לך;",
                "> בנבל עשור אזמרה לך,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> הנותן תשועה למלכים,",
                "> הפוצה את דוד עבדו מחרב רעה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> פצני והצילני מיד בני נכר,",
                "> אשר פיהם דיבר שוא,",
                "> וימינם ימין שקר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אשר בנינו כנטיעים מגודלים בנעוריהם,",
                "> בנותינו כזוויות מחוטבות",
                "> תבנית היכל."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> מזוינו מלאים,",
                "> מפיקים מזן אל זן,",
                "> צאננו מאליפות מרובבות",
                "> ברחובותינו;"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אלופינו מסובלים",
                "> אין פרץ ואין יוצאת,",
                "> ואין צוחה ברחובותינו!"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אשרי העם שככה לו;",
                "> אשרי העם שה' אלוהיו!"
            ]
        }
    ]
}