{
    "book": "תהילים",
    "chapter": 88,
    "verses": [
        {
            "text": [
                "שיר. מזמור לבני קרח. למנצח על מחלת לענות. משכיל להימן האזרחי."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה', אלוהי ישועתי,",
                "> ביום צעקתי בלילה לפניך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> תבוא לפניך תפילתי;",
                "> הטה אוזנך לשוועתי!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי שבעה ברעות נפשי,",
                "> וחיי לשאול הגיעו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> נחשבתי עם יורדי בור;",
                "> הייתי כגבר אין איל."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> במתים חופשי,",
                "> כמו חללים שוכבי קבר,",
                "> אשר לא זכרתם עוד,",
                "> והמה מידך נגזרו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> שמתני בבור תחתיות,",
                "> במחשכים במצולות."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> עלי סמכה חמתך,",
                "> וכל משבריך עינית סלה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> הרחקת מידעי ממני;",
                "> שמתני תועבות למו;",
                "> כלא ולא אצא."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> עיני דאבה מני עני;",
                "---",
                "> קראתיך ה' בכל יום;",
                "> שטחתי אליך כפי."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> הלעמיתים תעשה פלא?",
                "> אם רפאים יקומו יודוך סלה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> היסופר בקבר חסדך,",
                "> אמונתך באבדון?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> היודע בחושך פלאך?",
                "> וצדקתך בארץ נשיה?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ואני, ה', שועתי אליך,",
                "> ובבוקר תפילתי תקדמך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ה', למה תזנח נפשי?",
                "> תסתיר פניך ממני?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עני אני וגוע מנעוריי;",
                "> נשאתי אימיך אפונה."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> עלי עברה חמתך;",
                "> בעותיך צמתותני."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> סבוני כמים כל היום;",
                "> הקיפו עלי יחד."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> הרחקת ממני אהב ורע;",
                "> מידעי מחשך."
            ]
        }
    ]
}