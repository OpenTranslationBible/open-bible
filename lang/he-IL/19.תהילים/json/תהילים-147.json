{
    "book": "תהילים",
    "chapter": 147,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> כי טוב לזמר לאלוהינו;",
                "> כי נעים ותהילה נאוה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> בונה ירושלים ה';",
                "> נדחי ישראל יכנס."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הרופא לשבורי לב",
                "> ומחבש לעצבותם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מונה מספר לכוכבים;",
                "> לכלם שמות יקרא."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> גדול אדונינו ורב כח;",
                "> לתבונתו אין מספר."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> מעודד ענוים ה';",
                "> משפיל רשעים עד ארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ענו לה' בתודה;",
                "> זמרו לאלוהינו בכינור,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> המכסה שמים בעבים,",
                "> המכין לארץ מטר,",
                "> המצמיח הרים חציר."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> נותן לבהמה לחמה,",
                "> לבני עורב אשר יקראו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לא בגבורת הסוס יחפץ;",
                "> לא בשוקי האיש ירצה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> רוצה ה' את יראיו,",
                "> את המיחלים לחסדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> שבחי ירושלים את ה';",
                "> הללי אלוהיך ציון!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי חזק בריחי שעריך;",
                "> ברך בניך בקרבך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> השם גבולך שלום;",
                "> חלב חטים ישביעך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> השלח אמרתו ארץ;",
                "> עד מהרה ירוץ דברו."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> הנותן שלג כצמר;",
                "> כפור כאפר יפזר."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> משליך קרחו כפתים;",
                "> לפני קרתו מי יעמוד?"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ישלח דברו וימסם;",
                "> ישב רוחו יזלו מים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> מגיד דבריו ליעקב,",
                "> חקיו ומשפטיו לישראל."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> לא עשה כן לכל גוי;",
                "> ומשפטים בל ידעום.",
                "> הללו את ה'!"
            ]
        }
    ]
}