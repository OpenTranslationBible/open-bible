{
    "book": "תהילים",
    "chapter": 129,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> \"רבות צררוני מנעוריי,\"",
                "> יאמר נא ישראל,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"רבות צררוני מנעוריי;",
                "> אף לא יכלו לי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> על גבי חרשו חורשים;",
                "> האריכו למענותם.\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ה' צדיק;",
                "> קיצץ עבותות רשעים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יבושו ויסוגו אחור",
                "> כל שונאי ציון;"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> יהיו כחציר גגות,",
                "> שקדמת שלף יבש;"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שלא מלא כפו קוצר,",
                "> ולא חצנו מעמר;"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ולא אמרו העברים,",
                "> \"ברכת ה' עליכם;",
                "> ברכנו אתכם בשם ה'.\""
            ]
        }
    ]
}