{
    "book": "תהילים",
    "chapter": 99,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ה' מלך, ירגזו עמים;",
                "> יושב כרובים, תנוט הארץ."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ה' בציון גדול,",
                "> ורם הוא על כל העמים."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יודו שמך הגדול ונורא;",
                "> קדוש הוא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ועוז מלך משפט אהב;",
                "> אתה כוננת מישרים;",
                "> משפט וצדקה ביעקב אתה עשית."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> רוממו ה' אלוהינו",
                "> והשתחוו להדום רגליו;",
                "> קדוש הוא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> משה ואהרן בכהניו,",
                "> ושמואל בקוראי שמו;",
                "> קוראים אל ה', והוא יענם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בעמוד ענן ידבר אליהם;",
                "> שמרו עדותיו",
                "> וחק נתן למו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' אלוהינו, אתה עניתם;",
                "> אל נשא היית להם,",
                "> ונוקם על עלילותם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> רוממו ה' אלוהינו",
                "> והשתחוו להר קדשו,",
                "> כי קדוש ה' אלוהינו."
            ]
        }
    ]
}