{
    "book": "תהילים",
    "chapter": 121,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אשא עיני אל ההרים;",
                "> מאין יבוא עזרי?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עזרי מעם ה',",
                "> עושה שמים וארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אל ייתן למוט רגלך;",
                "> שומרך לא ינום."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הנה לא ינום ולא יישן",
                "> שומר ישראל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ה' שומרך;",
                "> ה' צלך על יד ימינך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> יומם השמש לא יככה,",
                "> וירח בלילה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ה' ישמרך מכל רע;",
                "> ישמור את נפשך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' ישמור צאתך ובואך",
                "> מעתה ועד עולם."
            ]
        }
    ]
}