{
    "book": "תהילים",
    "chapter": 131,
    "verses": [
        {
            "text": [
                "שיר המעלות. לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה', לא גבה לבי ולא רמו עיני;",
                "> ולא הלכתי בגדלות",
                "> ובנפלאות ממני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אם לא שיוויתי ודוממתי נפשי;",
                "> כגמול עלי אמו,",
                "> כגמול עלי נפשי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יחל ישראל אל ה'",
                "> מעתה ועד עולם."
            ]
        }
    ]
}