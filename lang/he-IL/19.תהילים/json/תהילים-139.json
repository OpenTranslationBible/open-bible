{
    "book": "תהילים",
    "chapter": 139,
    "verses": [
        {
            "text": [
                "למנצח מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> יהוה חקרתני ותדע."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אתה ידעת שבתי וקומי;",
                "> בנתה לרעי מרחוק."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ארחי ורבעי זרית,",
                "> וכל דרכי הסכנתה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי אין מילה בלשוני,",
                "> הן יהוה ידעת כולה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אחור וקדם צרתני,",
                "> ותשת עלי כפך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> פלאי דעת ממני,",
                "> נשגבה לא אוכל לה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אנה אלך מרוחך?",
                "> ואנה מפניך אברח?"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אם אסק שמים שם אתה;",
                "> ואציעה שאול הנך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אשא כנפי שחר,",
                "> אשכנה באחרית ים."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> גם שם ידך תנחני,",
                "> ותאחזני ימינך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ואמר אך חושך ישופני,",
                "> ולילה אור בעדני."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> גם חושך לא יחשיך ממך,",
                "> ולילה כיום יאיר;",
                "> כחשכה כאורה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי אתה קנית כליותי;",
                "> תסוכני בבטן אמי."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אודך על כי נוראות נפלאתי;",
                "> נפלאים מעשיך,",
                "> ונפשי יודעת מאד."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> לא נכחד עצמי ממך",
                "> אשר עשיתי בסתר,",
                "> רקמתי בתחתיות ארץ."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> גלמי ראו עיניך;",
                "> ועל ספרך כולם יכתבו",
                "> ימים יוצרו,",
                "> ולא אחד בהם."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ולי מה יקרו רעיך אל;",
                "> מה עצמו ראשיהם!"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אספרם מחול ירבון;",
                "> הקיצותי ועוד עמך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אם תקטול אלוה רשע;",
                "> ואנשי דמים סורו ממני."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אשר יאמרוך למזמה,",
                "> נשוא לשוא עריך."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> הלא משנאיך יהוה אשנא?",
                "> ובתקוממיך אתקוטט?"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> תכלית שנאה שנאתים;",
                "> לאויבים היו לי."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> חקרני אל ודע לבבי;",
                "> בחנני ודע שרעפי."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> וראה אם דרך עוצב בי,",
                "> ונחני בדרך עולם."
            ]
        }
    ]
}