{
    "book": "תהילים",
    "chapter": 81,
    "verses": [
        {
            "text": [
                "למנצח על הגתית לאסף."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הרנינו לאלוהים עוזנו;",
                "> הריעו לאלוהי יעקב."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שאו זמר ותנו תוף,",
                "> כנור נעים עם נבל."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> תקעו בחודש שופר,",
                "> בכסה ליום חגנו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי חוק לישראל הוא,",
                "> משפט לאלוהי יעקב."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> עדות ביהוסף שמו,",
                "> בצאתו על ארץ מצרים;",
                "---",
                "> שפת לא ידעתי אשמע:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הסירותי מסבל שכמו,",
                "> כפיו מדוד תעבורנה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בצרה קראת ואחלצך;",
                "> אענך בסתר רעם;",
                "> אבחנך על מי מריבה.",
                "> סלה"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> שמע עמי ואעידה בך;",
                "> ישראל אם תשמע לי!"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לא יהיה בך אל זר;",
                "> ולא תשתחוה לאל נכר."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אנכי ה' אלוהיך,",
                "> המעלך מארץ מצרים;",
                "> הרחב פיך ואמלאהו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ולא שמע עמי לקולי,",
                "> וישראל לא אבה בי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ואשלחהו בשרירות לבם,",
                "> ילכו במועצותיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לו עמי שומע לי,",
                "> ישראל בדרכי יהלכו!"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כמעט אויביהם אכניע,",
                "> ועל צריהם אשיב ידי."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> משנאי ה' יכחשו לו,",
                "> ויהי עתם לעולם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ויאכילהו מחלב חיטה,",
                "> ומצור דבש אשביעך.”"
            ]
        }
    ]
}