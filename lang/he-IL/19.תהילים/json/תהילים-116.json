{
    "book": "תהילים",
    "chapter": 116,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> אהבתי את ה', כי שומע",
                "> את קולי ואת תחנוני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי הטה אוזנו אלי,",
                "> ובימי אקרא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> חבלי מוות סבבוני",
                "> ומצרי שאול מצאוני;",
                "> צרה ויגון אמצא."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ובשם ה' אקרא:",
                "> \"אנא ה', מלטה נפשי!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> חנון ה' וצדיק;",
                "> ואלוהינו מרחם."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> שומר פתאים ה';",
                "> דלותי ולי יהושיע."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שובי נפשי למנוחיכי,",
                "> כי ה' גמל עליך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כי חלצת נפשי ממות,",
                "> את עיני מדמעה,",
                "> את רגלי מדחי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אתהלך לפני ה'",
                "> בארצות החיים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> האמנתי כי אדבר,",
                "> \"אני עניתי מאד.\""
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אני אמרתי בחפזי,",
                "> \"כל האדם כוזב.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מה אשיב לה'",
                "> כל תגמולוהי עלי?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כוס ישועות אשא,",
                "> ובשם ה' אקרא."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> נדרי לה' אשלם",
                "> נגד נא כל עמו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> יקר בעיני ה'",
                "> המוותה לחסידיו."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אנא ה', כי אני עבדך;",
                "> אני עבדך בן אמתך,",
                "> פתחת למוסרי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> לך אזבח זבח תודה,",
                "> ובשם ה' אקרא."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> נדרי לה' אשלם",
                "> נגד נא כל עמו."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> בחצרות בית ה',",
                "> בתוככי ירושלים.",
                "> הללו יה!"
            ]
        }
    ]
}