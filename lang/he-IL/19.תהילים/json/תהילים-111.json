{
    "book": "תהילים",
    "chapter": 111,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> אודה את ה' בכל לבב,",
                "> בסוד ישרים ועדה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> גדולים מעשי ה';",
                "> דרושים לכל חפציהם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הוד והדר פועלו,",
                "> וצדקתו עומדת לעד."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> זכר עשה לנפלאותיו;",
                "> חנון ורחום ה'."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> טרף נתן ליראיו;",
                "> יזכור לעולם בריתו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כוח מעשיו הגיד לעמו,",
                "> לתת להם נחלת גויים."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מעשי ידיו אמת ומשפט;",
                "> נאמנים כל פיקודיו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> סמוכים לעד לעולם;",
                "> עשויים באמת וישר."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> פדות שלח לעמו;",
                "> ציווה לעולם בריתו;",
                "> קדוש ונורא שמו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ראשית חכמה יראת ה';",
                "> שכל טוב לכל עושיהם;",
                "> תהילתו עומדת לעד."
            ]
        }
    ]
}