{
    "book": "תהילים",
    "chapter": 124,
    "verses": [
        {
            "text": [
                "שיר המעלות לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> \"לולא ה' שהיה לנו,\"",
                "> יאמר נא ישראל,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"לולא ה' שהיה לנו",
                "> בקום עלינו אדם,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אזי חיים בלעונו",
                "> בחרות אפם בנו;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אזי המים שטפונו,",
                "> נחלה עבר על נפשנו;"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אזי עבר על נפשנו המים הזידונים.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ברוך ה',",
                "> שלא נתננו טרף לשיניהם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> נפשנו כציפור נמלטה מפח יוקשים;",
                "> הפח נשבר ואנחנו נמלטנו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> עזרנו בשם ה',",
                "> עושה שמים וארץ."
            ]
        }
    ]
}