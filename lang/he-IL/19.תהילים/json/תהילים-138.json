{
    "book": "תהילים",
    "chapter": 138,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אודך בכל לבי,",
                "> נגד אלהים אזמרך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אשתחוה אל היכל קדשך,",
                "> ואודה את שמך על חסדך ועל אמתך;",
                "> כי הגדלת על כל שמך אמרתך."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ביום קראתי ותענני;",
                "> תרהיבני עוז בנפשי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יודוך ה' כל מלכי ארץ,",
                "> כי שמעו אמרי פיך."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> וישירו בדרכי ה',",
                "> כי גדול כבוד ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי רם ה',",
                "> ושפל יראה,",
                "> וגבה ממרחק יידע."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אם אלך בקרב צרה תחייני;",
                "> על אף אויבי תשלח ידך,",
                "> ותושיעני ימינך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' יגמר בעדי;",
                "> ה' חסדך לעולם,",
                "> מעשי ידיך אל תרף."
            ]
        }
    ]
}