{
    "book": "תהילים",
    "chapter": 80,
    "verses": [
        {
            "text": [
                "למנצח על שושנים עדות לאסף מזמור"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> רעה ישראל האזינה",
                "> נהג כצאן יוסף",
                "> יושב הכרובים הופיעה"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> לפני אפרים ובנימין ומנשה עוררה את גבורתך",
                "> ולכה לישעתה לנו"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אלהים השיבנו",
                "> והאר פניך ונושעה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יהוה אלהים צבאות",
                "> עד מתי עשנת בתפלת עמך"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> האכלתם לחם דמעה",
                "> ותשקמו בדמעות שליש"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> תשימנו מדון לשכנינו",
                "> ואויבינו ילעגו למו"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אלהים צבאות השיבנו",
                "> והאר פניך ונושעה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> גפן ממצרים תסיע",
                "> תגרש גוים ותטעה"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> פנית לפניה",
                "> ותשרש שרשיה ותמלא ארץ"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כסו הרים צלה",
                "> וענפיה ארזי אל"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> תשלח קצירה עד ים",
                "> ואל נהר יונקותיה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> למה פרצת גדריה",
                "> וארוה כל עוברי דרך"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יכרסמנה חזיר מיער",
                "> וזיז שדה ירענה"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אלהים צבאות שוב נא",
                "> הבט משמים וראה ופקד גפן זאת"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> וכנה אשר נטעה ימינך",
                "> ועל בן אמצת לך"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> שרפה באש כסוחה",
                "> מגערת פניך יאבדו"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> תהי ידך על איש ימינך",
                "> על בן אדם אמצת לך"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ולא נסוג ממך",
                "> תחיינו ובשמך נקרא"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> יהוה אלהים צבאות השיבנו",
                "> האר פניך ונושעה"
            ]
        }
    ]
}