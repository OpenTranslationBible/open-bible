{
    "book": "תהילים",
    "chapter": 119,
    "verses": [
        {
            "text": [
                "א א"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אשרי תמימי דרך,",
                "> ההולכים בתורת ה'."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אשרי נוצרי עדותיו,",
                "> בכל לב ידרשהו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אף לא פעלו עוולה;",
                "> בדרכיו הלכו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אתה צוית פיקודיך,",
                "> לשמר מאוד."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אחלי ייכונו דרכי,",
                "> לשמור חוקיך!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אז לא אבוש,",
                "> בהביטי אל כל מצוותיך."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אודך בישר לבב,",
                "> בלמדי משפטי צדקך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> את חוקיך אשמור;",
                "> אל תעזבני עד מאוד!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ב ב"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> במה יזכה נער את אורחו?",
                "> לשמור כדברך."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> בכל לבי דרשתיך;",
                "> אל תשגני ממצוותיך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> בלבי צפנתי אמרתך,",
                "> למען לא אחטא לך."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ברוך אתה, ה';",
                "> למדני חוקיך."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> בשפתי ספרתי",
                "> כל משפטי פיך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> בדרך עדותיך ששתי,",
                "> כעל כל הון."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> בפיקודיך אשיחה",
                "> ואביטה אורחותיך."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> בחוקיך אשתעשע;",
                "> לא אשכח דברך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ג ג"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> גמל על עבדך אחיה,",
                "> ואשמרה דברך."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> גל עיני ואביטה",
                "> נפלאות מתורתך."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> גר אנכי בארץ;",
                "> אל תסתר ממני מצוותיך."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> גרסה נפשי לתאבה",
                "> אל משפטיך בכל עת."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> גערת זדים ארורים,",
                "> השגים ממצוותיך."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> גל מעלי חרפה ובוז,",
                "> כי עדותיך נצרתי."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> גם ישבו שרים בי נדברו,",
                "> עבדך ישיח בחוקיך."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> גם עדותיך שעשועי;",
                "> אנשי עצתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ד ד"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> דבקה לעפר נפשי;",
                "> חייני כדברך."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> דרכי ספרתי ותענני;",
                "> למדני חוקיך."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> דרך פיקודיך הבינני,",
                "> ואשיחה בנפלאותיך."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> דלפה נפשי מתוגה;",
                "> קימני כדברך."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> דרך שקר הסר ממני,",
                "> ותורתך חנני."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> דרך אמונה בחרתי;",
                "> משפטיך שויתי."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> דבקתי בעדותיך;",
                "> ה', אל תבישני!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> דרך מצוותיך ארוץ,",
                "> כי תרחיב לבי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ה ה"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> הורני, ה', דרך חוקיך,",
                "> ואצרנה עקב."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> הבינני ואצרה תורתך",
                "> ואשמרנה בכל לב."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> הדריכני בנתיב מצוותיך,",
                "> כי בו חפצתי."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> הט לבי אל עדותיך,",
                "> ואל אל בצע."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> העבר עיני מראות שוא,",
                "> בדרכך חייני."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> הקם לעבדך אמרתך,",
                "> אשר ליראתך."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> העבר חרפתי אשר יגורתי,",
                "> כי משפטיך טובים."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> הנה תאבתי לפיקודיך;",
                "> בצדקתך חייני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ו ו"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> ויבאוני חסדיך, ה',",
                "> תשועתך כאמרתך;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> ואענה חרפי דבר,",
                "> כי בטחתי בדברך."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> ואל תצל מפי דבר אמת עד מאוד,",
                "> כי למשפטיך יחלתי."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> ואשמרה תורתך תמיד,",
                "> לעולם ועד."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> ואתהלכה ברחבה,",
                "> כי פיקודיך דרשתי."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> ואדברה בעדותיך נגד מלכים,",
                "> ולא אבוש."
            ]
        },
        {
            "verse": 47,
            "text": [
                "> ואשתעשע במצוותיך,",
                "> אשר אהבתי."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> ואשא כפי אל מצוותיך, אשר אהבתי;",
                "> ואשיחה בחוקיך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ז ז"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> זכר דבר לעבדך,",
                "> אשר יחלתני."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> זאת נחמתי בעוניי,",
                "> כי אמרתך חייתני."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> זדים הליצוני עד מאוד,",
                "> מתורתך לא נטיתי."
            ]
        },
        {
            "verse": 52,
            "text": [
                "> זכרתי משפטיך מעולם, ה',",
                "> ואתנחם."
            ]
        },
        {
            "verse": 53,
            "text": [
                "> זלעפה אחזתני מרשעים,",
                "> עוזבי תורתך."
            ]
        },
        {
            "verse": 54,
            "text": [
                "> זמרות היו לי חוקיך",
                "> בבית מגורי."
            ]
        },
        {
            "verse": 55,
            "text": [
                "> זכרתי בלילה שמך, ה',",
                "> ואשמרה תורתך."
            ]
        },
        {
            "verse": 56,
            "text": [
                "> זאת היתה לי,",
                "> כי פיקודיך נצרתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ח ח"
            ]
        },
        {
            "verse": 57,
            "text": [
                "> חלקי ה',",
                "> אמרתי לשמור דבריך."
            ]
        },
        {
            "verse": 58,
            "text": [
                "> חלותי פניך בכל לב;",
                "> חנני כאמרתך."
            ]
        },
        {
            "verse": 59,
            "text": [
                "> חשבתי דרכי",
                "> ואשיבה רגלי אל עדותיך."
            ]
        },
        {
            "verse": 60,
            "text": [
                "> חשתי ולא התמהמהתי",
                "> לשמור מצוותיך."
            ]
        },
        {
            "verse": 61,
            "text": [
                "> חבלי רשעים עודני,",
                "> תורתך לא שכחתי."
            ]
        },
        {
            "verse": 62,
            "text": [
                "> חצות לילה אקום להודות לך",
                "> על משפטי צדקך."
            ]
        },
        {
            "verse": 63,
            "text": [
                "> חבר אני לכל אשר יראוך,",
                "> ולשומרי פיקודיך."
            ]
        },
        {
            "verse": 64,
            "text": [
                "> חסדך, ה', מלאה הארץ;",
                "> חוקיך למדני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ט ט"
            ]
        },
        {
            "verse": 65,
            "text": [
                "> טוב עשית עם עבדך, ה',",
                "> כדברך."
            ]
        },
        {
            "verse": 66,
            "text": [
                "> טוב טעם ודעת למדני,",
                "> כי במצוותיך האמנתי."
            ]
        },
        {
            "verse": 67,
            "text": [
                "> טרם אענה אני שוגג,",
                "> ועתה אמרתך שמרתי."
            ]
        },
        {
            "verse": 68,
            "text": [
                "> טוב אתה ומטיב;",
                "> למדני חוקיך."
            ]
        },
        {
            "verse": 69,
            "text": [
                "> טפלו עלי שקר זדים;",
                "> אני בכל לב אצר פיקודיך."
            ]
        },
        {
            "verse": 70,
            "text": [
                "> טפש כחלב לבם,",
                "> אני תורתך שעשעתי."
            ]
        },
        {
            "verse": 71,
            "text": [
                "> טוב לי כי עוניתי,",
                "> למען אלמד חוקיך."
            ]
        },
        {
            "verse": 72,
            "text": [
                "> טוב לי תורת פיך",
                "> מאלפי זהב וכסף."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "י י"
            ]
        },
        {
            "verse": 73,
            "text": [
                "> ידיך עשוני ויכוננוני;",
                "> הבינני ואלמד מצוותיך."
            ]
        },
        {
            "verse": 74,
            "text": [
                "> יראוך יראיך וישמחו,",
                "> כי לדברך יחלתי."
            ]
        },
        {
            "verse": 75,
            "text": [
                "> ידעתי, ה', כי משפטיך צדק,",
                "> ואמונה עניתני."
            ]
        },
        {
            "verse": 76,
            "text": [
                "> יהי נא חסדך לנחמני,",
                "> כאמרתך לעבדך."
            ]
        },
        {
            "verse": 77,
            "text": [
                "> יבואוני רחמיך ואחיה,",
                "> כי תורתך שעשעי."
            ]
        },
        {
            "verse": 78,
            "text": [
                "> יבושו זדים כי שקר עותוני;",
                "> אני אשיח בפיקודיך."
            ]
        },
        {
            "verse": 79,
            "text": [
                "> ישובו לי יראיך,",
                "> ויודעי עדותיך."
            ]
        },
        {
            "verse": 80,
            "text": [
                "> יהי לבי תמים בחוקיך,",
                "> למען לא אבוש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "כ כ"
            ]
        },
        {
            "verse": 81,
            "text": [
                "> כלתה לתשועתך נפשי;",
                "> לדברך יחלתי."
            ]
        },
        {
            "verse": 82,
            "text": [
                "> כלו עיני לאמרתך,",
                "> לאמר, \"מתי תנחמני?\""
            ]
        },
        {
            "verse": 83,
            "text": [
                "> כי הייתי כנוד עשן,",
                "> חוקיך לא שכחתי."
            ]
        },
        {
            "verse": 84,
            "text": [
                "> כמה ימי עבדך?",
                "> מתי תעשה ברדפי משפט?"
            ]
        },
        {
            "verse": 85,
            "text": [
                "> כרו לי זדים שיחות,",
                "> אשר לא כתורתך."
            ]
        },
        {
            "verse": 86,
            "text": [
                "> כל מצוותיך אמונה;",
                "> שקר רדפוני, עזרני!"
            ]
        },
        {
            "verse": 87,
            "text": [
                "> כמעט כלוני בארץ,",
                "> ואני לא עזבתי פיקודיך."
            ]
        },
        {
            "verse": 88,
            "text": [
                "> כחסדך חייני,",
                "> ואשמרה עדות פיך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ל ל"
            ]
        },
        {
            "verse": 89,
            "text": [
                "> לעולם, ה',",
                "> דברך ניצב בשמים."
            ]
        },
        {
            "verse": 90,
            "text": [
                "> לדור ודור אמונתך;",
                "> כוננת ארץ ותעמוד."
            ]
        },
        {
            "verse": 91,
            "text": [
                "> למשפטיך עמדו היום,",
                "> כי הכל עבדיך."
            ]
        },
        {
            "verse": 92,
            "text": [
                "> לולי תורתך שעשעי,",
                "> אז אבדתי בעוניי."
            ]
        },
        {
            "verse": 93,
            "text": [
                "> לעולם לא אשכח פיקודיך,",
                "> כי בם חייתני."
            ]
        },
        {
            "verse": 94,
            "text": [
                "> לך אני, הושיעני,",
                "> כי פיקודיך דרשתי."
            ]
        },
        {
            "verse": 95,
            "text": [
                "> קוו לי רשעים לאבידני;",
                "> עדותיך אתבונן."
            ]
        },
        {
            "verse": 96,
            "text": [
                "> לכל תכלה ראיתי קץ;",
                "> רחבה מצוותך מאוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מ מ"
            ]
        },
        {
            "verse": 97,
            "text": [
                "> מה אהבתי תורתך!",
                "> כל היום היא שיחתי."
            ]
        },
        {
            "verse": 98,
            "text": [
                "> מאויבי תחכמני מצוותיך,",
                "> כי לעולם היא לי."
            ]
        },
        {
            "verse": 99,
            "text": [
                "> מכל מלמדי השכלתי,",
                "> כי עדותיך שיחתי."
            ]
        },
        {
            "verse": 100,
            "text": [
                "> מזקנים אתבונן,",
                "> כי פיקודיך נצרתי."
            ]
        },
        {
            "verse": 101,
            "text": [
                "> מכל אורח רע כלאתי רגלי,",
                "> למען אשמור דברך."
            ]
        },
        {
            "verse": 102,
            "text": [
                "> ממשפטיך לא סרתי,",
                "> כי אתה הורתני."
            ]
        },
        {
            "verse": 103,
            "text": [
                "> מה נמלצו לחכי אמרתך!",
                "> מדבש לפי."
            ]
        },
        {
            "verse": 104,
            "text": [
                "> מפיקודיך אתבונן;",
                "> על כן שנאתי כל אורח שקר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "נ נ"
            ]
        },
        {
            "verse": 105,
            "text": [
                "> נר לרגלי דברך",
                "> ואור לנתיבתי."
            ]
        },
        {
            "verse": 106,
            "text": [
                "> נשבעתי ואקיימה,",
                "> לשמור משפטי צדקך."
            ]
        },
        {
            "verse": 107,
            "text": [
                "> נעניתי עד מאוד;",
                "> חייני, ה', כדברך."
            ]
        },
        {
            "verse": 108,
            "text": [
                "> נדבות פי רצה נא, ה',",
                "> ומשפטיך למדני."
            ]
        },
        {
            "verse": 109,
            "text": [
                "> נפשי בכפי תמיד,",
                "> ותורתך לא שכחתי."
            ]
        },
        {
            "verse": 110,
            "text": [
                "> נתנו רשעים פח לי,",
                "> ומפיקודיך לא תעיתי."
            ]
        },
        {
            "verse": 111,
            "text": [
