{
    "book": "תהילים",
    "chapter": 142,
    "verses": [
        {
            "text": [
                "משכיל לדוד בהיותו במערה תפילה"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> בקולי אל ה' אזעק;",
                "> בקולי אל ה' אתחנן."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אשפוך לפניו שיחי;",
                "> צרתי לפניו אגיד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> בהתעטף עלי רוחי,",
                "> ואתה ידעת נתיבתי.",
                "> בדרך זו אשר אהלך,",
                "> טמנו פח לי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הבט ימין וראה;",
                "> ואין לי מכיר.",
                "> אבד מנוס ממני;",
                "> אין דורש לנפשי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> זעקתי אליך ה';",
                "> אמרתי, \"אתה מחסי,",
                "> חלקי בארץ החיים.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הקשיבה אל רינתי,",
                "> כי דלותי מאד;",
                "> הצילני מרודפי,",
                "> כי אמצו ממני."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הוציאה ממסגר נפשי,",
                "> להודות את שמך;",
                "> בי יכתרו צדיקים,",
                "> כי תגמול עלי.\""
            ]
        }
    ]
}