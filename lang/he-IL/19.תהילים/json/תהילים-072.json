{
    "book": "תהילים",
    "chapter": 72,
    "verses": [
        {
            "text": [
                "מזמור לשלמה."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלהים, תן למלך משפטיך,",
                "> וצדקתך לבן המלך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ישפוט עמך בצדק,",
                "> וענייך במשפט."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ישאו הרים שלום לעם,",
                "> וגבעות בצדקה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ישפוט עניי עם,",
                "> יושיע לבני אביון,",
                "> וידכא עושק."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ייראוך עם שמש,",
                "> ולפני ירח דור דורים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ירד כמטר על גז,",
                "> כרביבים זרזיף ארץ."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יפרח בימיו צדיק,",
                "> ורוב שלום עד בלי ירח."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> וירד מים עד ים,",
                "> ומנהר עד אפסי ארץ."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לפניו יכרעו ציים,",
                "> ואויביו עפר ילחכו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> מלכי תרשיש ואיים מנחה ישיבו,",
                "> מלכי שבא וסבא אשכר יקריבו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> וישתחוו לו כל מלכים,",
                "> כל גויים יעבדוהו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי יציל אביון משווע,",
                "> ועני ואין עוזר לו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יחוס על דל ואביון,",
                "> ונפשות אביונים יושיע."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> מתוך ומחמס יגאל נפשם,",
                "> וייקר דמם בעיניו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ויחי, וייתן לו מזהב שבא,",
                "> ויתפלל בעדו תמיד,",
                "> כל היום יברכוהו."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> יהי פסת בר בארץ בראש הרים,",
                "> ירעש כלבנון פריו,",
                "> ויציצו מעיר כעשב הארץ."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> יהי שמו לעולם,",
                "> לפני שמש ינון שמו;",
                "---",
                "> ויתברכו בו,",
                "> כל גויים יאשרוהו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ברוך ה' אלהים, אלהי ישראל,",
                "> עושה נפלאות לבדו."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> וברוך שם כבודו לעולם,",
                "> וימלא כבודו את כל הארץ.",
                "> אמן ואמן."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> כלו תפילות דוד בן ישי."
            ]
        }
    ]
}