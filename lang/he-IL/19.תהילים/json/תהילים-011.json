{
    "book": "תהילים",
    "chapter": 11,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> בה' חסיתי;",
                "> איך תאמרו לנפשי,",
                "> \"נודי הרכם ציפור;"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי הנה הרשעים ידרכו קשת,",
                "> כוננו חצם על יתר",
                "> לירות במו אופל לישרי לב."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי השתות יהרסון,",
                "> צדיק מה פעל?\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ה' בהיכל קדשו;",
                "> ה' בשמים כסאו;",
                "> עיניו יחזו, עפעפיו יבחנו בני אדם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ה' צדיק יבחן ורשע,",
                "> ואוהב חמס שנאה נפשו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ימטר על רשעים פחים,",
                "> אש וגפרית ורוח זלעפות מנת כוסם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי צדיק ה' צדקות אהב;",
                "> ישר יחזו פנימו."
            ]
        }
    ]
}