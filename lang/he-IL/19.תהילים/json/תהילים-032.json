{
    "book": "תהילים",
    "chapter": 32,
    "verses": [
        {
            "text": [
                "מזמור לדוד. משכיל."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אַשְׁרֵי נְשׂוּי פֶּשַׁע,",
                "> כְּסוּי חֲטָאָה."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אַשְׁרֵי אָדָם לֹא יַחְשֹׁב יְהוָה לוֹ עָוֹן,",
                "> וְאֵין בְּרוּחוֹ רְמִיָּה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כִּי-הֶחֱרַשְׁתִּי בָּלוּ עֲצָמָי,",
                "> בְּשַׁאֲגָתִי כָּל-הַיּוֹם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כִּי יוֹמָם וָלַיְלָה תִּכְבַּד עָלַי יָדֶךָ,",
                "> נֶהְפַּךְ לְשַׁדִּי בְּחַרְבֹּנֵי קַיִץ.",
                "> סֶלָה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> חַטָּאתִי אוֹדִיעֲךָ,",
                "> וַעֲוֹנִי לֹא-כִסִּיתִי;",
                "> אָמַרְתִּי אוֹדֶה עֲלֵי פְשָׁעַי לַיהוָה,",
                "> וְאַתָּה נָשָׂאתָ עֲוֹן חַטָּאתִי.",
                "> סֶלָה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> עַל-זֹאת יִתְפַּלֵּל כָּל-חָסִיד אֵלֶיךָ לְעֵת מְצֹא;",
                "> רַק לְשֵׁטֶף מַיִם רַבִּים אֵלָיו לֹא יַגִּיעוּ."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אַתָּה סֵתֶר לִי;",
                "> מִצַּר תִּצְּרֵנִי;",
                "> רָנֵּי פַלֵּט תְּסוֹבְבֵנִי.",
                "> סֶלָה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אַשְׂכִּילְךָ וְאוֹרְךָ בְּדֶרֶךְ-זוּ תֵלֵךְ;",
                "> אִיעֲצָה עָלֶיךָ עֵינִי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אַל-תִּהְיוּ כְּסוּס כְּפֶרֶד אֵין הָבִין,",
                "> בְּמֶתֶג וָרֶסֶן עֶדְיוֹ לִבְלוֹם,",
                "> בַּל-קְרֹב אֵלֶיךָ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> רַבִּים מַכְאוֹבִים לָרָשָׁע,",
                "> וְהַבּוֹטֵחַ בַּיהוָה חֶסֶד יְסוֹבְבֶנּוּ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> שִׂמְחוּ בַיהוָה וְגִילוּ צַדִּיקִים,",
                "> וְהַרְנִינוּ כָּל-יִשְׁרֵי-לֵב."
            ]
        }
    ]
}