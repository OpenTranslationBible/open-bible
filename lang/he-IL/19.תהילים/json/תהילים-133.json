{
    "book": "תהילים",
    "chapter": 133,
    "verses": [
        {
            "text": [
                "שיר המעלות. לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הנה מה טוב ומה נעים",
                "> שבת אחים גם יחד!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כשמן הטוב על הראש,",
                "> יורד על הזקן,",
                "> זקן אהרן,",
                "> שיורד על פי מדותיו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כטל חרמון",
                "> שיורד על הרי ציון;",
                "> כי שם ציווה ה' את הברכה—",
                "> חיים עד העולם."
            ]
        }
    ]
}