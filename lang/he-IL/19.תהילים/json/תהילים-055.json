{
    "book": "תהילים",
    "chapter": 55,
    "verses": [
        {
            "text": [
                "למנצח בנגינות. משכיל לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> האזינה אל תפילתי, אלוהים;",
                "> ואל תתעלם מתחינתי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הקשיבה לי וענה לי;",
                "> נודד אני בשיחי ונבהל,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> מקול אויב,",
                "> מפני עקת רשע;",
                "> כי ימיטו עלי און",
                "> ובאף ישטמוני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ליבי יחיל בקרבי,",
                "> ואימות מות נפלו עלי."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יראה ורעד יבוא בי,",
                "> ותכסני פלצות."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ואומר, \"מי יתן לי אבר כיונה!",
                "> אעופה ואשכונה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הנה ארחיק נדוד,",
                "> אלין במדבר.",
                "> סלה"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אחישה מפלט לי",
                "> מרוח סערה ומסופה.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> בלע, אדוני, פלג לשונם,",
                "> כי ראיתי חמס וריב בעיר."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יומם ולילה יסובבוה על חומותיה,",
                "> ואון ועמל בקרבה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הוות בקרבה;",
                "> ולא ימיש מרחובה תך ומרמה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי לא אויב יחרפני ואשא;",
                "> לא משנאי עלי הגדיל,",
                "> ואסתר ממנו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ואתה אנוש כערכי,",
                "> אלופי ומיודעי;"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אשר יחד נמתיק סוד,",
                "> בבית אלוהים נהלך ברגש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ישימות עליהם מוות;",
                "> ירדו שאול חיים,",
                "> כי רעות במגורם בקרבם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אני אל אלוהים אקרא,",
                "> ויהוה יושיעני."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ערב ובוקר וצהריים אשיחה ואהמה,",
                "> וישמע קולי."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> פדה בשלום נפשי מקרב לי,",
                "> כי ברבים היו עמדי."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ישמע אל ויענם—",
                "> ויושב קדם סלה—",
                "> אשר אין חליפות למו,",
                "> ולא יראו אלוהים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> שלח ידיו בשלומיו;",
                "> חלל בריתו."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> חלקו מחמאת פיו,",
                "> וקרב לבו;",
                "> רכו דבריו משמן,",
                "> והמה פתיחות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> השלך על יהוה יהבך והוא יכלכלך;",
                "> לא ייתן לעולם מוט לצדיק."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ואתה, אלוהים, תורידם לבאר שחת;",
                "> אנשי דמים ומרמה לא יחצו ימיהם.",
                "> ואני אבטח בך."
            ]
        }
    ]
}