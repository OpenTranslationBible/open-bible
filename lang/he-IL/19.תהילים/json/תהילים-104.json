{
    "book": "תהילים",
    "chapter": 104,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ברכי נפשי את ה'!",
                "> ה' אלוהי, גדלת מאוד;",
                "> הוד והדר לבשת,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עוטה אור כשלמה,",
                "> נוטה שמים כיריעה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> המקרה במים עליותיו;",
                "> שם עבים רכובו;",
                "> המהלך על כנפי רוח;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> עושה מלאכיו רוחות,",
                "> משרתיו אש לוהט."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יסד ארץ על מכוניה,",
                "> בל תימוט עולם ועד."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> תהום כלבוש כסיתו;",
                "> על הרים יעמדו מים."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מן גערתך ינוסון,",
                "> מן קול רעמך יחפזון."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> יעלו הרים, ירדו בקעות",
                "> אל מקום זה יסדת להם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> גבול שמת בל יעבורון,",
                "> בל ישובון לכסות הארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> המשלח מעיינות בנחלים;",
                "> בין הרים יהלכון;"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ישקו כל חיתו שדה;",
                "> ישברו פראים צמאם."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> עליהם עוף השמים ישכון;",
                "> מבין עפאים יתנו קול."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> משקה הרים מעליותיו;",
                "> מפרי מעשיך תשבע הארץ."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> מצמיח חציר לבהמה,",
                "> ועשב לעבודת אדם,",
                "> להוציא לחם מן הארץ,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ויין ישמח לבב אנוש,",
                "> להצהיל פנים משמן,",
                "> ולחם לבב אנוש יסעד."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ישבעו עצי ה',",
                "> ארזי לבנון אשר נטע,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אשר שם ציפורים יקננו,",
                "> חסידה ברושים ביתה."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> הרים הגבוהים ליעלים;",
                "> סלעים מחסה לשפנים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> עשה ירח למועדים;",
                "> שמש ידע מבואו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> תשת חושך ויהי לילה,",
                "> בו תרמוש כל חיתו יער."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> הכפירים שואגים לטרף,",
                "> ולבקש מאל אכלם."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> תזרח השמש יאספון,",
                "> ואל מעונתם ירבצון."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> יצא אדם לפעלו",
                "> ולעבודתו עדי ערב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> מה רבו מעשיך ה'!",
                "> כולם בחכמה עשית;",
                "> מלאה הארץ קנייניך."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> זה הים גדול ורחב ידים,",
                "> שם רמש ואין מספר,",
                "> חיות קטנות עם גדולות."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> שם אניות יהלכון,",
                "> לויתן זה יצרת לשחק בו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> כולם אליך ישברון",
                "> לתת אכלם בעתו."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> תתן להם ילקוטון;",
                "> תפתח ידך ישבעון טוב."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> תסתיר פניך יבהלון;",
                "> תסף רוחם יגועון",
                "> ואל עפרם ישובון."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> תשלח רוחך יבראון;",
                "> ותחדש פני אדמה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> יהי כבוד ה' לעולם;",
                "> ישמח ה' במעשיו;"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> המביט לארץ ותרעד;",
                "> יגע בהרים ויעשנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> אשירה לה' בחיי;",
                "> אזמרה לאלוהי בעודי."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> יערב עליו שיחי;",
                "> אנוכי אשמח בה'."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> יתמו חטאים מן הארץ",
                "> ורשעים עוד אינם.",
                "> ברכי נפשי את ה'.",
                "> הללו יה!"
            ]
        }
    ]
}