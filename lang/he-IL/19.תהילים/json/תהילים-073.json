{
    "book": "תהילים",
    "chapter": 73,
    "verses": [
        {
            "text": [
                "מזמור לאסף."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אך טוב לישראל אלהים,",
                "> לברי לבב!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ואני כמעט נטיו רגלי,",
                "> כאין שפכו אשורי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי קנאתי בהוללים,",
                "> שלום רשעים אראה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי אין חרצובות למותם,",
                "> ובריא אולם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> בעמל אנוש אינמו,",
                "> ועם אדם לא ינגעו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> לכן ענק גאווה ענדמו,",
                "> יעטף שית חמס למו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יצא מחלב עינימו,",
                "> עברו משכיות לבב."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ילעיגו וידברו ברע,",
                "> עושק ממרום ידברו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> שתו בשמים פיהם,",
                "> ולשונם תהלך בארץ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לכן ישיב עמו הלום,",
                "> ומי מלא ימצו למו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ואמרו איך ידע אל,",
                "> ויש דעה בעליון."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הנה אלה רשעים,",
                "> ושלוי עולם השגו חיל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אך ריק זכיתי לבבי,",
                "> וארחץ בניקיון כפי."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ואהי נגוע כל היום,",
                "> ותוכחתי לבקרים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אם אמרתי אספרה כמו,",
                "> הנה דור בניך בגדתי."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ואחשבה לדעת זאת,",
                "> עמל היא בעיני."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> עד אבוא אל מקדשי אל,",
                "> אבינה לאחריתם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אך בחלקות תשית למו,",
                "> הפלתם למשואות."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> איך היו לשמה כהרף עין,",
                "> כלו תמו מן בלהות."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> כחלום מהקיץ אדני,",
                "> בעיר צלמם תבזה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> כי יתחמץ לבבי,",
                "> וכליותי אשתונן."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ואני בער ולא אדע,",
                "> בהמות הייתי עמך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ואני תמיד עמך,",
                "> אחזת ביד ימיני."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> בעצתך תנחני,",
                "> ואחר כבוד תקחני."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> מי לי בשמים,",
                "> ועמך לא חפצתי בארץ."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> כלה שארי ולבבי,",
                "> צור לבבי וחלקי אלוהים לעולם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> כי הנה רחקיך יאבדו,",
                "> הצמת כל זונה ממך."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> ואני קרבת אלוהים לי טוב,",
                "> שיתי באדני יהוה מחסי,",
                "> לספר כל מלאכותיך."
            ]
        }
    ]
}