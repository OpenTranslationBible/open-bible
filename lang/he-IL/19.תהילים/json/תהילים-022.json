{
    "book": "תהילים",
    "chapter": 22,
    "verses": [
        {
            "text": [
                "למנצח על אילת השחר. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלי אלי למה עזבתני?",
                "> רחוק מישועתי דברי שאגתי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אלי אקרא יומם ולא תענה;",
                "> ולילה ולא דומיה לי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ואתה קדוש,",
                "> יושב תהלות ישראל."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> בך בטחו אבותינו;",
                "> בטחו ותפלטמו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אליך זעקו ונמלטו;",
                "> בך בטחו ולא בושו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ואנכי תולעת ולא איש,",
                "> חרפת אדם ובזוי עם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כל רואי ילעגו לי;",
                "> יפטירו בשפה יניעו ראש, לאמר,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"גל אל ה' יפלטהו;",
                "> יצילהו כי חפץ בו.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אתה גוחי מבטן;",
                "> מבטיחי על שדי אמי."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> עליך השלכתי מרחם;",
                "> מבטן אמי אלי אתה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אל תרחק ממני כי צרה קרובה;",
                "> כי אין עוזר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> סבבוני פרים רבים;",
                "> אבירי בשן כתרוני."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> פצו עלי פיהם,",
                "> כאריה טורף ושואג."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כמים נשפכתי,",
                "> והתפרדו כל עצמותי;",
                "> היה לבי כדונג,",
                "> נמס בתוך מעי."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> יבש כחרש כחי,",
                "> ולשוני מדבק מלקוחי;",
                "> ולעפר מוות תשפתני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> כי סבבוני כלבים;",
                "> עדת מרעים הקיפוני;",
                "> כארי ידי ורגלי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אספר כל עצמותי.",
                "> המה יביטו יראו בי;"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> יחלקו בגדי להם,",
                "> ועל לבושי יפילו גורל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ואתה, ה', אל תרחק;",
                "> אילותי לעזרתי חושה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> הצילה מחרב נפשי,",
                "> מיד כלב יחידתי."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> הושיעני מפי אריה;",
                "> ומקרני רמים עניתני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אספרה שמך לאחיי;",
                "> בתוך קהל אהללך."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> יראי ה' הללוהו;",
                "> כל זרע יעקב כבדוהו,",
                "> וגורו ממנו כל זרע ישראל."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> כי לא בזה ולא שקץ ענות עני;",
                "> ולא הסתיר פניו ממנו;",
                "> ובשועו אליו שמע."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> מאתך תהלתי בקהל רב;",
                "> נדרי אשלם נגד יראיו."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> יאכלו ענווים וישבעו;",
                "> יהללו ה' דורשיו.",
                "> יחי לבבכם לעד!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> יזכרו וישובו אל ה' כל אפסי ארץ,",
                "> וישתחוו לפניך כל משפחות גויים."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> כי לה' המלוכה,",
                "> ומשל בגויים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> אכלו וישתחוו כל דשני ארץ,",
                "> לפניו יכרעו כל יורדי עפר,",
                "> ונפשו לא חיה."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> זרע יעבדנו;",
                "> יסופר לה' לדור."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> יבואו ויגידו צדקתו",
                "> לעם נולד, כי עשה."
            ]
        }
    ]
}