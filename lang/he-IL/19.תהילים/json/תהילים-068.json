{
    "book": "תהילים",
    "chapter": 68,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד. שיר."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> יקום אלהים יפוצו אויביו",
                "> וינוסו משנאיו מפניו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כהנדף עשן תנדף;",
                "> כדונג נמס מפני אש,",
                "> יאבדו רשעים מפני אלהים."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> וצדיקים ישמחו יעלצו לפני אלהים,",
                "> וישישו בשמחה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> שירו לאלהים, זמרו שמו;",
                "> סולו לרוכב בערבות,",
                "> ביה שמו ועלזו לפניו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אבי יתומים ודיין אלמנות,",
                "> אלהים במעון קדשו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אלהים מושיב יחידים ביתה;",
                "> מוציא אסירים בכושרות,",
                "> אך סוררים שכנו צחיחה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אלהים, בצאתך לפני עמך,",
                "> בצעדך בישימון,",
                "> סלה"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ארץ רעשה;",
                "> גם שמים נטפו מפני אלהים;",
                "> זה סיני מפני אלהים, אלהי ישראל."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> גשם נדבות תניף אלהים;",
                "> נחלתך ונלאה אתה כוננתה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> חיתך ישבו בה;",
                "> תכין בטובתך לעני אלהים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אדוני יתן אומר;",
                "> המבשרות צבא רב:"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מלכי צבאות ידודון ידודון,",
                "> ונשאר בית תחלק שלל."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אם תשכבון בין שפתיים,",
                "> כנפי יונה נחפה בכסף,",
                "> ואברותיה בירקרק חרוץ."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> בפרש שדי מלכים בה,",
                "> תשלג בצלמון."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הר אלהים הר בשן;",
                "> הר גבנונים הר בשן."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> למה תרצדון הרים גבנונים,",
                "> ההר חמד אלהים לשבתו?",
                "> אף אדוני ישכון לנצח."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> רכב אלהים רבותים אלפי שנאן;",
                "> אדוני בם סיני בקדש."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> עלית למרום, שבית שבי;",
                "> לקחת מתנות באדם,",
                "> ואף סוררים,",
                "> לשכן יה אלהים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ברוך אדוני, יום יום יעמס לנו,",
                "> האל ישועתנו.",
                "> סלה"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> האל לנו אל למושעות;",
                "> וליהוה אדוני למוות תוצאות."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אך אלהים ימחץ ראש אויביו,",
                "> קדקד שער מתהלך באשמיו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אמר אדוני, \"מבשן אשיב,",
                "> אשיב ממצולות ים,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> למען תמחץ רגלך בדם,",
                "> לשון כלביך מאויבים מנתם.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ראו הליכותיך אלהים,",
                "> הליכות אלי מלכי בקודש."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> קדמו שרים אחר נגנים,",
                "> בתוך עלמות תופפות."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> במקהלות ברכו אלהים,",
                "> אדוני ממקור ישראל."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> שם בנימין צעיר רודם,",
                "> שרי יהודה רגמתם,",
                "> שרי זבולון, שרי נפתלי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> צוה אלהיך עזך;",
                "> עוזה אלהים זו פעלת לנו."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> מהיכלך על ירושלם,",
                "> לך יובילו מלכים שי."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> גער חית קנה,",
                "> עדת אבירים בעגלי עמים,",
                "> מתרפס ברצי כסף;",
                "> בזר עמים קרבות יחפצו."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> יאתיו חשמנים ממצרים;",
                "> כוש תריץ ידיו לאלהים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> ממלכות הארץ שירו לאלהים,",
                "> זמרו אדוני,",
                "> סלה"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> לרוכב בשמי שמי קדם;",
                "> הן יתן בקולו קול עז."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> תנו עז לאלהים;",
                "> על ישראל גאותו,",
                "> ועזו בשחקים."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> נורא אלהים ממקדשיך.",
                "> אל ישראל הוא נותן עז ותעצמות לעם.",
                "> ברוך אלהים!"
            ]
        }
    ]
}