{
    "book": "תהילים",
    "chapter": 128,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אשרי כל ירא ה',",
                "> ההולך בדרכיו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יגיע כפיך כי תאכל,",
                "> אשריך וטוב לך."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אשתך כגפן פוריה בירכתי ביתך,",
                "> בניך כשתילי זיתים סביב לשולחנך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הנה כי כן יבורך גבר",
                "> ירא ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יברכך ה' מציון,",
                "> וראה בטוב ירושלים כל ימי חייך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> וראה בנים לבניך.",
                "> שלום על ישראל!"
            ]
        }
    ]
}