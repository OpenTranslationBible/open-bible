{
    "book": "תהילים",
    "chapter": 92,
    "verses": [
        {
            "text": [
                "מזמור שיר ליום השבת."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> טוב להודות לה'",
                "> ולזמר לשמך עליון;"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> להגיד בבוקר חסדך",
                "> ואמונתך בלילות,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> עלי עשור ועלי נבל,",
                "> עלי הגיון בכינור."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי שמחתני ה' בפעלך,",
                "> במעשי ידיך ארנן."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מה גדלו מעשיך ה',",
                "> מאד עמקו מחשבותיך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> איש בער לא ידע,",
                "> וכסיל לא יבין את זאת:"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בפרוח רשעים כמו עשב",
                "> ויציצו כל פעלי און,",
                "> להשמדם עדי עד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ואתה מרום לעולם ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי הנה אויביך ה',",
                "> כי הנה אויביך יאבדו;",
                "> יתפרדו כל פעלי און."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ותרם כראם קרני,",
                "> בלותי בשמן רענן."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ותבט עיני בשוררי,",
                "> בשמעי באזני קמים עלי מרעים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> צדיק כתמר יפרח,",
                "> כארז בלבנון ישגה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> שתולים בבית ה',",
                "> בחצרות אלוהינו יפריחו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> עוד ינובון בשיבה;",
                "> דשנים ורעננים יהיו,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> להגיד כי ישר ה';",
                "> צורי ולא עולתה בו."
            ]
        }
    ]
}