{
    "book": "תהילים",
    "chapter": 89,
    "verses": [
        {
            "text": [
                "משכיל לאיתן האזרחי."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> חסדי ה' עולם אשירה;",
                "> לדור ודור אודיע אמונתך בפי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כי אמרתי עולם חסד יבנה;",
                "> שמים תכין אמונתך בהם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כרתִי ברית לבחירי;",
                "> נשבעתי לדוד עבדי,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> עד עולם אכין זרעך,",
                "> ובניתי לדור ודור כסאך סלה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ויודו שמים פלאך ה',",
                "> אף אמונתך בקהל קדושים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי מי בשחק יערך לה',",
                "> ידמה לה' בבני אלים."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אל נערץ בסוד קדושים רבה,",
                "> ונורא על כל סביביו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ה' אלוהי צבאות, מי כמוך חסין יה?",
                "> ואמונתך סביבותיך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אתה מושל בגאות הים;",
                "> בשוא גליו אתה תשבחם."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אתה דיכאת כחלל רהב;",
                "> בזרוע עוזך פיזרת אויביך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> לך שמים אף לך ארץ;",
                "> תבל ומלואה אתה יסדתם."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> צפון וימין אתה בראתם;",
                "> תבור וחרמון בשמך ירננו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לך זרוע עם גבורה;",
                "> תעז ידך, תרום ימינך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> צדק ומשפט מכון כסאך;",
                "> חסד ואמת יקדמו פניך."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אשרי העם יודעי תרועה;",
                "> ה' באור פניך יהלכון."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> בשמך יגילון כל היום,",
                "> ובצדקתך ירומו."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי תפארת עוזם אתה,",
                "> וברצונך תרום קרננו."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> כי לה' מגננו,",
                "> ולקדוש ישראל מלכנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אז דברת בחזון לחסידיך,",
                "> ותאמר שויתי עזר על גיבור;",
                "> הרימותי בחור מעם."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> מצאתי דוד עבדי;",
                "> בשמן קדשי משחתיו,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אשר ידי תכון עמו;",
                "> אף זרועי תאמצנו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> לא ישא אויב בו,",
                "> ובן עוולה לא יעננו."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> וכתותי מפניו צריו,",
                "> ומשנאיו אגוף."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ואמונתי וחסדי עמו,",
                "> ובשמי תרום קרנו."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> ושמתי בים ידו,",
                "> ובנהרות ימינו."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> הוא יקראני אבי אתה,",
                "> אלי וצור ישועתי."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> אף אני בכור אתנהו,",
                "> עליון למלכי ארץ."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> לעולם אשמור לו חסדי,",
                "> ובריתי נאמנת לו."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> ושמתי לעד זרעו,",
                "> וכסאו כימי שמים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> אם יעזבו בניו תורתי,",
                "> ובמשפטי לא ילכו,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> אם חקתי יחללו,",
                "> ומצותי לא ישמרו,"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> ופקדתי בשבט פשעם,",
                "> ובנגעים עוונם."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> וחסדי לא אפיר מעמו,",
                "> ולא אשקר באמונתי."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> לא אחלל בריתי,",
                "> ומוצא שפתי לא אשנה."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> אחת נשבעתי בקדשי;",
                "> אם לדוד אכזב."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> זרעו לעולם יהיה,",
                "> וכסאו כשמש נגדי."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> כירח יכון עולם,",
                "> ועד בשחק נאמן סלה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> ואתה זנחת ותמאס,",
                "> התעברת עם משיחך."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> ניארת ברית עבדך;",
                "> חללת לארץ נזרו."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> פרצת כל גדרותיו;",
                "> שמת מבצריו מחתה."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> שסהו כל עוברי דרך;",
                "> היה חרפה לשכניו."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> הרימות ימינו צריו;",
                "> שמחת כל אויביו."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> אף תשיב צור חרבו,",
                "> ולא הקמתו במלחמה."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> השבת מטהו לטהר,",
                "> והשלכת כסאו לארץ."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> קצרת ימי עלומיו;",
                "> העטית עליו בושה סלה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> עד מה ה', תסתר לנצח?",
                "> תבער כמו אש חמתך?"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> זכר אני מה חלד;",
                "> על מה שוא בראת כל בני אדם!"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> מי גבר יחיה ולא יראה מות?",
                "> ימלט נפשו מיד שאול סלה."
            ]
        },
        {
            "verse": 49,
            "text": [
                "> איה חסדיך הראשונים, אדוני,",
                "> אשר נשבעת לדוד באמונתך?"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> זכר ה', חרפת עבדיך;",
                "> שאת בחיקי כל רבים עמים,"
            ]
        },
        {
            "verse": 51,
            "text": [
                "> אשר חרפו אויביך ה',",
                "> אשר חרפו עקבות משיחך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 52,
            "text": [
                "> ברוך ה' לעולם!",
                "> אמן ואמן."
            ]
        }
    ]
}