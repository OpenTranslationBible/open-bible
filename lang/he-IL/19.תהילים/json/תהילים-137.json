{
    "book": "תהילים",
    "chapter": 137,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> על נהרות בבל,",
                "> שם ישבנו גם בכינו,",
                "> בזכרנו את ציון."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> על ערבים בתוכה",
                "> תלינו כינורותינו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי שם שאלונו שובינו דברי שיר,",
                "> ותוללינו שמחה, לאמור,",
                "> \"שירו לנו משיר ציון!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> איך נשיר את שיר ה'",
                "> על אדמת נכר?"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אם אשכחך ירושלים,",
                "> תשכח ימיני."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> תדבק לשוני לחכי",
                "> אם לא אזכרכי,",
                "> אם לא אעלה את ירושלים",
                "> על ראש שמחתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> זכור ה', לבני אדום",
                "> את יום ירושלים,",
                "> האומרים, \"ערו ערו",
                "> עד היסוד בה!\""
            ]
        },
        {
            "verse": 8,
            "text": [
                "> בת בבל השדודה,",
                "> אשרי שישלם לך",
                "> את גמולך שגמלת לנו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אשרי שיאחז וניפץ את עולליך",
                "> אל הסלע."
            ]
        }
    ]
}