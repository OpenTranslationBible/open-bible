{
    "book": "תהילים",
    "chapter": 48,
    "verses": [
        {
            "text": [
                "שיר; מזמור לבני קרח."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> גדול ה' ומהולל מאוד",
                "> בעיר אלוהינו, בהר קודשו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יפה נוף, משוש כל הארץ,",
                "> הר ציון ירכתי צפון,",
                "> קריית מלך רב."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אלוהים נודע בארמנותיה",
                "> למשגב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי הנה המלכים נועדו,",
                "> עברו יחדיו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> המה ראו כן תמהו;",
                "> נבהלו נחפזו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> רעדה אחזתם שם,",
                "> חיל כיולדה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ברוח קדים",
                "> תשבר אניות תרשיש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כאשר שמענו, כן ראינו",
                "> בעיר ה' צבאות, בעיר אלוהינו;",
                "> אלוהים יכוננה עד עולם.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> דמינו אלוהים חסדך",
                "> בקרב היכלך."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כשמך אלוהים כן תהילתך",
                "> על קצוות הארץ;",
                "> צדק מלאה ימינך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ישמח הר ציון,",
                "> תגלנה בנות יהודה",
                "> למען משפטיך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> סובו ציון והקיפוה;",
                "> ספרו מגדליה;"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> שיתו לבכם לחילה;",
                "> פסגו ארמנותיה,",
                "> למען תספרו לדור אחרון."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי זה אלוהים אלוהינו עולם ועד;",
                "> הוא ינהגנו על מות."
            ]
        }
    ]
}