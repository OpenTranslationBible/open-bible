{
    "book": "תהילים",
    "chapter": 122,
    "verses": [
        {
            "text": [
                "שיר המעלות. לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> שמחתי באומרים לי,",
                "> \"נלך אל בית ה'.\""
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עומדות היו רגלינו",
                "> בשערייך, ירושלים,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ירושלים הבנויה",
                "> כעיר שחוברה לה יחדיו;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ששם עולים השבטים, שבטי יה,",
                "> עדות לישראל,",
                "> להודות לשם ה'."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי שמה ישבו כסאות למשפט,",
                "> כסאות לבית דוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> שאלו שלום ירושלים:",
                "> \"ישליו אוהבייך."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יהי שלום בחילך,",
                "> שלווה בארמנותייך.\""
            ]
        },
        {
            "verse": 8,
            "text": [
                "> למען אחיי ורעיי,",
                "> אדברה נא שלום בך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> למען בית ה' אלוהינו,",
                "> אבקשה טוב לך."
            ]
        }
    ]
}