{
    "book": "תהילים",
    "chapter": 77,
    "verses": [
        {
            "text": [
                "למנצח על ידותון לאסף מזמור"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> קולי אל אלוהים ואצעק;",
                "> קולי אל אלוהים והוא יאזין לי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ביום צרתי את ה' דרשתי;",
                "> בלילה ידי נמשכה ולא נלאתה;",
                "> נפשי מאנה להתנחם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אזכרה אלוהים ואהמיה;",
                "> אשיחה ותתעטף רוחי.",
                "> סלה"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אחזת שמרות עיני;",
                "> נבהלתי ולא אדבר."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> חשבתי ימים מקדם,",
                "> שנות עולמים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אזכרה נגינתי בלילה;",
                "> עם לבבי אשיחה,",
                "> ויחפש רוחי:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הלעולמים יזנח אדני?",
                "> ולא יוסיף לרצות עוד?"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> האפס לנצח חסדו?",
                "> גמר אמר לדור ודור?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> השכח חנות אל?",
                "> אם קפץ באף רחמיו?",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ואמר, \"חולייתי היא,",
                "> שנות ימינו של עליון השתנו.\""
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אזכרה מעללי יהוה;",
                "> כי אזכרה מקדם פלאך."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והגיתי בכל פעלך,",
                "> ובעלילותיך אשיחה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אלוהים, בקודש דרכך;",
                "> מי אל גדול כאלוהים?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אתה האל עושה פלא;",
                "> הודעת בעמים עוזך."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> גאלת בזרוע עמך,",
                "> בני יעקב ויוסף.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ראוך מים אלוהים;",
                "> ראוך מים יחילו;",
                "> אף ירגזו תהומות."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> זרמו מים עבות;",
                "> קול נתנו שחקים;",
                "> אף חצציך יתהלכו."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> קול רעמך בגלגל;",
                "> האירו ברקים תבל;",
                "> רגזה ותרעש הארץ."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> בים דרכך,",
                "> ושבילך במים רבים,",
                "> ועקבותיך לא נודעו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> נחית כצאן עמך",
                "> ביד משה ואהרן."
            ]
        }
    ]
}