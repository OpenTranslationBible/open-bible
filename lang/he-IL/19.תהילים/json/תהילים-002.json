{
    "book": "תהילים",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> למה רגשו גוים,",
                "> ולאמים יהגו ריק?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יתייצבו מלכי ארץ,",
                "> ורוזנים נוסדו יחד",
                "> על ה' ועל משיחו, לאמר:"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"ננתקה את מוסרותימו,",
                "> ונשליכה ממנו עבותימו!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יושב בשמים ישחק,",
                "> אדוני ילעג למו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אז ידבר אלימו באפו,",
                "> ובחרונו יבהלמו, לאמר:"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> \"ואני נסכתי מלכי",
                "> על ציון הר קדשי.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "אספרה אל חוק:",
                "> ה' אמר אלי, \"בני אתה,",
                "> אני היום ילדתיך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> שאל ממני ואתנה גוים נחלתך,",
                "> ואחזתך אפסי ארץ."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> תרעם בשבט ברזל,",
                "> ככלי יוצר תנפצם.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ועתה, מלכים, השכילו;",
                "> הוסרו שופטי ארץ."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> עבדו את ה' ביראה,",
                "> וגילו ברעדה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> נשקו בר, פן יאנף ותאבדו דרך,",
                "> כי יבער כמעט אפו.",
                "> אשרי כל חוסי בו."
            ]
        }
    ]
}