{
    "book": "תהילים",
    "chapter": 87,
    "verses": [
        {
            "text": [
                "מזמור לבני קרח. שיר."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> יסודו בהררי קודש."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אוהב ה' שערי ציון",
                "> מכל משכנות יעקב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> נכבדים מדברים בך,",
                "> עיר האלוהים.",
                "> סלה"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"אזכיר רהב ובבל לידעי;",
                "> הנה פלשת וצור עם כוש:",
                "> 'זה יולד שם.'\""
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ולציון יאמר, \"איש ואיש יולד בה\";",
                "> והוא יכוננה עליון."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ה' יספר בכתוב עמים:",
                "> \"זה יולד שם.\"",
                "> סלה"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ושרים כחללים כל מעייני בך."
            ]
        }
    ]
}