{
    "book": "תהילים",
    "chapter": 41,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אשרי משכיל אל דל;",
                "> ביום רעה ימלטהו יהוה."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יהוה ישמרהו ויחיהו,",
                "> ואשר בארץ תאשר;",
                "> ואל תתנהו בנפש אויביו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יהוה יסעדהו על ערש דוי;",
                "> כל משכבו הפכת בחליו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אני אמרתי, \"יהוה חנני;",
                "> רפאה נפשי כי חטאתי לך.\""
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אויבי יאמרו רע לי,",
                "> \"מתי ימות ואבד שמו?\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ואם בא לראות שוא ידבר;",
                "> לבו יקבץ און לו;",
                "> יצא לחוץ ידבר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יחד עלי יתלחשו כל שונאי;",
                "> עלי יחשבו רעה לי, אומרים,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"דבר בליעל יצוק בו,",
                "> ואשר שכב לא יוסיף לקום.\""
            ]
        },
        {
            "verse": 9,
            "text": [
                "> גם איש שלומי אשר בטחתי בו,",
                "> אוכל לחמי,",
                "> הגדיל עלי עקב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ואתה, יהוה, חנני והקימני,",
                "> ואשלמה להם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> בזאת ידעתי כי חפצת בי,",
                "> כי לא יריע אויבי עלי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ואני בתמי תמכת בי,",
                "> ותציבני לפניך לעולם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ברוך יהוה אלהי ישראל,",
                "> מהעולם ועד העולם.",
                "> אמן ואמן."
            ]
        }
    ]
}