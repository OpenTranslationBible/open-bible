{
    "book": "תהילים",
    "chapter": 6,
    "verses": [
        {
            "text": [
                "למנצח בנגינות על השמינית מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה', אל תוכיחני באפך,",
                "> ואל תיסרני בחמתך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> חנני ה', כי אמלל אני;",
                "> רפאני ה', כי נבהלו עצמי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ונפשי נבהלה מאוד;",
                "> ואתה, ה', עד מתי?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> שוב ה', חלצה נפשי;",
                "> הושיעני למען חסדך."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי אין במוות זכרך;",
                "> בשאול מי יודה לך?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> יגעתי באנחתי;",
                "> אשחה בכל לילה מיטתי,",
                "> בדמעתי ערשי אמסה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> עשתה מכעס עיני;",
                "> עתקה מכל צוררי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> סורו ממני כל פועלי און,",
                "> כי שמע ה' קול בכיי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> שמע ה' תחינתי,",
                "> ה' תפילתי יקח."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יבושו ויבהלו מאוד כל אויבי;",
                "> ישובו יבושו רגע."
            ]
        }
    ]
}