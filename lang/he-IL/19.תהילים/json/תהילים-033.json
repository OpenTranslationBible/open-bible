{
    "book": "תהילים",
    "chapter": 33,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> רננו צדיקים ביהוה;",
                "> לישרים נאוה תהילה."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הודו ליהוה בכינור;",
                "> בנבל עשור זמרו לו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> שירו לו שיר חדש;",
                "> היטיבו נגן בתרועה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי ישר דבר יהוה,",
                "> וכל מעשהו באמונה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אהב צדקה ומשפט;",
                "> חסד יהוה מלאה הארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> בדבר יהוה שמים נעשו,",
                "> וברוח פיו כל צבאם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כונס כנד מי הים;",
                "> נותן באוצרות תהומות."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ייראו מיהוה כל הארץ;",
                "> ממנו יגורו כל יושבי תבל."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי הוא אמר ויהי;",
                "> הוא ציווה ויעמוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יהוה הפיר עצת גויים;",
                "> הניא מחשבות עמים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> עצת יהוה לעולם תעמוד,",
                "> מחשבות לבו לדור ודור."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אשרי הגוי אשר יהוה אלהיו,",
                "> העם בחר לנחלה לו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> מִשָּׁמַיִם הִבִּיט יְהוָה;",
                "> רָאָה אֶת כָּל בְּנֵי הָאָדָם;"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> מִמְּכוֹן שִׁבְתּוֹ הִשְׁגִּיחַ",
                "> אֶל כָּל יֹשְׁבֵי הָאָרֶץ,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הַיֹּצֵר יַחַד לִבָּם,",
                "> הַמֵּבִין אֶל כָּל מַעֲשֵׂיהֶם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אֵין הַמֶּלֶךְ נוֹשָׁע בְּרֹב חָיִל;",
                "> גִּבּוֹר לֹא יִנָּצֵל בְּרֹב כֹּחַ."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> שֶׁקֶר הַסּוּס לִתְשׁוּעָה;",
                "> וּבְרֹב חֵילוֹ לֹא יְמַלֵּט."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> הִנֵּה עֵין יְהוָה אֶל יְרֵאָיו,",
                "> לַמְיַחֲלִים לְחַסְדּוֹ,"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> לְהַצִּיל מִמָּוֶת נַפְשָׁם",
                "> וּלְחַיּוֹתָם בָּרָעָב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> נַפְשֵׁנוּ חִכְּתָה לַיהוָה;",
                "> עֶזְרֵנוּ וּמָגִנֵּנוּ הוּא."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> כִּי בוֹ יִשְׂמַח לִבֵּנוּ,",
                "> כִּי בְשֵׁם קָדְשׁוֹ בָטָחְנוּ."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> יְהִי חַסְדְּךָ יְהוָה עָלֵינוּ,",
                "> כַּאֲשֶׁר יִחַלְנוּ לָךְ."
            ]
        }
    ]
}