{
    "book": "תהילים",
    "chapter": 69,
    "verses": [
        {
            "text": [
                "למנצח על שושנים. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הושיעני, אלוהים,",
                "> כי באו מים עד נפש."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> טבעתי ביון מצולה ואין מעמד;",
                "> באתי במעמקי מים ושוטף שוטף אותי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יגעתי בקראי, נחר גרוני;",
                "> כלו עיני מיחל לאלוהי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> רבו משערות ראשי שונאי חנם;",
                "> עצמו מצמיתי איבי שקר;",
                "> אשר לא גזלתי אז אשיב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אלוהים, אתה ידעת לאולתי,",
                "> ואשמותי ממך לא נכחדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אל יבושו בי קויך, אדוני אלוהים צבאות;",
                "> אל יכלמו בי מבקשיך, אלוהי ישראל,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי עליך נשאתי חרפה;",
                "> כסתה כלמה פני."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> מוזר הייתי לאחי,",
                "> ונכרי לבני אמי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי קנאת ביתך אכלתני,",
                "> וחרפות חורפיך נפלו עלי."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ואבכה בצום נפשי,",
                "> ותהי לחרפות לי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ואתנה לבושי שק,",
                "> ואהי להם למשל."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ישיחו בי יושבי שער,",
                "> ונגינות שותי שכר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ואני תפלתי לך, אדוני, עת רצון;",
                "> אלוהים, ברב חסדך,",
                "> ענני באמת ישעך."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> הצילני מטיט ואל אטבעה;",
                "> אנצל משונאי וממעמקי מים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אל תשפכני שוטף מים",
                "> ואל תבלעני מצולה,",
                "> ואל תאטר עלי באר פיה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ענני, אדוני, כי טוב חסדך;",
                "> כרב רחמיך פנה אלי,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ואל תסתר פניך מעבדך,",
                "> כי צר לי; מהר ענני."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> קרבה אל נפשי גאלה;",
                "> למען אויבי פדני!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אתה ידעת חרפתי ובושתי וכלמתי;",
                "> נגדך כל צוררי."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> חרפה שברה לבי ואנוש;",
                "> ואקוה לנוד ואין,",
                "> ולמנחמים ולא מצאתי."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ויתנו בברותי ראש,",
                "> ולצמאוני ישקוני חומץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> יהי שולחנם לפניהם לפח;",
                "> ולשלומים למוקש."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> תחשכנה עיניהם מראות,",
                "> ומותניהם תמיד המעד."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> שפך עליהם זעמך,",
                "> וחרון אפך ישיגם."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> תהי טירתם נשמה;",
                "> באהליהם אל יהי יושב."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> כי אתה אשר הכית רדפו,",
                "> ואל מכאוב חלליך יספרו."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> תנה עוון על עוונם,",
                "> ואל יבואו בצדקתך."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> ימחו מספר חיים,",
                "> ועם צדיקים אל יכתבו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> ואני עני וכואב;",
                "> ישועתך, אלוהים, תשגבני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> אהללה שם אלוהים בשיר,",
                "> ואגדלנו בתודה."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> ותיטב לאדוני משור פר,",
                "> מקרן מפריס."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> ראו ענוים ישמחו;",
                "> דרשי אלוהים ויחי לבבכם."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> כי שומע אלוהים אביונים,",
                "> ואת אסיריו לא בזה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> יהללוהו שמים וארץ,",
                "> ימים וכל רומש בם."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> כי אלוהים יושיע ציון ויבנה ערי יהודה,",
                "> וישבו שם וירשוה."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> וזרע עבדיו ינחלוה,",
                "> ואוהבי שמו ישכנו בה."
            ]
        }
    ]
}