{
    "book": "תהילים",
    "chapter": 118,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הודו לה', כי טוב;",
                "> כי לעולם חסדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יאמר נא ישראל,",
                "> כי לעולם חסדו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יאמרו נא בית אהרן,",
                "> כי לעולם חסדו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יאמרו נא יראי ה',",
                "> כי לעולם חסדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מן המצר קראתי יה;",
                "> ענני במרחב יה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ה' לי, לא אירא;",
                "> מה יעשה לי אדם?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ה' לי בעוזרי;",
                "> ואני אראה בשונאי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> טוב לחסות בה'",
                "> מבטוח באדם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> טוב לחסות בה'",
                "> מבטוח בנדיבים."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כל גויים סבבוני;",
                "> בשם ה' כי אמילם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> סבוני גם סבבוני;",
                "> בשם ה' כי אמילם."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> סבוני כדבורים;",
                "> דועכו כאש קוצים;",
                "> בשם ה' כי אמילם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> דחיתני לנפול,",
                "> וה' עזרני."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> עזי וזמרת יה,",
                "> ויהי לי לישועה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> קול רינה וישועה באהלי צדיקים;",
                "> ימין ה' עשה חיל."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ימין ה' רוממה;",
                "> ימין ה' עשה חיל."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> לא אמות כי אחיה,",
                "> ואספר מעשי יה."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> יסר יסרני יה,",
                "> ולמוות לא נתנני."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> פתחו לי שערי צדק;",
                "> אבוא בם אודה יה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> זה השער לה';",
                "> צדיקים יבואו בו."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אודך כי עניתני,",
                "> ותהי לי לישועה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אבן מאסו הבונים",
                "> הייתה לראש פינה."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> מאת ה' הייתה זאת;",
                "> היא נפלאת בעינינו."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> זה היום עשה ה';",
                "> נגילה ונשמחה בו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> אנא ה', הושיעה נא;",
                "> אנא ה', הצליחה נא!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> ברוך הבא בשם ה';",
                "> ברכנוכם מבית ה'."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> אל ה' ויאר לנו;",
                "> אסרו חג בעבותים עד קרנות המזבח."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> אלי אתה ואודך;",
                "> אלי ארוממך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> הודו לה', כי טוב;",
                "> כי לעולם חסדו."
            ]
        }
    ]
}