{
    "book": "תהילים",
    "chapter": 102,
    "verses": [
        {
            "text": [
                "תפילה לעני כי יעטוף ולפני ה' ישפוך שיחו."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה' שמעה תפלתי,",
                "> ושועתי אליך תבוא."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אל תסתר פניך ממני ביום צר לי,",
                "> הטה אלי אוזנך;",
                "> ביום אקרא מהרה ענני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי כלו בעשן ימי,",
                "> ועצמותי כמו קידר נחרו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הוכה לבי ויבש כמו עשב,",
                "> כי שכחתי מאכל לחמי."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מקול אנחתי,",
                "> דבקה עצמי לבשרי."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> דמיתי לקאת מדבר,",
                "> הייתי ככוס חורבות."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שקדתי,",
                "> ואהיה כציפור בודד על גג."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כל היום חרפוני אויבי,",
                "> מהוללי בי נשבעו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אפר כלחם אכלתי,",
                "> ושקוי בבכי מסכתי."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> מפני זעמך וקצפך,",
                "> כי נשאתני ותשליכני."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ימי כצל נטוי,",
                "> ואני כעשב איבש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ואתה ה' לעולם תשב,",
                "> וזכרך לדור ודור."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אתה תקום תרחם ציון,",
                "> כי עת לחננה,",
                "> כי בא מועד."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי רצו עבדיך את אבניה,",
                "> ואת עפרה יחוננו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> וייראו גוים את שם ה',",
                "> וכל מלכי הארץ את כבודך."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> כי בנה ה' ציון,",
                "> נראה בכבודו."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> פנה אל תפלת הערער,",
                "> ולא בזה את תפלתם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> תכתב זאת לדור אחרון,",
                "> ועם נברא יהלל יה."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> כי השקיף ממרום קדשו,",
                "> ה' משמים אל ארץ הביט,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> לשמע אנקת אסיר,",
                "> לפתח בני תמותה,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> לספר בציון שם ה',",
                "> ותהילתו בירושלים,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> בהקבץ עמים יחדו,",
                "> וממלכות לעבוד את ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ענה בדרך כחי,",
                "> קצר ימי."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> אמרתי, \"אלי, אל תעלני בחצי ימי,",
                "> בדור ודור שנותיך."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> לפנים הארץ יסדת,",
                "> ומעשה ידיך שמים."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> המה יאבדו ואתה תעמוד,",
                "> וכלם כבגד יבלו;",
                "> כלבוש תחליפם ויחלופו."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> ואתה הוא ושנותיך לא יתמו."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> בני עבדיך ישכונו,",
                "> וזרעם לפניך יכון.\""
            ]
        }
    ]
}