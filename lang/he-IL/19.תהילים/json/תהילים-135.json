{
    "book": "תהילים",
    "chapter": 135,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> שבחו את שם ה';",
                "> הללו, עבדי ה',"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> העומדים בבית ה',",
                "> בחצרות בית אלוהינו!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הללו את ה', כי טוב ה';",
                "> זמרו לשמו, כי נעים הוא."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי יעקב בחר לו יה,",
                "> ישראל לסגולתו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי ידעתי כי גדול ה',",
                "> ואדוננו מכל אלוהים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כל אשר חפץ ה' עשה,",
                "> בשמים ובארץ, בימים ובכל תהומות."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מעלה נשיאים מקצה הארץ,",
                "> ברקים למטר עשה,",
                "> מוצא רוח מאוצרותיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> שהכה בכורי מצרים,",
                "> מאדם עד בהמה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> שלח אותות ומופתים בתוככי מצרים,",
                "> בפרעה ובכל עבדיו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> שהכה גויים רבים",
                "> והרג מלכים עצומים:"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> סיחון מלך האמורי,",
                "> ועוג מלך הבשן,",
                "> וכל ממלכות כנען;"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ונתן ארצם נחלה,",
                "> נחלה לישראל עמו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ה', שמך לעולם,",
                "> ה', זכרך לדור ודור."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי ידין ה' עמו",
                "> ועל עבדיו יתנחם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> עצבי הגויים כסף וזהב,",
                "> מעשה ידי אדם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> פה להם ולא ידברו;",
                "> עיניים להם ולא יראו;"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אוזניים להם ולא ישמעו,",
                "> אף אין רוח בפיהם."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> כמוהם יהיו עושיהם,",
                "> כל אשר בטח בהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> בית ישראל, ברכו את ה';",
                "> בית אהרן, ברכו את ה';"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> בית לוי, ברכו את ה';",
                "> יראי ה', ברכו את ה'."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ברוך ה' מציון,",
                "> שכן ירושלים.",
                "> הללו את ה'!"
            ]
        }
    ]
}