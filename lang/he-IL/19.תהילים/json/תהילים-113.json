{
    "book": "תהילים",
    "chapter": 113,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "---",
                "> הללו עבדי ה',",
                "> הללו את שם ה'."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יהי שם ה' מבורך",
                "> מעתה ועד עולם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ממזרח שמש עד מבואו,",
                "> מהולל שם ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> רם על כל גויים ה',",
                "> על השמים כבודו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מי כיהוה אלוהינו,",
                "> המגביהי לשבת,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> המשפילי לראות",
                "> בשמים ובארץ?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מקימי מעפר דל,",
                "> מאשפות ירים אביון,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> להושיבי עם נדיבים,",
                "> עם נדיבי עמו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מושיבי עקרת הבית",
                "> אם הבנים שמחה.",
                "> הללו את ה'!"
            ]
        }
    ]
}