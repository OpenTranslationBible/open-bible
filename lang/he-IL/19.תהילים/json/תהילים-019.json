{
    "book": "תהילים",
    "chapter": 19,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> השמים מספרים כבוד אל;",
                "> ומעשה ידיו מגיד הרקיע."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יום ליום יביע אומר,",
                "> ולילה ללילה יחוה דעת."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אין אומר ואין דברים;",
                "> בלי נשמע קולם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> בכל הארץ יצא קום,",
                "> ובקצה תבל מליהם.",
                "> להם שם אהל לשמש,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> והוא כחתן יוצא מחופתו;",
                "> ישיש כגבור לרוץ אורח."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> מקצה השמים מוצאו,",
                "> ותקופתו על קצותם;",
                "> ואין נסתר מחמתו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> תורת ה' תמימה, משיבת נפש;",
                "> עדות ה' נאמנה, מחכימת פתי."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> פקודי ה' ישרים, משמחי לב;",
                "> מצות ה' ברה, מאירת עינים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יראת ה' טהורה, עומדת לעד;",
                "> משפטי ה' אמת, צדקו יחדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> הנחמדים מזהב ומפז רב;",
                "> ומתוקים מדבש ונפת צופים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> גם עבדך נזהר בהם;",
                "> בשמרם עקב רב."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> שגיאות מי יבין?",
                "> מנסתרות נקני."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> גם מזדים חשוך עבדך;",
                "> אל ימשלו בי;",
                "> אז איתם,",
                "> ונקיתי מפשע רב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> יהיו לרצון אמרי פי והגיון לבי",
                "> לפניך,",
                "> ה', צורי וגואלי."
            ]
        }
    ]
}