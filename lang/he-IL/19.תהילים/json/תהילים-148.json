{
    "book": "תהילים",
    "chapter": 148,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> הללו את ה' מן השמים;",
                "> הללו במרומים!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הללו כל מלאכיו;",
                "> הללו כל צבאיו!"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הללו שמש וירח;",
                "> הללו כל כוכבי אור!"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הללו שמי השמים,",
                "> והמים אשר מעל השמים!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יהללו את שם ה',",
                "> כי הוא ציווה ונבראו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ויעמידם לעד לעולם;",
                "> חק נתן ולא יעבור."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הללו את ה' מן הארץ,",
                "> תנינים וכל תהומות;"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אש וברד, שלג וקיטור;",
                "> רוח סערה עושה דברו;"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ההרים וכל גבעות;",
                "> עץ פרי וכל ארזים;"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> החיה וכל בהמה;",
                "> רמש וציפור כנף;"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> מלכי ארץ וכל לאומים;",
                "> שרים וכל שופטי ארץ;"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> בחורים וגם בתולות;",
                "> זקנים עם נערים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יהללו את שם ה',",
                "> כי נשגב שמו לבדו;",
                "> הודו על ארץ ושמים."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> וירם קרן לעמו,",
                "> תהילה לכל חסידיו,",
                "> לבני ישראל עם קרובו.",
                "> הללו את ה'!"
            ]
        }
    ]
}