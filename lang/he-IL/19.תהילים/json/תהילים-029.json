{
    "book": "תהילים",
    "chapter": 29,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הבו לה' בני אלים,",
                "> הבו לה' כבוד ועוז."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הבו לה' כבוד שמו;",
                "> השתחוו לה' בהדרת קודש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> קול ה' על המים,",
                "> אל הכבוד הרעים,",
                "> ה' על מים רבים."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> קול ה' בכוח,",
                "> קול ה' בהדר."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> קול ה' שובר ארזים,",
                "> וישבר ה' את ארזי הלבנון."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> וירקידם כמו עגל,",
                "> לבנון ושריון כמו בן רים."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> קול ה' חוצב להבות אש."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> קול ה' יחיל מדבר,",
                "> יחיל ה' מדבר קדש."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> קול ה' יחולל אילות",
                "> ויחשוף יערות;",
                "> ובהיכלו כולו אומר כבוד."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ה' למבול ישב,",
                "> וישב ה' מלך לעולם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ה' עוז לעמו יתן,",
                "> ה' יברך את עמו בשלום."
            ]
        }
    ]
}