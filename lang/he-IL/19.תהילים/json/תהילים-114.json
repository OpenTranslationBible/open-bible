{
    "book": "תהילים",
    "chapter": 114,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> בצאת ישראל ממצרים,",
                "> בית יעקב מעם לועז,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הייתה יהודה לקדשו,",
                "> ישראל ממשלותיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הים ראה וינס,",
                "> הירדן יסוב לאחור."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ההרים רקדו כאילים,",
                "> גבעות כבני צאן."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מה לך הים כי תנוס?",
                "> הירדן תסוב לאחור?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הרים תרקדו כאילים?",
                "> גבעות כבני צאן?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מלפני אדון חולי ארץ,",
                "> מלפני אלוה יעקב,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ההופך הצור אגם מים,",
                "> חלמיש למעיין מים."
            ]
        }
    ]
}