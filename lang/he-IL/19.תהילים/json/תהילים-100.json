{
    "book": "תהילים",
    "chapter": 100,
    "verses": [
        {
            "text": [
                "מזמור לתודה."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הריעו לה' כל הארץ."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> עבדו את ה' בשמחה;",
                "> בואו לפניו ברננה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> דעו כי ה' הוא אלוהים;",
                "> הוא עשנו ולא אנחנו;",
                "> עמו וצאן מרעיתו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> בואו שעריו בתודה,",
                "> חצרותיו בתהילה.",
                "> הודו לו, ברכו שמו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי טוב ה';",
                "> חסדו לעולם,",
                "> ואמונתו לדור ודור."
            ]
        }
    ]
}