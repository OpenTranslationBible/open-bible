{
    "book": "תהילים",
    "chapter": 93,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ה' מלך, גאות לבש;",
                "> לבש ה' עוז התאזר.",
                "> אף תיכון תבל, בל תימוט."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> נכון כסאך מאז;",
                "> מעולם אתה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> נשאו נהרות ה',",
                "> נשאו נהרות קולם,",
                "> ישאו נהרות דכים."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מקולות מים רבים,",
                "> אדירים משברי ים,",
                "> אדיר במרום ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> עדותיך נאמנו מאד;",
                "> לביתך נאוה קודש,",
                "> ה' לאורך ימים."
            ]
        }
    ]
}