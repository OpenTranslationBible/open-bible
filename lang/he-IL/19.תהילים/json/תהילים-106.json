{
    "book": "תהילים",
    "chapter": 106,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "---",
                "> הודו לה' כי טוב,",
                "> כי לעולם חסדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> מי ימלל גבורות ה',",
                "> ישמיע כל תהילתו?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אשרי שומרי משפט,",
                "> עושי צדקה בכל עת!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> זכרני ה' ברצון עמך,",
                "> פקדני בישועתך,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לראות בטובת בחיריך,",
                "> לשמוח בשמחת גויך,",
                "> להתהלל עם נחלתך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> חטאנו עם אבותינו,",
                "> העוינו, הרשענו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אבותינו במצרים לא השכילו נפלאותיך,",
                "> לא זכרו את רוב חסדיך,",
                "> וימרו על ים בים סוף."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ויושיעם למען שמו,",
                "> להודיע את גבורתו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ויגער בים סוף ויחרב,",
                "> ויוליכם בתהומות כמדבר."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ויושיעם מיד שונא,",
                "> ויגאלם מיד אויב."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ויכסו מים צריהם,",
                "> אחד מהם לא נותר."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ויאמינו בדבריו,",
                "> ישירו תהילתו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> מהר שכחו מעשיו,",
                "> לא חיכו לעצתו,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ויתאוו תאוה במדבר,",
                "> וינסו אל בישימון."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ויתן להם שאלתם,",
                "> וישלח רזון בנפשם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ויקנאו למשה במחנה,",
                "> לאהרן קדוש ה'."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> תפתח ארץ ותבלע דתן,",
                "> ותחס על עדת אבירם."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ותבער אש בעדתם,",
                "> להבה תלהט רשעים."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> יעשו עגל בחרב,",
                "> וישתחוו למסכה."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> וימירו את כבודם",
                "> בתבנית שור אוכל עשב."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> שכחו אל מושיעם,",
                "> עשה גדולות במצרים,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> נפלאות בארץ חם,",
                "> נוראות על ים סוף."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ויאמר להשמידם,",
                "> לולי משה בחירו עמד בפרץ לפניו,",
                "> להשיב חמתו מהשחית."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> וימאסו בארץ חמדה,",
                "> לא האמינו לדברו,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> וירגנו באהליהם,",
                "> לא שמעו בקול ה'."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> וישא ידו להם",
                "> להפיל אותם במדבר,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> ולהפיל זרעם בגוים,",
                "> ולזרותם בארצות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> ויצמדו לבעל פעור,",
                "> ויאכלו זבחי מתים."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> ויכעיסו במעלליהם,",
                "> ותפרץ בם מגפה."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> ויעמד פינחס ויפלל,",
                "> ותעצר המגפה."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> ותחשב לו לצדקה,",
                "> לדור ודור עד עולם."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> ויקציפו על מי מריבה,",
                "> וירע למשה בעבורם;"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> כי המרו את רוחו,",
                "> ויבטא בשפתיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> לא השמידו את העמים,",
                "> אשר אמר ה' להם,"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> ויתערבו בגוים",
                "> וילמדו מעשיהם,"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> ויעבדו את עצביהם,",
                "> ויהיו להם למוקש."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> ויזבחו את בניהם",
                "> ואת בנותיהם לשדים,"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> וישפכו דם נקי,",
                "> דם בניהם ובנותיהם,",
                "> אשר זבחו לעצבי כנען;",
                "> ותחנף הארץ בדמים."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> ויטמאו במעשיהם,",
                "> ויזנו במעלליהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ויחר אף ה' בעמו,",
                "> ויתעב את נחלתו."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> ויתנם ביד גוים,",
                "> וישלטו בהם שונאיהם."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> וילחצום אויביהם,",
                "> ויכנעו תחת ידם."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> פעמים רבות יצילם;",
                "> והמה ימרו בעצתם,",
                "> וימכו בעונם."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> וירא בצר להם",
                "> בשמעו את רנתם;"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> ויזכר להם בריתו,",
                "> וינחם כרב חסדו."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> ויתן אותם לרחמים",
                "> לפני כל שוביהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> הושיענו ה' אלוהינו,",
                "> וקבצנו מן הגוים,",
                "> להודות לשם קדשך",
                "> להשתבח בתהילתך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> ברוך ה' אלוהי ישראל,",
                "> מן העולם ועד העולם.",
                "> ואמר כל העם, \"אמן.\"",
                "> הללו את ה'!"
            ]
        }
    ]
}