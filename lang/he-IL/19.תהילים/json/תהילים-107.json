            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יושבי חושך וצלמות,",
                "> אסירי עני וברזל,"
            ]
        },
        {
            "verse": 11,
            "text": [
