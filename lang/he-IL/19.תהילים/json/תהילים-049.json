{
    "book": "תהילים",
    "chapter": 49,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לבני קרח."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> שמעו זאת כל העמים;",
                "> האזינו כל יושבי חלד,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> גם בני אדם גם בני איש,",
                "> יחד עשיר ואביון."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> פי ידבר חכמות,",
                "> והגות לבי תבונות."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אטה למשל אוזני;",
                "> אפתח בכנור חידתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> למה אירא בימי רע,",
                "> עוון עקבי יסובני,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הבוטחים על חילם",
                "> וברוב עשרם יתהללו?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אח לא פדה יפדה איש,",
                "> לא יתן לאלוהים כופרם—"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ויקר פדיון נפשם,",
                "> וחדל לעולם—"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ויחי עוד לנצח,",
                "> לא יראה השחת."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי יראה חכמים ימותו;",
                "> יחד כסיל ובער יאבדו",
                "> ועזבו לאחרים חילם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> קרבם בתיהם לעולם",
                "> משכנותם לדור ודור;",
                "> קראו בשמותם עלי אדמות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ואדם ביקר בל ילין;",
                "> נמשל כבהמות נדמו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> זה דרכם כסל למו,",
                "> ואחריהם בפיהם ירצו.",
                "> סלה"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כצאן לשאול שתו;",
                "> מות ירעם;",
                "> וירדו בם ישרים לבקר,",
                "> וצורם לבלות שאול",
                "> מזבול לו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אך אלוהים יפדה נפשי מיד שאול,",
                "> כי יקחני סלה.",
                "> סלה"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אל תירא כי יעשיר איש,",
                "> כי ירבה כבוד ביתו;"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי לא במותו יקח הכל,",
                "> לא ירד אחריו כבודו."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> כי נפשו בחייו יברך—",
                "> ויודוך כי תיטיב לך—"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> תבוא עד דור אבותיו;",
                "> עד נצח לא יראו אור."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אדם ביקר ולא יבין,",
                "> נמשל כבהמות נדמו."
            ]
        }
    ]
}