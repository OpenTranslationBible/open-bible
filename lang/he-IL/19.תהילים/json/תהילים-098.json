{
    "book": "תהילים",
    "chapter": 98,
    "verses": [
        {
            "text": [
                "מזמור."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> שירו לה' שיר חדש,",
                "> כי נפלאות עשה,",
                "> הושיעה לו ימינו וזרוע קדשו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הודיע ה' ישועתו;",
                "> לעיני הגויים גילה צדקתו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> זכר חסדו ואמונתו לבית ישראל;",
                "> ראו כל אפסי ארץ את ישועת אלוהינו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הריעו לה' כל הארץ;",
                "> פצחו ורננו וזמרו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> זמרו לה' בכנור,",
                "> בכנור וקול זמרה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> בחצוצרות וקול שופר",
                "> הריעו לפני המלך ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ירעם הים ומלואו,",
                "> תבל ויושבי בה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> נהרות ימחאו כף,",
                "> יחד הרים ירננו"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לפני ה', כי בא לשפוט הארץ;",
                "> ישפוט תבל בצדק,",
                "> ועמים במישרים."
            ]
        }
    ]
}