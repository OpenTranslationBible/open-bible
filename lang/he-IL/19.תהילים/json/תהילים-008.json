{
    "book": "תהילים",
    "chapter": 8,
    "verses": [
        {
            "text": [
                "למנצח על הגיתית. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה' אדוננו,",
                "> מה אדיר שמך בכל הארץ,",
                "> אשר תנה הודך על השמים!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> מפי עוללים ויונקים יסדת עוז",
                "> למען צורריך,",
                "> להשבית אויב ומתנקם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי אראה שמיך מעשה אצבעותיך,",
                "> ירח וכוכבים אשר כוננתה,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מה אנוש כי תזכרנו,",
                "> ובן אדם כי תפקדנו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ותחסרהו מעט מאלוהים,",
                "> וכבוד והדר תעטרהו!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> תמשילהו במעשי ידיך;",
                "> כל שתה תחת רגליו,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> צאן ובקר כולם,",
                "> וגם בהמות שדה,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ציפור שמים ודגי הים,",
                "> עוברי ארחות ימים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ה' אדוננו,",
                "> מה אדיר שמך בכל הארץ!"
            ]
        }
    ]
}