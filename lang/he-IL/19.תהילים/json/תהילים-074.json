{
    "book": "תהילים",
    "chapter": 74,
    "verses": [
        {
            "text": [
                "משכיל לאסף."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלוהים, למה זנחת לנצח?",
                "> למה יבער אפך בצאן מרעיתך?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> זכור עדתך קנית קדם,",
                "> גאלת שבט נחלתך;",
                "> הר ציון זה שכנת בו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הרם פעמיך למשואות נצח;",
                "> כל הרע האויב בקודש."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> שאגו צרריך בקרב מועדך;",
                "> שמו אותותם אותות."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יודע כמביא למעלה",
                "> גרזנים בסבך עץ."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ועתה פתוחיה יחד",
                "> בכשיל וכילפות יהלמון."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שלחו באש מקדשך;",
                "> לארץ חללו משכן שמך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אמרו בלבם, \"נינם יחדו.\"",
                "> שרפו כל מועדי אל בארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אותותינו לא ראינו;",
                "> אין עוד נביא,",
                "> ולא איתנו יודע עד מה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> עד מתי אלוהים יחרף צר?",
                "> ינאץ אויב שמך לנצח?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> למה תשיב ידך וימינך מקרב חיקך?",
                "> כלה!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ואלוהים מלכי מקדם,",
                "> פועל ישועות בקרב הארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אתה פוררת בעוזך ים;",
                "> שברת ראשי תנינים על המים."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אתה רצצת ראשי לויתן;",
                "> תתננו מאכל לעם לציים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אתה בקעת מעין ונחל;",
                "> אתה הובשת נהרות איתן."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> לך יום אף לך לילה;",
                "> אתה הכינות מאור ושמש."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> אתה הצבת כל גבולות ארץ;",
                "> קיץ וחרף אתה יצרתם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> זכר זאת אויב חרף יהוה,",
                "> ועם נבל נאצו שמך."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אל תתן לחית נפש תורך;",
                "> חית ענייך אל תשכח לנצח."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> הבט לברית;",
                "> כי מלאו מחשכי ארץ נאות חמס."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אל ישוב דך נכלם;",
                "> עני ואביון יהללו שמך."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> קומה אלוהים, ריבה ריבך;",
                "> זכר חרפתך מני נבל כל היום."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> אל תשכח קול צרריך,",
                "> שאון קמיך עולה תמיד."
            ]
        }
    ]
}