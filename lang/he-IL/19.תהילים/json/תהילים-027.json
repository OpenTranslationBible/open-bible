{
    "book": "תהילים",
    "chapter": 27,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה' אורי וישעי;",
                "> ממי אירא?",
                "> ה' מעוז חיי;",
                "> ממי אפחד?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> בקרוב עלי מרעים לאכול את בשרי,",
                "> צרי ואויבי לי, המה כשלו ונפלו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אם תחנה עלי מחנה,",
                "> לא יירא לבי;",
                "> אם תקום עלי מלחמה,",
                "> בזאת אני בוטח."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אחת שאלתי מאת ה', אותה אבקש:",
                "> שבתי בבית ה' כל ימי חיי,",
                "> לחזות בנעם ה'",
                "> ולבקר בהיכלו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי יצפנני בסכה ביום רעה,",
                "> יסתרני בסתר אהלו,",
                "> בצור ירוממני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ועתה ירום ראשי על אויבי סביבותי,",
                "> ואזבחה באהלו זבחי תרועה;",
                "> אשירה ואזמרה לה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> שמע ה', קולי אקרא,",
                "> וחנני וענני."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> לך אמר לבי, \"בקשו פני,\"",
                "> את פניך, ה', אבקש."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אל תסתר פניך ממני,",
                "> אל תט באף עבדך;",
                "> עזרתי היית;",
                "> אל תטשני ואל תעזבני,",
                "> אלוה ישעי!"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי אבי ואמי עזבוני,",
                "> וה' יאספני."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הורני ה' דרכך,",
                "> ונחני בארח מישור למען שוררי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אל תתנני בנפש צרי,",
                "> כי קמו בי עדי שקר,",
                "> ויפח חמס."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לולא האמנתי לראות בטוב ה'",
                "> בארץ חיים."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> קוה אל ה';",
                "> חזק ויאמץ לבך;",
                "> וקוה אל ה'."
            ]
        }
    ]
}