{
    "book": "תהילים",
    "chapter": 39,
    "verses": [
        {
            "text": [
                "למנצח לידותון. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אמרתי אשמרה דרכי",
                "> מחטוא בלשוני;",
                "> אשמרה לפי מחסום",
                "> בעוד רשע לנגדי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> נאלמתי דומיה,",
                "> החשיתי מטוב,",
                "> וכאבי נעכר."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> חם לבי בקרבי,",
                "> בהגיגי תבער אש;",
                "> דברתי בלשוני:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"ה׳, הודיעני קצי,",
                "> ומדת ימי מה היא;",
                "> אדעה מה חדל אני."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הנה טפחות נתתה ימי,",
                "> וחלדי כאין נגדך;",
                "> אך כל הבל כל אדם נצב.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אך בצלם יתהלך איש;",
                "> אך הבל יהמיון;",
                "> יצבר ולא ידע מי אוספם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ועתה מה קויתי, אדני?",
                "> תוחלתי לך היא."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> מכל פשעי הצילני;",
                "> חרפת נבל אל תשימני."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> נאלמתי לא אפתח פי,",
                "> כי אתה עשית."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> הסר מעלי נגעך;",
                "> מתגרת ידך אני כליתי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> בתוכחות על עון יסרת איש;",
                "> ותמס כעש חמודו;",
                "> אך הבל כל אדם סלה.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> שמע תפלתי, ה׳, והאזינה אל שועתי;",
                "> אל דמעתי אל תחרש;",
                "> כי גר אנכי עמך,",
                "> תושב ככל אבותי."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> השע ממני ואבליגה",
                "> בטרם אלך ואינני."
            ]
        }
    ]
}