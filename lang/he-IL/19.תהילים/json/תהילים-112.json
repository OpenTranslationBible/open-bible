{
    "book": "תהילים",
    "chapter": 112,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו יה!",
                "> אשרי איש ירא את ה',",
                "> במצוותיו חפץ מאוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> זרעו יהיה גיבור בארץ;",
                "> דור ישרים יבורך."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> הון ועושר בביתו,",
                "> וצדקתו עומדת לעד."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> זרח בחושך אור לישרים;",
                "> חנון ורחום וצדיק."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> טוב איש חונן ומלווה;",
                "> יכלכל דבריו במשפט."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי לעולם לא ימוט;",
                "> לזכר עולם יהיה צדיק."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> משמועה רעה לא יירא;",
                "> נכון לבו בטוח בה'."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> סמוך לבו לא יירא,",
                "> עד אשר יראה בצריו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> פיזר נתן לאביונים,",
                "> צדקתו עומדת לעד;",
                "> קרנו תרום בכבוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> רשע יראה וכעס,",
                "> שיניו יחרוק ונמס;",
                "> תאוות רשעים תאבד."
            ]
        }
    ]
}