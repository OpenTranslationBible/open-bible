{
    "book": "תהילים",
    "chapter": 149,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> הללו את ה'!",
                "> שירו לה' שיר חדש,",
                "> ותהללוהו בקהל חסידים."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ישמח ישראל בעושיו;",
                "> בני ציון יגילו במלכם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> יהללו שמו במחול;",
                "> בתוף וכנור יזמרו לו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי רצה ה' בעמו;",
                "> יפאר ענוים בישועה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יעלזו חסידים בכבוד;",
                "> ירננו על משכבותם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> רוממות אל בגרונם,",
                "> וחרב פיפיות בידם,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> לעשות נקמה בגוים,",
                "> תוכחות בלאומים,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> לאסור מלכיהם בזיקים,",
                "> ונכבדיהם בכבלי ברזל,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לעשות בהם משפט כתוב.",
                "> הדר הוא לכל חסידיו.",
                "> הללו את ה'!"
            ]
        }
    ]
}