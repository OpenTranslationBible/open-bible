{
    "book": "תהילים",
    "chapter": 85,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לבני קרח."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה', רצית ארצך;",
                "> שבית שבות יעקב."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> נשאת עוון עמך;",
                "> כסית כל חטאתם.",
                "> סלה"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אספת כל עברתך;",
                "> השיבות מחרון אפך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> השיבנו, אלוהי ישענו,",
                "> והפר כעסך ממנו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הלעולם תאנף בנו?",
                "> תמשוך אפך לדר ודר?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הלא תשוב תחיינו,",
                "> ויעלוז עמך בך?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הראנו, ה', חסדך,",
                "> וישעך תתן לנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אשמעה מה ידבר האל ה';",
                "> כי ידבר שלום אל עמו ואל חסידיו;",
                "> ואל ישובו לכסלה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אך קרוב ליראיו ישעו,",
                "> לשכון כבוד בארצנו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> חסד ואמת נפגשו;",
                "> צדק ושלום נשקו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אמת מארץ תצמח,",
                "> וצדק משמים נשקף."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> גם ה' יתן הטוב,",
                "> וארצנו תתן יבולה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> צדק לפניו יהלך",
                "> וישם לדרך פעמיו."
            ]
        }
    ]
}