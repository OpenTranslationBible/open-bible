{
    "book": "שמואל ב",
    "chapter": 22,
    "verses": [
        {
            "verse": 1,
            "text": [
                "וידבר דוד את דברי השיר הזה לה'",
                "ביום הציל ה' אותו מכף כל אויביו,",
                "ומכף שאול."
            ]
        },
        {
            "verse": 2,
            "text": [
                "ויאמר:",
                "> \"ה' סלעי ומצודתי ומפלטי לי;"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אלוהי, צורי, אחסה בו,",
                "> מגני וקרן ישעי,",
                "> משגבי ומנוסי;",
                "> מושיעי, מחמס תושיעני."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מהולל אקרא ה',",
                "> ומן אויבי אושע."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי אפפוני משברי מוות,",
                "> נחלי בליעל יבעתוני;"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> חבלי שאול סבוני;",
                "> מוקשי מוות יקדםוני."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בצר לי אקרא ה',",
                "> ואל אלוהי אקרא;",
                "> וישמע מהיכלו קולי,",
                "> ושוועתי באוזניו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ותגעש ותרעש הארץ,",
                "> מוסדות השמים ירגזו",
                "> ויתגעשו, כי חרה לו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> עלה עשן באפו,",
                "> ואש מפיו תאכל;",
                "> גחלים בערו ממנו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ויט שמים וירד",
                "> וערפל תחת רגליו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> וירכב על כרוב ויעף;",
                "> וירא על כנפי רוח."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> וישת חושך סביבותיו סוכות,",
                "> חשכת מים, עבי שחקים."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> מנגה נגדו",
                "> בערו גחלי אש."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ירעם מן השמים ה',",
                "> ועליון יתן קולו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> וישלח חצים ויפיצם,",
                "> ברק ויהמם."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ויראו אפיקי ים,",
                "> יגלו מוסדות תבל",
                "> בגערת ה',",
                "> מנשמת רוח אפו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ישלח ממרום יקחני;",
                "> ימשני ממים רבים."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> יצילני מאויבי עז,",
                "> משונאי כי אמצו ממני."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> יקדמוני ביום אידי,",
                "> ויהי ה' משען לי."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> ויוציאני למרחב;",
                "> יחלצני כי חפץ בי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> יגמלני ה' כצדקתי;",
                "> כבור ידי ישיב לי."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> כי שמרתי דרכי ה',",
                "> ולא רשעתי מאלוהי."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> כי כל משפטיו לנגדי,",
                "> וחקתיו לא אסור ממנה."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ואהיה תמים לו,",
                "> ואשמרה מעוני."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> וישב ה' לי כצדקתי,",
                "> כבורי לנגד עיניו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> עם חסיד תתחסד,",
                "> עם גבר תמים תתמם;"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> עם נבר תתבר,",
                "> ועם עיקש תתפל."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> ועם עני תושיע,",
                "> ועיניך על רמים תשפיל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> כי אתה נרי ה',",
                "> וה' יגיה חשכי."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> כי בך ארוץ גדוד,",
                "> באלוהי אדלג שור."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> האל תמים דרכו;",
                "> אמרת ה' צרופה;",
                "> מגן הוא לכל החוסים בו."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> כי מי אל מבלעדי ה'?",
                "> ומי צור מבלעדי אלוהינו?"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> האל מעוזי חיל,",
                "> ויתן תמים דרכו."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> משוה רגלי כאילות,",
                "> ועל במותי יעמידני."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> מלמד ידי למלחמה,",
                "> ונחתה קשת נחושה זרועותי."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> ותתן לי מגן ישעך,",
                "> וענותך תרבני."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> תרחיב צעדי תחתיי,",
                "> ולא מעדו קרסוליי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> ארדפה אויבי ואשמידם,",
                "> ולא אשוב עד כלותם."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> ואכלם ואמחצם,",
                "> ולא יקומון;",
                "> ויפלו תחת רגליי."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ותאזרני חיל למלחמה;",
                "> תכריע קמי תחתיי."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> ואויבי תתה לי עורף,",
                "> ומשנאי אצמיתם."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> ישעו ואין מושיע—",
                "> אל ה' ולא ענם."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> ואשחקם כעפר ארץ;",
                "> כטיט חוצות אדקם ארקעם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> ותפלטני מריבי עמי;",
                "> תשמרני לראש גויים;",
                "> עם לא ידעתי יעבדוני."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> בני נכר יתכחשו לי;",
                "> לשמוע אוזן ישמעו לי."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> בני נכר יבלו,",
                "> ויחרגו ממסגרותיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> חי ה', וברוך צורי;",
                "> וירום אלוהי צור ישעי,"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> האל הנותן נקמות לי,",
                "> ומוריד עמים תחתיי,"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> ומוציאי מאויביי;",
                "> ומן קמי תרוממני;",
                "> מאיש חמסים תצילני."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> על כן אודך ה' בגויים,",
                "> ולשמך אזמרה."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> מגדול ישועות מלכו,",
                "> ועושה חסד למשיחו,",
                "> לדוד ולזרעו עד עולם.\""
            ]
        }
    ]
}