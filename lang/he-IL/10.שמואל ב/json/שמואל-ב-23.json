{
    "book": "שמואל ב",
    "chapter": 23,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אלה דברי דוד האחרונים:",
                "נאם דוד בן ישי,",
                "ונאם הגבר הוקם על,",
                "משיח אלוהי יעקב,",
                "ונעים זמירות ישראל:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"רוח ה' דיבר בי,",
                "> ומילתו על לשוני."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אמר אלוהי ישראל,",
                "> צור ישראל דיבר לי:",
                "> 'מושל באדם צדיק,",
                "> מושל יראת אלוהים,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> וכאור בוקר יזרח שמש,",
                "> בוקר לא עבות,",
                "> מנגה ממטר דשא מארץ.'"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי לא כן ביתי עם אל?",
                "> כי ברית עולם שם לי,",
                "> ערוכה בכל ושמורה;",
                "> כי כל ישעי וכל חפץ לא יצמיח?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ובליעל כקוץ מנד כלם,",
                "> כי לא ביד יקחו;"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ואיש יגע בהם",
                "> ימלא ברזל ועץ חנית,",
                "> ובאש ישרפו בשבת.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "אלה שמות הגיבורים אשר לדוד:",
                "יושב בשבת תחכמוני ראש השלישים—",
                "הוא עורר את חניתו על שמונה מאות חלל בפעם אחת."
            ]
        },
        {
            "verse": 9,
            "text": [
                "ואחריו אלעזר בן דודו בן אחוחי,",
                "מאחד שלושת הגיבורים עם דוד",
                "בהחרימם את הפלשתים הנאספים שם למלחמה,",
                "ויעלו אנשי ישראל."
            ]
        },
        {
            "verse": 10,
            "text": [
                "הוא קם ויך בפלשתים עד כי יגע ידו ותדבק החרב,",
                "ויעש ה' תשועה גדולה ביום ההוא;",
                "וישובו העם אחריו רק לפשט."
            ]
        },
        {
            "verse": 11,
            "text": [
                "ואחריו שמא בן אגא הררי.",
                "ויאספו פלשתים לחיה",
                "ותהי שם חלקת השדה מלאה עדשים,",
                "והעם נס מפני פלשתים."
            ]
        },
        {
            "verse": 12,
            "text": [
                "ויעמד בתוך החלקה ויצילה,",
                "ויך את הפלשתים;",
                "ויעש ה' תשועה גדולה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "וירדו שלושה מהשלושים ראש ויבואו אל דוד בקציר",
                "אל מערת עדלם,",
                "וחית פלשתים חונה בעמק רפאים."
            ]
        },
        {
            "verse": 14,
            "text": [
                "ודוד אז במצודה,",
                "ומצב פלשתים אז בבית לחם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "ויתאו דוד ויאמר,",
                "\"מי ישקני מים מבור בית לחם",
                "אשר בשער?\""
            ]
        },
        {
            "verse": 16,
            "text": [
                "ויבקעו שלושת הגיבורים במחנה פלשתים,",
                "וישאבו מים מבור בית לחם אשר בשער,",
                "וישאו ויביאו אל דוד.",
                "ולא אבה לשתותם, ויסך אותם לה':"
            ]
        },
        {
            "verse": 17,
            "text": [
                "ויאמר,",
                "\"חלילה לי ה' מעשות זאת!",
                "הדם האנשים ההולכים בנפשותם אשתה?\"",
                "ולא אבה לשתותם.",
                "אלה עשו שלושת הגיבורים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ואבישי אחי יואב בן צרויה,",
                "הוא ראש השלושים.",
                "והוא עורר את חניתו על שלוש מאות חלל,",
                "ולו שם בשלושה."
            ]
        },
        {
            "verse": 19,
            "text": [
                "מן השלושים נכבד,",
                "ויהי להם לשר;",
                "ואל השלושה לא בא."
            ]
        },
        {
            "verse": 20,
            "text": [
                "ובניהו בן יהוידע,",
                "בן איש חיל רב פעלים מקבצאל,",
                "הוא הכה את שני אראל מואב.",
                "והוא ירד והכה את האריה בתוך הבור ביום השלג."
            ]
        },
        {
            "verse": 21,
            "text": [
                "והוא הכה את האיש המצרי,",
                "ואיש מראה בידו חנית,",
                "וירד אליו בשבט,",
                "ויגזול את החנית מיד המצרי,",
                "ויהרגהו בחניתו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "אלה עשה בניהו בן יהוידע,",
                "ולו שם בשלושה הגיבורים."
            ]
        },
        {
            "verse": 23,
            "text": [
                "מן השלושים נכבד,",
                "ואל השלושה לא בא.",
                "וישימהו דוד על משמעתו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "עשהאל אחי יואב בשלושים;",
                "אלחנן בן דודו מבית לחם,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "שמעא חרודי;",
                "אליקא חרודי,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "חלץ פלתי;",
                "עירא בן עקש מתקוע,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "אביעזר מענתותי;",
                "מבניי החשתי,"
            ]
        },
        {
            "verse": 28,
            "text": [
                "צלמון אחוחי;",
                "מהרי נטופתי,"
            ]
        },
        {
            "verse": 29,
            "text": [
                "חלב בן בענה מנתופה;",
                "אתי בן ריבי מגבעת בני בנימין,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "בניהו פרעתוני;",
                "חידאי מנחלי געש,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "אבי עלבון הערבתי;",
                "עזמות ברחומי,"
            ]
        },
        {
            "verse": 32,
            "text": [
                "אליחבא שעלבני;",
                "בני ישן, יונתן,"
            ]
        },
        {
            "verse": 33,
            "text": [
                "שמעא הררי;",
                "אחיאם בן שראר האררי,"
            ]
        },
        {
            "verse": 34,
            "text": [
                "אליפלט בן אחסבי בן המעכתי;",
                "אליעם בן אחיתופל הגילוני,"
            ]
        },
        {
            "verse": 35,
            "text": [
                "חצרו הכרמלי;",
                "פראי הערבי,"
            ]
        },
        {
            "verse": 36,
            "text": [
                "יגאל בן נתן מצובה;",
                "בני הגדי,"
            ]
        },
        {
            "verse": 37,
            "text": [
                "צלק העמוני;",
                "נחרי הבארותי, נשא כלי יואב בן צרויה,"
            ]
        },
        {
            "verse": 38,
            "text": [
                "עירא היתרי;",
                "גרב היתרי,"
            ]
        },
        {
            "verse": 39,
            "text": [
                "אוריה החתי;",
                "שלושים ושבעה כלם."
            ]
        }
    ]
}