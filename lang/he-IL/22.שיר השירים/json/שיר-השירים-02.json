{
    "book": "שיר השירים",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אני חבצלת השרון,",
                "שושנת העמקים."
            ]
        },
        {
            "verse": 2,
            "text": [
                "כשושנה בין החוחים,",
                "כן רעייתי בין הבנות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "כתפוח בעצי היער,",
                "כן דודי בין הבנים.",
                "בצלו חמדתי וישבתי,",
                "ופריו מתוק לחכי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "הביאני אל בית היין,",
                "ודגלו עלי אהבה."
            ]
        },
        {
            "verse": 5,
            "text": [
                "סמכוני באשישות,",
                "רפדוני בתפוחים,",
                "כי חולת אהבה אני."
            ]
        },
        {
            "verse": 6,
            "text": [
                "שמאלו תחת לראשי,",
                "וימינו תחבקני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "השבעתי אתכן,",
                "בנות ירושלים,",
                "בצבאות או באיילות השדה,",
                "אם תעירו ואם תעוררו את האהבה",
                "עד שתחפץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "קול דודי!",
                "הנה זה בא,",
                "מדלג על ההרים,",
                "מקפץ על הגבעות!"
            ]
        },
        {
            "verse": 9,
            "text": [
                "דומה דודי לצבי או לעופר האיילים.",
                "הנה זה עומד אחר כתלנו,",
                "משגיח מן החלונות,",
                "מציץ מן החרכים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "ענה דודי ואמר לי,",
                "\"קומי לך, רעיתי, יפתי,",
                "ולכי לך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "כי הנה הסתיו עבר,",
                "הגשם חלף הלך לו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "הניצנים נראו בארץ;",
                "עת הזמיר הגיע,",
                "וקול התור נשמע בארצנו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "התאנה חנטה פגיה,",
                "והגפנים סמדר נתנו ריח.",
                "קומי לך, רעיתי, יפתי,",
                "ולכי לך!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "יונתי בחגווי הסלע,",
                "בסתר המדרגה,",
                "הראיני את מראיך,",
                "השמיעיני את קולך;",
                "כי קולך ערב,",
                "ומראיך נאוה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "אחזו לנו שועלים,",
                "שועלים קטנים מחבלים כרמים,",
                "וכרמינו סמדר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "דודי לי ואני לו;",
                "הרועה בשושנים."
            ]
        },
        {
            "verse": 17,
            "text": [
                "עד שיפוח היום ונסו הצללים,",
                "סוב, דמה לך דודי לצבי",
                "או לעופר האיילים על הרי בתר."
            ]
        }
    ]
}