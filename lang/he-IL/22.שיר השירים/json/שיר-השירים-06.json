{
    "book": "שיר השירים",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אנה הלך דודך,",
                "היפה בנשים?",
                "אנה פנה דודך,",
                "ונבקשנו עמך?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "דודי ירד לגנו,",
                "לערוגות הבושם,",
                "לרעות בגנים",
                "וללקט שושנים."
            ]
        },
        {
            "verse": 3,
            "text": [
                "אני לדודי ודודי לי,",
                "הרועה בשושנים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "יפה את רעיתי כתרצה,",
                "נעימה כירושלים,",
                "איימה כנדגלות."
            ]
        },
        {
            "verse": 5,
            "text": [
                "הסבי עיניך מנגדי,",
                "שהם הרהיבוני;",
                "שערך כעדר העזים",
                "שגלשו מן הגלעד."
            ]
        },
        {
            "verse": 6,
            "text": [
                "שיניך כעדר הרחלים",
                "שעלו מן הרחצה,",
                "שכולן מתאימות,",
                "ושכולה אין בהם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "כפלח הרימון רקתך",
                "מבעד לצמתך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "שישים המה מלכות ושמונים פילגשים,",
                "ועלמות אין מספר;"
            ]
        },
        {
            "verse": 9,
            "text": [
                "אחת היא יונתי תמתי,",
                "אחת היא לאמה,",
                "ברוה היא ליולדתה.",
                "ראו אותה בנות ויאשרוה,",
                "מלכות ופילגשים ויהללוה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "\"מי זאת הנשקפה כמו שחר,",
                "יפה כלבנה,",
                "ברכה כחמה,",
                "איימה כנדגלות?\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "אל גנת אגוז ירדתי",
                "לראות באבי הנחל,",
                "לראות הפרחה הגפן",
                "הנצו הרימונים."
            ]
        },
        {
            "verse": 12,
            "text": [
                "לא ידעתי נפשי שמה אותי",
                "מרכבות עמי נדיב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "שובי שובי השולמית,",
                "שובי שובי ונחזה בך!"
            ]
        },
        {
            "text": [
                "מה תחזו בשולמית,",
                "כמחולת המחניים?"
            ]
        }
    ]
}