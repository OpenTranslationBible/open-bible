{
    "book": "שיר השירים",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "השיר הגדול ביותר, מיוחס לשלמה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "ישקני מנשיקות פיהו!",
                "כי טובים דודיך מיין."
            ]
        },
        {
            "verse": 3,
            "text": [
                "לריח שמניך טובים,",
                "שמך כשמן תורק;",
                "על כן עלמות אהבוך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "משכני אחריך נרוצה!",
                "הביאני המלך חדריו.",
                "נגילה ונשמחה בך;",
                "נזכירה דודיך מיין.",
                "מישרים אהבוך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "שחורה אני ונאווה,",
                "בנות ירושלים,",
                "כאוהלי קדר,",
                "כיריעות שלמה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "אל תראוני שאני שחרחורת,",
                "ששזפתני השמש.",
                "בני אמי נחרו בי;",
                "שמרוני את הכרמים,",
                "כרמי שלי לא נטרתי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "הגידה לי, שאהבה נפשי,",
                "איפה תרעה,",
                "איפה תרביץ בצהריים?",
                "למה אהיה כעטיה",
                "על עדרי חבריך?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "אם לא תדעי לך,",
                "היפה בנשים,",
                "צאי לך בעקבי הצאן",
                "ורעי את גדיותיך",
                "על משכנות הרועים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "לסוסתי ברכבי פרעה",
                "דימיתיך רעייתי."
            ]
        },
        {
            "verse": 10,
            "text": [
                "נאוו לחייך בתורים,",
                "צווארך בחרוזים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "תורי זהב נעשה לך",
                "עם נקודות הכסף."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "עד שהמלך במסיבו,",
                "נרדי נתן ריחו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "צרור המור דודי לי",
                "בין שדי ילין."
            ]
        },
        {
            "verse": 14,
            "text": [
                "אשכול הכופר דודי לי",
                "בכרמי עין גדי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "הנך יפה רעייתי,",
                "הנך יפה!",
                "עיניך יונים."
            ]
        },
        {
            "verse": 16,
            "text": [
                "הנך יפה דודי,",
                "אף נעים!",
                "אף ערשנו רעננה!"
            ]
        },
        {
            "verse": 17,
            "text": [
                "קורות בתינו ארזים,",
                "רהיטנו ברותים."
            ]
        }
    ]
}