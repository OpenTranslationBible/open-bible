{
    "book": "שיר השירים",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "באתי לגני, אחותי כלה;",
                "אריתי מורי עם בשמי.",
                "אכלתי יערי עם דבשי;",
                "שתיתי ייני עם חלבי.",
                "אכלו רעים;",
                "שתו ושכרו דודים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "אני ישנה ולבי ער.",
                "קול דודי דופק:",
                "\"פתחי לי, אחותי רעיתי,",
                "יונתי תמתי!",
                "שראשי נמלא טל,",
                "קוצותי רסיסי לילה.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "\"פשטתי את כתנתי,",
                "איכה אלבשנה?",
                "רחצתי את רגלי,",
                "איכה אטנפם?\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "דודי שלח ידו מן החור,",
                "ומעי המו עליו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "קמתי אני לפתוח לדודי;",
                "וידי נטפו מור,",
                "ואצבעותי מור עובר,",
                "על כפות המנעול."
            ]
        },
        {
            "verse": 6,
            "text": [
                "פתחתי אני לדודי,",
                "ודודי חמק עבר!",
                "נפשי יצאה בדברו.",
                "בקשתי ולא מצאתיהו;",
                "קראתיו ולא ענני."
            ]
        },
        {
            "verse": 7,
            "text": [
                "מצאני השמרים הסובבים בעיר,",
                "הכוני פצעוני;",
                "נשאו את רדידי מעלי שומרי החומות."
            ]
        },
        {
            "verse": 8,
            "text": [
                "השבעתי אתכן,",
                "בנות ירושלים,",
                "אם תמצאו את דודי,",
                "מה תגידו לו:",
                "שחולת אהבה אני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "מה דודך מדוד,",
                "היפה בנשים?",
                "מה דודך מדוד,",
                "שכך השבעתנו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "דודי צח ואדום,",
                "דגול מרבבה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "ראשו כתם פז;",
                "קוצותיו תלתלים",
                "שחורות כעורב."
            ]
        },
        {
            "verse": 12,
            "text": [
                "עיניו כיונים על אפיקי מים,",
                "רחצות בחלב,",
                "יושבות על מלאת."
            ]
        },
        {
            "verse": 13,
            "text": [
                "לחייו כערוגת הבושם,",
                "מגדלות מרקחים;",
                "שפתותיו שושנים",
                "נטפות מור עובר."
            ]
        },
        {
            "verse": 14,
            "text": [
                "ידיו גלילי זהב",
                "ממולאים בתרשיש;",
                "מעיו עשת שן",
                "מעולפת ספירים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "שוקיו עמודי שש",
                "מייסדים על אדני פז;",
                "מראהו כלבנון,",
                "בחור כארזים."
            ]
        },
        {
            "verse": 16,
            "text": [
                "חכו ממתקים.",
                "וכלו מחמדים.",
                "זה דודי וזה רעי,",
                "בנות ירושלים."
            ]
        }
    ]
}