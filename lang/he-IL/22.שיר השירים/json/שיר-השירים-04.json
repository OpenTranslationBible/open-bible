{
    "book": "שיר השירים",
    "chapter": 4,
    "verses": [
        {
            "verse": 1,
            "text": [
                "מה יפה את, רעייתי,",
                "מה יפה את באמת!",
                "עינייך כיונים מבעד לצמתך;",
                "שערך כעדר העיזים",
                "שירדו מהר גלעד."
            ]
        },
        {
            "verse": 2,
            "text": [
                "שינייך כעדר הרחלים השטופות",
                "שעלו מן הרחצה,",
                "כולן תאומות,",
                "ואין בהן שכולה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "שפתותייך כחוט השני,",
                "ופיך נאה.",
                "רקותייך כפלח הרימון",
                "מבעד לצמתך."
            ]
        },
        {
            "verse": 4,
            "text": [
                "צווארך כמגדל דוד,",
                "בנוי לתלפיות",
                "תלוי עליו אלף מגנים,",
                "כל מגיני הגבורים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "שני שדייך כשני עופרים,",
                "תאומי צביה,",
                "הרועים בשושנים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "עד שיפוח היום",
                "ונסו הצללים,",
                "אלך לי אל הר המור",
                "ואל גבעת הלבונה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "כולך יפה, רעייתי,",
                "ומום אין בך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "תבואי איתי מלבנון, כלה,",
                "תבואי איתי מלבנון.",
                "תשקיפי מראש אמנה,",
                "מראש שניר וחרמון,",
                "ממאורות אריות,",
                "מהרי נמרים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "לִבַּבְתִּנִי, אחותי, כלה;",
                "לִבַּבְתִּנִי באחד מעינייך,",
                "באחד ענק מצווארך."
            ]
        },
        {
            "verse": 10,
            "text": [
                "מה יפו דודייך, אחותי, כלה!",
                "מה טובים דודייך מיין,",
                "וריח שמנייך מכל בשמים!"
            ]
        },
        {
            "verse": 11,
            "text": [
                "נופת תטופנה שפתותייך, כלה;",
                "דבש וחלב תחת לשונך,",
                "וריח שלמותייך כריח לבנון."
            ]
        },
        {
            "verse": 12,
            "text": [
                "גן נעול אחותי, כלה,",
                "מעיין חתום, מקור חתום."
            ]
        },
        {
            "verse": 13,
            "text": [
                "שלחייך פרדס רימונים",
                "עם פרי מגדים,",
                "כפרים עם נרדים,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "נרד וכרכם, קנה וקינמון,",
                "עם כל עצי לבונה,",
                "מור ואהלות, עם כל ראשי בשמים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "מעיין גנים,",
                "באר מים חיים,",
                "ונוזלים מן לבנון."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "עורי, צפון,",
                "ובואי, תימן;",
                "הפיחי גני,",
                "יזלו בשמיו.",
                "יבוא דודי לגנו",
                "ויאכל פרי מגדים!"
            ]
        }
    ]
}