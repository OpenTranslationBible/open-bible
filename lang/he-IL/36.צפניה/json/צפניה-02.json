{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> התקבצו והאספו,",
                "> גוי לא נכסף,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> בטרם לדת חק—",
                "> כקש עברה היום—",
                "> בטרם יבוא עליכם חרון אף ה',",
                "> בטרם יבוא עליכם יום אף ה'."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> בקשו את ה',",
                "> כל ענוי הארץ",
                "> אשר משפטו פעלו;",
                "> בקשו צדק, בקשו ענוה.",
                "> אולי תסתרו",
                "> ביום אף ה'."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי עזה עזובה תהיה,",
                "> ואשקלון לשממה;",
                "> אשדוד בצהרים יגרשוה,",
                "> ועקרון תעקר."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הוי ישבי חבל הים,",
                "> גוי כרתים!",
                "> דבר ה' עליכם,",
                "> כנען ארץ פלשתים;",
                "> והאבדתיך",
                "> מאין יושב."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> והיה חבל הים נוות כרת,",
                "> רעים וגדרות צאן."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והיה חבל",
                "> לשארית בית יהודה,",
                "> עליהם ירעו;",
                "> בבתי אשקלון בערב ירבצון,",
                "> כי יפקדם ה' אלוהיהם",
                "> ושב שבותם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> שמעתי חרפת מואב",
                "> וגדופי בני עמון,",
                "> אשר חרפו את עמי",
                "> ויגדילו על גבולם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לכן, חי אני,\" נאום ה' צבאות,",
                "> אלוהי ישראל,",
                "> \"כי מואב כסדם תהיה,",
                "> ובני עמון כעמורה—",
                "> ממלכת חרול ומכרה מלח,",
                "> ושממה עד עולם.",
                "> שארית עמי יבזום,",
                "> ויתר גוי ינחלום.\""
            ]
        },
        {
            "verse": 10,
            "text": [
                "> זאת להם תחת גאונם,",
                "> כי חרפו ויגדילו",
                "> על עם ה' צבאות."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> נורא ה' עליהם,",
                "> כי רזה את כל אלוהי הארץ;",
                "> וישתחוו לו כל איי הגויים,",
                "> איש ממקומו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"גם אתם, כושים,",
                "> חללי חרבי הם.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ויט ידו על צפון",
                "> ויאבד את אשור,",
                "> וישם את נינוה לשממה,",
                "> ציה כמדבר."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ורבצו בתוכה עדרים,",
                "> כל חיתו גוי;",
                "> גם קאת גם קפוד",
                "> בכפתוריה ילינו;",
                "> קול ישורר בחלון,",
                "> חורב בסף;",
                "> כי ערה ארזיה."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> זאת העיר העליזה",
                "> היושבת לבטח,",
                "> האומרת בלבבה,",
                "> \"אני ואפסי עוד.\"",
                "> איך היתה לשממה,",
                "> מרבץ לחיה!",
                "> כל עובר עליה ישרוק",
                "> יניע ידו."
            ]
        }
    ]
}