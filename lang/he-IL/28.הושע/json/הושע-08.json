{
    "book": "הושע",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> תקעו שופר!",
                "> כנשר, האויב בא על בית ה',",
                "> כי הם הפרו את בריתי",
                "> והפירו את תורתי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הם קוראים אלי,",
                "> \"אלוהים, אנחנו מישראל מכירים אותך!\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ישראל סר מהטוב;",
                "> האויב ירדוף אותו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הם המליכו מלכים, אך לא ברשותי;",
                "> הם מינו שרים, אך לא נועצתי.",
                "> בכספם ובזהבם עשו להם פסלים,",
                "> כדי שיוסרו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הוא דחה את עגלך, שומרון, ואמר,",
                "> \"חרון אפי בוער בהם!\"",
                "> עד מתי לא יוכלו להישאר נקיים?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי מישראל גם זה!",
                "> חרש עשהו, ולכן אינו אלוהים;",
                "> ודאי שעגל שומרון יישבר."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי הם זורעים רוח",
                "> וקוצרים סופה.",
                "> קמה אין לו גרעינים;",
                "> לא יעשה קמח.",
                "> אם יעשה, זרים יאכלוהו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ישראל נבלע;",
                "> הם עכשיו בין הגויים",
                "> ככלי שאין בו חפץ."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי עלו אשורה,",
                "> כמו פרא בודד;",
                "> אפרים שכר אוהבים."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> גם אם ישכרו אוהבים בין הגויים,",
                "> אאספם עתה;",
                "> ויחלו למעט",
                "> בגלל משא מלך השרים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי אפרים הרבה מזבחות לחטא,",
                "> היו לו מזבחות לחטא."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אכתוב לו רובי תורתי,",
                "> נחשבו כזר."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> זבחי מתנותי,",
                "> יזבחו בשר ויאכלו,",
                "> אך ה' לא יקבלם.",
                "> עתה יזכור עוונם",
                "> ויפקוד חטאותם;",
                "> ישובו מצרימה."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי ישראל שכח את עושו ובנה היכלות;",
                "> ויהודה הרבה ערים בצורות,",
                "> אך אשלח אש בעריו,",
                "> ותאכל ארמנותיה."
            ]
        }
    ]
}