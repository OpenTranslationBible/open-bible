{
    "book": "הושע",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"לכו ונשובה אל ה'.",
                "> כי הוא טרף וירפאנו;",
                "> יך ויחבשנו."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יחיינו מיומיים;",
                "> ביום השלישי יקימנו,",
                "> ונחיה לפניו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ונדעה נרדפה לדעת את ה'.",
                "> כשחר נכון מוצאו;",
                "> ויבוא כגשם לנו,",
                "> כמלקוש יורה ארץ.\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> מה אעשה לך אפרים?",
                "> מה אעשה לך יהודה?",
                "> וחסדכם כענן בוקר,",
                "> וכטל משכים הלך."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> על כן חצבתי בנביאים;",
                "> הרגתים באמרי פי;",
                "> ומשפטיך אור יצא."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי חסד חפצתי ולא זבח,",
                "> ודעת אלהים מעולות."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והמה כאדם עברו ברית;",
                "> שם בגדו בי."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> גלעד קרית פועלי און,",
                "> עקבה מדם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> וכחכי איש גדודים,",
                "> חבר כהנים דרך ירצחו שכמה;",
                "> כי זמה עשו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> בבית ישראל ראיתי שערורייה:",
                "> שם זנות אפרים,",
                "> נטמאה ישראל."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> גם לך יהודה, שות קציר לך,",
                "> בשובי שבות עמי."
            ]
        }
    ]
}