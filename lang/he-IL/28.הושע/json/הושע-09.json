{
    "book": "הושע",
    "chapter": 9,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> אל תשמח ישראל אל גיל כעמים!",
                "> כי זנית מעל אלוהיך;",
                "> אהבת אתנן על כל גרנות דגן."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> גורן ויקב לא ירעם,",
                "> ותירוש יכזב בה."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> לא ישבו בארץ ה',",
                "> ושב אפרים מצרימה,",
                "> ובאשור טמא יאכלו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> לא יסכו לה' יין,",
                "> ולא יערבו לו זבחיהם.",
                "> כלחם אונים להם לחמם;",
                "> כל אוכליו יטמאו,",
                "> כי לחמם לנפשם;",
                "> לא יבוא בית ה'."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> מה תעשו ליום מועד",
                "> וליום חג ה'?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי הנה הלכו משוד;",
                "> מצרים תקבצם,",
                "> מוף תקברם.",
                "> מחמד לכספם קמשונים יירשום;",
                "> חוח באוהליהם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> באו ימי הפקדה,",
                "> באו ימי השילום;",
                "> תדע ישראל!",
                "> אויל הנביא,",
                "> משוגע איש הרוח,",
                "> על רוב עוונך,",
                "> ורבה משטמה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> צופה אפרים עם אלוהי נביא,",
                "> פח יקוש על כל דרכיו,",
                "> משטמה בבית אלוהיו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> העמיקו שחתו כימי הגבעה;",
                "> יזכור עוונם,",
                "> יפקוד חטאותם."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כענבים במדבר מצאתי ישראל;",
                "> כבכורה בתאנה בראשיתה ראיתי אבותיכם.",
                "> המה באו בעל פעור וינזרו לבושת,",
                "> ויהיו שקוצים כאהבם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אפרים כעוף תעוף כבודם—",
                "> מלדה ומבטן ומהריון!"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי אם יגדלו את בניהם,",
                "> ושכלתים מאדם.",
                "> כי גם אוי להם בשורי מהם!"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אפרים כאשר ראיתי לצור שתולה בנוה,",
                "> ואפרים להוציא אל הורג בניו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> תן להם ה'—מה תיתן?",
                "> תן להם רחם משכיל ושדים צומקים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כל רעתם בגלגל;",
                "> כי שם שנאתים!",
                "> על רעת מעלליהם",
                "> מביתי אגרשם!",
                "> לא אוסיף אהבתם;",
                "> כל שריהם סוררים."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> הוכה אפרים, שורשיהם יבש,",
                "> פרי לא יעשו.",
                "> גם כי יולידו,",
                "> והמתי מחמדי בטנם."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ימאסם אלוהי",
                "> כי לא שמעו לו;",
                "> ויהיו נודים בגויים."
            ]
        }
    ]
}