{
    "book": "הושע",
    "chapter": 11,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> כי נער ישראל ואוהבהו,",
                "> וממצרים קראתי לבני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ככל קראם כן הלכו מפניהם;",
                "> לבעלים יזבחו",
                "> ולפסלים יקטרו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ואנכי תרגלתי לאפרים קחם על זרועותי;",
                "> ולא ידעו כי רפאתים."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> בחבלי אדם אמשכם,",
                "> בעבותות אהבה,",
                "> ואהיה להם כמרימי על לחיהם;",
                "> ואט אליו אוכיל."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לא ישוב אל ארץ מצרים;",
                "> ואשור הוא מלכו",
                "> כי מאנו לשוב."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> וחלה חרב בעריו,",
                "> וכלתה בדיו,",
                "> ואכלה מפני מועצותיהם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ועמי תלואים למשובתי;",
                "> ואל על יקראהו,",
                "> יחד לא ירומם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> איך אתנך אפרים?",
                "> אאמגנך ישראל?",
                "> איך אתנך כאדמה?",
                "> אשיםך כצבויים?",
                "> נהפך עלי לבי,",
                "> יחד נכמרו נחומי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לא אעשה חרון אפי;",
                "> לא אשוב לשחת את אפרים.",
                "> כי אל אנכי ולא איש,",
                "> בקרבך קדוש,",
                "> ולא אבוא בעיר."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אחרי ה' ילכו,",
                "> כאריה ישאג;",
                "> כי הוא ישאג,",
                "> ויחרדו בנים מים."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> יחרדו כצפור ממצרים,",
                "> וכיונה מארץ אשור;",
                "> והושבתים על בתיהם, נאם ה'."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> סבבני אפרים בכחש,",
                "> ובית ישראל במרמה;",
                "> ויהודה עוד רד עם אל,",
                "> ועם קדושים נאמן."
            ]
        }
    ]
}