{
    "book": "הושע",
    "chapter": 14,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> שובה ישראל עד ה' אלוהיך,",
                "> כי כשלת בעוונך."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> קחו עמכם דברים ושובו אל ה'.",
                "> אמרו אליו,",
                "> \"כל תשא עוון",
                "> וקח טוב,",
                "> ונשלמה פרים שפתינו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אשור לא יושיענו,",
                "> על סוס לא נרכב;",
                "> ולא נאמר עוד אלוהינו למעשה ידינו,",
                "> כי בך ירוחם יתום.\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ארפא משובתם,",
                "> אוהבם נדבה,",
                "> כי שב אפי ממנו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אהיה כטל לישראל;",
                "> יפרח כשושנה,",
                "> ויך שורשיו כלבנון."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ילכו יונקותיו,",
                "> ויהי כבודו כזית,",
                "> וריח לו כלבנון."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ישבו ישבי בצלו",
                "> יחיו דגן,",
                "> ויפרחו כגפן.",
                "> זכרו כיין לבנון."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אפרים, מה לי עוד לעצבים?",
                "> אני עניתי ואשורנו.",
                "> אני כברוש רענן;",
                "> ממני פריך נמצא."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מי חכם ויבן אלה;",
                "> נבון וידעם.",
                "> כי ישרים דרכי ה',",
                "> וצדיקים ילכו בם,",
                "> ופושעים יכשלו בם."
            ]
        }
    ]
}