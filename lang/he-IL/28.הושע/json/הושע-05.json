{
    "book": "הושע",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> שמעו זאת, הכהנים!",
                "> הקשיבו, בית ישראל!",
                "> האזינו, בית המלך!",
                "> כי לכם המשפט,",
                "> כי הייתם פח במצפה",
                "> ורשת פרושה על תבור."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> וסרה העמיקו,",
                "> ואני אייסר את כולם."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אני ידעתי את אפרים,",
                "> וישראל לא נכחד ממני;",
                "> כי עתה, אפרים, זנית,",
                "> נטמא ישראל."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> לא יתנו מעלליהם",
                "> לשוב אל אלוהיהם.",
                "> כי רוח זנונים בקרבם,",
                "> ואת ה' לא ידעו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> וענה גאון ישראל בפניו,",
                "> וישראל ואפרים יכשלו בעוונם;",
                "> גם יהודה כשל עמם."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> בצאנם ובבקרם",
                "> ילכו לבקש את ה', ולא ימצאו;",
                "> סר מהם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בה' בגדו,",
                "> כי בנים זרים ילדו.",
                "> עתה יאכלם חודש את חלקם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> תקעו שופר בגבעה,",
                "> חצוצרה ברמה.",
                "> הריעו בבית און:",
                "> \"אחריך, בנימין!\""
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אפרים לשמה תהיה ביום תוכחה;",
                "> בשבטי ישראל הודעתי נאמנה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> היו שרי יהודה כמסיגי גבול;",
                "> עליהם אשפוך כמים עברתי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> עשוק אפרים, רצוץ משפט,",
                "> כי הואיל הלך אחרי צו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ואני כעש לאפרים,",
                "> וכרקב לבית יהודה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> וירא אפרים את חליו,",
                "> ויהודה את מזורו,",
                "> וילך אפרים אל אשור",
                "> וישלח אל מלך ירב.",
                "> והוא לא יוכל לרפא לכם,",
                "> ולא יגיה מכם מזור."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי אני כשחל לאפרים,",
                "> וככפיר לבית יהודה.",
                "> אני, אני אטרף ואלך,",
                "> אשא ואין מציל."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> אלך אשובה אל מקומי",
                "> עד אשר יאשמו ויבקשו פני;",
                "> בצר להם ישחרונני."
            ]
        }
    ]
}