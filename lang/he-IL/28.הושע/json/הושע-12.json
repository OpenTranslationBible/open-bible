{
    "book": "הושע",
    "chapter": 12,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> אפרים רועה רוח,",
                "> ורודף קדים כל היום;",
                "> כזב ושוד ירבה.",
                "> וכרתו ברית עם אשור,",
                "> ושמן למצרים יובל."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> וריב ליהודה עם ה',",
                "> ולפקוד על יעקב כדרכיו;",
                "> כמעשיו ישיב לו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> בבטן עקב את אחיו,",
                "> ובאונו שרה את אלוהים."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> וישר אל מלאך ויוכל;",
                "> בכה ויתחנן לו.",
                "> בית אל ימצאנו,",
                "> ושם ידבר עמנו,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> וה' אלוהי הצבאות,",
                "> ה' שמו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ואתה, שוב לאלוהיך,",
                "> שמור חסד ומשפט,",
                "> וקוה אל אלוהיך תמיד."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כנען, בידו מאזני מרמה,",
                "> לעשוק אהב."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ויאמר אפרים, “אך עשרתי,",
                "> מצאתי און לי;",
                "> כל יגיעי לא ימצאו לי",
                "> עוון אשר חטא.”"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ואנוכי ה' אלוהיך מארץ מצרים;",
                "> עוד אושיבך באוהלים,",
                "> כימי מועד."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ודברתי על הנביאים,",
                "> ואנוכי חזון הרביתי,",
                "> וביד הנביאים אדמה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אם גלעד און,",
                "> אך שוא היו.",
                "> בגלגל שוורים זבחו,",
                "> גם מזבחותם כגלים",
                "> על תלמי שדה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ויברח יעקב שדה ארם,",
                "> ויעבוד ישראל באשה,",
                "> ובאשה שמר."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ובנביא העלה ה' את ישראל ממצרים,",
                "> ובנביא נשמר."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> הכעיס אפרים תמרורים,",
                "> ודמיו עליו יטוש,",
                "> וחרפתו ישיב לו אדוניו."
            ]
        }
    ]
}