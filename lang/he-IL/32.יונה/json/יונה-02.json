{
    "book": "יונה",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "יונה התפלל אל ה' אלוהיו מתוך בטן הדג,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "ואמר,",
                "> \"בצר לי קראתי אל ה',",
                "> ויענני. מבטן שאול",
                "> שוועתי,",
                "> שמעת קולי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ותשליכני מצולה,",
                "> בלבב ימים,",
                "> ונהר יסובבני;",
                "> כל משבריך וגליך עלי עברו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ואני אמרתי, 'נגרשתי מנגד עיניך;",
                "> אך אוסיף להביט אל היכל קדשך.'"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אפפוני מים עד נפש,",
                "> תהום יסובבני;",
                "> סוף חבוש לראשי."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> לקצבי הרים ירדתי;",
                "> הארץ בריחיה בעדי לעולם.",
                "> ותעל משחת חיי, ה' אלוהי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> בהתעטף עלי נפשי,",
                "> את ה' זכרתי,",
                "> ותבוא אליך תפילתי,",
                "> אל היכל קדשך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> משמרים הבלי שווא",
                "> חסדם יעזובו,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ואני בקול תודה",
                "> אזבחה לך.",
                "> אשר נדרתי אשלמה.",
                "> ישועה לה'.\""
            ]
        },
        {
            "verse": 10,
            "text": [
                "וידבר ה' אל הדג, ויקא את יונה אל היבשה."
            ]
        }
    ]
}