{
    "book": "שופטים",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ביום ההוא שרה דבורה וברק בן אבינעם לאמר:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"בפרוע פרעות בישראל,",
                "> בהתנדב עם,",
                "> ברכו יהוה!"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"שמעו מלכים! האזינו רוזנים!",
                "> אנכי, אנכי, אשירה ליהוה;",
                "> אזמר ליהוה, אלהי ישראל."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"יהוה, בצאתך משעיר,",
                "> בצעדך משדה אדום,",
                "> ארץ רעשה, גם שמים נטפו,",
                "> גם עבים נטפו מים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הרים נזלו מפני יהוה, זה סיני,",
                "> מפני יהוה אלהי ישראל."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> \"בימי שמגר בן ענת,",
                "> בימי יעל, חדלו ארחות,",
                "> והולכי נתיבות ילכו ארחות עקלקלות."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> חדלו פרזון בישראל;",
                "> חדלו עד שקמתי דבורה,",
                "> שקמתי אם בישראל."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> יבחר אלהים חדשים; אז לחם שערים.",
                "> מגן אם יראה ורמח",
                "> בארבעים אלף בישראל."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> לבי לחוקקי ישראל,",
                "> המתנדבים בעם.",
                "> ברכו יהוה!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> \"רכבו אתונות צחורות,",
                "> ישבי על מדין,",
                "> והולכי על דרך, שיחו:"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> מקול מחצצים בין משאבים.",
                "> שם יתנו צדקות יהוה,",
                "> צדקות פרזונו בישראל.",
                "> אז ירדו לשר שערים",
                "> עם יהוה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"עורי, עורי, דבורה!",
                "> עורי, עורי, דברי שיר!",
                "> קום, ברק, ושבה שביך בן אבינעם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> \"אז ירד שריד לאדירים;",
                "> עם יהוה ירד לי בגבורים."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> מני אפרים שרשם בעמלק,",
                "> אחריך בנימין בעממיך. מני מכיר ירדו מחוקקים,",
                "> ומזבולן מושכים בשבט סופר."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ושרי יששכר עם דבורה;",
                "> ויששכר כן ברק,",
                "> בעמק שלח ברגליו.",
                "> בפלגות ראובן",
                "> גדולים חקרי לב."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> למה ישבת בין המשפתים",
                "> לשמע שריקות עדרים?",
                "> לפלגות ראובן",
                "> גדולים חקרי לב."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> גלעד בעבר הירדן שכן.",
                "> ודן למה יגור אניות?",
                "> אשר ישב לחוף ימים",
                "> ועל מפרציו ישכון."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> זבולן עם חרף נפשו למות;",
                "> וכן נפתלי על מרומי שדה."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> \"באו מלכים נלחמו,",
                "> אז נלחמו מלכי כנען בתענך,",
                "> על מי מגדו;",
                "> בצע כסף לא לקחו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> מן שמים נלחמו הכוכבים,",
                "> ממסלותם נלחמו עם סיסרא."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> נחל קישון גרפם,",
                "> נחל קדומים, נחל קישון.",
                "> תדרכי נפשי עז!"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אז הלמו עקבי סוס מדהרות, דהרות אביריו."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 'ארו מרוז,' אמר מלאך יהוה.",
                "> 'ארו ארור ישביה,",
                "> כי לא באו לעזרת יהוה,",
                "> לעזרת יהוה בגבורים.'"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> \"תבורך מנשים יעל,",
                "> אשת חבר הקיני;",
                "> מנשים באהל תבורך."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> מים שאל, חלב נתנה;",
                "> בספל אדירים הקריבה חמאה."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> ידה ליתד תשלחנה,",
                "> וימינה להלמות עמלים.",
                "> והלמה סיסרא, מחצה ראשו,",
                "> ומחצה וחלפה רקתו."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> בין רגליה כרע, נפל;",
                "> שכב.",
                "> בין רגליה כרע, נפל;",
                "> באשר כרע, שם נפל שדוד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> \"בעד החלון נשקפה",
                "> ותיבב אם סיסרא בעד האשנב,",
                "> 'מדוע בשש רכבו לבוא?",
                "> מדוע אחרו פעמי מרכבותיו?'"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> חכמות שרותיה תענינה,",
                "> אף היא תשיב אמריה לה:"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 'הלוא ימצאו יחלקו שלל:",
                "> רחם רחמתים לראש גבר,",
                "> שלל צבעים לסיסרא,",
                "> שלל צבעים רקמה,",
                "> צבע רקמתים לצוארי שלל.'"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> \"כן יאבדו כל אויביך, יהוה!",
                "> ואוהביו כצאת השמש",
                "> בגבורתו.\"",
                "ותשקט הארץ ארבעים שנה."
            ]
        }
    ]
}