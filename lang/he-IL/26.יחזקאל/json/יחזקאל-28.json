{
    "book": "יחזקאל",
    "chapter": 28,
    "verses": [
        {
            "verse": 1,
            "text": [
                "דבר ה' היה אלי,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "\"בן אדם, אמור לנשיא צור, 'כה אמר אדוני ה': \"בגבהות לבך אתה מכריז,",
                "'אני אל;",
                "אני יושב במושב אלים בלב ימים.'",
                "ואתה אדם ולא אל,",
                "ואף על פי שאתה חושב עצמך חכם כאל."
            ]
        },
        {
            "verse": 3,
            "text": [
                "הנה, האם אתה חכם מדניאל?",
                "אין סוד נסתר ממך?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "בחכמתך ובתבונתך",
                "רכשת עושר לעצמך",
                "ואספת זהב וכסף לאוצרותיך."
            ]
        },
        {
            "verse": 5,
            "text": [
                "ברוב חכמתך במסחר",
                "הרבית עושרך,",
                "ולבך גבה בעושרך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "\"'לכן כה אמר אדוני ה':",
                "> 'יען כי שמת לבך",
                "> כלב אל,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> לכן, הנה, אביא עליך זרים,",
                "> עריצי גויים;",
                "> וחרבותיהם יפנו",
                "> אל יפיך חכמתך",
                "> ויחללו את זוהרך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> יורידוך אל בור,",
                "> ומות תמות מותי חללים",
                "> בלב ימים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> התאמר עוד 'אני אל,'",
                "> לפני הורגיך?",
                "> ואתה אדם ולא אל,",
                "> ביד מחלליך."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> מותי ערלים תמות",
                "> ביד זרים.",
                "אני דיברתי, נאום אדוני ה'.'\""
            ]
        },
        {
            "verse": 11,
            "text": [
                "עוד דבר ה' היה אלי,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "\"בן אדם, שא קינה על מלך צור ואמרת לו: 'כה אמר אדוני ה':",
                "> \"חותם תכנית אתה,",
                "> מלא חכמה וכליל יופי."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> בעדן גן אלהים היית;",
                "> כל אבן יקרה מסכתך:",
                "> אודם, פטדה ויהלום,",
                "> תרשיש, שהם וישפה,",
                "> ספיר, נפך וברקת.",
                "> זהב מלאכת תופיך ונקביך בך;",
                "> ביום הבראך",
                "> כוננו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כרוב ממשח הסוכך,",
                "> ואני נתתיך בהר קדש אלהים;",
                "> התהלכת בתוך אבני אש."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> תמים היית בדרכיך",
                "> מיום הבראך",
                "> עד נמצא עול בך."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ברוב רכלתך",
                "> מלאו תוכך חמס,",
                "> ותחטא.",
                "> ואחללך מהר אלהים,",
                "> ואאבדך כרוב הסוכך,",
                "> מתוך אבני אש."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> גבה לבך ביפיך;",
                "> השחת חכמתך על יפעתך.",
                "> על ארץ השלכתיך;",
                "> לפני מלכים נתתיך לראוה בך."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> מרב עוונותיך,",
                "> בעול רכלתך,",
                "> חללת מקדשיך.",
                "> ואוציא אש מתוכך;",
                "> היא אכלתך,",
                "> ואתנך לאפר על הארץ",
                "> לעיני כל רואיך."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> כל יודעיך בעמים",
                "> שממו עליך;",
                "> בלהות היית",
                "> ואינך עד עולם.\"'"
            ]
        },
        {
            "verse": 20,
            "text": [
                "דבר ה' היה אלי,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "\"בן אדם, שים פניך אל צידון והנבא עליה"
            ]
        },
        {
            "verse": 22,
            "text": [
                "ואמרת, 'כה אמר אדוני ה':",
                "> \"הנני עליך, צידון,",
                "> ונכבדתי בתוכך.",
                "> וידעו כי אני ה',",
                "> בעשותי בה שפטים",
                "> ונקדשתי בה."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ושלחתי בה דבר",
                "> ודם בחוצותיה;",
                "> ונפלו חלל בתוכה",
                "> בחרב מסביב.",
                "> וידעו כי אני ה'."
            ]
        },
        {
            "verse": 24,
            "text": [
                "ולא יהיה עוד לבית ישראל סלון ממאיר וקוץ מכאיב מכל סביביהם השאטים אותם. וידעו כי אני אדוני ה'."
            ]
        },
        {
            "verse": 25,
            "text": [
                "'כה אמר אדוני ה': בקבצי את בית ישראל מן העמים אשר נפוצו בם, ונקדשתי בם לעיני הגויים, וישבו על אדמתם אשר נתתי לעבדי ליעקב."
            ]
        },
        {
            "verse": 26,
            "text": [
                "וישבו עליה לבטח; ובנו בתים ונטעו כרמים, וישבו לבטח בעשותי שפטים בכל השאטים אותם מסביבם. וידעו כי אני ה' אלהיהם.'\""
            ]
        }
    ]
}