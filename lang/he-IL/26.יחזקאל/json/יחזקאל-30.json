{
    "book": "יחזקאל",
    "chapter": 30,
    "verses": [
        {
            "verse": 1,
            "text": [
                "המסר מה' הגיע אלי:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "\"בן אדם, התנבא ואמור: 'כה אמר אדוני ה':",
                "> \"הילילו,",
                "> 'אוי ליום ההוא!'"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי קרוב היום,",
                "> אכן, יום ה' קרוב;",
                "> יום עננים,",
                "> עת פורענות לגויים."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> חרב תבוא על מצרים,",
                "> ויהיה יגון בכוש.",
                "> כאשר יפלו חללים במצרים,",
                "> עושרה יישא,",
                "> ויסודותיה ייהרסו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "כוש, פוט, לוד, כל ערב, לוב, ועם ארץ הברית יפלו בחרב יחד עם מצרים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "'כה אמר ה':",
                "> \"ונפלו תומכי מצרים",
                "> וירד גאון עוזה.",
                "> ממגדול עד סונה יפלו בחרב בתוכה,\"",
                "> נאום אדוני ה'."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"והיו שממה",
                "> בתוך ארצות שוממות,",
                "> ועריהם תהיינה",
                "> בתוך ערים חרבות."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> וידעו כי אני ה',",
                "> כאשר אתן אש במצרים",
                "> ונשברו כל עוזריה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "ביום ההוא יצאו ממני מלאכים באניות להחריד את כוש מבטחם; רעד יאחזם ביום מפלת מצרים, כי בא יבוא."
            ]
        },
        {
            "verse": 10,
            "text": [
                "'כה אמר אדוני ה':",
                "> \"והשבתי המון מצרים",
                "> ביד נבוכדנאצר מלך בבל."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הוא ועמו עמו,",
                "> עריצי גויים,",
                "> יבואו להשחית את הארץ.",
                "> וחרבותיהם על מצרים",
                "> ומלאו את הארץ חללים."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> והובשתי את יאורי מצרים",
                "> ומכרתי את הארץ ביד אנשים רעים;",
                "> וידי זרים אשימנה שממה",
                "> וכל אשר בה.",
                "אני ה' דברתי."
            ]
        },
        {
            "verse": 13,
            "text": [
                "'כה אמר אדוני ה':",
                "> \"והאבדתי את הגילולים",
                "> והשבתי את האלילים מנוף.",
                "> ולא יהיה עוד נשיא מארץ מצרים,",
                "> ונתתי יראה בארץ."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> והשימותי את פתחור,",
                "> ונתתי אש בצוען,",
                "> ועשיתי שפטים בנא."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ושפכתי חמתי על סין,",
                "> מעוז מצרים,",
                "> והכרתי את המון נא."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ונתתי אש במצרים;",
                "> תחולל סין ביגון,",
                "> ונא תיבקע,",
                "> ונוף תהיה צרות תמיד."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> בחורי און ופיבסט",
                "> יפלו בחרב,",
                "> והנשים תלכנה בשבי."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> חשך יהיה היום בתחפנחס",
                "> כאשר אשבור את עול מצרים;",
                "> ושם יכלה גאון עוזה.",
                "> ענן יכסה אותה,",
                "> ובנותיה תלכנה בשבי."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ועשיתי שפטים במצרים,",
                "> וידעו כי אני ה'.'\""
            ]
        },
        {
            "verse": 20,
            "text": [
                "בשנה האחת עשרה, בחודש הראשון ביום השביעי, המסר מה' הגיע אלי:"
            ]
        },
        {
            "verse": 21,
            "text": [
                "\"בן אדם, שברתי את זרוע פרעה מלך מצרים. לא חבשו לרפואה ולא חגרו בתחבושת, כדי שתהיה חזקה להחזיק בחרב."
            ]
        },
        {
            "verse": 22,
            "text": [
                "לכן כה אמר אדוני ה': 'הנה אני אל פרעה מלך מצרים, ושברתי את שתי זרועותיו, את החזקה ואת השבורה, והפלתי את החרב מידו."
            ]
        },
        {
            "verse": 23,
            "text": [
                "והפיצותי את המצרים בגויים וזריתים בארצות."
            ]
        },
        {
            "verse": 24,
            "text": [
                "וחיזקתי את זרועות מלך בבל ונתתי את חרבי בידו, ושברתי את זרועות פרעה, ונאנח לפניו כאנוש פצוע."
            ]
        },
        {
            "verse": 25,
            "text": [
                "וחיזקתי את זרועות מלך בבל, וזרועות פרעה תיפולנה. וידעו כי אני ה', כאשר אתן את חרבי ביד מלך בבל ונטה אותה על ארץ מצרים."
            ]
        },
        {
            "verse": 26,
            "text": [
                "והפיצותי את המצרים בגויים וזריתים בארצות, וידעו כי אני ה'.'\""
            ]
        }
    ]
}