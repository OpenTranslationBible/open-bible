{
    "book": "עמוס",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "דברי עמוס אשר היה בנוקדים מתקוע אשר חזה על ישראל בימי עוזיה מלך יהודה ובימי ירבעם בן יואש מלך ישראל שנתיים לפני הרעש."
            ]
        },
        {
            "verse": 2,
            "text": [
                "ויאמר:",
                "> \"יהוה ישאג מציון",
                "> ומירושלים יתן קולו;",
                "> ואבלו נאות הרועים,",
                "> ויבש ראש הכרמל.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "כה אמר יהוה:",
                "> \"על שלושה פשעי דמשק ועל ארבעה",
                "> לא אשיבנו.",
                "> על דושם בחרוצות הברזל את הגלעד,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ושלחתי אש בבית חזאל",
                "> ואכלה ארמנות בן-הדד."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ושברתי בריח דמשק;",
                "> והכרתי יושב מבקעת און",
                "> ותומך שבט מבית עדן.",
                "> וגלו עם ארם קירה,\"",
                "אמר יהוה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "כה אמר יהוה:",
                "> \"על שלושה פשעי עזה ועל ארבעה",
                "> לא אשיבנו.",
                "> על הגלותם גלות שלמה",
                "> להסגיר לאדום,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ושלחתי אש בחומת עזה",
                "> ואכלה ארמנותיה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> והכרתי יושב מאשדוד",
                "> ותומך שבט מאשקלון.",
                "> והשבתי ידי על עקרון,",
                "> ואבד שארית פלשתים,\"",
                "אמר אדוני יהוה."
            ]
        },
        {
            "verse": 9,
            "text": [
                "כה אמר יהוה:",
                "> \"על שלושה פשעי צור ועל ארבעה",
                "> לא אשיבנו.",
                "> על הסגירם גלות שלמה לאדום",
                "> ולא זכרו ברית אחים,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ושלחתי אש בחומת צור",
                "> ואכלה ארמנותיה.\""
            ]
        },
        {
            "verse": 11,
            "text": [
                "כה אמר יהוה:",
                "> \"על שלושה פשעי אדום ועל ארבעה",
                "> לא אשיבנו.",
                "> על רדפו בחרב אחיו",
                "> ושחת רחמיו;",
                "> ויטרף לעד אפו",
                "> ועברתו שמרה נצח,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ושלחתי אש בתימן",
                "> ואכלה ארמנות בצרה.\""
            ]
        },
        {
            "verse": 13,
            "text": [
                "כה אמר יהוה:",
                "> \"על שלושה פשעי בני עמון ועל ארבעה",
                "> לא אשיבנו.",
                "> על בקעם הרות הגלעד",
                "> למען הרחיב את גבולם,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> והצתי אש בחומת רבה",
                "> ואכלה ארמנותיה",
                "> בתרועה ביום מלחמה",
                "> בסער ביום סופה."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> והלך מלכם בגולה,",
                "> הוא ושריו יחדו,\"",
                "אמר יהוה."
            ]
        }
    ]
}