{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "כך אמר ה':",
                "> \"על שלושה פשעי מואב ועל ארבעה,",
                "> לא אשיבנו,",
                "> על ששרף את עצמות מלך אדום לשיד."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ושילחתי אש במואב,",
                "> ואכלה ארמונות קריות;",
                "> ומת מואב בשאון,",
                "> בתרועה ובקול שופר."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> והכרתי שופט מקרבה",
                "> וכל שריה אהרוג עמו,\"",
                "> אמר ה'."
            ]
        },
        {
            "verse": 4,
            "text": [
                "כך אמר ה':",
                "> \"על שלושה פשעי יהודה ועל ארבעה,",
                "> לא אשיבנו,",
                "> על מאסם את תורת ה',",
                "> וחוקיו לא שמרו;",
                "> ויתעום כזביהם,",
                "> אשר הלכו אבותם אחריהם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ושלחתי אש ביהודה,",
                "> ואכלה ארמונות ירושלים.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "כך אמר ה':",
                "> \"על שלושה פשעי ישראל ועל ארבעה,",
                "> לא אשיבנו,",
                "> על מכרם בכסף צדיק,",
                "> ואביון בעבור נעליים."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> השואפים על עפר ארץ בראש דלים",
                "> ודרך ענוים יטו;",
                "> ואיש ואביו ילכו אל הנערה,",
                "> למען חלל את שם קדשי."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ועל בגדים חבולים יטו אצל כל מזבח,",
                "> ויין ענושים ישתו בבית אלהיהם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ואנכי השמדתי את האמורי מפניהם,",
                "> אשר כגובה ארזים גובהו,",
                "> וחסון הוא כאלונים;",
                "> ואשמיד פריו ממעל ושרשיו מתחת."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ואנכי העליתי אתכם מארץ מצרים,",
                "> ואולך אתכם במדבר ארבעים שנה,",
                "> לרשת את ארץ האמורי."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ואקים מבניכם לנביאים,",
                "> ומבחוריכם לנזירים.",
                "> האף אין זאת, בני ישראל?\"",
                "> נאם ה'."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"ותשקו את הנזירים יין,",
                "> ועל הנביאים צויתם לאמר,",
                "> 'לא תנבאו!'"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> הנה אנכי מעיק תחתיכם,",
                "> כאשר תעיק העגלה המלאה לה עמיר."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ואבד מנוס מקל,",
                "> וחזק לא יאמץ כחו,",
                "> וגבור לא ימלט נפשו."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ותפש קשת לא יעמוד,",
                "> וקל ברגליו לא ימלט,",
                "> ורכב סוס לא ימלט נפשו."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ואמיץ לב בגבורים ערום ינוס ביום ההוא,\"",
                "> נאם ה'."
            ]
        }
    ]
}