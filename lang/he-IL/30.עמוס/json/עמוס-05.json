{
    "book": "עמוס",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "שמעו את הדבר הזה, בית ישראל, הקינה הזאת שאני מרים עליכם:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"נפלה בתולת ישראל,",
                "> לא תוסיף קום.",
                "> ננטשה על אדמתה;",
                "> אין מי שיקים אותה.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי כה אמר אדוני ה' לישראל:",
                "> \"העיר היוצאת באלף",
                "> תשאיר מאה,",
                "> והיוצאת במאה",
                "> תשאיר עשרה.\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "כי כה אמר ה' לבית ישראל:",
                "> \"דרשו אותי, ותחיו."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אל תדרשו את בית אל,",
                "> ואל תלכו אל הגלגל,",
                "> ואל תעברו אל באר שבע;",
                "> כי הגלגל גולה יגלה,",
                "> ובית אל תהיה לאין.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "> דרשו את ה', ותחיו,",
                "> פן יבער כאש בית יוסף,",
                "> ואכלה ואין מכבה לבית אל."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> המה הופכים למר משפט",
                "> וצדקה לארץ הניחו."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> עשה כימה וכסיל,",
                "> הופך בוקר צלמות",
                "> ויום לילה החשיך,",
                "> הקורא למי הים",
                "> וישפכם על פני הארץ",
                "> — ה' שמו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> המבליג שוד על עז,",
                "> ושוד על מבצר יבוא."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> שנאו בשער מוכיח",
                "> ודובר תמים יתעבו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> לכן, יען כי תבוססו דל",
                "> ומס תרומת חיטה תקחו ממנו,",
                "> בתי גזית בניתם,",
                "> ולא תשבו בהם;",
                "> כרמי חמד נטעתם,",
                "> ולא תשתו את יינם."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> כי ידעתי רבים פשעיכם ורבים חטאותיכם.",
                "> לוחצי צדיק, לקחי כופר,",
                "> ודלים בשער הטו."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לכן המשכיל בעת ההיא ידום,",
                "> כי עת רעה היא."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> דרשו טוב ואל רע, למען תחיו;",
                "> ויהי כן ה' אלוהי צבאות אתכם,",
                "> כאשר אמרתם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> שנאו רע, אהבו טוב,",
                "> והציגו בשער משפט.",
                "> אולי יחנן ה' אלוהי צבאות",
                "> שארית יוסף."
            ]
        },
        {
            "verse": 16,
            "text": [
                "לכן, כה אמר ה', אלוהי צבאות:",
                "> \"מספד בכל רחובות",
                "> ובכל חוצות יאמרו הו הו.",
                "> וקראו אכר אל אבל",
                "> ומספד אל יודעי נהי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ובכל כרמים מספד,",
                "> כי אעבור בקרבך,\" אמר ה'."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> הוי המתאוים את יום ה'!",
                "> למה זה לכם יום ה'?",
                "> הוא חושך ולא אור."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> כאשר ינוס איש מפני הארי",
                "> ופגעו הדוב,",
                "> ובא הבית וסמך ידו על הקיר",
                "> ונשכו הנחש."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> הלא יום ה' חושך ולא אור,",
                "> ואפלה ולא נגה לו?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> \"שנאתי, מאסתי חגיכם;",
                "> ולא אריח בעצרתיכם."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> כי אם תעלו לי עולות ומנחות,",
                "> לא ארצה;",
                "> ושלם מריאיכם לא אביט."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> הסר מעלי המון שיריך;",
                "> וזמרת נבליך לא אשמע."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ויגל כמים משפט,",
                "> וצדקה כנחל איתן."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> הזבחים ומנחה הגשתם לי",
                "> במדבר ארבעים שנה, בית ישראל?"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> ונשאתם את סכות מלככם ואת כיון צלמיכם,",
                "> כוכב אלוהיכם אשר עשיתם לכם."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> והגליתי אתכם מהלאה לדמשק,\"",
                "אמר ה', אלוהי צבאות שמו."
            ]
        }
    ]
}