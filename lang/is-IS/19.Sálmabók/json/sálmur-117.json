{
    "book": "Sálmabók",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Heiðrið Drottin, allar þjóðir;",
                "> Fagnið nafni hans, allir lýðir!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Því að miskunn hans við oss er mikil,",
                "> Og trúfesti Drottins varir að eilífu.",
                "---",
                "> Heiðrið Drottin!"
            ]
        }
    ]
}