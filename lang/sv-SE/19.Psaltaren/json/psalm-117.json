{
    "book": "Psaltaren",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Ära Herren, alla nationer;",
                "> Fira Hans namn, alla folk!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Ty Hans godhet mot oss är enorm,",
                "> Och Herrens trofasthet varar för evigt.",
                "---",
                "> Ära Herren!"
            ]
        }
    ]
}