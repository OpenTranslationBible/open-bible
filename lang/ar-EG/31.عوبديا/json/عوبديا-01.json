{
    "book": "عوبديا",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "رؤيا عوبديا.",
                "هكذا قال السيد الرب عن أدوم—",
                "> قد سمعنا خبراً من الرب،",
                "> وأُرسل رسول بين الأمم قائلاً،",
                "> \"قوموا ولنقم عليها للحرب\"—"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"ها أنا أجعلك صغيراً بين الأمم؛",
                "> أنت محتقر جداً."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> غطرسة قلبك قد خدعتك،",
                "> يا من تسكن في شقوق الصخر،",
                "> في علو مسكنك،",
                "> الذي يقول في قلبه،",
                "> 'من يقدر أن يهبطني إلى الأرض؟'"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> إن رفعت كالنسر عشك،",
                "> وإن وضعت بين النجوم،",
                "> فمن هناك أهبطك\"، يقول الرب."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> \"إن أتاك لصوص،",
                "> إن جاءك نهبون في الليل—",
                "> كيف هلكت!—",
                "> ألا يسرقون حتى يكتفوا؟",
                "> إن جاءك قاطفو العنب،",
                "> ألا يتركون بعض القطاف؟"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> كيف فتش عيسو،",
                "> وفتشت كنوزه المخفية!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> جميع رجال عهدك",
                "> أرسلوك إلى الحدود،",
                "> وغلبك رجال السلام معك.",
                "> الذين يأكلون خبزك",
                "> وضعوا لك فخاً.",
                "> (لا فهم فيه.)"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> في ذلك اليوم\"، يقول الرب،",
                "> \"أبيد الحكماء من أدوم،",
                "> والفهم من جبل عيسو."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> فيرتعب أبطالك، يا تيمان،",
                "> لكي ينقرض الجميع",
                "> من جبل عيسو بالقتل."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> من أجل ظلمك لأخيك يعقوب،",
                "> يغطيك الخزي،",
                "> وتنقطع إلى الأبد."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> يوم وقفت مقابله،",
                "> يوم أخذ الغرباء ثروته،",
                "> ودخل الأجانب بابه",
                "> وألقوا قرعة على أورشليم—",
                "> كنت أنت أيضاً كواحد منهم."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> لا تشمت بيوم أخيك،",
                "> يوم مصيبته.",
                "> ولا تفرح لبني يهوذا",
                "> يوم هلاكهم؛",
                "> ولا تفغر فمك",
                "> يوم ضيقهم."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> لا تدخل باب شعبي",
                "> يوم بليتهم.",
                "> نعم، أنت، لا تشمت بمصيبتهم",
                "> يوم بليتهم.",
                "> ولا تمد يدك إلى ثروتهم",
                "> يوم بليتهم."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ولا تقف عند المفترق",
                "> لتقطع الناجين منهم؛",
                "> ولا تسلم الناجين منهم",
                "> يوم ضيقهم."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> لأن يوم الرب قريب",
                "> على كل الأمم!",
                "> كما فعلت، يُفعل بك.",
                "> عملك سيرتد على رأسك."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> كما شربتم على جبلي المقدس،",
                "> هكذا تشرب جميع الأمم دائماً.",
                "> يشربون ويبتلعون،",
                "> ويكونون كأنهم لم يكونوا."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> أما في جبل صهيون يكون نجاة،",
                "> ويكون مقدساً.",
                "> ويرث بيت يعقوب",
                "> ممتلكاتهم."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> فيكون بيت يعقوب ناراً،",
                "> وبيت يوسف لهباً؛",
                "> وبيت عيسو قشاً.",
                "> فيضرمونهم ويحرقونهم،",
                "> فلا يكون ناجٍ",
                "> لبيت عيسو\"،",
                "> لأن الرب تكلم."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> فيرث أهل الجنوب جبل عيسو،",
                "> وأهل السهل أرض الفلسطينيين؛",
                "> ويرثون أرض أفرايم وأرض السامرة،",
                "> ويرث بنيامين جلعاد."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> وسبي هذا الجيش من بني إسرائيل،",
                "> الذين هم بين الكنعانيين إلى صرفة،",
                "> وسبي أورشليم الذين في صفارد،",
                "> يرثون مدن الجنوب."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ويصعد المنقذون إلى جبل صهيون",
                "> ليدينوا جبل عيسو،",
                "> وتكون المملكة للرب."
            ]
        }
    ]
}