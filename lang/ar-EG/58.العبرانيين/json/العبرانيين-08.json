{
    "book": "العبرانيين",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "النقطة الرئيسية في ما نناقشه هي هذه: لدينا رئيس كهنة جلس عن يمين عرش الجلالة في السماوات،"
            ]
        },
        {
            "verse": 2,
            "text": [
                "خادم في المقدس وفي المسكن الحقيقي الذي أقامه الرب، وليس بأيدي بشرية."
            ]
        },
        {
            "verse": 3,
            "text": [
                "كل رئيس كهنة يُعين ليقدم هدايا وذبائح؛ لذلك من الضروري أن يكون لدى هذا الرئيس الكاهن شيء ليقدمه أيضًا."
            ]
        },
        {
            "verse": 4,
            "text": [
                "لو كان على الأرض، لما كان كاهنًا على الإطلاق، لأن هناك كهنة يقدمون الهدايا حسب الناموس."
            ]
        },
        {
            "verse": 5,
            "text": [
                "هم يخدمون في مقدس هو نسخة وظل للأشياء السماوية، كما أُنبئ موسى عندما كان على وشك بناء المسكن: \"انظر أن تصنع كل شيء حسب النموذج الذي أُظهر لك على الجبل.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "ولكن الآن حصل على خدمة أفضل، إلى الحد الذي هو أيضًا وسيط عهد أفضل، مؤسس على وعود أفضل."
            ]
        },
        {
            "verse": 7,
            "text": [
                "لأنه لو كان العهد الأول بلا عيب، لما كان هناك حاجة لعهد ثانٍ."
            ]
        },
        {
            "verse": 8,
            "text": [
                "لأنه وجد عيبًا في الناس، يقول:",
                "> \"ها أيام تأتي، يقول الرب،",
                "> حين أُقيم عهدًا جديدًا",
                "> مع بيت إسرائيل ومع بيت يهوذا."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> لن يكون مثل العهد",
                "> الذي صنعته مع آبائهم",
                "> يوم أمسكت بيدهم",
                "> لأخرجهم من أرض مصر؛",
                "> لأنهم لم يثبتوا في عهدي،",
                "> فأعرضت عنهم، يقول الرب."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> هذا هو العهد",
                "> الذي سأقيمه مع بيت إسرائيل",
                "> بعد تلك الأيام، يقول الرب:",
                "> سأضع نواميسي في عقولهم",
                "> وأكتبها على قلوبهم.",
                "> سأكون إلههم،",
                "> وهم سيكونون شعبي."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ولن يعلموا كل واحد جاره،",
                "> وكل واحد أخاه، قائلين، 'اعرف الرب،'",
                "> لأنهم جميعًا سيعرفونني،",
                "> من صغيرهم إلى كبيرهم."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> لأني سأكون رحيمًا تجاه آثامهم،",
                "> ولن أذكر خطاياهم بعد.\""
            ]
        },
        {
            "verse": 13,
            "text": [
                "بدعوته هذا العهد \"جديدًا\"، جعل الأول عتيقًا؛ وما هو عتيق ويشيخ سيختفي قريبًا."
            ]
        }
    ]
}