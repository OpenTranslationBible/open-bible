{
    "book": "المزامير",
    "chapter": 130,
    "verses": [
        {
            "text": [
                "ترنيمة المصاعد."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> من الأعماق صرخت إليك، يا رب."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> يا رب، استمع صوتي!",
                "> لتكن أذناك مصغيتين",
                "> إلى صوت تضرعاتي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> إذا كنت، يا رب، تراقب الآثام،",
                "> يا رب، من يقف؟"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ولكن عندك المغفرة،",
                "> لذلك تُهاب."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> أنتظر الرب، نفسي صابرة،",
                "> وأضع أملي في كلمته."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> نفسي تنتظر الرب بشوق",
                "> أكثر من الحراس للصباح؛",
                "> نعم، أكثر من الحراس للصباح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> يا إسرائيل، ضع أملك في الرب؛",
                "> لأن عند الرب رحمة،",
                "> وعنده فداء كثير."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> وهو سيفدي إسرائيل",
                "> من كل آثامه."
            ]
        }
    ]
}