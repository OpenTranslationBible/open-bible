{
    "book": "المزامير",
    "chapter": 115,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ليس لنا يا رب، ليس لنا،",
                "> بل لاسمك أعطِ المجد،",
                "> من أجل رحمتك وأمانتك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> لماذا تقول الأمم،",
                "> \"أين إلههم الآن؟\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> إن إلهنا في السماوات؛",
                "> يفعل كل ما يشاء."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> أصنامهم من فضة وذهب،",
                "> صنعة أيدي الناس."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لها أفواه ولا تتكلم؛",
                "> لها عيون ولا تبصر؛"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> لها آذان ولا تسمع؛",
                "> لها أنوف ولا تشم؛"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> لها أيدي ولا تلمس؛",
                "> لها أرجل ولا تمشي؛",
                "> ولا تصدر صوتًا في حناجرها."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> مثلها يكون صانعوها،",
                "> وكل من يثق بها."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> يا إسرائيل، اتكل على الرب؛",
                "> هو عونك ودرعك."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> يا بيت هارون، اتكلوا على الرب؛",
                "> هو عونكم ودرعكم."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> يا خائفي الرب، اتكلوا على الرب؛",
                "> هو عونكم ودرعكم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> الرب يذكرنا وسيباركنا.",
                "> سيبارك بيت إسرائيل؛",
                "> سيبارك بيت هارون."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> سيبارك خائفي الرب،",
                "> الصغار والكبار."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ليزدكم الرب،",
                "> أنتم وأبناؤكم."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> مباركون أنتم من الرب،",
                "> خالق السماء والأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> السماوات للرب،",
                "> أما الأرض فقد أعطاها للبشر."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> الموتى لا يسبحون الرب،",
                "> ولا أي من ينزل إلى الصمت؛"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> أما نحن فنبارك الرب",
                "> من الآن وإلى الأبد.",
                "> سبحوا الرب!"
            ]
        }
    ]
}