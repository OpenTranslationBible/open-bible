{
    "book": "المزامير",
    "chapter": 147,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> سبحوا الرب!",
                "> جيد أن نرنم لإلهنا؛",
                "> إنه لذيذ، ومثل هذا التسبيح جميل."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> الرب يعيد بناء أورشليم؛",
                "> يجمع منفيي إسرائيل."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> يشفي المنكسرين القلوب",
                "> ويضمد جراحهم."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> يعد النجوم؛",
                "> يسمي كل واحدة باسم."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> عظيم هو ربنا، وقوي في القدرة؛",
                "> فهمه لا حدود له."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> الرب يرفع المظلومين؛",
                "> يطرح الأشرار إلى الأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> قدموا أغاني للرب بشكر؛",
                "> عزفوا لإلهنا على العود،"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> الذي ينشر السحب في السماء،",
                "> الذي يرسل المطر على الأرض،",
                "> الذي يجعل العشب ينمو على الجبال."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> هو يوفر الطعام للحيوانات،",
                "> وللغراب الصغير عندما ينادي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> لا يجد فرحًا في قوة الحصان؛",
                "> لا يسر بساقي الإنسان."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> الرب يسر بالذين يخافونه،",
                "> الذين يرجون رحمته."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> سبحوا الرب، يا أورشليم!",
                "> أكرمي إلهك، يا صهيون!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> لأنه قد قوى عوارض أبوابك؛",
                "> قد بارك أولادك داخلك."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> يمنح السلام داخل حدودك؛",
                "> يملأك بأفضل القمح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> يرسل أمره إلى الأرض؛",
                "> كلمته تسير بسرعة."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> يمنح الثلج كالصوف؛",
                "> ينشر الصقيع كالرماد."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> يلقي جليده كقطع؛",
                "> من يستطيع الوقوف أمام بروده؟"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> يرسل كلمته ويذيبها؛",
                "> يجعل ريحه تهب، والمياه تجري."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> يكشف كلماته ليعقوب،",
                "> فرائضه وأحكامه لإسرائيل."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> لم يفعل هكذا مع أي أمة أخرى؛",
                "> أما أحكامه، فلم يفهموها.",
                "> سبحوا الرب!"
            ]
        }
    ]
}