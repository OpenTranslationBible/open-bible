{
    "book": "المزامير",
    "chapter": 142,
    "verses": [
        {
            "text": [
                "قصيدة تعليمية لداود. عندما كان في المغارة. صلاة."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> أصرخ بصوتي إلى الرب؛",
                "> أطلب بصوتي إلى الرب الرحمة."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> أفيض ضيقي أمامه؛",
                "> أكشف له مشاكلي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> عندما غمرني روحي داخلي،",
                "> كنت تعرف طريقي.",
                "> في الطريق الذي أسير فيه",
                "> وضعوا لي فخًا."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> انظر إلى اليمين وراقب؛",
                "> لأنه لا يوجد من يلاحظني.",
                "> لا يوجد مهرب لي؛",
                "> لا أحد يهتم بنفسي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ناديتك، يا رب؛",
                "> أعلنت، \"أنت ملجأي،",
                "> نصيبي في أرض الأحياء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> استمع إلى صرختي،",
                "> لأني قد انخفضت جدًا؛",
                "> أنقذني من مضطهدي،",
                "> لأنهم أقوى مني."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ارفع نفسي من الحزن،",
                "> لكي أشكر اسمك؛",
                "> سيتجمع الأبرار حولي،",
                "> لأنك ستعتني بي.\""
            ]
        }
    ]
}