{
    "book": "المزامير",
    "chapter": 20,
    "verses": [
        {
            "text": [
                "لإمام الموسيقى. مزمور لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ليجبك الرب في يوم الضيق!",
                "> ليحميك اسم إله يعقوب!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ليرسل لك عونًا من المقدس،",
                "> وليعضدك من صهيون!"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ليذكر كل تقدماتك",
                "> ويقبل محرقاتك برضى!",
                "> سلاه"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ليعطك حسب قلبك",
                "> ويتمم كل مشورتك!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> نهتف بخلاصك،",
                "> وباسم إلهنا نرفع راياتنا.",
                "---",
                "> ليتمم الرب كل سؤلك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> الآن علمت أن الرب يخلص مسيحه؛",
                "> يجيبه من سماء قدسه",
                "> بقوة خلاص يمينه."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> هؤلاء بالمركبات وهؤلاء بالخيل،",
                "> أما نحن فاسم الرب إلهنا نذكر."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> هم جثوا وسقطوا،",
                "> أما نحن فقمنا وانتصبنا."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> خلص يا رب؛",
                "> ليستجب لنا الملك في يوم دعائنا."
            ]
        }
    ]
}