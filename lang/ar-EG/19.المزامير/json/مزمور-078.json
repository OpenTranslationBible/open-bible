            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> وحول أنهارهم إلى دم،",
                "> وجداولهم، حتى لا يشربوا."
            ]
        },
        {
            "verse": 45,
            "text": [
