{
    "book": "المزامير",
    "chapter": 116,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> أحب الرب لأنه يسمع",
                "> صوتي وتضرعاتي."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> لأنه أمال أذنه إليّ،",
                "> لذلك أدعوه طوال أيامي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> أحاطت بي فخاخ الموت",
                "> وأدركتني أهوال القبر؛",
                "> وجدت ضيقًا وحزنًا."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ثم دعوت باسم الرب:",
                "> \"أرجوك، يا رب، احفظ حياتي!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> الرب حنون وعادل؛",
                "> حقًا، إلهنا مليء بالرحمة."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> الرب يحمي البسطاء؛",
                "> انخفضت، فأنقذني."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> عودي إلى سلامك، يا نفسي،",
                "> لأن الرب كان كريمًا معك."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> لأنك أنقذت نفسي من الموت،",
                "> وعيني من البكاء،",
                "> وقدمي من التعثر."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> أسير أمام الرب",
                "> في أرض الأحياء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> وثقت حتى عندما قلت،",
                "> \"أنا في ضيق شديد.\""
            ]
        },
        {
            "verse": 11,
            "text": [
                "> قلت في حيرتي،",
                "> \"كل الناس مخادعون.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> كيف أرد للرب",
                "> كل إحسانه لي؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> أرفع كأس الخلاص،",
                "> وأدعو باسم الرب."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> أوفي نذوري للرب",
                "> في محفل شعبه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ثمين في عيني الرب",
                "> موت أتقيائه."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> يا رب، أنا حقًا عبدك؛",
                "> أنا عبدك، ابن أمتك،",
                "> لقد حررتني من قيودي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> لك أقدم ذبيحة شكر،",
                "> وأدعو باسم الرب."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> أوفي نذوري للرب",
                "> في محفل شعبه."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> في ديار بيت الرب،",
                "> في وسطك، يا أورشليم.",
                "> سبحوا الرب!"
            ]
        }
    ]
}