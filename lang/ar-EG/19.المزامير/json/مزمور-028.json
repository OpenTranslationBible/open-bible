{
    "book": "المزامير",
    "chapter": 28,
    "verses": [
        {
            "text": [
                "مزمور لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> إليك يا رب أصرخ؛",
                "> صخرتي، لا تكن صامتًا لي،",
                "> لأني إن سكت عني،",
                "> أكون مثل الذين ينزلون إلى الجب."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> استمع لصوت تضرعاتي عندما أصرخ مستغيثًا بك،",
                "> عندما أرفع يدي نحو محراب قدسك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لا تجذبني مع الأشرار",
                "> ومع الذين يفعلون الإثم،",
                "> الذين يتكلمون بالسلام مع جيرانهم،",
                "> والشر في قلوبهم."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> جازهم حسب أعمالهم",
                "> وحسب شر أفعالهم؛",
                "> جازهم حسب عمل أيديهم؛",
                "> أعطهم ما يستحقون."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لأنهم لا يراعون أعمال الرب",
                "> ولا أعمال يديه،",
                "> يهدمهم ولا يبنيهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> مبارك الرب،",
                "> لأنه سمع صوت تضرعاتي."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> الرب قوتي وترسي؛",
                "> عليه اتكل قلبي فأعانني؛",
                "> لذلك يبتهج قلبي،",
                "> وبأغنيتي أحمده."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> الرب هو قوة شعبه،",
                "> وهو حصن خلاص لمسيحه."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> خلص شعبك وبارك ميراثك؛",
                "> ارعهم واحملهم إلى الأبد."
            ]
        }
    ]
}