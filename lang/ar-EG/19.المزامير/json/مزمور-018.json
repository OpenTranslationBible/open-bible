{
    "book": "المزامير",
    "chapter": 18,
    "verses": [
        {
            "text": [
                "لإمام الموسيقيين. مزمور لداود، خادم الرب، الذي كلم الرب بكلمات هذا النشيد في اليوم الذي أنقذه فيه الرب من يد جميع أعدائه ومن يد شاول. وقال:"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> أحبك يا رب، يا قوتي."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> الرب صخرتي وحصني ومخلصي،",
                "> إلهي، صخرتي التي ألتجئ إليها؛",
                "> ترسي وقرن خلاصي، ملجأي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> أدعو الرب المستحق للحمد،",
                "> فأخلص من أعدائي."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> أحبال الموت اكتنفتني،",
                "> وسيول الهلاك أفزعتني."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> شباك القبر أحاطت بي؛",
                "> فخاخ الموت واجهتني."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> في ضيقي دعوت الرب،",
                "> وصرخت إلى إلهي للمعونة؛",
                "> سمع صوتي من هيكله،",
                "> وبلغ صراخي أذنيه."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> فارتجت الأرض واهتزت؛",
                "> وتزعزعت أسس الجبال",
                "> وتحركت، لأنه غضب."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> صعد دخان من أنفه،",
                "> ونار آكلة من فمه؛",
                "> جمرات مشتعلة انطلقت منه."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> طأطأ السماوات ونزل،",
                "> وظلام كثيف تحت قدميه."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ركب على كروب وطار؛",
                "> وحلق على أجنحة الرياح."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> جعل الظلام ستره، غطاءه حوله،",
                "> مياه مظلمة، سحب كثيفة من السماء."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> من النور الذي أمامه عبرت سحبه الكثيفة،",
                "> برد وجمرات نار."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> الرب أرعد في السماوات،",
                "> والعلي أسمع صوته،",
                "> برد وجمرات نار."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> أرسل سهامه وشتتهم،",
                "> وبرقاً كثيراً فهزمهم."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> فظهرت مجاري المياه،",
                "> وانكشفت أسس العالم",
                "> من زجرك يا رب،",
                "> من نفخة نسمة أنفك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> أرسل من العلى، أخذني؛",
                "> انتشلني من مياه كثيرة."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> أنقذني من عدوي القوي،",
                "> ومن مبغضيّ، لأنهم كانوا أقوى مني."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> واجهوني في يوم مصيبتي،",
                "> لكن الرب كان سندي."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> أخرجني إلى مكان واسع؛",
                "> خلصني، لأنه سرّ بي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> كافأني الرب حسب برّي؛",
                "> حسب نقاوة يدي ردّ لي."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> لأني حفظت طرق الرب،",
                "> ولم أرتد عن إلهي."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> لأن جميع أحكامه أمامي،",
                "> ولم أترك فرائضه."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> وكنت كاملاً أمامه،",
                "> وحفظت نفسي من الإثم."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> لذلك ردّ لي الرب حسب برّي،",
                "> حسب نقاوة يدي أمام عينيه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> مع الرحيم تكون رحيماً؛",
                "> مع الكامل تظهر نفسك كاملاً؛"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> مع الطاهر تكون طاهراً،",
                "> ومع الملتوي تظهر نفسك ملتويًا."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> لأنك تخلص الشعب المتواضع،",
                "> وتخفض العيون المتكبرة."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> لأنك تضيء سراجي؛",
                "> الرب إلهي ينير ظلمتي."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> لأني بك اقتحمت جيشاً؛",
                "> وبإلهي قفزت سوراً."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> الله كامل طريقه؛",
                "> كلمة الرب مصفاة؛",
                "> هو ترس لجميع المحتمين به."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> لأنه من هو إله غير الرب؟",
                "> ومن هو صخرة غير إلهنا؟"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> الإله الذي يمنطقني بالقوة،",
                "> ويجعل طريقي كاملاً؟"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> يجعل قدميّ كالأيائل،",
                "> ويقيمني على مرتفعاتي."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> يعلم يدي القتال،",
                "> فتثني ذراعي قوس نحاس."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> أعطيتني ترس خلاصك،",
                "> ويمينك تسندني؛",
                "> ولطفك يعظمني."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> وسعت خطواتي تحتي،",
                "> فلم تزل قدماي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> طاردت أعدائي فأدركتهم،",
                "> ولم أرجع حتى أفنيتهم."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> سحقتهم فلم يستطيعوا القيام؛",
                "> سقطوا تحت قدميّ."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> لأنك نطقتني قوة للقتال؛",
                "> أخضعت تحتي القائمين عليّ."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> جعلت أعدائي يولّون لي الأدبار،",
                "> وأفنيت مبغضيّ."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> صرخوا ولم يكن من يخلصهم؛",
                "> صرخوا إلى الرب فلم يجبهم."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> فدققتهم كغبار أمام الريح؛",
                "> طرحتهم كطين في الشوارع."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> نجيتني من مخاصمات الشعب؛",
                "> جعلتني رأساً للأمم؛",
                "> شعب لم أعرفه يخدمني."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> عند سماعهم لي يطيعونني؛",
                "> الأجانب يخضعون لي."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> الأجانب يذوبون،",
                "> ويخرجون مرتعدين من حصونهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> حيّ هو الرب، ومبارك صخرتي؛",
                "> ومرتفع إله خلاصي،"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> الإله الذي ينتقم لي،",
                "> ويخضع الشعوب تحتي."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> منقذي من أعدائي؛",
                "> ترفعني فوق القائمين عليّ؛",
                "> تنجيني من الرجل الظالم."
            ]
        },
        {
            "verse": 49,
            "text": [
                "> لذلك أحمدك بين الأمم، يا رب،",
                "> وأرنم لاسمك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> يعطي خلاصاً عظيماً لملكه،",
                "> ويظهر رحمة لمسيحه،",
                "> لداود ونسله إلى الأبد."
            ]
        }
    ]
}