{
    "book": "المزامير",
    "chapter": 120,
    "verses": [
        {
            "text": [
                "ترنيمة المصاعد."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> في ضيقي صرخت إلى الرب،",
                "> فاستجاب لي."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> يا رب، نجِّ نفسي من الشفاه الكاذبة،",
                "> ومن اللسان الغاش."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ماذا يُعطى لك، وماذا يُزاد لك،",
                "> أيها اللسان الغاش؟"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> سهام المحارب الحادة،",
                "> مع جمرات العرعر المتقدة!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ويل لي، لأني أقيم في ماشك،",
                "> وقد جعلت مسكني بين خيام قيدار!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> نفسي قد سكنت طويلاً",
                "> بين الذين هم ضد السلام."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> أنا أطلب السلام، ولكن عندما أتكلم،",
                "> يلاحقون النزاع."
            ]
        }
    ]
}