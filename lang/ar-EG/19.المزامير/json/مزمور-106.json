{
    "book": "المزامير",
    "chapter": 106,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> سبحوا الرب!",
                "---",
                "> اشكروا الرب لأنه صالح؛",
                "> لأن رحمته أبدية."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> من يقدر أن يتكلم بأعمال الرب الجبارة،",
                "> أو يعلن كل تسبيحه؟"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> طوبى للذين يحفظون العدل،",
                "> والذين يمارسون البر في كل حين!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> اذكرني يا رب برضاك نحو شعبك؛",
                "> افتقدني بخلاصك،"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لأرى خير مختاريك،",
                "> لأفرح بفرح أمتك،",
                "> لأفتخر بميراثك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> قد أخطأنا كما أخطأ آباؤنا،",
                "> ضللنا، فعلنا الشر."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> آباؤنا في مصر لم يفهموا عجائبك؛",
                "> لم يذكروا كثرة مراحمك،",
                "> بل تمردوا عند البحر، عند بحر سوف."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> لكنه خلصهم من أجل اسمه،",
                "> ليعلن قوته."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> انتهر بحر سوف فجف،",
                "> وقادهم في الأعماق كالقفر."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> فخلصهم من يد المبغض،",
                "> وفداهم من يد العدو."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> غطت المياه مضايقيهم؛",
                "> لم يبق منهم ولا واحد."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> حينئذ آمنوا بكلماته؛",
                "> سبحوا بتسبيحه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> سرعان ما نسوا أعماله؛",
                "> لم ينتظروا مشورته،"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> بل اشتهوا شهوة في البرية،",
                "> وجربوا إله في الصحراء."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> فأعطاهم سؤلهم،",
                "> وأرسل هزالاً فيهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> حسدوا موسى في المحلة،",
                "> وهارون قدوس الرب."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> فتحت الأرض وابتلعت داثان،",
                "> وغطت جماعة أبيرام."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> واشتعلت نار في جماعتهم؛",
                "> أحرقت اللهيب الأشرار."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> صنعوا عجلاً في حوريب،",
                "> وسجدوا لتمثال مسبوك."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> فاستبدلوا مجدهم",
                "> بشبه ثور يأكل العشب."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> نسوا إله مخلصهم،",
                "> الذي صنع عظائم في مصر،"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> وعجائب في أرض حام،",
                "> وأعمالاً مهيبة عند بحر سوف."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> فقال إنه يهلكهم،",
                "> لولا أن موسى مختاره وقف في الثغر أمامه،",
                "> ليرد غضبه عن إهلاكهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ثم رفضوا الأرض الشهية؛",
                "> لم يؤمنوا بكلمته،"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> بل تذمروا في خيامهم؛",
                "> لم يسمعوا لصوت الرب."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> فرفع يده عليهم",
                "> ليسقطهم في البرية،"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> وليبدد نسلهم بين الأمم،",
                "> ويشتتهم في الأراضي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> وتعلقوا ببعل فغور،",
                "> وأكلوا ذبائح الموتى."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> فأغضبوه بأفعالهم،",
                "> فاندلعت بينهم ضربة."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> فوقف فينحاس ودان،",
                "> فانقطعت الضربة."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> فحسب له ذلك برًا،",
                "> إلى جيل الأبد."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> وأغضبوه عند مياه مريبة،",
                "> فساء لموسى بسببهم؛"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> لأنهم عصوا روحه،",
                "> فتلفظ بشفتيه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> لم يبيدوا الشعوب،",
                "> كما أمرهم الرب،"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> بل اختلطوا بالأمم",
                "> وتعلموا أعمالهم،"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> وعبدوا أصنامهم،",
                "> فصارت لهم فخًا."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> وذبحوا بنيهم وبناتهم للشياطين،"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> وسفكوا دمًا بريئًا،",
                "> دم بنيهم وبناتهم،",
                "> الذين ذبحوهم لأصنام كنعان؛",
                "> فتدنست الأرض بالدماء."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> وتنجسوا بأعمالهم،",
                "> وزنوا بأفعالهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> فاشتد غضب الرب على شعبه،",
                "> وكره ميراثه."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> فأسلمهم ليد الأمم،",
                "> فتسلط عليهم مبغضوهم."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> وضغطهم أعداؤهم،",
                "> فذلوا تحت يدهم."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> مرارًا كثيرة أنقذهم؛",
                "> لكنهم تمردوا بمشورتهم،",
                "> وانحطوا بإثمهم."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> لكنه نظر إلى ضيقهم",
                "> عندما سمع صراخهم؛"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> وذكر عهده لأجلهم،",
                "> وندم حسب كثرة رحمته."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> وجعلهم موضع رأفة",
                "> لدى كل أسراهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> خلصنا يا رب إلهنا،",
                "> واجمعنا من بين الأمم،",
                "> لنشكر اسمك القدوس",
                "> ونتفاخر بتسبيحك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> مبارك الرب إله إسرائيل،",
                "> من الأزل وإلى الأبد.",
                "> ويقول كل الشعب، \"آمين.\"",
                "> سبحوا الرب!"
            ]
        }
    ]
}