{
    "book": "المزامير",
    "chapter": 6,
    "verses": [
        {
            "text": [
                "للمخرج الموسيقي؛ مع آلات وترية، على قيثارة ذات ثمانية أوتار. مزمور لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> يا رب، لا توبخني في غضبك،",
                "> ولا تؤدبني في سخطك."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ارحمني، يا رب، لأني ضعيف؛",
                "> اشفني، يا رب، لأن عظامي في ضيق."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ونفسي مضطربة جداً؛",
                "> وأنت، يا رب، إلى متى؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ارجع، يا رب، أنقذ نفسي؛",
                "> خلصني من أجل رحمتك."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لأنه لا يوجد ذكر لك في الموت؛",
                "> في الهاوية، من يسبحك؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> تعبت من تنهدي؛",
                "> كل ليلة أبلل سريري،",
                "> أذيب فراشي بدموعي."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> عيني ضعفت من الحزن؛",
                "> شاخت بسبب جميع أعدائي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ابتعدوا عني، يا جميع فاعلي الإثم،",
                "> لأن الرب سمع صوت بكائي."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> الرب سمع تضرعي،",
                "> الرب يقبل صلاتي."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> جميع أعدائي سيخزون ويضطربون جداً؛",
                "> سيرجعون، فجأة سيخزون."
            ]
        }
    ]
}