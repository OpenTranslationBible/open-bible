{
    "book": "المزامير",
    "chapter": 57,
    "verses": [
        {
            "text": [
                "لإمام المغنين. على لا تهلك. قصيدة لداود عندما هرب من شاول في الكهف."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ارحمني يا إله، ارحمني،",
                "> لأن نفسي تحتمي بك؛",
                "> وفي ظل جناحيك أعتصم",
                "> حتى تعبر المصائب."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> أنادي إلى الله العلي،",
                "> إلى الله الذي يتمم لي مقاصده."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> يرسل من السماء ويخلصني؛",
                "> يعاتب الذي يطأني.",
                "> سلاه",
                "> يرسل إله رحمته وحقه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> نفسي بين الأسود؛",
                "> أضطجع بين الذين يلتهمون،",
                "> بين بني البشر، الذين أسنانهم رماح وسهام،",
                "> ولسانهم سيف حاد."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ارتفع فوق السماوات يا إله؛",
                "> ليكن مجدك فوق كل الأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> نصبوا شبكة لخطواتي؛",
                "> انحنت نفسي؛",
                "> حفروا أمامي حفرة؛",
                "> سقطوا فيها هم أنفسهم.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> قلبي ثابت يا إله، قلبي ثابت؛",
                "> أغني وأرنم!"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> استيقظي يا نفسي!",
                "> استيقظي يا عود ويا قيثارة!",
                "> أوقظ الصبح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> أحمدك يا رب بين الشعوب؛",
                "> أرنم لك بين الأمم."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> لأن رحمتك قد بلغت السماوات،",
                "> وحقك إلى الغيوم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ارتفع فوق السماوات يا إله؛",
                "> ليكن مجدك فوق كل الأرض."
            ]
        }
    ]
}