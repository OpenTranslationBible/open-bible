{
    "book": "المزامير",
    "chapter": 91,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> مَن يسكن في ملجأ العلي",
                "> يستريح في ظل القدير."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> أقول للرب، \"أنت ملجأي وحصني،",
                "> إلهي الذي أضع فيه ثقتي!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لأنه هو الذي ينقذك من فخ الصياد",
                "> ومن الوباء الخطير."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> يظللك بريشه،",
                "> وتحت جناحيه تجد ملجأ؛",
                "> أمانته درع وحاجز."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لا تخشى رعب الليل،",
                "> ولا السهم الذي يطير في النهار؛"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ولا الوباء الذي يسير في الظلام،",
                "> ولا الخراب الذي يهلك في الظهيرة."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> يسقط ألف عن جانبك",
                "> وعشرة آلاف عن يمينك،",
                "> لكنه لا يقترب منك."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> فقط بعينيك تنظر",
                "> وترى جزاء الأشرار."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> لأنك جعلت الرب ملجأك،",
                "> العلي مسكنك،"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> لا يصيبك أي ضرر،",
                "> ولا يقترب أي وباء من مسكنك."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> لأنه يوصي ملائكته بك،",
                "> ليحفظوك في كل طرقك."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> يحملونك على أيديهم،",
                "> لئلا تصدم رجلك بحجر."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> تطأ الأسد والأفعى،",
                "> تدوس الشبل والثعبان."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> \"لأنه يتعلق بي بالمحبة، أنقذه؛",
                "> أرفعه لأنه يعرف اسمي."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> يدعوني فأجيبه؛",
                "> أكون معه في الضيق؛",
                "> أنقذه وأكرمه."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> أشبعه بطول الأيام،",
                "> وأريه خلاصي.\""
            ]
        }
    ]
}