{
    "book": "المزامير",
    "chapter": 137,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> عند أنهار بابل،",
                "> هناك جلسنا وبكينا،",
                "> عندما تذكرنا صهيون."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> على الصفصاف في وسطها",
                "> علقنا قيثاراتنا."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لأن هناك سألنا سالبونا عن أغاني،",
                "> ومعذبونا عن فرح، قائلين،",
                "> \"غنوا لنا واحدة من أغاني صهيون!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> كيف نغني أغنية الرب",
                "> في أرض غريبة؟"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> إذا نسيتكِ يا أورشليم،",
                "> فلتنسَ يميني مهارتها."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ليلتصق لساني بسقف فمي",
                "> إذا لم أذكركِ،",
                "> إذا لم أُفضِّل أورشليم",
                "> فوق أعظم فرحي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> اذكر يا رب على بني أدوم",
                "> يوم أورشليم،",
                "> الذين قالوا، \"اهدموها، اهدموها",
                "> حتى أساسها!\""
            ]
        },
        {
            "verse": 8,
            "text": [
                "> يا بنت بابل المخربة،",
                "> طوبى لمن يجازيكِ",
                "> بالجزاء الذي جازيتينا."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> طوبى لمن يمسك أطفالكِ",
                "> ويضربهم على صخوركِ."
            ]
        }
    ]
}