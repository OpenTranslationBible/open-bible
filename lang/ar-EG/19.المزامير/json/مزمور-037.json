{
    "book": "المزامير",
    "chapter": 37,
    "verses": [
        {
            "text": [
                "مزمور لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> لا تغضب بسبب فاعلي الشر،",
                "> ولا تحسد عمال الإثم."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> لأنهم سريعًا ما يذبلون كالعشب،",
                "> ويذبلون كنباتات خضراء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> اتكل على الرب وافعل الخير؛",
                "> اسكن في الأرض وازرع الأمانة."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> تلذذ بالرب؛",
                "> فيعطيك سؤل قلبك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> سلم طريقك للرب،",
                "> واتكل عليه، وهو يعمل."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ويخرج مثل النور برك،",
                "> وحقك مثل الظهيرة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> انتظر الرب واصبر له؛",
                "> لا تغر من الذي ينجح في طريقه،",
                "> من الرجل الذي ينفذ مكايد."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> كف عن الغضب واترك السخط؛",
                "> لا تغر، لئلا تفعل الشر."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> لأن فاعلي الشر يقطعون،",
                "> والذين ينتظرون الرب هم يرثون الأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> بعد قليل لا يكون الشرير؛",
                "> تطلع في مكانه فلا يكون."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> أما الودعاء فيرثون الأرض،",
                "> ويتلذذون في كثرة السلام."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> الشرير يتآمر على الصديق،",
                "> ويصر عليه بأسنانه."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> الرب يضحك به،",
                "> لأنه رأى أن يومه آت."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> الأشرار يسلون سيوفهم",
                "> ويحنون قسيهم،",
                "> ليسقطوا المسكين والفقير،",
                "> ليذبحوا المستقيمين في الطريق."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> سيوفهم تدخل في قلوبهم،",
                "> وقسيهم تنكسر."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> القليل الذي للصديق",
                "> خير من ثروة أشرار كثيرين."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> لأن أذرع الأشرار تنكسر،",
                "> والرب عاضد الصديقين."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> الرب يعرف أيام الكملة،",
                "> وميراثهم إلى الأبد يكون."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> لا يخزون في زمن السوء،",
                "> وفي أيام الجوع يشبعون."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> أما الأشرار فيهلكون؛",
                "> وأعداء الرب كبهاء المراعي،",
                "> يفنون كالدخان يفنون."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> الشرير يستقرض ولا يفي،",
                "> أما الصديق فيترأف ويعطي."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> لأن المباركين منه يرثون الأرض،",
                "> والملعونين منه يقطعون."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> من الرب تتثبت خطوات الإنسان،",
                "> وفي طريقه يسر."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> إذا سقط لا ينطرح،",
                "> لأن الرب مسند يده."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> كنت فتى وقد شخت،",
                "> ولم أر صديقًا تخلي عنه،",
                "> ولا ذرية له تلتمس خبزًا."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> اليوم كله يترأف ويقرض،",
                "> ونسله للبركة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> حد عن الشر واصنع الخير،",
                "> واسكن إلى الأبد."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> لأن الرب يحب الحق",
                "> ولا يتخلى عن أتقيائه؛",
                "---",
                "> إلى الأبد يحفظون،",
                "> ونسل الأشرار ينقطع."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> الصديقون يرثون الأرض",
                "> ويسكنونها إلى الأبد."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> فم الصديق يلهج بالحكمة،",
                "> ولسانه ينطق بالحق."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> شريعة إلهه في قلبه؛",
                "> لا تتزعزع خطواته."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> الشرير يراقب الصديق،",
                "> ويطلب أن يميته."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> الرب لا يتركه في يده",
                "> ولا يحكم عليه عند محاكمته."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> انتظر الرب واحفظ طريقه،",
                "> فيرفعك لترث الأرض؛",
                "> ترى حين ينقطع الأشرار."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> رأيت الشرير عاتيًا",
                "> ويمتد كالأرز في لبنان."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> عبر فإذا هو ليس بموجود؛",
                "> التمسته فلم يوجد."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> لاحظ الكامل وانظر المستقيم؛",
                "> لأن العاقبة لإنسان السلامة."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> أما الأشرار فيهلكون جميعًا؛",
                "> عاقبة الأشرار تنقطع."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> أما خلاص الصديقين فمن الرب؛",
                "> حصنهم في زمن الضيق."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ويعينهم الرب وينجيهم؛",
                "> ينقذهم من الأشرار ويخلصهم،",
                "> لأنهم احتموا به."
            ]
        }
    ]
}