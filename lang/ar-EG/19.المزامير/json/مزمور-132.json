{
    "book": "المزامير",
    "chapter": 132,
    "verses": [
        {
            "text": [
                "ترنيمة المصاعد."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> اذكر، يا رب، من أجل داود،",
                "> كل مشقته؛"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> كيف حلف للرب",
                "> ونذر لقدير يعقوب:"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"لن أدخل إلى بيتي،",
                "> ولا أصعد إلى سريري؛"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> لن أعطي لعيني نومًا،",
                "> ولا لأجفاني نعاسًا،"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> حتى أجد مكانًا للرب،",
                "> مسكنًا لقدير يعقوب.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> لقد سمعنا به في أفراتة،",
                "> وجدناه في حقول يعار."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> لنذهب إلى مسكنه؛",
                "> لنسجد عند موطئ قدميه."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> قم، يا رب، إلى مكان راحتك،",
                "> أنت وتابوت عزتك."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ليلبس كهنتك البر،",
                "> وليهتف أتقياؤك فرحًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> من أجل داود عبدك،",
                "> لا ترد وجه مسيحك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> قد أقسم الرب لداود",
                "> حقًا لن يرجع عنه:",
                "> \"من ثمرة بطنك",
                "> أجعل على عرشك."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> إن حفظ بنوك عهدي",
                "> وشهاداتي التي أعلمهم،",
                "> فبنوهم أيضًا إلى الأبد يجلسون على عرشك.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> لأن الرب قد اختار صهيون؛",
                "> اشتهاها مسكنًا له."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> \"هذه هي راحتي إلى الأبد؛",
                "> هنا أسكن، لأني اشتهيتها."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> أبارك زادها بركة وافرة؛",
                "> أشبع مساكينها خبزًا."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> وألبس كهنتها خلاصًا،",
                "> ويبتهج أتقياؤها ترنمًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> هناك أنبت قرنًا لداود؛",
                "> أعددت سراجًا لمسيحي."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ألبس أعداءه خزيًا،",
                "> وعليه يزهر تاجه.\""
            ]
        }
    ]
}