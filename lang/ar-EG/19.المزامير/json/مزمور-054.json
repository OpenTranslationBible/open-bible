{
    "book": "المزامير",
    "chapter": 54,
    "verses": [
        {
            "text": [
                "لمدير الموسيقى؛ على الآلات الوترية. قصيدة تعليمية لداود، عندما جاء الزيّفيون وقالوا لشاول، \"أليس داود مختبئًا بيننا؟\""
            ]
        },
        {
            "verse": 1,
            "text": [
                "> خلصني يا إله باسمك،",
                "> وبررني بقوتك."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> استمع لصلاتي يا إله؛",
                "> أصغِ لكلمات فمي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لأن الغرباء قد قاموا ضدي،",
                "> والرجال القساة طلبوا نفسي؛",
                "> لم يضعوا إله أمامهم.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> حقًا، إله هو معيني؛",
                "> الرب هو سند نفسي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> سيرد الشر لأعدائي؛",
                "> في أمانتك، أوقعهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> بحرية سأقدم لك ذبائح؛",
                "> سأمجد اسمك، يا رب، لأنه صالح."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> لأنه قد أنقذني من كل ضيق،",
                "> وعيني قد نظرت بارتياح على أعدائي."
            ]
        }
    ]
}