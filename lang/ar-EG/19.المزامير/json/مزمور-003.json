{
    "book": "المزامير",
    "chapter": 3,
    "verses": [
        {
            "text": [
                "مزمور لداود عندما هرب من ابنه أبشالوم."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> يا رب، كم زاد أعدائي!",
                "> كثيرون يقومون علي."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> كثيرون يقولون عني،",
                "> \"لا خلاص له من خلال إله.\"",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لكن أنت، يا رب، ترس حولي،",
                "> مجدي، ورافع رأسي عاليًا."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> بصوتي إلى الرب صرخت،",
                "> فأجابني من جبله المقدس.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> أنا اضطجعت ونمت؛",
                "> استيقظت، لأن الرب يعضدني."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> لا أخاف من ربوات الشعب",
                "> الذين أحاطوا بي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> قم يا رب؛ خلصني، يا إلهي!",
                "> لأنك ضربت كل أعدائي على الفك؛",
                "> كسرت أسنان الأشرار."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> الخلاص للرب؛",
                "> لتكن بركتك على شعبك.",
                "> سلاه"
            ]
        }
    ]
}