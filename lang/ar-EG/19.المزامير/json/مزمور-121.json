{
    "book": "المزامير",
    "chapter": 121,
    "verses": [
        {
            "text": [
                "ترنيمة المصاعد."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> أرفع عيني إلى الجبال؛",
                "> من أين يأتي عوني؟"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> عوني من عند الرب،",
                "> خالق السماء والأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لا يدع رجلك تزل؛",
                "> الذي يحفظك لا ينعس."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> هوذا حافظ إسرائيل",
                "> لا ينعس ولا ينام."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> الرب حارس لك؛",
                "> الرب ظل لك عن يمينك."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> لا تضربك الشمس في النهار،",
                "> ولا القمر في الليل."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> الرب يحفظك من كل شر؛",
                "> يحفظ نفسك."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> الرب يحفظ خروجك ودخولك",
                "> من الآن وإلى الأبد."
            ]
        }
    ]
}