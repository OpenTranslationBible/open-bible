{
    "book": "المزامير",
    "chapter": 25,
    "verses": [
        {
            "text": [
                "مزمور لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> إليك، يا رب، أرفع نفسي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> إلهي، عليك توكلت،",
                "> لا تدعني أخزى؛",
                "> لا تدع أعدائي ينتصرون عليّ."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> حقًا، لا يخزى الذين ينتظرونك؛",
                "> الذين يغدرون بلا سبب يخزون."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> عرفني طرقك، يا رب؛",
                "> اهدني في سبلك."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> قُدني في حقك وعلمني،",
                "> لأنك إله خلاصي؛",
                "> إياك انتظرت اليوم كله."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> اذكر، يا رب، رحمتك ومحبتك الثابتة،",
                "> لأنها منذ الأزل."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> لا تذكر خطايا شبابي ولا معاصيّ؛",
                "> اذكرني حسب محبتك الثابتة،",
                "> من أجل صلاحك، يا رب."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> الرب صالح وعادل؛",
                "> لذلك يرشد الخطاة في الطريق الصحيح."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> يهدي الودعاء إلى الحق،",
                "> ويعلم الودعاء طريقه."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> كل طرق الرب رحمة وحق",
                "> للذين يحفظون عهده وشهاداته."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> من أجل اسمك، يا رب،",
                "> اغفر إثمي، لأنه عظيم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> من هو الذي يخاف الرب؟",
                "> يرشدُه في الطريق الذي يختاره."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> تسكن نفسه في الخير،",
                "> وذريته ترث الأرض."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> سر الرب للذين يخافونه،",
                "> ويعلن لهم عهده."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> عيناي دائمًا نحو الرب،",
                "> لأنه يخرج رجلي من الشبكة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> التفت إليّ وارحمني،",
                "> لأني وحيد ومضطرب."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ضيقات قلبي قد ازدادت؛",
                "> أخرجني من شدائدي."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> انظر إلى مذلتي وتعبي،",
                "> واغفر جميع خطاياي."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> انظر إلى أعدائي، لأنهم كثيرون،",
                "> ويبغضونني بغضًا شديدًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> احفظ نفسي ونجني؛",
                "> لا تدعني أخزى، لأني لجأت إليك."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ليحفظني الاستقامة والاستقامة،",
                "> لأني انتظرتك."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> نجِّ إسرائيل، يا إله،",
                "> من كل ضيقاته."
            ]
        }
    ]
}