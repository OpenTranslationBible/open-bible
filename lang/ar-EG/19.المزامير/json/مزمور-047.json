{
    "book": "المزامير",
    "chapter": 47,
    "verses": [
        {
            "text": [
                "لإمام الموسيقيين. مزمور لبني قورح."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> صفقوا بأيديكم يا جميع الشعوب؛",
                "> اهتفوا لإله بصوت الفرح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> لأن الرب العلي مرهوب،",
                "> ملك عظيم على كل الأرض."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> يخضع الشعوب تحتنا",
                "> والأمم تحت أقدامنا."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> يختار لنا ميراثنا،",
                "> فخر يعقوب الذي يحبه.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> صعد إله بين الهتاف،",
                "> الرب بصوت البوق."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> رنموا لإله، رنموا؛",
                "> رنموا لملكنا، رنموا."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> لأن إله هو ملك كل الأرض؛",
                "> رنموا بمزمور بفهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> إله يملك على الأمم،",
                "> إله جلس على كرسي قدسه."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> اجتمع رؤساء الشعوب",
                "> شعب إله إبراهيم،",
                "> لأن لله مجان الأرض؛",
                "> هو مرتفع جدًا."
            ]
        }
    ]
}