{
    "book": "المزامير",
    "chapter": 113,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> سبحوا الرب!",
                "---",
                "> سبحوا يا عبيد الرب،",
                "> سبحوا اسم الرب."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ليكن اسم الرب مباركًا",
                "> من الآن وإلى الأبد."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> من مشرق الشمس إلى مغربها،",
                "> اسم الرب مستحق التسبيح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> الرب مرتفع فوق كل الأمم؛",
                "> مجده فوق السماوات."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> من يقارن بالرب إلهنا،",
                "> الذي يجلس في العلاء،"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> الذي يتواضع لينظر",
                "> إلى ما في السماء وعلى الأرض؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> يرفع الفقير من التراب،",
                "> ويقيم المسكين من المزبلة،"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ليجلسهم مع الأمراء،",
                "> مع قادة شعبه."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> يمنح المرأة العقيم بيتًا",
                "> كأم فرحة بالأولاد.",
                "> سبحوا الرب!"
            ]
        }
    ]
}