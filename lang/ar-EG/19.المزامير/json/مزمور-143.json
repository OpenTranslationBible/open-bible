{
    "book": "المزامير",
    "chapter": 143,
    "verses": [
        {
            "text": [
                "مزمور لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> اسمع صلاتي يا رب،",
                "> استمع لتضرعاتي!",
                "> أجبني في أمانتك، في برك!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ولا تدخل في محاكمة مع عبدك،",
                "> لأنه لا يتبرر أمامك حي."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لأن العدو قد اضطهد نفسي؛",
                "> سحق حياتي إلى الأرض؛",
                "> أجلسني في الظلمات مثل الموتى منذ القدم."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> لذلك أعيَت فيَّ روحي؛",
                "> تحير فيَّ قلبي."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ذكرت أيام القدم؛",
                "> لهجت بكل أعمالك؛",
                "> تأملت في صنائع يديك."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> بسطت إليك يدي؛",
                "> نفسي إليك كأرض يابسة.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> أسرع أجبني يا رب،",
                "> قد فنيت روحي؛",
                "> لا تحجب وجهك عني،",
                "> فأشبه الهابطين في الجب."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> أسمعني رحمتك في الغداة،",
                "> لأني عليك توكلت؛",
                "> عرفني الطريق التي أسلك فيها،",
                "> لأني إليك رفعت نفسي."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> أنقذني يا رب من أعدائي؛",
                "> إليك احتميت."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> علمني أن أفعل مشيئتك،",
                "> لأنك أنت إلهي؛",
                "> روحك الصالح يهديني في أرض مستوية."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> من أجل اسمك يا رب أحييني.",
                "> ببرك تخرج نفسي من الضيق."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> وبرحمتك تفني أعدائي،",
                "> وتهلك كل مضايقي نفسي،",
                "> لأني أنا عبدك."
            ]
        }
    ]
}