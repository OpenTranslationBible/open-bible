{
    "book": "ميخا",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> الآن اجتمعوا في جيوش، يا بنت المحاربين؛",
                "> لقد حاصرونا؛",
                "> بعصا يضربون قاضي إسرائيل",
                "> على الخد."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"وأنتِ يا بيت لحم، في أرض يهوذا،",
                "> لستِ بأقل بين حكام يهوذا؛",
                "> لأنه منكِ يخرج حاكم يرعى شعبي إسرائيل.",
                "> أزمنته في الخروج منذ القديم،",
                "> منذ أيام الأزل.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لذلك سيسلمهم حتى الوقت",
                "> عندما تلد التي في المخاض.",
                "> ثم يعود بقية إخوته",
                "> إلى بني إسرائيل."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> وسيقف ليرعى قطيعه",
                "> بقوة الرب،",
                "> بجلال اسم الرب إلهه.",
                "> وسيسكنون بأمان،",
                "> لأنه في ذلك الوقت سيكون مشهورًا",
                "> إلى أقاصي الأرض."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> وهذا سيكون سلامنا.",
                "> عندما يغزو الآشوري أرضنا،",
                "> عندما يدوس على حصوننا،",
                "> سنقيم ضده",
                "> سبعة رعاة وثمانية قادة من الناس."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> وسيرعون أرض آشور بالسيف،",
                "> أرض نمرود عند مداخلها؛",
                "> وسينقذنا من الآشوري",
                "> عندما يغزو أرضنا",
                "> ويدوس على أراضينا."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ثم تكون بقية يعقوب",
                "> بين شعوب كثيرة",
                "> كالندى المرسل من الرب،",
                "> كالأمطار على النبات",
                "> التي لا تنتظر الإنسان،",
                "> ولا تتأخر للبشر."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> تكون بقية يعقوب",
                "> بين الأمم،",
                "> بين شعوب كثيرة",
                "> كالأسد بين حيوانات الغابة،",
                "> كالشبل بين قطعان الغنم،",
                "> الذي إذا مر،",
                "> يدوس ويمزق،",
                "> ولا يوجد من ينقذ."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> سترتفع يدك ضد خصومك،",
                "> وكل أعدائك سيتم القضاء عليهم."
            ]
        },
        {
            "verse": 10,
            "text": [
                "\"وفي ذلك اليوم\"، يقول الرب،",
                "> \"سأزيل خيلك من بينكم",
                "> وأدمر مركباتك."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> سأزيل أيضًا مدن أرضك",
                "> وأهدم جميع حصونك."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> سأزيل السحر من يدك،",
                "> ولن يكون لك عرافون."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> سأزيل تماثيلك المنحوتة",
                "> وأحجارك التذكارية من بينكم،",
                "> لكي لا تسجدوا بعد",
                "> لعمل أيديكم."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> سأقتلع أعمدة عبادتكم من بينكم",
                "> وأدمر مدنكم."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> وسأنفذ الانتقام بغضب وسخط",
                "> على الأمم التي لم تطيع.\""
            ]
        }
    ]
}