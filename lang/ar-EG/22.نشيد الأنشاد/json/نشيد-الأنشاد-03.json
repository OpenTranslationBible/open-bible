{
    "book": "نشيد الأنشاد",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "على فراشي، في الليالي، بحثت عنه",
                "الذي تحبه نفسي؛",
                "طلبته فلم أجده."
            ]
        },
        {
            "verse": 2,
            "text": [
                "لابد أن أقوم الآن وأجوب المدينة؛",
                "في الشوارع والساحات العامة.",
                "لابد أن أبحث عن الذي تحبه نفسي.”",
                "بحثت عنه فلم أجده."
            ]
        },
        {
            "verse": 3,
            "text": [
                "وجدني الحراس الذين يجوبون المدينة،",
                "فسألتهم،",
                "“هل رأيتم الذي تحبه نفسي؟”"
            ]
        },
        {
            "verse": 4,
            "text": [
                "لم أكاد أتجاوزهم",
                "حتى وجدت الذي تحبه نفسي؛",
                "أمسكت به ولم أتركه",
                "حتى أدخلته بيت أمي،",
                "وإلى غرفة التي حبلت بي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "أستحلفكن،",
                "يا بنات أورشليم،",
                "بالظباء أو بأيائل الحقل،",
                "أن لا توقظن أو تنبهن الحب",
                "حتى يشاء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "ما هذا الصاعد من البرية",
                "كأعمدة من الدخان،",
                "معطر بالمر واللبان،",
                "مع كل مساحيق التاجر؟"
            ]
        },
        {
            "verse": 7,
            "text": [
                "هوذا سرير سليمان المتنقل؛",
                "حوله ستون جبارًا،",
                "من جبابرة إسرائيل."
            ]
        },
        {
            "verse": 8,
            "text": [
                "كلهم قابضون على السيف،",
                "خبراء في الحرب؛",
                "كل واحد سيفه على فخذه،",
                "لحماية من أهوال الليل."
            ]
        },
        {
            "verse": 9,
            "text": [
                "عمل الملك سليمان لنفسه محفة",
                "من خشب لبنان."
            ]
        },
        {
            "verse": 10,
            "text": [
                "صنع أعمدتها من فضة،",
                "وقاعدتها من ذهب،",
                "ومقعدها من قماش أرجواني،",
                "وزينتها الداخلية بحب",
                "من بنات أورشليم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "اخرجن يا بنات صهيون،",
                "وانظرن الملك سليمان بالتاج",
                "الذي توجته به أمه",
                "في يوم عرسه،",
                "وفي يوم فرح قلبه."
            ]
        }
    ]
}