    "verses": [
        {
            "verse": 1,
            "text": [
                "هؤلاء هم أبناء المقاطعة الذين رجعوا من السبي من الأسرى الذين سباهم نبوخذنصر ملك بابل إلى بابل. رجعوا إلى أورشليم ويهوذا، كل واحد إلى مدينته."
            ]
        },
        {
            "verse": 2,
            "text": [
                "جاءوا مع زربابل ويشوع ونحميا وسرايا ورعلايا ومردخاي وبلشان ومصفار وبيغواي ورحوم وبعنة. وهذه قائمة رجال شعب إسرائيل:"
            ]
        },
