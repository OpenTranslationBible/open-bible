{
    "book": "Salme",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Pris Herren, alle folkeslag;",
                "> Lovsyng hans navn, alle folk!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> For hans godhet mot oss er stor,",
                "> Og Herrens trofasthet varer evig.",
                "---",
                "> Pris Herren!"
            ]
        }
    ]
}