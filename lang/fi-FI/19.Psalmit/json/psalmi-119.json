{
    "book": "Psalmit",
    "chapter": 119,
    "verses": [
        {
            "text": [
                "א Aleph"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> Autuaita ovat ne, joiden tie on puhdas,",
                "> Jotka seuraavat Herran lakia."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Autuaita ovat ne, jotka pitävät hänen todistuksensa,",
                "> Ja etsivät häntä kaikesta sydämestään."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> He eivät tee vääryyttä;",
                "> He vaeltavat hänen teillään."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Sinä olet antanut käskysi,",
                "> Että me noudattaisimme niitä tarkasti."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> Oi, jospa tieni olisivat vakaita",
                "> Pysymään sinun säädöksissäsi!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> Silloin en joudu häpeään,",
                "> Kun tarkastelen kaikkia sinun käskyjäsi."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> Kiitän sinua vilpittömästi,",
                "> Kun opin sinun vanhurskaat tuomiosi."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> Pidän sinun säädöksesi;",
                "> Älä hylkää minua kokonaan!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ב Beth"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> Kuinka nuorukainen voi pitää tiensä puhtaana?",
                "> Pysymällä sinun sanasi mukaan."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> Kaikesta sydämestäni olen etsinyt sinua;",
                "> Älä anna minun eksyä käskyistäsi."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> Olen kätkenyt sanasi sydämeeni,",
                "> Jotta en tekisi syntiä sinua vastaan."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> Kiitetty olet sinä, Herra;",
                "> Opeta minulle säädöksesi."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> Huulillani olen julistanut",
                "> Kaikki sinun suusi säädökset."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> Olen löytänyt iloa sinun todistustesi tiestä,",
                "> Yhtä paljon kuin kaikista rikkauksista."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> Mietin sinun käskyjäsi",
                "> Ja tarkastelen sinun teitäsi."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> Iloitsen sinun säädöksistäsi;",
                "> En unohda sinun sanaasi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ג Gimel"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> Kohtele palvelijaasi hyvin,",
                "> Että eläisin ja pitäisin sinun sanasi."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> Avaa silmäni, että näkisin",
                "> Ihmeellisiä asioita sinun laistasi."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> Olen muukalainen maan päällä;",
                "> Älä kätke käskyjäsi minulta."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> Sieluni kaipaa kiihkeästi",
                "> Sinun säädöksiäsi kaiken aikaa."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> Sinä nuhtelet ylpeitä, kirottuja,",
                "> Jotka eksyvät sinun käskyistäsi."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> Ota pois häpeä ja halveksunta minulta,",
                "> Sillä minä pidän sinun todistuksesi."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> Vaikka ruhtinaat istuvat ja puhuvat minua vastaan,",
                "> Palvelijasi miettii sinun säädöksiäsi."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> Myös sinun todistuksesi ovat iloni;",
                "> Ne ovat neuvonantajani."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ד Daleth"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> Sieluni tarttuu maahan;",
                "> Uudista minut sanasi mukaan."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> Olen kertonut sinulle tieni, ja sinä vastasit minulle;",
                "> Opeta minulle säädöksesi."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> Auta minua ymmärtämään sinun käskyjesi tietä,",
                "> Jotta mietin sinun ihmeitäsi."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> Sieluni itkee surusta;",
                "> Vahvista minua sanasi mukaan."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> Poista petollinen tie minusta,",
                "> Ja armossasi anna minulle lakisi."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> Olen valinnut uskollisuuden tien;",
                "> Olen asettanut sinun tuomiosi eteeni."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> Pidän kiinni sinun todistuksistasi;",
                "> Herra, älä anna minun joutua häpeään!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> Juoksen sinun käskyjesi tietä,",
                "> Sillä sinä laajennat sydäntäni."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ה He"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> Opeta minulle, Herra, sinun säädöstesi tietä,",
                "> Ja pidän sitä loppuun asti."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> Anna minulle ymmärrystä, että noudattaisin sinun lakiasi",
                "> Ja pitäisin sitä kaikesta sydämestäni."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> Johdata minua sinun käskyjesi tiellä,",
                "> Sillä minä iloitsen siitä."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> Käännä sydämeni sinun todistustesi puoleen,",
                "> Eikä petolliseen voittoon."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> Käännä silmäni pois arvottomista asioista,",
                "> Ja uudista minut sinun teilläsi."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> Vahvista sanasi palvelijallesi,",
                "> Joka herättää kunnioitusta sinua kohtaan."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> Poista häpeäni, jota pelkään,",
                "> Sillä sinun tuomiosi ovat hyvät."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> Katso, minä kaipaan sinun käskyjäsi;",
                "> Uudista minut sinun vanhurskaudellasi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ו Waw"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> Tulkoon myös sinun armosi minulle, Herra,",
                "> Sinun pelastuksesi sanasi mukaan;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> Jotta minulla olisi vastaus häntä vastaan, joka pilkkaa minua,",
                "> Sillä minä luotan sinun sanaasi."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> Älä ota totuuden sanaa kokonaan pois suustani,",
                "> Sillä minä odotan sinun tuomioitasi."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> Niin minä pidän sinun lakiasi jatkuvasti,",
                "> Aina ja ikuisesti."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> Ja minä vaellan vapaudessa,",
                "> Sillä minä etsin sinun käskyjäsi."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> Julistan myös sinun todistuksesi kuninkaille,",
                "> Enkä joudu häpeään."
            ]
        },
        {
            "verse": 47,
            "text": [
                "> Iloitsen sinun käskyistäsi,",
                "> Joita rakastan."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> Ja kohotan käteni sinun käskyjesi puoleen, joita rakastan;",
                "> Ja mietin sinun säädöksiäsi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ז Zayin"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> Muista sana palvelijallesi,",
                "> Jossa olet antanut minulle toivon."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> Tämä on lohdutukseni ahdingossani,",
                "> Että sinun sanasi on uudistanut minut."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> Ylpeät pilkkaavat minua täysin,",
                "> Kuitenkaan en käänny pois sinun laistasi."
            ]
        },
        {
            "verse": 52,
            "text": [
                "> Olen muistanut sinun tuomiosi muinaisista ajoista, Herra,",
                "> Ja löytänyt lohdutuksen."
            ]
        },
        {
            "verse": 53,
            "text": [
                "> Valtava suuttumus on vallannut minut jumalattomien vuoksi,",
                "> Jotka hylkäävät sinun lakisi."
            ]
        },
        {
            "verse": 54,
            "text": [
                "> Sinun säädöksesi ovat olleet laulujani",
                "> Matkani talossa."
            ]
        },
        {
            "verse": 55,
            "text": [
                "> Herra, muistan sinun nimesi yöllä,",
                "> Ja pidän sinun lakisi."
            ]
        },
        {
            "verse": 56,
            "text": [
                "> Tämä on tullut omakseni,",
                "> Että noudatan sinun käskyjäsi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ח Heth"
            ]
        },
        {
            "verse": 57,
            "text": [
                "> Herra on minun osani;",
                "> Olen luvannut pitää sinun sanasi."
            ]
        },
        {
            "verse": 58,
            "text": [
                "> Olen etsinyt sinun suosiotasi kaikesta sydämestäni;",
                "> Ole armollinen minulle sanasi mukaan."
            ]
        },
        {
            "verse": 59,
            "text": [
                "> Mietin teitäni",
                "> Ja käänsin askeleeni sinun todistustesi puoleen."
            ]
        },
        {
            "verse": 60,
            "text": [
                "> Kiirehdin enkä viivytellyt",
                "> Seuraamaan sinun käskyjäsi."
            ]
        },
        {
            "verse": 61,
            "text": [
                "> Jumalattomien ansat ovat ympäröineet minut,",
                "> Mutta en ole unohtanut sinun lakiasi."
            ]
        },
        {
            "verse": 62,
            "text": [
                "> Nousen keskiyöllä kiittämään sinua",
                "> Sinun vanhurskaiden tuomioidesi vuoksi."
            ]
        },
        {
            "verse": 63,
            "text": [
                "> Olen ystävä kaikille, jotka pelkäävät sinua,",
                "> Ja niille, jotka pitävät sinun käskyjäsi."
            ]
        },
        {
            "verse": 64,
            "text": [
                "> Maa on täynnä sinun armoasi, Herra;",
                "> Opeta minulle säädöksesi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ט Teth"
            ]
        },
        {
            "verse": 65,
            "text": [
                "> Olet kohdellut palvelijaasi hyvin, Herra,",
                "> Sanasi mukaan."
            ]
        },
        {
            "verse": 66,
            "text": [
                "> Opeta minulle hyvää harkintaa ja tietoa,",
                "> Sillä minä luotan sinun käskyihisi."
            ]
        },
        {
            "verse": 67,
            "text": [
                "> Ennen kuin minua koeteltiin, eksyin,",
                "> Mutta nyt pidän aina sinun sanasi."
            ]
        },
        {
            "verse": 68,
            "text": [
                "> Sinä olet hyvä ja teet oikein;",
                "> Opeta minulle säädöksesi."
            ]
        },
        {
            "verse": 69,
            "text": [
                "> Ylpeät ovat sepittäneet valheen minua vastaan;",
                "> Kaikesta sydämestäni pidän sinun käskyjäsi."
            ]
        },
        {
            "verse": 70,
            "text": [
                "> Heidän sydämensä on tunnoton, kuin kovettunut rasva,",
                "> Mutta minä iloitsen sinun laistasi."
            ]
        },
        {
            "verse": 71,
            "text": [
                "> On hyödyllistä, että koin vaikeuksia,",
                "> Jotta oppisin sinun säädöksesi."
            ]
        },
        {
            "verse": 72,
            "text": [
                "> Sinun suusi laki on minulle arvokkaampi",
                "> Kuin tuhannet kultaa ja hopeaa."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "י Yodh"
            ]
        },
        {
            "verse": 73,
            "text": [
                "> Sinun kätesi loivat minut ja muovasivat minut;",
                "> Anna minulle ymmärrystä, että oppisin sinun käskyjäsi."
            ]
        },
        {
            "verse": 74,
            "text": [
                "> Ne, jotka pelkäävät sinua, näkevät minut ja iloitsevat,",
                "> Koska toivon sinun sanaasi."
            ]
        },
        {
            "verse": 75,
            "text": [
                "> Tiedän, Herra, että sinun tuomiosi ovat vanhurskaita,",
                "> Ja että olet antanut minun kohdata koettelemuksia uskollisuudessa."
            ]
        },
        {
            "verse": 76,
            "text": [
                "> Olkoon sinun armosi lohdutukseni,",
                "> Sanasi mukaan palvelijallesi."
            ]
        },
        {
            "verse": 77,
            "text": [
                "> Tulkoon sinun myötätuntosi minulle, antaen minulle elämän,",
                "> Sillä sinun lakisi on iloni."
            ]
        },
        {
            "verse": 78,
            "text": [
                "> Hävetkööt ylpeät, sillä he tekevät minulle vääryyttä valheilla;",
                "> Mutta minä mietin sinun käskyjäsi."
            ]
        },
        {
            "verse": 79,
            "text": [
                "> Kääntykööt ne, jotka pelkäävät sinua, minun puoleeni,",
                "> Ja ne, jotka tuntevat sinun todistuksesi."
            ]
        },
        {
            "verse": 80,
            "text": [
                "> Olkoon sydämeni vakaa sinun säädöksissäsi,",
                "> Jotta en joutuisi häpeään."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "כ Kaph"
            ]
        },
        {
            "verse": 81,
            "text": [
                "> Sieluni kaipaa sinun pelastustasi;",
                "> Odotan sinun sanaasi."
            ]
        },
        {
            "verse": 82,
            "text": [
                "> Silmäni väsyvät kaivatessaan sinun sanaasi,",
                "> Kun sanon: \"Milloin sinä lohdutat minua?\""
            ]
        },
        {
            "verse": 83,
            "text": [
                "> Vaikka olen tullut kuin kuivunut viinileili savussa,",
                "> En unohda sinun säädöksiäsi."
            ]
        },
        {
            "verse": 84,
            "text": [
                "> Mikä on palvelijasi päivien mitta?",
                "> Milloin tuot oikeuden niille, jotka vainoavat minua?"
            ]
        },
        {
            "verse": 85,
            "text": [
                "> Ylpeät ovat kaivaneet kuoppia minulle,",
                "> Ihmiset, jotka eivät ole sinun lakisi mukaisia."
            ]
        },
        {
            "verse": 86,
            "text": [
                "> Kaikki sinun käskysi ovat uskollisia;",
                "> He ovat vainonneet minua valheilla; auta minua!"
            ]
        },
        {
            "verse": 87,
            "text": [
                "> He melkein tuhosivat minut maan päällä,",
                "> Mutta en hylännyt sinun käskyjäsi."
            ]
        },
        {
            "verse": 88,
            "text": [
                "> Elvytä minut armosi mukaan,",
                "> Jotta voisin pitää sinun suusi todistuksen."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ל Lamedh"
            ]
        },
        {
            "verse": 89,
            "text": [
                "> Iankaikkisesti, Herra,",
                "> Sinun sanasi pysyy taivaassa."
            ]
        },
        {
            "verse": 90,
            "text": [
                "> Sinun uskollisuutesi jatkuu sukupolvesta toiseen;",
                "> Sinä perustit maan, ja se pysyy."
            ]
        },
        {
            "verse": 91,
            "text": [
                "> Ne pysyvät tänä päivänä sinun säädöksiesi mukaan,",
                "> Sillä kaikki palvelevat sinua."
            ]
        },
        {
            "verse": 92,
            "text": [
                "> Ellei sinun lakisi olisi ollut iloni,",
                "> Olisin menehtynyt ahdinkooni."
            ]
        },
        {
            "verse": 93,
            "text": [
                "> En koskaan unohda sinun käskyjäsi,",
                "> Sillä niiden kautta olet elvyttänyt minut."
            ]
        },
        {
            "verse": 94,
            "text": [
                "> Minä kuulun sinulle; pelasta minut,",
                "> Sillä olen etsinyt sinun käskyjäsi."
            ]
        },
        {
            "verse": 95,
            "text": [
                "> Jumalattomat väijyvät tuhotakseen minut;",
                "> Tarkastelen huolellisesti sinun todistuksiasi."
            ]
        },
        {
            "verse": 96,
            "text": [
                "> Olen nähnyt täydellisyyden rajan;",
                "> Sinun käskysi on ylen laaja."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מ Mem"
            ]
        },
        {
            "verse": 97,
            "text": [
                "> Kuinka rakastankaan sinun laki!",
                "> Se on mietiskelyni koko päivän."
            ]
        },
        {
            "verse": 98,
            "text": [
                "> Sinun käskysi tekevät minut viisaammaksi kuin viholliseni,",
                "> Sillä ne ovat aina minun."
            ]
        },
        {
            "verse": 99,
            "text": [
                "> Minulla on enemmän ymmärrystä kuin kaikilla opettajillani,",
                "> Sillä sinun todistuksesi ovat mietiskelyni."
            ]
        },
        {
            "verse": 100,
            "text": [
                "> Ymmärrän enemmän kuin vanhat,",
                "> Koska olen noudattanut sinun käskyjäsi."
            ]
        },
        {
            "verse": 101,
            "text": [
                "> Olen pitänyt jalkani poissa kaikilta pahoilta teiltä,",
                "> Jotta voisin pitää sinun sanasi."
            ]
        },
        {
            "verse": 102,
            "text": [
                "> En ole kääntynyt pois sinun tuomioistasi,",
                "> Sillä sinä olet opettanut minua."
            ]
        },
        {
            "verse": 103,
            "text": [
                "> Kuinka makeita ovatkaan sinun sanasi suussani!",
                "> Kyllä, makeampia kuin hunaja suussani!"
            ]
        },
        {
            "verse": 104,
            "text": [
                "> Sinun käskyistäsi saan ymmärrystä;",
                "> Siksi vihaan jokaista väärää tietä."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "נ Nun"
            ]
        },
        {
            "verse": 105,
            "text": [
                "> Sinun sanasi on lamppu jaloilleni",
                "> Ja valo polullani."
            ]
        },
        {
            "verse": 106,
            "text": [
                "> Olen tehnyt valan ja pidän sen,",
                "> Että pidän sinun vanhurskaat tuomiosi."
            ]
        },
        {
            "verse": 107,
            "text": [
                "> Olen ylen määrin ahdistettu;",
                "> Elvytä minut, Herra, sanasi mukaan."
            ]
        },
        {
            "verse": 108,
            "text": [
                "> Hyväksy suuni vapaaehtoiset uhrit, Herra,",
                "> Ja opeta minulle sinun tuomiosi."
            ]
        },
        {
            "verse": 109,
            "text": [
                "> Elämäni on jatkuvasti kädessäni,",
                "> Kuitenkaan en unohda sinun lakiasi."
            ]
        },
        {
            "verse": 110,
            "text": [
                "> Jumalattomat ovat asettaneet ansan minulle,",
                "> Kuitenkaan en ole eksynyt sinun käskyistäsi."
            ]
        },
        {
            "verse": 111,
            "text": [
                "> Olen saanut sinun todistuksesi ikuiseksi perinnöksi,",
                "> Sillä ne ovat sydämeni ilo."
            ]
        },
        {
            "verse": 112,
            "text": [
                "> Olen asettanut sydämeni noudattamaan sinun säädöksiäsi",
                "> Ikuisesti, jopa loppuun asti."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ס Samekh"
            ]
        },
        {
            "verse": 113,
            "text": [
                "> Vihaan kaksimielisiä,",
                "> Mutta rakastan sinun laki."
            ]
        },
        {
            "verse": 114,
            "text": [
                "> Sinä olet turvapaikkani ja kilpeni;",
                "> Toivon sinun sanaasi."
            ]
        },
        {
            "verse": 115,
            "text": [
                "> Poistukaa luotani, te pahantekijät,",
                "> Jotta voisin noudattaa Jumalani käskyjä."
            ]
        },
        {
            "verse": 116,
            "text": [
                "> Ylläpidä minua sanasi mukaan, että eläisin;",
                "> Äläkä anna minun joutua häpeään toivostani."
            ]
        },
        {
            "verse": 117,
            "text": [
                "> Tue minua, jotta olisin turvassa,",
                "> Että voisin jatkuvasti kunnioittaa sinun säädöksiäsi."
            ]
        },
        {
            "verse": 118,
            "text": [
                "> Olet hylännyt kaikki, jotka eksyvät sinun säädöksistäsi,",
                "> Sillä heidän petollisuutensa on hyödytöntä."
            ]
        },
        {
            "verse": 119,
            "text": [
                "> Olet poistanut kaikki jumalattomat maan päältä kuin epäpuhtauden;",
                "> Siksi rakastan sinun säädöksiäsi."
            ]
        },
        {
            "verse": 120,
            "text": [
                "> Lihani vapisee sinun pelostasi,",
                "> Ja pelkään sinun tuomioitasi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ע Ayin"
            ]
        },
        {
            "verse": 121,
            "text": [
                "> Olen tehnyt oikeuden ja vanhurskauden;",
                "> Älä jätä minua sortajilleni."
            ]
        },
        {
            "verse": 122,
            "text": [
                "> Ole palvelijasi takaaja hyvälle;",
                "> Älä anna ylpeiden sortaa minua."
            ]
        },
        {
            "verse": 123,
            "text": [
                "> Silmäni väsyvät kaivatessaan sinun pelastustasi,",
                "> Ja sinun vanhurskasta sanaasi."
            ]
        },
        {
            "verse": 124,
            "text": [
                "> Kohtele palvelijaasi armollisesti,",
                "> Ja opeta minulle sinun säädöksesi."
            ]
        },
        {
            "verse": 125,
            "text": [
                "> Olen sinun palvelijasi; anna minulle ymmärrystä,",
                "> Jotta tuntisin sinun todistuksesi."
            ]
        },
        {
            "verse": 126,
            "text": [
                "> On aika Herran toimia,",
                "> Sillä he ovat rikkoneet sinun lakisi."
            ]
        },
        {
            "verse": 127,
            "text": [
                "> Siksi rakastan sinun käskyjäsi",
                "> Enemmän kuin kultaa, kyllä, enemmän kuin puhdasta kultaa."
            ]
        },
        {
            "verse": 128,
            "text": [
                "> Siksi seuraan kaikkia sinun käskyjäsi huolellisesti,",
                "> Vihaan jokaista väärää tietä."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "פ Pe"
            ]
        },
        {
            "verse": 129,
            "text": [
                "> Sinun todistuksesi ovat ihmeellisiä;",
                "> Siksi sieluni noudattaa niitä."
            ]
        },
        {
            "verse": 130,
            "text": [
                "> Sinun sanojesi ilmoitus tuo valoa;",
                "> Se antaa ymmärrystä yksinkertaisille."
            ]
        },
        {
            "verse": 131,
            "text": [
                "> Avasin suuni laajasti kaivaten,",
                "> Sillä kaipasin sinun käskyjäsi."
            ]
        },
        {
            "verse": 132,
            "text": [
                "> Käänny minun puoleeni ja ole armollinen minulle,",
                "> Kuten on sopivaa niille, jotka rakastavat sinun nimeäsi."
            ]
        },
        {
            "verse": 133,
            "text": [
                "> Vahvista askeleeni sinun sanassasi,",
                "> Äläkä anna minkään vääryyden hallita minua."
            ]
        },
        {
            "verse": 134,
            "text": [
                "> Lunasta minut ihmisten sorrosta,",
                "> Jotta voisin pitää sinun käskyjäsi."
            ]
        },
        {
            "verse": 135,
            "text": [
                "> Anna kasvojesi loistaa palvelijallesi,",
                "> Ja opeta minulle sinun säädöksesi."
            ]
        },
        {
            "verse": 136,
            "text": [
                "> Silmäni vuotavat vesivirtoja,",
                "> Koska he eivät pidä sinun lakiasi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "צ Tsadhe"
            ]
        },
        {
            "verse": 137,
            "text": [
                "> Sinä olet vanhurskas, Herra,",
                "> Ja sinun tuomiosi ovat oikeat."
            ]
        },
        {
            "verse": 138,
            "text": [
                "> Olet käskenyt sinun todistuksesi vanhurskaudella",
                "> Ja suurella uskollisuudella."
            ]
        },
        {
            "verse": 139,
            "text": [
                "> Kiihkoni on vallannut minut,",
                "> Koska viholliseni ovat unohtaneet sinun sanasi."
            ]
        },
        {
            "verse": 140,
            "text": [
                "> Sinun sanasi on hyvin puhdas,",
                "> Siksi palvelijasi rakastaa sitä."
            ]
        },
        {
            "verse": 141,
            "text": [
                "> Olen merkityksetön ja halveksittu,",
                "> Kuitenkaan en unohda sinun käskyjäsi."
            ]
        },
        {
            "verse": 142,
            "text": [
                "> Sinun vanhurskautesi on ikuisesti oikea,",
                "> Ja sinun lakisi on totuuden ydin."
            ]
        },
        {
            "verse": 143,
            "text": [
                "> Vaikeudet ja ahdistus ovat löytäneet minut,",
                "> Kuitenkin sinun käskysi tuovat minulle iloa."
            ]
        },
        {
            "verse": 144,
            "text": [
                "> Sinun todistuksesi ovat vanhurskaita ikuisesti;",
                "> Anna minulle ymmärrystä, jotta voisin elää."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ק Qoph"
            ]
        },
        {
            "verse": 145,
            "text": [
                "> Huusin kaikesta sydämestäni; vastaa minulle, Herra!",
                "> Pidän sinun säädöksesi."
            ]
        },
        {
            "verse": 146,
            "text": [
                "> Kutsuin sinua; pelasta minut,",
                "> Ja pidän sinun todistuksesi."
            ]
        },
        {
            "verse": 147,
            "text": [
                "> Nousen ennen aamunkoittoa ja huudan apua;",
                "> Odotan sinun sanojasi."
            ]
        },
        {
            "verse": 148,
            "text": [
                "> Silmäni odottavat yövartioita,",
                "> Jotta voisin miettiä sinun sanaasi."
            ]
        },
        {
            "verse": 149,
            "text": [
                "> Kuule ääneni armosi mukaan;",
                "> Elvytä minut, Herra, sinun tuomioidesi mukaan."
            ]
        },
        {
            "verse": 150,
            "text": [
                "> Ne, jotka harjoittavat pahuutta, lähestyvät;",
                "> He ovat kaukana sinun laistasi."
            ]
        },
        {
            "verse": 151,
            "text": [
                "> Kuitenkin sinä olet lähellä, Herra,",
                "> Ja kaikki sinun käskysi ovat totuus."
            ]
        },
        {
            "verse": 152,
            "text": [
                "> Kauan sitten opin sinun todistuksistasi,",
                "> Että olet asettanut ne ikuisesti."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ר Resh"
            ]
        },
        {
            "verse": 153,
            "text": [
                "> Katso minun ahdinkoani ja pelasta minut,",
                "> Sillä en unohda sinun lakiasi."
            ]
        },
        {
            "verse": 154,
            "text": [
                "> Aja asiani ja lunasta minut;",
                "> Elvytä minut sanasi mukaan."
            ]
        },
        {
            "verse": 155,
            "text": [
                "> Pelastus on kaukana jumalattomista,",
                "> Sillä he eivät etsi sinun säädöksiäsi."
            ]
        },
        {
            "verse": 156,
            "text": [
                "> Suuret ovat sinun armeliaisuutesi, Herra;",
                "> Elvytä minut sinun tuomioidesi mukaan."
            ]
        },
        {
            "verse": 157,
            "text": [
                "> Lukuisat ovat vainoojani ja vihollisiani,",
                "> Kuitenkaan en käänny pois sinun todistuksistasi."
            ]
        },
        {
            "verse": 158,
            "text": [
                "> Näen petolliset ja tunnen halveksuntaa,",
                "> Koska he eivät pidä sinun sanaasi."
            ]
        },
        {
            "verse": 159,
            "text": [
                "> Katso, kuinka rakastan sinun käskyjäsi;",
                "> Elvytä minut, Herra, sinun armosi mukaan."
            ]
        },
        {
            "verse": 160,
            "text": [
                "> Sinun sanasi kokonaisuus on totuus,",
                "> Ja jokainen sinun vanhurskas tuomiosi on ikuinen."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ש Sin ja Shin"
            ]
        },
        {
            "verse": 161,
            "text": [
                "> Ruhtinaat vainoavat minua ilman syytä,",
                "> Mutta sydämeni seisoo kunnioituksessa sinun sanojasi kohtaan."
            ]
        },
        {
            "verse": 162,
            "text": [
                "> Iloitsen sinun sanastasi,",
                "> Kuten se, joka löytää suuren aarteen."
            ]
        },
        {
            "verse": 163,
            "text": [
                "> Inhoan ja vihaan valheellisuutta,",
                "> Mutta rakastan sinun lakiasi."
            ]
        },
        {
            "verse": 164,
            "text": [
                "> Kiitän sinua koko päivän",
                "> Sinun vanhurskaiden tuomioidesi vuoksi."
            ]
        },
        {
            "verse": 165,
            "text": [
                "> Ne, jotka rakastavat sinun lakiasi, nauttivat suurta rauhaa,",
                "> Eikä mikään saa heitä kompastumaan."
            ]
        },
        {
            "verse": 166,
            "text": [
                "> Toivon sinun pelastustasi, Herra,",
                "> Ja seuraan sinun käskyjäsi."
            ]
        },
        {
            "verse": 167,
            "text": [
                "> Sieluni pitää sinun todistuksesi,",
                "> Ja rakastan niitä suuresti."
            ]
        },
        {
            "verse": 168,
            "text": [
                "> Noudatan sinun käskyjäsi ja todistuksiasi,",
                "> Sillä kaikki minun tieni ovat sinun edessäsi."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ת Taw"
            ]
        },
        {
            "verse": 169,
            "text": [
                "> Tulkoon huutoni sinun eteesi, Herra;",
                "> Anna minulle ymmärrystä sanasi mukaan."
            ]
        },
        {
            "verse": 170,
            "text": [
                "> Tulkoon anomiseni sinun eteesi;",
                "> Pelasta minut sanasi mukaan."
            ]
        },
        {
            "verse": 171,
            "text": [
                "> Antakoon huuleni ylitsevuotavan kiitoksen,",
                "> Sillä sinä opetat minulle sinun säädöksesi."
            ]
        },
        {
            "verse": 172,
            "text": [
                "> Antakoon kieleni laulaa sinun sanastasi,",
                "> Sillä kaikki sinun käskysi ovat vanhurskaus."
            ]
        },
        {
            "verse": 173,
            "text": [
                "> Olkoon kätesi valmis auttamaan minua,",
                "> Sillä olen valinnut sinun käskysi."
            ]
        },
        {
            "verse": 174,
            "text": [
                "> Kaipaan sinun pelastustasi, Herra,",
                "> Ja sinun lakisi on iloni."
            ]
        },
        {
            "verse": 175,
            "text": [
                "> Antakoon sieluni elää, jotta se voisi kiittää sinua,",
                "> Ja antakoon sinun säädöksesi auttaa minua."
            ]
        },
        {
            "verse": 176,
            "text": [
                "> Olen harhaillut kuin eksynyt lammas; etsi palvelijasi,",
                "> Sillä en unohda sinun käskyjäsi."
            ]
        }
    ]
}