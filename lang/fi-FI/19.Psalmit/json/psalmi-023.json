{
    "book": "Psalmit",
    "chapter": 23,
    "verses": [
        {
            "text": [
                "Daavidin psalmi."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> Herra on minun paimeneni,",
                "> ei minulta mitään puutu."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Hän vie minut vihreille niityille lepäämään;",
                "> Hän johdattaa minut vetten ääreen,",
                "> joissa saan levätä."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> Hän virvoittaa minun sieluni;",
                "> Hän ohjaa minut oikeille poluille",
                "> nimensä tähden."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Vaikka minä kulkisin pimeässä laaksossa,",
                "> en pelkäisi mitään pahaa, sillä sinä olet minun kanssani;",
                "> sinun vitsasi ja sauvasi minua lohduttavat."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> Sinä katat minulle pöydän vihollisteni silmien eteen;",
                "> sinä voitelet minun pääni öljyllä;",
                "> minun maljani on ylitsevuotavainen."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> Hyvyys ja laupeus seuraavat minua kaiken elinaikani,",
                "> ja minä saan asua Herran huoneessa päivieni loppuun asti."
            ]
        }
    ]
}