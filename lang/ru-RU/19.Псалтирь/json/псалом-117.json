{
    "book": "Псалтирь",
    "chapter": 117,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> Почитайте Господа, все народы;",
                "> Прославляйте Его имя, все люди!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Ибо велика милость Его к нам,",
                "> И верность Господа пребывает вовек.",
                "---",
                "> Почитайте Господа!"
            ]
        }
    ]
}