{
    "book": "ഹോശേയാ",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> കാഹളം ഊതുക!",
                "> കഴുകുപോലെ ശത്രു കർത്താവിന്റെ ആലയത്തിനുമേൽ വരുന്നു,",
                "> അവർ എന്റെ നിയമം ലംഘിച്ചിരിക്കുന്നു",
                "> എന്റെ ന്യായപ്രമാണത്തെ അവഗണിച്ചിരിക്കുന്നു."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> അവർ എന്നെ വിളിക്കുന്നു,",
                "> \"ഓ ദൈവമേ, ഞങ്ങൾ ഇസ്രായേലിൽ നിന്നുള്ളവരായി നിന്നെ അംഗീകരിക്കുന്നു!\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ഇസ്രായേൽ നല്ലതിൽ നിന്ന് മാറിയിരിക്കുന്നു;",
                "> ശത്രു അവനെ പിന്തുടരും."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> അവർ രാജാക്കന്മാരെ സ്ഥാപിച്ചു, എന്നാൽ എന്റെ അധികാരമനുസരിച്ച് അല്ല;",
                "> അവർ ഉദ്യോഗസ്ഥരെ നിയമിച്ചു, എന്നാൽ ഞാൻ ഉപദേശിക്കപ്പെട്ടില്ല.",
                "> അവരുടെ വെള്ളിയും പൊന്നും കൊണ്ട് അവർ തങ്ങൾക്ക് വിഗ്രഹങ്ങൾ നിർമ്മിച്ചു,",
                "> അതിനാൽ അവർ നീക്കിക്കളയപ്പെടും."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> സമാര്യാ, അവൻ നിന്റെ കാളയെ തള്ളിക്കളഞ്ഞിരിക്കുന്നു, പ്രഖ്യാപിച്ചിരിക്കുന്നു,",
                "> \"എന്റെ കോപം അവരുടെ നേരെ കത്തുന്നു!\"",
                "> അവർ എത്രകാലം കുറ്റമില്ലാതെ നിലനിൽക്കാൻ കഴിയില്ല?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ഇതു പോലും ഇസ്രായേലിൽ നിന്നാണ് വരുന്നത്!",
                "> ഒരു ശില്പി അതിനെ ഉണ്ടാക്കി, അതിനാൽ അത് ദൈവമല്ല;",
                "> സമാര്യയുടെ കാള നിശ്ചയമായും തകർന്നുപോകും."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> അവർ കാറ്റ് വിതയ്ക്കുന്നു",
                "> അവർ ചുഴലിക്കാറ്റ് കൊയ്യുന്നു.",
                "> നിലം നിൽക്കുന്ന ധാന്യത്തിന് കതിരുകളില്ല;",
                "> അതിന് ധാന്യം ഉണ്ടാകുന്നില്ല.",
                "> അതിന് ധാന്യം ഉണ്ടെങ്കിൽ, അന്യർ അതിനെ ഉപഭോഗിക്കും."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ഇസ്രായേൽ ഉപഭോഗിക്കപ്പെട്ടിരിക്കുന്നു;",
                "> അവർ ഇപ്പോൾ ജാതികളുടെ ഇടയിൽ",
                "> ആരും ഇഷ്ടപ്പെടാത്ത ഒരു പാത്രംപോലെയാണ്."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> അവർ അശ്ശൂരിലേക്ക് പോയിരിക്കുന്നു,",
                "> ഒറ്റപ്പെട്ട കാട്ടുകഴുതയെപ്പോലെ;",
                "> എഫ്രയീം പ്രിയക്കാരെ കൂലിക്കു വാങ്ങിയിരിക്കുന്നു."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> അവർ ജാതികളുടെ ഇടയിൽ കൂട്ടാളികളെ കൂലിക്കു വാങ്ങിയാലും,",
                "> ഞാൻ അവരെ ഇപ്പോൾ സമാഹരിക്കും;",
                "> അവർ കുറയാൻ തുടങ്ങും",
                "> ഉദ്യോഗസ്ഥരുടെ രാജാവിന്റെ ഭാരത്താൽ."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> എഫ്രയീം പാപത്തിനായി ബലിപീഠങ്ങൾ വർദ്ധിപ്പിച്ചിരിക്കുന്നു,",
                "> അവൻ പാപത്തിനുള്ള ബലിപീഠങ്ങളായി മാറിയിരിക്കുന്നു."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ഞാൻ അവനുവേണ്ടി എന്റെ ന്യായപ്രമാണത്തിന്റെ അനേകം ഉപദേശങ്ങൾ എഴുതിയാലും,",
                "> അവയെ വിദേശമായിട്ടാണ് കാണുന്നത്."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> എന്റെ ബലികളായ സമ്മാനങ്ങളെക്കുറിച്ച്,",
                "> അവർ മാംസം ബലി അർപ്പിച്ച് അതിനെ തിന്നുന്നു,",
                "> എന്നാൽ കർത്താവ് അവയെ അംഗീകരിക്കുന്നില്ല.",
                "> ഇപ്പോൾ അവന്റെ കുറ്റം ഓർക്കും",
                "> അവന്റെ പാപങ്ങൾക്കു ശിക്ഷ നൽകും;",
                "> അവർ മിസ്രയീമിലേക്കു മടങ്ങും."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ഇസ്രായേൽ തന്റെ സ്രഷ്ടാവിനെ മറന്നിരിക്കുന്നു, കൊട്ടാരങ്ങൾ പണിതിരിക്കുന്നു;",
                "> യെഹൂദാ ഉറപ്പുള്ള പട്ടണങ്ങൾ വർദ്ധിപ്പിച്ചിരിക്കുന്നു,",
                "> എന്നാൽ ഞാൻ അതിന്റെ പട്ടണങ്ങളിൽ തീ അയക്കും,",
                "> അതിന്റെ കോട്ടകളെ അത് ഉപഭോഗിക്കും."
            ]
        }
    ]
}