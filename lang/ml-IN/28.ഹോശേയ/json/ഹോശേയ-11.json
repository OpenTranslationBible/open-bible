{
    "book": "ഹോശേയാ",
    "chapter": 11,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> യിസ്രായേൽ ബാലനായിരിക്കുമ്പോൾ ഞാൻ അവനെ സ്നേഹിച്ചു,",
                "> മിസ്രയീമിൽ നിന്നു എന്റെ മകനെ വിളിച്ചു."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> അവർ കൂടുതൽ വിളിക്കപ്പെട്ടപ്പോൾ,",
                "> അവർ അവരിൽ നിന്നു കൂടുതൽ അകന്നു;",
                "> അവർ ബാലുകൾക്കു ബലികൾ കഴിച്ചു",
                "> വിഗ്രഹങ്ങൾക്ക് ധൂപം കാട്ടി."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> എങ്കിലും എഫ്രയീമിനെ നടക്കാൻ പഠിപ്പിച്ചത് ഞാൻ തന്നെയായിരുന്നു,",
                "> ഞാൻ അവരെ എന്റെ കൈകളിൽ എടുത്തു;",
                "> എങ്കിലും ഞാൻ അവരെ സുഖപ്പെടുത്തിയത് അവർ മനസ്സിലാക്കുന്നില്ല."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ഞാൻ മനുഷ്യന്റെ കയറുകളാൽ അവരെ നയിച്ചു,",
                "> സ്നേഹത്തിന്റെ ബന്ധനങ്ങളാൽ,",
                "> ഞാൻ അവരുടെ താടിയിൽ നിന്നു നുകം നീക്കി;",
                "> ഞാൻ താഴ്ന്നു അവരെ ഭക്ഷിപ്പിച്ചു."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> അവർ മിസ്രയീമിന്റെ ദേശത്തേക്കു മടങ്ങുകയില്ല;",
                "> എന്നാൽ അശ്ശൂർ അവരുടെ രാജാവായിരിക്കും",
                "> അവർ എന്നെ തിരിച്ചു വരാൻ നിരസിച്ചതിനാൽ."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> വാൾ അവരുടെ പട്ടണങ്ങൾക്കു നേരെ ചുറ്റും,",
                "> അവരുടെ പ്രവാചക പുരോഹിതന്മാരെ നശിപ്പിക്കും,",
                "> അവരുടെ ആലോചനകളാൽ അവരെ വിഴുങ്ങും."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> അതിനാൽ എന്റെ ജനങ്ങൾ എന്നിൽ നിന്നു മാറിപ്പോകുവാൻ ഉറച്ചിരിക്കുന്നു.",
                "> അവർ ഉയരത്തിലുള്ളവനെ വിളിച്ചാലും,",
                "> ആരും അവനെ സത്യമായി മഹത്വപ്പെടുത്തുന്നില്ല."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> എഫ്രയീമേ, ഞാൻ നിന്നെ എങ്ങനെ വിട്ടുകൊടുക്കും?",
                "> യിസ്രായേലേ, ഞാൻ നിന്നെ എങ്ങനെ വിട്ടുകൊടുക്കും?",
                "> ഞാൻ നിന്നെ എങ്ങനെ അദ്മാകു സമം ആക്കും?",
                "> ഞാൻ നിന്നെ എങ്ങനെ സെബോയീമിനെപ്പോലെ ആക്കും?",
                "> എന്റെ ഹൃദയം എന്റെ ഉള്ളിൽ ഉണർന്നിരിക്കുന്നു,",
                "> എന്റെ കരുണ നിറഞ്ഞിരിക്കുന്നു."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> എന്റെ ഉഗ്രകോപം ഞാൻ പുറത്തുവിടുകയില്ല;",
                "> എഫ്രയീമിനെ ഞാൻ വീണ്ടും നശിപ്പിക്കുകയില്ല.",
                "> ഞാൻ ദൈവമാണ്, മനുഷ്യൻ അല്ല,",
                "> ഞാൻ നിങ്ങളുടെ ഇടയിൽ വിശുദ്ധനാണ്,",
                "> ഞാൻ ക്രോധത്തോടെ വരികയില്ല."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> അവർ യഹോവയെ അനുഗമിക്കും,",
                "> അവൻ സിംഹം പോലെ ഗർജിക്കും;",
                "> തീർച്ചയായും അവൻ ഗർജിക്കും,",
                "> അവന്റെ മക്കൾ പടിഞ്ഞാറു നിന്നു വിറെച്ചുകൊണ്ടു വരും."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> അവർ മിസ്രയീമിൽ നിന്നു പക്ഷികൾ പോലെ വിറെച്ചുകൊണ്ടു വരും,",
                "> അശ്ശൂരിന്റെ ദേശത്തുനിന്നു പ്രാവുകൾ പോലെ;",
                "> ഞാൻ അവരെ അവരുടെ വീടുകളിൽ പാർപ്പിക്കും, യഹോവയുടെ അരുളപ്പാടു."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> എഫ്രയീം എന്നെ കള്ളങ്ങളാൽ ചുറ്റിയിരിക്കുന്നു,",
                "> യിസ്രായേലിന്റെ ഗൃഹം വഞ്ചനയാൽ;",
                "> യെഹൂദയും ദൈവത്തോടു വിരോധമായി,",
                "> എങ്കിലും ഞാൻ വിശുദ്ധനും വിശ്വസ്തനുമാണ്."
            ]
        }
    ]
}