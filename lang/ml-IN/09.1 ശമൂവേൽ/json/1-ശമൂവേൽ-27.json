{
    "book": "1 ശമൂവേൽ",
    "chapter": 27,
    "verses": [
        {
            "verse": 1,
            "text": [
                "അപ്പോൾ ദാവീദ് തന്റെ മനസ്സിൽ പറഞ്ഞു,",
                "“ഒരു ദിവസം ഞാൻ ശൗലിന്റെ കൈകൊണ്ടു നശിച്ചുപോകും.",
                "ഫിലിസ്ത്യരുടെ ദേശത്തേക്കു രക്ഷപ്പെടുന്നതല്ലാതെ",
                "ഇസ്രായേൽ അതിർത്തികളിൽ എനിക്കു വേണ്ടി അന്വേഷിക്കുന്നതിൽ",
                "ശൗൽ നിരാശപ്പെടും,",
                "അപ്പോൾ ഞാൻ അവന്റെ കൈയിൽ നിന്നു രക്ഷപ്പെടും.”"
            ]
        },
        {
            "verse": 2,
            "text": [
                "അങ്ങനെ, ദാവീദ് അവനോടുകൂടെ ഉണ്ടായിരുന്ന അറുനൂറു പേരോടുകൂടെ",
                "ഗാഥിലെ രാജാവായ മാവോക്കിന്റെ മകനായ ആഖീശിന്റെ അടുക്കൽ പോയി."
            ]
        },
        {
            "verse": 3,
            "text": [
                "ദാവീദും അവന്റെ പുരുഷന്മാരും, ഓരോരുത്തരും അവരുടെ കുടുംബത്തോടുകൂടെ,",
                "ദാവീദ് തന്റെ രണ്ടു ഭാര്യമാരായ യിസ്രെയേലുകാരിയായ അഹിനോവവും",
                "കർമ്മേലുകാരനായ നാബാലിന്റെ വിധവയായ അബീഗയിലും കൂടെ,",
                "ഗാഥിൽ ആഖീശിനോടുകൂടെ പാർത്തി."
            ]
        },
        {
            "verse": 4,
            "text": [
                "ദാവീദ് ഗാഥിലേക്കു ഓടിപ്പോയെന്നു ശൗലിന്നു അറിയിച്ചപ്പോൾ,",
                "അവൻ അവനെ അന്വേഷിക്കുന്നതു നിർത്തി."
            ]
        },
        {
            "verse": 5,
            "text": [
                "അപ്പോൾ ദാവീദ് ആഖീശിനോടു പറഞ്ഞു,",
                "“ഇപ്പോൾ ഞാൻ നിന്റെ കണ്മുന്നിൽ കൃപ കണ്ടു എങ്കിൽ,",
                "നിന്റെ ദാസൻ നിനക്കു കൂടെ രാജധാനിയിൽ പാർക്കേണ്ടതിന്നു",
                "എന്തു വേണ്ടിയിരിക്കുന്നു?",
                "എനിക്കു ഒരു ഗ്രാമത്തിൽ പാർപ്പാൻ ഒരു സ്ഥലം തരണമേ.”"
            ]
        },
        {
            "verse": 6,
            "text": [
                "ആഖീശ് അന്നു തന്നേ അവന്നു സിക്ലാഗ് കൊടുത്തു;",
                "ഫലമായി, സിക്ലാഗ് ഇന്നുവരെ യെഹൂദയുടെ രാജാക്കന്മാർക്കു സ്വന്തമായിരിക്കുന്നു."
            ]
        },
        {
            "verse": 7,
            "text": [
                "ഇപ്പോൾ ദാവീദ് ഫിലിസ്ത്യരുടെ ദേശത്തു പാർത്ത കാലം",
                "ഒരു വർഷവും നാലു മാസവുമായിരുന്നു."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "ഇപ്പോൾ ദാവീദും അവന്റെ പുരുഷന്മാരും ഗെശൂർക്കാരെയും ഗിർസ്യരെയും",
                "അമാലേക്യരെയും ആക്രമിച്ചു;",
                "അവർ പുരാതനകാലം മുതൽ",
                "ശൂർവരെ, മിസ്രയീം ദേശത്തേക്കു വരുന്നതുവരെ",
                "ആ ദേശത്തിന്റെ നിവാസികളായിരുന്നു."
            ]
        },
        {
            "verse": 9,
            "text": [
                "ദാവീദ് ആ ദേശത്തെ ആക്രമിച്ചു,",
                "ഒരു പുരുഷനെയും സ്ത്രീയെയും ജീവനോടെ വിട്ടില്ല,",
                "ആടുകളെയും കാളകളെയും കഴുതകളെയും ഒട്ടകങ്ങളെയും വസ്ത്രങ്ങളെയും എടുത്തു.",
                "പിന്നീട് അവൻ മടങ്ങി ആഖീശിന്റെ അടുക്കൽ എത്തി."
            ]
        },
        {
            "verse": 10,
            "text": [
                "ഇപ്പോൾ ആഖീശ് ചോദിക്കും, “ഇന്ന് നീ എവിടെ ആക്രമിച്ചു?”",
                "അപ്പോൾ ദാവീദ് പറയും, “യെഹൂദയുടെ നെഗെവിൽ,”",
                "അല്ലെങ്കിൽ “യെരഹ്മേല്യരുടെ നെഗെവിൽ,”",
                "അല്ലെങ്കിൽ “കേന്യരുടെ നെഗെവിൽ.”"
            ]
        },
        {
            "verse": 11,
            "text": [
                "ദാവീദ് ഒരു പുരുഷനെയും സ്ത്രീയെയും ജീവനോടെ ഗാഥിലേക്കു കൊണ്ടുപോകാതെ,",
                "“അവൻ ചെയ്തതു ദാവീദ് ഇങ്ങനെ ചെയ്തുവെന്ന്",
                "അവരെക്കുറിച്ചു പറയുമെന്നു അവർ പറയും” എന്നു പറഞ്ഞു.",
                "അവൻ ഫിലിസ്ത്യരുടെ ദേശത്തു പാർത്ത കാലം മുഴുവൻ",
                "ദാവീദ് ഇങ്ങനെ തന്നെയാണ് പെരുമാറിയത്."
            ]
        },
        {
            "verse": 12,
            "text": [
                "അങ്ങനെ ആഖീശ് ദാവീദിനെ വിശ്വസിച്ചു,",
                "“അവൻ തീർച്ചയായും തന്റെ ജനമായ ഇസ്രായേലിനോടു",
                "വെറുപ്പുണ്ടാക്കി;",
                "അതുകൊണ്ടു അവൻ എന്നേക്കും എന്റെ ദാസനാകും” എന്നു പറഞ്ഞു."
            ]
        }
    ]
}