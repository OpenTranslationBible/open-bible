{
    "book": "2 ശമൂവേൽ",
    "chapter": 21,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ദാവീദിന്റെ കാലത്തു മൂന്നു സംവത്സരം തുടർച്ചയായി ക്ഷാമം ഉണ്ടായി;",
                "ദാവീദ് യഹോവയോടു ചോദിച്ചു.",
                "യഹോവ പറഞ്ഞു,",
                "“ഇത് ശൗലിന്റെയും അവന്റെ രക്തപാതകമായ വീട്ടിന്റെയും കാരണമാണ്,",
                "അവൻ ഗിബെയോന്യരെ കൊല്ലുകയാൽ.”"
            ]
        },
        {
            "verse": 2,
            "text": [
                "അപ്പോൾ രാജാവു ഗിബെയോന്യരെ വിളിച്ചു അവരോടു സംസാരിച്ചു.",
                "(ഗിബെയോന്യർ യിസ്രായേൽമക്കളുടെ സന്തതിയിൽ പെട്ടവരല്ല,",
                "അമോര്യരുടെ ശേഷിപ്പിൽ പെട്ടവരാണ്,",
                "യിസ്രായേൽമക്കൾ അവരോടു സത്യം ചെയ്തിരുന്നു;",
                "പക്ഷേ ശൗൽ യിസ്രായേലിന്റെയും യെഹൂദയുടെയും മക്കളുടെ കാര്യത്തിൽ",
                "തീവ്രതയോടെ അവരെ നശിപ്പിക്കുവാൻ നോക്കി.)"
            ]
        },
        {
            "verse": 3,
            "text": [
                "അതുകൊണ്ടു ദാവീദ് ഗിബെയോന്യരോടു പറഞ്ഞു,",
                "“ഞാൻ നിങ്ങള്ക്കു വേണ്ടി എന്തു ചെയ്യണം,",
                "ഞാൻ എങ്ങനെ പ്രായശ്ചിത്തം ചെയ്യണം,",
                "നിങ്ങൾ യഹോവയുടെ അവകാശത്തെ അനുഗ്രഹിക്കേണ്ടതിന്നു?”"
            ]
        },
        {
            "verse": 4,
            "text": [
                "ഗിബെയോന്യർ അവനോടു പറഞ്ഞു,",
                "“ശൗലിനോടോ അവന്റെ വീട്ടിനോടോ ഞങ്ങൾക്കു വെള്ളിയോ പൊന്നോ അവകാശമില്ല,",
                "യിസ്രായേലിൽ ആരെയും കൊല്ലുവാൻ ഞങ്ങൾക്കു അധികാരവുമില്ല.”",
                "അപ്പോൾ അവൻ പറഞ്ഞു, “നിങ്ങൾ പറയുന്നതു ഞാൻ ചെയ്യും.”"
            ]
        },
        {
            "verse": 5,
            "text": [
                "അവർ രാജാവിനോടു പറഞ്ഞു,",
                "“ഞങ്ങളെ നശിപ്പിച്ചവനും ഞങ്ങളെ ഇല്ലാതാക്കുവാൻ പദ്ധതിയിട്ടവനും,",
                "യിസ്രായേലിന്റെ എല്ലാ പ്രദേശത്തും ഞങ്ങൾക്ക് സ്ഥലം ഇല്ലാതാക്കുവാൻ—"
            ]
        },
        {
            "verse": 6,
            "text": [
                "അവന്റെ മക്കളിൽ ഏഴുപേരെ ഞങ്ങൾക്ക് കൈമാറുക,",
                "ഞങ്ങൾ അവരെ യഹോവയുടെ മുമ്പാകെ ശൗലിന്റെ ഗിബെയയിൽ തൂക്കിക്കൊല്ലും,",
                "യഹോവയുടെ തിരഞ്ഞെടുത്തവൻ.”",
                "രാജാവു പറഞ്ഞു, “ഞാൻ അവരെ കൊടുക്കും.”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "പക്ഷേ രാജാവു മെഫീബോശെത്തിൽ,",
                "ശൗലിന്റെ മകൻ യോനാഥാന്റെ മകൻ,",
                "ദാവീദും ശൗലിന്റെ മകൻ യോനാഥാനും തമ്മിലുള്ള",
                "യഹോവയുടെ സത്യം കാരണം അവനെ രക്ഷിച്ചു."
            ]
        },
        {
            "verse": 8,
            "text": [
                "അപ്പോൾ രാജാവു അയാഹിന്റെ മകൾ റിസ്പയുടെ രണ്ടു മക്കളെ,",
                "അവൾ ശൗലിന്നു ജനിപ്പിച്ച അർമോനിയും മെഫീബോശെത്തിൽ,",
                "ശൗലിന്റെ മകൾ മെരബിന്റെ അഞ്ചു മക്കളെ,",
                "അവൾ മെഹോലാത്യനായ ബർസില്ലായിയുടെ മകൻ",
                "അദ്രിയേലിന്നു ജനിപ്പിച്ചവരെ എടുത്തു."
            ]
        },
        {
            "verse": 9,
            "text": [
                "അവരെ ഗിബെയോന്യർക്കു കൈമാറി,",
                "അവർ അവരെ യഹോവയുടെ മുമ്പാകെ മലയിൽ തൂക്കിക്കൊന്നു.",
                "അങ്ങനെ ഏഴുപേരും ഒരുമിച്ചു വീണു,",
                "അവരെ കൊന്നതു കൊയ്ത്തിന്റെ ആദ്യദിവസങ്ങളിൽ,",
                "ജൗവരി കൊയ്ത്തിന്റെ ആരംഭത്തിൽ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "അപ്പോൾ അയാഹിന്റെ മകൾ റിസ്പ തുണി എടുത്തു പാറമേൽ വിരിച്ചു,",
                "കൊയ്ത്തിന്റെ ആരംഭം മുതൽ ആകാശത്തുനിന്നു മഴ പെയ്യുന്നതുവരെ;",
                "പകൽ പക്ഷികൾ അവരിൽ വിശ്രമിക്കാതെയും,",
                "രാത്രിയിൽ കാട്ടുമൃഗങ്ങൾ അവരിൽ എത്താതെയും അവൾ നോക്കി."
            ]
        },
        {
            "verse": 11,
            "text": [
                "ശൗലിന്റെ ഉപപത്നിയായ അയാഹിന്റെ മകൾ റിസ്പയുടെ പ്രവൃത്തികളെക്കുറിച്ച്",
                "ദാവീദ് അറിഞ്ഞപ്പോൾ,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "ദാവീദ് യാബേശ്-ഗിലെയാദിലെ പുരുഷന്മാരിൽനിന്നു",
                "ശൗലിന്റെയും അവന്റെ മകൻ യോനാഥാന്റെയും അസ്ഥികൾ എടുത്തു,",
                "ഫിലിസ്ത്യർ ശൗലിനെ ഗിൽബോവയിൽ കൊന്ന നാളിൽ",
                "ഫിലിസ്ത്യർ അവരെ തൂക്കിയിരുന്ന ബേത്ത്-ശാനിലെ പൊതുസ്ഥലത്തു നിന്നു."
            ]
        },
        {
            "verse": 13,
            "text": [
                "അവൻ അവിടെനിന്നു ശൗലിന്റെയും അവന്റെ മകൻ",
                "യോനാഥാന്റെയും അസ്ഥികൾ എടുത്തു,",
                "കൊല്ലപ്പെട്ടവരുടെ അവശിഷ്ടങ്ങളും ശേഖരിച്ചു."
            ]
        },
        {
            "verse": 14,
            "text": [
                "അവൻ ശൗലിന്റെയും അവന്റെ മകൻ",
                "യോനാഥാന്റെയും അസ്ഥികൾ",
                "ബെന്യാമീൻ ദേശത്തിലെ സെലയിൽ,",
                "അവന്റെ പിതാവായ കീശിന്റെ കല്ലറയിൽ അടക്കം ചെയ്തു.",
                "അങ്ങനെ രാജാവു കല്പിച്ചതു എല്ലാം ചെയ്തു.",
                "അതിനു ശേഷം ദേശത്തിനുവേണ്ടി ദൈവം പ്രാർത്ഥനയെ ഉത്തരം നൽകി."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "അപ്പോൾ ഫിലിസ്ത്യർ വീണ്ടും യിസ്രായേലിനോടു യുദ്ധം ചെയ്തു,",
                "ദാവീദ് തന്റെ ദാസന്മാരോടുകൂടെ പോയി ഫിലിസ്ത്യർക്കെതിരെ യുദ്ധം ചെയ്തു,",
                "ദാവീദിനു ക്ഷീണം തോന്നി."
            ]
        },
        {
            "verse": 16,
            "text": [
                "അപ്പോൾ ഭീമന്മാരുടെ സന്തതിയിൽ പെട്ട",
                "ഇശ്ബി-ബേനോബ്,",
                "അവന്റെ കുന്തം മൂവായിരം ശേക്കൽ വെങ്കലം തൂക്കിയിരുന്നു,",
                "പുതിയ വാൾ ധരിച്ചിരുന്നവൻ,",
                "ദാവീദിനെ കൊല്ലുവാൻ ഉദ്ദേശിച്ചു."
            ]
        },
        {
            "verse": 17,
            "text": [
                "പക്ഷേ സെരൂയയുടെ മകൻ അബീശായി അവനെ സഹായിച്ചു,",
                "ഫിലിസ്ത്യനെ അടിച്ചു കൊന്നു.",
                "അപ്പോൾ ദാവീദിന്റെ പുരുഷന്മാർ അവനോടു സത്യം ചെയ്തു പറഞ്ഞു,",
                "“നീ ഇനി ഞങ്ങളോടുകൂടെ യുദ്ധത്തിന്നു പുറപ്പെടരുതു,",
                "ഇസ്രായേലിന്റെ ദീപം കെടുത്താതിരിക്കേണ്ടതിന്നു.”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ഇതിനു ശേഷം ഗോബിൽ ഫിലിസ്ത്യർക്കെതിരെ വീണ്ടും യുദ്ധം നടന്നു.",
                "അപ്പോൾ ഹുഷാത്യനായ ശിബ്ബെക്കായി",
                "ഭീമന്മാരുടെ സന്തതിയിൽ പെട്ട സാഫിനെ അടിച്ചു."
            ]
        },
        {
            "verse": 19,
            "text": [
                "ഗോബിൽ വീണ്ടും ഫിലിസ്ത്യർക്കെതിരെ യുദ്ധം നടന്നു,",
                "ബേത്ത്ളേഹമ്യനായ യാരെ-ഓരേഗീമിന്റെ മകൻ എൽഹാനാൻ",
                "ഗിത്ത്യനായ ഗൊലിയാത്തിനെ അടിച്ചു,",
                "അവന്റെ കുന്തത്തിന്റെ ദണ്ഡം നെയ്ത്തുകാരന്റെ കരകൗശലപോലെയായിരുന്നു."
            ]
        },
        {
            "verse": 20,
            "text": [
                "ഗാഥിൽ വീണ്ടും യുദ്ധം നടന്നു,",
                "അവിടെ വലിയ ശരീരമുള്ള ഒരു മനുഷ്യൻ ഉണ്ടായിരുന്നു,",
                "അവൻ ഓരോ കൈക്കും ആറു വിരലുകളും ഓരോ കാലിനും ആറു വിരലുകളും ഉണ്ടായിരുന്നു,",
                "മൊത്തം ഇരുപത്തിനാലു;",
                "അവനും ഭീമന്മാരുടെ സന്തതിയിൽ പെട്ടവനായിരുന്നു."
            ]
        },
        {
            "verse": 21,
            "text": [
                "അവൻ യിസ്രായേലിനോടു വെല്ലുവിളിച്ചപ്പോൾ,",
                "ദാവീദിന്റെ സഹോദരനായ ശിമെയിയുടെ മകൻ യോനാഥാൻ അവനെ തോല്പിച്ചു."
            ]
        },
        {
            "verse": 22,
            "text": [
                "ഇവരെല്ലാം ഗാഥിലെ ഭീമന്റെ സന്തതിയിൽ ജനിച്ചവരായിരുന്നു,",
                "അവരെ ദാവീദും അവന്റെ ദാസന്മാരും തോല്പിച്ചു."
            ]
        }
    ]
}