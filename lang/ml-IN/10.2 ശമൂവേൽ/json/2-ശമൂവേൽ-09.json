{
    "book": "2 ശമൂവേൽ",
    "chapter": 9,
    "verses": [
        {
            "verse": 1,
            "text": [
                "അപ്പോൾ ദാവീദ് പറഞ്ഞു,",
                "“യോനാഥാന്റെ നിമിത്തം",
                "ഞാൻ ദയ കാണിക്കേണ്ടതിന്നു",
                "ശൗലിന്റെ വീട്ടിൽ ആരെങ്കിലും ശേഷിച്ചുണ്ടോ?”"
            ]
        },
        {
            "verse": 2,
            "text": [
                "ശൗലിന്റെ വീട്ടിൽ സീബാ എന്ന പേരിൽ ഒരു ദാസൻ ഉണ്ടായിരുന്നു,",
                "അവനെ ദാവീദിന്റെ മുമ്പിൽ കൊണ്ടുവന്നു.",
                "രാജാവു അവനോടു ചോദിച്ചു, “നീ സീബയോ?”",
                "അവൻ മറുപടി നൽകി, “ഞാൻ നിങ്ങളുടെ ദാസനാണ്.”"
            ]
        },
        {
            "verse": 3,
            "text": [
                "അപ്പോൾ രാജാവു പറഞ്ഞു,",
                "“ദൈവത്തിന്റെ ദയ കാണിക്കേണ്ടതിന്നു",
                "ശൗലിന്റെ വീട്ടിൽ ആരെങ്കിലും ശേഷിച്ചുണ്ടോ?”",
                "അപ്പോൾ സീബാ രാജാവിനോടു പറഞ്ഞു,",
                "“യോനാഥാന്റെ ഒരു മകൻ ഇപ്പോഴും ഉണ്ടു,",
                "അവൻ ഇരുകാലും മുടന്തനാണ്.”"
            ]
        },
        {
            "verse": 4,
            "text": [
                "രാജാവു ചോദിച്ചു, “അവൻ എവിടെയുണ്ട്?”",
                "അപ്പോൾ സീബാ രാജാവിനോടു പറഞ്ഞു,",
                "“അവൻ ലോ-ദെബാറിലെ അമ്മീയേലിന്റെ മകനായ മാകീറിന്റെ വീട്ടിലുണ്ട്.”"
            ]
        },
        {
            "verse": 5,
            "text": [
                "അപ്പോൾ രാജാവായ ദാവീദ് ദൂതന്മാരെ അയച്ചു,",
                "അവനെ അമ്മീയേലിന്റെ മകനായ മാകീറിന്റെ വീട്ടിൽ നിന്ന്,",
                "ലോ-ദെബാറിൽ നിന്ന് കൊണ്ടുവന്നു."
            ]
        },
        {
            "verse": 6,
            "text": [
                "യോനാഥാന്റെ മകനും ശൗലിന്റെ മകനുമായ മെഫീബോശെത്ത് ദാവീദിന്റെ അടുക്കൽ വന്നു,",
                "വണങ്ങി, നമസ്കരിച്ചു.",
                "അപ്പോൾ ദാവീദ് പറഞ്ഞു, “മെഫീബോശെത്ത്!”",
                "അവൻ മറുപടി നൽകി, “നിങ്ങളുടെ ദാസൻ ഇവിടെ!”"
            ]
        },
        {
            "verse": 7,
            "text": [
                "ദാവീദ് അവനോടു പറഞ്ഞു,",
                "“ഭയപ്പെടേണ്ട, ഞാൻ നിനക്കു നിന്റെ അച്ഛൻ",
                "യോനാഥാന്റെ നിമിത്തം ദയ കാണിക്കും;",
                "നിന്റെ മുത്തശ്ശൻ ശൗലിന്റെ എല്ലാ ഭൂമിയും ഞാൻ നിനക്കു തിരിച്ചു തരാം;",
                "നീ എന്റെ മേശയിൽ സ്ഥിരമായി ഭക്ഷണം കഴിക്കും.”"
            ]
        },
        {
            "verse": 8,
            "text": [
                "അവൻ നമസ്കരിച്ചു പറഞ്ഞു,",
                "“നിങ്ങൾ ഒരു മരിച്ച നായയെപ്പോലെ",
                "എന്നെ കാണുന്നതെന്താണ്?”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "അപ്പോൾ രാജാവു സീബായെ, ശൗലിന്റെ ദാസനെയും വിളിച്ചു പറഞ്ഞു,",
                "“ശൗലിനും അവന്റെ കുടുംബത്തിനും ഉണ്ടായിരുന്ന",
                "എല്ലാം ഞാൻ നിന്റെ യജമാനന്റെ മകനു കൊടുത്തിരിക്കുന്നു."
            ]
        },
        {
            "verse": 10,
            "text": [
                "നീയും, നിന്റെ പുത്രന്മാരും, നിന്റെ ദാസന്മാരും അവന്നു വേണ്ടി ഭൂമി കൃഷി ചെയ്ത്,",
                "വിളവു കൊണ്ടുവരണം",
                "നിന്റെ യജമാനന്റെ മകനു ഭക്ഷണം ലഭിക്കേണ്ടതിന്നു;",
                "എന്നാൽ, നിന്റെ യജമാനന്റെ മകനായ മെഫീബോശെത്ത്",
                "എന്റെ മേശയിൽ സ്ഥിരമായി ഭക്ഷണം കഴിക്കും.”",
                "സീബയ്ക്കു പതിനഞ്ചു പുത്രന്മാരും ഇരുപതു ദാസന്മാരുമുണ്ടായിരുന്നു."
            ]
        },
        {
            "verse": 11,
            "text": [
                "അപ്പോൾ സീബാ രാജാവിനോടു പറഞ്ഞു,",
                "“എന്റെ യജമാനനായ രാജാവു തന്റെ ദാസനോടു കല്പിക്കുന്നതുപോലെ",
                "എന്റെ ദാസൻ ചെയ്യും.”",
                "അങ്ങനെ മെഫീബോശെത്ത്",
                "രാജാവിന്റെ മേശയിൽ രാജാവിന്റെ പുത്രന്മാരിൽ ഒരാളെപ്പോലെ ഭക്ഷണം കഴിച്ചു."
            ]
        },
        {
            "verse": 12,
            "text": [
                "മെഫീബോശെത്തിനു മിക്കാ എന്ന പേരിൽ ഒരു ബാലൻ ഉണ്ടായിരുന്നു.",
                "സീബയുടെ വീട്ടിൽ പാർത്ത എല്ലാവരും",
                "മെഫീബോശെത്തിനുള്ള ദാസന്മാരായിരുന്നു."
            ]
        },
        {
            "verse": 13,
            "text": [
                "അങ്ങനെ മെഫീബോശെത്ത് യെരൂശലേമിൽ പാർത്തു,",
                "രാജാവിന്റെ മേശയിൽ സ്ഥിരമായി ഭക്ഷണം കഴിച്ചു.",
                "അവൻ ഇരുകാലും മുടന്തനായിരുന്നു."
            ]
        }
    ]
}