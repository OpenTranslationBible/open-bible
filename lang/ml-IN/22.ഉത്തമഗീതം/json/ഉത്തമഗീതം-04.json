{
    "book": "സൊലോമോന്റെ ഗാനം",
    "chapter": 4,
    "verses": [
        {
            "verse": 1,
            "text": [
                "എത്ര മനോഹരമാണ് നീ, എന്റെ പ്രിയേ,",
                "എത്രയേറെ മനോഹരമാണ് നീ!",
                "നിന്റെ കണ്ണുകൾ നിന്റെ മൂടുപടത്തിനുപിന്നിൽ പ്രാവുകളെപ്പോലെ;",
                "നിന്റെ മുടി ഗിലെയാദ് പർവ്വതത്തിൽനിന്ന് ഇറങ്ങുന്ന",
                "ആടുകളുടെ കൂട്ടത്തെപ്പോലെ ഒഴുകുന്നു."
            ]
        },
        {
            "verse": 2,
            "text": [
                "നിന്റെ പല്ലുകൾ കഴുകി വന്ന",
                "പുതുതായി മുണ്ഡനം ചെയ്ത ആടുകളുടെ കൂട്ടത്തെപ്പോലെ,",
                "അവയിൽ എല്ലാം ഇരട്ടക്കുട്ടികളുള്ളവയാണ്,",
                "അവയിൽ ഒന്നും തന്റെ കുഞ്ഞിനെ നഷ്ടപ്പെടുത്തിയിട്ടില്ല."
            ]
        },
        {
            "verse": 3,
            "text": [
                "നിന്റെ അധരങ്ങൾ ചുവന്ന നൂലിനെപ്പോലെ,",
                "നിന്റെ വായ് ആകർഷകമാണ്.",
                "നിന്റെ കവിളുകൾ നിന്റെ മൂടുപടത്തിനുപിന്നിൽ",
                "മാതളനാരങ്ങയുടെ ഒരു തൊണ്ടിപ്പഴംപോലെ."
            ]
        },
        {
            "verse": 4,
            "text": [
                "നിന്റെ കഴുത്ത് ദാവീദിന്റെ ഗോപുരംപോലെ,",
                "കല്ലുകൾ കൊണ്ട് പണിതത്,",
                "അതിന്മേൽ ആയിരം കവചങ്ങൾ തൂക്കിയിരിക്കുന്നു,",
                "യോദ്ധാക്കളുടെ വൃത്താകൃതിയിലുള്ള കവചങ്ങൾ."
            ]
        },
        {
            "verse": 5,
            "text": [
                "നിന്റെ രണ്ടു സ്തനങ്ങൾ രണ്ടു മാൻകുട്ടികളെപ്പോലെ,",
                "കുറുമ്പാടിന്റെ ഇരട്ടക്കുട്ടികൾ,",
                "താമരപ്പൂക്കളിൽ ഇടയുന്നു."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "പകൽ തണുപ്പിന്റെ ശ്വാസം വീശുംവരെ,",
                "നിഴലുകൾ മാറുംവരെ,",
                "ഞാൻ എന്റെ വഴിക്ക് മ്യുര്‍ പർവ്വതത്തിലേക്കും",
                "കുന്തുരുക്കം മലയിൽക്കും പോകും."
            ]
        },
        {
            "verse": 7,
            "text": [
                "നീ മുഴുവനും സുന്ദരിയാണ്, എന്റെ പ്രിയേ,",
                "നിനക്കൊരുവിധം ദോഷവും ഇല്ല."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "ലെബനോനിൽ നിന്നു എന്നോടുകൂടെ വരിക, എന്റെ വധുവേ,",
                "ലെബനോനിൽ നിന്നു എന്നോടുകൂടെ വരിക.",
                "അമാനയുടെ ശിഖരത്തിൽനിന്നും,",
                "സേനീർ, ഹേർമോൻ പർവ്വതങ്ങളിലെ ശിഖരങ്ങളിൽനിന്നും,",
                "സിംഹങ്ങളുടെ ഗുഹകളിൽനിന്നും,",
                "ചിറകുള്ള പർവ്വതങ്ങളിൽനിന്നും ഇറങ്ങുക."
            ]
        },
        {
            "verse": 9,
            "text": [
                "നീ എന്റെ ഹൃദയം പിടിച്ചിരിക്കുന്നു, എന്റെ സഹോദരീ, എന്റെ വധുവേ;",
                "നിന്റെ കണ്ണുകളുടെ ഒരു നോക്കിൽ,",
                "നിന്റെ മാലയുടെ ഒരു മുത്തിൽ,",
                "നീ എന്റെ ഹൃദയം പിടിച്ചിരിക്കുന്നു."
            ]
        },
        {
            "verse": 10,
            "text": [
                "എത്ര ആകർഷകമാണ് നിന്റെ സ്നേഹം, എന്റെ സഹോദരീ, എന്റെ വധുവേ!",
                "നിന്റെ സ്നേഹം വീഞ്ഞിനെക്കാൾ എത്രയോ നല്ലത്,",
                "നിന്റെ എണ്ണങ്ങളുടെ സുഗന്ധം എല്ലായിനം കുന്തുരുക്കം എണ്ണകളെക്കാൾ നല്ലത്!"
            ]
        },
        {
            "verse": 11,
            "text": [
                "നിന്റെ അധരങ്ങൾ തേൻ ചൊരിയുന്നു, എന്റെ വധുവേ;",
                "തേനും പാലും നിന്റെ നാവിന് കീഴിൽ,",
                "നിന്റെ വസ്ത്രങ്ങളുടെ സുഗന്ധം ലെബനോന്റെ സുഗന്ധംപോലെ."
            ]
        },
        {
            "verse": 12,
            "text": [
                "ഒരു പൂട്ടിയ തോട്ടമാണ് എന്റെ സഹോദരീ, എന്റെ വധുവേ,",
                "ഒരു പൂട്ടിയ കിണർ, ഒരു മുദ്രയിട്ട ഉറവ."
            ]
        },
        {
            "verse": 13,
            "text": [
                "നിന്റെ ശാഖകൾ ഒരു മാതളനാരങ്ങയുടെ തോട്ടംപോലെ",
                "സുഖകരമായ ഫലങ്ങളുള്ളത്,",
                "ഹെന്നയും നാർദുമുള്ള ചെടികൾ,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "നാർദും കുങ്കുമവും, സുഗന്ധച്ചെറുപുല്ലും ചുക്കും,",
                "എല്ലാ കുന്തുരുക്കം മരങ്ങളും,",
                "മ്യുരും അഗരു, എല്ലായിനം മികച്ച കുന്തുരുക്കം എണ്ണകളും."
            ]
        },
        {
            "verse": 15,
            "text": [
                "നീ ഒരു തോട്ടത്തിന്റെ ഉറവപോലെ,",
                "തണുത്ത വെള്ളത്തിന്റെ കിണർ,",
                "ലെബനോനിൽനിന്ന് ഒഴുകുന്ന നീരുറവുകൾ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "ഉണരുക, വടക്കൻ കാറ്റേ,",
                "വരിക, തെക്കൻ കാറ്റേ;",
                "എന്റെ തോട്ടം സുഗന്ധം വിടരട്ടെ,",
                "അതിന്റെയെണ്ണങ്ങൾ ഒഴുകട്ടെ.",
                "എന്റെ പ്രിയൻ തന്റെ തോട്ടത്തിൽ വരിക,",
                "അതിന്റെയെളിമയുള്ള ഫലങ്ങൾ തിന്നുക!"
            ]
        }
    ]
}