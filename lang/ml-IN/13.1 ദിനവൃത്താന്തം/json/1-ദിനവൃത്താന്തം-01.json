{
    "book": "1 ദിനവൃത്താന്തം",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ആദാം, ശേത്ത്, എനോഷ്,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "കേനാൻ, മഹലലേൽ, യാരെദ്,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "എനോക്ക്, മെഥൂശലഹ്, ലാമെക്,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "നോഹ, അവന്റെ പുത്രന്മാരായ:",
                "> ശേം, ഹാം, യാഫെത്ത്."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "യാഫെത്തിന്റെ പുത്രന്മാർ:",
                "> ഗോമെർ, മാഗോഗ്, മാദായ്, യാവാൻ, തുബാൽ, മെഷെക്, തിരാസ്."
            ]
        },
        {
            "verse": 6,
            "text": [
                "ഗോമെറിന്റെ പുത്രന്മാർ:",
                "> അശ്കെനാസ്, ദിഫാത്ത്, തോഗർമാ."
            ]
        },
        {
            "verse": 7,
            "text": [
                "യാവാന്റെ വംശം:",
                "> എലീശാ, തർശീശ്, കിത്തീം, റോദാനീം."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "ഹാമിന്റെ പുത്രന്മാർ:",
                "> കൂശ്, മിസ്രായിം, പൂത്ത്, കനാൻ."
            ]
        },
        {
            "verse": 9,
            "text": [
                "കൂശിന്റെ പുത്രന്മാർ:",
                "> ശെബാ, ഹവില, സബ്താ, രാമാ, സബ്തെക്ക.",
                "> രാമായുടെ പുത്രന്മാർ:",
                "> ശെബാ, ദേദാൻ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> കൂശ് നിമ്രോദിന്റെ പിതാവായിരുന്നു;",
                "> അവൻ ഭൂമിയിൽ മഹാനായവനായി."
            ]
        },
        {
            "verse": 11,
            "text": [
                "മിസ്രായിം പിതാവായിരുന്നു",
                "> ലൂദ്, അനാം, ലഹാബ്, നഫ്തൂഹ്,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> പത്രൂസ്, കാസ്ലൂഹ് (അവിടെനിന്നാണ് ഫെലിസ്ത്യർ വന്നത്), കഫ്തോർ."
            ]
        },
        {
            "verse": 13,
            "text": [
                "കനാൻ പിതാവായിരുന്നു",
                "> സീദോൻ, അവന്റെ ആദ്യജാതൻ, ഹിത്ത്,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "ജെബൂസ്യർ, അമോര്യർ, ഗിർഗശ്യർ,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "ഹിവ്യർ, അർക്ക്യർ, സിന്യർ,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "അർവദ്യർ, സെമാര്യർ, ഹമാത്യർ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "ശേമിന്റെ പുത്രന്മാർ:",
                "> ഏലം, അശ്ശൂർ, അർപക്ഷാദ്, ലൂദ്, അരാം,",
                "> അരാമിന്റെ പുത്രന്മാർ:",
                "> ഉസ്, ഹുൽ, ഗെഥെർ, മെഷെക്."
            ]
        },
        {
            "verse": 18,
            "text": [
                "അർപക്ഷാദ് ശേലാഹിന്റെ പിതാവായിരുന്നു,",
                "ശേലാഹ് ഏബെറിന്റെ പിതാവായിരുന്നു."
            ]
        },
        {
            "verse": 19,
            "text": [
                "ഏബെറിന് രണ്ടു പുത്രന്മാർ ഉണ്ടായിരുന്നു:",
                "> ഒരുവന്റെ പേര് പെലെഗ്, അവന്റെ കാലത്ത് ഭൂമി വിഭജിക്കപ്പെട്ടു;",
                "> അവന്റെ സഹോദരന്റെ പേര് യോക്താൻ."
            ]
        },
        {
            "verse": 20,
            "text": [
                "യോഗ്താന്റെ സന്തതി:",
                "> അൽമോദാദ്, ശെലേഫ്, ഹസർമാവെത്ത്, യെരഹ്,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "ഹദോരം, ഉസാൽ, ദിക്ലാ,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "എബാൽ, അബീമയേൽ, ശെബാ,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "ഓഫീർ, ഹവില, യോബാബ്.",
                "ഇവരൊക്കെയും യോക്താന്റെ പുത്രന്മാരായിരുന്നു."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ശേം, അർപക്ഷാദ്, ശേലാഹ്,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> ഏബെർ, പെലെഗ്, രെഉ,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> സെരൂഗ്, നാഹോർ, തെരഹ്,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> അബ്രാം, അവനാണ് അബ്രാഹാം എന്നും അറിയപ്പെടുന്നത്."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> അബ്രാഹാമിന്റെ പുത്രന്മാർ:",
                "> യിസ്ഹാക്ക്, യിശ്മായേൽ."
            ]
        },
        {
            "verse": 29,
            "text": [
                "ഇവരുടെ തലമുറകൾ:",
                "> യിശ്മായേലിന്റെ ആദ്യജാതൻ നെബായോത്ത്, പിന്നെ കെദാർ, അബ്ദേൽ, മിബ്സാം,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "മിശ്മാ, ദൂമാ, മസ്സാ, ഹദാദ്, തേമാ,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "യതൂർ, നാഫിഷ്, കെദേമാ.",
                "ഇവരൊക്കെയും യിശ്മായേലിന്റെ സന്തതികളാണ്."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "അബ്രാഹാമിന്റെ ദാസിയായ കെതൂരയുടെ പുത്രന്മാർ, അവൾ പ്രസവിച്ചവർ:",
                "> സിംറാൻ, യോക്ഷാൻ, മേദാൻ, മിദ്യാൻ, യിശ്ബാക്ക്, ശൂഹ.",
                "> യോക്ഷാന്റെ പുത്രന്മാർ:",
                "> ശെബാ, ദേദാൻ."
            ]
        },
        {
            "verse": 33,
            "text": [
                "മിദ്യാന്റെ പുത്രന്മാർ:",
                "> എഫാ, എഫെർ, ഹനോക്ക്, അബീദ, എൽദാ.",
                "> ഇവരൊക്കെയും കെതൂരയുടെ പുത്രന്മാരാണ്."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "അബ്രാഹാം യിസ്ഹാക്കിനെ ജനിപ്പിച്ചു.",
                "> യിസ്ഹാക്കിന്റെ പുത്രന്മാർ:",
                "> ഏശാവ്, യിസ്രായേൽ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "ഏശാവിന്റെ പുത്രന്മാർ:",
                "> എലീഫാസ്, രെഉവേൽ, യെഉശ്, യാലാം, കോരഹ്."
            ]
        },
        {
            "verse": 36,
            "text": [
                "എലീഫാസിന്റെ പുത്രന്മാർ:",
                "> തേമാൻ, ഓമാർ, സെഫീ, ഗാതാം, കെനാസ്, തിമ്നാ, അമാലേക്."
            ]
        },
        {
            "verse": 37,
            "text": [
                "രെഉവേലിന്റെ പുത്രന്മാർ:",
                "> നഹത്ത്, സെരഹ്, ശമ്മാ, മിസ്സാ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "സെയീറിന്റെ പുത്രന്മാർ:",
                "> ലോത്താൻ, ശോബാൽ, സിബെയോൻ, അനാ, ദിശോൻ, ഏസെർ, ദിശാൻ."
            ]
        },
        {
            "verse": 39,
            "text": [
                "ലോത്താന്റെ പുത്രന്മാർ:",
                "> ഹോരി, ഹോമാം; തിമ്നാ ലോത്താന്റെ സഹോദരിയായിരുന്നു."
            ]
        },
        {
            "verse": 40,
            "text": [
                "ശോബാലിന്റെ പുത്രന്മാർ:",
                "> അല്യാൻ, മനഹത്ത്, എബാൽ, ശെഫീ, ഓനാം.",
                "> സിബെയോന്റെ പുത്രന്മാർ:",
                "> അയ്യാ, അനാ."
            ]
        },
        {
            "verse": 41,
            "text": [
                "അനായുടെ പുത്രൻ:",
                "> ദിശോൻ.",
                "> ദിശോന്റെ പുത്രന്മാർ:",
                "> ഹംരാൻ, എശ്ബാൻ, ഇത്രാൻ, ചെരാൻ."
            ]
        },
        {
            "verse": 42,
            "text": [
                "ഏസെറിന്റെ പുത്രന്മാർ:",
                "> ബിൽഹാൻ, സാവാൻ, യാക്കാൻ.",
                "> ദിശാന്റെ പുത്രന്മാർ:",
                "> ഉസ്, ആരാൻ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "ഇസ്രായേല്യർക്കു മുമ്പ് എദോമിൽ രാജാവായിരുന്നവർ:",
                "ബെയോരിന്റെ മകൻ ബേല, അവന്റെ നഗരം ദിൻഹാബാ."
            ]
        },
        {
            "verse": 44,
            "text": [
                "ബേല മരിച്ചപ്പോൾ ബോസ്രയിൽ നിന്നുള്ള സെരഹിന്റെ മകൻ യോബാബ് അവനെ അനുസരിച്ചാണ് രാജാവായത്."
            ]
        },
        {
            "verse": 45,
            "text": [
                "യോബാബ് മരിച്ചപ്പോൾ, തെമാന്യരുടെ ദേശത്തിൽ നിന്നുള്ള ഹുഷാം രാജാവായി."
            ]
        },
        {
            "verse": 46,
            "text": [
                "ഹുഷാം മരിച്ചപ്പോൾ, മോവാബിലെ മിദ്യാനെ തോല്പിച്ച ബെദദിന്റെ മകൻ ഹദാദ്",
                "രാജാവായി; അവന്റെ നഗരം അവീത്."
            ]
        },
        {
            "verse": 47,
            "text": [
                "ഹദാദ് മരിച്ചപ്പോൾ, മസ്രേക്കയിൽ നിന്നുള്ള ശംലാ രാജാവായി."
            ]
        },
        {
            "verse": 48,
            "text": [
                "ശംലാ മരിച്ചപ്പോൾ, നദിക്കരികെയുള്ള രെഹോബോത്തിൽ നിന്നുള്ള ശൗൽ രാജാവായി."
            ]
        },
        {
            "verse": 49,
            "text": [
                "ശൗൽ മരിച്ചപ്പോൾ, അഖ്ബോരിന്റെ മകൻ ബാൽ-ഹാനാൻ രാജാവായി."
            ]
        },
        {
            "verse": 50,
            "text": [
                "ബാൽ-ഹാനാൻ മരിച്ചപ്പോൾ, ഹദാദ് രാജാവായി;",
                "അവന്റെ നഗരം പായ്,",
                "അവന്റെ ഭാര്യ മെഹെതബേൽ, മാത്രേദിന്റെ മകൾ, മെസഹാബിന്റെ മകൾ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "അവശേഷം ഹദാദ് മരിച്ചുപോയി.",
                "എദോമിലെ തലവന്മാർ:",
                "തലവൻ തിമ്നാ, തലവൻ അലിയ, തലവൻ യെഥെത്ത്,"
            ]
        },
        {
            "verse": 52,
            "text": [
                "തലവൻ ഒഹോലീബാമ, തലവൻ ഏലാ, തലവൻ പിനോൻ,"
            ]
        },
        {
            "verse": 53,
            "text": [
                "തലവൻ കെനാസ്, തലവൻ തേമാൻ, തലവൻ മിബ്സാർ,"
            ]
        },
        {
            "verse": 54,
            "text": [
                "തലവൻ മഗ്ദിയേൽ, തലവൻ ഇറാം.",
                "ഇവരൊക്കെയും എദോമിലെ തലവന്മാരാണ്."
            ]
        }
    ]
}