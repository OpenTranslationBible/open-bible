        {
            "verse": 35,
            "text": [
                "> സെനാഹയുടെ വംശം, 3,630 പേർ."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> പുരോഹിതന്മാർ: യേശ്വയുടെ വീട്ടിലെ യെദായയുടെ വംശം, 973 പേർ;"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> ഇമ്മേരിന്റെ വംശം, 1,052 പേർ;"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> പാശ്ഹൂറിന്റെ വംശം, 1,247 പേർ;"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> ഹാരിമിന്റെ വംശം, 1,017 പേർ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ലേവ്യർ: ഹോദവ്യയുടെ വംശത്തിൽ നിന്നുള്ള യേശ്വയുടെയും കദ്മീയേലിന്റെയും കുടുംബം, 74 പേർ."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> സംഗീതജ്ഞർ: ആസാഫിന്റെ കുടുംബം, 128 പേർ."
            ]
        },
        {
            "verse": 42,
            "text": [
                "ആലയത്തിലെ കവാടരക്ഷകർ:",
                "> ശല്ലൂം, ആറ്റേർ, തൽമോൻ,",
                "> അക്കൂബ്, ഹത്തീത, ശോബായി എന്നിവരുടെ വംശം, 139 പേർ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "ആലയത്തിലെ സേവകർ:",
                "> സീഹ, ഹസൂഫ, തബ്ബാവോത്ത് എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> കെറോസ്, സിയാഹ, പാദോൻ എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> ലെബാന, ഹഗാബ, അക്കൂബ് എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> ഹഗാബ, ശൽമായ്, ഹാനാൻ എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> ഗിദ്ദേൽ, ഗഹാർ, രെയായാ എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> റെസീൻ, നെക്കോഡ, ഗസ്സാം എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> ഉസ്സാ, പസേഹ, ബേസായ് എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> അസ്നാ, മെഉനീം, നെഫൂസീം എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 51,
            "text": [
                "> ബക്ബൂക്, ഹകൂഫ, ഹർഹൂർ എന്നിവരുടെ വംശം,"
            ]
        },
        {
            "verse": 52,
            "text": [
