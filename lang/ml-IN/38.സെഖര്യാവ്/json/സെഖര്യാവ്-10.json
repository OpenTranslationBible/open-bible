{
    "book": "സെഖര്യാവിന്റെ പുസ്തകം",
    "chapter": 10,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> വേനൽക്കാലത്ത് കർത്താവിനോടു മഴ ചോദിപ്പിൻ—",
                "> കൊടുങ്കാറ്റുകൾ സൃഷ്ടിക്കുന്ന കർത്താവിനോടു;",
                "> അവൻ അവർക്കു മഴയുടെ ചാറ്റൽ നൽകും,",
                "> ഓരോരുത്തർക്കും വയലിൽ സസ്യങ്ങൾ നൽകും."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> തെരാഫീം വഞ്ചന സംസാരിക്കുന്നു,",
                "> ഭാവിഷ്യവാദികൾ മായാജാലം കാണുന്നു",
                "> വഞ്ചനാപൂർണ്ണ സ്വപ്നങ്ങൾ പറയുന്നു;",
                "> അവർ വ്യർത്ഥമായി ആശ്വസിപ്പിക്കുന്നു.",
                "> അതുകൊണ്ടു ജനങ്ങൾ ആടുകളെപ്പോലെ അലഞ്ഞു തിരിയുന്നു,",
                "> മേയ്പ്പൻ ഇല്ലാത്തതിനാൽ അവർ കഷ്ടപ്പെടുന്നു."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> “മേയ്പ്പന്മാരെക്കുറിച്ച് എന്റെ കോപം ജ്വലിക്കുന്നു,",
                "> ഞാൻ ആൺ കോലുകളെ ശിക്ഷിക്കും;",
                "> സൈന്യങ്ങളുടെ കർത്താവായ കർത്താവു തന്റെ ആട്ടിൻ കൂട്ടമായ യെഹൂദാഗൃഹത്തെ സന്ദർശിച്ചു,",
                "> യുദ്ധത്തിലെ തന്റെ മഹത്തായ കുതിരയെപ്പോലെ അവരെ മാറ്റും."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> അവരിൽ നിന്നു കോണുകല്ല് ഉയരും,",
                "> അവരിൽ നിന്നു കൂടാരത്തിന്റെ കൂൺ,",
                "> അവരിൽ നിന്നു യുദ്ധവില്ല്,",
                "> അവരിൽ നിന്നു എല്ലാ ഭരണാധികാരിയും, എല്ലാവരും ഒരുമിച്ച്."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> അവർ യോദ്ധാക്കളെപ്പോലെ ആയിരിക്കും,",
                "> യുദ്ധത്തിൽ തെരുവിലെ ചളിയിൽ ശത്രുവിനെ ചവിട്ടിക്കൊള്ളും;",
                "> അവർ യുദ്ധം ചെയ്യും, കാരണം കർത്താവ് അവരോടുകൂടെ ഉണ്ടാകും;",
                "> കുതിരപ്പുറത്തുള്ള സവാരികൾ ലജ്ജിക്കും."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ഞാൻ യെഹൂദാഗൃഹത്തെ ശക്തിപ്പെടുത്തും,",
                "> ഞാൻ യോസേഫിന്റെ ഗൃഹത്തെ രക്ഷിക്കും,",
                "> ഞാൻ അവരെ പുനഃസ്ഥാപിക്കും,",
                "> ഞാൻ അവരോടു കരുണ കാണിച്ചിരിക്കുന്നു;",
                "> ഞാൻ അവരെ തള്ളിക്കളഞ്ഞിട്ടില്ലാത്തതുപോലെ അവർ ആയിരിക്കും,",
                "> ഞാൻ അവരുടെ ദൈവമായ കർത്താവാണ്, ഞാൻ അവർക്കു പ്രതികരിക്കും."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> എഫ്രയീം യോദ്ധാവിനെപ്പോലെ ആയിരിക്കും,",
                "> അവരുടെ ഹൃദയം വീഞ്ഞുപോലെ സന്തോഷിക്കും;",
                "> അവരുടെ മക്കൾ അതു കണ്ടു സന്തോഷിക്കും,",
                "> അവരുടെ ഹൃദയം കർത്താവിൽ ആനന്ദിക്കും."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ഞാൻ അവരെ വിളിച്ചു കൂട്ടും,",
                "> ഞാൻ അവരെ വീണ്ടെടുത്തിരിക്കുന്നു;",
                "> അവർ മുമ്പത്തെപ്പോലെ അനേകം ആയിരിക്കും."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ഞാൻ അവരെ ജനങ്ങളിൽ ചിതറുമ്പോൾ,",
                "> അവർ ദൂരദേശങ്ങളിൽ എന്നെ ഓർക്കും,",
                "> അവരും അവരുടെ മക്കളും ജീവിക്കും, മടങ്ങിവരും."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ഞാൻ അവരെ മിസ്രയീംദേശത്തുനിന്നു തിരികെ കൊണ്ടുവരും",
                "> അശ്ശൂർദേശത്തുനിന്നു അവരെ കൂട്ടിച്ചേർക്കും;",
                "> ഞാൻ അവരെ ഗിലെയാദ് ലെബാനോൻ ദേശത്തേക്കു കൊണ്ടുവരും",
                "> അവർക്കു സ്ഥലം കിട്ടാതെ വരും."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> അവർ കഷ്ടതയുടെ കടലിലൂടെ കടന്നുപോകും,",
                "> അവൻ കടലിലെ തരംഗങ്ങളെ അടിക്കും",
                "> നൈൽ നദിയുടെ ആഴങ്ങൾ ഉണങ്ങിപ്പോകും;",
                "> അശ്ശൂർദേശത്തിന്റെ അഹങ്കാരം താഴ്ത്തപ്പെടും,",
                "> മിസ്രയീംദേശത്തിന്റെ ചെങ്കോൽ നീങ്ങിപ്പോകും."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ഞാൻ അവരെ കർത്താവിൽ ശക്തിപ്പെടുത്തും,",
                "> അവൻ്റെ നാമത്തിൽ അവർ നടക്കും,” കർത്താവിന്റെ അരുളപ്പാടു."
            ]
        }
    ]
}