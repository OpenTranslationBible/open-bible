            ]
        },
        {
            "verse": 37,
            "text": [
                "> ലോദിന്റെയും ഹദീദിന്റെയും ഓനോയുടെ ജനങ്ങൾ, 721 പേർ;"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> സെനാഹയുടെ വംശം, 3,930 പേർ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "ആരോന്മാരും:",
                "> യെദായയുടെ വംശം, യേശുവയുടെ ഗൃഹം, 973 പേർ;"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ഇമ്മേരിന്റെ വംശം, 1,052 പേർ;"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> പാശ്ഹൂരിന്റെ വംശം, 1,247 പേർ;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> ഹാരീമിന്റെ വംശം, 1,017 പേർ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "ലേവ്യരും:",
                "> യേശുവയുടെ വംശം, കട്മീയേലിന്റെ വഴി, ഹോദവയുടെ വഴി, 74 പേർ."
            ]
        },
        {
            "verse": 44,
            "text": [
                "ഗായകരും:",
                "> ആസാഫിന്റെ വംശം, 148 പേർ."
            ]
        },
        {
            "verse": 45,
            "text": [
                "വാതിൽകാക്കന്മാരും:",
                "> ശല്ലൂം, അതേർ, തൽമോൻ, അക്കൂബ്,",
                "> ഹത്തീത, ശോബായി, 138 പേർ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "ആലയ ദാസന്മാർ:",
                "സീഹ, ഹസൂഫ, തബ്ബാവോത്ത്,"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> കെറോസ്, സിയ, പാദോൻ,"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> ലെബാനാ, ഹഗാബാ, ശൽമായ്,"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> ഹാനാൻ, ഗിദ്ദേൽ, ഗഹാർ,"
            ]
        },
        {
            "verse": 50,
            "text": [
                "> രെയായ, റെസീൻ, നെക്കോഡാ,"
            ]
        },
        {
            "verse": 51,
            "text": [
                "> ഗസ്സാം, ഉസ്സാ, പസേയാ,"
            ]
        },
        {
            "verse": 52,
            "text": [
                "> ബേസായ്, മെഉനീം, ആലയ ദാസൻ നെഫുഷേസീം,"
            ]
        },
        {
            "verse": 53,
            "text": [
                "> ബക്ബൂക്ക്, ഹകൂഫ, ഹാർഹൂർ,"
