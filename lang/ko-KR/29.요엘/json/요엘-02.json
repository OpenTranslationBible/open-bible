{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 시온에서 나팔을 불어라;",
                "> 나의 거룩한 산에서 경고를 울려라.",
                "> 이 땅의 모든 주민이 떨게 하라,",
                "> 주의 날이 오고 있으니;",
                "> 참으로, 그것은 가까이 있다—"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 어둠과 우울의 날,",
                "> 구름과 짙은 어둠의 날.",
                "> 새벽이 산 위로 퍼지듯이,",
                "> 크고 강한 백성이 일어난다;",
                "> 그와 같은 것은 없었고,",
                "> 많은 세대 동안 다시는 없을 것이다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 그들 앞에서는 불이 삼키고,",
                "> 그들 뒤에서는 불길이 삼킨다.",
                "> 그들 앞의 땅은 에덴 동산 같으나,",
                "> 그들 뒤는 황폐한 광야이다",
                "> —아무것도 그들에게서 벗어나지 못한다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그들의 모습은 말과 같고;",
                "> 그들은 전쟁 말처럼 달린다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 병거 같은 소리로,",
                "> 그들은 산꼭대기를 뛰어넘는다,",
                "> 그루터기를 삼키는 불꽃의 소리처럼,",
                "> 전투를 위해 배치된 강한 군대처럼."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그들 앞에서, 민족들이 괴로워하고;",
                "> 모든 얼굴이 창백해진다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그들은 전사처럼 돌진하고,",
                "> 군인처럼 벽을 오르며.",
                "> 각자 줄을 맞추어 행진하고,",
                "> 그들의 길에서 벗어나지 않는다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그들은 서로 밀치지 않고;",
                "> 각자 똑바로 나아간다.",
                "> 그들은 방어선을 뚫고 나아가며",
                "> 대열을 깨뜨리지 않는다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그들은 성을 습격하고,",
                "> 벽을 따라 달리며;",
                "> 집으로 들어가고,",
                "> 도둑처럼 창문을 통해 들어간다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그들 앞에서 땅이 흔들리고,",
                "> 하늘이 떨며,",
                "> 해와 달이 어두워지고,",
                "> 별들이 그 빛을 잃는다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 주께서 그의 군대의 선두에서 천둥을 치신다;",
                "> 그의 진영은 매우 크고,",
                "> 그의 말씀을 실행하는 자는 강하다.",
                "> 주의 날은 크고 매우 두려우니;",
                "> 누가 그것을 견딜 수 있겠는가?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"그러나 지금이라도,\" 주께서 말씀하신다,",
                "> \"너희의 온 마음으로 내게 돌아오라,",
                "> 금식과 울음과 애통함으로.\""
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 너희의 마음을 찢고 옷을 찢지 말라.",
                "> 너희 하나님 여호와께 돌아오라,",
                "> 그는 은혜롭고 자비로우며,",
                "> 노하기를 더디하고 사랑이 풍성하며,",
                "> 재앙을 내리기를 그치신다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 누가 알겠는가? 그가 돌이켜 후회하고",
                "> 뒤에 복을 남겨두실지",
                "> —곡식 제물과 전제물로",
                "> 너희 하나님 여호와께 드릴 것이다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 시온에서 나팔을 불어라,",
                "> 금식을 성별하고,",
                "> 거룩한 모임을 소집하라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 백성을 모으고,",
                "> 회중을 성별하라;",
                "> 장로들을 모으고,",
                "> 아이들과 젖먹이들을 모으라.",
                "> 신랑은 그의 방을 떠나고",
                "> 신부는 그녀의 방을 떠나게 하라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 주 앞에서 섬기는 제사장들이",
                "> 현관과 제단 사이에서 울게 하라.",
                "> 그들이 말하게 하라,",
                "> \"주여, 주의 백성을 아끼소서.",
                "> 주의 유산을 수치와",
                "> 민족들 사이의 속담이 되지 않게 하소서.",
                "> 왜 그들이 백성들 사이에서 말하게 하시겠습니까,",
                "> '그들의 하나님이 어디 있느냐?'\""
            ]
        },
        {
            "verse": 18,
            "text": [
                "그때 주께서 그의 땅을 위해 열정을 가지시고 그의 백성에게 자비를 베푸셨다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "주께서 그의 백성에게 대답하셨다:",
                "> \"내가 너희에게 곡식과 새 포도주와 기름을 보내리니,",
                "> 너희를 충분히 만족하게 하리라;",
                "> 다시는 너희를 민족들 사이에서 수치가 되지 않게 하리라."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> \"내가 북쪽의 군대를 너희에게서 멀리 몰아내고,",
                "> 그것을 메마르고 황폐한 땅으로 몰아내리라;",
                "> 그 선봉은 동쪽 바다로,",
                "> 그 후미는 서쪽 바다로 몰아내리라.",
                "> 그 악취가 올라오고, 그 냄새가 올라오리라.\"",
                "> 확실히 그가 큰 일을 행하셨다!"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 유다의 땅아, 두려워하지 말라;",
                "> 기뻐하고 즐거워하라,",
                "> 주께서 큰 일을 행하셨다!"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 들의 짐승들아, 두려워하지 말라,",
                "> 광야의 초장이 푸르러지고 있다.",
                "> 나무들이 그 열매를 맺고;",
                "> 무화과나무와 포도나무가 그 풍요를 내리라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 시온의 백성들아, 기뻐하라,",
                "> 너희 하나님 여호와 안에서 즐거워하라,",
                "> 그가 그의 신실함으로 너희에게 이른 비를 주셨다.",
                "> 그가 너희에게 풍성한 소나기를 보내시리니,",
                "> 이른 비와 늦은 비가 예전처럼 내리리라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 타작마당은 곡식으로 가득 차고;",
                "> 포도즙 틀은 새 포도주와 기름으로 넘치리라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> \"내가 너희에게 갚아주리니",
                "> 메뚜기가 먹어 치운 해들—큰 메뚜기,",
                "> 어린 메뚜기, 다른 메뚜기, 그리고 메뚜기 떼",
                "> —내가 너희 가운데 보낸 나의 큰 군대."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 너희는 먹을 것이 풍부하여 배부를 것이며,",
                "> 너희 하나님 여호와의 이름을 찬양하리니,",
                "> 그가 너희를 위해 기이한 일을 행하셨다;",
                "> 다시는 내 백성이 수치를 당하지 않으리라."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그때 너희는 내가 이스라엘 가운데 있음을 알리라,",
                "> 내가 너희 하나님 여호와임을 알리라,",
                "> 다른 이가 없음을 알리라;",
                "> 다시는 내 백성이 수치를 당하지 않으리라."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> \"그 후에,",
                "> 내가 내 영을 모든 백성에게 부어주리니.",
                "> 너희의 아들들과 딸들이 예언할 것이며,",
                "> 너희의 늙은이들이 꿈을 꾸며,",
                "> 너희의 젊은이들이 환상을 보리라."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 심지어 내 종들, 남녀 모두에게도,",
                "> 그 날들에 내가 내 영을 부어주리라."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 내가 하늘과 땅에 기이한 일을 보이리니,",
                "> 피와 불과 연기 기둥이라."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 해가 어두워지고",
                "> 달이 피로 변하기 전에",
                "> 주의 크고 두려운 날이 오리라."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 주의 이름을 부르는 모든 자는",
                "> 구원을 받으리니;",
                "> 시온 산과 예루살렘에",
                "> 구원이 있으리라,",
                "> 주께서 말씀하신 대로,",
                "> 주께서 부르시는 생존자들 가운데서도."
            ]
        }
    ]
}