{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "여호와의 말씀이 브두엘의 아들 요엘에게 임하였느니라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 늙은 자들아, 이것을 들으라.",
                "> 땅에 사는 모든 사람들아, 귀를 기울이라.",
                "> 너희의 날이나 너희 조상들의 날에",
                "> 이런 일이 있었느냐?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 이것을 너희 자녀들에게 말하라.",
                "> 그들이 그들의 자녀들에게 말하게 하라.",
                "> 그들의 자손이 다음 세대에게 말하게 하라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 남은 것을 메뚜기가 먹고,",
                "> 메뚜기가 남긴 것을 느치가 먹고,",
                "> 느치가 남긴 것을 황충이 먹었도다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 깨어라, 술 취한 자들아, 울어라!",
                "> 포도주를 마시는 모든 자들아, 통곡하라.",
                "> 단 포도주가 너희 입에서 끊어졌음이라."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 한 민족이 내 땅에 올라왔으니,",
                "> 강하고 수가 많으며,",
                "> 사자의 이빨과 암사자의 어금니를 가졌도다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그가 내 포도나무를 황폐하게 하고",
                "> 내 무화과나무를 꺾어 버렸으며,",
                "> 그 껍질을 벗겨서 버렸으니,",
                "> 그 가지들이 희어졌도다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 젊은 시절의 남편을 위하여",
                "> 굵은 베옷을 입고 슬퍼하는 처녀처럼 애곡하라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 소제와 전제가 여호와의 집에서 끊어졌고,",
                "> 여호와께 수종드는 제사장들이 슬퍼하도다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 밭이 황폐하고,",
                "> 땅이 애통하니,",
                "> 곡식이 파괴되고,",
                "> 새 포도주가 말랐으며,",
                "> 기름이 떨어졌음이라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 농부들아, 수치를 당하라.",
                "> 포도원을 가꾸는 자들아, 울어라.",
                "> 밀과 보리로 인하여,",
                "> 밭의 수확이 망하였음이라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 포도나무가 말랐고,",
                "> 무화과나무가 시들었으며,",
                "> 석류나무와 종려나무와 사과나무,",
                "> 밭의 모든 나무가 말랐도다.",
                "> 참으로 사람의 기쁨이 시들었도다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 제사장들아, 굵은 베옷을 입고 슬퍼하라.",
                "> 제단에서 수종드는 자들아, 울어라.",
                "> 내 하나님께 수종드는 자들아,",
                "> 와서 굵은 베옷을 입고 밤을 지내라.",
                "> 소제와 전제가 너희 하나님의 집에서 끊어졌음이라."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 금식을 선포하고,",
                "> 성회를 소집하라.",
                "> 장로들과 땅에 사는 모든 사람들을",
                "> 너희 하나님의 여호와의 집으로 모으고,",
                "> 여호와께 부르짖으라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 슬프다, 그 날이여!",
                "> 여호와의 날이 가까웠으니,",
                "> 전능자에게서 멸망이 임하리로다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 우리의 눈앞에서 양식이 끊어지지 아니하였느냐,",
                "> 우리 하나님의 집에서 기쁨과 즐거움이 끊어지지 아니하였느냐?"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 씨가 흙덩이 아래에서 말랐고,",
                "> 창고가 황폐하였으며,",
                "> 곡간이 무너졌으니,",
                "> 곡식이 말랐음이라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 가축들이 탄식하도다!",
                "> 소 떼가 방황하니,",
                "> 그들이 초장이 없기 때문이라.",
                "> 양 떼도 고통을 받는도다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 여호와여, 내가 주께 부르짖나이다.",
                "> 불이 광야의 초장을 삼켰고,",
                "> 불꽃이 밭의 모든 나무를 태웠나이다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 들짐승들도 주를 향하여 헐떡이오니,",
                "> 시냇물이 말랐고,",
                "> 불이 광야의 초장을 삼켰음이니이다."
            ]
        }
    ]
}