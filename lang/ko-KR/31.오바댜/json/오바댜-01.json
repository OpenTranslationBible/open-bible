{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "오바댜의 환상.",
                "주 여호와께서 에돔에 대하여 이같이 말씀하시니라—",
                "> 우리가 여호와로부터 소식을 들었고,",
                "> 사자가 나라들 가운데 보내졌으니 이르기를,",
                "> \"일어나서 우리가 그녀를 대적하여 싸우자\" 하였느니라—"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"보라, 내가 너를 나라들 가운데에서 작게 만들리니;",
                "> 네가 크게 멸시를 받으리라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 네 마음의 교만이 너를 속였도다,",
                "> 바위 틈에 거주하며,",
                "> 높은 곳에 사는 자여,",
                "> 네 마음에 이르기를,",
                "> '누가 나를 땅으로 끌어내리겠느냐?' 하는 자여."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 네가 독수리처럼 높이 둥지를 틀고,",
                "> 별들 사이에 그것을 두더라도,",
                "> 거기서 내가 너를 끌어내리리라,\" 여호와의 말씀이니라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> \"도둑이 네게 이르렀다면,",
                "> 밤에 강도들이 왔다면—",
                "> 오, 네가 어떻게 망하였는고!—",
                "> 그들이 만족할 때까지만 훔치지 아니하겠느냐?",
                "> 포도 따는 자들이 네게 이르렀다면,",
                "> 그들이 얼마간의 이삭을 남기지 아니하겠느냐?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 오, 에서가 어떻게 수색되었으며,",
                "> 그의 숨겨진 보물들이 약탈되었는고!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 너와 동맹한 모든 사람들이",
                "> 너를 국경으로 보낼 것이며,",
                "> 너와 평화로운 사람들이",
                "> 너를 속이고 이길 것이며,",
                "> 네 빵을 먹는 자들이",
                "> 너를 위한 매복을 설치하리라.",
                "> (그에게는 이해가 없도다.)"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그 날에,\" 여호와의 말씀이니라,",
                "> \"내가 에돔에서 지혜로운 자들을 제거하며,",
                "> 에서의 산에서 이해를 제거하리라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그때에 네 용사들이 두려워하리라, 데만이여,",
                "> 그래서 모든 사람이",
                "> 에서의 산에서 살해로 제거되리라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 네 형제 야곱에게 행한 폭력 때문에,",
                "> 수치가 너를 덮을 것이며,",
                "> 네가 영원히 끊어지리라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 네가 멀리 서 있던 날에,",
                "> 낯선 자들이 그의 재물을 가져갔던 날에,",
                "> 외국인들이 그의 성문에 들어가",
                "> 예루살렘을 위하여 제비를 뽑았던 날에—",
                "> 너도 그들 중 하나였느니라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 네 형제의 날에 기뻐하지 말지니,",
                "> 그의 재앙의 날에.",
                "> 유다 자손의 멸망의 날에 기뻐하지 말지니,",
                "> 그렇다, 그들의 고난의 날에",
                "> 자랑하지 말지니라."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 내 백성의 성문에 들어가지 말지니,",
                "> 그들의 재앙의 날에.",
                "> 그렇다, 너는 그들의 재앙의 날에",
                "> 그들의 고난을 기뻐하지 말지니,",
                "> 그들의 재앙의 날에",
                "> 그들의 재물을 약탈하지 말지니라."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 교차로에 서지 말지니,",
                "> 그들의 생존자를 베어버리려 하며;",
                "> 그들의 피난민을 넘기지 말지니,",
                "> 그들의 고난의 날에."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 여호와의 날이 가까웠으니",
                "> 모든 나라를 위하여!",
                "> 네가 행한 대로, 그것이 네게 행해질 것이며,",
                "> 네 행위가 네 머리 위로 돌아오리라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 네가 내 거룩한 산에서 마신 것처럼,",
                "> 모든 나라가 계속해서 마시리라.",
                "> 그들이 마시고 삼키며,",
                "> 그들이 존재하지 않았던 것처럼 되리라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그러나 시온 산에는 피할 자들이 있으리니,",
                "> 그것이 거룩하리라.",
                "> 야곱의 집이 그들의 소유를 차지하리라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그때에 야곱의 집은 불이 되며,",
                "> 요셉의 집은 불꽃이 되리라;",
                "> 그러나 에서의 집은 지푸라기가 되리라.",
                "> 그들이 그들을 불태워 소멸시키리니,",
                "> 에서의 집에 남은 자가 없으리라,\"",
                "> 여호와께서 말씀하셨느니라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그때에 네게브의 사람들이 에서의 산을 차지하며,",
                "> 스펠라의 사람들은 블레셋 평야를 차지하리라;",
                "> 그들이 또한 에브라임의 영토와 사마리아의 영토를 차지하리니,",
                "> 베냐민은 길르앗을 차지하리라."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 이스라엘 자손의 군대의 포로들이,",
                "> 사르밧까지 가나안 사람들 가운데 있는 자들이,",
                "> 스파라드에 있는 예루살렘의 포로들이,",
                "> 네게브의 도시들을 차지하리라."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 구원자들이 시온 산에 올라가",
                "> 에서의 산을 심판하리니,",
                "> 그 왕국이 여호와께 속하리라."
            ]
        }
    ]
}