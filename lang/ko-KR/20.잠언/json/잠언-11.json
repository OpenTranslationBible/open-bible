{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "여호와는 거짓 저울을 미워하시나, 정확한 추는 그의 기쁨이니라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "교만이 오면 수치도 오거니와, 겸손한 자에게는 지혜가 있느니라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "정직한 자의 성실함은 그들을 인도하고, 배신자의 간사함은 그들을 멸망에 이르게 하느니라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "진노의 날에 재물은 무익하나, 의는 죽음에서 건지느니라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "완전한 자의 의는 그의 길을 곧게 하거니와, 악인은 자기의 악으로 넘어지느니라."
            ]
        },
        {
            "verse": 6,
            "text": [
                "정직한 자의 의는 그들을 구원하나, 배신자는 자기의 탐욕에 걸리느니라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "악인이 죽을 때 그의 소망이 끊어지고, 그의 힘의 기대도 사라지느니라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "의인은 환난에서 구원을 받고, 그 환난이 악인에게 임하느니라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "경건치 않은 자는 그의 입으로 이웃을 망하게 하나, 의인은 지식으로 구원을 얻느니라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "의인이 형통하면 성읍이 즐거워하고, 악인이 멸망하면 기뻐 외치느니라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "정직한 자의 축복으로 성읍이 높아지고, 악인의 입으로 말미암아 무너지느니라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "이웃을 멸시하는 자는 지혜가 없고, 명철한 자는 잠잠하느니라."
            ]
        },
        {
            "verse": 13,
            "text": [
                "험담하는 자는 비밀을 누설하나, 신실한 자는 이를 숨기느니라."
            ]
        },
        {
            "verse": 14,
            "text": [
                "지도가 없으면 백성이 넘어지나, 지략이 많으면 승리가 있느니라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "타인을 보증하는 자는 해를 입거니와, 보증을 피하는 자는 안전하니라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "은혜로운 여자는 존귀를 얻고, 강포한 남자는 재물만 얻느니라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "자비로운 자는 자기의 영혼을 이롭게 하고, 잔인한 자는 자기의 몸을 해롭게 하느니라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "악인은 허무한 삯을 얻으나, 의를 뿌리는 자는 참된 상을 받느니라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "의에 굳게 선 자는 생명을 얻고, 악을 따르는 자는 사망에 이르느니라."
            ]
        },
        {
            "verse": 20,
            "text": [
                "여호와는 마음이 비뚤어진 자를 미워하시나, 행위가 완전한 자를 기뻐하시느니라."
            ]
        },
        {
            "verse": 21,
            "text": [
                "악인은 형벌을 면하지 못하리라, 의인의 자손은 구원을 얻으리라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "돼지 코에 금고리 같으니, 아름다운 여인이 삼가지 아니함이니라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "의인의 소원은 오직 선하나, 악인의 기대는 진노를 이루느니라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "흩어 구제하여도 더욱 부하게 되는 일이 있고, 과도히 아껴도 가난하게 될 뿐이니라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "구제를 좋아하는 자는 풍족해질 것이요, 남을 윤택하게 하는 자는 자기도 윤택해지리라."
            ]
        },
        {
            "verse": 26,
            "text": [
                "곡식을 저축하는 자는 백성이 저주할 것이나, 파는 자는 그 머리에 복이 임하리라."
            ]
        },
        {
            "verse": 27,
            "text": [
                "선을 간절히 구하는 자는 은총을 얻으려니와, 악을 찾는 자에게는 악이 임하리라."
            ]
        },
        {
            "verse": 28,
            "text": [
                "자기의 재물을 의지하는 자는 넘어지려니와, 의인은 푸른 잎사귀 같이 번성하리라."
            ]
        },
        {
            "verse": 29,
            "text": [
                "자기 집을 해롭게 하는 자는 바람을 기업으로 얻고, 미련한 자는 마음이 지혜로운 자의 종이 되리라."
            ]
        },
        {
            "verse": 30,
            "text": [
                "의인의 열매는 생명 나무라, 지혜로운 자는 사람을 얻느니라."
            ]
        },
        {
            "verse": 31,
            "text": [
                "보라, 의인이라도 땅에서 보응을 받겠거든, 하물며 악인과 죄인이리요!"
            ]
        }
    ]
}