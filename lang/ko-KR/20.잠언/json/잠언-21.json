{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "왕의 마음은 주님의 손에 있는 물길과 같아서, 주님께서 원하시는 대로 이끄신다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "사람의 길은 자기 눈에 옳게 보일지라도, 주님께서는 마음을 평가하신다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "의와 공의를 행하는 것이 제사보다 주님께 더 바람직하다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "거만한 눈과 교만한 마음, 악인의 등불은 죄악이다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "부지런한 자의 계획은 반드시 이익을 가져오지만, 성급한 자는 가난에 이른다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "거짓된 혀로 재물을 얻는 것은 덧없는 안개와 치명적인 덫이다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "악인의 폭력은 그들을 휩쓸어 가리니, 그들이 공의를 행하기를 거부하기 때문이다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "유죄자의 길은 비뚤어졌으나, 순결한 자의 행위는 곧다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "다투는 여인과 함께 집을 공유하는 것보다 지붕의 한 모퉁이에 사는 것이 낫다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "악인의 영혼은 악을 원하며, 그들은 이웃에게 자비를 베풀지 않는다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "조롱하는 자가 벌을 받을 때, 단순한 자는 지혜를 얻고, 지혜로운 자가 훈계를 받을 때, 지식을 얻는다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "의로우신 이는 악인의 집을 살피시고 그들을 멸망으로 이끄신다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "가난한 자의 부르짖음에 귀를 닫는 자는 또한 부르짖을 것이나 응답받지 못할 것이다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "은밀히 주는 선물은 분노를 가라앉히고, 옷 속에 숨긴 뇌물은 강한 분노를 달랜다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "정의를 실행하는 것은 의인에게 기쁨을 주지만, 악을 행하는 자에게는 두려움을 준다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "이해의 길에서 벗어난 자는 죽은 자의 무리에 머물 것이다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "쾌락을 사랑하는 자는 가난해질 것이며, 포도주와 기름을 사랑하는 자는 부유해지지 못할 것이다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "악인은 의인을 위한 대속물이 되고, 배신자는 정직한 자를 위한 대속물이 된다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "다투고 성급한 여인과 함께 사는 것보다 광야에 사는 것이 낫다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "지혜로운 자는 귀한 보물과 기름을 쌓아두지만, 어리석은 자는 그것을 다 소비한다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "의와 사랑을 구하는 자는 생명과 번영과 명예를 발견한다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "지혜로운 자는 강한 자의 도시를 오르고 그들이 신뢰하는 요새를 무너뜨릴 수 있다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "입과 혀를 지키는 자는 자신을 재앙에서 보호한다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "거만하고 오만한 자, \"조롱자\"로 알려진 자는 무례한 교만으로 행동한다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "게으른 자의 욕망은 그의 몰락이 될 것이니, 그의 손이 일하기를 거부하기 때문이다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "그는 하루 종일 갈망하지만, 의인은 아낌없이 후하게 준다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "악인의 제사는 가증하며, 악한 의도로 드릴 때는 더욱 그렇다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "거짓 증인은 멸망할 것이나, 듣는 자는 오래도록 말할 것이다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "악인은 대담한 얼굴을 하지만, 정직한 자는 자신의 길을 신중히 생각한다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "주님을 대적할 수 있는 지혜도, 이해도, 계획도 없다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "말은 전쟁의 날을 위해 준비되지만, 승리는 주님께 있다."
            ]
        }
    ]
}