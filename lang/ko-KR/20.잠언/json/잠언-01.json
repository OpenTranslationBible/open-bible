{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "다윗의 아들, 이스라엘의 통치자 솔로몬의 지혜로운 말들:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "지혜와 훈계를 얻고, 명철의 말씀을 분별하게 하려 함이라;"
            ]
        },
        {
            "verse": 3,
            "text": [
                "지혜로운 행실과 의와 정의와 공평의 훈계를 받게 하려 하며;"
            ]
        },
        {
            "verse": 4,
            "text": [
                "어리석은 자에게 슬기를 주고, 젊은 자에게 지식과 분별력을 주기 위함이라;"
            ]
        },
        {
            "verse": 5,
            "text": [
                "지혜로운 자는 듣고 학식을 더할 것이요, 명철한 자는 지략을 얻을 것이라,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "잠언과 비유와 지혜로운 자의 말과 그들의 수수께끼를 깨달으리라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "여호와를 경외하는 것이 지식의 시작이거늘, 미련한 자는 지혜와 훈계를 멸시하느니라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "내 아들아, 네 아버지의 훈계를 들으며, 네 어머니의 법을 버리지 말라;"
            ]
        },
        {
            "verse": 9,
            "text": [
                "이는 네 머리의 아름다운 관이요, 네 목의 장식이니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "내 아들아, 죄인이 너를 유혹할지라도 따르지 말라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "그들이 말하기를 “우리와 함께 가자,",
                "> 우리가 피를 엿보며,",
                "> 까닭 없이 무죄한 자를 숨어 기다리자;"
            ]
        },
        {
            "verse": 12,
            "text": [
                "우리가 그들을 산 채로 삼키자, 무덤처럼,",
                "> 온전히 삼키자, 구덩이로 내려가는 자들처럼;"
            ]
        },
        {
            "verse": 13,
            "text": [
                "우리가 온갖 귀한 물건을 얻으며,",
                "> 우리의 집을 탈취물로 채우리라;"
            ]
        },
        {
            "verse": 14,
            "text": [
                "너는 우리와 함께 제비를 뽑고,",
                "> 우리가 함께 한 주머니를 쓰자” 하거든—"
            ]
        },
        {
            "verse": 15,
            "text": [
                "내 아들아, 그들의 길에 다니지 말며, 네 발을 그들의 길에서 멀리하라,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "그들은 악을 행하기에 빠르고, 피를 흘리기에 신속함이라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "새들이 보는 앞에서 그물을 치는 것이 어찌 헛되리요!"
            ]
        },
        {
            "verse": 18,
            "text": [
                "그들은 자기의 피를 엿보며, 자기의 생명을 숨어 기다리느니라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "불의한 이익을 탐하는 모든 자의 길은 이러하여, 그 소유자의 생명을 빼앗느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "지혜가 길거리에서 외치며, 광장에서 소리를 높이며;"
            ]
        },
        {
            "verse": 21,
            "text": [
                "번화한 거리 머리에서 외치며, 성문 어귀에서 그 소리를 발하니라:"
            ]
        },
        {
            "verse": 22,
            "text": [
                "“어리석은 자들아, 너희가 어리석음을 사랑하며 언제까지 하겠느냐?",
                "> 비웃는 자들이 비웃기를 기뻐하며",
                "> 미련한 자들이 지식을 미워하겠느냐?"
            ]
        },
        {
            "verse": 23,
            "text": [
                "나의 책망을 듣고 돌이키라!",
                "> 보라, 내가 나의 영을 너희에게 부어 주며,",
                "> 나의 말을 너희에게 알리리라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "내가 불렀으나 너희가 듣지 아니하였고, 내가 손을 펴었으나 돌아보는 자가 없었으며;"
            ]
        },
        {
            "verse": 25,
            "text": [
                "너희가 나의 모든 교훈을 무시하며",
                "나의 책망을 받지 아니하였은즉,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "너희가 재앙을 만날 때에 내가 웃을 것이며;",
                "너희의 두려움이 임할 때에 내가 비웃으리라,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "너희의 두려움이 폭풍우처럼 오고, 너희의 재앙이 회오리바람처럼 올 때에, 고난과 고통이 너희에게 임할 때에."
            ]
        },
        {
            "verse": 28,
            "text": [
                "그때에 그들이 나를 부르리니 내가 응답하지 아니하겠고; 그들이 간절히 나를 찾으리니 만나지 못하리라,"
            ]
        },
        {
            "verse": 29,
            "text": [
                "이는 그들이 지혜를 미워하며 여호와 경외하기를 원하지 아니하며,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "나의 교훈을 받지 아니하고 나의 모든 책망을 멸시하였음이라."
            ]
        },
        {
            "verse": 31,
            "text": [
                "그러므로 그들은 자기 행위의 열매를 먹으며 자기 꾀에 배부르리라."
            ]
        },
        {
            "verse": 32,
            "text": [
                "어리석은 자의 방황은 그들을 죽음에 이르게 하며, 미련한 자의 안일함은 그들을 멸망에 이르게 하느니라;"
            ]
        },
        {
            "verse": 33,
            "text": [
                "그러나 누구든지 내 말을 듣는 자는 안전히 거하며 재앙을 두려워하지 아니하리라.”"
            ]
        }
    ]
}