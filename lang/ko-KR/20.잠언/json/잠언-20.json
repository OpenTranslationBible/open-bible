{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "포도주는 조롱거리요, 독주는 싸움꾼이라; 그것에 이끌리는 자는 지혜롭지 못하다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "왕의 진노는 사자의 포효 같으니, 그를 자극하는 자는 목숨을 잃는다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "다툼을 피하는 것이 사람에게는 영광이지만, 어리석은 자는 쉽게 싸우려 한다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "게으른 자는 제철에 밭을 갈지 않으니, 수확 때에 찾아도 아무것도 얻지 못한다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "사람의 마음속 계획은 깊은 물 같으나, 명철한 자는 그것을 끌어낸다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "많은 사람이 자기의 인자함을 자랑하지만, 신실한 사람을 누가 찾을 수 있으랴?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "의인은 온전하게 행하니, 그들의 자녀는 그 뒤에 복을 받는다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "재판의 자리에 앉은 왕은 그의 눈으로 모든 악을 걸러낸다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "“내 마음을 정결하게 하였으니, 내 죄에서 벗어났다”고 말할 수 있는 자가 누구인가?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "다른 저울추와 다른 도량형은 둘 다 주께서 미워하시는 것이다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "어린아이도 그 행위로 알려지나니, 그 행실이 순수하고 올바른지 여부로 알 수 있다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "듣는 귀와 보는 눈은 둘 다 주께서 지으신 것이다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "잠자기를 좋아하지 말라, 그렇지 않으면 가난해질 것이다; 눈을 뜨라, 그러면 양식이 넉넉할 것이다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "“좋지 않다, 좋지 않다!”라고 사는 자가 말하지만, 가서는 자랑한다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "금도 있고 보석도 많으나, 지식을 말하는 입술은 귀한 보배이다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "타인을 위해 보증을 서는 자의 옷을 가져가라; 외인을 위해 서면 그것을 담보로 잡아라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "속임수로 얻은 양식은 달지만, 그 후에는 입이 자갈로 가득 찬다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "계획은 상담으로 세워지나니, 지혜로운 지도로 전쟁을 하라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "험담하는 자는 비밀을 누설하나니, 입이 많은 자를 피하라."
            ]
        },
        {
            "verse": 20,
            "text": [
                "자기 아버지나 어머니를 저주하는 자는 그의 등불이 어두운 가운데 꺼질 것이다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "처음에 급히 얻은 유산은 그 끝에 복이 없다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "“악을 갚겠다”고 말하지 말고, 주를 기다리라, 그가 너를 구원하실 것이다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "다른 저울추는 주께서 미워하시는 것이요, 거짓 저울은 좋지 않다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "사람의 걸음은 주께서 인도하시나니, 사람이 어찌 자기의 길을 알 수 있으랴?"
            ]
        },
        {
            "verse": 25,
            "text": [
                "서원을 경솔히 하고 나중에 그것을 생각하는 것은 위험하다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "지혜로운 왕은 악인을 걸러내고 타작 바퀴를 그들 위에 돌린다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "사람의 영혼은 주의 등불이라, 모든 깊은 곳을 살핀다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "인자와 진실이 왕을 보호하나니, 그의 왕위는 충성으로 말미암아 견고히 서리라."
            ]
        },
        {
            "verse": 29,
            "text": [
                "젊은이의 영광은 그의 힘이요, 노인의 아름다움은 그의 백발이다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "매와 상처는 악을 씻어내고, 매질은 깊은 속을 깨끗하게 한다."
            ]
        }
    ]
}