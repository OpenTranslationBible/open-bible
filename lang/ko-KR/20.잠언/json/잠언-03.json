{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "내 아들아, 나의 가르침을 잊지 말고, 네 마음이 나의 명령을 지키게 하라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "그것들이 네게 장수와 생명의 해와 평화를 더할 것임이라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "인자와 진리가 너를 떠나지 않게 하고, 그것들을 네 목에 매며, 네 마음판에 새기라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "그래야 네가 하나님과 사람 앞에서 은총과 좋은 명성을 얻으리라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "네 마음을 다하여 여호와를 신뢰하고, 네 자신의 명철을 의지하지 말라."
            ]
        },
        {
            "verse": 6,
            "text": [
                "네 모든 길에서 그를 인정하라, 그리하면 그가 네 길을 곧게 하시리라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "스스로 지혜롭게 여기지 말지어다; 여호와를 경외하며 악에서 떠날지어다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "이것이 네 몸에 건강이 되고 네 뼈에 윤택하게 하리라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "네 재물과 네 모든 소산의 첫 열매로 여호와를 공경하라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "그리하면 네 창고가 가득히 차고, 네 포도즙 틀에 새 포도즙이 넘치리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "내 아들아, 여호와의 징계를 경멸하지 말며, 그의 책망을 싫어하지 말라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "여호와께서 사랑하시는 자를 징계하시나니,",
                "> 마치 아버지가 기뻐하는 아들을 징계함 같으니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "지혜를 얻는 자와 명철을 얻는 자는 복이 있나니,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "이는 지혜의 이익이 은보다 낫고, 그 이익이 정금보다 나음이라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "지혜는 진주보다 귀하니, 네가 원하는 모든 것과 비교할 수 없도다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "그의 오른손에는 장수가 있고, 그의 왼손에는 부귀와 영광이 있나니."
            ]
        },
        {
            "verse": 17,
            "text": [
                "그의 길은 즐거운 길이요, 그의 모든 길은 평강이니라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "그는 그것을 붙잡는 자에게 생명나무라, 그를 굳게 잡는 자는 복되도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "여호와께서 지혜로 땅을 세우셨으며, 명철로 하늘을 굳게 펴셨고,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "그의 지식으로 깊은 바다를 갈라지게 하셨으며, 구름이 이슬을 내리게 하셨느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "내 아들아, 지혜와 근신을 네 눈에서 떠나지 않게 하며, 건전한 판단을 지키라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "그리하면 그것들이 네 영혼의 생명이 되며, 네 목에 장식이 되리라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "그리하면 네가 네 길을 안전히 다니겠고, 네 발이 걸려 넘어지지 아니하리라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "네가 누울 때 두려워하지 아니하겠고, 네 잠자리가 달콤하리라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "갑작스러운 재앙을 두려워하지 말며, 악인의 멸망이 임할 때도 두려워하지 말라."
            ]
        },
        {
            "verse": 26,
            "text": [
                "이는 여호와께서 네 확신이 되시며, 네 발이 올무에 걸리지 않게 하실 것임이라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "네 손에 선을 행할 힘이 있을 때, 마땅히 받을 자에게 선을 베풀기를 아끼지 말라."
            ]
        },
        {
            "verse": 28,
            "text": [
                "네 이웃에게 이르기를, “가서 다시 오라,",
                "> 내일 주겠노라,” 하지 말며, 네게 있을 때 주라."
            ]
        },
        {
            "verse": 29,
            "text": [
                "네 이웃이 네 곁에서 평안히 살거든, 그를 해할 계획을 세우지 말라."
            ]
        },
        {
            "verse": 30,
            "text": [
                "네게 해를 입히지 아니한 자와 다투지 말라."
            ]
        },
        {
            "verse": 31,
            "text": [
                "포악한 자를 부러워하지 말며, 그의 어떤 길도 택하지 말라."
            ]
        },
        {
            "verse": 32,
            "text": [
                "이는 사악한 자는 여호와께 가증한 자이지만, 정직한 자는 그의 친밀하심을 받음이라."
            ]
        },
        {
            "verse": 33,
            "text": [
                "여호와의 저주는 악인의 집에 있으나, 의인의 집에는 복이 있느니라."
            ]
        },
        {
            "verse": 34,
            "text": [
                "그는 거만한 자를 비웃으시며, 겸손한 자에게 은혜를 베푸시느니라."
            ]
        },
        {
            "verse": 35,
            "text": [
                "지혜로운 자는 영광을 상속하겠고, 미련한 자는 수치를 얻으리라."
            ]
        }
    ]
}