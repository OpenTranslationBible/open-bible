{
    "book": "열왕기상",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "이스라엘 자손이 이집트 땅에서 나온 지 사백팔십 년째,",
                "솔로몬이 이스라엘을 다스린 지 사 년째 되는 해,",
                "둘째 달인 시브월에,",
                "그는 주님의 성전 건축을 시작하였다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "솔로몬 왕이 주님을 위해 지은 성전은 길이가 육십 규빗,",
                "너비가 이십 규빗,",
                "높이가 삼십 규빗이었다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "성전 앞의 현관은 성전의 너비에 맞춰 길이가 이십 규빗이며,",
                "성전 앞쪽으로 깊이가 십 규빗이었다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "그는 성전에 예술적인 창틀을 만들었다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "그는 성전 벽에 붙여 부속 건물을 지었으며,",
                "성전의 내실과 외실 주위에",
                "측실을 만들었다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "가장 낮은 층은 너비가 오 규빗,",
                "중간 층은 너비가 육 규빗,",
                "세 번째 층은 너비가 칠 규빗이었다.",
                "그는 성전 벽 주위에 턱을 만들어",
                "들보가 성전 벽에 박히지 않게 하였다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "성전은 채석장에서 다듬은 돌로 지어졌으며,",
                "건축하는 동안 성전 안에서는 망치나 도끼나",
                "어떤 철제 도구 소리도 들리지 않았다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "가장 낮은 측실로 들어가는 문은 성전 오른쪽에 있었으며,",
                "나선형 계단을 통해 중간 층으로 올라가고,",
                "중간 층에서 세 번째 층으로 올라갔다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "그는 이렇게 성전을 건축하여 완성하였으며,",
                "성전을 백향목 들보와 널판지로 덮었다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "그는 성전 전체에 측실을 지었으며,",
                "각 층의 높이는 오 규빗이었다.",
                "그들은 백향목 들보로 성전에 연결되었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "그때 주님께서 솔로몬에게 말씀하셨다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "\"네가 짓고 있는 이 성전에 대하여,",
                "네가 내 법규를 따르고,",
                "내 규례를 지키며,",
                "내 모든 계명을 지켜 행하면,",
                "내가 네 아버지 다윗에게 말한 내 말을 네게 이룰 것이다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "그리고 나는 이스라엘 자손 가운데 거하며,",
                "내 백성 이스라엘을 버리지 않을 것이다.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "이렇게 솔로몬은 성전을 건축하여 완성하였다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "그는 성전의 내부 벽을 백향목으로 지었으며,",
                "성전의 바닥에서 천장까지 내부를 나무로 덮었고,",
                "성전의 바닥은 노송나무 널판지로 덮었다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "그는 성전 뒤쪽에 이십 규빗의 공간을 백향목 널판지로",
                "바닥에서 천장까지 지었으며,",
                "그것을 내부의 지성소로 지었다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "지성소 앞의 외실은",
                "길이가 사십 규빗이었다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "성전 내부는 박과 열린 꽃 모양으로 조각된",
                "백향목으로 장식되었으며,",
                "모든 것이 백향목이었고,",
                "돌은 보이지 않았다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "그는 성전 안에 지성소를 준비하여",
                "주님의 언약궤를 두었다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "지성소는 길이, 너비, 높이가 각각 이십 규빗이며,",
                "순금으로 덮었다.",
                "그는 또한 제단을 백향목으로 덮었다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "솔로몬은 성전 내부를 순금으로 덮었으며,",
                "지성소 앞에 금 사슬을 걸고,",
                "그것을 금으로 덮었다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "그는 성전 전체를 금으로 덮었으며,",
                "성전이 완성될 때까지 그렇게 하였다.",
                "그는 또한 지성소 옆에 있는 제단 전체를 금으로 덮었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "지성소 안에는 올리브 나무로 만든 두 그룹을 만들었으며,",
                "각각 높이가 십 규빗이었다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "한 그룹의 한 날개는 길이가 오 규빗이며,",
                "다른 날개도 길이가 오 규빗이었다.",
                "한 날개의 끝에서 다른 날개의 끝까지는 십 규빗이었다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "다른 그룹도 십 규빗이었으며,",
                "두 그룹은 크기와 모양이 같았다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "한 그룹의 높이는 십 규빗이며,",
                "다른 그룹도 같은 높이였다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "그는 그룹들을 성전 안에 두었으며,",
                "그룹들의 날개는 펼쳐져 있었고,",
                "한 그룹의 날개는 한쪽 벽에 닿았고,",
                "다른 그룹의 날개는 다른 쪽 벽에 닿았으며,",
                "그들의 날개는 성전 중앙에서 서로 닿았다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "그는 또한 그룹들을 금으로 덮었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "그는 성전의 모든 벽을 둘러싸고",
                "그룹, 종려나무, 열린 꽃 모양의 조각으로 새겼으며,",
                "내실에서 외실까지 그렇게 하였다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "그는 또한 성전의 바닥을 금으로 덮었으며,",
                "내실에서 외실까지 그렇게 하였다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "지성소의 입구를 위해, 그는 올리브 나무로 문을 만들었으며,",
                "문설주와 다섯 면의 문틀을 만들었다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "그는 올리브 나무로 두 문을 만들었으며,",
                "그 위에 그룹, 종려나무, 열린 꽃 모양을 새겼고,",
                "금으로 덮었으며,",
                "그룹과 종려나무 위에 금을 두드려 입혔다."
            ]
        },
        {
            "verse": 33,
            "text": [
                "마찬가지로, 그는 외실의 입구를 위해 올리브 나무로 네 면의 문틀을 만들었다."
            ]
        },
        {
            "verse": 34,
            "text": [
                "그리고 사이프러스 나무로 두 문을 만들었으며,",
                "한 문의 두 짝은 회전축으로 돌았고,",
                "다른 문의 두 짝도 회전축으로 돌았다."
            ]
        },
        {
            "verse": 35,
            "text": [
                "그는 그 위에 그룹, 종려나무, 열린 꽃 모양을 새겼으며,",
                "조각된 작업 위에 고르게 금을 입혔다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 36,
            "text": [
                "그는 다듬은 돌 세 줄과",
                "백향목 들보 한 줄로 내뜰을 지었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 37,
            "text": [
                "넷째 해, 시브월에 주님의 성전의 기초가 놓였다."
            ]
        },
        {
            "verse": 38,
            "text": [
                "열한째 해, 불월(여덟째 달)에,",
                "성전은 모든 부분과 계획에 따라 완성되었다.",
                "그는 그것을 칠 년 만에 지었다."
            ]
        }
    ]
}