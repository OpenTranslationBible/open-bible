{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "유다 왕 아몬의 아들 요시야 시대에 히스기야의 아들 아마랴의 아들 그달랴의 아들 구시의 아들 스바냐에게 임한 여호와의 말씀이라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"내가 땅 위에서 모든 것을 완전히 쓸어버리리라,\"",
                "> 여호와의 말씀이니라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"내가 사람과 짐승을 쓸어버리며,",
                "> 공중의 새와 바다의 고기를 제거하며,",
                "> 악인과 함께 폐허를 없애리라.",
                "> 내가 사람을 땅 위에서 끊으리라,\"",
                "> 여호와의 말씀이니라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"내가 유다와 예루살렘의 모든 주민을 대적하여 손을 펴서",
                "> 이곳에서 바알의 남은 자들을 끊으며,",
                "> 우상 숭배하는 제사장들의 이름을 다른 제사장들과 함께 끊으리라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 지붕 위에서 하늘의 별들에게 절하며,",
                "> 여호와를 맹세하고 또 밀곰을 맹세하는 자들,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 여호와를 따르지 않고 돌아선 자들,",
                "> 여호와를 찾지도 않고 그에게 묻지도 않은 자들.\""
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 주 여호와 앞에서 잠잠하라,",
                "> 여호와의 날이 가까우니라.",
                "> 여호와께서 희생제를 준비하셨고,",
                "> 그의 손님들을 성별하셨느니라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"여호와의 희생제의 날에,",
                "> 내가 방백들과 왕의 아들들을 벌하며,",
                "> 이방의 옷을 입은 모든 자들을 벌하리라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그 날에 내가 문지방을 뛰어넘는 모든 자들을 벌하며,",
                "> 그들의 주인의 집을 폭력과 속임수로 채운 자들을 벌하리라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> \"그 날에,\" 여호와의 말씀이니라,",
                "> \"물고기 문에서 부르짖는 소리가 들리며,",
                "> 둘째 구역에서 울부짖는 소리와",
                "> 언덕에서 큰 충돌 소리가 들리리라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 시장 구역에 사는 자들아, 울부짖으라,",
                "> 너희의 모든 상인들이 멸망할 것이며,",
                "> 은을 저울질하는 자들이 끊어질 것이라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그때에 내가 등불로 예루살렘을 찾아서",
                "> 안일한 자들을 벌하리니,",
                "> 그들은 찌꺼기에 남은 포도주 같아서",
                "> 마음속에 이르기를,",
                "> '여호와께서는 선도 악도 행하지 아니하신다' 하는 자들이라."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그들의 재물이 약탈당하며,",
                "> 그들의 집들이 황폐하게 되리라.",
                "> 그들이 집을 지어도 거기에 살지 못하며,",
                "> 포도원을 심어도 그 포도주를 마시지 못하리라.\""
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 여호와의 큰 날이 가까우니",
                "> —가까워서 신속히 임하리라.",
                "> 여호와의 날에 부르짖는 소리가 쓰라리니,",
                "> 용사가 전쟁의 함성을 지르리라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그 날은 분노의 날이요,",
                "> 환난과 고통의 날이요,",
                "> 황폐와 파괴의 날이요,",
                "> 어둠과 암흑의 날이요,",
                "> 구름과 짙은 흑암의 날이니라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 나팔 소리와 전쟁의 함성이",
                "> 견고한 성읍을 대적하여",
                "> 높은 망대를 대적하여 임하리라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> \"내가 사람들에게 고통을 주리니,",
                "> 그들이 맹인같이 걸으리라,",
                "> 이는 그들이 여호와께 죄를 지었기 때문이라.",
                "> 그들의 피가 먼지같이 쏟아질 것이며,",
                "> 그들의 살이 똥같이 쏟아지리라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그들의 은이나 금이",
                "> 여호와의 분노의 날에 그들을 구원하지 못하리라.",
                "> 그의 질투의 불에",
                "> 온 땅이 소멸되리니,",
                "> 이는 그가 땅의 모든 주민을",
                "> 완전히 끝내리라,",
                "> 참으로 두렵게 하리라."
            ]
        }
    ]
}