{
    "book": "아가",
    "chapter": 6,
    "verses": [
        {
            "verse": 1,
            "text": [
                "여자들 중에 가장 아름다운 자야,",
                "네 사랑하는 자가 어디로 갔는가?",
                "네 사랑하는 자가 어디로 돌이켰는가?",
                "우리가 너와 함께 그를 찾으리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "내 사랑하는 자는 그의 동산으로 내려갔으며,",
                "향기로운 꽃밭으로 갔도다.",
                "그는 동산에서 양 떼를 먹이며",
                "백합을 거두는구나."
            ]
        },
        {
            "verse": 3,
            "text": [
                "나는 내 사랑하는 자에게 속하였고, 내 사랑하는 자는 내게 속하였도다.",
                "그는 백합 가운데 양 떼를 먹이는구나."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "내 사랑아, 너는 디르사같이 아름답고,",
                "예루살렘같이 곱고,",
                "깃발을 세운 군대같이 위엄이 있구나."
            ]
        },
        {
            "verse": 5,
            "text": [
                "네 눈이 나를 압도하니",
                "나를 보지 말라.",
                "네 머리털은 길르앗에서 내려오는",
                "염소 떼 같구나."
            ]
        },
        {
            "verse": 6,
            "text": [
                "네 이는 목욕장에서 나오는",
                "털 깎인 암양 떼 같으니,",
                "모두 쌍태를 낳았고,",
                "그 중에 하나도 잃지 않았구나."
            ]
        },
        {
            "verse": 7,
            "text": [
                "네 뺨은 너울 속에서",
                "석류 한 쪽 같구나."
            ]
        },
        {
            "verse": 8,
            "text": [
                "왕비가 육십 명이요, 후궁이 팔십 명이며,",
                "계집이 무수하되,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "내 비둘기, 내 완전한 자는 하나뿐이로구나.",
                "그는 그의 어머니의 외딸이요,",
                "그를 낳은 자의 귀중히 여기는 자로구나.",
                "여자들이 그를 보고 복되다 하고,",
                "왕비와 후궁들도 그를 칭찬하는구나."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "“이 여자가 누구인가?",
                "새벽같이 비치고,",
                "달같이 아름답고,",
                "해같이 맑고,",
                "깃발을 세운 군대같이 위엄이 있구나.”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "내가 호두나무 동산으로 내려가서",
                "골짜기의 푸른 나무를 보며,",
                "포도나무가 싹이 났는지,",
                "석류나무가 꽃이 피었는지 보려 하였노라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "내가 깨닫기 전에 내 마음이 나를",
                "귀족의 병거 가운데로 이끌었도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "돌아오라, 돌아오라, 술람미 여인아;",
                "돌아오라, 돌아오라, 우리가 너를 보게 하라!",
                "너희가 어찌하여 술람미 여인을 보려 하느냐,",
                "마치 두 군대의 춤추는 것을 보듯이 하려느냐?"
            ]
        }
    ]
}