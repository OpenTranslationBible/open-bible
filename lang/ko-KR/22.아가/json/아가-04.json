{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "내 사랑, 당신은 얼마나 아름다운가,",
                "정말로 아름답습니다!",
                "당신의 눈은 베일 뒤의 비둘기 같고,",
                "당신의 머리카락은 길르앗 산에서 내려오는",
                "염소 떼와 같습니다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "당신의 이는 갓 깎은 양 떼 같고",
                "세탁을 마치고 올라온 양 떼 같으며,",
                "모두 쌍둥이를 낳았고,",
                "그 중 하나도 새끼를 잃지 않았습니다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "당신의 입술은 주홍색 실 같고,",
                "당신의 입은 매력적입니다.",
                "당신의 관자놀이들은 베일 뒤의",
                "석류 조각과 같습니다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "당신의 목은 다윗의 망대 같고,",
                "겹겹이 쌓은 돌로 지어졌으며,",
                "그 위에는 천 개의 방패,",
                "모두 전사의 둥근 방패가 걸려 있습니다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "당신의 두 가슴은 두 어린 사슴 같고,",
                "쌍둥이 노루 같으며,",
                "백합 사이에서 풀을 뜯습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "날이 시원해질 때까지,",
                "그림자가 사라질 때까지,",
                "나는 몰약의 산과",
                "유향의 언덕으로 가겠습니다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "당신은 완전히 아름답습니다, 내 사랑,",
                "당신에게는 흠이 없습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "레바논에서 나와 함께 하세요, 내 신부,",
                "레바논에서 나와 함께 오세요.",
                "아마나의 정상에서 내려오세요,",
                "세닐과 헤르몬의 정상에서,",
                "사자의 굴에서,",
                "표범의 산에서 내려오세요."
            ]
        },
        {
            "verse": 9,
            "text": [
                "당신은 내 마음을 사로잡았습니다, 내 누이, 내 신부;",
                "당신은 당신의 눈길 한 번으로 내 마음을 사로잡았습니다,",
                "당신의 목걸이 한 줄로."
            ]
        },
        {
            "verse": 10,
            "text": [
                "당신의 사랑은 얼마나 즐거운가, 내 누이, 내 신부!",
                "당신의 사랑은 포도주보다 얼마나 더 좋은가,",
                "당신의 기름 향기는 모든 종류의 발삼유보다 더 좋습니다!"
            ]
        },
        {
            "verse": 11,
            "text": [
                "당신의 입술은 꿀을 떨어뜨립니다, 내 신부;",
                "꿀과 젖이 당신의 혀 아래 있으며,",
                "당신의 옷 향기는 레바논의 향기와 같습니다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "잠긴 동산은 내 누이, 내 신부,",
                "잠긴 우물, 봉인된 샘입니다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "당신의 가지는 석류 과수원 같고",
                "즐거운 열매가 있으며,",
                "헨나와 나드 식물이 있습니다,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "나드와 사프란, 향기로운 갈대와 계피,",
                "모든 유향 나무와 함께,",
                "몰약과 침향, 모든 최고의 발삼유와 함께 있습니다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "당신은 동산의 샘 같고,",
                "신선한 물의 우물 같으며,",
                "레바논에서 흐르는 시내와 같습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "북풍아, 깨어나라,",
                "남풍아, 와라;",
                "내 동산이 향기를 내뿜게 하고,",
                "그 발삼유가 흐르게 하라.",
                "내 사랑이 그의 동산에 들어와",
                "그의 즐거운 열매를 먹기를 바랍니다!"
            ]
        }
    ]
}