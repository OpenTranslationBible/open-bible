{
    "book": "아가",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "내가 밤마다 내 침상에서",
                "내 마음에 사랑하는 자를 찾았으나",
                "찾아도 찾지 못하였노라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "이제 내가 일어나서 성 안을 돌아다니리라;",
                "거리와 광장에서",
                "내 마음에 사랑하는 자를 찾으리라 하였으나",
                "찾아도 찾지 못하였노라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "성 안을 순찰하는 파수꾼들이 나를 만나매",
                "내가 묻기를",
                "“내 마음에 사랑하는 자를 보았느냐?” 하였노라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "그들을 지나자마자",
                "내 마음에 사랑하는 자를 만나서",
                "그를 붙잡고 놓지 아니하였노라",
                "내 어머니의 집으로,",
                "나를 잉태한 자의 방으로 그를 데려오기까지."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "예루살렘의 딸들아,",
                "내가 너희에게 부탁하노니,",
                "들사슴이나 들의 암사슴을 두고",
                "사랑이 원하기 전에는",
                "사랑을 깨우지 말며 흔들지 말지니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "이것이 무엇인가? 광야에서 올라오는 것이",
                "연기 기둥 같고,",
                "몰약과 유향과",
                "상인의 모든 향품으로 향기로운 것인가?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "보라, 그것은 솔로몬의 이동식 침상이라;",
                "이스라엘의 용사들 중",
                "육십 명의 용사들이 그 주위에 둘러섰도다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "그들 모두는 칼을 잡고,",
                "전쟁에 능숙하며;",
                "각자 허리에 칼을 차고,",
                "밤의 두려움으로부터 지키는 자들이라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "솔로몬 왕이 자신을 위해 가마를 만들었으니",
                "레바논의 나무로 만들었도다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "그 기둥은 은으로,",
                "등받이는 금으로,",
                "좌석은 자주색 천으로 만들었으며,",
                "그 내부는 예루살렘의 딸들이",
                "사랑으로 장식하였도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "시온의 딸들아, 나가서 보라,",
                "솔로몬 왕을 그의 어머니가",
                "그의 결혼식 날에,",
                "그의 마음이 기뻐하는 날에",
                "그에게 씌운 왕관을 쓰고 있도다."
            ]
        }
    ]
}