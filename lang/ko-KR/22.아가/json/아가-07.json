{
    "book": "아가",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "귀한 신발을 신은 네 발이 어찌 그리 아름다운가,",
                "오 귀족의 딸이여!",
                "네 엉덩이의 곡선은 보석 같고,",
                "예술가의 손으로 만든 작품이로다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "네 배꼽은 둥근 잔 같아서",
                "혼합 포도주가 끊이지 않으며,",
                "네 배는 밀 더미 같아서",
                "백합으로 둘러싸여 있도다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "네 두 가슴은 온유한 새끼 사슴 같고,",
                "쌍태의 노루 새끼 같도다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "네 목은 상아 망대 같고,",
                "네 눈은 헤스본의 바드라빔 문 곁의 연못 같으며,",
                "네 코는 다메섹을 향한 레바논 망대 같도다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "네 머리는 갈멜 산 같고,",
                "네 머리털은 자주빛 실 같으니,",
                "왕이 그 머리카락에 매혹되었도다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "네가 어찌 그리 사랑스럽고 어찌 그리 기쁜가,",
                "나의 사랑이여, 너의 모든 매력으로!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "네 키는 종려나무 같고,",
                "네 가슴은 그 열매 송이 같도다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "내가 말하기를, “내가 종려나무에 올라가서",
                "그 가지를 잡으리라.” 하였도다.",
                "오, 네 가슴이 포도송이 같고,",
                "네 숨결의 향기가 사과 같기를 원하노라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "네 입은 가장 좋은 포도주 같으니라!”",
                "그것이 나의 사랑하는 자를 위하여 부드럽게 미끄러져,",
                "쉬는 자의 입술을 통해 부드럽게 흐르도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "나는 나의 사랑하는 자에게 속하였고,",
                "그의 갈망은 나를 향하였도다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "오라, 나의 사랑하는 자여, 우리가 들로 나가자,",
                "우리가 마을에서 밤을 지내자."
            ]
        },
        {
            "verse": 12,
            "text": [
                "우리가 일찍 일어나 포도원으로 가자;",
                "포도나무가 싹이 났는지",
                "꽃이 피었는지,",
                "석류가 꽃을 피웠는지 보자.",
                "거기서 내가 너와 사랑을 나누리라."
            ]
        },
        {
            "verse": 13,
            "text": [
                "합환채가 그 향기를 발하였고;",
                "우리 문 앞에는 모든 귀한 열매가 있도다,",
                "새것과 묵은 것,",
                "내가 너를 위하여 간직한 것이로다, 나의 사랑하는 자여."
            ]
        }
    ]
}