{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "네가 내 어머니의 젖을 먹은",
                "오라비 같았으면 좋겠구나.",
                "내가 밖에서 너를 만나면 입맞추겠고,",
                "아무도 나를 업신여기지 않을 것이다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "내가 너를 이끌어",
                "내 어머니의 집으로 데려가리니,",
                "그분이 나를 가르치셨다.",
                "내가 너에게 향기로운 포도주를 마시게 하리니,",
                "내 석류즙으로 만든 것이다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "그의 왼손은 내 머리를 받치고,",
                "그의 오른손은 나를 안는다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "예루살렘의 딸들아,",
                "내가 너희에게 부탁한다.",
                "사랑이 원할 때까지",
                "사랑을 깨우거나 흔들지 말라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "“사랑하는 이에게 기대어",
                "광야에서 올라오는 이가 누구인가?”",
                "“사과나무 아래에서 내가 너를 깨웠다;",
                "거기서 네 어머니가 너를 낳았고,",
                "거기서 그녀가 너를 낳았다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "너를 내 마음에 도장같이,",
                "내 팔에 도장같이 새겨다오.",
                "사랑은 죽음처럼 강하고,",
                "열정은 무덤처럼 잔인하다;",
                "그 불꽃은 불의 불꽃이요,",
                "신성한 불길이다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "많은 물도 사랑을 끌 수 없고,",
                "강물도 그것을 잠기게 할 수 없다;",
                "사람이 그의 집의 모든 재산을 사랑을 위해 준다 해도,",
                "그것은 완전히 멸시받을 것이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "우리에게 어린 여동생이 있는데,",
                "아직 성숙하지 않았다;",
                "그녀가 말해지는 날에",
                "우리가 그녀를 위해 무엇을 할까?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "그녀가 벽이라면,",
                "우리는 그녀 위에 은으로 된 성벽을 세우리라;",
                "그러나 그녀가 문이라면,",
                "우리는 그녀를 백향목 판자로 막으리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "나는 벽이었고, 내 키는 탑과 같았다;",
                "그러나 나는 그의 눈에",
                "평화를 찾은 자로 보였다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "솔로몬은 바알하몬에 포도원을 가졌고,",
                "그 포도원을 관리인들에게 맡겼다.",
                "각자는 그 열매를 위해 천 세겔의 은을 가져와야 했다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "내 자신의 포도원은 내게 있다;",
                "천 세겔은 솔로몬에게 주고,",
                "이백은 그 열매를 돌보는 자들에게 주리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "정원에 거하는 너여,",
                "내 동료들이 네 목소리를 기다리고 있다—",
                "내게 들려다오!"
            ]
        },
        {
            "verse": 14,
            "text": [
                "나의 사랑하는 자여, 서둘러라,",
                "그리고 빠른 노루나 어린 사슴처럼",
                "향기로운 산들 위에 있어라."
            ]
        }
    ]
}