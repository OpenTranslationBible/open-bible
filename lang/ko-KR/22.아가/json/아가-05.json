{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "내 누이, 내 신부여, 내가 내 동산에 들어왔도다.",
                "내가 몰약과 향재를 거두었고,",
                "내가 내 꿀과 꿀집을 먹었으며,",
                "내가 내 포도주와 내 우유를 마셨도다.",
                "친구들아, 먹어라.",
                "마시고 사랑에 취하라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "나는 잠들었으나 내 마음은 깨어 있었도다.",
                "내 사랑하는 자의 소리가 들리니, 그가 문에 서서 말하였도다.",
                "“내 누이, 나의 사랑,",
                "나의 비둘기, 흠 없는 자여, 내게 열어다오.",
                "내 머리가 이슬에 젖었고,",
                "내 머리털이 밤의 이슬에 젖었도다.”"
            ]
        },
        {
            "verse": 3,
            "text": [
                "“내가 옷을 벗었으니,",
                "어찌 다시 입겠는가?",
                "내가 발을 씻었으니,",
                "어찌 다시 더럽히겠는가?”"
            ]
        },
        {
            "verse": 4,
            "text": [
                "내 사랑하는 자가 손을 문틈으로 넣으매,",
                "내 마음이 그로 인하여 움직였도다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "내가 일어나 내 사랑하는 자에게 열었으나,",
                "내 손에는 몰약이 떨어지고,",
                "내 손가락에는 흐르는 몰약이",
                "빗장 손잡이에 묻었도다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "내가 내 사랑하는 자에게 열었으나,",
                "내 사랑하는 자는 돌아서서 가버렸도다.",
                "그가 떠나매 내 혼이 나갔도다.",
                "내가 그를 찾았으나 만나지 못하였고,",
                "내가 그를 불렀으나 대답하지 아니하였도다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "성읍을 순찰하는 자들이 나를 만나매,",
                "나를 쳐서 상하게 하였도다.",
                "성벽을 지키는 자들이 내 겉옷을 벗겼도다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "예루살렘 딸들아,",
                "내가 너희에게 부탁하노니,",
                "너희가 내 사랑하는 자를 만나거든,",
                "너희가 그에게 말하기를",
                "내가 사랑으로 병이 났다고 하라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "여자들 중에서 가장 아름다운 자야,",
                "네 사랑하는 자가 어떤 자이기에",
                "네가 우리에게 이렇게 부탁하느냐?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "내 사랑하는 자는 희고 붉으며,",
                "만 명 중에 뛰어난 자로구나."
            ]
        },
        {
            "verse": 11,
            "text": [
                "그의 머리는 순금 같고,",
                "그의 머리털은 종려나무 가지 같으며,",
                "까마귀같이 검구나."
            ]
        },
        {
            "verse": 12,
            "text": [
                "그의 눈은 시냇가의 비둘기 같고,",
                "우유에 씻은 듯하며,",
                "자리에 맞추어졌도다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "그의 뺨은 향기로운 꽃밭 같고,",
                "향기로운 풀밭 같으며,",
                "그의 입술은 백합화 같고,",
                "몰약이 떨어지는구나."
            ]
        },
        {
            "verse": 14,
            "text": [
                "그의 손은 황금 막대기 같고,",
                "귀한 보석으로 물렸으며,",
                "그의 몸은 상아로 만든 것 같고,",
                "사파이어로 꾸몄도다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "그의 다리는 순금 받침에 세운",
                "화반석 기둥 같고,",
                "그의 모습은 레바논 같으며,",
                "백향목처럼 뛰어나도다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "그의 입은 심히 달콤하며,",
                "그는 전적으로 사랑스럽도다.",
                "이는 나의 사랑하는 자요, 나의 친구로다,",
                "예루살렘 딸들아."
            ]
        }
    ]
}