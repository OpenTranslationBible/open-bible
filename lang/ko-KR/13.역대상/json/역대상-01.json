{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "아담, 셋, 에노스,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "케난, 마할랄렐, 야렛,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "에녹, 므두셀라, 라멕,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "노아와 그의 아들들:",
                "> 셈, 함, 야벳."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "야벳의 아들들은:",
                "> 고멜, 마곡, 마대, 야완, 두발, 메섹, 디라스."
            ]
        },
        {
            "verse": 6,
            "text": [
                "고멜의 아들들은:",
                "> 아스그나스, 디밧, 도갈마."
            ]
        },
        {
            "verse": 7,
            "text": [
                "야완의 자손들은:",
                "> 엘리사, 다시스, 깃딤, 로다님."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "함의 아들들은:",
                "> 구스, 미스라임, 붓, 가나안."
            ]
        },
        {
            "verse": 9,
            "text": [
                "구스의 아들들은:",
                "> 스바, 하윌라, 삽다, 라아마, 삽드가.",
                "> 라아마의 아들들은:",
                "> 스바와 드단."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 구스는 니므롯의 아버지였으며;",
                "> 그는 땅에서 강력한 인물이 되었다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "미스라임은 다음의 조상이었다:",
                "> 룻, 아남, 르합, 납두흐,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 바드루스, 가슬루 (여기서 블레셋이 나왔음), 갑도르."
            ]
        },
        {
            "verse": 13,
            "text": [
                "가나안은",
                "> 그의 맏아들 시돈과 헷의 조상이었다,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "그리고 여부스 족속, 아모리 족속, 기르가스 족속,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "히위 족속, 알가 족속, 시니 족속,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "아르왓 족속, 스말 족속, 하맛 족속의 조상이었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "셈의 아들들은:",
                "> 엘람, 앗수르, 아르박삿, 룻, 아람,",
                "> 아람의 아들들은",
                "> 우스, 훌, 게델, 메섹."
            ]
        },
        {
            "verse": 18,
            "text": [
                "아르박삿은 셀라의 아버지였고,",
                "셀라는 에벨의 아버지였다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "에벨에게는 두 아들이 있었다:",
                "> 하나는 벨렉이라 불렸는데, 그의 시대에 땅이 나뉘었다;",
                "> 그의 형제는 욕단이라 불렸다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "욕단의 자손들은:",
                "> 알모닷, 셀렙, 하살마웻, 예라,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "하도람, 우살, 디글라,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "에발, 아비마엘, 스바,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "오빌, 하윌라, 요밥.",
                "이들은 모두 욕단의 아들들이었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 셈, 아르박삿, 셀라,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 에벨, 벨렉, 르우,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 스룩, 나홀, 데라,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 아브람, 그는 아브라함으로도 알려져 있다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 아브라함의 아들들은:",
                "> 이삭과 이스마엘이라 불렸다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "이들은 그들의 세대들이다:",
                "> 이스마엘의 맏아들은 느바욧, 그 다음은 게달, 앗브엘, 밉삼,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "미스마, 두마, 맛사, 하닷, 데마,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "여둘, 나비스, 게드마.",
                "이들은 이스마엘의 자손들이었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "아브라함의 첩인 그두라의 아들들은 그녀가 낳은:",
                "> 십란, 욕산, 므단, 미디안, 이스박, 수아.",
                "> 욕산의 아들들은:",
                "> 스바와 드단."
            ]
        },
        {
            "verse": 33,
            "text": [
                "미디안의 아들들은:",
                "> 에바, 에벨, 하녹, 아비다, 엘다아.",
                "> 이들은 모두 그두라의 아들들이었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "아브라함은 이삭을 낳았다.",
                "> 이삭의 아들들은:",
                "> 에서와 이스라엘."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "에서의 아들들은:",
                "> 엘리바스, 르우엘, 여우스; 얄람, 고라."
            ]
        },
        {
            "verse": 36,
            "text": [
                "엘리바스의 아들들은:",
                "> 데만, 오말, 스보, 가담, 그나스, 딤나, 아말렉."
            ]
        },
        {
            "verse": 37,
            "text": [
                "르우엘의 아들들은:",
                "> 나핫, 세라; 삼마, 미사."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "세일의 아들들은:",
                "> 로단, 소발, 시브온; 아나, 디손, 에셀, 디산."
            ]
        },
        {
            "verse": 39,
            "text": [
                "로단의 아들들은:",
                "> 호리와 호맘; 딤나는 로단의 누이였다."
            ]
        },
        {
            "verse": 40,
            "text": [
                "소발의 아들들은:",
                "> 알리안, 마나핫, 에발, 스비, 오남.",
                "> 시브온의 아들들은:",
                "> 아야와 아나."
            ]
        },
        {
            "verse": 41,
            "text": [
                "아나의 아들은:",
                "> 디손.",
                "> 디손의 아들들은:",
                "> 함란, 에스반, 이드란, 그란."
            ]
        },
        {
            "verse": 42,
            "text": [
                "에셀의 아들들은:",
                "> 빌한, 사아완, 야아간.",
                "> 디산의 아들들은:",
                "> 우스와 아란."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "이스라엘 자손 위에 왕이 다스리기 전에 에돔 땅을 다스린 왕들은:",
                "브올의 아들 벨라, 그의 성은 딘하바라 불렸다."
            ]
        },
        {
            "verse": 44,
            "text": [
                "벨라가 죽자, 보스라의 세라의 아들 요밥이 그를 이어 왕이 되었다."
            ]
        },
        {
            "verse": 45,
            "text": [
                "요밥이 죽은 후, 데만 족속의 땅에서 온 후삼이 왕위를 계승했다."
            ]
        },
        {
            "verse": 46,
            "text": [
                "후삼이 죽었을 때, 모압 지역에서 미디안을 물리친 브닷의 아들 하닷이 왕이 되었다;",
                "그의 성은 아윗이라 불렸다."
            ]
        },
        {
            "verse": 47,
            "text": [
                "하닷이 죽자, 마스레가의 삼라가 왕위를 이었다."
            ]
        },
        {
            "verse": 48,
            "text": [
                "삼라가 죽자, 강가의 르호봇에서 온 사울이 그를 이어 왕이 되었다."
            ]
        },
        {
            "verse": 49,
            "text": [
                "사울이 죽은 후, 악볼의 아들 바알하난이 왕위를 이었다."
            ]
        },
        {
            "verse": 50,
            "text": [
                "바알하난이 죽었을 때, 하닷이 왕이 되었다;",
                "그의 성은 바이라 불렸고,",
                "그의 아내는 마드렛의 딸이며 메사합의 딸인 메헤다벨이었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "그 후 하닷이 죽었다.",
                "에돔의 족장들은:",
                "딤나 족장, 알리아 족장, 여뎃 족장,"
            ]
        },
        {
            "verse": 52,
            "text": [
                "오홀리바마 족장, 엘라 족장, 비논 족장,"
            ]
        },
        {
            "verse": 53,
            "text": [
                "그나스 족장, 데만 족장, 밉살 족장,"
            ]
        },
        {
            "verse": 54,
            "text": [
                "막디엘 족장, 이람 족장.",
                "이들은 에돔의 지도자들이었다."
            ]
        }
    ]
}