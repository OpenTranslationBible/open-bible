{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “보라, 내 눈이 이것을 다 보았고,",
                "> 내 귀가 듣고 깨달았느니라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 너희가 아는 것을 나도 아노니,",
                "> 나는 너희보다 못하지 않다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 그러나 나는 전능자에게 말씀드리고 싶고,",
                "> 하나님과 변론하기를 원하노라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그러나 너희는 거짓말로 나를 덮고,",
                "> 너희 모두는 무익한 의원들이라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 너희가 잠잠하기만 한다면,",
                "> 그것이 너희의 지혜일 것이니라!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 나의 간청을 들어주고,",
                "> 내 입술의 논쟁에 주의를 기울이라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 너희가 하나님을 대신하여 불의하게 말하겠느냐,",
                "> 그를 위하여 속이겠느냐?"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그를 위하여 편파적으로 행하겠느냐?",
                "> 하나님을 위하여 변론하겠느냐?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그가 너희를 살피실 때에 너희가 잘 되겠느냐?",
                "> 너희가 사람을 속이듯 그를 속이겠느냐?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 너희가 은밀히 편파적으로 행하면",
                "> 그가 반드시 너희를 책망하시리라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그의 위엄이 너희를 두렵게 하지 않겠느냐,",
                "> 그에 대한 두려움이 너희에게 임하지 않겠느냐?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 너희의 기억할 만한 말들은 재의 속담이요,",
                "> 너희의 방어는 진흙의 방어니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> “내 앞에서 잠잠하라, 내가 말하게 하라;",
                "> 그러면 무슨 일이 닥쳐도 나에게 임하게 하라."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 어찌하여 내가 내 생명을 위험에 빠뜨리며,",
                "> 내 생명을 내 손에 두겠느냐?"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그가 나를 죽이실지라도, 나는 그를 신뢰하리라.",
                "> 그럼에도 불구하고, 나는 그 앞에서 내 사정을 진술하리라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 이것도 나의 구원이 되리니,",
                "> 경건하지 않은 자는 그 앞에 서지 못하리라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 내 말을 주의 깊게 듣고,",
                "> 나의 선언이 너희 귀에 닿게 하라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 보라, 내가 내 사정을 준비하였으니,",
                "> 내가 의롭다 함을 받을 것을 확신하노라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 누가 나와 변론하겠느냐?",
                "> 그러면 나는 잠잠하고 멸망하리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> “오직 두 가지 일을 내게 행하지 마소서,",
                "> 그러면 내가 주의 얼굴을 피하지 아니하리이다:"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 주의 손을 내게서 거두시고,",
                "> 주의 두려움이 나를 압도하지 않게 하소서."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그리하시면 주께서 부르시면 내가 대답하겠고,",
                "> 아니면 내가 말하게 하시고 주께서 내게 대답하소서."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 나의 죄와 허물이 얼마나 많으니이까?",
                "> 내게 나의 죄악과 죄를 알게 하소서."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 어찌하여 주의 얼굴을 숨기시고",
                "> 나를 주의 대적으로 여기시나이까?"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 주께서 바람에 날리는 잎사귀를 두렵게 하시겠나이까?",
                "> 마른 겨를 쫓으시겠나이까?"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 주께서 나를 대적하여 쓴 것들을 기록하시고",
                "> 나의 젊은 시절의 죄악을 짊어지게 하시나이다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 주께서 내 발을 착고에 채우시고",
                "> 나의 모든 길을 살피시며,",
                "> 내 발바닥에 경계를 정하시나이다,"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 나는 썩어가는 것처럼 소멸되고,",
                "> 좀먹은 의복처럼 되나이다."
            ]
        }
    ]
}