{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "수아 사람 빌닷이 대답하여 이르되,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"네가 어느 때까지 이런 말을 하겠으며",
                "> 네 입의 말이 거센 바람과 같겠는가?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 하나님이 정의를 굽게 하시겠느냐?",
                "> 전능자가 공의를 굽게 하시겠느냐?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 네 자녀들이 그에게 죄를 지었으므로",
                "> 그가 그들을 그 죄에 넘기셨나니라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 네가 만일 하나님을 간절히 구하며",
                "> 전능하신 이에게 은혜를 구하고,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 네가 정결하고 정직하면,",
                "> 반드시 그가 너를 위하여 일어나사",
                "> 네 의로운 처소를 회복하실 것이라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 네 시작은 미약하였으나,",
                "> 네 나중은 심히 창대하리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"청컨대 너는 옛 시대 사람에게 물으며,",
                "> 조상들이 터득한 것을 배울지어다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 우리는 어제부터 있었을 뿐이라 아무것도 알지 못하나니,",
                "> 세상에 있는 날이 그림자와 같음이라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그들이 너를 가르치고 네게 말하며,",
                "> 그들의 마음에서 나오는 말을 할 것이 아니냐?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 갈대가 진펄이 없이 크게 자라겠느냐?",
                "> 갈대가 물 없이 자라겠느냐?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 아직 푸르고 베이지 아니하였을 때에도,",
                "> 다른 풀보다 먼저 마르는 것이니라."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 하나님을 잊어버리는 자의 길은 다 이와 같고,",
                "> 경건하지 못한 자의 소망은 사라지리니,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그의 믿는 것은 끊어지고,",
                "> 그의 의지하는 것은 거미줄 같은지라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그 집을 의지할지라도 집이 서지 못하고,",
                "> 굳게 잡아도 집이 견디지 못하리라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그는 햇빛을 받고 물이 가득한 곳에 잘 자라며,",
                "> 그 가지가 동산에 뻗어가며,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그 뿌리가 돌무더기에 엉키고,",
                "> 돌 가운데로 들어가도다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그가 그 자리에서 뽑히면,",
                "> 그 자리도 그를 모른다 하며 이르기를 '내가 너를 보지 못하였다' 하리라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 보라, 그의 길의 기쁨은 이와 같고,",
                "> 그 후에 다른 것이 흙에서 나리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 하나님은 온전한 사람을 버리지 아니하시며,",
                "> 악한 자를 붙들어 주지 아니하시리니,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그가 다시 네 입에 웃음을,",
                "> 네 입술에 즐거운 소리를 채우시리라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 너를 미워하는 자는 부끄러움을 입을 것이며,",
                "> 악인의 장막은 없어지리라.\""
            ]
        }
    ]
}