{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "이제 데만 사람 엘리바스가 말하여 이르되,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> “하나님께 사람이 유익이 될 수 있겠느냐?",
                "> 지혜로운 자가 자기에게 유익이 될 수 있겠느냐?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 네가 의롭다고 전능자가 기뻐하시겠느냐,",
                "> 네 길이 완전하다고 이익이 되겠느냐?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 네 경외함 때문에 그가 너를 책망하시며",
                "> 너와 함께 심판에 들어가시겠느냐?"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 네 악이 크지 아니하냐,",
                "> 네 죄악이 끝이 없지 아니하냐?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 네가 까닭 없이 형제에게 담보를 취하고",
                "> 헐벗은 자의 옷을 벗겼으며,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 피곤한 자에게 물을 주지 아니하고,",
                "> 주린 자에게 음식을 주지 아니하였도다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그러나 땅은 강한 자의 것이 되고,",
                "> 존귀한 자가 그 위에 거하느니라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 네가 과부를 빈손으로 돌려보내며,",
                "> 고아의 팔을 꺾었도다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그러므로 올무들이 너를 둘러싸고,",
                "> 두려움이 갑자기 너를 엄습하며,"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 어둠이 너로 하여금 보지 못하게 하고,",
                "> 물의 홍수가 너를 덮느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> “하나님은 높은 하늘에 계시지 아니하냐?",
                "> 보라, 가장 높은 별들이 얼마나 높은가!"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그러나 네가 말하기를, ‘하나님이 무엇을 아시겠느냐?",
                "> 짙은 어둠을 통해 심판하실 수 있겠느냐?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 구름이 그를 가리우니, 그가 우리를 보지 못하시고,",
                "> 하늘의 궁창을 거니신다’ 하느니라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 네가 악인이 밟던 옛 길을 계속 가겠느냐,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그들은 때가 되기 전에 끌려가고,",
                "> 그들의 기초는 홍수에 휩쓸렸느니라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그들이 하나님께 말하기를, ‘우리를 떠나소서!’ 하며",
                "> ‘전능자가 그들에게 무엇을 할 수 있겠느냐?’ 하였으나,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그들의 집을 좋은 것으로 채우신 이는 그이시니,",
                "> 그러나 악인의 꾀는 나와 멀도다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 의인은 보고 기뻐하며,",
                "> 무죄한 자는 그들을 비웃으며 말하되,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> ‘진실로 우리의 대적은 끊어졌고,",
                "> 불이 그들의 재물을 삼켰다’ 하느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> “너는 그와 화목하고 평안하라;",
                "> 그리하면 복이 네게 임하리라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그의 입에서 교훈을 받고",
                "> 그의 말을 네 마음에 쌓아 두라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 네가 전능자에게로 돌아가면, 네가 회복되리니;",
                "> 네 장막에서 불의를 멀리하라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 네 금을 티끌에 던지고,",
                "> 오빌의 금을 시내의 돌에 던지라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 그리하면 전능자가 네 보배가 되시고,",
                "> 귀한 은이 되시리라."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 그때에 네가 전능자 안에서 기쁨을 얻고",
                "> 하나님께 네 얼굴을 들리라."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 네가 그에게 기도하면, 그가 네게 응답하시고,",
                "> 네가 서원한 것을 갚으리라."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 네가 무엇을 결정하면, 그것이 네게 이루어질 것이요,",
                "> 네 길에 빛이 비추리라."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 사람들이 낮아질 때에, 네가 말하기를,",
                "> ‘그들을 높이라!’ 하리니, 그가 겸손한 자를 구원하시리라."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 그가 죄 있는 자라도 건지시리니,",
                "> 네 손이 깨끗함으로 구원을 받으리라.”"
            ]
        }
    ]
}