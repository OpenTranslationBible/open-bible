{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "그때 주님께서 욥에게 말씀하셨다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"흠을 찾는 자가 전능자와 다투겠느냐?",
                "> 하나님을 도전하는 자는 대답하라.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "욥이 주님께 대답하여 말했다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"보소서, 나는 하찮은 자입니다. 어떻게 주께 대답할 수 있겠습니까?",
                "> 내 손을 내 입에 대겠습니다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 내가 한 번 말했으니 다시는 대답하지 않겠습니다;",
                "> 두 번 말했으니 더 이상 덧붙이지 않겠습니다.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "그때 주님께서 폭풍 속에서 욥에게 말씀하셨다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"사람처럼 준비하라;",
                "> 내가 너에게 질문할 것이니 네가 내게 알려라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 네가 정말로 내 판단을 무효로 하겠느냐?",
                "> 네가 너 자신을 정당화하기 위해 나를 정죄하겠느냐?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 네가 하나님과 같은 힘을 가지고 있느냐,",
                "> 네 목소리가 그분처럼 강력하게 울려 퍼질 수 있느냐?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 위엄과 존귀로 너 자신을 꾸미고,",
                "> 영광과 위엄으로 너 자신을 입혀라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 네 분노의 격노를 풀어라,",
                "> 교만한 자들을 보고 그들을 낮추어라."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 모든 오만한 자들을 보고 그들을 낮추어라,",
                "> 악한 자들을 그들이 서 있는 곳에서 짓밟아라."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그들을 함께 먼지 속에 묻어라;",
                "> 그들을 숨겨진 곳에 가두어라."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그러면 내가 네게 인정하리라",
                "> 네 자신의 오른손이 너를 구원할 수 있음을.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> \"보라, 내가 너와 함께 만든 베헤못을;",
                "> 그것은 소처럼 풀을 먹는다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그것의 허리의 힘을 보라,",
                "> 그것의 배의 근육의 힘을 보라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그것의 꼬리는 백향목처럼 흔들리고;",
                "> 그것의 넓적다리의 힘줄은 단단히 묶여 있다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그것의 뼈는 청동의 관 같고,",
                "> 그것의 팔다리는 철의 막대기 같다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그것은 하나님의 작품 중 으뜸이다;",
                "> 그것의 창조자는 칼로 그것에 접근할 수 있다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 산들은 그것을 위해 먹이를 내고,",
                "> 모든 들짐승들이 그 근처에서 논다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 연꽃 식물 아래에 그것이 쉬고,",
                "> 갈대와 늪 속에 숨겨져 있다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 연꽃들이 그것에게 그늘을 제공하고;",
                "> 시냇가의 버드나무들이 그것을 둘러싼다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 강이 격렬하게 흐를지라도 그것은 놀라지 않으며;",
                "> 요단강이 그 입에 넘쳐도 그것은 자신만만하다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그것이 경계할 때 누가 그것을 잡을 수 있겠느냐,",
                "> 혹은 그것의 코를 올가미로 뚫을 수 있겠느냐?\""
            ]
        }
    ]
}