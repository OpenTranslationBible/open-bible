{
    "book": "욥기",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"이제 부르라, 네게 응답할 자가 있겠느냐?",
                "> 너는 어느 거룩한 자에게로 돌아가겠느냐?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 분노는 어리석은 자를 죽이고,",
                "> 질투는 순진한 자를 죽음에 이르게 한다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 나는 어리석은 자가 뿌리 내리는 것을 보았고,",
                "> 즉시 그의 집을 저주하였다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그의 자녀들은 안전에서 멀리 떨어져 있으며,",
                "> 성문에서 억압을 당하고,",
                "> 구원자가 없다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 굶주린 자가 그의 수확을 먹어 치우고",
                "> 가시덤불에서도 그것을 가져가며,",
                "> 음모자는 그들의 재산을 탐한다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 재앙은 흙에서 일어나는 것이 아니며,",
                "> 고난은 땅에서 솟아나는 것이 아니다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그러나 사람은 고난을 위해 태어난다,",
                "> 불꽃이 위로 날아가는 것처럼."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> \"그러나 나는 하나님을 찾을 것이며,",
                "> 하나님께 나의 간구를 드릴 것이다,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그분은 크고 헤아릴 수 없는 일을 행하시며,",
                "> 셀 수 없는 기적을 이루신다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그분은 땅에 비를 내리시고,",
                "> 들에 물을 보내신다,"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그래서 낮은 자를 높이시고,",
                "> 애통하는 자를 안전하게 드신다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그분은 교활한 자의 계획을 좌절시키시며,",
                "> 그들의 손이 성공을 이루지 못하게 하신다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그분은 지혜로운 자를 그들의 교활함에 빠뜨리시고,",
                "> 교활한 자의 계략은 신속히 뒤집힌다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그들은 낮에도 어둠을 만나고,",
                "> 정오에도 밤처럼 더듬는다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그러나 그분은 그들의 입의 칼에서 구하시며,",
                "> 강한 자의 손에서 가난한 자를 구하신다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그래서 무력한 자에게 희망이 있으며,",
                "> 불의는 입을 다문다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> \"보라, 하나님께 징계를 받는 사람은 복이 있나니,",
                "> 전능자의 징계를 거절하지 말라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그분은 아프게 하시고 회복시키시며;",
                "> 상처를 내시고, 그분의 손이 또한 치유하신다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 여섯 가지 고난에서 그분은 너를 구하시며,",
                "> 일곱 가지에서도 재앙이 너를 해치지 못하리라."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 기근 중에 그분은 너를 죽음에서 구하시며,",
                "> 전쟁 중에 칼의 위력에서 구하시리라."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 너는 혀의 채찍에서 숨겨질 것이며,",
                "> 폭력이 올 때 두려워하지 않으리라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 너는 파멸과 기근을 비웃을 것이며,",
                "> 들짐승을 두려워하지 않으리라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 이는 네가 들의 돌들과 화평을 맺을 것이며,",
                "> 들의 짐승들이 너와 화목할 것이기 때문이다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 너는 네 장막이 안전함을 알 것이며,",
                "> 네 집을 방문하여 아무것도 잘못된 것이 없음을 알리라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 네 자손이 많음을 알 것이며,",
                "> 네 후손이 땅의 풀처럼 풍성하리라."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 너는 풍성한 나이에 무덤에 이를 것이며,",
                "> 제철에 거두어지는 곡식단처럼 되리라."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 보라, 우리가 이것을 조사하였으니, 이는 진실이라;",
                "> 이것을 듣고, 네 스스로 깨달으라.\""
            ]
        }
    ]
}