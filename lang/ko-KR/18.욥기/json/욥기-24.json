{
    "book": "욥기",
    "chapter": 24,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “전능자가 정한 때가 없고,",
                "> 그를 아는 자들이 그의 날을 알지 못하는 이유는 무엇인가?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 사람들이 경계표를 옮기고;",
                "> 양 떼를 빼앗아 먹는다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 그들은 고아의 나귀를 몰아가고,",
                "> 과부의 소를 담보로 잡는다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그들은 가난한 자를 길에서 밀어내고;",
                "> 땅의 가난한 자들이 함께 숨게 만든다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 보라, 광야의 들나귀처럼",
                "> 그들은 먹이를 찾으며,",
                "> 자녀들을 위해 사막에서 양식을 구한다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그들은 들에서 사료를 모으고",
                "> 불의한 자의 포도원을 주운다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그들은 옷 없이 밤을 지내며,",
                "> 추위를 막을 덮개가 없다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그들은 산의 비에 젖으며,",
                "> 피할 곳이 없어 바위에 매달린다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 다른 사람들은 젖먹이 고아를 빼앗고,",
                "> 가난한 자를 담보로 잡는다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그들은 가난한 자를 옷 없이 다니게 하고,",
                "> 굶주린 자에게서 곡식을 빼앗는다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그들은 성벽 안에서 기름을 짜고;",
                "> 포도주 틀을 밟으면서도 목마르다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 성읍에서 사람들이 신음하고,",
                "> 상처 입은 자들의 영혼이 부르짖는다;",
                "> 그러나 하나님은 그 불의를 돌아보지 않으신다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 다른 사람들은 빛을 거역하는 자들과 함께 있었으며;",
                "> 그들은 그 길을 알기를 원치 않고,",
                "> 그 길에 머물지 않는다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 살인자는 새벽에 일어나;",
                "> 가난한 자와 궁핍한 자를 죽이고,",
                "> 밤에는 도둑처럼 행동한다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 간음하는 자의 눈은 황혼을 기다리며,",
                "> ‘아무도 나를 보지 못하리라’ 말하고,",
                "> 얼굴을 가린다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그들은 어둠 속에서 집을 뚫고 들어가며,",
                "> 낮에는 스스로를 가두고;",
                "> 빛을 알지 못한다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 아침은 그에게 깊은 어둠과 같으니,",
                "> 그는 깊은 어둠의 공포에 익숙하다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그들은 물 위에서 하찮으며;",
                "> 그들의 땅은 저주받았고,",
                "> 포도원을 향하지 않는다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 건조함과 열기가 눈 녹은 물을 삼키듯,",
                "> 스올은 죄 지은 자들을 삼킨다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 어머니는 그를 잊을 것이며; 벌레는 그를 달게 먹을 것이다.",
                "> 그는 더 이상 기억되지 않는다.",
                "> 악행은 나무처럼 부러진다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그는 자식 없는 여자를 학대하고,",
                "> 과부에게 선을 행하지 않는다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그러나 그는 강한 자를 그의 힘으로 끌어내며;",
                "> 그가 일어나도 생명의 확신이 없다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 그는 그들에게 안전을 주어 그들이 지탱되게 하고;",
                "> 그의 눈은 그들의 길을 지켜본다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그들은 잠시 동안 높아졌다가 사라지며;",
                "> 또한, 그들은 모아진 모든 것처럼 낮아지며;",
                "> 곡식의 이삭처럼 잘려 나간다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 이제 만일 그렇지 않다면, 누가 나를 거짓으로 증명하며,",
                "> 내 말을 무의미하게 만들 수 있겠는가?”"
            ]
        }
    ]
}