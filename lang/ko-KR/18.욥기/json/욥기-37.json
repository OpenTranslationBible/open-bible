{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “이로 인해 내 마음이 떨리고,",
                "> 제자리를 떠나 뛰노는구나."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 그의 음성의 천둥 소리를 주의 깊게 들으라,",
                "> 그의 입에서 나오는 울림을 들으라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 온 하늘을 가로질러 그것을 내보내시고,",
                "> 그의 번개가 땅끝까지 이른다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그 뒤에 음성이 울려 퍼지며;",
                "> 그는 그의 위엄 있는 음성으로 천둥을 치시고,",
                "> 그의 음성이 들릴 때 번개를 멈추지 않으신다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 하나님은 그의 음성으로 놀랍게 천둥을 치시고,",
                "> 우리의 이해를 초월하는 큰일을 이루신다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 눈에게 명령하시기를, ‘땅에 내려라,’ 하시고,",
                "> 비에게, ‘강하게 내리라,’ 하신다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그는 모든 사람의 손을 봉인하시어,",
                "> 모든 사람이 그의 일을 알게 하신다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그때에 동물은 굴로 물러가고",
                "> 그들의 굴에 머문다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 남쪽에서 폭풍이 오고,",
                "> 북쪽에서 추위가 온다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 하나님의 숨결로 얼음이 형성되고,",
                "> 물의 넓은 면이 얼어붙는다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그는 또한 구름에 습기를 채우시고;",
                "> 그의 번개의 구름을 흩으신다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그것은 그의 인도로 방향을 바꾸며,",
                "> 그가 명령하신 것을 이루기 위해",
                "> 사람이 사는 땅의 표면 위에서 움직인다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 교정이든, 그의 세계를 위한 것이든,",
                "> 자비를 위한 것이든, 그는 그것이 일어나게 하신다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> “이것을 들어라, 욥아:",
                "> 서서 하나님의 경이로움을 생각하라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 하나님이 그것들을 어떻게 세우시는지 아느냐,",
                "> 그의 구름의 번개를 어떻게 빛나게 하시는지 아느냐?"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 구름의 떠다님에 대해 이해하느냐,",
                "> 지식이 완전하신 분의 경이로움을 아느냐,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 남풍 때문에 땅이 고요할 때",
                "> 너의 옷이 따뜻한 너는?"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 너는 그와 함께 하늘을 펼칠 수 있느냐,",
                "> 주조된 금속 거울처럼 강하게?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> “우리가 그에게 무엇을 말해야 할지 가르쳐라;",
                "> 우리는 어둠 때문에 우리의 경우를 제시할 수 없다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 내가 말하겠다고 그에게 보고해야 하겠느냐?",
                "> 아니면 사람이 압도될 것이라고 말해야 하겠느냐?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 현재 사람들은 하늘에서 밝게 빛나는 빛을 보지 못한다;",
                "> 그러나 바람이 지나가고 그것들을 맑게 한다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 북쪽에서 황금빛 광채가 오고;",
                "> 하나님 주위에는 경이로운 위엄이 있다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 전능자—우리는 그를 완전히 이해할 수 없다;",
                "> 그는 권능에 높으시며,",
                "> 그는 정의와 풍성한 의를 타협하지 않으신다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그러므로 사람들은 그를 경외한다;",
                "> 그는 마음이 지혜로운 자를 고려하지 않으신다.”"
            ]
        }
    ]
}