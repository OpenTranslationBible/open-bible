{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “네가 산 염소가 새끼를 낳는 때를 아느냐?",
                "> 암사슴이 새끼를 낳는 것을 지켜보느냐?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 그들이 채우는 달을 셀 수 있느냐,",
                "> 그들이 출산하는 때를 아느냐?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 그들은 무릎을 꿇고 새끼를 낳으며,",
                "> 고통에서 벗어난다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그들의 새끼는 강하게 자라서 들판에서 성숙하고;",
                "> 그들은 떠나고 다시 돌아오지 않는다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 누가 들나귀를 자유롭게 하였느냐?",
                "> 누가 빠른 나귀를 그의 결박에서 풀어주었느냐,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 내가 광야를 그의 집으로 주었고,",
                "> 소금 땅을 그의 거처로 주었느냐?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그는 도시의 혼란을 비웃고,",
                "> 감독자의 외침을 듣지 않는다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그는 그의 목초지를 위해 산을 돌아다니며,",
                "> 모든 푸른 것을 찾는다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 들소가 너를 섬기려고 하겠느냐,",
                "> 혹은 네 먹이통에서 밤을 보내겠느냐?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 네가 들소를 밧줄로 고랑에 묶을 수 있느냐,",
                "> 혹은 그가 너를 따라 골짜기를 갈겠느냐?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그의 힘이 크다고 그를 믿겠느냐,",
                "> 네 노동을 그에게 맡기겠느냐?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그가 네 곡식을 되돌려 가져오고,",
                "> 네 타작마당에서 모으리라고 믿겠느냐?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> “타조의 날개가 기쁘게 흔들리며,",
                "> 애정의 깃털과 함께,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그녀는 알을 땅에 두고,",
                "> 먼지 속에서 따뜻하게 한다,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 발이 그것을 부술 수 있음을 알지 못하며,",
                "> 들짐승이 그것을 밟을 수 있음을 알지 못한다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그녀는 자기 새끼를 자신의 것이 아닌 것처럼 가혹하게 대하며;",
                "> 그녀의 수고가 헛되지만, 그녀는 개의치 않는다,"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 하나님이 그녀에게 지혜를 주지 않으셨고,",
                "> 이해의 몫을 주지 않으셨기 때문이다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그녀가 날아오를 때,",
                "> 그녀는 말과 그 기수를 비웃는다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> “네가 말에게 힘을 주었느냐?",
                "> 그의 목에 흐르는 갈기를 장식하였느냐?"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 네가 그를 메뚜기처럼 뛰게 하였느냐?",
                "> 그의 장엄한 코김은 두렵다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그는 골짜기에서 발굽을 치며, 그의 힘을 자랑하며;",
                "> 싸움에 돌진한다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그는 두려움을 비웃고 겁내지 않으며;",
                "> 칼 앞에서도 물러서지 않는다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 화살통이 그에게 부딪히고,",
                "> 번쩍이는 창과 투창이 있다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그는 땅을 소리와 분노로 달리며,",
                "> 나팔 소리에 멈추지 않는다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 나팔 소리가 날 때마다 그는 ‘아하!’라고 외치며,",
                "> 멀리서 전투를 감지하고,",
                "> 대장의 천둥과 전쟁의 외침을 감지한다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> “매가 네 지혜로 날아오르며,",
                "> 남쪽을 향해 날개를 펼치느냐?"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 독수리가 네 명령으로 올라가며,",
                "> 높은 곳에 둥지를 트느냐?"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 그는 절벽에 머물며 밤을 보내고,",
                "> 바위의 틈, 접근할 수 없는 곳에 있다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 거기서 그는 먹이를 찾고;",
                "> 그의 눈은 멀리서 그것을 본다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 그의 새끼들도 피를 먹으며;",
                "> 죽임 당한 자가 있는 곳에, 그가 있다.”"
            ]
        }
    ]
}