{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “은을 위한 광산이 있고",
                "> 금을 정제하는 장소가 있나니."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 철은 땅에서 캐내고,",
                "> 구리는 돌에서 제련하느니라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 사람은 어둠의 끝을 가져오고,",
                "> 가장 먼 경계까지 찾아내며",
                "> 암흑과 깊은 그늘 속의 바위를 탐색하느니라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그는 거주지에서 멀리 갱도를 파고,",
                "> 발길에 잊혀진 곳에서;",
                "> 사람들로부터 멀리 떨어져 매달리고 흔들리느니라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 땅에서는 음식이 나오고,",
                "> 그 아래는 불처럼 뒤집히느니라."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그 바위는 사파이어를 내고,",
                "> 그 먼지는 금을 품고 있느니라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그 길은 맹금이 알지 못하며,",
                "> 매의 눈도 보지 못하였느니라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 교만한 짐승도 그 위를 다니지 아니하였고,",
                "> 사자도 그 위를 지나지 아니하였느니라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그는 부싯돌에 손을 대며;",
                "> 산을 그 뿌리에서 뒤집느니라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그는 바위 사이에 수로를 파고,",
                "> 그의 눈은 모든 귀중한 것을 발견하느니라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그는 흐르는 물을 막고,",
                "> 숨겨진 것을 빛으로 가져오느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> “그러나 지혜는 어디에서 발견될 수 있는가?",
                "> 명철의 장소는 어디인가?"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 인류는 그 가치를 알지 못하며,",
                "> 생존자의 땅에 있지 아니하니라."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 깊은 바다는 말하되, ‘그것은 내 안에 있지 않다’ 하며;",
                "> 바다는 말하되, ‘그것은 나와 함께 있지 않다’ 하느니라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 순금으로도 그것을 바꿀 수 없으며,",
                "> 은도 그 가치로 달 수 없느니라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 오빌의 금으로도 그것을 평가할 수 없으며,",
                "> 귀한 호마노나 사파이어로도 마찬가지니라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 금이나 유리도 그것에 비할 수 없으며,",
                "> 정금의 물건으로도 그것을 교환할 수 없느니라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 산호와 수정은 언급할 가치도 없으며;",
                "> 지혜의 얻음은 진주보다 더 귀중하니라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 구스의 황옥도 그것에 비할 수 없으며,",
                "> 순금으로도 그것을 평가할 수 없느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> “그러면 지혜는 어디에서 오는가?",
                "> 명철의 장소는 어디인가?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그것은 모든 생물의 눈에 숨겨져 있으며,",
                "> 하늘의 새에게서도 감추어져 있느니라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 멸망과 죽음이 말하되,",
                "> ‘우리 귀로 그 소문을 들었노라’ 하느니라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 하나님은 그 길을 아시며,",
                "> 그 장소를 아시느니라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 이는 그가 땅 끝까지 살피시며;",
                "> 하늘 아래 모든 것을 보시기 때문이니라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 그가 바람의 무게를 정하시고,",
                "> 물을 측량하시며,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 비에 경계를 정하시고,",
                "> 번개에 길을 정하셨을 때,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그가 그것을 보시고 선언하셨으며;",
                "> 그것을 세우시고 또한 시험하셨느니라."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 그리고 모든 인류에게 말씀하시기를,",
                "> ‘보라, 주님을 경외하는 것이 지혜요;",
                "> 악에서 떠나는 것이 명철이니라’ 하셨느니라.”"
            ]
        }
    ]
}