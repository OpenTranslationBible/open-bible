{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “네가 낚시로 리워야단을 끌어낼 수 있느냐,",
                "> 줄로 그의 혀를 눌러 놓을 수 있느냐?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 그의 코에 줄을 꿸 수 있느냐,",
                "> 갈고리로 그의 턱을 뚫을 수 있느냐?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 그가 너에게 여러 번 간청하겠느냐,",
                "> 부드러운 말로 너에게 말하겠느냐?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그가 너와 계약을 맺겠느냐?",
                "> 네가 그를 영원히 종으로 삼겠느냐?"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 네가 새처럼 그와 놀겠느냐,",
                "> 네 어린 여종들을 위해 그를 묶겠느냐?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 상인들이 그를 두고 흥정하겠느냐?",
                "> 그들이 그를 상인들 사이에 나누겠느냐?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 네가 작살로 그의 피부를 덮을 수 있느냐,",
                "> 낚시 창으로 그의 머리를 덮을 수 있느냐?"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 네 손을 그 위에 얹어라.",
                "> 전쟁을 기억하라; 다시는 시도하지 않을 것이다!"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 보라, 네 기대는 헛되다;",
                "> 그를 보고도 너는 낙담하겠느냐?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 아무도 그를 깨울 만큼 두려움이 없는 자가 없다;",
                "> 그러면 누가 내 앞에 설 수 있겠느냐?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 누가 나에게 주어서 내가 그에게 갚아야 하겠느냐?",
                "> 하늘 아래 있는 모든 것이 내 것이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> “나는 그의 사지에 대해 침묵하지 않을 것이다,",
                "> 그의 강력한 힘이나 그의 우아한 형체에 대해."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 누가 그의 외피를 벗길 수 있느냐?",
                "> 누가 그의 이중 갑옷을 뚫을 수 있느냐?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 누가 그의 입을 열 수 있느냐?",
                "> 그의 이는 경외감을 준다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그의 강한 비늘은 그의 자랑이다,",
                "> 단단히 봉합되어 있다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 각각이 서로 가까워서",
                "> 그 사이로 공기도 지나갈 수 없다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그것들은 서로 연결되어 있다;",
                "> 그것들은 서로 달라붙어 떨어질 수 없다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그의 재채기는 빛의 번쩍임을 내뿜고,",
                "> 그의 눈은 새벽의 광선과 같다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그의 입에서 타오르는 횃불이 나오고;",
                "> 불꽃이 튀어나온다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 그의 콧구멍에서 연기가 나며",
                "> 끓는 솥과 타는 갈대에서처럼."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그의 숨은 숯을 붙이고,",
                "> 불꽃이 그의 입에서 나온다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그의 목에는 힘이 있으며,",
                "> 두려움이 그 앞에서 움직인다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 그의 살의 주름은 단단히 결합되어,",
                "> 그 위에 견고하고 움직이지 않는다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그의 마음은 돌처럼 단단하며,",
                "> 참으로 하부 맷돌처럼 단단하다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 그가 일어날 때, 강한 자들은 두려워하며;",
                "> 충돌 때문에 그들은 당황한다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 그를 치는 칼은 이기지 못하며,",
                "> 창이나 화살이나 투창도 마찬가지다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그는 철을 지푸라기처럼 여기며,",
                "> 청동을 썩은 나무처럼 여긴다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 화살은 그를 도망치게 하지 못하며;",
                "> 돌팔매는 그에게 겨처럼 여겨진다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 몽둥이는 겨로 여겨지며;",
                "> 그는 투창의 소리에 웃는다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 그의 아랫부분은 날카로운 도자기 조각 같으며;",
                "> 그는 진흙 위에 타작기처럼 자신을 펼친다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 그는 깊은 곳을 솥처럼 끓게 하며;",
                "> 그는 바다를 향유의 솥처럼 만든다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 그의 뒤에는 빛나는 흔적을 남긴다;",
                "> 깊은 곳이 백발인 것처럼 보일 것이다."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 땅 위에는 그와 같은 것이 없으며,",
                "> 두려움 없는 생물이다."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 그는 모든 높은 것을 살피며;",
                "> 그는 모든 교만한 자의 왕이다.”"
            ]
        }
    ]
}