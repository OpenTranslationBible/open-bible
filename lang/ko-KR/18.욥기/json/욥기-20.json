{
    "book": "욥기",
    "chapter": 20,
    "verses": [
        {
            "verse": 1,
            "text": [
                "나아마 사람 소발이 대답하여 이르되,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"내 불안한 생각이 나로 하여금 대답하게 하니,",
                "> 이는 내 깊은 불안 때문이라."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 나를 모욕하는 책망을 들었으므로,",
                "> 내 이해의 통찰이 나로 하여금 답하게 하느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 네가 이 일을 옛적부터 알지 못하느냐,",
                "> 사람이 땅에 세워진 때부터,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 악인의 환희는 잠시뿐이며,",
                "> 경건치 않은 자의 기쁨은 순간적임을?"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그의 자만이 하늘에 닿고",
                "> 그의 머리가 구름에 닿을지라도,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그는 자신의 배설물처럼 영원히 사라지리니;",
                "> 그를 본 자들이 '그가 어디 있느냐?' 하리라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그는 꿈처럼 사라져 찾을 수 없고;",
                "> 밤의 환상처럼 쫓겨가리라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그를 본 눈이 다시는 그를 보지 못할 것이며;",
                "> 그의 처소는 더 이상 그를 보지 못하리라."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그의 자녀들은 가난한 자의 은혜를 구할 것이며,",
                "> 그의 손은 그의 재물을 되돌려줄 것이라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 한때 젊음의 활기로 가득 찼던 그의 뼈는",
                "> 그와 함께 먼지 속에 누우리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"비록 악행이 그의 입에 달고",
                "> 그가 그것을 혀 밑에 숨길지라도,"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그가 그것을 아끼고 놓지 않으며,",
                "> 입에 간직할지라도,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그의 음식은 그의 위에서 신물이 되어;",
                "> 그의 속에서 독사의 독이 되리라."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그는 재물을 삼키지만,",
                "> 토해내리니;",
                "> 하나님이 그의 배에서 그것을 강제로 내쫓으시리라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그는 독사의 독을 빨아들이리니;",
                "> 독사의 혀가 그를 쓰러뜨리리라."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그는 시냇물을 보지 못하리니,",
                "> 꿀과 크림이 흐르는 강들을 보지 못하리라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그는 수고하여 얻은 것을 되돌려주고 먹지 못하리니;",
                "> 그의 거래에서 얻은 재물을 즐기지 못하리라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 이는 그가 가난한 자를 짓밟고 버렸으며;",
                "> 그가 짓지 않은 집을 빼앗았음이라."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> \"그가 자기 안에서 평안을 알지 못하였으므로,",
                "> 그가 원하는 것을 아무것도 간직하지 못하리라."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그가 삼킬 것이 아무것도 남지 않으리니;",
                "> 그러므로 그의 번영이 지속되지 못하리라."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그의 풍요로움 가운데서 고난이 그를 덮치리니;",
                "> 비참함의 모든 힘이 그에게 닥치리라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 그가 배를 채울 때, 하나님이 그의 맹렬한 분노를 그에게 쏟으시리니",
                "> 그가 먹고 있을 때 비를 내리시리라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그가 철 무기를 피할지라도,",
                "> 청동 화살이 그를 찌르리라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 그것이 뽑혀 그의 등에서 나오고,",
                "> 번쩍이는 점이 그의 간에서 나오리니;",
                "> 공포가 그에게 닥치리라."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 그의 보물에는 완전한 어둠이 예비되어 있으며;",
                "> 부채질하지 않은 불이 그를 삼키고",
                "> 그의 장막에 남은 것을 삼키리라."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 하늘이 그의 악행을 드러내고,",
                "> 땅이 그를 대적하여 일어나리라."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 그의 집의 증가는 흘러가리니;",
                "> 그의 소유는 하나님의 진노의 날에 사라지리라."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 이것이 하나님께서 악인에게 할당하신 몫이요,",
                "> 하나님께서 그에게 정하신 유산이라.\""
            ]
        }
    ]
}