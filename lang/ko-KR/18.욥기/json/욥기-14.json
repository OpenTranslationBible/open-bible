{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> “여자에게서 태어난 사람은",
                "> 사는 날이 짧고 고난이 가득합니다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 꽃처럼 피었다가 시들며,",
                "> 그림자처럼 사라져서 오래 가지 못합니다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 주께서도 그들을 주의 깊게 보시고",
                "> 자신과 함께 심판하십니다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 누가 부정한 것에서 정결한 것을 낼 수 있겠습니까?",
                "> 아무도 없습니다!"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 그들의 날이 정해졌고,",
                "> 그들의 달 수가 주께 알려졌으며,",
                "> 그들이 넘지 못할 경계를 주께서 정하셨습니다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그들에게서 주의 눈을 돌리셔서 그들이 쉴 수 있게 하소서,",
                "> 그들이 품꾼처럼 그들의 날을 마칠 때까지."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> “나무에게는 희망이 있습니다,",
                "> 베어져도 다시 싹이 나며,",
                "> 그 가지가 끊어지지 않습니다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그 뿌리가 땅 속에서 늙고,",
                "> 그 그루터기가 마른 흙에서 죽어도,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 물 냄새를 맡고 싹이 나서",
                "> 어린 식물처럼 가지를 뻗습니다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그러나 사람이 죽고 낮아지면,",
                "> 사람이 숨을 거두면 어디에 있습니까?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 바다에서 물이 사라지고,",
                "> 강이 마르고 말라버리듯이,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 사람도 누워서 일어나지 못합니다.",
                "> 하늘이 더 이상 존재하지 않을 때까지,",
                "> 그들은 깨어나지 않으며 잠에서 일어나지 못합니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> “주께서 나를 스올에 숨기시고,",
                "> 주의 진노가 지나갈 때까지 나를 감추시며,",
                "> 나를 위해 시간을 정하시고 나를 기억해 주시기를 바랍니다!"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 사람이 죽으면, 다시 살겠습니까?",
                "> 나의 고난의 모든 날 동안 나는 기다릴 것입니다",
                "> 나의 새로워짐이 올 때까지."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 주께서 부르시면, 내가 대답할 것입니다;",
                "> 주께서 주의 손으로 만드신 것을 그리워하실 것입니다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 지금 주께서 나의 발걸음을 세시고,",
                "> 나의 죄를 감시하지 않으십니다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 나의 허물은 주머니에 봉해져 있고,",
                "> 주께서 나의 죄악을 덮으십니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> “그러나 산은 무너져 내리고,",
                "> 바위는 그 자리에서 옮겨집니다;"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 물은 돌을 침식하고,",
                "> 그 급류는 땅의 흙을 씻어내립니다;",
                "> 그래서 주께서 사람의 희망을 줄이십니다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 주께서 계속해서 그들을 압도하시고 그들이 떠나가게 하십니다;",
                "> 주께서 그들의 모습을 바꾸시고 그들을 보내십니다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그들의 자녀가 영예를 얻어도 그들은 알지 못하며;",
                "> 그들이 하찮아져도 그들은 깨닫지 못합니다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그러나 그들의 몸은 고통을 느끼고,",
                "> 그들의 영혼은 그것을 슬퍼합니다.”"
            ]
        }
    ]
}