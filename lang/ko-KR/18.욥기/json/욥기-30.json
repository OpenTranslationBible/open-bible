{
    "book": "욥기",
    "chapter": 30,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"그러나 이제는 나보다 어린 자들이 나를 조롱하니,",
                "> 그들의 아버지들을 내 양 떼의 개들과 함께 두지 않았던 자들이다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 참으로 그들의 손의 힘이 내게 무슨 유익이 있었던가?",
                "> 그들의 기력은 이미 떠나갔다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 그들은 가난과 굶주림으로 야위었으며—",
                "> 황폐와 황무지에서 밤에 마른 땅을 갉아먹는 자들이다,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그들은 덤불에서 소금을 모으고,",
                "> 그들의 음식은 싸리나무 뿌리이다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 그들은 공동체에서 쫓겨나며;",
                "> 사람들이 도둑을 대하듯 그들을 외친다,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그래서 그들은 황폐한 골짜기에 거주하며,",
                "> 땅과 바위의 구멍에 살고 있다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 덤불 사이에서 울부짖고;",
                "> 잡초 아래에서 함께 모여 있다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 어리석은 자들의 아들, 이름 없는 자들의 아들,",
                "> 그들은 땅에서 쫓겨났다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 이제 나는 그들의 조롱거리가 되었고,",
                "> 나는 그들에게 속담이 되었다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그들은 나를 싫어하고 나에게서 멀리하며,",
                "> 내 얼굴에 침 뱉는 것을 주저하지 않는다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그가 그의 활시위를 풀고 나를 괴롭히셨으므로,",
                "> 그들은 내 앞에서 절제를 버렸다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 오른쪽에서 그들의 무리가 일어나며;",
                "> 그들은 내 발을 밀어내고 나를 대적하여 파괴의 길을 쌓는다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그들은 내 길을 방해하고,",
                "> 내 몰락에서 이익을 얻으며;",
                "> 아무도 그들을 막지 않는다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그들은 벽의 틈처럼 나에게 다가오며;",
                "> 폭풍 속에서 전진한다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 갑작스러운 공포가 나를 향해 돌이켜졌으며;",
                "> 그들은 바람처럼 내 명예를 추격하고,",
                "> 내 번영은 구름처럼 사라졌다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 이제 내 영혼이 내 안에서 쏟아졌고;",
                "> 고난의 날들이 나를 덮쳤다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 밤에는 그것이 내 뼈를 꿰뚫고,",
                "> 내 끊임없는 고통이 쉬지 않는다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 큰 힘으로 내 옷이 뒤틀리고;",
                "> 그것이 내 코트의 깃처럼 나를 묶는다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그가 나를 진흙 속에 던지셨고,",
                "> 나는 먼지와 재로 줄어들었다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 내가 당신께 도움을 외쳐도, 당신은 응답하지 않으시며;",
                "> 내가 일어서도, 당신은 나를 향해 시선을 돌리신다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 당신은 나에게 가혹하게 되셨고;",
                "> 당신의 손의 힘으로 나를 박해하신다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 당신은 나를 바람에 들어 올리시고 그것에 타게 하시며,",
                "> 폭풍 속에 나를 흩으신다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 나는 당신이 나를 죽음으로 데려가실 것을 알고 있으며,",
                "> 모든 살아 있는 자들이 모이는 집으로 데려가실 것을 알고 있다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그러나 누가 폐허 속에서 손을 뻗지 않겠는가,",
                "> 또는 그의 재난 속에서 도움을 외치지 않겠는가?"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 내가 고난 당한 자를 위해 울지 않았던가?",
                "> 내 영혼이 궁핍한 자를 위해 슬퍼하지 않았던가?"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 내가 좋은 것을 바랄 때, 악이 왔고;",
                "> 내가 빛을 기다릴 때, 어둠이 왔다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 내 내장은 뒤틀리고 결코 가만히 있지 않으며;",
                "> 고난의 날들이 나를 대면한다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 나는 위로 없이 슬픔 속에서 방황하며;",
                "> 나는 회중에서 일어서서 도움을 간청한다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 나는 자칼과 친척이 되었고,",
                "> 타조의 동료가 되었다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 내 피부는 내 위에 검게 변했고,",
                "> 내 뼈는 열로 타오르고 있다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 그래서 내 하프는 애도의 소리에 맞춰졌고,",
                "> 내 피리는 탄식의 소리에 맞춰졌다."
            ]
        }
    ]
}