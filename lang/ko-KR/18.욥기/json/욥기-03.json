{
    "book": "욥기",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "이 일 후에 욥이 입을 열어 자기의 생일을 저주하니라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "욥이 말하여 이르되:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"나의 생일이 사라지며,",
                "> '사내아이가 잉태되었다'고 말한 그 밤도 사라지기를 원하노라."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그 날이 어둠이 되게 하라;",
                "> 위에 계신 하나님이 그것을 돌아보지 않으시며,",
                "> 그 위에 빛이 비치지 않게 하라."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 어둠과 깊은 그늘이 그것을 차지하게 하라;",
                "> 구름이 그 위에 머무르게 하라;",
                "> 그 날의 흑암이 그것을 두렵게 하라."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그 밤도 짙은 어둠이 그것을 차지하게 하라;",
                "> 그것이 해의 날들 중에 속하지 않게 하며,",
                "> 달들 중에 기록되지 않게 하라."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 보라, 그 밤이 황폐하게 되게 하라;",
                "> 그 안에서 기쁜 소리가 들리지 않게 하라."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 날을 저주하는 자들이 그 날을 저주하게 하라,",
                "> 리워야단을 일으킬 준비가 된 자들이 그리하게 하라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그 아침 별들이 어두워지게 하라;",
                "> 빛을 바라지만 얻지 못하게 하며,",
                "> 새벽의 첫 빛을 보지 못하게 하라,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 이는 그것이 내 어머니의 태의 문을 닫지 아니하였고,",
                "> 내 눈에서 고난을 숨기지 아니하였음이라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> \"어찌하여 내가 태어날 때 죽지 아니하였던가,",
                "> 태에서 나와서 숨지지 아니하였던가?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 어찌하여 무릎이 나를 받았던가,",
                "> 어찌하여 내가 젖을 빨았던가?"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그렇지 아니하면 내가 이제 평안히 누워서 쉬었을 것이니,",
                "> 잠들어 평안을 누렸을 것이니라,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 땅의 왕들과 모사들과 함께,",
                "> 그들이 스스로를 위해 폐허를 세운 자들과 함께,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 금을 가진 왕자들과 함께,",
                "> 그들의 집을 은으로 채운 자들과 함께."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 혹은 내가 숨겨진 사산아처럼 되지 않았던가,",
                "> 빛을 보지 못한 유아들처럼."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 거기서 악한 자들이 소란을 멈추며,",
                "> 피곤한 자들이 쉼을 얻느니라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 갇힌 자들이 함께 평안히 있으며;",
                "> 그들은 압제자의 소리를 듣지 아니하느니라."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 작은 자와 큰 자가 거기 있으며,",
                "> 종이 그의 주인에게서 해방되느니라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> \"어찌하여 고난 당한 자에게 빛을 주며,",
                "> 영혼이 괴로운 자에게 생명을 주는가,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 죽기를 바라는 자에게, 그러나 그것이 오지 아니하며,",
                "> 숨겨진 보물보다 더 그것을 찾는 자에게,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 그들이 무덤을 발견할 때 기뻐하고,",
                "> 즐거워하며 뛰노는가?"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 어찌하여 길이 숨겨진 사람에게 빛을 주며,",
                "> 하나님이 그를 둘러싸신 자에게 빛을 주는가?"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 이는 나의 탄식이 음식보다 앞서 오며,",
                "> 나의 신음이 물같이 쏟아짐이라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 내가 두려워하던 그것이 내게 임하였고,",
                "> 내가 무서워하던 그것이 내게 닥쳤음이라."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 나는 평안도 없고, 고요함도 없고,",
                "> 쉼도 없고, 오직 혼란만 있느니라.\""
            ]
        }
    ]
}