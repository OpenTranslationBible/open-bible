{
    "book": "Job",
    "chapter": 36,
    "verses": [
        {
            "verse": 1,
            "text": [
                "엘리후가 계속 말하여 이르되:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"조금만 더 참아 주십시오,",
                "> 내가 하나님의 편에서 더 할 말이 있음을 보여드리겠습니다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 내가 먼 곳에서 지식을 가져와서",
                "> 내 창조주께 의를 돌리겠습니다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 내 말이 거짓이 아님을 확신하십시오;",
                "> 지식이 완전한 이가 당신과 함께 있습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 보십시오, 하나님은 강하시며 아무도 버리지 않으십니다;",
                "> 그분은 힘과 이해가 강하십니다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그분은 악인을 보호하지 않으시고,",
                "> 고난받는 자의 권리를 지키십니다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그분은 의인에게서 눈을 돌리지 않으시고;",
                "> 그들을 왕들과 함께 보좌에 앉히시며",
                "> 영원히 높이십니다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 만약 그들이 사슬에 매이고",
                "> 고난의 줄에 걸리면,"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그분은 그들의 행위와",
                "> 그들이 교만하게 행한 죄를 그들에게 알리십니다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그분은 그들의 귀를 열어 교훈을 듣게 하시고",
                "> 죄악에서 돌이키라고 명령하십니다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 만약 그들이 듣고 그분을 섬기면,",
                "> 그들은 그들의 날을 번영 가운데 보내고",
                "> 그들의 해를 행복 가운데 보낼 것입니다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그러나 만약 그들이 듣지 않으면, 그들은 칼에 의해 끝을 맞이하고",
                "> 이해 없이 사라질 것입니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 마음이 경건하지 않은 자들은 분노를 품고;",
                "> 그분이 그들을 묶을 때 도움을 요청하지 않습니다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그들은 젊어서 죽고,",
                "> 그들의 생명은 신전의 남창들 가운데 끝납니다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그분은 고난받는 자를 그들의 고통 속에서 구하시고",
                "> 억압의 때에 그들의 귀를 여십니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 참으로, 그분은 당신을 고난의 턱에서 끌어내어",
                "> 제약 없는 넓은 곳으로 인도하시며,",
                "> 당신의 식탁은 풍성한 음식으로 가득 차 있습니다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그러나 이제 당신은 악인에게 마땅한 심판으로 가득 차 있습니다;",
                "> 심판과 정의가 당신을 붙잡았습니다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 분노가 당신을 조롱으로 유혹하지 않도록 주의하십시오,",
                "> 큰 속전이 당신을 돌이키지 않게 하십시오."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 당신의 재산이나 당신의 힘의 노력이 당신을 고난에서 지켜줄 수 있습니까?"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 사람들이 그들의 자리에서 사라지는 밤을 갈망하지 마십시오."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 고난보다 악으로 돌아서는 것을 선호하는 것처럼 보이는 것을 조심하십시오."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 보십시오, 하나님은 그분의 능력에서 최고이십니다;",
                "> 누가 그분처럼 가르칠 수 있겠습니까?"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 누가 그분의 길을 그분에게 정해주었으며,",
                "> 누가 '당신이 잘못했다'고 말했습니까?"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그분의 일을 찬양하는 것을 기억하십시오,",
                "> 사람들이 찬양의 노래로 불렀습니다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 모든 인류가 그것을 보았습니다;",
                "> 인류는 멀리서 그것을 바라봅니다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 보십시오, 하나님은 우리의 이해를 초월하여 위대하십니다;",
                "> 그분의 해수는 헤아릴 수 없습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그분은 물방울을 끌어올리시고,",
                "> 그것들은 하늘의 시내에서 비로 내립니다,"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 구름은 그들의 습기를 쏟아내고,",
                "> 풍성한 소나기가 인류에게 내립니다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 누가 구름의 확산을 이해할 수 있으며,",
                "> 그분의 장막에서 나오는 천둥을 이해할 수 있습니까?"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 보십시오, 그분은 자신의 주변에 번개를 흩으시고",
                "> 바다의 깊이를 덮으십니다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 이로써 그분은 나라들을 다스리시고",
                "> 풍성한 음식을 제공합니다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 그분은 번개로 손을 채우시고",
                "> 그것이 목표를 치도록 명령하십니다."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 그분의 천둥은 폭풍을 알립니다;",
                "> 심지어 가축들도 그것의 접근을 압니다."
            ]
        }
    ]
}