{
    "book": "욥기",
    "chapter": 18,
    "verses": [
        {
            "verse": 1,
            "text": [
                "그때 수아 사람 빌닷이 대답하여 말하였다:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> “너희가 언제까지 말을 찾겠느냐?",
                "> 지혜롭게 행동하라, 그러면 우리가 대화할 수 있다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 왜 우리가 짐승으로 여겨지며,",
                "> 너희 눈에 어리석은 자로 간주되느냐?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 너는 분노하여 자신을 찢는 자인데,",
                "> 땅이 너를 위해 버려져야 하겠느냐,",
                "> 또는 바위가 그 자리에서 옮겨져야 하겠느냐?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> “악인의 빛은 꺼지고,",
                "> 그의 불꽃은 빛을 잃는다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그의 장막 안의 빛은 어두워지고,",
                "> 그 위의 등불은 꺼진다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그의 활기찬 걸음은 줄어들고,",
                "> 그의 계획은 그를 넘어뜨린다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그의 발은 그를 그물로 이끌고,",
                "> 그는 그물의 망에 걸린다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 덫이 그의 발꿈치를 잡고,",
                "> 함정이 그를 단단히 붙든다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 올가미가 땅에 그를 위해 숨겨져 있고,",
                "> 덫이 그의 길에 놓여 있다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 갑작스러운 공포가 그를 사방에서 놀라게 하고",
                "> 그의 모든 발걸음을 쫓는다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그의 힘은 소진되고,",
                "> 재앙이 그의 곁에 준비되어 있다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그것이 그의 피부의 일부를 삼키고;",
                "> 죽음의 맏이가 그의 팔다리를 먹어치운다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 그는 그의 장막의 안전에서 찢겨나가",
                "> 공포의 왕 앞에 인도된다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 유황이 그의 거처에 뿌려지고;",
                "> 불이 그의 장막을 삼킨다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그의 뿌리는 아래에서 시들고,",
                "> 그의 가지는 위에서 시든다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그의 기억은 땅에서 사라지고,",
                "> 그는 땅에 이름을 남기지 않는다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그는 빛에서 어둠으로 던져지고",
                "> 세상에서 제거된다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그는 자기 백성 가운데 자손이나 후손이 없고,",
                "> 그가 살던 곳에 살아남은 자가 없다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 서쪽에 있는 자들은 그의 운명에 놀라고,",
                "> 동쪽에 있는 자들은 두려움에 사로잡힌다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 분명히 이것이 악인의 거처이며,",
                "> 하나님을 알지 못하는 자의 처소이다.”"
            ]
        }
    ]
}