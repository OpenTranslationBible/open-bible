{
    "book": "예레미야 애가",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "나는 그의 진노의 막대기 아래에서 고난을 본 사람입니다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "그가 나를 몰아내시고 빛이 아닌 어둠 속을 걷게 하셨습니다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "참으로 그가 하루 종일 반복하여 그의 손을 나를 대적하여 돌리셨습니다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "그가 내 피부와 살을 늙게 하시고 내 뼈를 부수셨습니다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "그가 나를 포위하시고 고통과 쓰라림으로 둘러싸셨습니다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "그가 나를 오래된 죽은 자들처럼 어둠 속에 살게 하셨습니다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "그가 나를 가두어 나갈 수 없게 하시고, 나를 쇠사슬로 무겁게 하셨습니다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "내가 부르짖고 도움을 요청할 때에도 내 기도가 들리지 않습니다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "그가 돌로 내 길을 막으시고 내 길을 구부러지게 하셨습니다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "그는 숨어 기다리는 곰 같고, 숨어 있는 사자 같습니다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "그가 나를 길에서 벗어나게 하시고 나를 찢어 조각내어 황폐하게 하셨습니다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "그가 활을 굽혀 나를 그의 화살의 목표로 삼으셨습니다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "그가 그의 화살통에서 내 마음을 꿰뚫으셨습니다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "나는 내 모든 백성의 조롱거리가 되었고, 그들이 하루 종일 나를 노래로 비웃습니다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "그가 나를 쓰라림으로 가득 채우시고 쑥을 마시게 하셨습니다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "그가 자갈로 내 이를 부수시고 나를 먼지 속에 눌러 넣으셨습니다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "내 영혼은 평안을 알지 못하고, 나는 행복이 무엇인지 잊었습니다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "그래서 내가 말하기를, \"내 영광이 사라졌고, 주님으로부터의 내 희망도 사라졌다\" 하였습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "내 고난과 내 방랑, 쓰라림과 쑥을 기억하소서."
            ]
        },
        {
            "verse": 20,
            "text": [
                "내 영혼이 그것들을 잘 기억하고 내 안에서 낙심합니다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "그러나 내가 이것을 마음에 떠올리므로 희망을 가집니다:"
            ]
        },
        {
            "verse": 22,
            "text": [
                "주의 자비는 참으로 끝이 없으며, 그의 긍휼은 결코 실패하지 않습니다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "그것들은 매일 아침 새로워지고, 주의 신실하심은 큽니다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "\"주는 나의 몫이시라\" 내 영혼이 선언하니, \"그러므로 내가 그를 기다리리라.\""
            ]
        },
        {
            "verse": 25,
            "text": [
                "주는 그를 바라는 자에게, 그를 찾는 사람에게 선을 베푸십니다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "주의 구원을 조용히 기다리는 것이 유익합니다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "젊은 시절에 멍에를 지는 것이 사람에게 유익합니다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "그가 홀로 앉아 침묵하라, 이는 주께서 그것을 그에게 지우셨기 때문입니다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "그가 먼지 속에 얼굴을 묻으라—아마도 희망이 있을 것입니다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "그가 그를 치는 자에게 뺨을 내어주고, 치욕으로 가득 차게 하라."
            ]
        },
        {
            "verse": 31,
            "text": [
                "그러나 주의 뜻은 영원히 버리는 것이 아닙니다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "비록 그가 슬픔을 주시더라도, 그의 풍성한 자비에 따라 긍휼을 보이실 것입니다."
            ]
        },
        {
            "verse": 33,
            "text": [
                "이는 그가 사람의 자녀들에게 고난이나 슬픔을 기꺼이 주지 않으시기 때문입니다."
            ]
        },
        {
            "verse": 34,
            "text": [
                "땅의 모든 죄수를 발로 밟는 것,"
            ]
        },
        {
            "verse": 35,
            "text": [
                "지극히 높으신 분 앞에서 사람에게 정의를 부정하는 것,"
            ]
        },
        {
            "verse": 36,
            "text": [
                "소송에서 누군가를 속이는 것—이런 것들을 주께서 승인하지 않으십니다."
            ]
        },
        {
            "verse": 37,
            "text": [
                "주께서 명령하지 않으시면 누가 말하고 그것이 이루어질 수 있겠습니까?"
            ]
        },
        {
            "verse": 38,
            "text": [
                "재앙과 좋은 것이 모두 지극히 높으신 분의 입에서 나오지 않습니까?"
            ]
        },
        {
            "verse": 39,
            "text": [
                "어떤 살아 있는 사람이 자신의 죄로 인해 벌을 받을 때 불평해야 합니까?"
            ]
        },
        {
            "verse": 40,
            "text": [
                "우리의 길을 살피고 시험하여 주께로 돌아가자."
            ]
        },
        {
            "verse": 41,
            "text": [
                "우리의 마음을 들어 올리고 하늘에 계신 하나님께 우리의 손을 들어 올리자;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "우리가 죄를 짓고 반역하였으므로, 주께서 용서를 거두셨습니다."
            ]
        },
        {
            "verse": 43,
            "text": [
                "주께서 분노로 자신을 감싸시고 우리를 추격하셨으며, 자비 없이 우리를 죽이셨습니다."
            ]
        },
        {
            "verse": 44,
            "text": [
                "주께서 구름으로 자신을 숨기셔서 어떤 기도도 통과할 수 없게 하셨습니다."
            ]
        },
        {
            "verse": 45,
            "text": [
                "주께서 우리를 백성들 가운데서 찌꺼기와 쓰레기로 만드셨습니다."
            ]
        },
        {
            "verse": 46,
            "text": [
                "우리의 모든 적들이 입을 열어 우리를 대적하여 말했습니다."
            ]
        },
        {
            "verse": 47,
            "text": [
                "우리는 공포와 함정, 파괴와 파멸을 만났습니다."
            ]
        },
        {
            "verse": 48,
            "text": [
                "내 백성의 딸의 파멸로 인해 내 눈에서 눈물의 강이 흐릅니다."
            ]
        },
        {
            "verse": 49,
            "text": [
                "내 눈은 멈추지 않고, 쉬지 않고 흐를 것입니다,"
            ]
        },
        {
            "verse": 50,
            "text": [
                "주께서 하늘에서 보시고 보실 때까지."
            ]
        },
        {
            "verse": 51,
            "text": [
                "내가 보는 것이 내 도시의 모든 딸들로 인해 내 영혼에 슬픔을 줍니다."
            ]
        },
        {
            "verse": 52,
            "text": [
                "이유 없이 나의 적들이 새처럼 나를 추격했습니다."
            ]
        },
        {
            "verse": 53,
            "text": [
                "그들이 내 생명을 구덩이에 넣고 돌을 던졌습니다;"
            ]
        },
        {
            "verse": 54,
            "text": [
                "물이 내 머리 위로 닫히고, 나는 끊어졌다고 생각했습니다."
            ]
        },
        {
            "verse": 55,
            "text": [
                "내가 주의 이름을 불렀습니다, 주님, 구덩이의 깊은 곳에서."
            ]
        },
        {
            "verse": 56,
            "text": [
                "주께서 내 간청을 들으셨습니다: \"내 부르짖음에 귀를 막지 마소서.\""
            ]
        },
        {
            "verse": 57,
            "text": [
                "내가 주를 부를 때 주께서 가까이 오셔서 나를 안심시키셨습니다, \"두려워하지 말라.\""
            ]
        },
        {
            "verse": 58,
            "text": [
                "주님, 주께서 내 사건을 맡으셨습니다; 주께서 내 생명을 회복하셨습니다."
            ]
        },
        {
            "verse": 59,
            "text": [
                "주님, 주께서 나에게 행해진 잘못을 보셨습니다. 내 사건을 지지하소서!"
            ]
        },
        {
            "verse": 60,
            "text": [
                "주께서 그들의 모든 복수, 나를 대적한 모든 계략을 보셨습니다."
            ]
        },
        {
            "verse": 61,
            "text": [
                "주님, 주께서 그들의 모욕을 아셨습니다, 나를 대적한 모든 음모를—"
            ]
        },
        {
            "verse": 62,
            "text": [
                "나를 공격하는 자들의 입술과 그들의 속삭임이 하루 종일 나를 대적합니다."
            ]
        },
        {
            "verse": 63,
            "text": [
                "그들의 앉고 일어섬을 보소서; 나는 그들의 조롱 노래입니다."
            ]
        },
        {
            "verse": 64,
            "text": [
                "그들의 손의 행위에 따라 그들에게 갚으소서, 주님."
            ]
        },
        {
            "verse": 65,
            "text": [
                "그들의 마음에 베일을 씌우시고, 주의 저주가 그들 위에 있게 하소서!"
            ]
        },
        {
            "verse": 66,
            "text": [
                "그들을 분노로 추격하시고 주의 하늘 아래에서 그들을 제거하소서."
            ]
        }
    ]
}