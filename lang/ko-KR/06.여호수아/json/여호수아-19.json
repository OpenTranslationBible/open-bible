{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "둘째 제비는 시므온 지파에게 그 가족대로 뽑혔으니, 그들의 기업은 유다 지파의 기업 중에 있더라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "그들의 기업은 브엘세바(또는 세바), 몰라다,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "하살 수알, 발라, 에셈,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "엘돌랏, 벧훌, 호르마,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "시글락, 벧 마르가봇, 하살 수사,"
            ]
        },
        {
            "verse": 6,
            "text": [
                "벧 르바옷, 사루헨; 열세 성읍과 그 마을들이며,"
            ]
        },
        {
            "verse": 7,
            "text": [
                "아인, 림몬, 에델, 아산; 네 성읍과 그 마을들이며—"
            ]
        },
        {
            "verse": 8,
            "text": [
                "또한 이 성읍들 주위의 모든 마을들, 곧 바알랏 브엘(네겝의 라마)까지라. 이것이 그들의 가족대로 받은 시므온 지파의 기업이었더라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "시므온의 기업은 유다의 몫에서 취한 것이니, 이는 유다 자손의 분깃이 그들에게 너무 많으므로 시므온 자손이 그들의 기업을 유다의 기업 중에서 받았음이라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "셋째 제비는 스불론 자손에게 그 가족대로 뽑혔으니, 그들의 기업의 경계는 사릿까지라."
            ]
        },
        {
            "verse": 11,
            "text": [
                "그들의 경계가 서쪽으로 올라가서 마랄라에 이르고, 다베셋에 닿으며, 욧느암 앞 시내에 이르며,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "사릿에서 동쪽으로 돌아 해 뜨는 쪽으로 기슬롯 다볼 경계에 이르고, 다브라스로 나아가서 야비아에 이르며,"
            ]
        },
        {
            "verse": 13,
            "text": [
                "거기서 동쪽으로 가드 헤벨과 에트 가신에 이르고, 림몬으로 나아가서 느아로 굽어지며,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "북쪽으로 돌아 한나돈에 이르고, 입다엘 골짜기에 이르러 끝이 나며,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "또한 갓닷, 나할랄, 시므론, 이달라, 베들레헴을 포함하니, 열두 성읍과 그 마을들이라."
            ]
        },
        {
            "verse": 16,
            "text": [
                "이 성읍들과 그 마을들이 스불론 자손이 그 가족대로 받은 기업이었더라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "넷째 제비는 잇사갈 자손에게 그 가족대로 뽑혔더라."
            ]
        },
        {
            "verse": 18,
            "text": [
                "그들의 지경은 이스르엘, 그술롯, 수넴,"
            ]
        },
        {
            "verse": 19,
            "text": [
                "하바라임, 시온, 아나하랏,"
            ]
        },
        {
            "verse": 20,
            "text": [
                "랍빗, 기시온, 에베스,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "레멧, 엔간님, 엔핫다, 벧 바세스며,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "그 경계는 다볼, 사하수마, 벧 세메스에 닿고, 요단에서 끝나니, 열여섯 성읍과 그 마을들이라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "이 성읍들과 그 마을들이 잇사갈 자손이 그 가족대로 받은 기업이었더라."
            ]
        },
        {
            "verse": 24,
            "text": [
                "다섯째 제비는 아셀 자손에게 그 가족대로 뽑혔더라."
            ]
        },
        {
            "verse": 25,
            "text": [
                "그들의 지경은 헬갓, 할리, 베텐, 악삽,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "알람멜렉, 아맛, 미살이며, 서쪽으로는 갈멜과 시홀 립낫에 닿으며,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "동쪽으로는 벧 다곤에 돌아 스불론과 입다엘 골짜기에 닿고, 북쪽으로는 벧 에멕과 느이엘에 이르러 좌측으로 가불을 지나며,"
            ]
        },
        {
            "verse": 28,
            "text": [
                "에브론, 르홉, 하몬, 가나에 이르고, 큰 시돈까지 이르며,"
            ]
        },
        {
            "verse": 29,
            "text": [
                "그 경계가 라마로 돌아 견고한 성읍 두로에 이르고, 호사로 돌아서 끝이 바다에 이르며, 악십 지방에 이르며,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "또한 우마, 아벡, 르홉을 포함하니, 스물두 성읍과 그 마을들이라."
            ]
        },
        {
            "verse": 31,
            "text": [
                "이 성읍들과 그 마을들이 아셀 자손이 그 가족대로 받은 기업이었더라."
            ]
        },
        {
            "verse": 32,
            "text": [
                "여섯째 제비는 납달리 자손에게 그 가족대로 뽑혔더라."
            ]
        },
        {
            "verse": 33,
            "text": [
                "그들의 경계는 헬렙에서 시작하여 사아난님에 있는 큰 나무에 이르고, 아다미 느겝과 얍느엘을 지나 라굼에 이르고, 요단에서 끝나며,"
            ]
        },
        {
            "verse": 34,
            "text": [
                "서쪽으로 돌아 아스놋 다볼에 이르고, 훅곡에 이르러 끝이 나며, 남쪽으로는 스불론에 닿고, 서쪽으로는 아셀에 닿으며, 동쪽으로는 요단에 닿으며,"
            ]
        },
        {
            "verse": 35,
            "text": [
                "견고한 성읍은 싯딤, 세르, 하맛, 락갓, 긴네렛,"
            ]
        },
        {
            "verse": 36,
            "text": [
                "아다마, 라마, 하솔,"
            ]
        },
        {
            "verse": 37,
            "text": [
                "게데스, 에드레이, 엔하솔,"
            ]
        },
        {
            "verse": 38,
            "text": [
                "이론, 믹다엘, 호렘, 벧 아낫, 벧 세메스니, 열아홉 성읍과 그 마을들이라."
            ]
        },
        {
            "verse": 39,
            "text": [
                "이 성읍들과 그 마을들이 납달리 자손이 그 가족대로 받은 기업이었더라."
            ]
        },
        {
            "verse": 40,
            "text": [
                "일곱째 제비는 단 자손에게 그 가족대로 뽑혔더라."
            ]
        },
        {
            "verse": 41,
            "text": [
                "그들의 기업의 경계는 소라, 에스다올, 이르세메스,"
            ]
        },
        {
            "verse": 42,
            "text": [
                "사알랍빈, 아얄론, 이들라,"
            ]
        },
        {
            "verse": 43,
            "text": [
                "엘론, 딤나, 에그론,"
            ]
        },
        {
            "verse": 44,
            "text": [
                "엘르게, 깁브돈, 바알랏,"
            ]
        },
        {
            "verse": 45,
            "text": [
                "여훗, 브네브락, 가드림몬,"
            ]
        },
        {
            "verse": 46,
            "text": [
                "메얄곤, 락곤과 욥바 맞은편 지역까지라."
            ]
        },
        {
            "verse": 47,
            "text": [
                "단 자손이 그들의 경계를 잃었으므로 올라가서 레셈을 쳐서 점령하고, 거기 거주하며, 그들의 조상 단의 이름을 따라 레셈을 단이라 하였더라."
            ]
        },
        {
            "verse": 48,
            "text": [
                "이 성읍들과 그 마을들이 단 자손이 그 가족대로 받은 기업이었더라."
            ]
        },
        {
            "verse": 49,
            "text": [
                "이스라엘 자손이 그들의 기업의 땅을 나누어 준 후에, 그들 중에서 눈의 아들 여호수아에게 기업을 주었으니,"
            ]
        },
        {
            "verse": 50,
            "text": [
                "여호와께서 명령하신 대로 그가 구한 성읍, 곧 에브라임 산지의 딤낫 세라를 주었더라. 그가 그 성읍을 건축하고 거기 거주하였더라."
            ]
        },
        {
            "verse": 51,
            "text": [
                "이는 제사장 엘르아살과 눈의 아들 여호수아와 이스라엘 자손의 지파 족장들이 실로에서 여호와 앞 회막 문에서 제비 뽑아 나눈 기업들이라. 그들이 이와 같이 땅을 나누어 분배하였더라."
            ]
        }
    ]
}