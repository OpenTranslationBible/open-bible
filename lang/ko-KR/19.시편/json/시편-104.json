{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 내 영혼아, 주님을 찬양하라!",
                "> 주 나의 하나님이여, 주님은 매우 위대하시며,",
                "> 영광과 위엄으로 옷 입으셨습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 빛으로 옷을 입듯이 자신을 감싸시며,",
                "> 하늘을 장막처럼 펼치셨습니다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 물 위에 자신의 누각의 들보를 세우시며,",
                "> 구름을 자신의 수레로 사용하시며,",
                "> 바람의 날개 위를 걸으십니다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 바람을 자신의 사신으로 삼으시고,",
                "> 불꽃을 자신의 종으로 삼으십니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 땅을 그 기초 위에 세우셨으니,",
                "> 영원히 흔들리지 않을 것입니다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 주님은 깊은 물로 땅을 덮으셨으며,",
                "> 물이 산 위에 섰습니다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 주님의 꾸짖음에 물이 도망가고,",
                "> 주님의 천둥 소리에 물이 급히 물러갔습니다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 산은 올라가고, 골짜기는 내려가며",
                "> 주님이 정하신 곳으로 갔습니다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 주님은 물이 넘지 못할 경계를 정하셨으니,",
                "> 다시는 땅을 덮지 못할 것입니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 주님은 샘을 골짜기로 보내시어,",
                "> 산 사이로 흐르게 하십니다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 들의 모든 짐승에게 마실 것을 주시며,",
                "> 들나귀들이 갈증을 해소합니다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그 곁에 하늘의 새들이 살며,",
                "> 나뭇가지 사이에서 노래합니다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 주님은 자신의 누각에서 산을 물 주시며,",
                "> 땅은 주님의 일의 열매로 가득합니다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 주님은 가축을 위해 풀을 자라게 하시며,",
                "> 사람의 일을 위해 식물을 주시어,",
                "> 땅에서 음식을 내게 하십니다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 사람의 마음을 기쁘게 하는 포도주와,",
                "> 얼굴을 빛나게 하는 기름과,",
                "> 사람의 마음을 강하게 하는 음식을 주십니다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 주님의 나무들은 물을 충분히 받으며,",
                "> 주님이 심으신 레바논의 백향목도 그러합니다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그곳에 새들이 둥지를 틀고,",
                "> 황새는 전나무에 거처를 둡니다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 높은 산은 산염소의 것이며,",
                "> 바위는 너구리의 피난처입니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 주님은 달을 만드시어 계절을 알게 하셨고,",
                "> 해는 그 지는 곳을 압니다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 주님이 어둠을 만드시면 밤이 되며,",
                "> 숲의 모든 짐승이 움직입니다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 젊은 사자들은 먹이를 찾아 포효하며,",
                "> 하나님께 그들의 양식을 구합니다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 해가 뜨면 그들은 물러가고,",
                "> 그들의 굴에 눕습니다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 사람은 그의 일터로 나가며,",
                "> 저녁까지 일합니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 주님, 주님의 일들이 얼마나 많은지요!",
                "> 주님은 지혜로 그것들을 모두 만드셨으며,",
                "> 땅은 주님의 피조물로 가득합니다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 여기는 넓고 광대한 바다로,",
                "> 그 안에는 수많은 생물들이 있으며,",
                "> 크고 작은 생물들이 있습니다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 배들이 그곳을 다니며,",
                "> 주님이 만드신 리워야단이 그곳에서 놀고 있습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그들은 모두 주님을 의지하며,",
                "> 때에 맞춰 그들의 양식을 받기를 기다립니다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 주님이 주시면 그들이 모으며,",
                "> 주님의 손을 펴시면 좋은 것으로 가득합니다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 주님이 얼굴을 숨기시면 그들은 두려워하며,",
                "> 주님이 그들의 숨을 거두시면 그들은 죽어",
                "> 그들의 먼지로 돌아갑니다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 주님이 영을 보내시면 그들이 창조되며,",
                "> 주님은 땅의 표면을 새롭게 하십니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 주님의 영광이 영원하기를 바라며,",
                "> 주님이 자신의 일들을 기뻐하시기를 바랍니다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 주님이 땅을 보시면 땅이 진동하며,",
                "> 주님이 산을 만지시면 그들이 연기를 내뿜습니다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 내가 사는 동안 주님께 노래하리니,",
                "> 내가 존재하는 동안 나의 하나님께 찬양하리이다."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 나의 묵상이 주님께 기쁨이 되기를 바라며,",
                "> 나는 주님 안에서 기쁨을 찾으리이다."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 죄인들이 땅에서 사라지기를 바라며,",
                "> 악인이 더 이상 없기를 바랍니다.",
                "> 내 영혼아, 주님을 찬양하라.",
                "> 주님을 찬양하라!"
            ]
        }
    ]
}