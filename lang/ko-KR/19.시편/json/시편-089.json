{
    "book": "시편",
    "chapter": 89,
    "verses": [
        {
            "text": [
                "에스라 사람 에단의 마스길"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 내가 여호와의 긍휼을 영원히 노래하리이다.",
                "> 내 입으로 주의 성실하심을 모든 세대에 알리리이다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 내가 말하기를, “긍휼이 영원히 세워질 것이며,",
                "> 주의 성실하심이 하늘에서 굳게 서리이다.” 하였나이다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> “내가 나의 택한 자와 언약을 맺었으며,",
                "> 나의 종 다윗에게 맹세하기를,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 내가 네 자손을 영원히 견고하게 하며,",
                "> 네 왕위를 대대에 세우리라.” 하셨나이다.",
                "> 셀라"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 여호와여, 하늘이 주의 기이한 일을 찬양하며,",
                "> 거룩한 자들의 모임에서 주의 성실하심을 찬양하리이다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 하늘에서 여호와와 비교할 자 누구며,",
                "> 능력 있는 자들 중에 여호와와 같은 자 누구리이까?"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 하나님은 거룩한 자들의 회중에서 매우 두려워할 이시며,",
                "> 그를 둘러싼 모든 자들보다 두려운 이시니이다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 만군의 하나님 여호와여, 주와 같은 이 누구리이까?",
                "> 주의 성실하심이 주를 둘렀나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 주께서 바다의 넘침을 다스리시며,",
                "> 그 파도가 일어날 때 그것을 잔잔하게 하시나이다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 주께서 라합을 죽임을 당한 자같이 부수셨으며,",
                "> 주의 강한 팔로 주의 원수들을 흩으셨나이다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 하늘이 주의 것이요, 땅도 주의 것이라,",
                "> 세계와 그 안에 충만한 것을 주께서 세우셨나이다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 북쪽과 남쪽을 주께서 창조하셨으며,",
                "> 다볼과 헤르몬이 주의 이름으로 인해 기뻐 노래하나이다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 주의 팔에 능력이 있으며,",
                "> 주의 손이 강하고 주의 오른손이 높이 들리었나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 의와 공의가 주의 보좌의 기초이며,",
                "> 긍휼과 진리가 주 앞에 있나이다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 즐거운 소리를 아는 백성은 복이 있나니,",
                "> 여호와여, 그들이 주의 얼굴빛 안에서 행하리이다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그들이 종일 주의 이름으로 인해 기뻐하며,",
                "> 주의 의로 인해 높아지리이다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 주는 그들의 힘의 영광이시며,",
                "> 우리의 뿔이 주의 은총으로 높아지리이다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 우리의 방패는 여호와께 속하였고,",
                "> 우리의 왕은 이스라엘의 거룩하신 이께 속하였나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그때 주께서 환상 중에 주의 성도들에게 말씀하시기를,",
                "> “내가 능력 있는 자에게 도움을 주었으며,",
                "> 백성 중에서 택한 자를 높였도다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 내가 나의 종 다윗을 발견하였으며,",
                "> 나의 거룩한 기름으로 그에게 기름을 부었도다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 내 손이 그와 함께 견고히 하며,",
                "> 내 팔이 그를 강하게 하리로다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 원수가 그를 속이지 못하며,",
                "> 악한 자가 그를 괴롭히지 못하리로다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 내가 그의 앞에서 그의 대적들을 부수며,",
                "> 그를 미워하는 자들을 치리로다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 나의 성실함과 나의 긍휼이 그와 함께 하리니,",
                "> 내 이름으로 그의 뿔이 높아지리로다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 내가 그의 손을 바다 위에 두며,",
                "> 그의 오른손을 강들 위에 두리로다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 그가 내게 부르기를, ‘주는 나의 아버지시며,",
                "> 나의 하나님이시며, 나의 구원의 반석이시라.’ 하리로다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 내가 또한 그를 나의 장자로 삼아,",
                "> 땅의 왕들 중에서 가장 높은 자로 삼으리로다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 내가 그를 위하여 나의 긍휼을 영원히 지키며,",
                "> 나의 언약을 그에게 확고히 하리로다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 내가 그의 자손을 영원히 견고하게 하며,",
                "> 그의 왕위를 하늘의 날과 같이 하리로다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 만일 그의 자손이 나의 법을 버리며,",
                "> 나의 규례를 따르지 아니하며,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 나의 율례를 깨뜨리며,",
                "> 나의 계명을 지키지 아니하면,"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 내가 그들의 죄악을 막대기로 징계하며,",
                "> 그들의 불의를 채찍으로 벌하리로다."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 그러나 나의 긍휼을 그에게서 거두지 아니하며,",
                "> 나의 성실함을 배반하지 아니하리로다."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 내가 나의 언약을 깨뜨리지 아니하며,",
                "> 내 입술에서 낸 것을 변하지 아니하리로다."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 내가 나의 거룩함으로 한 번 맹세하였은즉,",
                "> 다윗에게 거짓말하지 아니하리로다."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> 그의 자손이 영원히 있을 것이며,",
                "> 그의 왕위가 내 앞에서 해같이 견고하리로다."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> 그것이 달같이 영원히 견고하게 서며,",
                "> 하늘의 신실한 증인과 같으리라.” 하셨나이다.",
                "> 셀라"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> 그러나 주께서 주의 기름 부음 받은 자를 버리시고,",
                "> 미워하시며, 크게 노하셨나이다."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> 주의 종의 언약을 폐하시고,",
                "> 그의 면류관을 땅에 던져 더럽히셨나이다."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> 주께서 그의 모든 성벽을 무너뜨리시며,",
                "> 그의 요새를 폐허로 만드셨나이다."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> 지나가는 모든 자들이 그를 약탈하며,",
                "> 그는 그의 이웃에게 수치가 되었나이다."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> 주께서 그의 대적들의 오른손을 높이시며,",
                "> 그의 모든 원수들이 기뻐하게 하셨나이다."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> 주께서 그의 칼날을 돌이키시며,",
                "> 전쟁에서 그를 돕지 아니하셨나이다."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> 주께서 그의 영광을 빼앗으시고,",
                "> 그의 왕위를 땅에 던지셨나이다."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> 주께서 그의 젊은 날을 짧게 하시며,",
                "> 그를 수치로 덮으셨나이다.",
                "> 셀라"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 46,
            "text": [
                "> 여호와여, 언제까지니이까? 주께서 영원히 숨으시겠나이까?",
                "> 주의 진노가 불같이 타오르겠나이까?"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> 나의 생명이 얼마나 짧은지 기억하소서.",
                "> 주께서 모든 인생을 얼마나 헛되이 창조하셨는지요!"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> 어떤 사람이 살고 죽음을 보지 아니하리이까?",
                "> 그가 자기의 영혼을 스올의 권세에서 구원할 수 있으리이까?",
                "> 셀라"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> 주여, 주의 옛날의 긍휼이 어디 있나이까,",
                "> 주께서 다윗에게 주의 성실함으로 맹세하신 것이니이다."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> 주여, 주의 종들이 당한 비방을 기억하소서.",
                "> 내가 내 품에 안고 있는 모든 많은 백성의 비방이니이다."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> 여호와여, 주의 원수들이 비방한 것과,",
                "> 주의 기름 부음 받은 자의 발자취를 조롱한 것을 기억하소서."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 52,
            "text": [
                "> 여호와께서 영원히 찬양받으실지어다!",
                "> 아멘, 아멘."
            ]
        }
    ]
}