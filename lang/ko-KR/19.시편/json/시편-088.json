{
    "book": "시편",
    "chapter": 88,
    "verses": [
        {
            "text": [
                "노래. 고라 자손의 시. 음악 감독을 위하여; 마할랏 르안놋에 따라. 에스라 사람 헤만의 마스길."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 여호와여, 나의 구원의 하나님이여,",
                "> 내가 낮에도 밤에도 주 앞에서 부르짖었나이다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 나의 기도가 주께 이르게 하소서;",
                "> 나의 간구를 들어주소서!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 내 영혼이 고난으로 가득하며,",
                "> 내 생명이 스올에 가까워졌나이다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 나는 구덩이에 내려가는 자같이 여겨지며,",
                "> 힘없는 사람과 같게 되었나이다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 죽은 자들 가운데 버려진 자 같으며,",
                "> 무덤에 누운 살해된 자 같으니,",
                "> 주께서 다시 기억하지 아니하시고,",
                "> 주의 손에서 끊어진 자들이니이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 주께서 나를 가장 낮은 구덩이에 두셨으며,",
                "> 어두운 곳, 깊은 곳에 두셨나이다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 주의 진노가 나를 심히 누르시고,",
                "> 주의 모든 파도로 나를 괴롭게 하셨나이다.",
                "> 셀라"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 주께서 나의 친구들을 나에게서 멀리 떠나게 하시고,",
                "> 나를 그들에게 가증한 자로 삼으셨으므로,",
                "> 나는 갇혀서 나갈 수 없나이다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 나의 눈이 고난으로 말미암아 쇠하였나이다;",
                "---",
                "> 여호와여, 내가 매일 주를 부르며,",
                "> 주를 향하여 나의 손을 펴나이다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 주께서 죽은 자를 위하여 기적을 행하시겠나이까?",
                "> 떠나간 영들이 일어나 주를 찬양하리이까?",
                "> 셀라"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 주의 인자하심이 무덤에서 선포되겠나이까,",
                "> 주의 성실하심이 멸망 중에 있겠나이까?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 주의 기적이 어두운 곳에서 알려지겠나이까?",
                "> 주의 의가 잊혀진 땅에서 알려지겠나이까?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그러나 여호와여, 내가 주께 부르짖었사오며,",
                "> 아침에 나의 기도가 주께 이르리이다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 여호와여, 어찌하여 내 영혼을 버리시며,",
                "> 어찌하여 주의 얼굴을 내게서 숨기시나이까?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 내가 어릴 적부터 고난을 당하여 죽음에 가까웠사오며,",
                "> 주의 두려움을 견디며 지쳤나이다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 주의 맹렬한 진노가 내게 넘치고,",
                "> 주의 두려움이 나를 멸하셨나이다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그것들이 물같이 종일 나를 에워싸고,",
                "> 함께 나를 둘러쌌나이다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 주께서 나의 사랑하는 자와 친구를 나에게서 멀리 떠나게 하셨으며,",
                "> 나의 친구들은 어둠 속에 있나이다."
            ]
        }
    ]
}