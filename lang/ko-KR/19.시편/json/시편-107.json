            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그들이 술에 취한 자처럼 비틀거리며 흔들렸으며,",
                "> 그들의 지혜가 다하였도다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 그들이 그들의 고난 중에 여호와께 부르짖었더니,",
                "> 그가 그들의 고통에서 그들을 구원하셨도다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 그가 폭풍을 잠잠하게 하사,",
                "> 바다의 물결을 고요하게 하셨도다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 그들이 조용하게 되었으므로 기뻐하였으며,",
                "> 그가 그들을 그들이 원하는 항구로 인도하셨도다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 여호와의 인자하심을 감사하라,",
                "> 인류의 자손에게 행하신 그의 기이한 일들로 인하여!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 그들은 또한 백성의 회중에서 그를 높이며,",
                "> 장로들의 모임에서 그를 찬양할지어다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 그가 강들을 광야로,",
                "> 샘들을 마른 땅으로 변하게 하시며;"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 비옥한 땅을 불모지로 변하게 하시니,",
                "> 그 안에 거주하는 자들의 악함 때문이라."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 그가 광야를 물 웅덩이로,",
                "> 마른 땅을 샘들로 변하게 하시며;"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> 그가 배고픈 자들을 그곳에 살게 하사,",
                "> 그들이 거주할 성읍을 세우게 하셨도다,"
            ]
        },
        {
            "verse": 37,
            "text": [
                "> 밭을 갈고 포도원을 심게 하사,",
                "> 풍성한 수확을 거두게 하셨도다."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> 그가 그들을 축복하시고 그들이 크게 번성하게 하시며,",
                "> 그들의 가축이 줄어들지 않게 하셨도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> 그들이 압박과 고난과 슬픔으로 인해",
                "> 줄어들고 낮아질 때,"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> 그가 귀족들에게 멸시를 쏟으시며",
                "> 그들을 길 없는 광야에서 방황하게 하시도다."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> 그러나 그가 궁핍한 자를 고난에서 높이시고,",
                "> 그들의 가족을 양 떼처럼 만드셨도다."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> 정직한 자들은 보고 기뻐하며;",
                "> 모든 불의는 입을 다물도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "> 누가 지혜로운가? 그가 이 일들을 주의하여 보고,",
                "> 여호와의 인자하심을 깊이 생각할지어다."
            ]
        }
    ]
}