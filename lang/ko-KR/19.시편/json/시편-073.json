{
    "book": "시편",
    "chapter": 73,
    "verses": [
        {
            "text": [
                "아삽의 시."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 하나님은 참으로 이스라엘에게 선하시니,",
                "> 마음이 정결한 자에게로다!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 그러나 내 발은 거의 미끄러질 뻔하였고,",
                "> 내 걸음은 거의 넘어질 뻔하였도다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 내가 악인의 형통함을 보고",
                "> 오만한 자를 시기하였음이로다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 그들은 죽을 때에도 고통이 없고,",
                "> 그들의 몸은 건강하며"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 다른 사람들과 같은 고난을 당하지 아니하며,",
                "> 다른 사람들처럼 재앙을 당하지 아니하는도다."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 그러므로 교만이 그들의 목걸이요,",
                "> 강포가 그들의 옷이며"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그들의 눈은 기름으로 튀어나오며,",
                "> 그들의 마음의 상상은 넘치는도다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그들은 비웃으며 악하게 말하며,",
                "> 거만하게 말하나이다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그들의 입은 하늘에 대하여 두고,",
                "> 그들의 혀는 땅을 두루 다니도다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그러므로 그의 백성이 이리로 돌아와서",
                "> 물을 가득히 마시며"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 말하기를 \"하나님이 어찌 알랴?",
                "> 지존자에게 지식이 있으랴?\" 하도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 보라, 이들은 악인이로다;",
                "> 항상 평안하고 재물이 더하도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 내가 내 마음을 정결하게 하며",
                "> 내 손을 씻어 무죄함으로 지켰나니 헛되도다;"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 나는 종일 재앙을 당하며,",
                "> 아침마다 징벌을 받았도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 내가 만일 이같이 말하리라 하였다면,",
                "> 보라, 주의 자손의 세대에게 성실하지 못하였으리이다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 내가 어찌하여 이를 깨달으랴 하였더니,",
                "> 그것이 내게 심히 곤란하였도다"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 하나님의 성소에 들어갈 때에야",
                "> 그들의 종말을 내가 깨달았나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 주께서 참으로 그들을 미끄러운 곳에 두시며,",
                "> 파멸에 던지시니"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그들이 어찌하여 갑자기 황폐되었는가,",
                "> 놀랄만큼 완전히 멸망하였나이다!"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 주여, 사람이 깨어난 후의 꿈같이",
                "> 주께서 일어나실 때 그들의 형상을 멸시하시리이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 내 마음이 산란하며",
                "> 내 양심이 찔렸나이다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 내가 이같이 우매 무지하니",
                "> 주 앞에 짐승이오나"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 내가 항상 주와 함께하니",
                "> 주께서 내 오른손을 붙드셨나이다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 주의 교훈으로 나를 인도하시고,",
                "> 후에는 영광으로 나를 영접하시리니"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 하늘에서는 주 외에 누가 내게 있으리요?",
                "> 땅에서는 주밖에 내가 사모할 이 없나이다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 내 육체와 마음은 쇠약하나",
                "> 하나님은 내 마음의 반석이시며 영원한 분깃이시라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 무릇 주를 멀리하는 자는 망하리니",
                "> 주께서 모든 음녀를 멸하셨나이다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 하나님께 가까이 함이 내게 복이라;",
                "> 내가 주 여호와를 나의 피난처로 삼아",
                "> 주의 모든 행적을 전파하리이다."
            ]
        }
    ]
}