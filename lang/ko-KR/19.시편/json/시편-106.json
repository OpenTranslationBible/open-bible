{
    "book": "시편",
    "chapter": 106,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 여호와를 찬양하라!",
                "---",
                "> 여호와께 감사하라, 그는 선하시며",
                "> 그의 인자하심이 영원함이로다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 누가 여호와의 능한 일을 말할 수 있으며,",
                "> 그의 모든 찬양을 선포할 수 있으리요?"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 정의를 지키는 자들과",
                "> 항상 의를 행하는 자들은 복이 있도다!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 주의 백성에게 베푸시는 은혜로 나를 기억하시고,",
                "> 주의 구원으로 나를 찾아주소서,"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 내가 주의 택하신 자들의 형통함을 보고,",
                "> 주의 나라의 기쁨을 함께 나누며,",
                "> 주의 유업을 자랑하게 하소서."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 우리가 우리 조상들처럼 죄를 지었으며,",
                "> 우리가 잘못 행하고 악을 행하였나이다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 우리 조상들이 이집트에서 주의 기적을 깨닫지 못하였으며,",
                "> 주의 풍성한 인자하심을 기억하지 못하고,",
                "> 바다에서, 홍해에서 반역하였나이다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그러나 주께서 자신의 이름을 위하여 그들을 구원하셨으니,",
                "> 자신의 능력을 알리려 하심이로다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그가 홍해를 꾸짖으시니 마르며,",
                "> 그가 그들을 광야처럼 큰 물을 지나가게 하셨도다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 이와 같이 그가 그들을 미워하는 자들의 손에서 구원하시고,",
                "> 원수의 손에서 구속하셨도다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 물이 그들의 대적을 덮으니,",
                "> 그들 중 하나도 남지 아니하였도다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그때 그들이 그의 말씀을 믿고,",
                "> 그의 찬양을 불렀도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그들이 그의 행사를 빨리 잊어버리고,",
                "> 그의 인도를 기다리지 아니하며,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 광야에서 탐욕을 품고,",
                "> 사막에서 하나님을 시험하였도다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그러므로 그가 그들의 요구를 들어주셨으나,",
                "> 그들 중에 소모병을 보내셨도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그들이 진영에서 모세를 시기하였으며,",
                "> 여호와의 거룩한 자 아론을 시기하였도다."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 땅이 열려 다단을 삼키고,",
                "> 아비람의 무리를 덮었도다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 불이 그들의 무리 중에 타올라,",
                "> 악인들을 불살랐도다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그들이 호렙에서 송아지를 만들고,",
                "> 부어 만든 우상을 경배하였도다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 이와 같이 그들이 자기들의 영광을",
                "> 풀을 먹는 소의 형상으로 바꾸었도다."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 그들이 자기들의 구원자 하나님을 잊었으니,",
                "> 그가 이집트에서 큰일을 행하셨도다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 함의 땅에서 기적을 행하시고,",
                "> 홍해에서 두려운 일을 행하셨도다."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 그러므로 그가 그들을 멸하겠다고 선언하셨으나,",
                "> 그의 택하신 자 모세가 그 앞에서 틈에 서서,",
                "> 그의 진노를 돌이켜 멸하지 않게 하였도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 그들이 아름다운 땅을 거절하고,",
                "> 그의 약속을 믿지 아니하며,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 자기들의 장막에서 원망하며,",
                "> 여호와의 음성을 듣지 아니하였도다."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 그러므로 그가 그들에게 맹세하시기를",
                "> 그들을 광야에 엎드러지게 하리라 하셨도다."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 그들의 후손을 민족들 가운데 흩으시고,",
                "> 여러 땅에 흩으시리라 하셨도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 그들이 또한 브올의 바알을 따르고,",
                "> 죽은 자에게 바친 제물을 먹었도다."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 이와 같이 그들이 그들의 행위로 그를 격노케 하였으므로,",
                "> 그들 중에 재앙이 일어났도다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 그때 비느하스가 일어나 개입하였으므로,",
                "> 재앙이 그쳤도다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 그것이 그에게 의로 여겨졌으니,",
                "> 모든 세대에 걸쳐서이로다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 그들이 또한 므리바 물에서 그를 격노케 하였으므로,",
                "> 그로 인해 모세가 고난을 당하였도다."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 그들이 그의 영을 거역하였으므로,",
                "> 그가 입술로 경솔히 말하였도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 그들이 백성들을 멸하지 아니하였으니,",
                "> 여호와께서 그들에게 명령하신 대로 하지 아니하였도다."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 그들이 이방인들과 섞여서",
                "> 그들의 행위를 배웠으며,"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> 그들의 우상들을 경배하였으니,",
                "> 그것이 그들에게 올무가 되었도다."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> 그들이 심지어 자기들의 아들딸들을 귀신들에게 희생물로 바쳤도다."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> 그들이 무죄한 피를 흘렸으니,",
                "> 자기들의 아들딸들의 피라,",
                "> 그들이 가나안의 우상들에게 희생물로 바쳤으며,",
                "> 그 땅이 피로 더럽혀졌도다."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> 이와 같이 그들이 그들의 행위로 더러워졌으며,",
                "> 그들의 행위로 불충실하였도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 40,
            "text": [
                "> 그러므로 여호와께서 자기 백성에게 진노하시고,",
                "> 그의 유업을 미워하셨도다."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> 그가 그들을 이방인의 손에 넘기셨으니,",
                "> 그들을 미워하는 자들이 그들을 다스렸도다."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> 그들의 원수들이 그들을 압박하였으며,",
                "> 그들이 그들의 권세 아래 굴복하였도다."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> 그가 여러 번 그들을 구원하셨으나,",
                "> 그들은 그들의 계획으로 반역하였으며,",
                "> 그들의 죄악으로 인해 낮아졌도다."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> 그러나 그가 그들의 고통을 보시고,",
                "> 그들의 부르짖음을 들으셨도다."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> 그가 그들을 위하여 그의 언약을 기억하시고,",
                "> 그의 크신 인자하심을 따라 뜻을 돌이키셨도다."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> 그가 그들을 사로잡은 모든 자들 앞에서",
                "> 그들을 불쌍히 여기게 하셨도다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> 우리 하나님 여호와여, 우리를 구원하시고,",
                "> 이방인들 가운데서 우리를 모으사,",
                "> 주의 거룩한 이름에 감사하게 하시며,",
                "> 주의 찬양을 자랑하게 하소서."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> 여호와 이스라엘의 하나님을 찬송할지어다,",
                "> 영원부터 영원까지.",
                "> 모든 백성이 말할지어다, \"아멘.\"",
                "> 여호와를 찬양하라!"
            ]
        }
    ]
}