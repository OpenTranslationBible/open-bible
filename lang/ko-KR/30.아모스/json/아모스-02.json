{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "주님께서 이렇게 말씀하십니다:",
                "> \"모압의 세 가지 죄와 네 가지 죄 때문에",
                "> 내가 그 벌을 돌이키지 않겠다.",
                "> 그가 에돔 왕의 뼈를 불태워 석회로 만들었기 때문이다."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 그러므로 내가 모압에 불을 보내리니,",
                "> 그것이 그리옷의 요새들을 삼킬 것이다.",
                "> 모압은 소란 속에서 죽을 것이며,",
                "> 전쟁의 함성과 나팔 소리와 함께 할 것이다."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 내가 그들 가운데서 재판관을 제거하고",
                "> 그의 모든 지도자들을 그와 함께 끝내리라,\"",
                "> 주님께서 말씀하십니다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "주님께서 이렇게 말씀하십니다:",
                "> \"유다의 세 가지 죄와 네 가지 죄 때문에",
                "> 내가 그 벌을 돌이키지 않겠다.",
                "> 그들이 주님의 율법을 거부하고",
                "> 그의 법규를 지키지 않았기 때문이다.",
                "> 그들의 거짓말이 그들을 잘못 인도하였으니,",
                "> 그들의 조상들이 따랐던 것들이다."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 그러므로 내가 유다에 불을 보내리니,",
                "> 그것이 예루살렘의 요새들을 삼킬 것이다.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "주님께서 이렇게 말씀하십니다:",
                "> \"이스라엘의 세 가지 죄와 네 가지 죄 때문에",
                "> 내가 그 벌을 돌이키지 않겠다.",
                "> 그들이 의인을 돈으로 팔고,",
                "> 가난한 자를 신 한 켤레로 팔았기 때문이다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 그들은 가난한 자의 머리를 땅의 먼지 속에 짓밟고",
                "> 고난받는 자를 길에서 밀어내며;",
                "> 한 남자와 그의 아버지가 같은 소녀와 성관계를 맺어",
                "> 내 거룩한 이름을 더럽힌다."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그들은 담보로 잡은 옷을 모든 제단 곁에 깔고 눕고,",
                "> 그들의 신의 집에서 벌금으로 받은 자들의 포도주를 마신다."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그러나 내가 그들 앞에서 아모리 사람을 제거하였으니,",
                "> 그의 키는 백향목 같고,",
                "> 그는 상수리나무처럼 강하였으나;",
                "> 내가 그의 위의 열매와 아래의 뿌리를 멸하였다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 내가 너희를 이집트 땅에서 이끌어 내어",
                "> 광야에서 40년 동안 인도하여",
                "> 아모리 사람의 땅을 차지하게 하였다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그리고 내가 너희 아들들 중에서 선지자를 세우고,",
                "> 너희 젊은이들 중에서 나실인을 세웠다.",
                "> 이스라엘 자손들아, 그렇지 아니하냐?\"",
                "> 주님께서 말씀하십니다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"그러나 너희는 나실인들에게 포도주를 마시게 하고,",
                "> 선지자들에게 명령하여 말하기를,",
                "> '예언하지 말라!' 하였다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 보라, 내가 너희 위에 짐을 지우리니,",
                "> 마치 곡식 단으로 가득 찬 수레가 눌리는 것과 같다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 빠른 자도 도망하지 못하고,",
                "> 강한 자도 그의 힘을 강화하지 못하며,",
                "> 전사도 그의 생명을 구하지 못할 것이다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 활 쏘는 자도 굳게 서지 못하고,",
                "> 발이 빠른 자도 도망하지 못하며,",
                "> 기병도 그의 생명을 구하지 못할 것이다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 용사들 중 가장 용감한 자도 그 날에 벌거벗고 도망할 것이다,\"",
                "> 주님께서 말씀하십니다."
            ]
        }
    ]
}