{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "다윗이 이 노래의 말씀을 여호와께 아뢰었으니",
                "이는 여호와께서 그를 모든 원수의 손과",
                "사울의 손에서 구원하신 날에 한 것이라."
            ]
        },
        {
            "verse": 2,
            "text": [
                "그가 선언하였다:",
                "> \"여호와는 나의 반석이시며, 나의 요새시며, 나의 구원자시라;"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 나의 하나님, 내가 안전을 찾는 나의 반석이시며,",
                "> 나의 방패와 나의 구원의 뿔이시며,",
                "> 나의 산성이시며 나의 피난처시라;",
                "> 나의 구원자시여, 주께서 나를 해로부터 보호하시나이다."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 내가 찬양받으실 여호와를 부르리니,",
                "> 그러면 내가 나의 원수들로부터 구원을 받으리라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 죽음의 파도가 나를 둘러쌌고,",
                "> 파멸의 급류가 나를 덮쳤나이다;"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 스올의 줄이 나를 에워쌌고,",
                "> 죽음의 올무가 나를 맞닥뜨렸나이다."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 나의 고난 중에 내가 여호와께 부르짖었고,",
                "> 참으로 나의 하나님께 부르짖었더니;",
                "> 그분의 성전에서 내 소리를 들으셨고,",
                "> 나의 도움을 구하는 부르짖음이 그분의 귀에 닿았나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 그때 땅이 흔들리고 떨렸으며,",
                "> 하늘의 기초가 진동하고",
                "> 흔들렸으니, 이는 그분이 분노하셨기 때문이라."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 그분의 콧구멍에서 연기가 올라오고,",
                "> 그분의 입에서 불이 삼키며;",
                "> 숯이 그로 인해 타올랐나이다."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 그분이 하늘을 굽히고 내려오셨으며",
                "> 그분의 발 아래에 짙은 어둠이 있었나이다."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 그분이 그룹을 타고 날아오르셨으며;",
                "> 바람의 날개 위에 솟아오르셨나이다."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> 그분은 그분 주위에 어둠을 그분의 장막으로 삼으셨으며,",
                "> 물의 모임, 하늘의 짙은 구름을 삼으셨나이다."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 그분 앞의 광채로부터",
                "> 숯불이 점화되었나이다."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 여호와께서 하늘에서 천둥을 치셨으며,",
                "> 지극히 높으신 분이 그분의 목소리를 높이셨나이다."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> 그분이 화살을 보내어 그들을 흩으셨으며,",
                "> 번개를 보내어 그들을 도망가게 하셨나이다."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> 그때 바다의 통로가 드러났고,",
                "> 세상의 기초가 드러났으니",
                "> 이는 여호와의 꾸짖음으로,",
                "> 그분의 콧구멍의 숨결로 인함이라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 그분이 높은 곳에서 손을 내밀어 나를 붙잡으셨으며;",
                "> 많은 물에서 나를 끌어내셨나이다."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 그분이 나를 강한 원수로부터 구원하셨으며,",
                "> 나를 미워하는 자들로부터 구원하셨으니, 그들은 나보다 강하였나이다."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> 그들이 나의 재난의 때에 나를 맞닥뜨렸으나,",
                "> 여호와께서 나의 지지자가 되셨나이다."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> 그분이 나를 넓은 곳으로 이끌어 내셨으며;",
                "> 그분이 나를 구원하셨으니, 이는 그분이 나를 기뻐하셨기 때문이라."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> 여호와께서 나의 의에 따라 나에게 보상하셨으며;",
                "> 내 손의 깨끗함에 따라 그분이 나에게 갚으셨나이다."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> 이는 내가 여호와의 길을 따랐으며,",
                "> 나의 하나님에게서 떠나지 않았음이라."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> 그분의 모든 규례가 내 앞에 있었으며,",
                "> 나는 그분의 법규에서 떠나지 않았나이다."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> 나는 또한 그분 앞에서 흠이 없었으며,",
                "> 나의 죄책에서 나를 지켰나이다."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> 그러므로 여호와께서 나의 의에 따라 나에게 갚으셨으며,",
                "> 그분의 눈앞에서 나의 깨끗함에 따라 갚으셨나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> 신실한 자에게는 주께서 신실하게 나타나시며,",
                "> 흠 없는 자에게는 주께서 흠 없이 나타나시나이다;"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> 깨끗한 자에게는 주께서 깨끗하게 나타나시며,",
                "> 교활한 자에게는 주께서 교묘하게 나타나시나이다."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> 주께서는 겸손한 백성을 구원하시며,",
                "> 교만한 자에게는 주의 눈이 그들을 낮추시나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> 주께서는 나의 등불이시니, 오 여호와여;",
                "> 여호와께서 나의 어둠을 밝히시나이다."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> 주로 인해 내가 군대를 돌파할 수 있으며;",
                "> 나의 하나님으로 인해 내가 성벽을 뛰어넘을 수 있나이다."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> 하나님에 관하여 말하자면, 그분의 길은 완전하며;",
                "> 여호와의 말씀은 순수하며;",
                "> 그분은 그분에게 피하는 모든 자에게 방패가 되시나이다."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> 여호와 외에 누가 하나님이시며?",
                "> 우리 하나님 외에 누가 반석이시리요?"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> 하나님은 나의 산성이시며;",
                "> 그분이 나의 길을 곧게 하시나이다."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> 그분이 나의 발을 사슴의 발처럼 만드시며,",
                "> 나를 높은 곳에 세우시나이다."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 그분이 나의 손을 전쟁을 위해 준비시키시며,",
                "> 나의 팔이 청동 활을 휘게 하시나이다."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> 주께서 또한 나에게 주의 구원의 방패를 주셨으며,",
                "> 주의 지지가 나를 위대하게 만드시나이다."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> 주께서 내 아래의 길을 넓히셨으니,",
                "> 나의 발이 미끄러지지 않았나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> 내가 나의 원수를 추격하여 그들을 물리쳤으며,",
                "> 그들이 멸망할 때까지 돌아서지 않았나이다."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> 내가 그들을 소멸하고 부수었으니,",
                "> 그들이 일어나지 못하였으며;",
                "> 그들이 내 발 아래에 쓰러졌나이다."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> 주께서 나에게 전쟁을 위한 힘을 주셨으며;",
                "> 나를 대적하여 일어나는 자들을 내 아래에 굴복시키셨나이다."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> 주께서 나의 원수들이 나에게 등을 돌리게 하셨으며,",
                "> 나를 미워하는 자들을 내가 멸하였나이다."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> 그들이 보았으나 구원할 자가 없었으며—",
                "> 심지어 여호와께 부르짖었으나 그분이 그들에게 응답하지 않으셨나이다."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> 그러자 내가 그들을 땅의 먼지처럼 부수었으며;",
                "> 그들을 가루로 만들어 거리의 진흙처럼 짓밟았나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> 주께서 나를 나의 백성의 다툼에서 구원하셨으며;",
                "> 나를 민족들의 머리로 삼으셨으니;",
                "> 내가 알지 못하던 백성이 나를 섬기나이다."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> 외국인들이 나에게 복종하는 척하며;",
                "> 그들이 듣자마자 나에게 복종하나이다."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> 외국인들이 마음을 잃고,",
                "> 그들의 요새에서 떨며 나오나이다."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> 여호와는 살아 계시며, 찬송받으실 나의 반석이시며;",
                "> 나의 구원의 기초이신 나의 하나님이 높임을 받으시리라,"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> 나를 위해 복수를 행하시는 하나님이시며,",
                "> 나를 아래에 두신 민족들을 낮추시는 하나님이시라,"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> 또한 나를 원수들로부터 구원하시는 분이시며;",
                "> 나를 대적하여 일어나는 자들 위에 나를 높이 드시는 분이시며;",
                "> 폭력적인 사람으로부터 나를 구원하시는 분이시라."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> 그러므로 내가 주께 감사드리리이다, 여호와여, 민족들 가운데서,",
                "> 내가 주의 이름을 찬양하리이다."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> 그분은 그분의 왕에게 구원의 탑이시며,",
                "> 그분의 기름부음을 받은 자에게 은혜를 베푸시며,",
                "> 다윗과 그의 후손에게 영원히 베푸시리이다.”"
            ]
        }
    ]
}