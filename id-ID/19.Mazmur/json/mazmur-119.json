{
  "book": "Mazmur",
  "chapter": 119,
  "verses": [
    {
      "text": ["א Aleph"]
    },
    {
      "verse": 1,
      "text": [
        "> Berbahagialah orang-orang yang hidupnya tidak bercela,",
        "> Yang mengikuti hukum Tuhan."
      ]
    },
    {
      "verse": 2,
      "text": [
        "> Berbahagialah orang-orang yang memegang peringatan-Nya,",
        "> Dan mencari Dia dengan segenap hati."
      ]
    },
    {
      "verse": 3,
      "text": ["> Mereka juga tidak melakukan kejahatan;", "> Mereka berjalan menurut jalan-Nya."]
    },
    {
      "verse": 4,
      "text": [
        "> Engkau telah menetapkan titah-titah-Mu,",
        "> Agar kami memeliharanya dengan sungguh-sungguh."
      ]
    },
    {
      "verse": 5,
      "text": ["> Oh, kiranya jalan-jalanku tetap", "> Untuk memelihara ketetapan-Mu!"]
    },
    {
      "verse": 6,
      "text": ["> Maka aku tidak akan merasa malu", "> Ketika aku memperhatikan semua perintah-Mu."]
    },
    {
      "verse": 7,
      "text": [
        "> Aku akan bersyukur kepada-Mu dengan tulus hati,",
        "> Ketika aku belajar hukum-hukum-Mu yang adil."
      ]
    },
    {
      "verse": 8,
      "text": ["> Aku akan memegang ketetapan-Mu;", "> Janganlah sekali-kali meninggalkan aku!"]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ב Beth"]
    },
    {
      "verse": 9,
      "text": [
        "> Dengan apakah seorang muda mempertahankan kelakuannya bersih?",
        "> Dengan menjaganya sesuai dengan firman-Mu."
      ]
    },
    {
      "verse": 10,
      "text": [
        "> Dengan segenap hatiku aku mencari Engkau;",
        "> Jangan biarkan aku menyimpang dari perintah-Mu."
      ]
    },
    {
      "verse": 11,
      "text": [
        "> Dalam hatiku aku menyimpan firman-Mu,",
        "> Supaya aku tidak berdosa terhadap Engkau."
      ]
    },
    {
      "verse": 12,
      "text": ["> Terpujilah Engkau, Tuhan;", "> Ajarkanlah ketetapan-Mu kepadaku."]
    },
    {
      "verse": 13,
      "text": ["> Dengan bibirku aku menceritakan", "> Semua hukum dari mulut-Mu."]
    },
    {
      "verse": 14,
      "text": ["> Aku bergembira atas jalan peringatan-Mu,", "> Seperti atas segala harta."]
    },
    {
      "verse": 15,
      "text": ["> Aku hendak merenungkan titah-titah-Mu", "> Dan memikirkan jalan-jalan-Mu."]
    },
    {
      "verse": 16,
      "text": ["> Aku akan bergembira dalam ketetapan-Mu;", "> Aku tidak akan melupakan firman-Mu."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ג Gimel"]
    },
    {
      "verse": 17,
      "text": [
        "> Perlakukanlah hamba-Mu dengan murah hati,",
        "> Supaya aku hidup dan memegang firman-Mu."
      ]
    },
    {
      "verse": 18,
      "text": ["> Bukalah mataku, supaya aku melihat", "> Hal-hal ajaib dari hukum-Mu."]
    },
    {
      "verse": 19,
      "text": ["> Aku ini orang asing di bumi;", "> Jangan sembunyikan perintah-Mu dariku."]
    },
    {
      "verse": 20,
      "text": ["> Jiwaku hancur karena rindu", "> Akan hukum-hukum-Mu setiap waktu."]
    },
    {
      "verse": 21,
      "text": [
        "> Engkau menegur orang-orang yang sombong, yang terkutuk,",
        "> Yang menyimpang dari perintah-Mu."
      ]
    },
    {
      "verse": 22,
      "text": ["> Jauhkanlah dariku cela dan hina,", "> Karena aku memegang peringatan-Mu."]
    },
    {
      "verse": 23,
      "text": [
        "> Sekalipun para pemimpin duduk dan berbicara melawan aku,",
        "> Hamba-Mu merenungkan ketetapan-Mu."
      ]
    },
    {
      "verse": 24,
      "text": ["> Juga peringatan-Mu adalah kegembiraanku;", "> Mereka adalah penasihatku."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ד Daleth"]
    },
    {
      "verse": 25,
      "text": ["> Jiwaku melekat pada debu;", "> Hidupkanlah aku sesuai dengan firman-Mu."]
    },
    {
      "verse": 26,
      "text": [
        "> Aku telah menceritakan jalan-jalanku, dan Engkau menjawab aku;",
        "> Ajarkanlah ketetapan-Mu kepadaku."
      ]
    },
    {
      "verse": 27,
      "text": [
        "> Buatlah aku mengerti jalan titah-titah-Mu,",
        "> Supaya aku merenungkan keajaiban-keajaiban-Mu."
      ]
    },
    {
      "verse": 28,
      "text": ["> Jiwaku menangis karena duka;", "> Kuatkanlah aku sesuai dengan firman-Mu."]
    },
    {
      "verse": 29,
      "text": [
        "> Jauhkanlah dariku jalan penipuan,",
        "> Dan anugerahkanlah hukum-Mu kepadaku dengan murah hati."
      ]
    },
    {
      "verse": 30,
      "text": [
        "> Aku telah memilih jalan kebenaran;",
        "> Aku telah menempatkan hukum-hukum-Mu di hadapanku."
      ]
    },
    {
      "verse": 31,
      "text": ["> Aku berpegang pada peringatan-Mu;", "> Tuhan, jangan biarkan aku dipermalukan!"]
    },
    {
      "verse": 32,
      "text": [
        "> Aku akan berlari mengikuti perintah-Mu,",
        "> Karena Engkau akan melapangkan hatiku."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ה He"]
    },
    {
      "verse": 33,
      "text": [
        "> Ajarkanlah kepadaku, jalan ketetapan-Mu, Tuhan,",
        "> Dan aku akan memeliharanya sampai akhir."
      ]
    },
    {
      "verse": 34,
      "text": [
        "> Berilah aku pengertian, supaya aku memelihara hukum-Mu",
        "> Dan menjaganya dengan segenap hatiku."
      ]
    },
    {
      "verse": 35,
      "text": ["> Bimbinglah aku di jalan perintah-Mu,", "> Karena aku bergembira di dalamnya."]
    },
    {
      "verse": 36,
      "text": [
        "> Condongkanlah hatiku kepada peringatan-Mu,",
        "> Dan bukan kepada keuntungan yang tidak jujur."
      ]
    },
    {
      "verse": 37,
      "text": [
        "> Palingkanlah mataku dari melihat hal yang tidak berguna,",
        "> Dan hidupkanlah aku dalam jalan-Mu."
      ]
    },
    {
      "verse": 38,
      "text": [
        "> Teguhkanlah firman-Mu kepada hamba-Mu,",
        "> Sebagai sesuatu yang menimbulkan rasa hormat kepada-Mu."
      ]
    },
    {
      "verse": 39,
      "text": ["> Jauhkanlah cela yang kutakuti,", "> Karena hukum-hukum-Mu baik."]
    },
    {
      "verse": 40,
      "text": [
        "> Lihatlah, aku rindu akan titah-titah-Mu;",
        "> Hidupkanlah aku melalui kebenaran-Mu."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ו Waw"]
    },
    {
      "verse": 41,
      "text": [
        "> Kiranya kemurahan-Mu juga datang kepadaku, Tuhan,",
        "> Keselamatan-Mu sesuai dengan firman-Mu;"
      ]
    },
    {
      "verse": 42,
      "text": [
        "> Supaya aku mempunyai jawaban bagi yang mencemooh aku,",
        "> Karena aku percaya kepada firman-Mu."
      ]
    },
    {
      "verse": 43,
      "text": [
        "> Dan janganlah mengambil firman kebenaran sepenuhnya dari mulutku,",
        "> Karena aku menantikan hukum-hukum-Mu."
      ]
    },
    {
      "verse": 44,
      "text": ["> Maka aku akan memelihara hukum-Mu terus-menerus,", "> Untuk selamanya."]
    },
    {
      "verse": 45,
      "text": ["> Dan aku akan berjalan dalam kebebasan,", "> Karena aku mencari titah-titah-Mu."]
    },
    {
      "verse": 46,
      "text": [
        "> Aku juga akan menceritakan peringatan-Mu di hadapan raja-raja,",
        "> Dan tidak akan merasa malu."
      ]
    },
    {
      "verse": 47,
      "text": ["> Aku akan bergembira dalam perintah-Mu,", "> Yang aku cintai."]
    },
    {
      "verse": 48,
      "text": [
        "> Dan aku akan mengangkat tanganku kepada perintah-Mu, yang aku cintai;",
        "> Dan aku akan merenungkan ketetapan-Mu."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ז Zayin"]
    },
    {
      "verse": 49,
      "text": ["> Ingatlah firman kepada hamba-Mu,", "> Yang membuat aku berharap."]
    },
    {
      "verse": 50,
      "text": [
        "> Inilah penghiburanku dalam penderitaanku,",
        "> Bahwa firman-Mu telah menghidupkan aku."
      ]
    },
    {
      "verse": 51,
      "text": [
        "> Orang-orang sombong mencemooh aku dengan sepenuhnya,",
        "> Namun aku tidak menyimpang dari hukum-Mu."
      ]
    },
    {
      "verse": 52,
      "text": [
        "> Aku telah mengingat hukum-hukum-Mu dari dahulu, Tuhan,",
        "> Dan menemukan penghiburan."
      ]
    },
    {
      "verse": 53,
      "text": [
        "> Kemarahan yang besar telah menguasai aku karena orang fasik,",
        "> Yang meninggalkan hukum-Mu."
      ]
    },
    {
      "verse": 54,
      "text": ["> Ketetapan-Mu telah menjadi nyanyian-nyanyianku", "> Di rumah perjalananku."]
    },
    {
      "verse": 55,
      "text": ["> Tuhan, aku mengingat nama-Mu di malam hari,", "> Dan memelihara hukum-Mu."]
    },
    {
      "verse": 56,
      "text": ["> Ini telah menjadi milikku,", "> Bahwa aku memelihara titah-titah-Mu."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ח Heth"]
    },
    {
      "verse": 57,
      "text": ["> Tuhan adalah bagianku;", "> Aku telah berjanji untuk memelihara firman-Mu."]
    },
    {
      "verse": 58,
      "text": [
        "> Aku mencari kemurahan-Mu dengan segenap hatiku;",
        "> Kasihanilah aku sesuai dengan firman-Mu."
      ]
    },
    {
      "verse": 59,
      "text": [
        "> Aku merenungkan jalan-jalanku",
        "> Dan mengarahkan langkahku kepada peringatan-Mu."
      ]
    },
    {
      "verse": 60,
      "text": ["> Aku bergegas dan tidak menunda-nunda", "> Untuk mengikuti perintah-Mu."]
    },
    {
      "verse": 61,
      "text": [
        "> Jerat orang fasik telah mengelilingi aku,",
        "> Namun aku tidak melupakan hukum-Mu."
      ]
    },
    {
      "verse": 62,
      "text": [
        "> Aku bangun pada tengah malam untuk bersyukur kepada-Mu",
        "> Karena hukum-hukum-Mu yang adil."
      ]
    },
    {
      "verse": 63,
      "text": [
        "> Aku adalah teman bagi semua orang yang takut kepada-Mu,",
        "> Dan bagi mereka yang memelihara titah-titah-Mu."
      ]
    },
    {
      "verse": 64,
      "text": ["> Bumi penuh dengan kasih setia-Mu, Tuhan;", "> Ajarkanlah ketetapan-Mu kepadaku."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ט Teth"]
    },
    {
      "verse": 65,
      "text": [
        "> Engkau telah memperlakukan hamba-Mu dengan baik, Tuhan,",
        "> Sesuai dengan firman-Mu."
      ]
    },
    {
      "verse": 66,
      "text": [
        "> Ajarkanlah kepadaku kebijaksanaan dan pengetahuan yang baik,",
        "> Karena aku percaya kepada perintah-Mu."
      ]
    },
    {
      "verse": 67,
      "text": [
        "> Sebelum aku menderita, aku menyimpang,",
        "> Tetapi sekarang aku selalu memelihara firman-Mu."
      ]
    },
    {
      "verse": 68,
      "text": ["> Engkau baik dan melakukan apa yang benar;", "> Ajarkanlah ketetapan-Mu kepadaku."]
    },
    {
      "verse": 69,
      "text": [
        "> Orang-orang sombong telah memalsukan kebohongan terhadap aku;",
        "> Dengan segenap hatiku aku akan memelihara titah-titah-Mu."
      ]
    },
    {
      "verse": 70,
      "text": [
        "> Hati mereka keras, seperti lemak yang mengeras,",
        "> Tetapi aku bergembira dalam hukum-Mu."
      ]
    },
    {
      "verse": 71,
      "text": [
        "> Adalah baik bagiku bahwa aku mengalami kesulitan,",
        "> Supaya aku belajar ketetapan-Mu."
      ]
    },
    {
      "verse": 72,
      "text": [
        "> Hukum dari mulut-Mu lebih berharga bagiku",
        "> Daripada ribuan keping emas dan perak."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["י Yodh"]
    },
    {
      "verse": 73,
      "text": [
        "> Tangan-Mu telah membuat aku dan membentuk aku;",
        "> Berilah aku pengertian, supaya aku belajar perintah-Mu."
      ]
    },
    {
      "verse": 74,
      "text": [
        "> Kiranya orang-orang yang takut kepada-Mu melihat aku dan bersukacita,",
        "> Karena aku berharap kepada firman-Mu."
      ]
    },
    {
      "verse": 75,
      "text": [
        "> Aku tahu, Tuhan, bahwa hukum-hukum-Mu benar,",
        "> Dan bahwa Engkau telah membiarkan aku menghadapi cobaan dalam kesetiaan."
      ]
    },
    {
      "verse": 76,
      "text": [
        "> Kiranya kemurahan-Mu menghibur aku,",
        "> Sesuai dengan firman-Mu kepada hamba-Mu."
      ]
    },
    {
      "verse": 77,
      "text": [
        "> Kiranya belas kasihan-Mu datang kepadaku, memberikan aku hidup,",
        "> Karena hukum-Mu adalah kegembiraanku."
      ]
    },
    {
      "verse": 78,
      "text": [
        "> Kiranya orang-orang sombong merasa malu, karena mereka berbuat salah terhadap aku dengan kebohongan;",
        "> Tetapi aku akan merenungkan titah-titah-Mu."
      ]
    },
    {
      "verse": 79,
      "text": [
        "> Kiranya orang-orang yang takut kepada-Mu berbalik kepada aku,",
        "> Dan mereka yang mengenal peringatan-Mu."
      ]
    },
    {
      "verse": 80,
      "text": ["> Kiranya hatiku tetap dalam ketetapan-Mu,", "> Supaya aku tidak merasa malu."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["כ Kaph"]
    },
    {
      "verse": 81,
      "text": ["> Jiwaku merana menantikan keselamatan-Mu;", "> Aku menunggu firman-Mu."]
    },
    {
      "verse": 82,
      "text": [
        "> Mataku lelah merindukan firman-Mu,",
        "> Sambil berkata, \"Kapan Engkau akan menghibur aku?\""
      ]
    },
    {
      "verse": 83,
      "text": [
        "> Meskipun aku telah menjadi seperti kantong anggur kering dalam asap,",
        "> Aku tidak melupakan ketetapan-Mu."
      ]
    },
    {
      "verse": 84,
      "text": [
        "> Berapa lama lagi hari-hariku, hamba-Mu?",
        "> Kapan Engkau akan membawa keadilan kepada mereka yang mengejar aku?"
      ]
    },
    {
      "verse": 85,
      "text": [
        "> Orang-orang sombong telah menggali lubang untuk aku,",
        "> Orang-orang yang tidak sejalan dengan hukum-Mu."
      ]
    },
    {
      "verse": 86,
      "text": [
        "> Semua perintah-Mu setia;",
        "> Mereka telah menganiaya aku dengan kebohongan; tolonglah aku!"
      ]
    },
    {
      "verse": 87,
      "text": [
        "> Mereka hampir membinasakan aku di bumi,",
        "> Tetapi aku tidak meninggalkan titah-titah-Mu."
      ]
    },
    {
      "verse": 88,
      "text": [
        "> Hidupkanlah aku sesuai dengan kasih setia-Mu,",
        "> Supaya aku memelihara kesaksian dari mulut-Mu."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ל Lamedh"]
    },
    {
      "verse": 89,
      "text": ["> Untuk selama-lamanya, Tuhan,", "> Firman-Mu berdiri di surga."]
    },
    {
      "verse": 90,
      "text": [
        "> Kesetiaan-Mu berlanjut sepanjang generasi;",
        "> Engkau menegakkan bumi, dan itu berdiri."
      ]
    },
    {
      "verse": 91,
      "text": [
        "> Mereka berdiri hari ini oleh hukum-hukum-Mu,",
        "> Karena segala sesuatu melayani Engkau."
      ]
    },
    {
      "verse": 92,
      "text": [
        "> Seandainya hukum-Mu bukan kegembiraanku,",
        "> Aku sudah binasa dalam penderitaanku."
      ]
    },
    {
      "verse": 93,
      "text": [
        "> Aku tidak akan melupakan titah-titah-Mu,",
        "> Karena oleh mereka Engkau telah menghidupkan aku."
      ]
    },
    {
      "verse": 94,
      "text": ["> Aku milik-Mu; selamatkanlah aku,", "> Karena aku telah mencari titah-titah-Mu."]
    },
    {
      "verse": 95,
      "text": [
        "> Orang-orang fasik menunggu untuk membinasakan aku;",
        "> Aku akan dengan tekun mempertimbangkan peringatan-Mu."
      ]
    },
    {
      "verse": 96,
      "text": ["> Aku telah melihat batas dari segala kesempurnaan;", "> Perintah-Mu sangat luas."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["מ Mem"]
    },
    {
      "verse": 97,
      "text": ["> Betapa aku mencintai hukum-Mu!", "> Itu adalah renunganku sepanjang hari."]
    },
    {
      "verse": 98,
      "text": [
        "> Perintah-Mu membuat aku lebih bijaksana daripada musuh-musuhku,",
        "> Karena mereka selalu milikku."
      ]
    },
    {
      "verse": 99,
      "text": [
        "> Aku memiliki lebih banyak wawasan daripada semua guruku,",
        "> Karena peringatan-Mu adalah renunganku."
      ]
    },
    {
      "verse": 100,
      "text": [
        "> Aku mengerti lebih dari orang-orang tua,",
        "> Karena aku telah memelihara titah-titah-Mu."
      ]
    },
    {
      "verse": 101,
      "text": [
        "> Aku telah menjaga kakiku dari setiap jalan yang jahat,",
        "> Supaya aku dapat memelihara firman-Mu."
      ]
    },
    {
      "verse": 102,
      "text": ["> Aku tidak menyimpang dari hukum-hukum-Mu,", "> Karena Engkau telah mengajar aku."]
    },
    {
      "verse": 103,
      "text": [
        "> Betapa manisnya firman-Mu bagi rasaku!",
        "> Ya, lebih manis daripada madu bagi mulutku!"
      ]
    },
    {
      "verse": 104,
      "text": [
        "> Dari titah-titah-Mu aku mendapatkan pengertian;",
        "> Oleh karena itu aku membenci setiap jalan yang palsu."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["נ Nun"]
    },
    {
      "verse": 105,
      "text": ["> Firman-Mu adalah pelita bagi kakiku", "> Dan terang bagi jalanku."]
    },
    {
      "verse": 106,
      "text": [
        "> Aku telah bersumpah dan akan menepatinya,",
        "> Bahwa aku akan memelihara hukum-hukum-Mu yang benar."
      ]
    },
    {
      "verse": 107,
      "text": ["> Aku sangat menderita;", "> Hidupkanlah aku, Tuhan, sesuai dengan firman-Mu."]
    },
    {
      "verse": 108,
      "text": [
        "> Terimalah persembahan sukarela dari mulutku, Tuhan,",
        "> Dan ajarkanlah hukum-hukum-Mu kepadaku."
      ]
    },
    {
      "verse": 109,
      "text": ["> Hidupku selalu dalam genggamanku,", "> Namun aku tidak melupakan hukum-Mu."]
    },
    {
      "verse": 110,
      "text": [
        "> Orang-orang fasik telah memasang perangkap untuk aku,",
        "> Namun aku tidak menyimpang dari titah-titah-Mu."
      ]
    },
    {
      "verse": 111,
      "text": [
        "> Aku telah menerima peringatan-Mu sebagai warisan abadi,",
        "> Karena mereka adalah kegembiraan hatiku."
      ]
    },
    {
      "verse": 112,
      "text": [
        "> Aku telah menetapkan hatiku untuk melaksanakan ketetapan-Mu",
        "> Selamanya, bahkan sampai akhir."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ס Samekh"]
    },
    {
      "verse": 113,
      "text": ["> Aku benci orang-orang yang berpikiran ganda,", "> Tetapi aku mencintai hukum-Mu."]
    },
    {
      "verse": 114,
      "text": ["> Engkau adalah perlindunganku dan perisaiku;", "> Aku berharap kepada firman-Mu."]
    },
    {
      "verse": 115,
      "text": [
        "> Menjauhlah dariku, kamu pelaku kejahatan,",
        "> Supaya aku dapat memelihara perintah-perintah Tuhanku."
      ]
    },
    {
      "verse": 116,
      "text": [
        "> Topanglah aku sesuai dengan firman-Mu, supaya aku hidup;",
        "> Dan jangan biarkan aku merasa malu atas harapanku."
      ]
    },
    {
      "verse": 117,
      "text": [
        "> Teguhkanlah aku supaya aku selamat,",
        "> Supaya aku dapat menghormati ketetapan-Mu terus-menerus."
      ]
    },
    {
      "verse": 118,
      "text": [
        "> Engkau telah menolak semua orang yang menyimpang dari ketetapan-Mu,",
        "> Karena tipu daya mereka sia-sia."
      ]
    },
    {
      "verse": 119,
      "text": [
        "> Engkau telah menghilangkan semua orang fasik dari bumi sebagai kotoran;",
        "> Oleh karena itu aku mencintai ketetapan-Mu."
      ]
    },
    {
      "verse": 120,
      "text": ["> Tubuhku gemetar karena takut kepada-Mu,", "> Dan aku takut akan hukum-hukum-Mu."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ע Ayin"]
    },
    {
      "verse": 121,
      "text": [
        "> Aku telah melakukan keadilan dan kebenaran;",
        "> Jangan tinggalkan aku kepada penindasku."
      ]
    },
    {
      "verse": 122,
      "text": [
        "> Jadilah penjamin bagi hamba-Mu untuk kebaikan;",
        "> Jangan biarkan orang-orang sombong menindas aku."
      ]
    },
    {
      "verse": 123,
      "text": ["> Mataku lelah merindukan keselamatan-Mu,", "> Dan firman-Mu yang benar."]
    },
    {
      "verse": 124,
      "text": [
        "> Perlakukanlah hamba-Mu dengan kasih setia-Mu,",
        "> Dan ajarkanlah ketetapan-Mu kepadaku."
      ]
    },
    {
      "verse": 125,
      "text": [
        "> Aku adalah hamba-Mu; berilah aku pengertian,",
        "> Supaya aku dapat mengetahui peringatan-Mu."
      ]
    },
    {
      "verse": 126,
      "text": [
        "> Inilah saatnya bagi Tuhan untuk bertindak,",
        "> Karena mereka telah melanggar hukum-Mu."
      ]
    },
    {
      "verse": 127,
      "text": [
        "> Oleh karena itu aku mencintai perintah-Mu",
        "> Lebih dari emas, ya, lebih dari emas murni."
      ]
    },
    {
      "verse": 128,
      "text": [
        "> Oleh karena itu aku mengikuti semua titah-Mu dengan hati-hati,",
        "> Aku membenci setiap jalan yang palsu."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["פ Pe"]
    },
    {
      "verse": 129,
      "text": ["> Peringatan-Mu luar biasa;", "> Oleh karena itu jiwaku memeliharanya."]
    },
    {
      "verse": 130,
      "text": [
        "> Penyataan firman-Mu membawa terang;",
        "> Itu memberikan pengertian kepada orang yang sederhana."
      ]
    },
    {
      "verse": 131,
      "text": [
        "> Aku membuka mulutku lebar-lebar dengan kerinduan,",
        "> Karena aku merindukan perintah-Mu."
      ]
    },
    {
      "verse": 132,
      "text": [
        "> Berpalinglah kepadaku dan kasihanilah aku,",
        "> Seperti yang layak bagi mereka yang mencintai nama-Mu."
      ]
    },
    {
      "verse": 133,
      "text": [
        "> Teguhkanlah langkahku dalam firman-Mu,",
        "> Dan jangan biarkan kejahatan menguasai aku."
      ]
    },
    {
      "verse": 134,
      "text": [
        "> Bebaskanlah aku dari penindasan manusia,",
        "> Supaya aku dapat memelihara titah-titah-Mu."
      ]
    },
    {
      "verse": 135,
      "text": [
        "> Biarlah wajah-Mu bersinar atas hamba-Mu,",
        "> Dan ajarkanlah ketetapan-Mu kepadaku."
      ]
    },
    {
      "verse": 136,
      "text": ["> Mataku mengalirkan air mata,", "> Karena mereka tidak memelihara hukum-Mu."]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["צ Tsadhe"]
    },
    {
      "verse": 137,
      "text": ["> Engkau benar, Tuhan,", "> Dan hukum-hukum-Mu benar."]
    },
    {
      "verse": 138,
      "text": [
        "> Engkau telah memerintahkan peringatan-Mu dengan kebenaran",
        "> Dan dengan kesetiaan yang besar."
      ]
    },
    {
      "verse": 139,
      "text": [
        "> Semangatku telah menguasai aku,",
        "> Karena musuh-musuhku telah melupakan firman-Mu."
      ]
    },
    {
      "verse": 140,
      "text": ["> Firman-Mu sangat murni,", "> Oleh karena itu hamba-Mu mencintainya."]
    },
    {
      "verse": 141,
      "text": ["> Aku tidak berarti dan dihina,", "> Namun aku tidak melupakan titah-titah-Mu."]
    },
    {
      "verse": 142,
      "text": [
        "> Kebenaran-Mu adalah keadilan yang kekal,",
        "> Dan hukum-Mu adalah inti dari kebenaran."
      ]
    },
    {
      "verse": 143,
      "text": [
        "> Kesusahan dan kesedihan telah menimpa aku,",
        "> Namun perintah-Mu membawa kegembiraan bagiku."
      ]
    },
    {
      "verse": 144,
      "text": [
        "> Peringatan-Mu adalah benar selamanya;",
        "> Berilah aku pengertian supaya aku dapat hidup."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ק Qoph"]
    },
    {
      "verse": 145,
      "text": [
        "> Aku berseru dengan segenap hatiku; jawablah aku, Tuhan!",
        "> Aku akan memelihara ketetapan-Mu."
      ]
    },
    {
      "verse": 146,
      "text": [
        "> Aku berseru kepada-Mu; selamatkanlah aku,",
        "> Dan aku akan memelihara peringatan-Mu."
      ]
    },
    {
      "verse": 147,
      "text": [
        "> Aku bangun sebelum fajar dan berseru meminta pertolongan;",
        "> Aku menunggu firman-Mu."
      ]
    },
    {
      "verse": 148,
      "text": ["> Mataku menantikan jaga malam,", "> Supaya aku dapat merenungkan firman-Mu."]
    },
    {
      "verse": 149,
      "text": [
        "> Dengarlah suaraku sesuai dengan kasih setia-Mu;",
        "> Hidupkanlah aku, Tuhan, sesuai dengan hukum-hukum-Mu."
      ]
    },
    {
      "verse": 150,
      "text": ["> Mereka yang mengejar kejahatan mendekat;", "> Mereka jauh dari hukum-Mu."]
    },
    {
      "verse": 151,
      "text": ["> Namun Engkau dekat, Tuhan,", "> Dan semua perintah-Mu adalah kebenaran."]
    },
    {
      "verse": 152,
      "text": [
        "> Sejak dahulu aku telah belajar dari peringatan-Mu,",
        "> Bahwa Engkau telah menetapkannya untuk selamanya."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ר Resh"]
    },
    {
      "verse": 153,
      "text": [
        "> Lihatlah penderitaanku dan selamatkanlah aku,",
        "> Karena aku tidak melupakan hukum-Mu."
      ]
    },
    {
      "verse": 154,
      "text": [
        "> Belalah perkaraku dan tebuslah aku;",
        "> Hidupkanlah aku sesuai dengan firman-Mu."
      ]
    },
    {
      "verse": 155,
      "text": [
        "> Keselamatan jauh dari orang fasik,",
        "> Karena mereka tidak mencari ketetapan-Mu."
      ]
    },
    {
      "verse": 156,
      "text": ["> Besar kasih setia-Mu, Tuhan;", "> Hidupkanlah aku sesuai dengan hukum-hukum-Mu."]
    },
    {
      "verse": 157,
      "text": [
        "> Banyaklah penganiaya dan musuhku,",
        "> Namun aku tidak menyimpang dari peringatan-Mu."
      ]
    },
    {
      "verse": 158,
      "text": [
        "> Aku melihat orang-orang yang berkhianat dan merasa jijik,",
        "> Karena mereka tidak memelihara firman-Mu."
      ]
    },
    {
      "verse": 159,
      "text": [
        "> Pertimbangkanlah betapa aku mencintai titah-titah-Mu;",
        "> Hidupkanlah aku, Tuhan, sesuai dengan kasih setia-Mu."
      ]
    },
    {
      "verse": 160,
      "text": [
        "> Seluruh firman-Mu adalah kebenaran,",
        "> Dan setiap hukum-Mu yang benar adalah kekal."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ש Sin dan Shin"]
    },
    {
      "verse": 161,
      "text": [
        "> Para pangeran mengejar aku tanpa alasan,",
        "> Tetapi hatiku berdiri dalam kekaguman terhadap firman-Mu."
      ]
    },
    {
      "verse": 162,
      "text": ["> Aku bersukacita atas firman-Mu,", "> Seperti orang yang menemukan harta besar."]
    },
    {
      "verse": 163,
      "text": [
        "> Aku membenci dan merasa jijik terhadap kebohongan,",
        "> Tetapi aku mencintai hukum-Mu."
      ]
    },
    {
      "verse": 164,
      "text": ["> Aku memuji Engkau sepanjang hari", "> Karena hukum-hukum-Mu yang benar."]
    },
    {
      "verse": 165,
      "text": [
        "> Mereka yang mencintai hukum-Mu memiliki damai sejahtera yang besar,",
        "> Dan tidak ada yang membuat mereka tersandung."
      ]
    },
    {
      "verse": 166,
      "text": ["> Aku berharap akan keselamatan-Mu, Tuhan,", "> Dan mengikuti perintah-Mu."]
    },
    {
      "verse": 167,
      "text": ["> Jiwaku memelihara peringatan-Mu,", "> Dan aku sangat mencintainya."]
    },
    {
      "verse": 168,
      "text": [
        "> Aku memelihara titah-titah-Mu dan peringatan-Mu,",
        "> Karena semua jalanku ada di hadapan-Mu."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "text": ["ת Taw"]
    },
    {
      "verse": 169,
      "text": [
        "> Biarlah seruanku datang ke hadapan-Mu, Tuhan;",
        "> Berilah aku pengertian sesuai dengan firman-Mu."
      ]
    },
    {
      "verse": 170,
      "text": [
        "> Biarlah permohonanku datang ke hadapan-Mu;",
        "> Selamatkanlah aku sesuai dengan firman-Mu."
      ]
    },
    {
      "verse": 171,
      "text": [
        "> Biarlah bibirku meluap dengan pujian,",
        "> Karena Engkau mengajarkan ketetapan-Mu kepadaku."
      ]
    },
    {
      "verse": 172,
      "text": [
        "> Biarlah lidahku menyanyikan firman-Mu,",
        "> Karena semua perintah-Mu adalah kebenaran."
      ]
    },
    {
      "verse": 173,
      "text": [
        "> Biarlah tangan-Mu siap menolong aku,",
        "> Karena aku telah memilih titah-titah-Mu."
      ]
    },
    {
      "verse": 174,
      "text": ["> Aku merindukan keselamatan-Mu, Tuhan,", "> Dan hukum-Mu adalah kegembiraanku."]
    },
    {
      "verse": 175,
      "text": [
        "> Biarlah jiwaku hidup supaya dapat memuji Engkau,",
        "> Dan biarlah hukum-hukum-Mu menolong aku."
      ]
    },
    {
      "verse": 176,
      "text": [
        "> Aku telah mengembara seperti domba yang hilang; carilah hamba-Mu,",
        "> Karena aku tidak melupakan perintah-Mu."
      ]
    }
  ]
}
