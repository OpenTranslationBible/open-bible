{
    "book": "المزامير",
    "chapter": 135,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> سبحوا الرب!",
                "> مجدوا اسم الرب؛",
                "> سبحوه، يا عبيد الرب،"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> أنتم الواقفون في مسكن الرب،",
                "> في ديار بيت إلهنا!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> سبحوا الرب، لأن الرب صالح؛",
                "> رنموا لاسمه، لأنه لذيذ."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> لأن الرب اختار يعقوب لنفسه،",
                "> إسرائيل ملكًا خاصًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لأني متأكد أن الرب عظيم،",
                "> وأن ربنا فوق جميع الآلهة."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> كل ما شاء الرب فعله،",
                "> في السماء وعلى الأرض، في البحار وفي جميع أعماق المحيطات."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> هو الذي يصعد السحاب من أقاصي الأرض،",
                "> الذي يصنع البرق للمطر،",
                "> الذي يخرج الريح من خزائنه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ضرب أبكار مصر،",
                "> من الناس والبهائم."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> أرسل آيات وعجائب في وسطك، يا مصر،",
                "> ضد فرعون وجميع عبيده."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> هزم أممًا كثيرة",
                "> وأسقط ملوكًا أقوياء:"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> سيحون ملك الأموريين،",
                "> وعوج ملك باشان،",
                "> وجميع ممالك كنعان؛"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> وأعطى أرضهم ميراثًا،",
                "> ميراثًا لشعبه إسرائيل."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> اسمك، يا رب، إلى الأبد،",
                "> ذكرك، يا رب، إلى جميع الأجيال."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> لأن الرب يدين شعبه",
                "> ويرحم عبيده."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> أصنام الأمم من فضة وذهب،",
                "> عمل أيدي البشر."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> لها أفواه ولا تتكلم؛",
                "> لها عيون ولا تبصر؛"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> لها آذان ولا تسمع،",
                "> وليس في أفواهها نفس."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> مثلها يكون صانعوها،",
                "> كل من يتكل عليها."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> بيت إسرائيل، مجدوا الرب؛",
                "> بيت هارون، مجدوا الرب؛"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> بيت لاوي، مجدوا الرب؛",
                "> أنتم الذين تخافون الرب، مجدوا الرب."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> مبارك الرب من صهيون،",
                "> الساكن في أورشليم.",
                "> سبحوا الرب!"
            ]
        }
    ]
}