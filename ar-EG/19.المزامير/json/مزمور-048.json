{
    "book": "المزامير",
    "chapter": 48,
    "verses": [
        {
            "text": [
                "ترنيمة؛ مزمور لبني قورح."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> عظيم هو الرب، ومحمود جداً",
                "> في مدينة إلهنا، جبل قدسه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> جميل في ارتفاعه، يفرح الأرض كلها،",
                "> جبل صهيون في الجانب الشمالي،",
                "> مدينة الملك العظيم."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> قد أظهر إله نفسه كملجأ",
                "> في قصورها."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> حقاً، اجتمع الملوك،",
                "> مروا معاً."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> رأوها فتعجبوا؛",
                "> ارتاعوا، هربوا سريعاً."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> أخذهم هناك رعب،",
                "> ألم كالتي تلد."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> بالريح الشرقية",
                "> تحطم سفن ترشيش."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> كما سمعنا، كذلك رأينا",
                "> في مدينة رب الجنود، في مدينة إلهنا؛",
                "> إله يثبتها إلى الأبد.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> تأملنا في رحمتك، يا إله،",
                "> في وسط هيكلك."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> كما أن اسمك مشهور، يا إله،",
                "> كذلك تسبيحك في الأرض كلها؛",
                "> يمينك مملوءة بالبر."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ليفرح جبل صهيون،",
                "> لتبتهج بنات يهوذا",
                "> بسبب أحكامك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> طوفوا حول صهيون وادوروا حولها؛",
                "> عدوا أبراجها؛"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> تأملوا متارسها؛",
                "> اجتازوا في قصورها،",
                "> لكي تخبروا بها الجيل التالي."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> لأن هذا الإله هو إلهنا إلى الأبد والأبد؛",
                "> هو يهدينا حتى الموت."
            ]
        }
    ]
}