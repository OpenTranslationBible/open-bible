{
    "book": "المزامير",
    "chapter": 119,
    "verses": [
        {
            "text": [
                "א ألف"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> طوبى للذين طريقهم نقي،",
                "> الذين يتبعون شريعة الرب."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> طوبى للذين يحفظون شهاداته،",
                "> ويطلبونه بكل قلوبهم."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> لا يرتكبون أي خطأ؛",
                "> يسيرون في طرقه."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> قد وضعت وصاياك،",
                "> لكي نحفظها بدقة."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ليت طرقي تكون ثابتة",
                "> لحفظ فرائضك!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> حينئذ لن أخجل",
                "> عندما أعتبر جميع وصاياك."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> سأشكرك بصدق القلب،",
                "> عندما أتعلم أحكامك العادلة."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> سأحافظ على فرائضك؛",
                "> لا تتركني تمامًا!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ב بيت"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> كيف يحفظ الشاب طريقه نقيًا؟",
                "> بحفظه حسب كلمتك."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> بكل قلبي طلبتك؛",
                "> لا تدعني أضل عن وصاياك."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> خزنت كلمتك في قلبي،",
                "> لكي لا أخطئ إليك."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> مبارك أنت، يا رب؛",
                "> علمني فرائضك."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> بشفتيّ أعلنت",
                "> جميع أحكام فمك."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> وجدت فرحًا في طريق شهاداتك،",
                "> كما في كل الثروات."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> سأفكر في وصاياك",
                "> وأعتبر طرقك."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> سأتلذذ بفرائضك؛",
                "> لن أنسى كلمتك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ג جيميل"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> تعامل بسخاء مع عبدك،",
                "> لكي أعيش وأحفظ كلمتك."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> افتح عينيّ لأرى",
                "> عجائب من شريعتك."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> أنا غريب في الأرض؛",
                "> لا تخفِ وصاياك عني."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> نفسي تذوب شوقًا",
                "> لأحكامك في كل الأوقات."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> توبخ المتكبرين، الملعونين،",
                "> الذين يضلون عن وصاياك."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> أزل عني العار والاحتقار،",
                "> لأني أحفظ شهاداتك."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> حتى وإن جلس الرؤساء وتكلموا ضدي،",
                "> يتأمل عبدك في فرائضك."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> شهاداتك أيضًا هي سروري؛",
                "> هي مستشاريني."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ד داليت"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> نفسي تلتصق بالتراب؛",
                "> جددني حسب كلمتك."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> قد أخبرت بطرقي، وقد استجبت لي؛",
                "> علمني فرائضك."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> ساعدني في فهم طريق وصاياك،",
                "> لكي أتأمل عجائبك."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> نفسي تبكي بسبب الحزن؛",
                "> قوني حسب كلمتك."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> أزل عني طريق الكذب،",
                "> وامنحني شريعتك بنعمة."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> اخترت طريق الأمانة؛",
                "> وضعت أحكامك أمامي."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> أتمسك بشهاداتك؛",
                "> يا رب، لا تدعني أخجل!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> سأركض في طريق وصاياك،",
                "> لأنك توسع قلبي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ה هي"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> علمني، طريق فرائضك، يا رب،",
                "> وسأحفظها حتى النهاية."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> امنحني الفهم، لكي أحفظ شريعتك",
                "> وأحفظها بكل قلبي."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> ارشدني في طريق وصاياك،",
                "> لأني أتلذذ بها."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> اجذب قلبي نحو شهاداتك،",
                "> وليس نحو المكسب غير الشريف."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> حول عينيّ عن النظر إلى ما هو باطل،",
                "> وجددني في طرقك."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> ثبت كلمتك لعبدك،",
                "> كما تلهم الخشوع لك."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> أزل عني العار الذي أخشاه،",
                "> لأن أحكامك جيدة."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> ها أنا أشتاق إلى وصاياك؛",
                "> جددني من خلال برك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ו واو"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> لتأتِ إليّ نعمتك أيضًا، يا رب،",
                "> خلاصك حسب كلمتك؛"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> لكي يكون لديّ جواب لمن يعيرني،",
                "> لأني أثق في كلمتك."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> ولا تأخذ كلمة الحق تمامًا من فمي،",
                "> لأني أنتظر أحكامك."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> لذلك سأحفظ شريعتك باستمرار،",
                "> إلى الأبد."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> وسأمشي في الحرية،",
                "> لأني أطلب وصاياك."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> سأعلن أيضًا شهاداتك أمام الملوك،",
                "> ولن أخجل."
            ]
        },
        {
            "verse": 47,
            "text": [
                "> سأتلذذ بوصاياك،",
                "> التي أحبها."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> وسأرفع يدي إلى وصاياك، التي أحبها؛",
                "> وسأتأمل في فرائضك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ז زايين"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> اذكر الكلمة لعبدك،",
                "> التي جعلتني أرجوها."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> هذه هي تعزيتي في ضيقي،",
                "> أن كلمتك جددتني."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> المتكبرون يستهزئون بي تمامًا،",
                "> لكني لا أتحول عن شريعتك."
            ]
        },
        {
            "verse": 52,
            "text": [
                "> تذكرت أحكامك منذ القديم، يا رب،",
                "> ووجدت الراحة."
            ]
        },
        {
            "verse": 53,
            "text": [
                "> الغضب الشديد استولى علي بسبب الأشرار،",
                "> الذين يتركون شريعتك."
            ]
        },
        {
            "verse": 54,
            "text": [
                "> فرائضك كانت أغانيّ",
                "> في بيت رحلتي."
            ]
        },
        {
            "verse": 55,
            "text": [
                "> يا رب، أذكر اسمك في الليل،",
                "> وأحفظ شريعتك."
            ]
        },
        {
            "verse": 56,
            "text": [
                "> هذا أصبح لي،",
                "> أني أحفظ وصاياك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ח حيت"
            ]
        },
        {
            "verse": 57,
            "text": [
                "> الرب هو نصيبي؛",
                "> وعدت أن أحفظ كلماتك."
            ]
        },
        {
            "verse": 58,
            "text": [
                "> طلبت نعمتك بكل قلبي؛",
                "> كن رحيماً بي حسب كلمتك."
            ]
        },
        {
            "verse": 59,
            "text": [
                "> تأملت في طرقي",
                "> وحولت خطواتي إلى شهاداتك."
            ]
        },
        {
            "verse": 60,
            "text": [
                "> أسرعت ولم أتأخر",
                "> لأتبع وصاياك."
            ]
        },
        {
            "verse": 61,
            "text": [
                "> فخاخ الأشرار أحاطت بي،",
                "> لكني لم أنس شريعتك."
            ]
        },
        {
            "verse": 62,
            "text": [
                "> أقوم في منتصف الليل لأشكرك",
                "> بسبب أحكامك العادلة."
            ]
        },
        {
            "verse": 63,
            "text": [
                "> أنا صديق لكل الذين يخافونك،",
                "> وللذين يحفظون وصاياك."
            ]
        },
        {
            "verse": 64,
            "text": [
                "> الأرض مملوءة برحمتك، يا رب؛",
                "> علمني فرائضك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ט تيت"
            ]
        },
        {
            "verse": 65,
            "text": [
                "> لقد أحسنت إلى عبدك، يا رب،",
                "> حسب كلمتك."
            ]
        },
        {
            "verse": 66,
            "text": [
                "> علمني حسن التمييز والمعرفة،",
                "> لأني أثق في وصاياك."
            ]
        },
        {
            "verse": 67,
            "text": [
                "> قبل أن أُذل، كنت أضل،",
                "> أما الآن فأحفظ كلمتك دائمًا."
            ]
        },
        {
            "verse": 68,
            "text": [
                "> أنت صالح وتفعل ما هو صحيح؛",
                "> علمني فرائضك."
            ]
        },
        {
            "verse": 69,
            "text": [
                "> المتكبرون اختلقوا كذبة ضدي؛",
                "> بكل قلبي سأحفظ وصاياك."
            ]
        },
        {
            "verse": 70,
            "text": [
                "> قلبهم غير حساس، مثل الشحم المتصلب،",
                "> لكني أتلذذ بشريعتك."
            ]
        },
        {
            "verse": 71,
            "text": [
                "> من المفيد لي أني تعرضت للضيق،",
                "> لكي أتعلم فرائضك."
            ]
        },
        {
            "verse": 72,
            "text": [
                "> شريعة فمك أثمن لي",
                "> من آلاف قطع الذهب والفضة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "י يود"
            ]
        },
        {
            "verse": 73,
            "text": [
                "> يداك صنعتاني وشكلتاني؛",
                "> امنحني الفهم، لكي أتعلم وصاياك."
            ]
        },
        {
            "verse": 74,
            "text": [
                "> ليراني الذين يخافونك ويفرحوا،",
                "> لأني أرجو في كلمتك."
            ]
        },
        {
            "verse": 75,
            "text": [
                "> أعلم، يا رب، أن أحكامك عادلة،",
                "> وأنك سمحت لي بمواجهة التجارب بأمانة."
            ]
        },
        {
            "verse": 76,
            "text": [
                "> لتكن نعمتك تعزيني،",
                "> حسب كلمتك لعبدك."
            ]
        },
        {
            "verse": 77,
            "text": [
                "> لتأتِ إليّ رحمتك، مانحة لي الحياة،",
                "> لأن شريعتك هي سروري."
            ]
        },
        {
            "verse": 78,
            "text": [
                "> ليخجل المتكبرون، لأنهم يظلمونني بالأكاذيب؛",
                "> لكني سأتأمل في وصاياك."
            ]
        },
        {
            "verse": 79,
            "text": [
                "> ليت الذين يخافونك يتحولون إليّ،",
                "> والذين يعرفون شهاداتك."
            ]
        },
        {
            "verse": 80,
            "text": [
                "> ليثبت قلبي في فرائضك،",
                "> لكي لا أخجل."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "כ كاف"
            ]
        },
        {
            "verse": 81,
            "text": [
                "> نفسي تذبل من أجل خلاصك؛",
                "> أنتظر كلمتك."
            ]
        },
        {
            "verse": 82,
            "text": [
                "> عينيّ تذبل شوقًا لكلمتك،",
                "> بينما أقول، \"متى ستعزيني؟\""
            ]
        },
        {
            "verse": 83,
            "text": [
                "> رغم أني أصبحت مثل زقاق جاف في الدخان،",
                "> لا أنسى فرائضك."
            ]
        },
        {
            "verse": 84,
            "text": [
                "> ما هو مقياس أيامي، عبدك؟",
                "> متى ستجلب العدالة لمن يطاردونني؟"
            ]
        },
        {
            "verse": 85,
            "text": [
                "> المتكبرون حفروا حفرًا لي،",
                "> أناس لا يتفقون مع شريعتك."
            ]
        },
        {
            "verse": 86,
            "text": [
                "> جميع وصاياك أمينة؛",
                "> لقد اضطهدوني بالأكاذيب؛ ساعدني!"
            ]
        },
        {
            "verse": 87,
            "text": [
                "> كادوا يدمرونني على الأرض،",
                "> لكني لم أترك وصاياك."
            ]
        },
        {
            "verse": 88,
            "text": [
                "> أحييني حسب رحمتك،",
                "> لكي أحفظ شهادة فمك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ל لاميد"
            ]
        },
        {
            "verse": 89,
            "text": [
                "> إلى الأبد، يا رب،",
                "> كلمتك ثابتة في السماء."
            ]
        },
        {
            "verse": 90,
            "text": [
                "> أمانتك تستمر عبر الأجيال؛",
                "> قد أسست الأرض، وهي ثابتة."
            ]
        },
        {
            "verse": 91,
            "text": [
                "> هم ثابتون هذا اليوم بأحكامك،",
                "> لأن جميع الأشياء تخدمك."
            ]
        },
        {
            "verse": 92,
            "text": [
                "> لو لم تكن شريعتك سروري،",
                "> لهلكت من ضيقي."
            ]
        },
        {
            "verse": 93,
            "text": [
                "> لن أنسى وصاياك أبدًا،",
                "> لأنك بها أحييتني."
            ]
        },
        {
            "verse": 94,
            "text": [
                "> أنا لك؛ أنقذني،",
                "> لأني طلبت وصاياك."
            ]
        },
        {
            "verse": 95,
            "text": [
                "> الأشرار يكمنون ليدمروني؛",
                "> سأعتبر شهاداتك بدقة."
            ]
        },
        {
            "verse": 96,
            "text": [
                "> لقد رأيت حدًا لكل كمال؛",
                "> وصيتك واسعة جدًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מ ميم"
            ]
        },
        {
            "verse": 97,
            "text": [
                "> كم أحب شريعتك!",
                "> هي تأملي طوال اليوم."
            ]
        },
        {
            "verse": 98,
            "text": [
                "> وصاياك تجعلني أحكم من أعدائي،",
                "> لأنها لي دائمًا."
            ]
        },
        {
            "verse": 99,
            "text": [
                "> لديّ فهم أكثر من جميع معلمي،",
                "> لأن شهاداتك هي تأملي."
            ]
        },
        {
            "verse": 100,
            "text": [
                "> أفهم أكثر من الشيوخ،",
                "> لأني حفظت وصاياك."
            ]
        },
        {
            "verse": 101,
            "text": [
                "> حفظت قدمي من كل طريق شرير،",
                "> لكي أحفظ كلمتك."
            ]
        },
        {
            "verse": 102,
            "text": [
                "> لم أتحول عن أحكامك،",
                "> لأنك علمتني."
            ]
        },
        {
            "verse": 103,
            "text": [
                "> ما أحلى كلماتك لذوقي!",
                "> نعم، أحلى من العسل لفمي!"
            ]
        },
        {
            "verse": 104,
            "text": [
                "> من وصاياك أكتسب الفهم؛",
                "> لذلك أكره كل طريق كاذب."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "נ نون"
            ]
        },
        {
            "verse": 105,
            "text": [
                "> كلمتك هي مصباح لقدمي",
                "> ونور لطريقي."
            ]
        },
        {
            "verse": 106,
            "text": [
                "> لقد أقسمت وسأوفي بها،",
                "> أني سأحفظ أحكامك العادلة."
            ]
        },
        {
            "verse": 107,
            "text": [
                "> أنا مضطهد جدًا؛",
                "> أحييني، يا رب، حسب كلمتك."
            ]
        },
        {
