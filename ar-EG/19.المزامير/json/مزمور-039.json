{
    "book": "المزامير",
    "chapter": 39,
    "verses": [
        {
            "text": [
                "لِلْمُخَرِّجِ الْمُوسِيقِيِّ، لِيَدُوثُونَ. مَزْمُورٌ لِدَاوُدَ."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> قُلْتُ: \"سَأُرَاقِبُ طُرُقِي",
                "> لِكَيْ لَا أُخْطِئَ بِلِسَانِي؛",
                "> سَأُرَاقِبُ فَمِي كَمَا بِكِمَامَةٍ",
                "> وَأَنَا فِي حُضُورِ الأَشْرَارِ.\""
            ]
        },
        {
            "verse": 2,
            "text": [
                "> كُنْتُ أَخْرَسَ وَصَامِتًا،",
                "> وَامْتَنَعْتُ حَتَّى عَنِ الْخَيْرِ،",
                "> وَتَحَرَّكَ أَلَمِي."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> احْتَرَقَ قَلْبِي فِي دَاخِلِي،",
                "> وَبَيْنَمَا كُنْتُ أَتَفَكَّرُ، اشْتَعَلَتِ النَّارُ؛",
                "> ثُمَّ تَكَلَّمْتُ بِلِسَانِي:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> \"يَا رَبُّ، أَفْهِمْنِي نِهَايَتِي،",
                "> وَمِقْيَاسَ أَيَّامِي؛",
                "> لِيَتَحَقَّقَ لِي كَمْ أَنَا زَائِلٌ."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> هَا قَدْ جَعَلْتَ أَيَّامِي قَصِيرَةً كَقَبْضَةِ يَدٍ،",
                "> وَعُمْرِي كَلاَ شَيْءٍ أَمَامَكَ؛",
                "> حَقًّا، كُلُّ إِنْسَانٍ نَفْخَةٌ فَقَط.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> حَقًّا، كُلُّ إِنْسَانٍ يَتَحَرَّكُ كَظِلٍّ عَابِرٍ؛",
                "> يُحْدِثُونَ ضَجَّةً بِلاَ جَدْوَى؛",
                "> يَجْمَعُ ثَرْوَةً، وَلاَ يَعْلَمُ مَنْ سَيَجْمَعُهَا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> وَالآنَ، يَا رَبُّ، مَاذَا أَنْتَظِرُ؟",
                "> أَمَلِي فِيكَ."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> نَجِّنِي مِنْ كُلِّ مَعَاصِيَّ؛",
                "> لَا تَجْعَلْنِي عَارًا لِلْجُهَلَاءِ."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> صِرْتُ أَخْرَسَ، لَا أَفْتَحُ فَمِي،",
                "> لأَنَّهُ أَنْتَ الَّذِي فَعَلْتَ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> أَزِلْ ضَرْبَتَكَ عَنِّي؛",
                "> بِسَبَبِ ضَغْطِ يَدِكَ أَنَا مُنْهَارٌ."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> بِالتَّوْبِيخَاتِ تُؤَدِّبُ الإِنْسَانَ مِنْ أَجْلِ الإِثْمِ؛",
                "> تَفْنَى مَا يُعَزُّ عَلَيْهِ كَالْعُثِّ؛",
                "> حَقًّا، كُلُّ إِنْسَانٍ نَفْخَةٌ فَقَط.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> اسْمَعْ صَلاَتِي، يَا رَبُّ، وَأَصْغِ إِلَى صَرْخَتِي لِلْمَعُونَةِ؛",
                "> لَا تَتَجَاهَلْ دُمُوعِي؛",
                "> لأَنِّي غَرِيبٌ مَعَكَ،",
                "> نَزِيلٌ كَكُلِّ آبَائِي."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> أَحْرِفْ نَظَرَكَ عَنِّي، لِكَيْ أَجِدَ فَرَحًا مَرَّةً أُخْرَى",
                "> قَبْلَ أَنْ أَرْحَلَ وَأَكُونَ لَا شَيْءَ."
            ]
        }
    ]
}