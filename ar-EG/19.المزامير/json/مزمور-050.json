{
    "book": "المزامير",
    "chapter": 50,
    "verses": [
        {
            "text": [
                "مزمور لآساف."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> المتعالي، إله، الرب، قد تكلم،",
                "> ودعا الأرض، من مشرق الشمس إلى مغربها."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> من صهيون، قمة الجمال،",
                "> أظهر إله نوره."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ليأتِ إلهنا ولا يصمت؛",
                "> نار آكلة تسبقه،",
                "> وعاصفة قوية تحيط به."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> يدعو السماوات من فوق،",
                "> والأرض، ليحكم على شعبه:"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> \"اجمعوا إليّ أتقيائي،",
                "> الذين دخلوا في عهد معي بذبيحة.\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "> وتعلن السماوات بره،",
                "> لأن إله هو القاضي.",
                "> سلاه"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"اسمعوا، يا شعبي، وسأتكلم؛",
                "> يا إسرائيل، سأشهد ضدك؛",
                "> أنا إله، إلهك."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> لا أوبخك على ذبائحك،",
                "> ومحرقاتك دائمًا أمامي."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> لن آخذ ثورًا من بيتك،",
                "> ولا تيوسًا من حظائرك."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> لأن كل حيوان في الغابة لي،",
                "> والبهائم على ألف جبل."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> أنا أعرف كل طير الجبال،",
                "> وكل ما يتحرك في الحقل لي."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> لو كنت جائعًا لما أخبرتك،",
                "> لأن العالم لي، وكل ما فيه."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> هل آكل لحم الثيران",
                "> أو أشرب دم التيوس؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> قدم لإله ذبيحة شكر",
                "> وأوفِ نذورك للعلي؛"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ادعني في يوم الضيق؛",
                "> أنقذك، وستكرمني.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "ولكن للأشرار يعلن إله،",
                "> \"ما حق لك أن تتلو فرائضي",
                "> وتتحدث عن عهدي؟"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> لأنك تكره التأديب،",
                "> وتلقي بكلماتي جانبًا."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> عندما ترى سارقًا، تتفق معه،",
                "> وترافق الزناة."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> تتحدث بالشر بحرية،",
                "> ولسانك ينسج الخداع."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> تجلس وتتحدث ضد أخيك؛",
                "> تسيء إلى ابن أمك."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> هذه الأفعال قد فعلتها، وأنا صامت؛",
                "> ظننت أني مثلك؛",
                "> سأوبخك وأعرض القضية أمام عينيك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> الآن تأملوا في هذا، يا من تنسون إله،",
                "> لئلا أمزقكم، ولا منقذ لكم."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> من يقدم ذبيحة شكر يكرمني؛",
                "> ولمن يسير بطريق مستقيم، سأظهر خلاص إله.\""
            ]
        }
    ]
}