{
    "book": "المزامير",
    "chapter": 111,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> سبحوا الرب!",
                "> سأعبر عن امتناني للرب بكل قلبي،",
                "> بين المستقيمين وفي الجماعة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> أعمال الرب رائعة؛",
                "> يستكشفها كل من يسر بها."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> الجلال والعظمة عمله،",
                "> وبره يدوم إلى الأبد."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> لقد ضمن أن تُذكر عجائبه؛",
                "> الرب رحيم ورؤوف."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> يوفر الطعام للذين يهابونه؛",
                "> سيتذكر عهده إلى الأبد."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> لقد كشف لشعبه قوة أعماله،",
                "> بمنحهم ميراث الأمم."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> أعمال يديه حق وعدل؛",
                "> كل وصاياه موثوقة."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> هي ثابتة إلى الأبد؛",
                "> تُنفذ بالحق والاستقامة."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> لقد جلب الفداء لشعبه؛",
                "> أسس عهده إلى الأبد؛",
                "> قدوس ومهيب اسمه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> مخافة الرب هي بداية الحكمة؛",
                "> كل من يلتزم بوصاياه يمتلك فهماً جيداً؛",
                "> تسبيحه يدوم إلى الأبد."
            ]
        }
    ]
}