{
    "book": "صموئيل الثاني الاصحاح",
    "chapter": 22,
    "verses": [
        {
            "verse": 1,
            "text": [
                "وتكلم داود بكلمات هذا النشيد للرب",
                "في اليوم الذي أنقذه الرب فيه من يد جميع أعدائه،",
                "ومن يد شاول."
            ]
        },
        {
            "verse": 2,
            "text": [
                "وقال:",
                "> \"الرب صخرتي وحصني ومنقذي؛"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> إلهي، صخرتي، الذي أجد فيه الأمان،",
                "> ترسي وقرن خلاصي،",
                "> ملجأي وملاذي؛",
                "> مخلصي، تحميني من الأذى."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> أدعو الرب المستحق للحمد،",
                "> فأخلص من أعدائي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لأن أمواج الموت أحاطت بي،",
                "> سيول الهلاك اجتاحتني؛"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> حبال الهاوية التفت حولي؛",
                "> فخاخ الموت واجهتني."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> في ضيقي دعوت الرب،",
                "> نعم، دعوت إلهي؛",
                "> من هيكله سمع صوتي،",
                "> وبلغ صراخي إلى أذنيه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ثم اهتزت الأرض وارتجفت،",
                "> أسس السماوات ارتعدت",
                "> واهتزت، لأنه غضب."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> صعد دخان من أنفه،",
                "> ونار من فمه أكلت؛",
                "> جمر اشتعل منها."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> طأطأ السماوات ونزل",
                "> وظلام كثيف تحت قدميه."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ركب على كروب وطار؛",
                "> حلق على أجنحة الرياح."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> جعل الظلام مظلته حوله،",
                "> تجمع المياه، سحب السماء الكثيفة."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> من بهاء قدامه",
                "> اشتعلت جمر النار."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> الرب أرعد من السماء،",
                "> والعلي رفع صوته."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> أرسل سهامًا وشتتهم،",
                "> برقًا وجعلهم يهربون."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ثم ظهرت مجاري البحر،",
                "> وانكشفت أسس العالم",
                "> من زجر الرب،",
                "> ومن نسمة أنفه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> أرسل من العلاء، أخذني؛",
                "> انتشلني من مياه كثيرة."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> أنقذني من عدوي القوي،",
                "> ومن مبغضي، لأنهم كانوا أقوى مني."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> واجهوني في يوم مصيبتي،",
                "> لكن الرب كان سندي."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> أخرجني إلى مكان فسيح؛",
                "> خلصني، لأنه سر بي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> كافأني الرب حسب برّي؛",
                "> حسب طهارة يدي رد لي."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> لأني حفظت طرق الرب،",
                "> ولم أرتد عن إلهي."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> لأن جميع أحكامه أمامي،",
                "> ولم أبتعد عن فرائضه."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> وكنت كاملًا أمامه،",
                "> وحفظت نفسي من إثمي."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> لذلك رد لي الرب حسب برّي،",
                "> حسب طهارتي أمام عينيه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> مع الصالح تظهر صالحًا،",
                "> ومع الكامل تظهر كاملًا؛"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> مع الطاهر تظهر طاهرًا،",
                "> ومع الملتوي تظهر ملتويًا."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> وتخلص الشعب المتواضع،",
                "> ولكن عينيك على المتكبرين لتخفضهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> لأنك أنت سراجي، يا رب؛",
                "> والرب ينير ظلمتي."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> لأنه بك أقتحم جيشًا؛",
                "> وبإلهي أتسلق سورًا."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> أما إله، فطريقه كامل؛",
                "> كلمة الرب نقية؛",
                "> هو ترس لجميع المحتمين به."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> لأنه من هو إله غير الرب؟",
                "> ومن هو صخرة غير إلهنا؟"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> إلهي هو حصني؛",
                "> ويجعل طريقي مستقيمًا."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> يجعل قدمي كأقدام الأيائل،",
                "> ويقيمني على المرتفعات."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> يعلم يدي القتال،",
                "> فتثني ذراعي قوس نحاس."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> وأعطيتني ترس خلاصك،",
                "> ولطفك جعلني عظيمًا."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> وسعت خطواتي تحتي،",
                "> فلم تزل قدماي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "> طاردت أعدائي وأهلكتهم،",
                "> ولم أرجع حتى أفنيتهم."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> أفنيتهم وسحقتهم،",
                "> فلم يقوموا؛",
                "> سقطوا تحت قدمي."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> لأنك نطقتني قوة للقتال؛",
                "> أخضعت تحتي القائمين علي."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> جعلت أعدائي يولون لي الأدبار،",
                "> فأهلكت مبغضي."
            ]
        },
        {
            "verse": 42,
            "text": [
                "> نظروا، ولم يكن من يخلصهم—",
                "> إلى الرب، فلم يجبهم."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> فسحقتهم كغبار الأرض؛",
                "> دقتهم ودستهم كطين الشوارع."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 44,
            "text": [
                "> أنقذتني من مخاصمات شعبي؛",
                "> حفظتني رأسًا للأمم؛",
                "> شعب لم أعرفه يخدمني."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> الأجانب يتملقون لي؛",
                "> عند سماعهم لي يطيعونني."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> الأجانب يذوبون،",
                "> ويخرجون مرتعدين من حصونهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "> حي هو الرب، ومبارك صخرتي؛",
                "> ومرتفع إله خلاصي،"
            ]
        },
        {
            "verse": 48,
            "text": [
                "> الإله الذي ينتقم لي،",
                "> ويخضع الشعوب تحتي،"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> الذي ينقذني أيضًا من أعدائي؛",
                "> ترفعني فوق القائمين علي؛",
                "> تنقذني من الرجل الظالم."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> لذلك أحمدك، يا رب، بين الأمم،",
                "> وأغني لاسمك."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> هو برج خلاص لملكه،",
                "> ويظهر لطفًا لمسيحه،",
                "> لداود ونسله إلى الأبد.\""
            ]
        }
    ]
}