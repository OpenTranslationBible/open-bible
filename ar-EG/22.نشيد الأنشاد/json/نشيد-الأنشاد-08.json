{
    "book": "نشيد الأنشاد",
    "chapter": 8,
    "verses": [
        {
            "verse": 1,
            "text": [
                "يا ليتك كأخ لي،",
                "الذي رضعته أمي.",
                "إذا وجدتك في الخارج، أقبلك؛",
                "ولا يحتقرني أحد."
            ]
        },
        {
            "verse": 2,
            "text": [
                "أقودك وأدخلك",
                "إلى بيت أمي التي علمتني؛",
                "أعطيك خمرًا ممزوجة",
                "من عصير رماني."
            ]
        },
        {
            "verse": 3,
            "text": [
                "يده اليسرى تحت رأسي،",
                "ويمينه تعانقني."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "أقسمتكن،",
                "يا بنات أورشليم،",
                "ألا توقظن الحب أو تنبهنه",
                "حتى يشاء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "من هذه الصاعدة من البرية",
                "مستندة على حبيبها؟\"",
                "\"تحت شجرة التفاح أيقظتك؛",
                "هناك ولدت بك أمك،",
                "هناك ولدت بك التي ولدت."
            ]
        },
        {
            "verse": 6,
            "text": [
                "اجعلني كخاتم على قلبك،",
                "كخاتم على ذراعك.",
                "لأن الحب قوي كالموت،",
                "والغيرة قاسية كالهاوية؛",
                "لهيبها لهيب نار،",
                "شعلة إلهية."
            ]
        },
        {
            "verse": 7,
            "text": [
                "مياه كثيرة لا تستطيع أن تطفئ الحب،",
                "ولا تغمره الأنهار؛",
                "إن أعطى الإنسان كل ثروة بيته بدل الحب،",
                "يحتقر احتقارًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "لنا أخت صغيرة،",
                "وليس لها ثديان؛",
                "ماذا نصنع لأختنا",
                "في يوم أن تخطب؟"
            ]
        },
        {
            "verse": 9,
            "text": [
                "إن كانت سورًا،",
                "نبني عليها برج فضة؛",
                "وإن كانت بابًا،",
                "نغلقها بألواح أرز."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "كنت سورًا، وقامتي كالأبراج؛",
                "حينئذ كنت في عينيه",
                "كمن وجدت سلامًا."
            ]
        },
        {
            "verse": 11,
            "text": [
                "كان لسليمان كرم في بعل هامون؛",
                "أعطى الكرم للنواطير.",
                "كل واحد كان يأتي بألف من الفضة لأجل ثمره."
            ]
        },
        {
            "verse": 12,
            "text": [
                "كرمي الذي لي هو أمامي؛",
                "الألف لك يا سليمان،",
                "ومئتان لنواطير الثمر."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "أنت يا ساكنة في الجنات،",
                "الأصحاب يصغون لصوتك—",
                "فأسمعيني."
            ]
        },
        {
            "verse": 14,
            "text": [
                "أسرع يا حبيبي،",
                "وكن كالظبي أو كغزال الأيائل",
                "على جبال الأطياب."
            ]
        }
    ]
}