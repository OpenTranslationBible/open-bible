{
    "book": "نشيد الأنشاد",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "أعظم الأغاني، منسوبة لسليمان."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "ليقبلني بقبلات فمه!",
                "لأن حبك أطيب من الخمر."
            ]
        },
        {
            "verse": 3,
            "text": [
                "زيوتك لها رائحة طيبة،",
                "اسمك كزيت مصفى؛",
                "لذلك تحبك الفتيات."
            ]
        },
        {
            "verse": 4,
            "text": [
                "اجذبني وراءك فنجري!",
                "أدخلني الملك إلى حجاله.",
                "نفرح ونبتهج بك؛",
                "نذكر حبك أكثر من الخمر.",
                "بالحق يحبونك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "أنا سوداء وجميلة،",
                "يا بنات أورشليم،",
                "كخيام قيدار،",
                "كستائر سليمان."
            ]
        },
        {
            "verse": 6,
            "text": [
                "لا تنظرن إليّ لأني سوداء،",
                "لأن الشمس قد لوحتني.",
                "غضب عليّ بنو أمي؛",
                "جعلوني ناطورة الكروم،",
                "أما كرمي فلم أنطره."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "أخبرني يا من تحبه نفسي،",
                "أين ترعى،",
                "أين تربض عند الظهيرة؟",
                "لما أكون كمقنعة",
                "عند قطعان أصحابك؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "إن لم تعرفي،",
                "أيتها الجميلة بين النساء،",
                "اخرجي على آثار الغنم",
                "وارعي جداءك",
                "عند مساكن الرعاة."
            ]
        },
        {
            "verse": 9,
            "text": [
                "لقد شبهتك يا حبيبتي",
                "بفرس في مركبات فرعون."
            ]
        },
        {
            "verse": 10,
            "text": [
                "خدودك جميلة بالحلي،",
                "عنقك بقلائد."
            ]
        },
        {
            "verse": 11,
            "text": [
                "سنصنع لك حلياً من ذهب",
                "مع فضة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "بينما كان الملك على مائدته،",
                "أفاح نارديني رائحته."
            ]
        },
        {
            "verse": 13,
            "text": [
                "حبيبي لي كصرة المر",
                "تبيت بين ثديي."
            ]
        },
        {
            "verse": 14,
            "text": [
                "حبيبي لي كعنقود الحناء",
                "في كروم عين جدي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "ها أنت جميلة يا حبيبتي،",
                "ها أنت جميلة!",
                "عيناك حمامتان."
            ]
        },
        {
            "verse": 16,
            "text": [
                "ها أنت جميل يا حبيبي،",
                "وحلو!",
                "إن فراشنا نضير!"
            ]
        },
        {
            "verse": 17,
            "text": [
                "جذوع بيوتنا أرز،",
                "وروافدنا سرو."
            ]
        }
    ]
}