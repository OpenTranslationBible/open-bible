            ]
        },
        {
            "verse": 15,
            "text": [
                "> بوني، وعزجد، وبيباي،"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> عدونيا، وبيجواي، وعادين،"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> عاطر، وحزقيا، وعزور،"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> هوديا، وحشوم، وبصاي،"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> حاريف، وعناثوث، ونباي،"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> مغفيعش، ومشلام، وحزير،"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> مشيزبئيل، وصادوق، ويدوع،"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> فلطيا، وحنان، وعنايا،"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> هوشع، وحننيا، وحشوب،"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> حلحش، وفلحا، وشوبيك،"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> رحوم، وحشبنا، ومعسيا،"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> أخيا، وحنان، وعنان،"
            ]
        },
        {
            "verse": 27,
            "text": [
