            ]
        },
        {
            "verse": 2,
            "text": [
                "> سرايا، وعزريا، وإرميا،"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> فشحور، وعماريا، وملكيّا،"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> حطوش، وشبنيا، وملوخ،"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> حاريم، ومرموت، وعبديّا،"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> دانيال، وجنثون، وباروخ،"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> مشلام، وأبيا، وميامين،"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> معزيا، وبلجاي، وشمعيا كانوا الكهنة."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> واللاويون: يشوع بن أزنيّا، وبنوي من بني حناداد، وقدميئيل؛"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> مع إخوتهم: شبنيا، وهوديا، وقليطا، وفلايا، وحنان،"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ميكا، ورحوب، وحشبيا،"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> زكور، وشربيا، وشبنيا،"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> هوديا، وباني، وبنينو."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "رؤساء الشعب:",
