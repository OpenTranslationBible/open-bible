{
    "book": "1 Паралипоменон, глава",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "Адам, Сиф, Енос,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "Кайнан, Малелеил, Иаред,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "Енох, Мафусал, Ламех,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "Ной, и сыновья его:",
                "> Сим, Хам и Иафет."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "Сыновья Иафета:",
                "> Гомер, Магог, Мадай, Иаван, Фувал, Мешех и Фирас."
            ]
        },
        {
            "verse": 6,
            "text": [
                "Сыновья Гомера:",
                "> Ашкеназ, Дифат и Фогарма."
            ]
        },
        {
            "verse": 7,
            "text": [
                "Сыновья Иавана:",
                "> Елиса, Фарсис, Киттим и Роданим."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "Сыновья Хама:",
                "> Хуш, Мицраим, Фут и Ханаан."
            ]
        },
        {
            "verse": 9,
            "text": [
                "Сыновья Хуша:",
                "> Сева, Хавила, Савта, Раама и Савтека.",
                "> Сыновья Раамы:",
                "> Шева и Дедан."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> Хуш родил Нимрода;",
                "> он начал быть силен на земле."
            ]
        },
        {
            "verse": 11,
            "text": [
                "Мицраим родил",
                "> Лудим, Анамим, Легавим, Нафтухим,"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> Патрусим, Каслухим (откуда произошли филистимляне) и Кафторим."
            ]
        },
        {
            "verse": 13,
            "text": [
                "Ханаан родил",
                "> Сидона, своего первенца, и Хета,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "и Иевусея, Аморея и Гергесея,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "и Хивея, Аркея и Синея,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "и Арвадея, Цемарея и Хамафея."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "Сыновья Сима:",
                "> Елам, Ассур, Арфаксад, Луд, Арам.",
                "> Сыновья Арама:",
                "> Уц, Хул, Гефер и Мешех."
            ]
        },
        {
            "verse": 18,
            "text": [
                "Арфаксад родил Салу,",
                "а Сала родил Евера."
            ]
        },
        {
            "verse": 19,
            "text": [
                "У Евера родились два сына:",
                "> имя одному Фалек, потому что в его дни земля была разделена;",
                "> имя его брата Иоктан."
            ]
        },
        {
            "verse": 20,
            "text": [
                "Сыновья Иоктана:",
                "> Алмодад, Шалеф, Хацармавеф, Иерах,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "Гадорам, Узал и Дикла,"
            ]
        },
        {
            "verse": 22,
            "text": [
                "Евал, Авимаил и Шева,"
            ]
        },
        {
            "verse": 23,
            "text": [
                "Офир, Хавила и Иовав.",
                "Все они сыновья Иоктана."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> Сим, Арфаксад, Сала,"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> Евер, Фалек, Рагав,"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> Серух, Нахор, Фарра,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> и Аврам, он же Авраам."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> Сыновья Авраама:",
                "> Исаак и Измаил."
            ]
        },
        {
            "verse": 29,
            "text": [
                "Вот родословие их:",
                "> Первенец Измаила: Навиоф, затем Кедар, Адбеил и Мивсам,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "Мишма, Дума, Масса, Хадад и Фема,"
            ]
        },
        {
            "verse": 31,
            "text": [
                "Иетур, Нафиш и Кедема.",
                "Это сыновья Измаила."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 32,
            "text": [
                "Сыновья Хеттуры, наложницы Авраама, которых она родила:",
                "> Зимран, Иокшан, Медан, Мадиан, Ишбак и Шуах.",
                "> Сыновья Иокшана:",
                "> Шева и Дедан."
            ]
        },
        {
            "verse": 33,
            "text": [
                "Сыновья Мадиана:",
                "> Ефа, Ефер, Ханох, Авида и Елдага.",
                "> Все они сыновья Хеттуры."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "Авраам родил Исаака.",
                "> Сыновья Исаака:",
                "> Исав и Израиль."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 35,
            "text": [
                "Сыновья Исава:",
                "> Елифаз, Рагуил, Иеуш, Иеглом и Корей."
            ]
        },
        {
            "verse": 36,
            "text": [
                "Сыновья Елифаза:",
                "> Феман, Омар, Цефи, Гафам, Кеназ, Фамна и Амалик."
            ]
        },
        {
            "verse": 37,
            "text": [
                "Сыновья Рагуила:",
                "> Нахаф и Зерах, Шамма и Мизза."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "Сыновья Сеира:",
                "> Лотан, Шовал, Цивеон, Ана, Дишон, Ецер и Дишан."
            ]
        },
        {
            "verse": 39,
            "text": [
                "Сыновья Лотана:",
                "> Хори и Гемам; а сестра Лотана — Фамна."
            ]
        },
        {
            "verse": 40,
            "text": [
                "Сыновья Шовала:",
                "> Алян, Манахаф, Евал, Шефо и Онам.",
                "> Сыновья Цивеона:",
                "> Аия и Ана."
            ]
        },
        {
            "verse": 41,
            "text": [
                "Сын Ана:",
                "> Дишон.",
                "> Сыновья Дишона:",
                "> Хемдан, Ешбан, Ифран и Херан."
            ]
        },
        {
            "verse": 42,
            "text": [
                "Сыновья Ецера:",
                "> Билган, Зааван и Иакан.",
                "> Сыновья Дишана:",
                "> Уц и Аран."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 43,
            "text": [
                "Вот цари, которые царствовали в земле Едома прежде, нежели царствовал царь у сынов Израилевых:",
                "Бела, сын Веора, и имя города его Динава."
            ]
        },
        {
            "verse": 44,
            "text": [
                "Когда умер Бела, воцарился вместо него Иовав, сын Зераха, из Восоры."
            ]
        },
        {
            "verse": 45,
            "text": [
                "Когда умер Иовав, воцарился вместо него Хушам из земли Теманитян."
            ]
        },
        {
            "verse": 46,
            "text": [
                "Когда умер Хушам, воцарился вместо него Гаддад, сын Бедада, который поражал Мадианитян на поле Моава;",
                "и имя города его Авиф."
            ]
        },
        {
            "verse": 47,
            "text": [
                "Когда умер Гаддад, воцарился вместо него Самла из Масреки."
            ]
        },
        {
            "verse": 48,
            "text": [
                "Когда умер Самла, воцарился вместо него Саул из Реховофа, что при реке."
            ]
        },
        {
            "verse": 49,
            "text": [
                "Когда умер Саул, воцарился вместо него Баал-Ханан, сын Ахбора."
            ]
        },
        {
            "verse": 50,
            "text": [
                "Когда умер Баал-Ханан, воцарился вместо него Гаддад;",
                "и имя города его Па,",
                "и имя жены его Мехетавеель, дочь Матреды, дочери Мезагава."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 51,
            "text": [
                "Потом умер Гаддад.",
                "И были вожди Едома:",
                "вождь Фамна, вождь Алва, вождь Иетеф,"
            ]
        },
        {
            "verse": 52,
            "text": [
                "вождь Оливема, вождь Ела, вождь Пинон,"
            ]
        },
        {
            "verse": 53,
            "text": [
                "вождь Кеназ, вождь Феман, вождь Мивцар,"
            ]
        },
        {
            "verse": 54,
            "text": [
                "вождь Магдиил, вождь Ирам.",
                "Вот вожди Едома."
            ]
        }
    ]
}