{
    "book": "Псалтирь",
    "chapter": 119,
    "verses": [
        {
            "text": [
                "א Алеф"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> Блаженны те, чей путь чист,",
                "> Кто следует Закону Господа."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> Блаженны те, кто соблюдает Его свидетельства,",
                "> И ищут Его всем сердцем."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> Они также не совершают зла;",
                "> Они ходят путями Его."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> Ты установил Свои повеления,",
                "> Чтобы мы соблюдали их усердно."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> О, если бы пути мои были тверды,",
                "> Чтобы соблюдать Твои уставы!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> Тогда я не буду постыжен,",
                "> Когда буду размышлять о всех Твоих заповедях."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> Я буду благодарить Тебя искренним сердцем,",
                "> Когда научусь Твоим праведным судам."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> Я буду соблюдать Твои уставы;",
                "> Не оставляй меня полностью!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ב Бет"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> Как может юноша содержать путь свой в чистоте?",
                "> Соблюдая его по Твоему слову."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> Всем сердцем моим я искал Тебя;",
                "> Не дай мне уклониться от Твоих заповедей."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> Я сокрыл Твое слово в сердце моем,",
                "> Чтобы не согрешить против Тебя."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> Благословен Ты, Господи;",
                "> Научи меня Твоим уставам."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> Устами моими я провозгласил",
                "> Все постановления Твоих уст."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> Я нашел радость в пути Твоих свидетельств,",
                "> Как в великом богатстве."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> Я буду размышлять о Твоих повелениях",
                "> И размышлять о Твоих путях."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> Я буду наслаждаться Твоими уставами;",
                "> Я не забуду Твое слово."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ג Гимел"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> Обходись щедро с Твоим слугой,",
                "> Чтобы я жил и соблюдал Твое слово."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> Открой мои глаза, чтобы я увидел",
                "> Чудесные вещи из Твоего Закона."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> Я странник на земле;",
                "> Не скрывай от меня Твои заповеди."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> Душа моя изнемогает от желания",
                "> Твоих постановлений во всякое время."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> Ты обличаешь гордых, проклятых,",
                "> Которые уклоняются от Твоих заповедей."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> Удали от меня позор и презрение,",
                "> Ибо я соблюдаю Твои свидетельства."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> Хотя князья сидят и говорят против меня,",
                "> Твой слуга размышляет о Твоих уставах."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> Твои свидетельства также — мое наслаждение;",
                "> Они — мои советники."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ד Далет"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> Душа моя прилипла к земле;",
                "> Оживи меня по Твоему слову."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> Я рассказал о путях моих, и Ты ответил мне;",
                "> Научи меня Твоим уставам."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> Помоги мне понять путь Твоих повелений,",
                "> Чтобы я размышлял о Твоих чудесах."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> Душа моя плачет от печали;",
                "> Укрепи меня по Твоему слову."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> Удали от меня путь лжи,",
                "> И благодатно даруй мне Твой Закон."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> Я избрал путь верности;",
                "> Я поставил Твои суды перед собой."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> Я держусь за Твои свидетельства;",
                "> Господи, не дай мне быть постыженным!"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> Я побегу путем Твоих заповедей,",
                "> Ибо Ты расширишь сердце мое."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ה Хе"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> Научи меня, Господи, пути Твоих уставов,",
                "> И я буду соблюдать его до конца."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> Дай мне понимание, чтобы я соблюдал Твой Закон",
                "> И хранил его всем сердцем."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> Веди меня путем Твоих заповедей,",
                "> Ибо я наслаждаюсь им."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> Привлеки сердце мое к Твоим свидетельствам,",
                "> А не к нечестной выгоде."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> Отврати глаза мои от суеты,",
                "> И обнови меня в Твоих путях."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> Утверди Твое слово для Твоего слуги,",
                "> Как то, что внушает благоговение перед Тобой."
            ]
        },
        {
            "verse": 39,
            "text": [
                "> Удали мой позор, которого я боюсь,",
                "> Ибо Твои суды добры."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> Вот, я жажду Твоих повелений;",
                "> Обнови меня через Твою праведность."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ו Вав"
            ]
        },
        {
            "verse": 41,
            "text": [
                "> Да придет ко мне также Твоя милость, Господи,",
                "> Твое спасение по Твоему слову;"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> Чтобы у меня был ответ для того, кто насмехается надо мной,",
                "> Ибо я уповаю на Твое слово."
            ]
        },
        {
            "verse": 43,
            "text": [
                "> И не отнимай полностью слово истины из уст моих,",
                "> Ибо я жду Твоих судов."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> Так я буду соблюдать Твой Закон постоянно,",
                "> Во все времена."
            ]
        },
        {
            "verse": 45,
            "text": [
                "> И я буду ходить в свободе,",
                "> Ибо я ищу Твои повеления."
            ]
        },
        {
            "verse": 46,
            "text": [
                "> Я также буду провозглашать Твои свидетельства перед царями,",
                "> И не буду постыжен."
            ]
        },
        {
            "verse": 47,
            "text": [
                "> Я буду наслаждаться Твоими заповедями,",
                "> Которые я люблю."
            ]
        },
        {
            "verse": 48,
            "text": [
                "> И я подниму руки к Твоим заповедям, которые я люблю;",
                "> И я буду размышлять о Твоих уставах."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ז Заин"
            ]
        },
        {
            "verse": 49,
            "text": [
                "> Помни слово к Твоему слуге,",
                "> На которое Ты дал мне надежду."
            ]
        },
        {
            "verse": 50,
            "text": [
                "> Это мое утешение в моем страдании,",
                "> Что Твое слово обновило меня."
            ]
        },
        {
            "verse": 51,
            "text": [
                "> Гордые полностью насмехаются надо мной,",
                "> Но я не уклоняюсь от Твоего Закона."
            ]
        },
        {
            "verse": 52,
            "text": [
                "> Я вспомнил Твои суды издревле, Господи,",
                "> И нашел утешение."
            ]
        },
        {
            "verse": 53,
            "text": [
                "> Сильное негодование охватило меня из-за нечестивых,",
                "> Которые оставляют Твой Закон."
            ]
        },
        {
            "verse": 54,
            "text": [
                "> Твои уставы были моими песнями",
                "> В доме моего странствования."
            ]
        },
        {
            "verse": 55,
            "text": [
                "> Господи, я вспоминаю Твое имя ночью,",
                "> И соблюдаю Твой Закон."
            ]
        },
        {
            "verse": 56,
            "text": [
                "> Это стало моим,",
                "> Что я соблюдаю Твои повеления."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ח Хет"
            ]
        },
        {
            "verse": 57,
            "text": [
                "> Господь — моя часть;",
                "> Я обещал соблюдать Твои слова."
            ]
        },
        {
            "verse": 58,
            "text": [
                "> Я искал Твою милость всем сердцем;",
                "> Будь милостив ко мне по Твоему слову."
            ]
        },
        {
            "verse": 59,
            "text": [
                "> Я размышлял о путях моих",
                "> И обратил стопы мои к Твоим свидетельствам."
            ]
        },
        {
            "verse": 60,
            "text": [
                "> Я поспешил и не замедлил",
                "> Следовать Твоим заповедям."
            ]
        },
        {
            "verse": 61,
            "text": [
                "> Сети нечестивых окружили меня,",
                "> Но я не забыл Твой Закон."
            ]
        },
        {
            "verse": 62,
            "text": [
                "> Я встаю в полночь, чтобы благодарить Тебя",
                "> Из-за Твоих праведных судов."
            ]
        },
        {
            "verse": 63,
            "text": [
                "> Я друг всем, кто боится Тебя,",
                "> И тем, кто соблюдает Твои повеления."
            ]
        },
        {
            "verse": 64,
            "text": [
                "> Земля полна Твоей милости, Господи;",
                "> Научи меня Твоим уставам."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ט Тет"
            ]
        },
        {
            "verse": 65,
            "text": [
                "> Ты хорошо поступил с Твоим слугой, Господи,",
                "> По Твоему слову."
            ]
        },
        {
            "verse": 66,
            "text": [
                "> Научи меня доброму разумению и знанию,",
                "> Ибо я доверяю Твоим заповедям."
            ]
        },
        {
            "verse": 67,
            "text": [
                "> Прежде чем я был поражен, я заблуждался,",
                "> Но теперь я всегда соблюдаю Твое слово."
            ]
        },
        {
            "verse": 68,
            "text": [
                "> Ты благ и делаешь праведное;",
                "> Научи меня Твоим уставам."
            ]
        },
        {
            "verse": 69,
            "text": [
                "> Гордые сочинили ложь против меня;",
                "> Всем сердцем я буду соблюдать Твои повеления."
            ]
        },
        {
            "verse": 70,
            "text": [
                "> Их сердце нечувствительно, как затвердевший жир,",
                "> Но я наслаждаюсь Твоим Законом."
            ]
        },
        {
            "verse": 71,
            "text": [
                "> Это было полезно для меня, что я испытал трудности,",
                "> Чтобы я мог научиться Твоим уставам."
            ]
        },
        {
            "verse": 72,
            "text": [
                "> Закон Твоих уст дороже для меня,",
                "> Чем тысячи золотых и серебряных монет."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "י Йод"
            ]
        },
        {
            "verse": 73,
            "text": [
                "> Твои руки создали меня и сформировали меня;",
                "> Дай мне понимание, чтобы я мог научиться Твоим заповедям."
            ]
        },
        {
            "verse": 74,
            "text": [
                "> Пусть те, кто боится Тебя, увидят меня и возрадуются,",
                "> Потому что я надеюсь на Твое слово."
            ]
        },
        {
            "verse": 75,
            "text": [
                "> Я знаю, Господи, что Твои суды праведны,",
                "> И что Ты позволил мне испытать испытания в верности."
            ]
        },
        {
            "verse": 76,
            "text": [
                "> Пусть Твоя милость утешит меня,",
                "> По Твоему слову к Твоему слуге."
            ]
        },
        {
            "verse": 77,
            "text": [
                "> Пусть Твое сострадание придет ко мне, даруя мне жизнь,",
                "> Ибо Твой Закон — мое наслаждение."
            ]
        },
        {
            "verse": 78,
            "text": [
                "> Пусть гордые будут постыжены, ибо они обижают меня ложью;",
                "> Но я буду размышлять о Твоих повелениях."
            ]
        },
        {
            "verse": 79,
            "text": [
                "> Пусть те, кто боится Тебя, обратятся ко мне,",
                "> И те, кто знает Твои свидетельства."
            ]
        },
        {
            "verse": 80,
            "text": [
                "> Пусть мое сердце будет твердо в Твоих уставах,",
                "> Чтобы я не был постыжен."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "כ Каф"
            ]
        },
        {
            "verse": 81,
            "text": [
                "> Душа моя изнемогает в ожидании Твоего спасения;",
                "> Я жду Твое слово."
            ]
        },
        {
            "verse": 82,
            "text": [
                "> Глаза мои изнемогают от желания Твоего слова,",
                "> В то время как я говорю: «Когда Ты утешишь меня?»"
            ]
        },
        {
            "verse": 83,
            "text": [
                "> Хотя я стал как высохшая меха в дыму,",
                "> Я не забываю Твои уставы."
            ]
        },
        {
            "verse": 84,
            "text": [
                "> Какова мера моих дней, Твой слуга?",
                "> Когда Ты принесешь справедливость тем, кто преследует меня?"
            ]
        },
        {
            "verse": 85,
            "text": [
                "> Гордые вырыли ямы для меня,",
                "> Люди, которые не в согласии с Твоим Законом."
            ]
        },
        {
            "verse": 86,
            "text": [
                "> Все Твои заповеди верны;",
                "> Они преследовали меня ложью; помоги мне!"
            ]
        },
        {
            "verse": 87,
            "text": [
                "> Они почти уничтожили меня на земле,",
                "> Но я не оставил Твои повеления."
            ]
        },
        {
            "verse": 88,
            "text": [
                "> Оживи меня по Твоей милости,",
                "> Чтобы я мог соблюдать свидетельство Твоих уст."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ל Ламед"
            ]
        },
        {
            "verse": 89,
            "text": [
                "> Навеки, Господи,",
                "> Твое слово стоит на небесах."
            ]
        },
        {
            "verse": 90,
            "text": [
                "> Твоя верность продолжается во всех поколениях;",
                "> Ты утвердил землю, и она стоит."
            ]
        },
        {
            "verse": 91,
            "text": [
                "> Они стоят и сегодня по Твоим постановлениям,",
                "> Ибо все служит Тебе."
            ]
        },
        {
            "verse": 92,
            "text": [
                "> Если бы Твой Закон не был моим наслаждением,",
                "> Я бы погиб от моего страдания."
            ]
        },
        {
            "verse": 93,
            "text": [
                "> Я никогда не забуду Твои повеления,",
                "> Ибо через них Ты оживил меня."
            ]
        },
        {
            "verse": 94,
            "text": [
                "> Я принадлежу Тебе; избавь меня,",
                "> Ибо я искал Твои повеления."
            ]
        },
        {
            "verse": 95,
            "text": [
                "> Нечестивые подстерегают, чтобы уничтожить меня;",
                "> Я буду усердно размышлять о Твоих свидетельствах."
            ]
        },
        {
            "verse": 96,
            "text": [
                "> Я видел предел всякого совершенства;",
                "> Твоя заповедь чрезвычайно широка."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מ Мем"
            ]
        },
        {
            "verse": 97,
            "text": [
                "> Как я люблю Твой Закон!",
                "> Он — мое размышление весь день."
            ]
        },
        {
            "verse": 98,
            "text": [
                "> Твои заповеди делают меня мудрее врагов моих,",
                "> Ибо они всегда со мной."
            ]
        },
        {
            "verse": 99,
            "text": [
                "> У меня больше понимания, чем у всех моих учителей,",
                "> Ибо Твои свидетельства — мое размышление."
            ]
        },
        {
            "verse": 100,
            "text": [
                "> Я понимаю больше, чем старцы,",
                "> Потому что я соблюдаю Твои повеления."
            ]
        },
        {
            "verse": 101,
            "text": [
                "> Я удерживал ноги мои от всякого злого пути,",
