{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "verse": 1,
            "text": [
                "温柔的回答使怒气消退，暴躁的话激起愤怒。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "智慧人的舌头使知识增进，愚昧人的口吐出愚妄。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "耶和华的眼目无处不在，恶人善人他都鉴察。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "温和的舌头是生命树，乖谬的舌头使人心碎。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "愚妄人藐视父母的管教，领受责备的却是明智的。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "义人的家中有丰厚的财物，恶人的收入带来烦扰。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "智慧人的嘴传播知识，愚昧人的心不正。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "恶人的祭物是耶和华所憎恶的，正直人的祈祷是他所喜悦的。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "耶和华厌恶恶人的道路，喜爱追求公义的人。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "偏离正道的必受严厉的惩罚，恨恶责备的必致死亡。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "阴间和灭亡在耶和华面前敞开，何况世人的心呢！"
            ]
        },
        {
            "verse": 12,
            "text": [
                "亵慢人不喜欢受责备，也不亲近智慧人。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "心中喜乐，面带笑容；心灵忧伤，灵被压碎。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "明智的心寻求知识，愚昧人的口以愚妄为食。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "困苦人的日子都是艰难的，心中欢畅的常享盛宴。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "少有财宝，敬畏耶和华，强如多有财宝，烦扰不安。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "吃素菜彼此相爱，强如吃肥牛彼此相恨。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "暴怒的人挑起争端，忍怒的人平息纷争。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "懒惰人的路如荆棘篱笆，正直人的道如平坦大道。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "智慧的儿子使父亲喜乐，愚昧的人藐视母亲。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "无知的人以愚妄为乐，聪明的人按正路而行。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "不经商议，计划落空；谋士众多，计划成就。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "口善应对，自觉喜乐，话合其时，何等美好！"
            ]
        },
        {
            "verse": 24,
            "text": [
                "智慧人的生命道路向上，使他远离阴间。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "耶和华必拆毁骄傲人的家，却要立定寡妇的地界。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "耶和华憎恶恶人的计谋，慈爱的言语却是纯净的。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "贪婪的人扰害己家，恨恶贿赂的必得存活。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "义人的心思量如何回答，恶人的口吐出恶言。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "耶和华远离恶人，却听义人的祷告。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "眼有光使心喜乐，好信息使骨滋润。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "听从生命责备的，必常在智慧人中。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "弃绝管教的，轻看自己的生命；听从责备的，得着智慧。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "敬畏耶和华是智慧的训诲，尊荣以前必有谦卑。"
            ]
        }
    ]
}