{
    "book": "מיכה",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ואמר,",
                "> \"שמעו נא ראשי יעקב",
                "> וקציני בית ישראל.",
                "> הלוא לכם לדעת משפט?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שונאי טוב ואוהבי רעה,",
                "> הגוזלים את עורם",
                "> ואת בשרם מעל עצמותם,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> האוכלים את בשר עמי,",
                "> ומפשיטים את עורם מעליהם,",
                "> ומפצחים את עצמותיהם,",
                "> וקוצצים כאלו בסיר",
                "> וכבשר בתוך קלחת!\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אז יקראו אל ה',",
                "> ולא יענה להם.",
                "> ויסתיר פניו מהם בעת ההיא",
                "> כי עשו מעשים רעים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כה אמר ה' על הנביאים המתעים את עמי:",
                "> כאשר יש להם מה לנשוך בשיניהם,",
                "> הם קוראים, \"שלום,\"",
                "> ועל מי שלא נותן בפיהם",
                "> הם מכריזים מלחמת קודש."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> לכן לילה יהיה לכם—בלי חזון,",
                "> וחושך לכם—בלי קסם.",
                "> השמש תשקע על הנביאים,",
                "> והיום יחשיך עליהם."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> והחוזים יבושו,",
                "> והקוסמים יתביישו.",
                "> אכן, כולם יכסו את פיהם",
                "> כי אין מענה מאלוהים."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ואולם אני מלאתי כוח—",
                "> ברוח ה'—",
                "> ובמשפט ובגבורה",
                "> להגיד ליעקב פשעו,",
                "> ולישראל חטאתו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> שמעו נא זאת, ראשי בית יעקב",
                "> וקציני בית ישראל,",
                "> המתעבים משפט",
                "> ומעקשים כל ישר,"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> הבונים ציון בדמים,",
                "> וירושלים בעולה."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ראשיה ישפטו בשוחד,",
                "> כהניה יורו במחיר,",
                "> ונביאיה יקסמו בכסף.",
                "> ובכל זאת יישענו על ה' ויאמרו,",
                "> \"הלוא ה' בקרבנו?",
                "> לא תבוא עלינו רעה.\""
            ]
        },
        {
            "verse": 12,
            "text": [
                "> לכן, בגללכם",
                "> ציון תחרש כשדה,",
                "> וירושלים תהיה לעיים,",
                "> והר הבית יהיה לבמות יער."
            ]
        }
    ]
}