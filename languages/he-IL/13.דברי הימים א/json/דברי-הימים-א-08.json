{
    "book": "",
    "chapter": 0,
    "verses": [
        {
            "text": [
                "בנימין היה אב ל:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "בני בלע כללו את:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "אלה הם צאצאי אהוד.",
                "הם היו ראשי המשפחות שגרו בגבע,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "שחרים הוליד ילדים בארץ מואב",
                "לאחר ששלח את חושים ובערה נשותיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "דרך חודש אשתו, היו לו:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "עם חושים, הוליד:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "בני אלפעל היו:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "אחיו, וששק, וירמות,"
            ]
        },
        {
            "text": [
                "וזבדיה, ערד, ועדר,"
            ]
        },
        {
            "text": [
                "מיכאל, וישפה, ויוחא היו בני בריעה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "זבדיה, ומשלם, חזקי, חבר,"
            ]
        },
        {
            "text": [
                "ישמרי, ויזליה, ויובב היו בני אלפעל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "עם יקים, וזכרי, וזבדי,"
            ]
        },
        {
            "text": [
                "אליעני, וצלתיי, ואליאל,"
            ]
        },
        {
            "text": [
                "עדיה, ובריה, ושמרת היו בני שמעי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ישפן, ועבר, ואליאל,"
            ]
        },
        {
            "text": [
                "עבדון, וזכרי, וחנן,"
            ]
        },
        {
            "text": [
                "חנניה, ואלם, וענתותיה,"
            ]
        },
        {
            "text": [
                "יפדיה, ופנואל -בני ששק."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "שמשרי, ושחריה, ואתליה,"
            ]
        },
        {
            "text": [
                "יערשיה, ואליה, וזכרי היו בני ירחם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "אלה היו ראשי משפחות לפי דורותיהם,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "ועכשיו בגבעון, ייעיאל, אבי גבעון, גר,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "בנו הבכור היה עבדון, ואחריו צור, קיש, בעל, נדב,"
            ]
        },
        {
            "text": [
                "גדור, ואחיו, וזכר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מכלות היה אב לשמע."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "נר היה אב לשושלת קיש,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "בן יונתן היה מריב-בעל,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "צאצאי מיכה היו:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "אחז היה אב ליהועדה,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "מוצא היה אב לבניה;",
                "רפא היה בנו,"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "לאצל היו שישה בנים, ואלה שמותיהם:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "בני אשק כללו את:"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "text": [
                "בני אולם היו לוחמים אמיצים מיומנים בקשת,"
            ]
        }
    ]
}