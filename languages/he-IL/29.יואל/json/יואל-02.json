{
    "book": "יואל",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> תקעו שופר בציון;",
                "> הריעו בהר קודשי.",
                "> ירגזו כל יושבי הארץ,",
                "> כי בא יום ה';",
                "> כי קרוב הוא—"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> יום חושך ואפלה,",
                "> יום ענן וערפל.",
                "> כשחר פרוש על ההרים,",
                "> עם רב ועצום קם;",
                "> כמוהו לא נהיה מעולם,",
                "> ואחריו לא יוסיף עד שנות דור ודור."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> לפניו אכלה אש,",
                "> ואחריו תלהט להבה.",
                "> כגן עדן הארץ לפניו,",
                "> ואחריו מדבר שממה",
                "> —וגם פליטה לא הייתה לו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כמראה סוסים מראהו;",
                "> וכפרשים כן ירוצון."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כקול מרכבות",
                "> על ראשי ההרים ירקדון,",
                "> כקול להבת אש אכלה קש,",
                "> כעם עצום ערוך מלחמה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> מפניו יחילו עמים;",
                "> כל פנים קבצו פארור."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כגיבורים ירוצון,",
                "> כחיילים עלו חומה.",
                "> ואיש בדרכיו ילכון,",
                "> ולא יעבטון ארחותם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ואיש אחיו לא ידחקון;",
                "> גבר במסילתו ילכון.",
                "> בעד השלח יפולון",
                "> לא יבצעו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> בעיר ישקון,",
                "> בחומה ירוצון;",
                "> בבתים יעלו,",
                "> בעד החלונים יבואו כגנב."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לפניו רגזה ארץ,",
                "> רעשו שמים,",
                "> שמש וירח קדרו,",
                "> וכוכבים אספו נגהם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> וה' נתן קולו לפני חילו;",
                "> כי רב מאד מחנהו,",
                "> כי עצום עושה דברו.",
                "> כי גדול יום ה' ונורא מאד;",
                "> ומי יכילנו?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> \"ועתה,\" נאום ה',",
                "> \"שובו עדי בכל לבבכם,",
                "> ובצום ובבכי ובמספד.\""
            ]
        },
        {
            "verse": 13,
            "text": [
                "> וקרעו לבבכם ואל בגדיכם.",
                "> ושובו אל ה' אלוהיכם,",
                "> כי חנון ורחום הוא,",
                "> ארך אפיים ורב חסד,",
                "> ונחם על הרעה."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> מי יודע ישוב ונחם",
                "> והשאיר אחריו ברכה",
                "> —מנחה ונסך",
                "> לה' אלוהיכם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> תקעו שופר בציון,",
                "> קדשו צום,",
                "> קראו עצרה."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> אספו עם,",
                "> קדשו קהל;",
                "> קבצו זקנים,",
                "> אספו עוללים ויונקי שדים.",
                "> יצא חתן מחדרו",
                "> וכלה מחופתה."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> בין האולם ולמזבח יבכו הכוהנים, משרתי ה',",
                "> ויאמרו,",
                "> \"חוסה ה' על עמך,",
                "> ואל תתן נחלתך לחרפה,",
                "> למשול בם גויים.",
                "> למה יאמרו בעמים,",
                "> 'איה אלוהיהם?'\""
            ]
        },
        {
            "verse": 18,
            "text": [
                "אז יקנא ה' לארצו ויחמול על עמו."
            ]
        },
        {
            "verse": 19,
            "text": [
                "ויען ה' ויאמר לעמו:",
                "> \"הנני שולח לכם דגן ותירוש ויצהר,",
                "> ושבעתם בו;",
                "> ולא אתן אתכם עוד חרפה בגויים."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> \"ואת הצפוני ארחיק מעליכם,",
                "> והדחתיו אל ארץ ציה ושממה;",
                "> את פניו אל הים הקדמוני",
                "> וסופו אל הים האחרון.",
                "> ועלה באשו ותעל צחנתו.\"",
                "> כי הגדיל לעשות!"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> אל תיראי, אדמה;",
                "> גילי ושמחי,",
                "> כי הגדיל ה' לעשות!"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אל תיראו, בהמות שדי,",
                "> כי דשאו נאות מדבר.",
                "> כי עץ נשא פריו;",
                "> תאנה וגפן נתנו חילם."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> ובני ציון גילו ושמחו",
                "> בה' אלוהיכם,",
                "> כי נתן לכם את המורה לצדקה.",
                "> ויורד לכם גשם מורה ומלקוש בראשון."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ומלאו הגרנות בר,",
                "> והשיקו היקבים תירוש ויצהר."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> \"ושלמתי לכם את השנים",
                "> אשר אכל הארבה—הילק",
                "> והחסיל והגזם",
                "> —חילי הגדול אשר שלחתי בכם."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> ואכלתם אכול ושבוע,",
                "> והללתם את שם ה' אלוהיכם,",
                "> אשר עשה עמכם להפליא;",
                "> ולא יבושו עמי לעולם."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> וידעתם כי בקרב ישראל אני,",
                "> ואני ה' אלוהיכם,",
                "> ואין עוד;",
                "> ולא יבושו עמי לעולם."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> \"והיה אחרי כן,",
                "> אשפוך את רוחי על כל בשר.",
                "> ונבאו בניכם ובנותיכם,",
                "> זקניכם חלומות יחלמון,",
                "> בחוריכם חזיונות יראו."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> וגם על העבדים ועל השפחות",
                "> בימים ההם אשפוך את רוחי."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> ונתתי מופתים בשמים ובארץ,",
                "> דם ואש ותמרות עשן."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> השמש יהפך לחשך",
                "> והירח לדם",
                "> לפני בוא יום ה' הגדול והנורא."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> והיה כל אשר יקרא",
                "> בשם ה' ימלט;",
                "> כי בהר ציון ובירושלים",
                "> תהיה פליטה,",
                "> כאשר אמר ה',",
                "> ובשרידים אשר ה' קורא."
            ]
        }
    ]
}