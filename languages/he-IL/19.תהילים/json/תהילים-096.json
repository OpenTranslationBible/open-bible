{
    "book": "תהילים",
    "chapter": 96,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> שירו לה' שיר חדש;",
                "> שירו לה', כל הארץ."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שירו לה', ברכו שמו;",
                "> בשרו מיום ליום ישועתו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ספרו בגוים כבודו,",
                "> בכל העמים נפלאותיו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי גדול ה' ומהולל מאוד;",
                "> נורא הוא על כל אלוהים."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי כל אלוהי העמים אלילים,",
                "> וה' שמים עשה."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> הוד והדר לפניו,",
                "> עוז ותפארת במקדשו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> הבו לה' משפחות עמים,",
                "> הבו לה' כבוד ועוז."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> הבו לה' כבוד שמו;",
                "> שאו מנחה ובואו לחצרותיו."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> השתחוו לה' בהדרת קודש;",
                "> חילו מלפניו, כל הארץ."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אמרו בגוים, \"ה' מלך;",
                "> אף תיכון תבל, בל תימוט;",
                "> ידין עמים במישרים.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ישמחו השמים ותגל הארץ;",
                "> ירעם הים ומלואו;"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> יעלוז שדה וכל אשר בו;",
                "> אז ירננו כל עצי יער"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לפני ה', כי בא,",
                "> כי בא לשפוט הארץ.",
                "> ישפוט תבל בצדק,",
                "> ועמים באמונתו."
            ]
        }
    ]
}