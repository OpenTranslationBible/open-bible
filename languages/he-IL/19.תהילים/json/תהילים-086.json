{
    "book": "תהילים",
    "chapter": 86,
    "verses": [
        {
            "text": [
                "תפילה לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> הטה אוזנך, ה' וענני;",
                "> כי עני ואביון אני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמרה נפשי כי חסיד אני;",
                "> אתה אלוהי, הושע עבדך הבוטח בך."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> חנני, ה'",
                "> כי אליך אקרא כל היום."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> שמח נפש עבדך,",
                "> כי אליך, ה', נפשי אשא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי אתה, ה', טוב וסלח,",
                "> ורב חסד לכל קוראיך."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> האזן, ה', תפילתי;",
                "> והקשיבה לקול תחנוני!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ביום צרתי אקראך,",
                "> כי תענני."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אין כמוך באלוהים, ה',",
                "> ואין כמעשיך."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כל הגויים אשר עשית יבואו וישתחוו לפניך, ה',",
                "> ויכבדו שמך."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי גדול אתה ועושה נפלאות;",
                "> אתה אלוהים לבדך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הורני, ה', דרכך;",
                "> אהלך באמתך;",
                "> יחד לבבי ליראה שמך."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אודך, ה' אלוהי, בכל לבבי,",
                "> ואכבד שמך לעולם."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי חסדך גדול עלי,",
                "> והצלת נפשי משאול תחתיה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אלוהים, זדים קמו עלי,",
                "> ועדת עריצים בקשו נפשי,",
                "> ולא שמוך לנגדם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ואתה, ה', אל רחום וחנון,",
                "> ארך אפיים ורב חסד ואמת."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> פנה אלי וחנני;",
                "> תנה עזך לעבדך,",
                "> והושיעה לבן אמתך."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> עשה עמי אות לטובה,",
                "> ויראו שונאי ויבושו,",
                "> כי אתה, ה', עזרתני וניחמתני."
            ]
        }
    ]
}