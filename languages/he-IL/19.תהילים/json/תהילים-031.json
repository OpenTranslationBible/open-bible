{
    "book": "תהילים",
    "chapter": 31,
    "verses": [
        {
            "text": [
                "למנצח מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> בך ה' חסיתי;",
                "> אל אבוש לעולם;",
                "> בצדקתך תצילני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הטה אלי אוזנך, מהרה הצילני;",
                "> היה לי לצור מעוז,",
                "> לבית מצודות להושיעני."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי סלעי ומצודתי אתה;",
                "> ולמען שמך תנחני ותנהלני."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> תוציאני מרשת זו טמנו לי,",
                "> כי אתה מעוזי."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> בידך אפקיד רוחי;",
                "> פדית אותי, ה' אל אמת."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> שנאתי השומרים הבלי שווא,",
                "> ואני על ה' בטחתי."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אגילה ואשמחה בחסדך,",
                "> אשר ראית את עניי;",
                "> ידעת בצרות נפשי,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ולא הסגרתני ביד אויב;",
                "> העמדת במרחב רגלי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> חנני ה' כי צר לי;",
                "> עששה בכעס עיני, נפשי ובטני."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> כי כלו ביגון חיי",
                "> ושנותי באנחה;",
                "> כשל בעווני כוחי,",
                "> ועצמותי עששו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> מכל צוררי הייתי חרפה,",
                "> ולשכני מאוד,",
                "> ופחד למיודעי;",
                "> רואי בחוץ נדדו ממני."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> נשכחתי כמת מלב;",
                "> הייתי ככלי אובד."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי שמעתי דיבת רבים,",
                "> מגור מסביב;",
                "> בהוסדם יחד עלי,",
                "> לקחת נפשי זממו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> ואני עליך בטחתי ה',",
                "> אמרתי, \"אלי אתה.\""
            ]
        },
        {
            "verse": 15,
            "text": [
                "> בידך עתותי;",
                "> הצילני מיד אויבי ומרדפי."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> האירה פניך על עבדך;",
                "> הושיעני בחסדך."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> ה' אל אבושה כי קראתיך;",
                "> יבושו רשעים, ידמו לשאול."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> תאלמנה שפתי שקר,",
                "> הדוברות על צדיק עתק",
                "> בגאווה ובוז."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> מה רב טובך,",
                "> אשר צפנת ליראיך,",
                "> פעלת לחוסים בך,",
                "> נגד בני אדם!"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> תסתירם בסתר פניך מרכסי איש;",
                "> תצפנם בסוכה מריב לשונות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ברוך ה',",
                "> כי הפליא חסדו לי בעיר מצור."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ואני אמרתי בחפזי,",
                "> \"נגזרתי מנגד עיניך!\"",
                "> אכן שמעת קול תחנוני",
                "> בשועי אליך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> אהבו את ה', כל חסידיו!",
                "> אמונים נוצר ה'",
                "> ומשלם על יתר עשה גאווה."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> חזקו ויאמץ לבבכם,",
                "> כל המיחלים לה'."
            ]
        }
    ]
}