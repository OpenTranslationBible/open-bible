{
    "book": "תהילים",
    "chapter": 115,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> לא לנו, יהוה, לא לנו,",
                "> כי לשמך תן כבוד,",
                "> על חסדך ועל אמיתך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> למה יאמרו הגויים,",
                "> \"איה נא אלהיהם?\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ואלהינו בשמים;",
                "> כל אשר חפץ עשה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> עצביהם כסף וזהב,",
                "> מעשה ידי אדם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> פה להם ולא ידברו;",
                "> עיניים להם ולא יראו;"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אוזניים להם ולא ישמעו;",
                "> אף להם ולא יריחון;"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ידיהם ולא ימישון;",
                "> רגליהם ולא יהלכו;",
                "> לא יהגו בגרונם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כמוהם יהיו עושיהם,",
                "> כל אשר בטח בהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ישראל, בטח ביהוה;",
                "> עזרם ומגנם הוא."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> בית אהרן, בטחו ביהוה;",
                "> עזרם ומגנם הוא."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> יראי יהוה, בטחו ביהוה;",
                "> עזרם ומגנם הוא."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> יהוה זכרנו יברך;",
                "> יברך את בית ישראל;",
                "> יברך את בית אהרן."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> יברך יראי יהוה,",
                "> הקטנים עם הגדולים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> יוסף יהוה עליכם,",
                "> עליכם ועל בניכם."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ברוכים אתם ליהוה,",
                "> עושה שמים וארץ."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> השמים שמים ליהוה,",
                "> והארץ נתן לבני אדם."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> לא המתים יהללו יה,",
                "> ולא כל יורדי דומה;"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ואנחנו נברך יה,",
                "> מעתה ועד עולם.",
                "> הללו יה!"
            ]
        }
    ]
}