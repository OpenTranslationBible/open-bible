{
    "book": "תהילים",
    "chapter": 64,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> שמע, אלוהים, קולי בשיחי;",
                "> מחי חיי מפחד אויב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> תסתרני מסוד מרעים,",
                "> מרגשת פועלי און,"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אשר שננו כחרב לשונם.",
                "> דרכו חצם דבר מר,"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> לירות במסתרים תם;",
                "> פתאום יורים ולא ייראו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יחזקו למו דבר רע;",
                "> יספרו לטמון מוקשים;",
                "> אמרו, \"מי יראה למו?\""
            ]
        },
        {
            "verse": 6,
            "text": [
                "> יחפשו עולות,",
                "> \"תמנו חפש מחפש\";",
                "> וקרב איש ולב עמוק."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ויורם אלוהים חץ;",
                "> פתאום היו מכותם."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ויכשילו;",
                "> לשונם עליהם תיפול;",
                "> ינועו כל רואיהם."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> וייראו כל אדם,",
                "> ויגידו פועל אלוהים,",
                "> ומעשהו ישכילו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ישמח צדיק ביהוה וחסה בו;",
                "> ויתהללו כל ישרי לב."
            ]
        }
    ]
}