{
    "book": "תהילים",
    "chapter": 44,
    "verses": [
        {
            "text": [
                "למנצח. משכיל לבני קורח."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אלוהים, באוזנינו שמענו,",
                "> אבותינו ספרו לנו",
                "> פועלך בימיהם,",
                "> בימי קדם."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ידך החזקה גרשה גויים ותכונן אבותינו;",
                "> ענית עמים ותשלחם לחופשי."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי לא בחרבם ירשו ארץ,",
                "> וזרועם לא הושיעה למו,",
                "> כי ימינך וזרועך ואור פניך,",
                "> כי רציתם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אתה הוא מלכי, אלוהים;",
                "> צווה ישועות ליעקב."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> בך נדוף צרינו;",
                "> בשמך נבוס קמינו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> כי לא בקשתי אבטח,",
                "> וחרבי לא תושיעני."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כי הושעתנו מצרינו,",
                "> ומשנאינו הבישות."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> באלוהים הללנו כל היום,",
                "> ונודה שמך לעולם.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> אף זנחת ותכלימנו,",
                "> ולא תצא בצבאותינו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> תשיבנו אחור מני צר,",
                "> ומשנאינו שׁסו למו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> תתננו כצאן מאכל,",
                "> ובגויים זריתנו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> תמכור עמך בלא הון,",
                "> ולא רבית במחיריהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> תשימנו חרפה לשכנינו,",
                "> לעג וקלס לסביבותינו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> תשימנו משל בגויים,",
                "> מנוד ראש בעמים."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כל היום כלמתי נגדי,",
                "> ובשת פני כסתני,"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> מקול מחרף ומגדף,",
                "> מפני אויב ומתנקם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כל זאת באתנו ולא שכחנוך,",
                "> ולא שקרנו בבריתך."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> לא נסוג לבנו אחור,",
                "> ותיט אשורינו מני ארחך,"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> כי דכיתנו במקום תנים,",
                "> ותכס עלינו בצלמות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> אם שכחנו שם אלוהינו",
                "> ונפרוש כפינו לאל זר,"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> הלא אלוהים יחקור זאת?",
                "> כי הוא יודע תעלומות לב."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> כי עליך הורגנו כל היום;",
                "> נחשבנו כצאן טבחה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> עורה, למה תישן, אדוני?",
                "> הקיצה, אל תזנח לנצח."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> למה פניך תסתיר",
                "> תשכח עניינו ולחצנו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> כי שחה לעפר נפשנו;",
                "> דבקה לארץ בטננו."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> קומה עזרתה לנו,",
                "> ופדנו למען חסדך."
            ]
        }
    ]
}