{
    "book": "תהילים",
    "chapter": 94,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ה', אל נקמות,",
                "> אל נקמות הופיע!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> הנשא, שופט הארץ,",
                "> השב גמול על גאים."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> עד מתי רשעים, ה',",
                "> עד מתי רשעים יעלוזו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יביעו, ידברו עתק;",
                "> יתאמרו כל פועלי און."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> עמך ה', ידכאו,",
                "> ונחלתך יענו."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אלמנה וגר יהרגו,",
                "> ויתומים ירצחו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ויאמרו, \"לא יראה ה',",
                "> ולא יבין אלוהי יעקב.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> בינו, בערים בעם;",
                "> וכסילים, מתי תשכילו?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> הנטע אוזן, הלא ישמע?",
                "> אם יצר עין, הלא יביט?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> היסר גויים, הלא יוכיח,",
                "> המלמד אדם דעת?"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ה' יודע מחשבות אדם,",
                "> כי הם הבל."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אשרי הגבר אשר תיסרנו, ה',",
                "> ומתורתך תלמדנו,"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> להשקיט לו מימי רעה,",
                "> עד יכרה לרשע שחת."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> כי לא יטוש ה' עמו,",
                "> ונחלתו לא יעזוב."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> כי עד צדק ישוב משפט,",
                "> ואחריו כל ישרי לב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> מי יקום לי עם מרעים?",
                "> מי יתייצב לי עם פועלי און?"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> לולי ה' עזרתה לי,",
                "> כמעט שכנה דומה נפשי."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> אם אמרתי, \"מטה רגלי,\"",
                "> חסדך ה', יסעדני."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ברוב שרעפי בקרבי,",
                "> תנחומיך ישעשעו נפשי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> היחברך כסא הוות,",
                "> יוצר עמל עלי חוק?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> יגודו על נפש צדיק",
                "> ודם נקי ירשיעו."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ויהי ה' לי למשגב,",
                "> ואלוהי לצור מחסי."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> וישב עליהם את אונם,",
                "> וברעתם יצמיתם;",
                "> יצמיתם ה' אלוהינו."
            ]
        }
    ]
}