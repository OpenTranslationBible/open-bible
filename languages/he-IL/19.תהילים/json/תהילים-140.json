{
    "book": "תהילים",
    "chapter": 140,
    "verses": [
        {
            "text": [
                "למנצח. מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> חלצני, ה' מאדם רע;",
                "> מנאיש חמסים תשמרני"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> אשר חשבו רעות בלב;",
                "> כל יום יגורו מלחמות."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> שננו לשונם כמו נחש;",
                "> חמת עכשוב תחת שפתימו.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> שמרני, ה', מידי רשע;",
                "> מנאיש חמסים תשמרני",
                "> אשר חשבו לדחוף פעמי."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> טמנו גאים פח לי, וחבלים;",
                "> פרשו רשת על יד מעגל;",
                "> מוקשים שמו לי.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אמרתי לה', \"אלי אתה;",
                "> האזינה, ה', קול תחנוני.\""
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ה' אדני, עז ישועתי,",
                "> סכתה לראשי ביום נשק."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> אל תתן, ה', מאויי רשע;",
                "> זממו אל תפק, ירומו סלה.",
                "> סלה"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ראש מסבי,",
                "> עמל שפתימו יכסמו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ימיטו עליהם גחלים;",
                "> באש יפלם,",
                "> במעמקים בל יקומו."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> איש לשון בל יכון בארץ;",
                "> איש חמס רע יצודנו למדחפות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ידעתי כי יעשה ה' דין עני;",
                "> משפט אביונים."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אך צדיקים יודו לשמך;",
                "> ישבו ישרים את פניך."
            ]
        }
    ]
}