{
    "book": "תהילים",
    "chapter": 97,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ה' מלך, תגל הארץ;",
                "> ישמחו איים רבים."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ענן וערפל סביביו;",
                "> צדק ומשפט מכון כסאו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אש לפניו תלך",
                "> ותלהט סביב צריו."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> הברקים שלו האירו תבל;",
                "> ראתה ותחל הארץ."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ההרים נמסו כשעווה מפני ה',",
                "> מפני אדון כל הארץ."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> השמים הגידו צדקו,",
                "> וראו כל העמים כבודו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> יבושו כל עבדי פסל,",
                "> המתהללים באלילים;",
                "> השתחוו לו, כל אלוהים."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> שמעה ציון ותשמח,",
                "> ותגלנה בנות יהודה",
                "> למען משפטיך, ה'."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אתה ה' עליון על כל הארץ;",
                "> מאוד נעלית על כל אלוהים."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אהבו את ה', שנאו רע,",
                "> שומר נפשות חסידיו;",
                "> מיד רשעים יצילם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> אור זרוע לצדיק,",
                "> ולישרי לב שמחה."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> שמחו בה', צדיקים,",
                "> והודו לזכר קדשו."
            ]
        }
    ]
}