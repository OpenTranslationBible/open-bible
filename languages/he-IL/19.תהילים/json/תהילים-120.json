{
    "book": "תהילים",
    "chapter": 120,
    "verses": [
        {
            "text": [
                "שיר המעלות."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> אל ה' בצרתי קראתי,",
                "> ויענני."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ה', הציל נפשי משפת שקר,",
                "> מלשון רמיה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> מה ייתן לך ומה יוסיף לך,",
                "> לשון רמיה?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> חיצי גיבור שנונים,",
                "> עם גחלי רתמים!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> אוי לי כי גרתי משך,",
                "> שכנתי עם אוהלי קדר!"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> רבת שכנה נפשי",
                "> עם שונא שלום."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> אני שלום, וכי אדבר,",
                "> המה למלחמה."
            ]
        }
    ]
}