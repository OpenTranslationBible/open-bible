{
    "book": "תהילים",
    "chapter": 65,
    "verses": [
        {
            "text": [
                "למנצח מזמור לדוד שיר"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> לך דומיה תהילה ציון אלהים",
                "> ולך ישולם נדר."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שומע תפילה",
                "> עדיך כל בשר יבואו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> דברי עוונות גברו מני",
                "> פשעינו אתה תכפרם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אשרי תבחר ותקרב ישכון חצריך",
                "> נשבעה בטוב ביתך קדש היכלך."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> נוראות בצדק תעננו",
                "> אלהי ישענו",
                "> מבטח כל קצוי ארץ וים רחוקים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> מכין הרים בכחו",
                "> נאזר בגבורה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> משביח שאון ימים",
                "> שאון גליהם והמון לאומים."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> וייראו יושבי קצוות מאותותיך",
                "> מוצאי בקר וערב תרנין."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> פקדת הארץ ותשקקה",
                "> רבת תעשרנה",
                "> פלג אלהים מלא מים",
                "> תכין דגנם כי כן תכינה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> תלמיה רוה נחת גדודיה",
                "> ברביבים תמוגגנה",
                "> צמחה תברך."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> עטרת שנה טובתך",
                "> ומעגליך ירעפון דשן."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> ירעפו נאות מדבר",
                "> וגיל גבעות תחגרנה."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> לבשו כרים הצאן",
                "> ועמקים יעטפו בר",
                "> יתרועעו אף ישירו."
            ]
        }
    ]
}