{
    "book": "תהילים",
    "chapter": 141,
    "verses": [
        {
            "text": [
                "מזמור לדוד."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> ה', קראתי אליך; מהר אלי!",
                "> הקשב לקולי בקראי אליך!"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> תכון תפלתי קטורת לפניך;",
                "> משאת כפי מנחת ערב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> שיתה ה', שמרה לפי;",
                "> נצרה על דל שפתי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אל תט לבי לדבר רע,",
                "> להתעסק עלילות ברשע",
                "> את אנשי פועלי און;",
                "> ובל אלחם במנעמיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> יהלמני צדיק חסד;",
                "> ויוכיחני שמן ראש אל יני ראשי,",
                "> כי עוד ותפלתי ברעותיהם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> נשמטו בידי סלע שופטיהם,",
                "> ושמעו אמרי כי נעמו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> כמו פותר וכובש בארץ,",
                "> נפזרו עצמינו לפי שאול."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> כי אליך ה' אדוני עיני;",
                "> בך חסיתי, אל תער נפשי."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> שמרני מפח יקשו לי,",
                "> ומוקשי פועלי און."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> יפלו במכמריהם רשעים,",
                "> יחד אנכי עד אעבור."
            ]
        }
    ]
}