{
    "book": "איוב",
    "chapter": 34,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ויען אליהוא ויאמר:"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> שמעו דברי חכמים,",
                "> והאזינו לי, יודעי דעת."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כי אוזן מילים תבחן,",
                "> וחך אוכל יטעם."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> נבחרה לנו משפט,",
                "> נדעה בינינו מה טוב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> כי אמר איוב, 'צדקתי,",
                "> ואלוה הסיר משפטי."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> על משפטי כזב אחשב;",
                "> חצי אנוש, בלי פשע.'"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> מי גבר כאיוב,",
                "> ישתה לעג כמים,"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> וילך לחברת פועלי און",
                "> וילך עם אנשי רשע?"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כי אמר, 'לא יועיל לאיש",
                "> ברצותו את אלוהים.'"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לכן שמעו לי, אנשי לבב.",
                "> חלילה לאל מרשע,",
                "> ושדי מעול."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> כי פועל אדם ישלם לו,",
                "> וכאורח איש ימצאנו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> אף אמנם אל לא ירשיע,",
                "> ושדי לא יעות משפט."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> מי פקד עליו ארץ?",
                "> ומי שם תבל כלה?"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אם ישים אליו לבו,",
                "> רוחו ונשמתו אליו יאסוף,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> יגוע כל בשר יחד,",
                "> ואדם על עפר ישוב."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ואם בינה שמעו זאת;",
                "> האזינו לקול דברי."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> האף שונא משפט יחבוש?",
                "> ואם צדיק כביר תרשיע?"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> האומר למלך, 'בליעל,'",
                "> לנשיאים, 'רשע,'"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> אשר לא נשא פני שרים",
                "> ולא נכר שוע לפני דל,",
                "> כי מעשה ידיו כלם?"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> רגע ימותו,",
                "> וחצות לילה יגועו עם;",
                "> ויעברו אבירים לא ביד."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> כי עיניו על דרכי איש,",
                "> וכל צעדיו יראה."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> אין חשך ואין צלמות",
                "> להסתר שם פעלי און."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> כי לא על איש ישים עוד,",
                "> להלך אל אל במשפט."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ירעץ אבירים לא חקר,",
                "> ויעמד אחרים תחתם."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> לכן יכיר מעשיהם,",
                "> והפך לילה וידכאו."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> תחת רשעים ספקם",
                "> במקום רואים,"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> אשר על כן סרו מאחריו",
                "> וכל דרכיו לא השכילו."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> להביא אליו צעקת דל,",
                "> וצעקת עניים ישמע."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> והוא ישקיט ומי ירשיע?",
                "> ויסתר פנים ומי ישורנו?",
                "> ועל גוי ועל אדם יחד,"
            ]
        },
        {
            "verse": 30,
            "text": [
                "> ממלך אדם חנף",
                "> ממוקשי עם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> כי אל אלוה אמר,",
                "> 'נשאתי לא אחבל עוד;"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> בלתי אחזה אתה;",
                "> אם עול פעלתי לא אוסיף.'"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> המעמך ישלמנה כי מאסת?",
                "> כי אתה תבחר ולא אני;",
                "> ומה ידעת דבר."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 34,
            "text": [
                "> אנשי לבב יאמרו לי,",
                "> ואיש חכם שומע לי יאמר,"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> 'איוב בבלי דעת ידבר;",
                "> ודבריו לא בהשכל.'"
            ]
        },
        {
            "verse": 36,
            "text": [
                "> אבי יבחן איוב עד נצח,",
                "> על תשובות כאנשי און."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> כי יוסיף על חטאתו פשע;",
                "> בין ידינו יספוק",
                "> וירבה אמריו לאלוהים.”"
            ]
        }
    ]
}