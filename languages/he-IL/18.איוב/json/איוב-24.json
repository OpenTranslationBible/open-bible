{
    "book": "איוב",
    "chapter": 24,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"מדוע לא נסתרים עתים מעם שדי,",
                "> ולא חזו ידעיו ימיו?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> גבולות יעתיקו,",
                "> עדר גזלו וירעו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> חמור יתומים ינהגו,",
                "> יחבלו שור אלמנה."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> יטו אביונים מדרך,",
                "> יחדו נחבאו עניי ארץ."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> הנה פראים במדבר",
                "> יצאו לפעלם שחר לטרף,",
                "> ערבה לו לחם לנערים."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> בשדה בלילו יקצרו,",
                "> וכרם רשע ילקשו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ערום ילינו מבלי לבוש,",
                "> ואין כסות בקרה."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> מזרם הרים ירטבו,",
                "> ומבלי מחסה חבקו צור."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> יגזלו משד יתום,",
                "> ועל עני יחבלו."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ערום הלכו בלי לבוש,",
                "> ורעבים נשאו עמר."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> בין שורתם יצהירו שמן;",
                "> יקבים דרכו ויצמאו."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> מעיר מתים ינאקו,",
                "> ונפש חללים תשוע;",
                "> ואלוה לא ישים תפלה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> המה היו במרדי אור;",
                "> לא הכירו דרכיו,",
                "> ולא ישבו בנתיבותיו."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> לאור יקום רוצח;",
                "> יקטול עני ואביון,",
                "> ובלילה יהיה כגנב."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ועין נואף שמרה נשף,",
                "> אמר: 'לא תשורני עין.'",
                "> וסתר פנים ישים."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> בחשך חתרו בתים,",
                "> יומם חתמו להם;",
                "> לא ידעו אור."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> כי יחדו בקר לצלמות,",
                "> כי יכיר בלהות צלמות."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> קל הוא על פני מים;",
                "> תקלל חלקתם בארץ.",
                "> לא יפנה דרך כרמים."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> ציה גם חם יגזלו מימי שלג,",
                "> שאול חטאו."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> תשכחהו רחם, מתקו עליו רמה;",
                "> לא יזכר עוד.",
                "> ותשבר עולה כעץ."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> רעה עקרה לא תלד,",
                "> ואלמנה לא ייטיב."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ומשך אבירים בכחו;",
                "> יקום ולא יאמין בחיים."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> יתן לו לבטח ולא יסעד,",
                "> ועיניו על דרכיהם."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> רומו מעט ואינם;",
                "> והמכו כל כאלו קציר,",
                "> וכראש שבול ימללו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> ואם לא אפוא מי יכזיבני,",
                "> וישם לאל מלתי?\""
            ]
        }
    ]
}