{
    "book": "איוב",
    "chapter": 17,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"רוחי נשברה, ימי כבו,",
                "> קבר מחכה לי."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> בוודאי לצים איתי,",
                "> ועיני מביטה על התגרותם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> אנא, שים ערבון לי אצלך;",
                "> מי יש שיהיה ערב לי?"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> כי מנעת לבם מתבונה,",
                "> לכן לא תרומם אותם."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> המגיד על חברים בשביל חלק בשלל,",
                "> עיני ילדיו יאבדו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> אך הוא עשה אותי למשל בעמים,",
                "> ואני אחד שמרוקקים עליו."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> גם עיני כהתה מעצב,",
                "> וכל איברי כצל."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> הישרים יבהלו מזה,",
                "> והנקיים יקומו על החסרי אלוהים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> ואף על פי כן הצדיק יעמוד בדרכו,",
                "> והנקי ידיים ילך ויתחזק."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> שובו נא כולכם, אני מבקש,",
                "> כי איני מוצא חכם בכם."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> ימי עברו, תוכניותיי נשברו,",
                "> משאלות לבי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הם הופכים לילה ליום, אומרים,",
                "> 'האור קרוב,' בנוכחות החושך."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> אם אראה לשאול כבית שלי,",
                "> אפרוש מיטתי בחושך;"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אקרא לקבר, 'אתה אבי';",
                "> לרימה, 'אמי ואחותי.'"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> איפה אז תקוותי?",
                "> ומי רואה תקווה עבורי?"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> האם תרד איתי לשאול?",
                "> האם נרד יחד לעפר?\""
            ]
        }
    ]
}