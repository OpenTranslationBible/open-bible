{
    "book": "איוב",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> \"הלא צבא לאנוש עלי ארץ,",
                "> וימי שכיר כימי ימיו?"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> כעבד ישאף צל,",
                "> וכשכיר יקווה פעלו."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> כן הנחלתי לי ירחי שוא,",
                "> ולילות עמל מנו לי."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> אם שכבתי ואמרתי מתי אקום,",
                "> ומדד ערב ושבעתי נדודים עד נשף."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לבש בשרי רמה וגוש עפר,",
                "> עורי התקש וימאס."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ימי קלו מני ארג,",
                "> ויכלו באפס תקוה."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> זכר כי רוח חיי,",
                "> לא תשוב עיני לראות טוב."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> לא תשורני עין ראי,",
                "> עיניך בי ואינני."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> כלה ענן וילך,",
                "> כן יורד שאול לא יעלה."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> לא ישוב עוד לביתו,",
                "> ולא יכירנו עוד מקומו."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> \"גם אני לא אחשוך פי;",
                "> אדבר בצר רוחי,",
                "> אשיחה במר נפשי."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> הים אני אם תנין,",
                "> כי תשים עלי משמר?"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> כי אמרתי תנחמני ערשי,",
                "> ישא בשיחי משכבי,"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> אז חתתני בחלומות",
                "> ומחזיונות תבעתני,"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> ותבחר מחנק נפשי,",
                "> מות מעצמותי."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> מאסתי לא לעולם אחיה.",
                "> חדל ממני כי הבל ימי."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> מה אנוש כי תגדלנו,",
                "> וכי תשית אליו לבך,"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> ותפקדנו לבקרים,",
                "> לרגעים תבחננו?"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> כמה לא תשעה ממני,",
                "> לא תרפני עד בלעי רקי?"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> חטאתי מה אפעל לך,",
                "> נוצר האדם?",
                "> למה שמתני למפגע לך,",
                "> ואהיה עלי למשא?"
            ]
        },
        {
            "verse": 21,
            "text": [
                "> ומדוע לא תשא פשעי",
                "> ותעביר את עווני?",
                "> כי עתה לעפר אשכב;",
                "> ושחרתני ואינני.\""
            ]
        }
    ]
}