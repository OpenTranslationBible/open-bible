{
    "book": "איוב",
    "chapter": 12,
    "verses": [
        {
            "verse": 1,
            "text": [
                "אז ענה איוב ואמר,"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"אמנם אתם העם,",
                "> ועמכם תמות החכמה!"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> גם לי לבב כמו לכם;",
                "> לא נופל אני מכם.",
                "> ומי לא ידע כאלו?"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> לשחוק רעי הייתי,",
                "> הקורא לאלוהים ויענהו—",
                "> צדיק ותמים לשחוק הייתי."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> לבוז לפיד לעשתות שאנן,",
                "> נכון למועדי רגל."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ישליו אוהלי שודדים,",
                "> ובוטחים למרגיזי אל,",
                "> אשר הביא אלוה בידם."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> \"אך שאל נא בהמות ותרך;",
                "> ועוף השמים ויגיד לך."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> או שיח לארץ ותרך;",
                "> ויספרו לך דגי הים."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> מי לא ידע בכל אלה",
                "> כי יד ה' עשתה זאת?"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> אשר בידו נפש כל חי",
                "> ורוח כל בשר איש."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> הלא אזן מלין תבחן",
                "> וחיך אוכל יטעם לו?"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> בישישים חכמה,",
                "> וארך ימים תבונה."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> \"עמו חכמה וגבורה;",
                "> לו עצה ותבונה."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> הן יהרוס ולא יבנה;",
                "> יסגר על איש ולא יפתח."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> הן יעצר במים ויבשו;",
                "> וישלחם ויהפכו ארץ."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> עמו עז ותושיה;",
                "> לו שגיא ומשגה."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> מוליך יועצים שולל",
                "> ושופטים יהולל."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> מוסר אסורים יפתח",
                "> ובמותניהם חבל יחגר."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> מוליך כהנים שולל",
                "> ואתנים יסלף."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> מסיר שפה לנאמנים",
                "> וטעם זקנים יקח."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> שופך בוז על נדיבים",
                "> ומתיר אפיקי איתנים."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> מגלה עמקות מני חושך",
                "> ויוצא לאור צלמות."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> משגיא לגוים ויאבדם;",
                "> שטח לגוים וינחם."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> מסיר לב ראשי עם הארץ",
                "> ויתעם בתהו לא דרך."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> ימששו חושך ולא אור;",
                "> ויתעם כשכור."
            ]
        }
    ]
}