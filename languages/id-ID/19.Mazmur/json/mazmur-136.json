{
  "book": "Mazmur",
  "chapter": 136,
  "verses": [
    {
      "verse": 1,
      "text": ["Bersyukurlah kepada Tuhan, Dia baik,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 2,
      "text": ["Bersyukurlah kepada Dia, Tuhan segala Tuhan,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 3,
      "text": ["Bersyukurlah kepada Dia, Tuhan segala tuhan,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 4,
      "text": ["Kepada Dia yang sendiri melakukan keajaiban besar,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 5,
      "text": ["Kepada Dia yang menjadikan langit dengan keahlian,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 6,
      "text": ["Kepada Dia yang membentangkan bumi di atas air,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 7,
      "text": ["Kepada Dia yang menjadikan cahaya-cahaya besar,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 8,
      "text": ["Matahari untuk memerintah siang,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 9,
      "text": ["Bulan dan bintang-bintang untuk memerintah malam,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 10,
      "text": [
        "Kepada Dia yang memukul orang Mesir, yaitu anak sulung mereka,",
        "> Kasih-Nya kekal selamanya."
      ]
    },
    {
      "verse": 11,
      "text": [
        "Dan membawa Israel keluar dari tengah-tengah mereka,",
        "> Kasih-Nya kekal selamanya."
      ]
    },
    {
      "verse": 12,
      "text": ["Dengan tangan yang kuat dan lengan yang terentang,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 13,
      "text": [
        "Kepada Dia yang membagi Laut Merah menjadi bagian-bagian,",
        "> Kasih-Nya kekal selamanya."
      ]
    },
    {
      "verse": 14,
      "text": ["Dan memimpin Israel melalui tengah-tengahnya,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 15,
      "text": [
        "Tetapi Dia menenggelamkan Firaun dan tentaranya di Laut Merah,",
        "> Kasih-Nya kekal selamanya."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 16,
      "text": [
        "Kepada Dia yang membimbing umat-Nya melalui padang gurun,",
        "> Kasih-Nya kekal selamanya."
      ]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 17,
      "text": ["Kepada Dia yang memukul raja-raja besar,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 18,
      "text": ["Dan membawa kematian kepada raja-raja perkasa,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 19,
      "text": ["Sihon, penguasa orang Amori,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 20,
      "text": ["Dan Og, penguasa Basan,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 21,
      "text": ["Dan memberikan tanah mereka sebagai warisan,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 22,
      "text": ["Warisan kepada hamba-Nya Israel,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 23,
      "text": ["Yang mengingat kita dalam kerendahan kita,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "verse": 24,
      "text": [
        "Dan telah menyelamatkan kita dari musuh-musuh kita,",
        "> Kasih-Nya kekal selamanya."
      ]
    },
    {
      "verse": 25,
      "text": ["Yang memberi makanan kepada segala makhluk,", "> Kasih-Nya kekal selamanya."]
    },
    {
      "text": ["---"]
    },
    {
      "verse": 26,
      "text": ["Bersyukurlah kepada Tuhan di surga,", "> Kasih-Nya kekal selamanya."]
    }
  ]
}
