{
    "book": "حبقوق",
    "chapter": 3,
    "verses": [
        {
            "verse": 1,
            "text": [
                "صلاة تضرع لحبقوق النبي، على شجيونوت."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> يا رب، قد سمعت خبرك، فجزعت من أعمالك، يا رب.",
                "> في وسط السنين أحييها،",
                "> في وسط السنين عرف بها؛",
                "> في الغضب اذكر الرحمة."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> إله جاء من تيمان،",
                "> والقدوس من جبل فاران. سلاه",
                "> غطت السماوات جلاله،",
                "> وامتلأت الأرض من تسبيحه."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> وكان لمعانه كالنور؛",
                "> له شعاع من يده،",
                "> وهناك استتار قدرته."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> قدامه ذهب الوباء،",
                "> وعند رجليه خرجت الحمى."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> وقف فقاس الأرض؛",
                "> نظر فرجف الأمم.",
                "> وتدكت الجبال الدهرية،",
                "> وخسفت الآكام القديمة.",
                "> مسالكه أزلية."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> رأيت خيام كوشان تحت بلية،",
                "> ارتجفت شقق أرض مديان."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> هل على الأنهار حمى الرب؟",
                "> هل على الأنهار غضبك؟",
                "> هل على البحر سخطك",
                "> إذ ركبت خيلك",
                "> ومركبات خلاصك؟"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> عريت قوسك،",
                "> سباعية سهام كلمتك. سلاه شققت الأرض أنهارًا."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> أبصرتك ففزعت الجبال؛",
                "> سيل المياه جاز.",
                "> أعطى الغمر صوته،",
                "> رفع يديه إلى العلاء."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> الشمس والقمر وقفا في بروجهما",
                "> لنور سهامك الطائرة،",
                "> للمعان برق مجدك."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> بغضب خطرت في الأرض؛",
                "> بسخط دست الأمم."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> خرجت لخلاص شعبك،",
                "> لخلاص مسيحك.",
                "> سحقت رأس بيت الشرير،",
                "> معريًا الأساس حتى العنق. سلاه"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> بثقبه برماحه",
                "> رأس قادته.",
                "> عصفوا لتفريقنا،",
                "> تهللوا كما لأكل المسكين في الخفية."
            ]
        },
        {
            "verse": 15,
            "text": [
                "> سلكت في البحر بخيلك،",
                "> كومة المياه الكثيرة."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> سمعت فارتعدت أحشائي؛",
                "> لصوتك رجفت شفتاي.",
                "> دخل النخر في عظامي،",
                "> وارتعدت في مكاني.",
                "> لأني أستريح في يوم الضيق",
                "> عند صعود الشعب الذي يزحمنا."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> فإن التينة لا تزهر،",
                "> ولا يكون حمل في الكروم؛",
                "> يكذب عمل الزيتونة،",
                "> والحقول لا تصنع طعامًا؛",
                "> ينقطع الغنم من الحظيرة،",
                "> ولا بقر في المذاود،"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> فإني أبتهج بالرب،",
                "> وأفرح بإله خلاصي."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> الرب السيد قوتي؛",
                "> يجعل قدمي كالأيائل،",
                "> ويمشيني على مرتفعاتي.",
                "لرئيس المغنين، على آلاتي الوترية."
            ]
        }
    ]
}