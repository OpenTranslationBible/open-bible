{
    "book": "نشيد الأنشاد",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "أنا زهرة شارون،",
                "وسوسنة الأودية."
            ]
        },
        {
            "verse": 2,
            "text": [
                "كالسوسنة بين الشوك،",
                "كذلك حبيبتي بين البنات."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "كشجرة التفاح بين أشجار الوعر،",
                "كذلك حبيبي بين البنين.",
                "تحت ظله اشتهيت أن أجلس،",
                "وثمرته حلوة لحلقي."
            ]
        },
        {
            "verse": 4,
            "text": [
                "أدخلني إلى بيت الخمر،",
                "وعَلَمُه فوقي محبة."
            ]
        },
        {
            "verse": 5,
            "text": [
                "أسندوني بأقراص الزبيب،",
                "أنعشوني بالتفاح،",
                "لأني مريضة حبًا."
            ]
        },
        {
            "verse": 6,
            "text": [
                "يساره تحت رأسي،",
                "ويمينه تعانقني."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "أُناشدكن،",
                "يا بنات أورشليم،",
                "بظباء الحقل أو بأيائل الحقل،",
                "ألا توقظن ولا تنبهن الحب",
                "حتى يشاء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "صوت حبيبي!",
                "هوذا آتٍ،",
                "طافرًا على الجبال،",
                "قافزًا على التلال!"
            ]
        },
        {
            "verse": 9,
            "text": [
                "حبيبي يشبه الظبي أو غفر الأيائل.",
                "هوذا واقف وراء حائطنا،",
                "يتطلع من الكوى،",
                "يُشرف من الشبابيك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "أجاب حبيبي وقال لي،",
                "“قومي يا حبيبتي يا جميلتي،",
                "وتعالَيْ."
            ]
        },
        {
            "verse": 11,
            "text": [
                "لأن الشتاء قد مضى،",
                "والغيث مر وزال."
            ]
        },
        {
            "verse": 12,
            "text": [
                "الزهور ظهرت في الأرض؛",
                "بلغ أوان تقليم الكروم،",
                "وصوت اليمامة سُمع في أرضنا."
            ]
        },
        {
            "verse": 13,
            "text": [
                "التينة أخرجت فجها،",
                "وقُعْبُ الكروم تفيح رائحة.",
                "قومي يا حبيبتي يا جميلتي،",
                "وتعالَيْ!”"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 14,
            "text": [
                "يا حمامتي في محاجئ الصخر،",
                "في ستر المعاقل،",
                "أريني وجهك،",
                "أسمعيني صوتك؛",
                "لأن صوتك لطيف،",
                "ووجهك جميل."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "خذوا لنا الثعالب،",
                "الثعالب الصغيرة المفسدة للكروم،",
                "وكرومنا مفلحة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "حبيبي لي وأنا له؛",
                "الراعي بين السوسن."
            ]
        },
        {
            "verse": 17,
            "text": [
                "إلى أن يفيح النهار وتنهزم الظلال،",
                "ارجع يا حبيبي وأشبه الظبي",
                "أو غفر الأيائل على الجبال المشعبة."
            ]
        }
    ]
}