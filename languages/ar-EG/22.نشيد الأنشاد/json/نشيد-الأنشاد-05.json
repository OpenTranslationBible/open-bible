{
    "book": "نشيد الأنشاد الاصحاح",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "قد دخلت جنتي يا أختي يا عروسي؛",
                "قطفت مري مع بلساني.",
                "أكلت شهدي مع عسلي؛",
                "شربت خمري مع لبني.",
                "كلوا أيها الأصدقاء؛",
                "اشربوا واثملوا حبًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "كنت نائمة وقلبي مستيقظ.",
                "سمعت صوتًا! حبيبي كان عند الباب:",
                "\"افتحي لي يا أختي يا حبيبتي،",
                "يا حمامتي يا كاملتي!",
                "لأن رأسي امتلأ من الندى،",
                "وشعري من قطرات الليل.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "\"خلعت ثوبي،",
                "كيف ألبسه مرة أخرى؟",
                "غسلت قدمي،",
                "كيف أوسخهما مرة أخرى؟\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "مد حبيبي يده من الفتحة،",
                "فأحشائي تحركت لأجله."
            ]
        },
        {
            "verse": 5,
            "text": [
                "قمت لأفتح لحبيبي؛",
                "وكانت يداي تقطران مراً،",
                "وأصابعي تقطر مرًا سائلاً،",
                "على مقبض القفل."
            ]
        },
        {
            "verse": 6,
            "text": [
                "فتحت لحبيبي،",
                "لكن حبيبي كان قد انصرف وذهب!",
                "نفسي خرجت عندما تكلم.",
                "طلبته فلم أجده؛",
                "دعوت عليه فلم يجبني."
            ]
        },
        {
            "verse": 7,
            "text": [
                "وجدني الحراس الذين يطوفون في المدينة،",
                "ضربوني وجرحوني؛",
                "رفعوا ردائي عني حراس الأسوار."
            ]
        },
        {
            "verse": 8,
            "text": [
                "أقسمتكن،",
                "يا بنات أورشليم،",
                "إذا وجدتن حبيبي،",
                "ماذا تخبرنه:",
                "أني مريضة حبًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "ما نوع حبيبك،",
                "يا أجمل النساء؟",
                "ما نوع حبيبك،",
                "حتى تقسمينا هكذا؟"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "حبيبي أبيض وأحمر،",
                "متميز بين عشرة آلاف."
            ]
        },
        {
            "verse": 11,
            "text": [
                "رأسه ذهب نقي؛",
                "شعره كعناقيد النخل",
                "أسود كالغربان."
            ]
        },
        {
            "verse": 12,
            "text": [
                "عيناه كالحمام على مجاري المياه،",
                "مغسولتان باللبن،",
                "وموضوعتان في موضعهما."
            ]
        },
        {
            "verse": 13,
            "text": [
                "خداه كحديقة بلسان،",
                "أحواض أعشاب عطرية؛",
                "شفتاه سوسن",
                "تقطران مراً سائلاً."
            ]
        },
        {
            "verse": 14,
            "text": [
                "يداه قضبان ذهب",
                "مرصعتان بالزبرجد؛",
                "بطنه عاج منحوت",
                "مرصع بالياقوت الأزرق."
            ]
        },
        {
            "verse": 15,
            "text": [
                "ساقاه عمودا رخام",
                "مؤسسان على قواعد من ذهب خالص؛",
                "منظره كلبنان،",
                "مختار كالأرز."
            ]
        },
        {
            "verse": 16,
            "text": [
                "فمه حلاوة كلها.",
                "وهو مشتهى تمامًا.",
                "هذا هو حبيبي وهذا هو خليلي،",
                "يا بنات أورشليم."
            ]
        }
    ]
}