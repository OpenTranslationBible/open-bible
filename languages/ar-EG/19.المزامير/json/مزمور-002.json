{
    "book": "المزامير",
    "chapter": 2,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> لماذا تثور الأمم،",
                "> والشعوب تبتكر خططًا باطلة؟"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> يقف ملوك الأرض،",
                "> ويتآمر الحكام",
                "> ضد الرب ومسيحه، قائلين،"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> \"لنقطع قيودهم،",
                "> ونطرح حبالهم عنا!\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> الساكن في السماوات يضحك،",
                "> الرب يستهزئ بهم."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ثم يخاطبهم بغضبه،",
                "> ويرعبهم بسخطه، قائلاً،"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> \"أما أنا فقد مسحت ملكي",
                "> على صهيون، جبلي المقدس.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "سأعلن مرسوم الرب:",
                "> قال لي، \"أنت ابني،",
                "> اليوم ولدتُك."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> اسألني، فأعطيك الأمم ميراثًا لك،",
                "> وأقصى الأرض ملكًا لك."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> تحطمهم بقضيب من حديد،",
                "> وتكسرهم كإناء خزف.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> فالآن، أيها الملوك، كونوا حكماء؛",
                "> تقبلوا التعليم، يا قضاة الأرض."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> اعبدوا الرب بخشوع،",
                "> واهتفوا برعدة."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> أكرموا الابن، لئلا يغضب فتهلكوا في طريقكم،",
                "> لأن غضبه يمكن أن يشتعل بسرعة.",
                "> طوبى لجميع الذين يلجأون إليه."
            ]
        }
    ]
}