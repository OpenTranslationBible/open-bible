{
    "book": "المزامير",
    "chapter": 33,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> ابتهجوا في الرب، أيها الأبرار؛",
                "> التسبيح يليق بالمستقيمين."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> اشكروا الرب بالعود؛",
                "> غنوا له بالقيثارة ذات العشرة أوتار."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> غنوا له أغنية جديدة؛",
                "> اعزفوا ببراعة مع هتافات الفرح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> لأن كلمة الرب حق،",
                "> وكل عمله يتم بأمانة."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> هو يحب البر والعدل؛",
                "> الأرض مملوءة من صلاح الرب."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> بكلمة الرب صنعت السماوات،",
                "> وبنسمة فمه كل جندها."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> يجمع مياه البحر ككومة؛",
                "> يضع الأعماق في مخازن."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> لتخش الرب كل الأرض؛",
                "> ليقف جميع سكان العالم في رهبة منه."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> لأنه قال فكان؛",
                "> أمر فثبت."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> الرب يبطل مشورة الأمم؛",
                "> يحبط مقاصد الشعوب."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> مشورة الرب تدوم إلى الأبد،",
                "> أفكار قلبه إلى جميع الأجيال."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> طوبى للأمة التي إلهها الرب،",
                "> الشعب الذي اختاره ميراثًا له."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> الرب ينظر من السماء؛",
                "> يرى جميع بني البشر؛"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> من مقر سكناه يراقب",
                "> جميع سكان الأرض،"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> الذي يصور قلوبهم جميعًا،",
                "> الذي يفهم كل أعمالهم."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> الملك لا يخلص بكثرة الجيش؛",
                "> الجبار لا ينجو بعظم القوة."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> الحصان باطل للنجاة؛",
                "> ولا ينجو بعظم قوته."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> هوذا عين الرب على الذين يخشونه،",
                "> على الذين يرجون في أمانته،"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> لينجي نفوسهم من الموت",
                "> وليحفظهم في الجوع."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 20,
            "text": [
                "> أنفسنا تنتظر الرب؛",
                "> هو عوننا وترسنا."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> لأن قلوبنا تفرح به،",
                "> لأننا نثق باسمه القدوس."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> لتكن نعمتك، يا رب، علينا،",
                "> كما رجونا فيك."
            ]
        }
    ]
}