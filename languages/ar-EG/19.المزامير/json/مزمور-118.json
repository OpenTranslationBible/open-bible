{
    "book": "المزامير",
    "chapter": 118,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> احمدوا الرب، لأنه صالح؛",
                "> لأن رحمته تدوم إلى الأبد."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> ليقل إسرائيل،",
                "> \"إن رحمته تدوم إلى الأبد.\""
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ليقل بيت هارون،",
                "> \"إن رحمته تدوم إلى الأبد.\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> ليقل الذين يخافون الرب،",
                "> \"إن رحمته تدوم إلى الأبد.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> من ضيقي دعوت الرب؛",
                "> فأجابني الرب ووضعني في مكان واسع."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> الرب معي؛ لا أخاف؛",
                "> ماذا يمكن للبشر أن يفعلوا بي؟"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> الرب معي كمعين لي؛",
                "> لذلك سأنتصر على الذين يكرهونني."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> من الأفضل الاحتماء بالرب",
                "> من الثقة في البشر."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> من الأفضل الاحتماء بالرب",
                "> من الثقة في الرؤساء."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> كل الأمم أحاطت بي؛",
                "> باسم الرب، سأدفعهم بالتأكيد."
            ]
        },
        {
            "verse": 11,
            "text": [
                "> أحاطوا بي، بل أحاطوا بي؛",
                "> باسم الرب، سأدفعهم بالتأكيد."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> أحاطوا بي مثل النحل؛",
                "> انطفأوا مثل النار في الشوك؛",
                "> باسم الرب، سأدفعهم بالتأكيد."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> دفعتني بشدة لأقع،",
                "> لكن الرب سندني."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> الرب قوتي ونشيدي،",
                "> وقد أصبح خلاصي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> أصوات الفرح والخلاص في خيام الأبرار؛",
                "> يمين الرب تصنع ببسالة."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> يمين الرب مرتفعة؛",
                "> يمين الرب تصنع ببسالة."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> لن أموت، بل أحيا،",
                "> وأعلن أعمال الرب."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> أدبني الرب بشدة،",
                "> لكنه لم يسلمني للموت."
            ]
        },
        {
            "verse": 19,
            "text": [
                "> افتحوا لي أبواب البر؛",
                "> سأدخل من خلالها وأحمد الرب."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> هذا هو باب الرب؛",
                "> الأبرار سيدخلون من خلاله."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> سأحمدك، لأنك أجبتني،",
                "> وأصبحت خلاصي."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> الحجر الذي رفضه البناؤون",
                "> أصبح رأس الزاوية."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> الرب صنع هذا؛",
                "> وهو عجيب في أعيننا."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> هذا هو اليوم الذي صنعه الرب؛",
                "> فلنفرح ونبتهج فيه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 25,
            "text": [
                "> يا رب، نتوسل إليك، خلصنا؛",
                "> يا رب، نتوسل إليك، امنحنا النجاح!"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 26,
            "text": [
                "> مبارك الآتي باسم الرب؛",
                "> نبارككم من بيت الرب."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> الرب هو إله، وقد أنارنا؛",
                "> اربطوا الذبيحة بحبال إلى قرون المذبح."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "> أنت إلهي، وسأحمدك؛",
                "> أنت إلهي، سأرفعك."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 29,
            "text": [
                "> احمدوا الرب، لأنه صالح؛",
                "> لأن رحمته تدوم إلى الأبد."
            ]
        }
    ]
}