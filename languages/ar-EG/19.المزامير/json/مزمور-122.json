{
    "book": "المزامير",
    "chapter": 122,
    "verses": [
        {
            "text": [
                "ترنيمة المصاعد. لداود."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> فرحت عندما قالوا لي،",
                "> \"لنذهب إلى مسكن الرب.\""
            ]
        },
        {
            "verse": 2,
            "text": [
                "> أقدامنا الآن واقفة",
                "> داخل أبوابكِ، يا أورشليم،"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> أورشليم، التي بُنيت",
                "> كمدينة متصلة معًا؛"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> التي تصعد إليها الأسباط، أسباط الرب—",
                "> فريضة لإسرائيل—",
                "> ليشكروا اسم الرب."
            ]
        },
        {
            "verse": 5,
            "text": [
                "> لأنه هناك أُقيمت كراسي القضاء،",
                "> كراسي بيت داود."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> صلوا من أجل سلام أورشليم:",
                "> \"ليجد الذين يحبونكِ الأمان."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> ليكن السلام داخل أسواركِ،",
                "> والرخاء داخل قصوركِ.\""
            ]
        },
        {
            "verse": 8,
            "text": [
                "> من أجل إخوتي وأصدقائي،",
                "> سأقول الآن، \"ليكن السلام داخلكِ.\""
            ]
        },
        {
            "verse": 9,
            "text": [
                "> من أجل بيت الرب إلهنا،",
                "> سأتابع رفاهيتكِ."
            ]
        }
    ]
}