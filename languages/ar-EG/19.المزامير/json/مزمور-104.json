{
    "book": "المزامير",
    "chapter": 104,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> باركي الرب يا نفسي!",
                "> الرب إلهي، أنت عظيم جداً؛",
                "> أنت متسربل بالجلال والبهاء،"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> لابس النور كثوب،",
                "> باسط السماوات كستارة خيمة."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> المؤسس عوارض علّياته على المياه؛",
                "> المتخذ السحاب مركبة له؛",
                "> الماشي على أجنحة الرياح؛"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> الصانع ملائكته رياحاً،",
                "> وخدامه ناراً ملتهبة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> المؤسس الأرض على قواعدها،",
                "> فلا تتزعزع إلى الأبد."
            ]
        },
        {
            "verse": 6,
            "text": [
                "> كسوتها باللجج كثوب؛",
                "> فوق الجبال تقف المياه."
            ]
        },
        {
            "verse": 7,
            "text": [
                "> من انتهارك هربت،",
                "> من صوت رعدك أسرعت."
            ]
        },
        {
            "verse": 8,
            "text": [
                "> صعدت الجبال، نزلت الأودية",
                "> إلى المكان الذي أسسته لها."
            ]
        },
        {
            "verse": 9,
            "text": [
                "> وضعت لها حداً لا تتعداه،",
                "> فلا ترجع لتغطي الأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> المرسل ينابيع في الأودية؛",
                "> تسير بين الجبال؛"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> تسقي كل حيوان البر؛",
                "> تروي الحمير الوحشية عطشها."
            ]
        },
        {
            "verse": 12,
            "text": [
                "> عندها تسكن طيور السماء؛",
                "> تغني بين الأغصان."
            ]
        },
        {
            "verse": 13,
            "text": [
                "> الساقي الجبال من علّياته؛",
                "> من ثمر أعمالك تشبع الأرض."
            ]
        },
        {
            "verse": 14,
            "text": [
                "> المنبت عشباً للبهائم،",
                "> ونباتاً لخدمة الإنسان،",
                "> ليخرج خبزاً من الأرض،"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> وخمراً تفرح قلب الإنسان،",
                "> لتلمع وجهه بالزيت،",
                "> وخبزاً يقوي قلب الإنسان."
            ]
        },
        {
            "verse": 16,
            "text": [
                "> تشبع أشجار الرب،",
                "> أرز لبنان الذي غرسه،"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> حيث تبني الطيور أعشاشها،",
                "> اللقلق الذي بيته في السرو."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> الجبال العالية للوعول؛",
                "> الصخور ملجأ للوبار."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> صنع القمر للمواقيت؛",
                "> الشمس تعرف مغربها."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> تجعل ظلمة فيصير ليل،",
                "> فيه تدب كل حيوانات الوعر."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> الأشبال تزأر لتفترس،",
                "> وتطلب طعامها من إله."
            ]
        },
        {
            "verse": 22,
            "text": [
                "> تشرق الشمس فتجمع،",
                "> وتربض في مآويها."
            ]
        },
        {
            "verse": 23,
            "text": [
                "> يخرج الإنسان إلى عمله",
                "> وإلى شغله حتى المساء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 24,
            "text": [
                "> ما أعظم أعمالك يا رب!",
                "> كلها بحكمة صنعت؛",
                "> ملآنة الأرض من غناك."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> هذا البحر الكبير الواسع الأطراف،",
                "> هناك دبابات بلا عدد،",
                "> صغار مع كبار."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> هناك تجري السفن،",
                "> لوياثان الذي كونته ليلعب فيه."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 27,
            "text": [
                "> كلها إياك تترجى",
                "> لتعطيها طعامها في حينه."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> تعطيها فتلتقط؛",
                "> تفتح يدك فتشبع خيراً."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> تحجب وجهك فترتاع؛",
                "> تنزع أرواحها فتموت",
                "> وإلى ترابها تعود."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> ترسل روحك فتخلق،",
                "> وتجدد وجه الأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 31,
            "text": [
                "> ليكن مجد الرب إلى الأبد؛",
                "> ليفرح الرب بأعماله؛"
            ]
        },
        {
            "verse": 32,
            "text": [
                "> الناظر إلى الأرض فترتعد؛",
                "> يمس الجبال فتدخن."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "> أغني للرب في حياتي؛",
                "> أرنم لإلهي ما دمت موجوداً."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> لتكن لهجتي حلوة عنده؛",
                "> أنا أفرح بالرب."
            ]
        },
        {
            "verse": 35,
            "text": [
                "> ليفن الخطاة من الأرض",
                "> والأشرار لا يكونوا بعد.",
                "> باركي الرب يا نفسي.",
                "> هللويا!"
            ]
        }
    ]
}