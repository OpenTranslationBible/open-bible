{
    "book": "المزامير",
    "chapter": 129,
    "verses": [
        {
            "text": [
                "ترنيمة المصاعد."
            ]
        },
        {
            "verse": 1,
            "text": [
                "> \"كثيرًا ما هاجموني منذ شبابي\"،",
                "> ليقل إسرائيل،"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> \"كثيرًا ما هاجموني منذ شبابي؛",
                "> لكنهم لم يتغلبوا عليّ."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> الحراثون حرثوا على ظهري؛",
                "> أطالوا أخاديدهم.\""
            ]
        },
        {
            "verse": 4,
            "text": [
                "> الرب عادل؛",
                "> قد قطع حبال الأشرار."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> ليخزى ويرتد إلى الوراء",
                "> كل من يبغض صهيون؛"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> ليكونوا كالعشب على السطوح،",
                "> الذي يذبل قبل أن ينمو؛"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> الذي لا يملأ الحاصد يده منه،",
                "> ولا يملأ حاضن الحزم ذراعيه؛"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ولا يقول العابرون،",
                "> \"لتكن بركة الرب عليكم؛",
                "> نبارككم باسم الرب.\""
            ]
        }
    ]
}