{
    "book": "المزامير",
    "chapter": 105,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> اشكروا الرب، ادعوا باسمه؛",
                "> أخبروا بأعماله بين الشعوب."
            ]
        },
        {
            "verse": 2,
            "text": [
                "> غنوا له، قدموا له تسبيحًا؛",
                "> أعلنوا كل عجائبه."
            ]
        },
        {
            "verse": 3,
            "text": [
                "> افتخروا باسمه القدوس؛",
                "> ليفرح قلب الذين يلتمسون الرب."
            ]
        },
        {
            "verse": 4,
            "text": [
                "> التمسوا الرب وقوته؛",
                "> اطلبوا وجهه دائمًا."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> اذكروا عجائبه التي صنعها،",
                "> ومعجزاته، والأحكام التي نطق بها فمه،"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> يا ذرية عبده إبراهيم،",
                "> يا بني يعقوب، مختاريه!"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> هو الرب إلهنا؛",
                "> أحكامه في كل الأرض."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> ذكر عهده إلى الأبد،",
                "> الكلمة التي أوصى بها إلى ألف جيل،"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> العهد الذي قطعه مع إبراهيم،",
                "> ووعده لإسحاق."
            ]
        },
        {
            "verse": 10,
            "text": [
                "> ثم أكده ليعقوب كفريضة،",
                "> لإسرائيل كعهد أبدي،"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> قائلاً: \"لك أعطي أرض كنعان",
                "> نصيب ميراثكم.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> عندما كانوا قلة في العدد،",
                "> قليلين جدًا، وغرباء فيها،"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> وانتقلوا من أمة إلى أمة،",
                "> ومن مملكة إلى شعب آخر،"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> لم يسمح لأحد أن يظلمهم،",
                "> ووبخ ملوكًا من أجلهم، قائلاً:"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> \"لا تمسوا مسحائي،",
                "> ولا تؤذوا أنبيائي.\""
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ودعا الجوع على الأرض؛",
                "> كسر كل عكاز الخبز."
            ]
        },
        {
            "verse": 17,
            "text": [
                "> أرسل رجلًا أمامهم،",
                "> يوسف، الذي بيع عبدًا."
            ]
        },
        {
            "verse": 18,
            "text": [
                "> قيدوا قدميه بالقيود،",
                "> وضعوه في الحديد؛"
            ]
        },
        {
            "verse": 19,
            "text": [
                "> حتى جاء وقت تحقق كلمته،",
                "> كلمة الرب امتحنته."
            ]
        },
        {
            "verse": 20,
            "text": [
                "> أرسل الملك فأطلقه،",
                "> أطلقه حاكم الشعوب."
            ]
        },
        {
            "verse": 21,
            "text": [
                "> جعله سيدًا على بيته،",
                "> وحاكمًا على كل ممتلكاته،"
            ]
        },
        {
            "verse": 22,
            "text": [
                "> ليقيد رؤسائه كما يشاء،",
                "> ويعلم شيوخه الحكمة."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 23,
            "text": [
                "> جاء إسرائيل أيضًا إلى مصر؛",
                "> فأقام يعقوب في أرض حام."
            ]
        },
        {
            "verse": 24,
            "text": [
                "> وجعل شعبه مثمرًا جدًا،",
                "> وجعلهم أقوى من أعدائهم."
            ]
        },
        {
            "verse": 25,
            "text": [
                "> حول قلوبهم ليكرهوا شعبه،",
                "> ليتعاملوا بمكر مع عبيده."
            ]
        },
        {
            "verse": 26,
            "text": [
                "> أرسل موسى، عبده المختار،",
                "> وهارون، الذي اختاره."
            ]
        },
        {
            "verse": 27,
            "text": [
                "> أظهروا آياته العجيبة بينهم،",
                "> وعجائب في أرض حام."
            ]
        },
        {
            "verse": 28,
            "text": [
                "> أرسل ظلامًا فظلم؛",
                "> ولم يعصوا أوامره."
            ]
        },
        {
            "verse": 29,
            "text": [
                "> حول مياههم إلى دم،",
                "> وأهلك أسماكهم."
            ]
        },
        {
            "verse": 30,
            "text": [
                "> امتلأت أرضهم بالضفادع",
                "> حتى في غرف ملوكهم."
            ]
        },
        {
            "verse": 31,
            "text": [
                "> تكلم، فجاءت أسراب من الذباب،",
                "> والبعوض في كل أراضيهم."
            ]
        },
        {
            "verse": 32,
            "text": [
                "> أعطاهم بردًا بدلًا من المطر،",
                "> ونارًا ملتهبة في أرضهم."
            ]
        },
        {
            "verse": 33,
            "text": [
                "> وضرب كرومهم وتينهم،",
                "> وكسر أشجار أراضيهم."
            ]
        },
        {
            "verse": 34,
            "text": [
                "> تكلم، فجاء الجراد،",
                "> والجراد الذي لا يُحصى،"
            ]
        },
        {
            "verse": 35,
            "text": [
                "> وأكل كل نبات في أرضهم،",
                "> وأكل ثمر أرضهم."
            ]
        },
        {
            "verse": 36,
            "text": [
                "> وضرب كل بكر في أرضهم،",
                "> أول ثمار كل قوتهم."
            ]
        },
        {
            "verse": 37,
            "text": [
                "> ثم أخرج بني إسرائيل بفضة وذهب،",
                "> ولم يكن في أسباطه أحد يتعثر."
            ]
        },
        {
            "verse": 38,
            "text": [
                "> فرحت مصر عند خروجهم،",
                "> لأن رعبهم وقع على المصريين."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 39,
            "text": [
                "> نشر سحابة كغطاء،",
                "> ونارًا لتضيء الليل."
            ]
        },
        {
            "verse": 40,
            "text": [
                "> طلبوا، فجلب لهم السلوى،",
                "> وقدم لهم خبز السماء."
            ]
        },
        {
            "verse": 41,
            "text": [
                "> فتح الصخرة فتدفقت المياه؛",
                "> جرت كالنهر في الصحراء."
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 42,
            "text": [
                "> لأنه ذكر وعده المقدس",
                "> لعبده إبراهيم؛"
            ]
        },
        {
            "verse": 43,
            "text": [
                "> وأخرج شعبه بفرح،",
                "> مختاريه بهتاف فرح."
            ]
        },
        {
            "verse": 44,
            "text": [
                "> وأعطاهم أراضي الأمم،",
                "> وورثوا تعب الشعوب،"
            ]
        },
        {
            "verse": 45,
            "text": [
                "> لكي يحفظوا فرائضه",
                "> ويلتزموا بشريعته.",
                "> سبحوا الرب!"
            ]
        }
    ]
}