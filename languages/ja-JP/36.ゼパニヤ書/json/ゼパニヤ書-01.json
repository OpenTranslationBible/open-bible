{
    "book": "ゼパニヤ書",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "アモンの子、ユダの王ヨシヤの時代に、クシの子、ゲダリヤの子、アマリヤの子、ヒゼキヤの子であるゼパニヤに臨んだ主の言葉。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 「わたしは地の面からすべてのものを完全に一掃する」と主は宣言される。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 「わたしは人と獣を一掃し、",
                "> 空の鳥と海の魚を取り除き、",
                "> 廃墟と悪者を共にする。",
                "> わたしは地の面から人類を断ち切る」と主は宣言される。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 「わたしはユダに対して手を伸ばし、",
                "> エルサレムのすべての住民に対しても。",
                "> わたしはこの場所からバアルの残りをすべて断ち切り、",
                "> 偶像礼拝の祭司たちの名を他の祭司たちと共に。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 屋上で星の軍勢にひれ伏す者たち、",
                "> 主に誓い、またミルコムに誓う者たち、"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 主に従うことをやめた者たち、",
                "> 主を求めず、彼に尋ねもしない者たち。」"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 主なる神の前で静まれ、",
                "> 主の日が近いからだ。",
                "> 主は犠牲を準備され、",
                "> 彼の客を聖別された。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 「主の犠牲の日に、",
                "> わたしは君主たち、王の子たち、",
                "> そして外国の服を着るすべての者を罰する。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> その日にわたしは敷居を飛び越えるすべての者を罰し、",
                "> 彼らの主人の家を暴力と欺瞞で満たす者たちを罰する。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "> 「その日に」と主は宣言される、",
                "> 「魚の門から叫び声が聞こえ、",
                "> 第二地区からの嘆き、",
                "> 丘からの大きな崩壊の音が。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "> 市場地区に住む者たちよ、嘆け、",
                "> あなたの商人たちはすべて滅ぼされ、",
                "> 銀を量る者たちはすべて断ち切られる。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "> その時、わたしは灯火を持ってエルサレムを探し、",
                "> 自己満足している者たちを罰する、",
                "> 滓に残されたぶどう酒のような者たち、",
                "> 彼らの心の中で言う、",
                "> 『主は何もなさらない、良いことも悪いことも。』"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> 彼らの富は略奪され、",
                "> 彼らの家は荒廃する。",
                "> 家を建ててもそこに住むことはなく、",
                "> ぶどう園を植えてもそのぶどう酒を飲むことはない。」"
            ]
        },
        {
            "verse": 14,
            "text": [
                "> 主の大いなる日は近い",
                "> —近く、速やかに来る。",
                "> 主の日の叫びは苦い；",
                "> 戦士はその戦いの叫びを上げる。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "> その日は怒りの日、",
                "> 苦しみと苦悩の日、",
                "> 廃墟と荒廃の日、",
                "> 暗闇と陰鬱の日、",
                "> 雲と濃い暗闇の日、"
            ]
        },
        {
            "verse": 16,
            "text": [
                "> ラッパと戦いの叫びの日",
                "> 要塞都市に対して",
                "> 高い角の塔に対して。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "> 「わたしは人類に苦しみをもたらし、",
                "> 彼らは盲人のように歩む、",
                "> 主に対して罪を犯したからだ。",
                "> 彼らの血は塵のように注がれ、",
                "> 彼らの肉は糞のように。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "> 彼らの銀も金も",
                "> 主の怒りの日に彼らを救うことはできない。",
                "> 彼の嫉妬の火の中で、",
                "> 全地は消費される、",
                "> 彼は完全な終わりを作る、",
                "> 実に恐ろしいものを、",
                "> 地のすべての住民に。」"
            ]
        }
    ]
}