{
    "book": "ヨハネによる福音書",
    "chapter": 11,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ラザロという名の病気の人がいた。彼はマリアとその姉妹マルタの村、ベタニアの出身であった。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "（このマリアは、主に香油を塗り、髪でその足を拭った人であり、その兄弟ラザロが病気であった。）"
            ]
        },
        {
            "verse": 3,
            "text": [
                "そこで姉妹たちはイエスに言付けを送って、「主よ、あなたが愛しておられる者が病気です」と言った。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "イエスはこれを聞いて言われた、「この病気は死に至るものではありません。神の栄光のためであり、それによって神の子が栄光を受けるのです。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "イエスはマルタとその姉妹とラザロを深く愛しておられた。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "それで、ラザロが病気であると聞かれたとき、さらに二日間その場所に留まられた。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "そして弟子たちに言われた、「ユダヤに戻りましょう。」"
            ]
        },
        {
            "verse": 8,
            "text": [
                "弟子たちは言った、「先生、つい最近、人々はあなたを石で打とうとしました。それでもまた行かれるのですか？」"
            ]
        },
        {
            "verse": 9,
            "text": [
                "イエスは答えられた、「昼の時間は十二時間ではありませんか？昼間に歩く者は、この世の光によって見るのでつまずきません。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "しかし、夜に歩く者はつまずきます。光がないからです。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 11,
            "text": [
                "これを言われた後、さらに言われた、「私たちの友ラザロは眠っています。しかし、私は彼を起こしに行きます。」"
            ]
        },
        {
            "verse": 12,
            "text": [
                "弟子たちは言った、「主よ、眠っているならば、回復するでしょう。」"
            ]
        },
        {
            "verse": 13,
            "text": [
                "イエスはラザロの死を指して言われたが、弟子たちは自然な眠りを指していると思った。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "それでイエスははっきりと彼らに言われた、「ラザロは死にました。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "そして、あなたがたのために、私はそこにいなかったことを喜んでいます。それはあなたがたが信じるためです。しかし、彼のもとへ行きましょう。」"
            ]
        },
        {
            "verse": 16,
            "text": [
                "トマス、別名ディディモと呼ばれる者が他の弟子たちに言った、「私たちも行きましょう。彼と共に死に直面するために。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 17,
            "text": [
                "イエスが到着すると、ラザロがすでに墓に四日間入っていることが分かった。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "ベタニアはエルサレムからそう遠くない場所にあった。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "多くのユダヤ人がマルタとマリアのもとに来て、彼らの兄弟について慰めていた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "マルタはイエスが来られると聞いて、出迎えに行ったが、マリアは家に留まっていた。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "マルタはイエスに言った、「主よ、もしあなたがここにおられたなら、私の兄弟は死ななかったでしょう。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "しかし、今でも私は知っています。神はあなたが求めることを何でも与えてくださると。」"
            ]
        },
        {
            "verse": 23,
            "text": [
                "イエスは彼女に言われた、「あなたの兄弟は蘇るでしょう。」"
            ]
        },
        {
            "verse": 24,
            "text": [
                "マルタは言った、「私は彼が最後の日に復活することを知っています。」"
            ]
        },
        {
            "verse": 25,
            "text": [
                "イエスは彼女に言われた、「私は復活であり、命です。私を信じる者は、たとえ死んでも生きるのです。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "そして、私を信じて生きる者は決して本当に死ぬことはありません。これを信じますか？」"
            ]
        },
        {
            "verse": 27,
            "text": [
                "彼女は言った、「はい、主よ、私はあなたがメシアであり、神の子であり、この世に来るべき方であると信じています。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 28,
            "text": [
                "これを言った後、彼女は戻って、妹マリアを呼び寄せ、そっと言った。「先生がここにおられ、あなたを呼んでおられます。」"
            ]
        },
        {
            "verse": 29,
            "text": [
                "これを聞いて、マリアはすぐに立ち上がり、イエスのもとに行った。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "イエスはまだ村に入っておらず、マルタが出迎えた場所に留まっておられた。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "マリアと一緒に家にいて彼女を慰めていたユダヤ人たちは、彼女が急いで立ち上がり出て行くのを見て、彼女が墓に行って泣くのだと思い、彼女について行った。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "マリアはイエスがおられる場所に着き、彼を見てその足元にひれ伏した。「主よ、もしあなたがここにおられたなら、私の兄弟は死ななかったでしょう。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 33,
            "text": [
                "イエスは彼女が泣いているのを見、彼女と一緒に来たユダヤ人たちも泣いているのを見て、霊の中で深く動かされ、心を痛められた。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "「彼をどこに置きましたか？」とイエスは尋ねられた。「主よ、来てご覧ください」と彼らは答えた。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "イエスは涙を流された。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "それで人々は言った、「彼がどれほど彼を愛しておられたかを見なさい！」"
            ]
        },
        {
            "verse": 37,
            "text": [
                "しかし、他の者たちは言った、「盲人の目を開けたこの人が、この人の死を防ぐことができなかったのか？」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 38,
            "text": [
                "イエスは再び深く動かされて、墓に来られた。それは石が入口に置かれた洞窟であった。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "「石を取り除けなさい」とイエスは言われた。「しかし、主よ」とマルタ、亡くなった者の姉妹は言った、「もう臭いがしています。彼は四日間そこにいます。」"
            ]
        },
        {
            "verse": 40,
            "text": [
                "イエスは言われた、「もし信仰があれば、あなたは神の栄光を見ると私は言わなかったでしょうか？」"
            ]
        },
        {
            "verse": 41,
            "text": [
                "それで彼らは石を取り除けた。イエスは目を上げて言われた、「父よ、あなたが私を聞いてくださったことを感謝します。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "あなたがいつも私を聞いてくださることを私は知っていますが、ここに立っている人々のために言いました。彼らがあなたが私を遣わされたと信じるためです。」"
            ]
        },
        {
            "verse": 43,
            "text": [
                "これを言った後、イエスは大声で呼ばれた、「ラザロ、出てきなさい！」"
            ]
        },
        {
            "verse": 44,
            "text": [
                "亡くなった人が出てきた。彼の手と足は亜麻布で巻かれ、顔には布がかけられていた。イエスは彼らに言われた、「墓の服を取り除いて、彼を行かせなさい。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 45,
            "text": [
                "その結果、マリアを訪ねてきた多くのユダヤ人が、イエスが行ったことを見て、彼を信じた。"
            ]
        },
        {
            "verse": 46,
            "text": [
                "しかし、彼らの中にはパリサイ人のもとに行き、イエスが行ったことを知らせた者もいた。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 47,
            "text": [
                "それで祭司長たちとパリサイ人たちはサンヘドリンを招集した。「私たちは何をしているのか？」彼らは言った。「この人は多くのしるしを行っています。"
            ]
        },
        {
            "verse": 48,
            "text": [
                "もし彼を続けさせるならば、皆が彼を信じるでしょう。そしてローマ人が来て、私たちの神殿と国を奪うでしょう。」"
            ]
        },
        {
            "verse": 49,
            "text": [
                "その年の大祭司であったカヤパという名の一人が言った、「あなたがたは何が必要かを知らないのです！"
            ]
        },
        {
            "verse": 50,
            "text": [
                "一人の人が民のために死ぬ方が、全民族が滅びるよりも良いことを理解していないのです。」"
            ]
        },
        {
            "verse": 51,
            "text": [
                "彼は自分からこのことを言ったのではなく、実際にはその年の大祭司として、イエスがユダヤ民族のために死ぬことをすでに予言していた。"
            ]
        },
        {
            "verse": 52,
            "text": [
                "そして、その民族だけでなく、散らばった神の子供たちをも集め、一つにするためであった。"
            ]
        },
        {
            "verse": 53,
            "text": [
                "それでその日から彼らは彼の命を終わらせることを計画した。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 54,
            "text": [
                "その結果、イエスはもはやユダヤの人々の間を公然と動き回ることはなかった。代わりに、荒野に近いエフライムという村に退かれ、そこで弟子たちと共に過ごされた。"
            ]
        },
        {
            "verse": 55,
            "text": [
                "ユダヤの過越の祭りが近づくと、多くの人々が過越の前に儀式的な清めのために田舎からエルサレムに上って来た。"
            ]
        },
        {
            "verse": 56,
            "text": [
                "彼らはイエスを探し続け、神殿の庭に立って互いに尋ねた、「どう思いますか？彼は祭りに来るのでしょうか？」"
            ]
        },
        {
            "verse": 57,
            "text": [
                "しかし、祭司長たちとパリサイ人たちは、彼がどこにいるかを知った者は誰でも報告するように命じていた。彼らが彼を逮捕できるようにするためである。"
            ]
        }
    ]
}