{
    "book": "雅歌",
    "chapter": 7,
    "verses": [
        {
            "verse": 1,
            "text": [
                "あなたの足はサンダルを履いてどれほど美しいことでしょう、",
                "王女の娘よ！",
                "あなたの腰の曲線は宝石のようで、",
                "芸術家の手の作品です。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "あなたのへそは丸い杯で、",
                "混ぜたぶどう酒が欠けることがありません。",
                "あなたの腹は小麦の山のようで、",
                "百合で囲まれています。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "あなたの二つの乳房は優しい小鹿のようで、",
                "ガゼルの双子です。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "あなたの首は象牙の塔のように優雅で、",
                "あなたの目はヘシュボンの静かな池のようです。",
                "バテ・ラビムの門のそばにあります。",
                "あなたの鼻はレバノンの塔のように優雅で、",
                "ダマスカスを見渡しています。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "あなたの頭はカルメルのように威厳があり、",
                "あなたの頭の流れる髪は紫の糸のようです。",
                "王はあなたの髪に魅了されています。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "どれほど愛らしく、どれほど心地よいことでしょう、",
                "私の愛しい人よ、あなたのすべての魅力で！"
            ]
        },
        {
            "verse": 7,
            "text": [
                "あなたの姿はヤシの木のようで、",
                "あなたの乳房はその房のようです。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "私は言いました、「私はヤシの木に登り、",
                "その果実の茎をつかみます。」",
                "ああ、あなたの乳房がぶどうの房のようでありますように、",
                "あなたの息の香りがリンゴのようでありますように、"
            ]
        },
        {
            "verse": 9,
            "text": [
                "そしてあなたの口が最上のぶどう酒のようでありますように！」",
                "それは私の愛する者のために滑らかに流れ、",
                "休む者の唇を通って優しく流れます。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "私は私の愛する者に属し、",
                "彼の望みは私にあります。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "来てください、私の愛する者よ、田舎へ行きましょう、",
                "村々で夜を過ごしましょう。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "早く起きてぶどう畑に行きましょう。",
                "ぶどうの木が芽を出したかどうか、",
                "その花が開いたかどうか、",
                "ザクロが咲いたかどうか見てみましょう。",
                "そこで私はあなたと愛を分かち合います。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "マンドレイクはその香りを放ち、",
                "私たちの扉の上にはすべての選りすぐりの果物があります、",
                "新しいものも古いものも、",
                "私の愛する者よ、あなたのために取っておいたものです。"
            ]
        }
    ]
}