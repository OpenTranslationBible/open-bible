{
    "book": "ソロモンの歌",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "私は私の園に来た、私の妹、私の花嫁よ。",
                "私は没薬と香料を集めた。",
                "私は蜂の巣と蜂蜜を食べた。",
                "私は私のワインとミルクを飲んだ。",
                "食べよ、友よ。",
                "飲んで愛に酔いしれよ。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 2,
            "text": [
                "私は眠っていたが、私の心は目覚めていた。",
                "声を聞いた！私の愛する者が戸口にいた。",
                "「開けておくれ、私の妹、私の愛しい者、",
                "私の鳩、私の完璧な者よ！",
                "私の頭は露で濡れている、",
                "私の髪は夜の湿気で濡れている。」"
            ]
        },
        {
            "verse": 3,
            "text": [
                "「私は上着を脱いでしまった、",
                "どうやってまた着ることができようか？",
                "私は足を洗った、",
                "どうやってまた汚すことができようか？」"
            ]
        },
        {
            "verse": 4,
            "text": [
                "私の愛する者が開口部から手を伸ばした、",
                "そして私の心は彼のために動かされた。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "私は立ち上がり、私の愛する者に開けた。",
                "そして私の手は没薬で覆われ、",
                "私の指は流れる没薬で、",
                "ボルトの取っ手の上にあった。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "私は私の愛する者に開けた、",
                "しかし私の愛する者は振り返って去ってしまった！",
                "彼が去ったとき、私の魂は失われた。",
                "私は彼を探したが見つけられなかった。",
                "私は彼を呼んだが、彼は私に答えなかった。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "町を巡回する見張りたちが私を見つけた、",
                "彼らは私を打ち、傷つけた。",
                "城壁の守衛たちが私からショールを奪った。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "私はあなたたちに誓わせる、",
                "エルサレムの娘たちよ、",
                "もし私の愛する者を見つけたなら、",
                "彼に何を伝えるかを：",
                "私は恋に悩んでいると。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 9,
            "text": [
                "あなたの愛する者はどんな人か、",
                "最も美しい女性たちの中で？",
                "あなたの愛する者はどんな人か、",
                "私たちに誓わせるほどに？"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 10,
            "text": [
                "私の愛する者は輝いて赤みを帯び、",
                "万人に優れている。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "彼の頭は精錬された金のようだ。",
                "彼の髪はナツメヤシの房のようで、",
                "カラスのように黒い。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "彼の目は水の流れのそばの鳩のようで、",
                "ミルクに浸され、",
                "完璧に配置されている。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "彼の頬は香料の花壇のようで、",
                "香り高い草の土手のようだ。",
                "彼の唇はユリで、",
                "液体の没薬が滴っている。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "彼の手はトパーズで飾られた金の棒だ。",
                "彼の腹は彫られた象牙で、",
                "サファイアがはめ込まれている。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "彼の脚は純金の台座に立つアラバスターの柱だ。",
                "彼の姿はレバノンのように威厳があり、",
                "杉のように選び抜かれている。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "彼の口は甘美に満ちている。",
                "そして彼は全く愛らしい。",
                "これが私の愛する者であり、これが私の友だ、",
                "エルサレムの娘たちよ。"
            ]
        }
    ]
}