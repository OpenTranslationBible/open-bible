{
    "book": "詩篇",
    "chapter": 150,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 主を賛美せよ！",
                "> 聖なる場所で神をたたえよ。",
                "> 広大な天で神を賛美せよ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 力強い御業のために神をたたえよ。",
                "> 偉大な力のために神を賛美せよ。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> ラッパの音で神をたたえよ。",
                "> ハープと竪琴で神を賛美せよ。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> タンバリンと踊りで神をたたえよ。",
                "> 弦楽器と笛で神を賛美せよ。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 響き渡るシンバルで神をたたえよ。",
                "> 鳴り響くシンバルで神を賛美せよ。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 息のあるすべてのものよ、主を賛美せよ。",
                "> 主を賛美せよ！"
            ]
        }
    ]
}