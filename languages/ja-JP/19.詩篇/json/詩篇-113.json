{
    "book": "詩篇",
    "chapter": 113,
    "verses": [
        {
            "verse": 1,
            "text": [
                "> 主を賛美せよ！",
                "---",
                "> 主のしもべたちよ、賛美せよ、",
                "> 主の御名を賛美せよ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 主の御名がたたえられますように、",
                "> 今よりとこしえに。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 日の出から日の入りまで、",
                "> 主の御名は賛美に値する。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 主はすべての国々の上に高くおられ、",
                "> その栄光は天の上にある。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 誰が、私たちの神、主に比べられようか、",
                "> 高く座しておられる方に。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 天と地の事を見られるために",
                "> 身を低くされる方に。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 貧しい者をちりから引き上げ、",
                "> 乏しい者を灰の中から高く上げられる。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 彼らを君主たちと共に、",
                "> その民の指導者たちと共に座らせるために。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "> 子を持たない女に家を与え、",
                "> 子供たちの喜ぶ母とされる。",
                "> 主を賛美せよ！"
            ]
        }
    ]
}