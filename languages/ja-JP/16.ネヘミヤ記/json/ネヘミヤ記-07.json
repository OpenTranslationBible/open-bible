            ]
        },
        {
            "verse": 12,
            "text": [
                "> エラムの家系、1,254人;"
            ]
        },
        {
            "verse": 13,
            "text": [
                "> ザットの家系、845人;"
            ]
        },
        {
            "verse": 14,
            "text": [
