{
    "book": "伝道の書",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "ダビデの子、エルサレムの王である伝道者の言葉。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "「空の空」と伝道者は言う。「空の空、すべては空である。」"
            ]
        },
        {
            "verse": 3,
            "text": [
                "人は太陽の下で労苦して働いて、何を得るのか。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "世代は去り、世代は来るが、地は永遠に変わらない。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "太陽は昇り、太陽は沈み、また急いでその昇るところに帰る。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "風は南に吹き、北に回り、巡り巡って、またその巡るところに帰る。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "すべての川は海に流れ込むが、海は満ちることがない。川は流れ出たところに帰り、また流れ出る。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "すべてのことは人が言い尽くせないほどに疲れさせる。目は見て満足せず、耳は聞いて満ち足りない。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "過去にあったことはこれからもあり、過去に行われたことはこれからも行われる。太陽の下には新しいものは何もない。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "「見よ、これは新しい」と言えるものがあるだろうか。それはすでに昔の時代に存在していた。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "以前のことを覚えている者はなく、これからのことも後に来る者たちが覚えることはない。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "私、伝道者は、エルサレムでイスラエルの王であった。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "私は心を尽くして、天の下で行われるすべてのことを知恵をもって探り求めた。それは神が人の子らに与えた苦しい務めである。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "私は太陽の下で行われるすべてのことを見たが、それはすべて空であり、風を追うようなものである。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "曲がったものはまっすぐにできず、欠けているものは数えられない。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "私は心の中で言った、「見よ、私はエルサレムで私の前にいたすべての者よりも多くの知恵を得た。私は多くの知恵と知識を経験した。」"
            ]
        },
        {
            "verse": 17,
            "text": [
                "それから私は心を尽くして知恵を知り、また狂気と愚かさを知ろうとしたが、これもまた風を追うようなものであると知った。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "多くの知恵には多くの悩みがあり、知識を増す者は痛みを増す。"
            ]
        }
    ]
}