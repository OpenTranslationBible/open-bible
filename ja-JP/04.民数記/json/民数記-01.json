{
    "book": "民数記",
    "chapter": 1,
    "verses": [
        {
            "verse": 1,
            "text": [
                "エジプトを出た後の第2年の第2月の第1日に、シナイの荒野で、会見の天幕で、主はモーセに語られた。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "「イスラエル人の全会衆を、その家族ごとに、父祖の家ごとに、名を一人一人挙げて調べなさい。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "あなたとアロンは、イスラエルの中で20歳以上で軍務に就くことのできるすべての者を、その軍団ごとに数えなさい。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "あなたと共に、各部族から一人ずつ、その家の頭である者を連れて行きなさい。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "あなたを助ける者たちの名前は次のとおりである。ルベンからは、シデウルの子エリツル。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "シメオンの部族からは、ツリシャダイの子シェルミエル。"
            ]
        },
        {
            "verse": 7,
            "text": [
                "ユダの部族からは、アミナダブの子ナフション。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "イッサカルの部族からは、ツアルの子ネタネル。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "ゼブルンの部族からは、ヘロンの子エリアブ。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "ヨセフの子孫からは、エフライムの部族からは、アミフデの子エリシャマ。マナセの部族からは、ペダツルの子ガマリエル。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "ベニヤミンの部族からは、ギデオニの子アビダン。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "ダンの部族からは、アミシャダイの子アヒエゼル。"
            ]
        },
        {
            "verse": 13,
            "text": [
                "アシェルの部族からは、オクランの子パギエル。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "ガドの部族からは、デウエルの子エリアサフ。"
            ]
        },
        {
            "verse": 15,
            "text": [
                "ナフタリの部族からは、エナンの子アヒラ。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "これらは、会衆から選ばれた者たちであり、彼らの父祖の部族の指導者であり、イスラエルの氏族の頭であった。"
            ]
        },
        {
            "verse": 17,
            "text": [
                "モーセとアロンは、名を指定されたこれらの者たちを集め、"
            ]
        },
        {
            "verse": 18,
            "text": [
                "第2月の第1日に全会衆を集めた。彼らは家族ごとに、父祖の家ごとに、20歳以上の者を一人一人名を挙げて登録した。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "主がモーセに命じたように、彼はシナイの荒野で彼らを数えた。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "ルベンの子孫、イスラエルの長子からは、20歳以上で軍務に就くことのできるすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 21,
            "text": [
                "ルベンの部族の数は46,500人であった。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "シメオンの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "シメオンの部族の数は59,300人であった。"
            ]
        },
        {
            "verse": 24,
            "text": [
                "ガドの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 25,
            "text": [
                "ガドの部族の数は45,650人であった。"
            ]
        },
        {
            "verse": 26,
            "text": [
                "ユダの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 27,
            "text": [
                "ユダの部族の数は74,600人であった。"
            ]
        },
        {
            "verse": 28,
            "text": [
                "イッサカルの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 29,
            "text": [
                "イッサカルの部族の数は54,400人であった。"
            ]
        },
        {
            "verse": 30,
            "text": [
                "ゼブルンの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 31,
            "text": [
                "ゼブルンの部族の数は57,400人であった。"
            ]
        },
        {
            "verse": 32,
            "text": [
                "ヨセフの子孫からは、エフライムの部族からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 33,
            "text": [
                "エフライムの部族の数は40,500人であった。"
            ]
        },
        {
            "verse": 34,
            "text": [
                "マナセの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 35,
            "text": [
                "マナセの部族の数は32,200人であった。"
            ]
        },
        {
            "verse": 36,
            "text": [
                "ベニヤミンの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 37,
            "text": [
                "ベニヤミンの部族の数は35,400人であった。"
            ]
        },
        {
            "verse": 38,
            "text": [
                "ダンの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 39,
            "text": [
                "ダンの部族の数は62,700人であった。"
            ]
        },
        {
            "verse": 40,
            "text": [
                "アシェルの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 41,
            "text": [
                "アシェルの部族の数は41,500人であった。"
            ]
        },
        {
            "verse": 42,
            "text": [
                "ナフタリの子孫からは、20歳以上で軍務に適するすべての者が、氏族と家族ごとに名を挙げて登録された。"
            ]
        },
        {
            "verse": 43,
            "text": [
                "ナフタリの部族の数は53,400人であった。"
            ]
        },
        {
            "verse": 44,
            "text": [
                "これらは、モーセとアロンがイスラエルの指導者たちと共に数えた者たちであり、12人のそれぞれが父祖の家を代表していた。"
            ]
        },
        {
            "verse": 45,
            "text": [
                "イスラエルの軍隊において軍務に適する20歳以上のすべてのイスラエル人は、家族ごとに数えられた。"
            ]
        },
        {
            "verse": 46,
            "text": [
                "彼らの総数は603,550人であった。"
            ]
        },
        {
            "verse": 47,
            "text": [
                "しかし、レビの部族は他の者たちと共に数えられなかった。"
            ]
        },
        {
            "verse": 48,
            "text": [
                "主がモーセに語り、彼に命じたからである。"
            ]
        },
        {
            "verse": 49,
            "text": [
                "「レビの部族を数えたり、他のイスラエル人の中に含めたりしてはならない。"
            ]
        },
        {
            "verse": 50,
            "text": [
                "むしろ、証の幕屋とそのすべての備品とそのすべてのものについて、レビ人を任命しなさい。彼らは幕屋とそのすべての備品を運び、それを管理し、その周りに宿営しなければならない。"
            ]
        },
        {
            "verse": 51,
            "text": [
                "幕屋が移動するときは、レビ人がそれを取り下げ、設営するときはレビ人がそれを設営しなければならない。外部の者がそれに近づくと死刑にされる。"
            ]
        },
        {
            "verse": 52,
            "text": [
                "イスラエル人はそれぞれ自分の陣営と自分の旗のもとに宿営しなければならない。"
            ]
        },
        {
            "verse": 53,
            "text": [
                "しかし、レビ人は証の幕屋の周りに宿営し、イスラエルの会衆に対する神の怒りが起こらないようにしなければならない。レビ人は証の幕屋の奉仕を担当する。」"
            ]
        },
        {
            "verse": 54,
            "text": [
                "イスラエル人は、主がモーセに命じたとおりにすべてを行った。"
            ]
        }
    ]
}