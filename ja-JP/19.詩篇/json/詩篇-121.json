{
    "book": "詩篇",
    "chapter": 121,
    "verses": [
        {
            "text": [
                "登る歌"
            ]
        },
        {
            "verse": 1,
            "text": [
                "> 私は山に向かって目を上げる。",
                "> 私の助けはどこから来るのか。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "> 私の助けは主から来る。",
                "> 天と地を造られた方から。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 3,
            "text": [
                "> 彼はあなたの足をよろけさせず、",
                "> あなたを守る方はまどろむことがない。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "> 見よ、イスラエルを守る方は",
                "> まどろむことも眠ることもない。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 5,
            "text": [
                "> 主はあなたを守る方、",
                "> 主はあなたの右手を覆う陰。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "> 昼は太陽があなたを打たず、",
                "> 夜は月も打たない。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "> 主はあなたをすべての災いから守り、",
                "> あなたの魂を守られる。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "> 主はあなたの出入りを守られる。",
                "> 今よりとこしえに至るまで。"
            ]
        }
    ]
}