{
    "book": "箴言",
    "chapter": 5,
    "verses": [
        {
            "verse": 1,
            "text": [
                "わが子よ、わたしの知恵に注意を払い、わたしの理解に耳を傾けよ。"
            ]
        },
        {
            "verse": 2,
            "text": [
                "それはあなたが慎みを保ち、あなたの唇が知識を守るためである。"
            ]
        },
        {
            "verse": 3,
            "text": [
                "なぜなら、姦淫の女の唇は蜜を滴らせ、その言葉は油よりも滑らかだからである。"
            ]
        },
        {
            "verse": 4,
            "text": [
                "しかし最終的には、彼女は苦よもぎのように苦く、両刃の剣のように鋭い。"
            ]
        },
        {
            "verse": 5,
            "text": [
                "彼女の足は死に下り、彼女の歩みはまっすぐにシェオルに向かう。"
            ]
        },
        {
            "verse": 6,
            "text": [
                "彼女は命の道を考えず、その道は不安定であり、彼女自身もそれを知らない。"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 7,
            "text": [
                "それゆえ、わが子たちよ、わたしに聞き従い、わたしの言葉から離れてはならない。"
            ]
        },
        {
            "verse": 8,
            "text": [
                "あなたの道を彼女から遠ざけ、彼女の家の戸口に近づいてはならない。"
            ]
        },
        {
            "verse": 9,
            "text": [
                "そうでないと、あなたの誉れを他人に渡し、あなたの年を残酷な者に渡すことになる。"
            ]
        },
        {
            "verse": 10,
            "text": [
                "そうでないと、見知らぬ者があなたの富で満たされ、あなたの苦労して得た財産が異邦人の家に行くことになる。"
            ]
        },
        {
            "verse": 11,
            "text": [
                "そして最後には、あなたの肉と体が尽き果てるときに、あなたはうめくことになる。"
            ]
        },
        {
            "verse": 12,
            "text": [
                "あなたは言うだろう、「私はいかにして訓練を嫌い、心が矯正を拒んだことか！"
            ]
        },
        {
            "verse": 13,
            "text": [
                "私は教師の声に耳を傾けず、指導者に聞き従わなかった。"
            ]
        },
        {
            "verse": 14,
            "text": [
                "私は集会と会衆の中で、ほとんど完全に破滅に陥っていた。」"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 15,
            "text": [
                "自分の貯水瓶から水を飲み、自分の井戸から新鮮な水を汲みなさい。"
            ]
        },
        {
            "verse": 16,
            "text": [
                "あなたの泉が通りに溢れ出し、公共の広場に水の流れを持つべきだろうか？"
            ]
        },
        {
            "verse": 17,
            "text": [
                "それらはあなたのものだけであり、見知らぬ者と分かち合うべきではない。"
            ]
        },
        {
            "verse": 18,
            "text": [
                "あなたの喜びの源が祝福され、若い頃の妻に喜びを見出しなさい。"
            ]
        },
        {
            "verse": 19,
            "text": [
                "愛らしい雌鹿、優雅なガゼル—彼女の乳房が常にあなたを満たし、彼女の愛に常に酔いしれなさい。"
            ]
        },
        {
            "verse": 20,
            "text": [
                "なぜ、わが子よ、姦淫の女に酔いしれ、道に迷った女の胸を抱くのか？"
            ]
        },
        {
            "text": [
                "---"
            ]
        },
        {
            "verse": 21,
            "text": [
                "すべての人の道は主の目の前にあり、主は彼らのすべての道を調べる。"
            ]
        },
        {
            "verse": 22,
            "text": [
                "悪者の不正は彼らを捕らえ、彼らは自分の罪の縄によってしっかりと縛られる。"
            ]
        },
        {
            "verse": 23,
            "text": [
                "彼らは訓練の欠如のために死に、その愚かさの大きさの中で道を誤る。"
            ]
        }
    ]
}